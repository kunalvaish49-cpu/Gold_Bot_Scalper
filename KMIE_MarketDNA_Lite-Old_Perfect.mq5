//--- 2026-09-08, explicit operator request (MARKET DNA STATE REMOVAL): re-indexed to the new 16-slot
//--- compacted enum, same realign-by-name/preserve-value rule as g_dnaCalibMean[] above. EXPANSION/
//--- COMPRESSION's stdev entries (old idx11/idx12) are gone entirely; UPTREND/DOWNTREND's (old idx2/
//--- idx3) preserved byte-for-byte at their new retired-compatibility slots (idx11/idx12).
double g_dnaCalibStdev[LDNA_STATE_COUNT] =
  {
   15.5291, // idx0  STRONG_UPTREND (real, unchanged)
   15.1539, // idx1  STRONG_DOWNTREND (real, unchanged)
   15.0,    // idx2  WEAK_UPTREND (placeholder, unchanged)
   15.0,    // idx3  WEAK_DOWNTREND (placeholder, unchanged)
   9.855,   // idx4  PULLBACK_UP (real, 2026-09-08 96,355-bar audit, unchanged value - just moved from old idx6)
   9.791,   // idx5  PULLBACK_DOWN (real, 2026-09-08 same audit, unchanged value - just moved from old idx7)
   15.0,    // idx6  VOLATILITY_EXPANSION (placeholder, unchanged)
   15.0,    // idx7  VOLATILITY_COMPRESSION (placeholder, unchanged)
   15.0,    // idx8  VOLATILE (placeholder, unchanged)
   15.0,    // idx9  CHOPPY (placeholder, unchanged)
   15.0,    // idx10 NEUTRAL (placeholder, unchanged)
   15.1948, // idx11 UPTREND (real, unchanged value - just moved from old idx2) - RETIRED-COMPATIBILITY
   19.0750, // idx12 DOWNTREND (real, unchanged value - just moved from old idx3) - RETIRED-COMPATIBILITY
   6.85,    // idx13 STRONG_TREND (real, unchanged) - RETIRED-COMPATIBILITY, never read by ARGMAX
   15.0,    // idx14 INSTITUTIONAL_BUYING (placeholder, unchanged) - RETIRED-COMPATIBILITY
   6.01     // idx15 INSTITUTIONAL_SELLING (real, unchanged) - RETIRED-COMPATIBILITY
  };

#define KMIE_LITE_DNA_ZSCALE 15.0

void CalibrateMarketDNAScores(double &scores[])
  {
   for(int i=0;i<LDNA_STATE_COUNT;i++)
     {
      double sd = (g_dnaCalibStdev[i]>1e-6) ? g_dnaCalibStdev[i] : 1.0; // guard only - never 0 in practice
      double z  = (scores[i]-g_dnaCalibMean[i])/sd;
      scores[i] = Clamp0to100(50.0 + z*KMIE_LITE_DNA_ZSCALE);
     }
  }

//--- 2026-09-04, explicit operator request (FULL MARKET DNA CONSOLIDATION): EvaluateBreakoutStructure()
//--- and its BreakoutStructure are FULLY REMOVED (BREAKOUT DNA state deleted) - source-audited before
//--- removal to confirm zero remaining consumers.

//====================================================================
// 2026-09-04, explicit operator request ("Upgrade the EXISTING generic PULLBACK Market DNA... PHASE 1
// ONLY"): LIVE PRODUCTION replacement of the 2026-08-25 formula. Takes BOTH the raw rates[]/k (for the
// UNCHANGED fh=2 fractal swing/trend-context detection, Steps 1-4 below - closed candles only,
// rates[1..k-1], never rates[0]/shift 0) AND the ALREADY-BUILT 25-bar canonical window (win[]/gotWin
// from BuildMarketDnaWindow30(), called ONCE by EvaluateMarketDNA() and already reused for
// STRONG_TREND/WEAK_TREND/CHOPPY/NEUTRAL/VOL_EXPANSION/VOL_COMPRESSION/VOLATILE) - zero duplicate
// CopyRates/BuildMarketDnaWindow30/ComputeVolumeDna calls, zero new pip/volume formula for anything
// downstream of trend detection.
//
// See PullbackStructure's own header (just above) for the full old-formula-vs-new-formula disclosure,
// what was kept unchanged (swing detection) vs what changed (everything downstream of it).
//====================================================================
PullbackStructure EvaluatePullbackStructure(const MqlRates &rates[], const int k, const PriceRangeDnaResult &win[], const int gotWin)
  {
   PullbackStructure ps;
   ps.valid=false; ps.reasoning=""; ps.barTime=0; ps.contextBars=0;
   ps.swingHighCount=0; ps.swingLowCount=0; ps.bullishTrendEvidence=0.0; ps.bearishTrendEvidence=0.0;
   ps.trendDirection=LDIR_WAIT; ps.trendContextScore=0.0; ps.latestConfirmedExtreme=0.0; ps.latestConfirmedOrigin=0.0;
   ps.precedingImpulsePips=0.0; ps.retracementPips=0.0; ps.retracementRatio=0.0;
   ps.netDisplacementPips5=0.0; ps.grossDisplacementPips5=0.0; ps.directionalConsistency5=0.0;
   ps.avgBodyRatio5=0.0; ps.followThroughScore=0.0; ps.persistenceScore=0.0;
   ps.latestBodyRatio=0.0; ps.candleQualityScore=0.0;
   ps.haveRvol=false; ps.rvol=0.0; ps.haveRelativeRange=false; ps.relativeRange=0.0;
   ps.volumePipRegime="UNKNOWN"; ps.volumePipScore=0.0;
   ps.structuralPreservationScore=0.0; ps.choppyProtectionScore=0.0; ps.finalScore=0.0;

   //--- SAME 25-bar data-sufficiency requirement as STRONG_TREND/WEAK_TREND/CHOPPY/NEUTRAL/VOL_EXPANSION
   //--- (Section 3/Phase 4).
   const int KMIE_PULLBACK_CONTEXT_BARS = 25; // 2026-09-09, explicit operator request ("make all DNA use 25 bars"): 15 -> 25 (was 25 -> 15 on 2026-09-08)
   const int KMIE_PULLBACK_PERSISTENCE_BARS = 5;
   if(gotWin < KMIE_PULLBACK_CONTEXT_BARS)
     {
      ps.reasoning = StringFormat("insufficient closed-candle context (have=%d need=%d)", gotWin, KMIE_PULLBACK_CONTEXT_BARS);
      return ps;
     }
   for(int i=0;i<KMIE_PULLBACK_CONTEXT_BARS;i++)
      if(!win[i].valid)
        {
         ps.reasoning = StringFormat("candle at context index %d invalid (%s)", i, win[i].reasoning);
         return ps;
        }
   ps.contextBars = KMIE_PULLBACK_CONTEXT_BARS;
   ps.barTime = win[0].barTime;

   //--- A. DIRECTIONAL CONTEXT (Section 6) - fh=2 fractal swing detection, UNCHANGED technique from the
   //--- retired formula (Steps 1-4), closed candles only (rates[1..k-1] - shift>=1, verified never shift
   //--- 0 by construction: the loop's own upper bound k-1-fh is always <k, and the fractal window itself
   //--- reads i-w/i+w around that, never index 0 directly reachable from this range for realistic k).
   //--- trendDirection is INTERNAL CONTEXT ONLY (Section 6's explicit "NOT yet PULLBACK_UP/PULLBACK_DOWN")
   //--- - never a separate DNA state, never exposed to scores[].
   int fh = KMIE_UPTREND_FRACTAL_HALFWIDTH; // reused constant, not redefined
   if(k < (2*fh+2))
     {
      ps.reasoning = StringFormat("insufficient closed-candle history for swing detection (k=%d need>=%d)", k, 2*fh+2);
      return ps;
     }

   bool     isHighArr[KMIE_UPTREND_MAX_SWINGS];
   double   priceArr[KMIE_UPTREND_MAX_SWINGS];
   int rawCount=0;
   for(int i=k-1-fh; i>=fh && rawCount<KMIE_UPTREND_MAX_SWINGS; i--)
     {
      bool isSwingHigh=true, isSwingLow=true;
      for(int w=1; w<=fh; w++)
        {
         if(rates[i].high<=rates[i-w].high || rates[i].high<=rates[i+w].high) isSwingHigh=false;
         if(rates[i].low>=rates[i-w].low   || rates[i].low>=rates[i+w].low)   isSwingLow=false;
        }
      if(isSwingHigh && rawCount<KMIE_UPTREND_MAX_SWINGS)
        { isHighArr[rawCount]=true;  priceArr[rawCount]=rates[i].high; rawCount++; }
      if(isSwingLow && rawCount<KMIE_UPTREND_MAX_SWINGS)
        { isHighArr[rawCount]=false; priceArr[rawCount]=rates[i].low;  rawCount++; }
     }

   bool     cIsHigh[KMIE_UPTREND_MAX_SWINGS];
   double   cPrice[KMIE_UPTREND_MAX_SWINGS];
   int cleanCount=0;
   for(int r=0; r<rawCount; r++)
     {
      if(cleanCount>0 && cIsHigh[cleanCount-1]==isHighArr[r])
        {
         bool moreExtreme = isHighArr[r] ? (priceArr[r]>cPrice[cleanCount-1]) : (priceArr[r]<cPrice[cleanCount-1]);
         if(moreExtreme) cPrice[cleanCount-1]=priceArr[r];
        }
      else
        { cIsHigh[cleanCount]=isHighArr[r]; cPrice[cleanCount]=priceArr[r]; cleanCount++; }
     }

   double SH[KMIE_UPTREND_MAX_SWINGS]; int mH=0;
   double SL[KMIE_UPTREND_MAX_SWINGS]; int pL=0;
   for(int c=0;c<cleanCount;c++)
     {
      if(cIsHigh[c]) { SH[mH]=cPrice[c]; mH++; }
      else           { SL[pL]=cPrice[c]; pL++; }
     }
   ps.swingHighCount=mH; ps.swingLowCount=pL;

   if(mH<2 || pL<2)
     {
      ps.reasoning = StringFormat("insufficient swing evidence (swingHighs=%d swingLows=%d, need>=2 each)", mH, pL);
      return ps;
     }

   int hhPairs=mH-1, hhRising=0, lhFalling=0;
   for(int i=0;i<hhPairs;i++) { if(SH[i+1]>SH[i]) hhRising++; if(SH[i+1]<SH[i]) lhFalling++; }
   int hlPairs=pL-1, hlRising=0, llFalling=0;
   for(int j=0;j<hlPairs;j++) { if(SL[j+1]>SL[j]) hlRising++; if(SL[j+1]<SL[j]) llFalling++; }

   ps.bullishTrendEvidence = ((100.0*hhRising/hhPairs) + (100.0*hlRising/hlPairs)) / 2.0;
   ps.bearishTrendEvidence = ((100.0*lhFalling/hhPairs) + (100.0*llFalling/hlPairs)) / 2.0;
   ps.trendDirection = (ps.bullishTrendEvidence>=ps.bearishTrendEvidence) ? LDIR_BUY : LDIR_SELL;
   ps.trendContextScore = MathMax(ps.bullishTrendEvidence, ps.bearishTrendEvidence);

   //--- B. PRECEDING IMPULSE (Section 7) - the leg that produced the current swing structure, measured
   //--- in pips (raw price distance, this file's own established convention - see PriceRangeDnaResult's
   //--- own header). Always positive by construction (HH always above its preceding HL, LH always above
   //--- its preceding LL).
   ps.latestConfirmedExtreme = SH[mH-1];
   ps.latestConfirmedOrigin  = SL[pL-1];
   double legRange = ps.latestConfirmedExtreme - ps.latestConfirmedOrigin;
   if(legRange<=0.0) legRange=_Point;
   ps.precedingImpulsePips = legRange;

   //--- C/D. COUNTER-DIRECTION DISPLACEMENT + RETRACEMENT DEPTH (Section 9) - measured from the LATEST
   //--- CLOSED candle (rates[1].low/high, shift=1) - NEVER ci.newestLow/newestHigh (the retired formula's
   //--- own look-ahead defect this replacement fixes). rates[1] is the SAME closed candle win[0]
   //--- represents (BuildMarketDnaWindow30()'s own shift=1 starting point) - reading rates[1] directly
   //--- here (rather than re-deriving high/low from win[], which does not store them) is still entirely
   //--- within the closed-candle-only contract, not a second independent fetch (rates[] is the SAME array
   //--- EvaluateMarketDNA() already holds).
   double closedLow  = rates[1].low;
   double closedHigh = rates[1].high;
   if(ps.trendDirection==LDIR_BUY)
      ps.retracementPips = ps.latestConfirmedExtreme - closedLow;
   else
      ps.retracementPips = closedHigh - ps.latestConfirmedOrigin;
   ps.retracementRatio = SafeDiv(ps.retracementPips, ps.precedingImpulsePips, 0.0) * 100.0; // RAW, unclamped - can be negative (no retracement yet) or >100 (structure broken)

   //--- E. FIVE-BAR RETRACEMENT PERSISTENCE (Section 8) - indices 0..4 of the 25-bar context, SAME
   //--- technique STRONG_TREND/WEAK_TREND/CHOPPY already established. directionalConsistency5 measures
   //--- agreement with the COUNTER-trend direction (opposite of trendDirection) - i.e. "are the recent 5
   //--- bars actually behaving like a retracement", not "are they continuing the main trend".
   double signedMove5[5];
   double bodyRatio5[5];
   double sumBodyRatio=0.0;
   int counterBars=0;
   for(int i=0;i<KMIE_PULLBACK_PERSISTENCE_BARS;i++)
     {
      signedMove5[i] = win[i].signedCloseToClosePips;
      bodyRatio5[i]  = win[i].bodyRatio;
      sumBodyRatio  += bodyRatio5[i];
      bool isCounterMove = (ps.trendDirection==LDIR_BUY) ? (signedMove5[i]<0.0) : (signedMove5[i]>0.0);
      if(isCounterMove) counterBars++;
     }
   ps.avgBodyRatio5 = sumBodyRatio/KMIE_PULLBACK_PERSISTENCE_BARS;
   ps.directionalConsistency5 = Clamp0to100((counterBars/(double)KMIE_PULLBACK_PERSISTENCE_BARS)*100.0);

   double gross=0.0, net=0.0;
   for(int i=0;i<KMIE_PULLBACK_PERSISTENCE_BARS;i++) { gross += MathAbs(signedMove5[i]); net += signedMove5[i]; }
   ps.grossDisplacementPips5 = gross;
   ps.netDisplacementPips5 = net;

   //--- Follow-through: is the retracement still active (latest bar's relativeRange vs the 5-bar
   //--- average) - SAME threshold-at-50 conversion style STRONG_TREND's own followThrough uses.
   double sumRelRange5=0.0;
   for(int i=0;i<KMIE_PULLBACK_PERSISTENCE_BARS;i++)
      sumRelRange5 += (win[i].rangeClass!="UNKNOWN") ? win[i].relativeRange : 0.0;
   double avgRelRange5 = sumRelRange5/KMIE_PULLBACK_PERSISTENCE_BARS;
   double latestRelRange = (win[0].rangeClass!="UNKNOWN") ? win[0].relativeRange : 0.0;
   ps.followThroughScore = (avgRelRange5>0.0) ? Clamp0to100(50.0*SafeDiv(latestRelRange, avgRelRange5, 1.0)) : 50.0;

   //--- persistenceScore: directional consistency (the DOMINANT term - Section 8's own explicit "avoid
   //--- classifying one isolated opposite candle as a PULLBACK") + follow-through + moderate body
   //--- presence (avgBodyRatio5 - real candles, not indecisive dojis, matching Section 5F's own
   //--- distinction).
   ps.persistenceScore = Clamp0to100(ps.directionalConsistency5*0.60 + ps.followThroughScore*0.25 + ps.avgBodyRatio5*0.15);

   //--- F/G. CANDLE BODY/WICK QUALITY (Section 5F/G) - latest closed bar's own bodyRatio, reused
   //--- canonical field, no new formula. Moderate-to-clean bodies support a genuine retracement leg;
   //--- this is a supporting term, never the dominant one (matching PULLBACK's own established "structure
   //--- first, candle composition second" philosophy carried over from the retired formula's own Section
   //--- D design note).
   ps.latestBodyRatio = win[0].bodyRatio;
   ps.candleQualityScore = Clamp0to100(ps.latestBodyRatio);

   //--- H/I. VOLUME PARTICIPATION + VOLUME x PIP EFFICIENCY (Section 11) - reuses the EXISTING, untouched
   //--- ComputeVolumeDna()/ClassifyVolumePipRegime() - zero new volume calculation, zero raw
   //--- volume/pips ratio (explicitly forbidden by Section 11). EFFICIENT_EXPANSION (clean, confirmed
   //--- retracement movement) scores highest; EFFORT_WITHOUT_RESULT (high effort, poor result - Section
   //--- 11's own "weak/noisy" category) reduced; THIN_MOVEMENT/COMPRESSION (Section 11's own "potentially
   //--- reversal-like" caution zone, since a genuine retracement should show SOME participation) reduced
   //--- further.
   VolumeDnaResult vr = ComputeVolumeDna(PERIOD_M1, KMIE_VOLUME_DNA_BASELINE_BARS);
   ps.haveRvol = vr.valid && (vr.volumeClass!="UNKNOWN");
   ps.rvol = ps.haveRvol ? vr.relativeVolume : 0.0;
   ps.haveRelativeRange = (win[0].rangeClass!="UNKNOWN");
   ps.relativeRange = ps.haveRelativeRange ? win[0].relativeRange : 0.0;
   ps.volumePipRegime = ClassifyVolumePipRegime(ps.haveRelativeRange, ps.relativeRange, ps.haveRvol, ps.rvol);
   if(ps.volumePipRegime=="EFFICIENT_EXPANSION")
      ps.volumePipScore = Clamp0to100(55.0 + 20.0*MathMin(ps.rvol/1.60,2.0));
   else if(ps.volumePipRegime=="EFFORT_WITHOUT_RESULT")
      ps.volumePipScore = 30.0; // high effort, poor result - weak/noisy retracement (Section 11)
   else if(ps.volumePipRegime=="THIN_MOVEMENT")
      ps.volumePipScore = 25.0; // caution zone
   else if(ps.volumePipRegime=="COMPRESSION")
      ps.volumePipScore = 20.0; // low participation - not a confirmed retracement
   else
      ps.volumePipScore = 25.0; // UNKNOWN - neutral-low, never fabricated

   //--- J. STRUCTURAL PRESERVATION (Section 10) - SAME leg-origin-breach geometry the retired formula's
   //--- own structuralIntegrity already validated (100 while retracementRatio<=100 - the leg's own
   //--- origin, a natural geometric boundary, not invented - linear falloff to 0 by ratio=200), now
   //--- measured off retracementRatio (the closed-candle-based version) instead of the retired formula's
   //--- running-candle-based pullbackPct.
   ps.structuralPreservationScore = (ps.retracementRatio<=100.0) ? 100.0 : Clamp0to100(200.0-ps.retracementRatio);

   //--- CHOPPY PROTECTION (Section 12) - explicit, dedicated factor (not merely implicit via
   //--- directionalConsistency5 alone). A gross-heavy/net-light 5-bar sequence (UP/DOWN/UP/DOWN/UP style
   //--- alternation) is exactly CHOPPY's own domain, not PULLBACK's - reuses the SAME gross/net
   //--- inefficiency TECHNIQUE CHOPPY's own grossNetInefficiencyScore established (independent
   //--- computation, not a call into CHOPPY's own struct/function - no cross-DNA dependency), but reads
   //--- it in PULLBACK's own INVERTED sense: HIGH gross-vs-net inefficiency (two-sided, no net progress)
   //--- REDUCES choppyProtectionScore, since a genuine retracement is expected to show net progress
   //--- (counter-trend displacement), unlike a fully alternating chop that cancels to near-zero net.
   double netToGross = SafeDiv(MathAbs(net), gross, 1.0); // gross==0 (flat) -> 1.0, matches CHOPPY's own zero-denominator convention
   ps.choppyProtectionScore = Clamp0to100(netToGross*100.0); // HIGH net-to-gross ratio = genuine directional retracement, LOW = choppy alternation

   //--- FINAL (Section 15) - weighted sum of independent 0..100 components under THREE mandatory
   //--- multiplicative gates. trendContextScore gates on "was there ever an established directional
   //--- trend to retrace FROM" (Section 2's own explicit definition) - the retired formula's own
   //--- multiplicative philosophy, preserved. directionalConsistency5 is the SECOND mandatory gate - "is
   //--- a counter-trend move actually happening RIGHT NOW" (Section 13's own explicit requirement: "a
   //--- clean directional continuation must not score as a strong PULLBACK").
   //---
   //--- ROOT-CAUSE NOTE (first live run, 2026-09-04): TEST4/TEST5 (clean 5-bar continuation, zero
   //--- counter-trend bars) failed with finalScore=65.9 against a <40 expectation, despite
   //--- directionalConsistency5 correctly reading 0.0. Investigation found structuralPreservationScore
   //--- (100 - the trend genuinely isn't broken) and choppyProtectionScore (100 - five same-direction
   //--- bars are, correctly, not choppy) both stayed HIGH on a pure continuation - genuinely correct
   //--- readings for THOSE two factors in isolation, but the ADDITIVE blend let them prop up finalScore
   //--- even with zero actual retracement evidence, since only trendContextScore (not
   //--- directionalConsistency5) was gating multiplicatively. Fixed by promoting directionalConsistency5
   //--- to a second mandatory multiplicative gate.
   //---
   //--- ROOT-CAUSE NOTE 2 (PULLBACK PHASE 2, live run 2026-09-04, TEST28 reversal-protection): a genuine
   //--- counter-trend move WITH a deep structural breach (structuralPreservationScore=0.0, a full
   //--- reversal past the leg's own origin) still routed pullbackUp=58.11 against a <20 expectation. Same
   //--- root cause as TEST4/5 above, one level deeper: structuralPreservationScore was only a 0.25-weighted
   //--- ADDITIVE term, so even a complete collapse to 0 could remove at most 25 points from the blend -
   //--- persistenceScore/choppyProtectionScore/candleQualityScore/volumePipScore (all genuinely high on
   //--- this fixture, since real counter-trend bars ARE present) still summed to ~58. This directly
   //--- violates Section 10/14's own explicit "a pullback that destroys the directional structure should
   //--- receive a SUBSTANTIALLY reduced score" / "large counter-move + structural break... should reduce
   //--- PULLBACK substantially" requirements - a genuine formula gap, not a test-fixture defect (TEST28's
   //--- own <20 threshold is a reasonable, deliberately strict reading of "substantially reduced"). Fixed
   //--- by promoting structuralPreservationScore to a THIRD mandatory multiplicative gate, symmetric with
   //--- directionalConsistency5's own fix - a broken structure can no longer be compensated for by
   //--- persistence/choppy-protection/candle-quality/volume-pip, exactly as a missing counter-trend move
   //--- can no longer be compensated for by trend-context/structure/quality alone.
   double additiveBlend = Clamp0to100(
      ps.persistenceScore*0.45 + ps.choppyProtectionScore*0.25 +
      ps.candleQualityScore*0.15 + ps.volumePipScore*0.15);
   ps.finalScore = Clamp0to100((ps.trendContextScore/100.0) * (ps.directionalConsistency5/100.0) *
      (ps.structuralPreservationScore/100.0) * additiveBlend);

   ps.valid = true;
   ps.reasoning = StringFormat("contextBars=%d trendDir=%s trendContext=%.1f retracementRatio=%.1f persistence=%.1f structPreserve=%.1f choppyProtect=%.1f candleQuality=%.1f volumePip=%.1f(%s) final=%.1f",
      ps.contextBars, DirName(ps.trendDirection), ps.trendContextScore, ps.retracementRatio, ps.persistenceScore,
      ps.structuralPreservationScore, ps.choppyProtectionScore, ps.candleQualityScore, ps.volumePipScore, ps.volumePipRegime, ps.finalScore);
   return ps;
  }

//--- Live diagnostic writer - throttled, writes to a NEW, dedicated file pullback_dna.jsonl, mirroring
//--- LogStrongTrendDna()/LogWeakTrendDna()/LogChoppyDna()/LogNeutralDna()/LogVolatilityDna()'s own
//--- convention. NEVER read by any trading decision - purely to confirm this IS the production
//--- calculation actually feeding scores[LDNA_PULLBACK_UP]/scores[LDNA_PULLBACK_DOWN].
//---
//--- 2026-09-04, explicit operator request (PULLBACK PHASE 2): extended with pullbackDirection (alias of
//--- trendDirection, per Section 13's own exact field-name list) + pullbackUpScore/pullbackDownScore -
//--- the SAME routing logic EvaluateMarketDNA()'s own wiring uses, recomputed here read-only for
//--- diagnostic transparency (never a second/independent routing decision).
datetime g_pullbackLogLastTime = 0;
void LogPullbackDna(const PullbackStructure &ps)
  {
   if(!Inp_DashboardLogEnabled) return;
   if(TimeCurrent()==g_pullbackLogLastTime) return;
   g_pullbackLogLastTime = TimeCurrent();

   double pullbackUpScore   = (ps.valid && ps.trendDirection==LDIR_BUY)  ? ps.finalScore : 0.0;
   double pullbackDownScore = (ps.valid && ps.trendDirection==LDIR_SELL) ? ps.finalScore : 0.0;

   string line = StringFormat(
      "{\"time\":\"%s\",\"symbol\":\"%s\",\"valid\":%s,\"barTime\":\"%s\",\"contextBars\":%d,"
      "\"pullbackDirection\":\"%s\",\"trendDirection\":\"%s\",\"pullbackUpScore\":%.2f,\"pullbackDownScore\":%.2f,"
      "\"trendContextScore\":%.2f,\"precedingImpulsePips\":%.3f,"
      "\"retracementPips\":%.3f,\"retracementRatio\":%.2f,\"netDisplacementPips5\":%.3f,"
      "\"grossDisplacementPips5\":%.3f,\"directionalConsistency5\":%.2f,\"avgBodyRatio5\":%.2f,"
      "\"followThroughScore\":%.2f,\"persistenceScore\":%.2f,\"latestBodyRatio\":%.2f,"
      "\"candleQualityScore\":%.2f,\"haveRvol\":%s,\"rvol\":%.4f,\"relativeRange\":%.4f,"
      "\"volumePipRegime\":\"%s\",\"volumePipScore\":%.2f,\"structuralPreservationScore\":%.2f,"
      "\"choppyProtectionScore\":%.2f,\"finalScore\":%.2f}",
      DashIsoTime(TimeCurrent()), g_symbol, ps.valid?"true":"false", DashIsoTime(ps.barTime), ps.contextBars,
      DirName(ps.trendDirection), DirName(ps.trendDirection), pullbackUpScore, pullbackDownScore,
      ps.trendContextScore, ps.precedingImpulsePips,
      ps.retracementPips, ps.retracementRatio, ps.netDisplacementPips5,
      ps.grossDisplacementPips5, ps.directionalConsistency5, ps.avgBodyRatio5,
      ps.followThroughScore, ps.persistenceScore, ps.latestBodyRatio,
      ps.candleQualityScore, ps.haveRvol?"true":"false", ps.rvol, ps.relativeRange,
      ps.volumePipRegime, ps.volumePipScore, ps.structuralPreservationScore,
      ps.choppyProtectionScore, ps.finalScore);
   DashAppendLine("pullback_dna.jsonl", line);
  }

//--- 2026-09-04, explicit operator request (FULL MARKET DNA CONSOLIDATION):
//--- EvaluateFalseBreakoutStructure() and its FalseBreakoutStructure are FULLY REMOVED (FALSE_BREAKOUT
//--- DNA state deleted) - source-audited before removal to confirm zero remaining consumers.

//--- 2026-09-04, explicit operator request (FULL MARKET DNA CONSOLIDATION): EvaluateAccumulationStructure()
//--- and its AccumulationStructure, and EvaluateDistributionStructure()/DistributionStructure, are FULLY
//--- REMOVED (ACCUMULATION and DISTRIBUTION DNA states deleted) - source-audited before removal to
//--- confirm zero remaining consumers.

//--- 2026-09-08, explicit operator request (MARKET DNA STATE REMOVAL): EvaluateExpansionStructure()/
//--- EvaluateCompressionStructure() (the live evaluators for the now fully-removed EXPANSION/
//--- COMPRESSION states) are FULLY REMOVED - zero remaining consumers (source-audited before removal).

//--- Live evaluator - mirrors EvaluateStrongTrendStructure()/EvaluateWeakTrendStructure()/
//--- EvaluateChoppyStructure()/EvaluateNeutralStructure()'s own established pattern EXACTLY. Takes the
//--- ALREADY-BUILT 30-candle window (win[]/gotWin from BuildMarketDnaWindow30()) - zero duplicate
//--- CopyRates/BuildMarketDnaWindow30/ComputeVolumeDna calls, zero new pip/volume formula.
VolExpansionStructure EvaluateVolExpansionStructure(const PriceRangeDnaResult &win[], const int gotWin)
  {
   VolExpansionStructure vs;
   vs.valid=false; vs.reasoning=""; vs.barTime=0; vs.contextBars=0;
   vs.latestRelativeRange=0.0; vs.avgRelativeRange5=0.0; vs.expansionPersistenceScore=0.0;
   vs.expansionTrendScore=0.0; vs.latestBarScore=0.0; vs.fiveBarExpansionScore=0.0;
   vs.haveRvol=false; vs.rvol=0.0; vs.volumePipRegime="UNKNOWN"; vs.volumePipScore=0.0; vs.finalScore=0.0;

   const int KMIE_VOLEXP_CONTEXT_BARS = 25; // 2026-09-09, explicit operator request ("make all DNA use 25 bars"): 15 -> 25 (was 25 -> 15 on 2026-09-08)
   const int KMIE_VOLEXP_PERSISTENCE_BARS = 5;
   if(gotWin < KMIE_VOLEXP_CONTEXT_BARS)
     {
      vs.reasoning = StringFormat("insufficient closed-candle context (have=%d need=%d)", gotWin, KMIE_VOLEXP_CONTEXT_BARS);
      return vs;
     }
   for(int i=0;i<KMIE_VOLEXP_CONTEXT_BARS;i++)
      if(!win[i].valid)
        {
         vs.reasoning = StringFormat("candle at context index %d invalid (%s)", i, win[i].reasoning);
         return vs;
        }
   vs.contextBars = KMIE_VOLEXP_CONTEXT_BARS;
   vs.barTime = win[0].barTime;

   double relRange5[5];
   double sumRelRange=0.0; int aboveBaseline=0;
   for(int i=0;i<KMIE_VOLEXP_PERSISTENCE_BARS;i++)
     {
      relRange5[i] = (win[i].rangeClass!="UNKNOWN") ? win[i].relativeRange : 0.0;
      sumRelRange += relRange5[i];
      if(relRange5[i]>1.0) aboveBaseline++;
     }
   vs.avgRelativeRange5 = sumRelRange/KMIE_VOLEXP_PERSISTENCE_BARS;
   vs.latestRelativeRange = relRange5[0];

   //--- EXPANSION PERSISTENCE (Section 3 - "recent 5-bar expansion persistence... do NOT classify a
   //--- single large candle as sufficient by itself") - % of the 5 bars individually exceeding the
   //--- 20-bar baseline, the SAME structural-protection technique VOLATILE's own persistenceScore
   //--- already established (a single isolated spike among 4 normal bars scores LOW here).
   vs.expansionPersistenceScore = Clamp0to100((aboveBaseline/(double)KMIE_VOLEXP_PERSISTENCE_BARS)*100.0);

   //--- EXPANSION TREND - is the window trending toward MORE expansion (newer bars larger than older
   //--- ones), not merely "currently elevated". Compares the newest half of the 5-bar window (indices
   //--- 0-1) against the oldest half (indices 3-4), index 2 as the midpoint - genuine trend direction,
   //--- distinct from persistence (which only counts, never orders).
   double newerAvg = (relRange5[0]+relRange5[1])/2.0;
   double olderAvg = (relRange5[3]+relRange5[4])/2.0;
   double trendRatio = SafeDiv(newerAvg, MathMax(olderAvg,0.01), 1.0);
   vs.expansionTrendScore = Clamp0to100(50.0*trendRatio); // newer==older -> 50, newer 2x older -> 100

   //--- LATEST-BAR CONTRIBUTION - weighted but never exclusive (Section 3's own explicit requirement).
   //--- Same relativeRange->score conversion style STRONG_TREND's own relRangeForceComponent uses.
   vs.latestBarScore = Clamp0to100(50.0*vs.latestRelativeRange);

   //--- FIVE-BAR EXPANSION SCORE - the dominant term, combining persistence (mandatory multi-bar
   //--- evidence) with trend+latest-bar (magnitude/direction refinement). Multiplicative on persistence
   //--- so an isolated single-candle spike (persistence=20, only 1/5 bars above baseline) cannot reach a
   //--- high score merely from a large latestBarScore (Section 3 TEST2's own explicit requirement).
   double magnitudeBlend = Clamp0to100(vs.expansionTrendScore*0.5 + vs.latestBarScore*0.5);
   vs.fiveBarExpansionScore = Clamp0to100((vs.expansionPersistenceScore/100.0)*magnitudeBlend); // persistence-scaled magnitude

   //--- VOLUME x PIP CONFIRMATION (Section 3's own explicit regime mapping) - reuses the EXISTING,
   //--- untouched ComputeVolumeDna()/ClassifyVolumePipRegime(). EFFICIENT_EXPANSION strongly supports;
   //--- EFFORT_WITHOUT_RESULT reduces quality (effort without real range confirmation); THIN_MOVEMENT/
   //--- COMPRESSION strongly reduce (exactly the ordering Section 3 specifies).
   VolumeDnaResult vr = ComputeVolumeDna(PERIOD_M1, KMIE_VOLUME_DNA_BASELINE_BARS);
   vs.haveRvol = vr.valid && (vr.volumeClass!="UNKNOWN");
   vs.rvol = vs.haveRvol ? vr.relativeVolume : 0.0;
   bool haveRelRangeForRegime = (win[0].rangeClass!="UNKNOWN");
   vs.volumePipRegime = ClassifyVolumePipRegime(haveRelRangeForRegime, vs.latestRelativeRange, vs.haveRvol, vs.rvol);
   if(vs.volumePipRegime=="EFFICIENT_EXPANSION")
      vs.volumePipScore = Clamp0to100(60.0 + 20.0*MathMin(vs.rvol/1.60,2.0));
   else if(vs.volumePipRegime=="EFFORT_WITHOUT_RESULT")
      vs.volumePipScore = 30.0; // effort present but range not confirming - reduced quality
   else if(vs.volumePipRegime=="THIN_MOVEMENT")
      vs.volumePipScore = 15.0; // range elevated on thin participation - strongly reduced
   else if(vs.volumePipRegime=="COMPRESSION")
      vs.volumePipScore = 5.0;  // low volume + low range - the opposite of expansion, strongly reduced
   else
      vs.volumePipScore = 25.0; // UNKNOWN - neutral-low, never fabricated

   //--- FINAL (Section 3's own recommended weighting: recent expansion/persistence + latest-bar +
   //--- volume-pip confirmation). fiveBarExpansionScore dominant, volumePipScore a meaningful supporting
   //--- term - matching this file's established "one dominant + supporting" convention.
   vs.finalScore = Clamp0to100(vs.fiveBarExpansionScore*0.70 + vs.volumePipScore*0.30);

   vs.valid = true;
   vs.reasoning = StringFormat("contextBars=%d persistence=%.1f trend=%.1f latestBar=%.1f fiveBar=%.1f volumePip=%.1f(%s) final=%.1f",
      vs.contextBars, vs.expansionPersistenceScore, vs.expansionTrendScore, vs.latestBarScore,
      vs.fiveBarExpansionScore, vs.volumePipScore, vs.volumePipRegime, vs.finalScore);
   return vs;
  }

VolCompressionStructure EvaluateVolCompressionStructure(const PriceRangeDnaResult &win[], const int gotWin)
  {
   VolCompressionStructure vc;
   vc.valid=false; vc.reasoning=""; vc.barTime=0; vc.contextBars=0;
   vc.latestRelativeRange=0.0; vc.avgRelativeRange5=0.0; vc.contractionPersistenceScore=0.0;
   vc.contractionTrendScore=0.0; vc.latestBarScore=0.0; vc.fiveBarContractionScore=0.0;
   vc.haveRvol=false; vc.rvol=0.0; vc.volumePipRegime="UNKNOWN"; vc.volumePipScore=0.0; vc.finalScore=0.0;

   const int KMIE_VOLCOMP_CONTEXT_BARS = 25; // 2026-09-09, explicit operator request ("make all DNA use 25 bars"): 15 -> 25 (was 25 -> 15 on 2026-09-08)
   const int KMIE_VOLCOMP_PERSISTENCE_BARS = 5;
   if(gotWin < KMIE_VOLCOMP_CONTEXT_BARS)
     {
      vc.reasoning = StringFormat("insufficient closed-candle context (have=%d need=%d)", gotWin, KMIE_VOLCOMP_CONTEXT_BARS);
      return vc;
     }
   for(int i=0;i<KMIE_VOLCOMP_CONTEXT_BARS;i++)
      if(!win[i].valid)
        {
         vc.reasoning = StringFormat("candle at context index %d invalid (%s)", i, win[i].reasoning);
         return vc;
        }
   vc.contextBars = KMIE_VOLCOMP_CONTEXT_BARS;
   vc.barTime = win[0].barTime;

   double relRange5[5];
   double sumRelRange=0.0; int belowBaseline=0;
   for(int i=0;i<KMIE_VOLCOMP_PERSISTENCE_BARS;i++)
     {
      relRange5[i] = (win[i].rangeClass!="UNKNOWN") ? win[i].relativeRange : 1.0; // UNKNOWN defaults to 1.0 (baseline-neutral), never fabricated as compressed
      sumRelRange += relRange5[i];
      if(relRange5[i]<1.0) belowBaseline++;
     }
   vc.avgRelativeRange5 = sumRelRange/KMIE_VOLCOMP_PERSISTENCE_BARS;
   vc.latestRelativeRange = relRange5[0];

   //--- CONTRACTION PERSISTENCE (Section 4 - "compression must be persistent across the recent 5-bar
   //--- behavior... do NOT classify one small candle as compression") - % of the 5 bars individually
   //--- BELOW the 20-bar baseline.
   vc.contractionPersistenceScore = Clamp0to100((belowBaseline/(double)KMIE_VOLCOMP_PERSISTENCE_BARS)*100.0);

   //--- CONTRACTION TREND - is the window trending toward LESS range (newer bars smaller than older
   //--- ones) - mirror of VOL_EXPANSION's own trend measurement, inverted sense.
   double newerAvg = (relRange5[0]+relRange5[1])/2.0;
   double olderAvg = (relRange5[3]+relRange5[4])/2.0;
   double trendRatio = SafeDiv(olderAvg, MathMax(newerAvg,0.01), 1.0); // inverted vs VOL_EXPANSION: older/newer, so shrinking ranges score HIGH
   vc.contractionTrendScore = Clamp0to100(50.0*trendRatio);

   //--- LATEST-BAR CONTRIBUTION - weighted but never exclusive. Inverted relativeRange->score conversion
   //--- (LOW relativeRange -> HIGH score).
   vc.latestBarScore = Clamp0to100(100.0-50.0*vc.latestRelativeRange);

   //--- FIVE-BAR CONTRACTION SCORE - the dominant term, persistence-scaled (mirrors VOL_EXPANSION's own
   //--- structural-protection technique).
   double magnitudeBlend = Clamp0to100(vc.contractionTrendScore*0.5 + vc.latestBarScore*0.5);
   vc.fiveBarContractionScore = Clamp0to100((vc.contractionPersistenceScore/100.0)*magnitudeBlend);

   //--- VOLUME PARTICIPATION CONFIRMATION (Section 4's own explicit "reduced/contracting volume
   //--- participation where supported by the canonical volume measurement" + "the existing COMPRESSION
   //--- regime... may be used as confirmation, but do not simply map one existing regime directly to the
   //--- DNA score" - so COMPRESSION regime is one input among several here, not a direct pass-through).
   VolumeDnaResult vr = ComputeVolumeDna(PERIOD_M1, KMIE_VOLUME_DNA_BASELINE_BARS);
   vc.haveRvol = vr.valid && (vr.volumeClass!="UNKNOWN");
   vc.rvol = vc.haveRvol ? vr.relativeVolume : 0.0;
   bool haveRelRangeForRegime = (win[0].rangeClass!="UNKNOWN");
   vc.volumePipRegime = ClassifyVolumePipRegime(haveRelRangeForRegime, vc.latestRelativeRange, vc.haveRvol, vc.rvol);
   if(vc.volumePipRegime=="COMPRESSION")
      vc.volumePipScore = Clamp0to100(60.0 + 20.0*MathMax(0.0, 1.0-MathMin(vc.rvol/1.60,1.0))); // low volume reinforces compression confidence
   else if(vc.volumePipRegime=="THIN_MOVEMENT")
      vc.volumePipScore = 40.0; // low volume, but range not confirming below-baseline - partial support
   else if(vc.volumePipRegime=="EFFORT_WITHOUT_RESULT")
      vc.volumePipScore = 20.0; // high effort contradicts genuine compression
   else if(vc.volumePipRegime=="EFFICIENT_EXPANSION")
      vc.volumePipScore = 5.0;  // real directional displacement - the opposite of compression, strongly reduced
   else
      vc.volumePipScore = 25.0; // UNKNOWN - neutral-low, never fabricated

   //--- FINAL (Section 4's own recommended weighting).
   vc.finalScore = Clamp0to100(vc.fiveBarContractionScore*0.70 + vc.volumePipScore*0.30);

   vc.valid = true;
   vc.reasoning = StringFormat("contextBars=%d persistence=%.1f trend=%.1f latestBar=%.1f fiveBar=%.1f volumePip=%.1f(%s) final=%.1f",
      vc.contextBars, vc.contractionPersistenceScore, vc.contractionTrendScore, vc.latestBarScore,
      vc.fiveBarContractionScore, vc.volumePipScore, vc.volumePipRegime, vc.finalScore);
   return vc;
  }

//--- 2026-09-04, explicit operator request (VOLATILE production upgrade): HIGH/UNSTABLE volatility -
//--- NOT "high volatility = STRONG TREND" (Section 5's own critical distinction). Rebuilt on the SAME
//--- closed-M1 25-bar/5-bar architecture, structurally eliminating the prior formula's own shift-0
//--- CopyRates(...,0,1,...) read.
VolatileStructure EvaluateVolatileStructure(const PriceRangeDnaResult &win[], const int gotWin)
  {
   VolatileStructure v;
   v.valid=false; v.reasoning=""; v.barTime=0; v.contextBars=0;
   v.avgRelativeRange5=0.0; v.magnitudeScore=0.0; v.rangeVariabilityScore=0.0;
   v.directionalConsistencyScore=0.0; v.instabilityScore=0.0;
   v.haveRvol=false; v.rvol=0.0; v.participationScore=0.0; v.finalScore=0.0;

   const int KMIE_VOLATILE_CONTEXT_BARS = 25; // 2026-09-09, explicit operator request ("make all DNA use 25 bars"): 15 -> 25 (was 25 -> 15 on 2026-09-08)
   const int KMIE_VOLATILE_PERSISTENCE_BARS = 5;
   if(gotWin < KMIE_VOLATILE_CONTEXT_BARS)
     {
      v.reasoning = StringFormat("insufficient closed-candle context (have=%d need=%d)", gotWin, KMIE_VOLATILE_CONTEXT_BARS);
      return v;
     }
   for(int i=0;i<KMIE_VOLATILE_CONTEXT_BARS;i++)
      if(!win[i].valid)
        {
         v.reasoning = StringFormat("candle at context index %d invalid (%s)", i, win[i].reasoning);
         return v;
        }
   v.contextBars = KMIE_VOLATILE_CONTEXT_BARS;
   v.barTime = win[0].barTime;

   double relRange5[5];
   double rangePips5[5];
   double signedMove5[5];
   double sumRelRange=0.0;
   for(int i=0;i<KMIE_VOLATILE_PERSISTENCE_BARS;i++)
     {
      relRange5[i]   = (win[i].rangeClass!="UNKNOWN") ? win[i].relativeRange : 0.0;
      rangePips5[i]  = win[i].rangePips;
      signedMove5[i] = win[i].signedCloseToClosePips;
      sumRelRange += relRange5[i];
     }
   v.avgRelativeRange5 = sumRelRange/KMIE_VOLATILE_PERSISTENCE_BARS;

   //--- A. MAGNITUDE - ABSOLUTE elevated range vs the 20-bar baseline, averaged over the 5-bar window
   //--- (NOT one candle - the SAME structural difference from VOLATILITY_EXPANSION the retired formula's
   //--- own header already established, preserved here).
   v.magnitudeScore = Clamp0to100(v.avgRelativeRange5>1.0 ? (v.avgRelativeRange5-1.0)*100.0 : 0.0);

   //--- B. RANGE VARIABILITY - coefficient-of-variation of the 5-bar rangePips (irregular SIZE) - SAME
   //--- technique the retired formula's own dispersionScore used, recomputed on the canonical rangePips
   //--- field instead of a locally-recomputed high-low.
   double meanR=0.0;
   for(int i=0;i<KMIE_VOLATILE_PERSISTENCE_BARS;i++) meanR+=rangePips5[i];
   meanR/=KMIE_VOLATILE_PERSISTENCE_BARS;
   double varR=0.0;
   for(int i=0;i<KMIE_VOLATILE_PERSISTENCE_BARS;i++) varR += (rangePips5[i]-meanR)*(rangePips5[i]-meanR);
   varR/=KMIE_VOLATILE_PERSISTENCE_BARS;
   double stdevR = MathSqrt(varR);
   double cv = SafeDiv(stdevR, MathMax(meanR,_Point), 0.0);
   v.rangeVariabilityScore = Clamp0to100(cv*100.0);

   //--- C. DIRECTIONAL CONSISTENCY - the SAME metric STRONG_TREND/WEAK_TREND compute (fraction of the 5
   //--- bars agreeing with the net 5-bar direction). VOLATILE is the MIRROR read: LOW consistency
   //--- (poor directional persistence) is what distinguishes it from STRONG_TREND (Section 5/K's own
   //--- critical "large movement without clean directional persistence should favor VOLATILE rather than
   //--- STRONG_TREND" requirement).
   double netMove5=0.0;
   int bullBars=0, bearBars=0, neutralBars=0;
   for(int i=0;i<KMIE_VOLATILE_PERSISTENCE_BARS;i++)
     {
      netMove5 += signedMove5[i];
      if(signedMove5[i]>0.0) bullBars++; else if(signedMove5[i]<0.0) bearBars++; else neutralBars++;
     }
   ENUM_LITE_DIR netDir5 = (netMove5>0.0) ? LDIR_BUY : (netMove5<0.0) ? LDIR_SELL : LDIR_WAIT;
   int agreeCount = (netDir5==LDIR_BUY) ? bullBars : (netDir5==LDIR_SELL) ? bearBars : neutralBars;
   v.directionalConsistencyScore = Clamp0to100((agreeCount/(double)KMIE_VOLATILE_PERSISTENCE_BARS)*100.0);

   //--- INSTABILITY - blend of range variability (irregular SIZE) and directional INCONSISTENCY
   //--- (100-consistency, irregular DIRECTION) - the SAME two-factor blend the retired formula's own
   //--- flipRate+dispersionScore already established, with directional consistency now reusing the
   //--- SAME canonical metric STRONG_TREND/WEAK_TREND compute instead of a locally-recomputed flip-rate.
   v.instabilityScore = Clamp0to100((v.rangeVariabilityScore + (100.0-v.directionalConsistencyScore))/2.0);

   //--- VOLUME PARTICIPATION (Section 5's own "elevated volume participation where applicable") -
   //--- context, not a mandatory gate - reuses the EXISTING, untouched ComputeVolumeDna().
   VolumeDnaResult vr = ComputeVolumeDna(PERIOD_M1, KMIE_VOLUME_DNA_BASELINE_BARS);
   v.haveRvol = vr.valid && (vr.volumeClass!="UNKNOWN");
   v.rvol = v.haveRvol ? vr.relativeVolume : 0.0;
   v.participationScore = v.haveRvol ? Clamp0to100(50.0*v.rvol) : 25.0;

   //--- FINAL: magnitude AND instability are a MANDATORY multiplicative AND-gate (Section 5/K's own
   //--- "should NOT automatically become STRONG_TREND" requirement, enforced structurally - large range
   //--- WITH clean directional persistence produces LOW instability, which collapses this score toward
   //--- zero regardless of how large magnitudeScore reads, leaving STRONG_TREND free to compete normally
   //--- on that same input per Section 5's own worked example). Participation modulates in a 0.5x-1.0x
   //--- range, never fully zeroing the score - same modulation style the retired formula already used.
   double base = (v.magnitudeScore/100.0) * (v.instabilityScore/100.0);
   double multiplier = 0.5 + 0.5*(v.participationScore/100.0);
   v.finalScore = Clamp0to100(base*multiplier*100.0);

   v.valid = true;
   v.reasoning = StringFormat("contextBars=%d magnitude=%.1f variability=%.1f consistency=%.1f instability=%.1f participation=%.1f final=%.1f",
      v.contextBars, v.magnitudeScore, v.rangeVariabilityScore, v.directionalConsistencyScore,
      v.instabilityScore, v.participationScore, v.finalScore);
   return v;
  }

//--- Live diagnostic writer - throttled, writes to a NEW, dedicated file volatility_dna.jsonl, mirroring
//--- LogStrongTrendDna()/LogWeakTrendDna()/LogChoppyDna()/LogNeutralDna()'s own convention. NEVER read by
//--- any trading decision - purely to confirm this IS the production calculation actually feeding
//--- scores[LDNA_VOLATILITY_EXPANSION]/scores[LDNA_VOLATILITY_COMPRESSION]/scores[LDNA_VOLATILE].
datetime g_volatilityLogLastTime = 0;
void LogVolatilityDna(const VolExpansionStructure &ve, const VolCompressionStructure &vc, const VolatileStructure &vt)
  {
   if(!Inp_DashboardLogEnabled) return;
   if(TimeCurrent()==g_volatilityLogLastTime) return;
   g_volatilityLogLastTime = TimeCurrent();

   string line = StringFormat(
      "{\"time\":\"%s\",\"symbol\":\"%s\",\"barTime\":\"%s\",\"contextBars\":%d,"
      "\"volExpansion\":{\"valid\":%s,\"latestRelativeRange\":%.4f,\"avgRelativeRange5\":%.4f,"
      "\"expansionPersistenceScore\":%.2f,\"expansionTrendScore\":%.2f,\"latestBarScore\":%.2f,"
      "\"fiveBarExpansionScore\":%.2f,\"volumePipRegime\":\"%s\",\"volumePipScore\":%.2f,\"finalScore\":%.2f},"
      "\"volCompression\":{\"valid\":%s,\"latestRelativeRange\":%.4f,\"avgRelativeRange5\":%.4f,"
      "\"contractionPersistenceScore\":%.2f,\"contractionTrendScore\":%.2f,\"latestBarScore\":%.2f,"
      "\"fiveBarContractionScore\":%.2f,\"volumePipRegime\":\"%s\",\"volumePipScore\":%.2f,\"finalScore\":%.2f},"
      "\"volatile\":{\"valid\":%s,\"avgRelativeRange5\":%.4f,\"magnitudeScore\":%.2f,"
      "\"rangeVariabilityScore\":%.2f,\"directionalConsistencyScore\":%.2f,\"instabilityScore\":%.2f,"
      "\"haveRvol\":%s,\"rvol\":%.4f,\"participationScore\":%.2f,\"finalScore\":%.2f},"
      "\"selectedDna\":\"%s\",\"selectedScore\":%.2f}",
      DashIsoTime(TimeCurrent()), g_symbol, DashIsoTime(ve.barTime), ve.contextBars,
      ve.valid?"true":"false", ve.latestRelativeRange, ve.avgRelativeRange5,
      ve.expansionPersistenceScore, ve.expansionTrendScore, ve.latestBarScore,
      ve.fiveBarExpansionScore, ve.volumePipRegime, ve.volumePipScore, ve.finalScore,
      vc.valid?"true":"false", vc.latestRelativeRange, vc.avgRelativeRange5,
      vc.contractionPersistenceScore, vc.contractionTrendScore, vc.latestBarScore,
      vc.fiveBarContractionScore, vc.volumePipRegime, vc.volumePipScore, vc.finalScore,
      vt.valid?"true":"false", vt.avgRelativeRange5, vt.magnitudeScore,
      vt.rangeVariabilityScore, vt.directionalConsistencyScore, vt.instabilityScore,
      vt.haveRvol?"true":"false", vt.rvol, vt.participationScore, vt.finalScore,
      DnaName(g_dnaState), g_dnaScore);
   DashAppendLine("volatility_dna.jsonl", line);
  }

//--- 2026-09-04, explicit operator request (FULL MARKET DNA CONSOLIDATION): EvaluateQuietStructure()/
//--- QuietStructure (QUIET state) and EvaluateRangeStructure()/RangeStructure (RANGE state) are FULLY
//--- REMOVED - source-audited before removal to confirm zero remaining consumers.

//--- Live evaluator - mirrors EvaluateStrongTrendStructure()/EvaluateWeakTrendStructure()/
//--- EvaluateChoppyStructure()'s own established pattern EXACTLY. Takes the ALREADY-BUILT 30-candle
//--- window (win[]/gotWin from BuildMarketDnaWindow30(), called ONCE by EvaluateMarketDNA() and already
//--- reused for STRONG_TREND/STRONG_UPTREND/STRONG_DOWNTREND/WEAK_UPTREND/WEAK_DOWNTREND/CHOPPY) - zero
//--- duplicate CopyRates/BuildMarketDnaWindow30/ComputeVolumeDna calls, zero new pip/volume formula.
NeutralStructure EvaluateNeutralStructure(const PriceRangeDnaResult &win[], const int gotWin)
  {
   NeutralStructure ns;
   ns.valid=false; ns.reasoning=""; ns.barTime=0; ns.contextBars=0;
   ns.grossMovePips=0.0; ns.netMovePips=0.0; ns.netVsBaselineScore=0.0; ns.twoSidedGrossScore=0.0; ns.lowNetDisplacementScore=0.0;
   ns.bullBars5=0; ns.bearBars5=0; ns.directionalBalanceScore=0.0;
   ns.avgBullBodyPips5=0.0; ns.avgBearBodyPips5=0.0; ns.effortBalanceScore=0.0;
   ns.avgBodyRatio5=0.0; ns.avgCloseExtremity5=0.0; ns.candleCharacterScore=0.0;
   ns.haveRvol=false; ns.rvol=0.0; ns.haveRelativeRange=false; ns.relativeRange=0.0;
   ns.volumePipRegime="UNKNOWN"; ns.volumePipScore=0.0; ns.finalScore=0.0;

   //--- SAME data-sufficiency requirement as STRONG_TREND/WEAK_TREND/CHOPPY (Phase 4): 25 closed M1
   //--- bars, all individually valid, index 0 = latest CLOSED candle (shift 1), never the running candle.
   const int KMIE_NEUTRAL_CONTEXT_BARS = 25; // 2026-09-09, explicit operator request ("make all DNA use 25 bars"): 15 -> 25 (was 25 -> 15 on 2026-09-08)
   const int KMIE_NEUTRAL_PERSISTENCE_BARS = 5;
   if(gotWin < KMIE_NEUTRAL_CONTEXT_BARS)
     {
      ns.reasoning = StringFormat("insufficient closed-candle context (have=%d need=%d)", gotWin, KMIE_NEUTRAL_CONTEXT_BARS);
      return ns;
     }
   for(int i=0;i<KMIE_NEUTRAL_CONTEXT_BARS;i++)
      if(!win[i].valid)
        {
         ns.reasoning = StringFormat("candle at context index %d invalid (%s)", i, win[i].reasoning);
         return ns;
        }
   ns.contextBars = KMIE_NEUTRAL_CONTEXT_BARS;
   ns.barTime = win[0].barTime;

   //--- Shared 5-bar reads (indices 0..4, still entirely within the 25-bar closed context).
   double signedMove5[5];
   double bodyPips5[5];
   double bodyRatio5[5];
   double closeExtremity5[5];
   int bullBars=0, bearBars=0;
   double sumBullBody=0.0, sumBearBody=0.0;
   double sumBodyRatio=0.0, sumCloseExtremity=0.0;
   for(int i=0;i<KMIE_NEUTRAL_PERSISTENCE_BARS;i++)
     {
      signedMove5[i] = win[i].signedCloseToClosePips;
      bodyPips5[i]   = win[i].bodyPips;
      bodyRatio5[i]  = win[i].bodyRatio;
      closeExtremity5[i] = MathAbs(win[i].closeLocation-0.5)*200.0; // 0 at midpoint, 100 at either extreme
      sumBodyRatio += bodyRatio5[i];
      sumCloseExtremity += closeExtremity5[i];
      if(signedMove5[i]>0.0)      { bullBars++; sumBullBody += bodyPips5[i]; }
      else if(signedMove5[i]<0.0) { bearBars++; sumBearBody += bodyPips5[i]; }
     }
   ns.bullBars5 = bullBars;
   ns.bearBars5 = bearBars;
   ns.avgBodyRatio5 = sumBodyRatio/KMIE_NEUTRAL_PERSISTENCE_BARS;
   ns.avgCloseExtremity5 = sumCloseExtremity/KMIE_NEUTRAL_PERSISTENCE_BARS;
   ns.avgBullBodyPips5 = (bullBars>0) ? sumBullBody/bullBars : 0.0;
   ns.avgBearBodyPips5 = (bearBars>0) ? sumBearBody/bearBars : 0.0;

   //--- A. LOW NET DIRECTIONAL DISPLACEMENT (Phase 5A) - gross/net technique reused from CHOPPY
   //--- (sum(|move|) vs |sum(move)|), but interpreted OPPOSITELY: CHOPPY rewards gross-with-low-net AS
   //--- inefficiency evidence toward two-sided noise; NEUTRAL rewards the SAME shape only when net
   //--- displacement is LOW RELATIVE TO THE 20-BAR BASELINE *and* gross movement is still MEANINGFUL
   //--- (not near-zero) - explicitly distinguishing "balanced two-sided market" from "nothing is
   //--- happening" (Phase 5A's own "do NOT treat simply small movement as automatically neutral").
   double gross=0.0;
   for(int i=0;i<KMIE_NEUTRAL_PERSISTENCE_BARS;i++) gross += MathAbs(signedMove5[i]);
   double netMove5Telescoped=0.0;
   for(int i=0;i<KMIE_NEUTRAL_PERSISTENCE_BARS;i++) netMove5Telescoped += signedMove5[i];
   double net = MathAbs(netMove5Telescoped);
   ns.grossMovePips = gross;
   ns.netMovePips = net;
   double baseline = MathMax(win[0].avgRangePips20, _Point);
   //--- netVsBaselineScore: net displacement as a fraction of 5x the 20-bar baseline range (SAME
   //--- normalization STRONG_TREND's own persistenceScore net-displacement term uses) - LOW net earns a
   //--- HIGH score here (inverted sense vs STRONG_TREND, which rewards HIGH net).
   double netRatio = SafeDiv(net, baseline*5.0, 0.0);
   ns.netVsBaselineScore = Clamp0to100(100.0-Clamp0to100(netRatio*100.0));
   //--- twoSidedGrossScore: gross movement must be MEANINGFUL relative to the SAME baseline - scaled so
   //--- gross==1x the 5-bar baseline (i.e. average-sized bars, just cancelling out) lands at 50, saturating
   //--- toward 100 by 2x - a market with near-zero gross (Scenario: genuinely still/compressed) scores LOW
   //--- here, correctly excluding COMPRESSION/QUIET from earning NEUTRAL via this component.
   double grossRatio = SafeDiv(gross, baseline*5.0, 0.0);
   ns.twoSidedGrossScore = Clamp0to100(50.0*grossRatio);
   //--- lowNetDisplacementScore: BOTH conditions must hold - low net AND meaningful gross - multiplicative,
   //--- not additive, so a near-zero-gross (compressed) market cannot earn a high score merely from
   //--- netVsBaselineScore defaulting high when nothing moved at all.
   ns.lowNetDisplacementScore = Clamp0to100((ns.netVsBaselineScore/100.0)*(ns.twoSidedGrossScore/100.0)*100.0);

   //--- B. DIRECTIONAL BALANCE (Phase 5B) - bull/bear BAR COUNT balance, independent of which side the
   //--- net move happens to favor (distinct from STRONG/WEAK_TREND/CHOPPY's "consistency WITH net
   //--- direction" metric, which is direction-agnostic in a DIFFERENT sense - it asks "do bars agree with
   //--- the net outcome", not "are the two sides balanced"). A 5-bar window cannot split perfectly 50/50
   //--- (odd length) - the closest achievable balance is 3-2, scored as the max attainable 100.
   int strongerSide = MathMax(bullBars, bearBars);
   int weakerSide = MathMin(bullBars, bearBars);
   int totalDirectional = bullBars+bearBars;
   double imbalance = (totalDirectional>0) ? SafeDiv((double)(strongerSide-weakerSide), (double)totalDirectional, 0.0) : 0.0;
   ns.directionalBalanceScore = Clamp0to100(100.0-imbalance*100.0);

   //--- C. BUY/SELL EFFORT BALANCE (Phase 5C) - average bullish-bar body pips vs average bearish-bar
   //--- body pips. Only meaningful when BOTH sides have at least one bar (Phase 5C: "where canonical
   //--- candle measurements permit it") - defaults to a neutral-low 50 when one side is entirely absent
   //--- (a fully one-sided 5-bar run has no opposing effort to compare against, which the directional
   //--- balance component above already penalizes independently).
   if(bullBars>0 && bearBars>0)
     {
      double largerEffort = MathMax(ns.avgBullBodyPips5, ns.avgBearBodyPips5);
      double smallerEffort = MathMin(ns.avgBullBodyPips5, ns.avgBearBodyPips5);
      double effortRatio = SafeDiv(smallerEffort, largerEffort, 1.0); // both zero (flat bars) -> 1.0, fully balanced by definition
      ns.effortBalanceScore = Clamp0to100(effortRatio*100.0);
     }
   else
      ns.effortBalanceScore = 50.0; // no opposing side to compare - neutral-low, never fabricated as balanced

   //--- D. BODY/WICK CHARACTER (Phase 5D) - "NEUTRAL should not require every candle to have tiny
   //--- bodies... a balanced sequence of meaningful bullish and bearish candles may still be neutral."
   //--- Scored as a MODERATE-body preference (peaks near bodyRatio~50, the least "extreme" reading in
   //--- either direction - a near-0 bodyRatio is rejection/wick-heavy noise CHOPPY's own domain, a
   //--- near-100 bodyRatio is clean-conviction STRONG_TREND's own domain), combined with non-extreme
   //--- close location (candles closing mid-range rather than at either extreme - genuine indecision,
   //--- not a directional push). Deliberately NOT a "small body" requirement (would wrongly favor
   //--- COMPRESSION/QUIET instead).
   double bodyModerationScore = Clamp0to100(100.0-MathAbs(ns.avgBodyRatio5-50.0)*2.0); // 100 at bodyRatio==50, falls to 0 at either extreme (0 or 100)
   double closeModerationScore = Clamp0to100(100.0-ns.avgCloseExtremity5); // 100 at midpoint closes, 0 at extreme closes
   ns.candleCharacterScore = Clamp0to100(bodyModerationScore*0.55 + closeModerationScore*0.45);

   //--- E/F. VOLUME PARTICIPATION + VOLUME x PIP RELATIONSHIP (Phase 5E/5F) - reuses the EXISTING,
   //--- untouched ComputeVolumeDna()/ClassifyVolumePipRegime() STRONG_TREND/WEAK_TREND/CHOPPY already
   //--- use - zero new volume calculation, zero new regime logic. "Do NOT treat low volume alone as
   //--- neutral" / "low volume + low movement must not automatically become NEUTRAL" (Phase 5E/5F) -
   //--- COMPRESSION regime is explicitly NOT rewarded highly here, matching that instruction.
   VolumeDnaResult vr = ComputeVolumeDna(PERIOD_M1, KMIE_VOLUME_DNA_BASELINE_BARS);
   ns.haveRvol = vr.valid && (vr.volumeClass!="UNKNOWN");
   ns.rvol = ns.haveRvol ? vr.relativeVolume : 0.0;
   ns.haveRelativeRange = (win[0].rangeClass!="UNKNOWN");
   ns.relativeRange = ns.haveRelativeRange ? win[0].relativeRange : 0.0;
   ns.volumePipRegime = ClassifyVolumePipRegime(ns.haveRelativeRange, ns.relativeRange, ns.haveRvol, ns.rvol);
   //--- EFFORT_WITHOUT_RESULT (high participation, NOT producing net directional displacement) is the
   //--- strongest NEUTRAL-favoring regime - participation exists but is not creating directional edge,
   //--- directly matching Phase 5F's "high participation with near-balanced displacement can support
   //--- NEUTRAL". EFFICIENT_EXPANSION (participation producing REAL directional displacement) is
   //--- deliberately capped low - Phase 5F's explicit "high participation producing sustained directional
   //--- displacement must weaken NEUTRAL". COMPRESSION (low volume + low movement) is also capped low -
   //--- Phase 5F's explicit "must not automatically become NEUTRAL because that may belong to
   //--- QUIET/COMPRESSION".
   if(ns.volumePipRegime=="EFFORT_WITHOUT_RESULT")
      ns.volumePipScore = Clamp0to100(50.0 + 25.0*MathMin(ns.rvol/1.60,2.0));
   else if(ns.volumePipRegime=="THIN_MOVEMENT")
      ns.volumePipScore = 35.0; // some displacement on thin participation - mild NEUTRAL evidence at best
   else if(ns.volumePipRegime=="EFFICIENT_EXPANSION")
      ns.volumePipScore = 15.0; // real directional displacement with confirming volume - belongs to TREND, must weaken NEUTRAL
   else if(ns.volumePipRegime=="COMPRESSION")
      ns.volumePipScore = 20.0; // low volume + low movement - QUIET/COMPRESSION's own domain, not rewarded as NEUTRAL evidence
   else
      ns.volumePipScore = 25.0; // UNKNOWN (volume data unavailable) - neutral-low, never fabricated

   //--- FINAL (Phase 7) - weighted sum of independent 0..100 components. lowNetDisplacementScore is the
   //--- dominant term (the core "balanced despite real movement" evidence, Phase 2's own positive-evidence
   //--- requirement); directionalBalanceScore and candleCharacterScore are meaningful supporting terms;
   //--- effortBalanceScore and volumePipScore are secondary refinements - matching this file's established
   //--- "one dominant + supporting components" additive convention (STRONG_TREND 0.35/0.35/0.30, WEAK_TREND
   //--- 0.50/0.30/0.20, CHOPPY 0.55/0.20/0.25). Direction-neutral throughout - no BUY/SELL branch anywhere.
   ns.finalScore = Clamp0to100(
      ns.lowNetDisplacementScore*0.35 + ns.directionalBalanceScore*0.20 + ns.candleCharacterScore*0.20 +
      ns.effortBalanceScore*0.10 + ns.volumePipScore*0.15);

   ns.valid = true;
   ns.reasoning = StringFormat("contextBars=%d lowNetDisp=%.1f dirBalance=%.1f(%d/%d) effortBalance=%.1f character=%.1f volumePip=%.1f(%s) final=%.1f",
      ns.contextBars, ns.lowNetDisplacementScore, ns.directionalBalanceScore, ns.bullBars5, ns.bearBars5,
      ns.effortBalanceScore, ns.candleCharacterScore, ns.volumePipScore, ns.volumePipRegime, ns.finalScore);
   return ns;
  }

//--- Live diagnostic writer - throttled (own timer, independent of every other throttle in this file),
//--- writes to a NEW, dedicated file neutral_dna.jsonl, mirroring LogStrongTrendDna()/LogWeakTrendDna()/
//--- LogChoppyDna()'s own convention. NEVER read by any trading decision - purely to confirm this IS the
//--- production calculation actually feeding scores[LDNA_NEUTRAL].
datetime g_neutralLogLastTime = 0;
void LogNeutralDna(const NeutralStructure &ns)
  {
   if(!Inp_DashboardLogEnabled) return;
   if(TimeCurrent()==g_neutralLogLastTime) return;
   g_neutralLogLastTime = TimeCurrent();

   string line = StringFormat(
      "{\"time\":\"%s\",\"symbol\":\"%s\",\"valid\":%s,\"barTime\":\"%s\",\"contextBars\":%d,"
      "\"grossMovePips\":%.3f,\"netMovePips\":%.3f,\"netVsBaselineScore\":%.2f,\"twoSidedGrossScore\":%.2f,"
      "\"lowNetDisplacementScore\":%.2f,\"bullBars5\":%d,\"bearBars5\":%d,\"directionalBalanceScore\":%.2f,"
      "\"avgBullBodyPips5\":%.3f,\"avgBearBodyPips5\":%.3f,\"effortBalanceScore\":%.2f,"
      "\"avgBodyRatio5\":%.2f,\"avgCloseExtremity5\":%.2f,\"candleCharacterScore\":%.2f,"
      "\"haveRvol\":%s,\"rvol\":%.4f,\"relativeRange\":%.4f,\"volumePipRegime\":\"%s\",\"volumePipScore\":%.2f,"
      "\"finalScore\":%.2f}",
      DashIsoTime(TimeCurrent()), g_symbol, ns.valid?"true":"false", DashIsoTime(ns.barTime), ns.contextBars,
      ns.grossMovePips, ns.netMovePips, ns.netVsBaselineScore, ns.twoSidedGrossScore,
      ns.lowNetDisplacementScore, ns.bullBars5, ns.bearBars5, ns.directionalBalanceScore,
      ns.avgBullBodyPips5, ns.avgBearBodyPips5, ns.effortBalanceScore,
      ns.avgBodyRatio5, ns.avgCloseExtremity5, ns.candleCharacterScore,
      ns.haveRvol?"true":"false", ns.rvol, ns.relativeRange, ns.volumePipRegime, ns.volumePipScore,
      ns.finalScore);
   DashAppendLine("neutral_dna.jsonl", line);
  }

//--- 2026-08-28, explicit operator request (IMPROVED existing state #16, CHOPPY): genuinely random/
//--- whipsaw market. Four MANDATORY factors, all multiplicative - proven numerically necessary over
//--- additive (a mostly-trending market with a brief noisy patch scored 50.31 additively vs 3.82
//--- multiplicatively on identical input; additive let high reversal evidence alone compensate for the
//--- established trend's low NonTrend/DirectionalInefficiency, a false CHOPPY classification). Swing
//--- detection (NonTrend) is a 7th INDEPENDENT implementation of the SAME fh=2 fractal technique already
//--- used by StrongUptrend/StrongDowntrend/Uptrend/Downtrend/Range/Neutral. Running candle: swing
//--- detection reads ONLY closed candles (rates[0..k-1]) - matches every other structural DNA's explicit
//--- precedent - but the running candle's own close/direction IS folded into ReversalEvidence/
//--- DirectionalInefficiency/ContinuationFailure (via ci.runningIncluded), so CHOPPY still reacts live.
//--- Live evaluator - mirrors EvaluateStrongTrendStructure()/EvaluateWeakTrendStructure()'s own
//--- established pattern EXACTLY. Takes the ALREADY-BUILT 30-candle window (win[]/gotWin from
//--- BuildMarketDnaWindow30(), called ONCE by EvaluateMarketDNA() and already reused for
//--- STRONG_TREND/STRONG_UPTREND/STRONG_DOWNTREND/WEAK_UPTREND/WEAK_DOWNTREND) - zero duplicate
//--- CopyRates/BuildMarketDnaWindow30/ComputeVolumeDna calls, zero new pip/volume formula.
ChoppyStructure EvaluateChoppyStructure(const PriceRangeDnaResult &win[], const int gotWin)
  {
   ChoppyStructure cs;
   cs.valid=false; cs.reasoning=""; cs.barTime=0; cs.contextBars=0;
   cs.alternationCount=0; cs.chopAlternationScore=0.0; cs.directionalConsistencyScore=0.0;
   cs.grossMovePips=0.0; cs.netMovePips=0.0; cs.grossNetInefficiencyScore=0.0; cs.fiveBarDisplacementScore=0.0;
   cs.latestBodyRatio=0.0; cs.avgBodyRatio5=0.0; cs.noiseScore=0.0;
   cs.haveRvol=false; cs.rvol=0.0; cs.haveRelativeRange=false; cs.relativeRange=0.0;
   cs.volumePipRegime="UNKNOWN"; cs.volumePipScore=0.0; cs.finalScore=0.0;

   //--- SAME data-sufficiency requirement as STRONG_TREND/WEAK_TREND (Section 3): 25 closed M1 bars,
   //--- all individually valid, index 0 = latest CLOSED candle (shift 1), index 24 = oldest. No partial-
   //--- history fallback, no fabricated values, never the running candle.
   const int KMIE_CHOPPY_CONTEXT_BARS = 25; // 2026-09-09, explicit operator request ("make all DNA use 25 bars"): 15 -> 25 (was 25 -> 15 on 2026-09-08)
   const int KMIE_CHOPPY_PERSISTENCE_BARS = 5;
   if(gotWin < KMIE_CHOPPY_CONTEXT_BARS)
     {
      cs.reasoning = StringFormat("insufficient closed-candle context (have=%d need=%d)", gotWin, KMIE_CHOPPY_CONTEXT_BARS);
      return cs;
     }
   for(int i=0;i<KMIE_CHOPPY_CONTEXT_BARS;i++)
      if(!win[i].valid)
        {
         cs.reasoning = StringFormat("candle at context index %d invalid (%s)", i, win[i].reasoning);
         return cs;
        }
   cs.contextBars = KMIE_CHOPPY_CONTEXT_BARS;
   cs.barTime = win[0].barTime;

   //--- FIVE-BAR CHOP PERSISTENCE (Section 5) - indices 0..4, still entirely within the 25-bar closed
   //--- context, never extends beyond it, never touches shift 0. Fixed-size 5 (MQL5 requires a compile-
   //--- time-constant array bound, not a local const int, for a stack array - matching the KMIE_CHOPPY_
   //--- PERSISTENCE_BARS value used everywhere else in this function).
   double signedMove5[5];
   int    signDir5[5];
   double sumBodyRatio5=0.0;
   for(int i=0;i<KMIE_CHOPPY_PERSISTENCE_BARS;i++)
     {
      signedMove5[i] = win[i].signedCloseToClosePips;
      signDir5[i] = (signedMove5[i]>0.0) ? 1 : (signedMove5[i]<0.0 ? -1 : 0);
      sumBodyRatio5 += win[i].bodyRatio;
     }
   cs.avgBodyRatio5 = sumBodyRatio5/KMIE_CHOPPY_PERSISTENCE_BARS;

   //--- A. Directional alternation - sign changes across the 5-bar chronological sequence (oldest->
   //--- newest, i.e. index 4->0, matching STRONG_TREND's own chronological reading of win[]).
   //--- Zero-move bars (signDir==0) do not count as a "change" against either neighbor - they are
   //--- absorbed exactly like STRONG_TREND's own directionalConsistency treats a WAIT bar (Section 5A
   //--- example "BUY->SELL->BUY->SELL->BUY" implies every bar has a real sign).
   int alternations=0;
   for(int i=KMIE_CHOPPY_PERSISTENCE_BARS-1;i>0;i--)
     {
      int newer=signDir5[i-1], older=signDir5[i];
      if(newer!=0 && older!=0 && newer!=older) alternations++;
     }
   cs.alternationCount = alternations;
   cs.chopAlternationScore = Clamp0to100((alternations/(double)(KMIE_CHOPPY_PERSISTENCE_BARS-1))*100.0);

   //--- B. Directional consistency - SAME metric/formula STRONG_TREND/WEAK_TREND already compute
   //--- (fraction of the 5 bars agreeing with the NET 5-bar direction), reused here as a DAMPENER: a
   //--- strongly one-sided sequence (Section 5B "BUY->BUY->BUY->BUY->BUY") must NOT score as CHOPPY
   //--- merely because the candles are individually small - high consistency directly REDUCES
   //--- fiveBarDisplacementScore below, independent of how large gross/net pip values happen to be.
   double netMove5Telescoped=0.0;
   int bullBars=0, bearBars=0, neutralBars=0;
   for(int i=0;i<KMIE_CHOPPY_PERSISTENCE_BARS;i++)
     {
      netMove5Telescoped += signedMove5[i];
      if(signDir5[i]>0) bullBars++; else if(signDir5[i]<0) bearBars++; else neutralBars++;
     }
   ENUM_LITE_DIR netDir5 = (netMove5Telescoped>0.0) ? LDIR_BUY : (netMove5Telescoped<0.0) ? LDIR_SELL : LDIR_WAIT;
   int agreeCount = (netDir5==LDIR_BUY) ? bullBars : (netDir5==LDIR_SELL) ? bearBars : neutralBars;
   cs.directionalConsistencyScore = Clamp0to100((agreeCount/(double)KMIE_CHOPPY_PERSISTENCE_BARS)*100.0);

   //--- C/D/E. Gross vs net displacement (Section 5C/D/E) - gross = sum(|signed 1-bar move|), net =
   //--- |sum(signed 1-bar move)|. High gross + low net = strong CHOPPY evidence (large gross movement
   //--- absorbed by reversals instead of becoming net progress). SafeDiv-guarded against a zero-gross
   //--- denominator (Section 5's own "protect every ratio against zero denominators" + TEST11).
   double gross=0.0;
   for(int i=0;i<KMIE_CHOPPY_PERSISTENCE_BARS;i++) gross += MathAbs(signedMove5[i]);
   double net = MathAbs(netMove5Telescoped);
   cs.grossMovePips = gross;
   cs.netMovePips = net;
   double netToGross = SafeDiv(net, gross, 1.0); // gross==0 (all 5 bars flat) -> netToGross=1.0 (fully "efficient" by definition, no ground covered at all - Section 5's own zero-denominator guard) -> inefficiency=0, matches Section 6 Scenario A (compression, not chop)
   cs.grossNetInefficiencyScore = Clamp0to100((1.0-netToGross)*100.0);

   //--- fiveBarDisplacementScore: the dominant persistence-side term, combining alternation (evidence
   //--- OF two-sidedness) + gross/net inefficiency (evidence movement was absorbed, not net progress),
   //--- DAMPENED by directional consistency (Section 5B's explicit requirement - a one-sided run must
   //--- reduce CHOPPY even with small candles). Multiplicative dampener rather than a third additive
   //--- term - a perfectly consistent 5-bar run (consistency=100) must pull this toward 0 regardless of
   //--- how alternation/inefficiency read, matching TEST5/TEST13's requirement that genuine trends never
   //--- falsely classify as CHOPPY.
   double rawDisplacement = Clamp0to100(cs.chopAlternationScore*0.55 + cs.grossNetInefficiencyScore*0.45);
   double consistencyDampener = Clamp0to100(100.0-cs.directionalConsistencyScore)/100.0; // 1.0 = fully dampened-out (100% consistent run), 0.0 = no dampening (fully alternating)
   cs.fiveBarDisplacementScore = Clamp0to100(rawDisplacement*consistencyDampener);

   //--- LATEST CLOSED-BAR WICK/NOISE (Section 9) - MULTI-BAR average (avgBodyRatio5, already computed
   //--- above), never the single newest candle alone (Section 9's explicit "a single large-wick candle
   //--- is not a choppy market... CHOPPY requires multi-bar behavior"). latestBodyRatio is exposed for
   //--- diagnostics/transparency only - it does NOT feed finalScore on its own.
   cs.latestBodyRatio = win[0].bodyRatio;
   cs.noiseScore = Clamp0to100(100.0-cs.avgBodyRatio5);

   //--- VOLUME x PIP RELATIONSHIP (Section 7/8) - reuses the EXISTING, untouched ComputeVolumeDna() and
   //--- the EXISTING ClassifyVolumePipRegime() classifier STRONG_TREND/WEAK_TREND already use - zero new
   //--- volume calculation, zero new regime logic. Volume here is direction-neutral CONTEXT (Section 7's
   //--- own "do NOT interpret volume as BUY or SELL direction") - it modulates the score, never gates it
   //--- to zero on its own (Section 8's own LOW-volume/LOW-movement -> QUIET/COMPRESSION example is
   //--- handled by grossNetInefficiencyScore/chopAlternationScore naturally reading low in that case,
   //--- not by a volume floor here).
   VolumeDnaResult vr = ComputeVolumeDna(PERIOD_M1, KMIE_VOLUME_DNA_BASELINE_BARS);
   cs.haveRvol = vr.valid && (vr.volumeClass!="UNKNOWN");
   cs.rvol = cs.haveRvol ? vr.relativeVolume : 0.0;
   cs.haveRelativeRange = (win[0].rangeClass!="UNKNOWN");
   cs.relativeRange = cs.haveRelativeRange ? win[0].relativeRange : 0.0;
   cs.volumePipRegime = ClassifyVolumePipRegime(cs.haveRelativeRange, cs.relativeRange, cs.haveRvol, cs.rvol);
   //--- Section 8's explicit examples: HIGH volume + HIGH gross + LOW net -> strong CHOPPY candidate;
   //--- LOW volume + LOW movement -> more likely QUIET/COMPRESSION (scored low here too, deliberately -
   //--- CHOPPY does not compete for that regime); HIGH directional displacement + persistence should
   //--- favor TREND instead (EFFICIENT_EXPANSION is elevated pip WITH elevated volume in a coherent
   //--- single-candle sense, which correlates with genuine trend expansion far more than two-sided
   //--- absorption - so it is deliberately NOT rewarded here, unlike STRONG_TREND's own volumePipScore
   //--- where EFFICIENT_EXPANSION is the highest-scoring regime).
   if(cs.volumePipRegime=="EFFORT_WITHOUT_RESULT")
      cs.volumePipScore = Clamp0to100(50.0 + 25.0*MathMin(cs.rvol/1.60,2.0)); // Section 8's own headline example: HIGH volume, LOW net-efficient pip - the strongest CHOPPY-favoring regime
   else if(cs.volumePipRegime=="EFFICIENT_EXPANSION")
      cs.volumePipScore = 20.0; // elevated volume AND elevated single-candle range together correlates with trend/expansion, not chop - deliberately capped low (Section 8's "should favor TREND states instead")
   else if(cs.volumePipRegime=="THIN_MOVEMENT")
      cs.volumePipScore = 35.0; // elevated range on thin participation - some chop-consistent noise, but no confirming effort
   else if(cs.volumePipRegime=="COMPRESSION")
      cs.volumePipScore = 15.0; // low volume + low movement - more consistent with QUIET/COMPRESSION (Section 8/11), not rewarded as CHOPPY evidence
   else
      cs.volumePipScore = 25.0; // UNKNOWN (volume data unavailable) - neutral-low, never fabricated

   //--- FINAL (Section 10) - independent components combined into one 0..100 score. Persistence-side
   //--- (fiveBarDisplacementScore, already itself alternation+inefficiency dampened-by-consistency) is
   //--- the dominant term; noise and volume-pip regime are meaningful but secondary, matching this
   //--- file's established "one dominant + supporting components" additive convention (STRONG_TREND/
   //--- WEAK_TREND's own 0.35/0.35/0.30 and 0.50/0.30/0.20 splits). Direction-neutral throughout - no
   //--- BUY/SELL branch anywhere in this formula (Section 12).
   cs.finalScore = Clamp0to100(cs.fiveBarDisplacementScore*0.55 + cs.noiseScore*0.20 + cs.volumePipScore*0.25);

   cs.valid = true;
   cs.reasoning = StringFormat("contextBars=%d alternation=%d/4 grossNetIneff=%.1f consistency=%.1f fiveBarDisp=%.1f noise=%.1f volumePip=%.1f(%s) final=%.1f",
      cs.contextBars, cs.alternationCount, cs.grossNetInefficiencyScore, cs.directionalConsistencyScore,
      cs.fiveBarDisplacementScore, cs.noiseScore, cs.volumePipScore, cs.volumePipRegime, cs.finalScore);
   return cs;
  }

//--- Live diagnostic writer - throttled (own timer, independent of every other throttle in this file),
//--- writes to a NEW, dedicated file choppy_dna.jsonl, mirroring LogStrongTrendDna()/LogWeakTrendDna()'s
//--- own convention. NEVER read by any trading decision - purely to confirm this IS the production
//--- calculation actually feeding scores[LDNA_CHOPPY] (Section 16/17).
datetime g_choppyLogLastTime = 0;
void LogChoppyDna(const ChoppyStructure &cs)
  {
   if(!Inp_DashboardLogEnabled) return;
   if(TimeCurrent()==g_choppyLogLastTime) return;
   g_choppyLogLastTime = TimeCurrent();

   string line = StringFormat(
      "{\"time\":\"%s\",\"symbol\":\"%s\",\"valid\":%s,\"barTime\":\"%s\",\"contextBars\":%d,"
      "\"alternationCount\":%d,\"chopAlternationScore\":%.2f,\"directionalConsistencyScore\":%.2f,"
      "\"grossMovePips\":%.3f,\"netMovePips\":%.3f,\"grossNetInefficiencyScore\":%.2f,"
      "\"fiveBarDisplacementScore\":%.2f,\"latestBodyRatio\":%.2f,\"avgBodyRatio5\":%.2f,\"noiseScore\":%.2f,"
      "\"haveRvol\":%s,\"rvol\":%.4f,\"relativeRange\":%.4f,\"volumePipRegime\":\"%s\",\"volumePipScore\":%.2f,"
      "\"finalScore\":%.2f}",
      DashIsoTime(TimeCurrent()), g_symbol, cs.valid?"true":"false", DashIsoTime(cs.barTime), cs.contextBars,
      cs.alternationCount, cs.chopAlternationScore, cs.directionalConsistencyScore,
      cs.grossMovePips, cs.netMovePips, cs.grossNetInefficiencyScore,
      cs.fiveBarDisplacementScore, cs.latestBodyRatio, cs.avgBodyRatio5, cs.noiseScore,
      cs.haveRvol?"true":"false", cs.rvol, cs.relativeRange, cs.volumePipRegime, cs.volumePipScore,
      cs.finalScore);
   DashAppendLine("choppy_dna.jsonl", line);
  }

//--- 2026-09-04, explicit operator request (FULL MARKET DNA CONSOLIDATION): EvaluateReversalStructure()/
//--- ReversalStructure (REVERSAL state) and EvaluateTrendExhaustionStructure()/TrendExhaustionStructure
//--- (TREND_EXHAUSTION state) are FULLY REMOVED - source-audited before removal to confirm zero
//--- remaining consumers.
//====================================================================
// STRONG_TREND REBUILD (2026-09-04, explicit operator request - "MARKET DNA — direct live
// implementation", STRONG_TREND only). LIVE PRODUCTION REPLACEMENT of the prior single-line
// ci.aggression/ci.candleConfidence/ci.candleQuality formula at scores[LDNA_STRONG_TREND] below -
// not a shadow/candidate/parallel calculation. Architecture, per explicit spec:
//
//   25 CLOSED M1 BARS -> 20-BAR BASELINE -> 5-BAR PERSISTENCE -> LATEST CLOSED-BAR FORCE
//   -> PIP DISPLACEMENT + VOLUME PARTICIPATION -> VOLUME x PIP RELATIONSHIP -> STRONG_TREND
//
// Reuses ONLY existing canonical measurements - no new pip/range/volume formula is created:
//   - BuildMarketDnaWindow30() (Step 16, ~line 2237) already fetches shift=1..N (CLOSED bars only,
//     shift=0/the running candle is NEVER fetched - see its own header) and returns up to 30
//     PriceRangeDnaResult entries, each independently carrying bodyPips/rangePips/bodyRatio/
//     relativeRange/closeLocation/rangeATR/signedCloseToClosePips, each already baselined against
//     its OWN 20 immediately-older candles (KMIE_PRICE_RANGE_DNA_BASELINE_BARS=20). Indices 0..24 of
//     that array ARE the "25 closed M1 bars" context window this task asks for - no second fetch.
//   - ComputeVolumeDna(PERIOD_M1, KMIE_VOLUME_DNA_BASELINE_BARS) (~line 1883) is the SAME, byte-for-
//     byte untouched Volume DNA calculator PRICE_VOLUME_EXPANSION already uses (see
//     EvaluatePriceVolumeExpansionStructure(), ~line 2534) - not a second volume calculator. Its own
//     20-bar baseline is independent of, but numerically identical in size to, the price baseline
//     (documented as an intentional design choice at KMIE_PRICE_RANGE_DNA_BASELINE_BARS's own header,
//     ~line 2225-2228 - "the two systems are independent by design... a future change to one must
//     never silently move the other").
//   - Pip convention: rangePips/bodyPips are already the file's established "pip == raw price
//     distance, no _Point division" convention (see PriceRangeDnaResult's own header, ~line 2072) -
//     reused verbatim, never redefined.
//
// NOT reused/touched: ci.aggression/candleConfidence/candleQuality (EvaluateCandleIntelligence(),
// ~line 5491) remain byte-for-byte unchanged - they are still read by WEAK_TREND/COMPRESSION/
// EXPANSION/INSTITUTIONAL_BUYING/INSTITUTIONAL_SELLING/QUIET/NEUTRAL (grep-confirmed, 8 other live
// consumers) at their own existing lines. Only the ONE line assigning scores[LDNA_STRONG_TREND]
// (below, inside EvaluateMarketDNA()) is replaced.
//
// CALIBRATION: g_dnaCalibMean[0]/g_dnaCalibStdev[0] (35.7/6.85, REAL-measured against the OLD
// formula's output distribution) are DELIBERATELY LEFT UNCHANGED in this task. The new formula below
// is, by design, the SAME shape as the old one - an additive weighted sum of three already-0..100-
// scaled sub-scores (latestForceScore*0.35 + persistenceScore*0.35 + volumePipScore*0.30, mirroring
// the old aggression*0.4+candleConfidence*0.4+candleQuality*0.2) - so its raw output is expected to
// occupy a broadly comparable 0..100 range under the SAME z-score calibration, not a fundamentally
// different numerical scale requiring new constants. This is a documented expectation, not a proven
// one: per explicit instruction ("if the new measurement architecture requires recalibration... report
// the exact reason and stop"), this raw score is now ALSO logged to strong_trend_dna.jsonl (see
// LogStrongTrendDna() below) specifically so its real live distribution can be measured before any
// future recalibration decision - the SAME Step-13c method (dna_raw_scores.jsonl) already used for
// every other state in this file. If live data later shows this formula's distribution has in fact
// shifted materially from 35.7/6.85, that is a SEPARATE, explicitly-approved recalibration task -
// this implementation does not perform it silently.
//====================================================================

//--- Pure classifier - the single source of truth for the Volume x Pip regime, matching the exact
//--- 4-regime spec (Efficient Expansion / Effort-Without-Result / Thin Movement / Compression).
//--- Scalars only (never touches rates[]/g_symbol/CopyRates) so it is callable both by the live
//--- evaluator below AND directly by deterministic tests with literal inputs - same "pure classifier +
//--- live wrapper" pattern already established by ClassifyPriceVolumeExpansion() (~line 2468).
string ClassifyVolumePipRegime(const bool haveRelativeRange, const double relativeRange,
                                const bool haveRvol, const double rvol)
  {
   if(!haveRelativeRange || !haveRvol) return "UNKNOWN";
   bool highVol = rvol>=1.30;             // ELEVATED+ on ClassifyVolumeDna()'s own bins (~line 1871)
   bool highPip = relativeRange>=1.30;    // ELEVATED+ on ClassifyRangeDna()'s own bins
   if(highVol && highPip)  return "EFFICIENT_EXPANSION";      // Regime A
   if(highVol && !highPip) return "EFFORT_WITHOUT_RESULT";    // Regime B - do NOT reward
   if(!highVol && highPip) return "THIN_MOVEMENT";            // Regime C - caution, reduced confidence
   return "COMPRESSION";                                       // Regime D - do NOT qualify as STRONG_TREND
  }

//--- Every component exposed individually (never a hidden single formula), same transparency
//--- convention PriceVolumeExpansionStructure (~line 2486) already established.
struct StrongTrendStructure
  {
   bool     valid;                 // false = fewer than 25 closed M1 bars available - every field below is then 0.0/safe, never fabricated
   string   reasoning;
   datetime barTime;                // latest closed bar's own open time (shift=1)
   int      contextBars;            // actual count of closed bars used for context (<=25)
   ENUM_LITE_DIR direction;         // BULLISH(BUY)/BEARISH(SELL)/NEUTRAL(WAIT) market CONDITION - never a trade instruction (Section 14)

   // Latest closed-bar force
   double   latestBodyPips;
   double   latestRangePips;
   double   latestNetMovePips;      // signed, vs the immediately-older closed candle
   double   bodyRatio;              // 0..100
   double   relativeRange;          // vs this candle's own 20-bar baseline
   double   closeLocation;          // 0..1
   double   latestForceScore;       // 0..100 - combines bodyRatio + relativeRange + closeLocation conviction

   // 5-bar persistence (indices 0..4 of the 25-bar context)
   double   netMove5Pips;           // signed, close[0]-close[5]
   double   directionalConsistency; // 0..100 - how many of the 5 bars agree with the net-move direction
   double   avgBodyRatio5;
   double   avgRelativeRange5;
   double   followThrough;          // 0..100 - latest bar's own relativeRange vs the 5-bar average (still expanding, not fading)
   double   persistenceScore;       // 0..100 - combines the above

   // Volume x Pip relationship
   bool     haveRvol;
   double   rvol;
   string   volumePipRegime;        // EFFICIENT_EXPANSION/EFFORT_WITHOUT_RESULT/THIN_MOVEMENT/COMPRESSION/UNKNOWN
   double   volumePipScore;         // 0..100

   double   finalScore;             // 0..100, feeds scores[LDNA_STRONG_TREND]
  };

//--- Live evaluator - mirrors the established EvaluateXStructure() pattern (e.g.
//--- EvaluatePriceVolumeExpansionStructure()) every other DNA state's own dedicated formula uses.
//--- Takes the ALREADY-BUILT 30-candle window (win[]/gotWin from BuildMarketDnaWindow30(), called
//--- ONCE by EvaluateMarketDNA() below) - never a second independent CopyRates/window build.
StrongTrendStructure EvaluateStrongTrendStructure(const PriceRangeDnaResult &win[], const int gotWin)
  {
   StrongTrendStructure s;
   s.valid=false; s.reasoning=""; s.barTime=0; s.contextBars=0; s.direction=LDIR_WAIT;
   s.latestBodyPips=0.0; s.latestRangePips=0.0; s.latestNetMovePips=0.0;
   s.bodyRatio=0.0; s.relativeRange=0.0; s.closeLocation=0.5; s.latestForceScore=0.0;
   s.netMove5Pips=0.0; s.directionalConsistency=0.0; s.avgBodyRatio5=0.0; s.avgRelativeRange5=0.0;
   s.followThrough=0.0; s.persistenceScore=0.0;
   s.haveRvol=false; s.rvol=0.0; s.volumePipRegime="UNKNOWN"; s.volumePipScore=0.0;
   s.finalScore=0.0;

   //--- STEP 17 (explicit requirement) - data sufficiency: at minimum 25 closed M1 bars, ALL of them
   //--- individually valid=true (each PriceRangeDnaResult entry's own insufficient-history guard,
   //--- ComputePriceRangeDna() ~line 2125-2129) before this measurement is considered usable at all.
   //--- No partial-history fallback, no fabricated values - matches this file's established
   //--- invalid-data convention (e.g. ComputePriceRangeDna() itself, PriceVolumeExpansionStructure).
   const int KMIE_STRONG_TREND_CONTEXT_BARS = 25;
   const int KMIE_STRONG_TREND_PERSISTENCE_BARS = 5;
   if(gotWin < KMIE_STRONG_TREND_CONTEXT_BARS)
     {
      s.reasoning = StringFormat("insufficient closed-candle context (have=%d need=%d)", gotWin, KMIE_STRONG_TREND_CONTEXT_BARS);
      return s;
     }
   for(int i=0;i<KMIE_STRONG_TREND_CONTEXT_BARS;i++)
      if(!win[i].valid)
        {
         s.reasoning = StringFormat("candle at context index %d invalid (%s)", i, win[i].reasoning);
         return s;
        }
   s.contextBars = KMIE_STRONG_TREND_CONTEXT_BARS;
   s.barTime = win[0].barTime;

   //--- LATEST CLOSED-BAR FORCE (index 0 = shift 1, the most recently CLOSED M1 candle - never shift 0).
   //--- Every field below is read directly from ComputePriceRangeDna()'s own already-computed result -
   //--- no re-derivation, no second formula.
   s.latestBodyPips     = win[0].bodyPips;
   s.latestRangePips    = win[0].rangePips;
   s.latestNetMovePips  = win[0].signedCloseToClosePips;
   s.bodyRatio           = win[0].bodyRatio;                                   // 0..100, bodyPips/rangePips*100, SafeDiv-guarded at the source
   s.relativeRange       = (win[0].rangeClass!="UNKNOWN") ? win[0].relativeRange : 0.0;
   s.closeLocation       = win[0].closeLocation;                               // 0..1

   //--- Force score: bodyRatio (clean directional body) + relativeRange scaled the SAME way
   //--- PriceVolumeExpansionStructure already scales it (threshold lands at 50, ~2x saturates near
   //--- 100 - here the "threshold" is 1.0x baseline, i.e. a perfectly average candle scores 50) +
   //--- close-location conviction (extremity from the 0.5 midpoint). All three already 0..100/0..1
   //--- scale - no unit mismatch, no unnormalized raw pip value entering a weighted sum (explicit
   //--- "DO NOT let one raw variable dominate" instruction).
   double relRangeForceComponent = Clamp0to100(50.0 * s.relativeRange);        // 1.0x baseline -> 50, 2.0x -> 100
   double closeExtremity = MathAbs(s.closeLocation-0.5)*2.0*100.0;             // 0 at midpoint, 100 at either extreme
   s.latestForceScore = Clamp0to100(s.bodyRatio*0.45 + relRangeForceComponent*0.35 + closeExtremity*0.20);

   //--- 5-BAR PERSISTENCE (indices 0..4, still entirely within the 25-bar closed context - never
   //--- extends beyond it, never touches shift 0).
   double sumBodyRatio5=0.0, sumRelRange5=0.0;
   int bullBars=0, bearBars=0, neutralBars=0;
   for(int i=0;i<KMIE_STRONG_TREND_PERSISTENCE_BARS;i++)
     {
      sumBodyRatio5 += win[i].bodyRatio;
      sumRelRange5  += (win[i].rangeClass!="UNKNOWN") ? win[i].relativeRange : 0.0;
      double signedMove = win[i].signedCloseToClosePips;
      if(signedMove>0.0) bullBars++; else if(signedMove<0.0) bearBars++; else neutralBars++;
     }
   s.avgBodyRatio5   = sumBodyRatio5/KMIE_STRONG_TREND_PERSISTENCE_BARS;
   s.avgRelativeRange5 = sumRelRange5/KMIE_STRONG_TREND_PERSISTENCE_BARS;
   //--- netMove5Pips: close[0] (latest closed) vs close[5] (the candle immediately OLDER than the
   //--- 5-bar window) - a true 5-bar net displacement, distinct from any single-candle close-to-close
   //--- reading. Index 5 exists because gotWin>=25 was already asserted above. Computed by summing the
   //--- first 5 candles' own signedCloseToClosePips (close[i]-close[i+1]) - the sum telescopes exactly
   //--- to close[0]-close[5], with no extra data read beyond what win[] already provides.
   double netMove5Telescoped = 0.0;
   for(int i=0;i<KMIE_STRONG_TREND_PERSISTENCE_BARS;i++) netMove5Telescoped += win[i].signedCloseToClosePips;
   s.netMove5Pips = netMove5Telescoped;
   //--- Directional consistency: what fraction of the 5 bars agree with the NET 5-bar direction - a
   //--- persistent trend can contain small counter-directional candles (explicit Section 13
   //--- requirement: "do NOT use an oversimplified '5 bullish candles' rule"), so this measures
   //--- agreement-with-the-net-outcome, not unanimous same-color candles.
   ENUM_LITE_DIR netDir5 = (s.netMove5Pips>0.0) ? LDIR_BUY : (s.netMove5Pips<0.0) ? LDIR_SELL : LDIR_WAIT;
   int agreeCount = (netDir5==LDIR_BUY) ? bullBars : (netDir5==LDIR_SELL) ? bearBars : neutralBars;
   s.directionalConsistency = Clamp0to100((agreeCount/(double)KMIE_STRONG_TREND_PERSISTENCE_BARS)*100.0);
   //--- Follow-through: is the LATEST bar's own relativeRange still at or above the 5-bar average
   //--- (movement still expanding), or has it faded below it (movement stalling)? Scaled so "exactly
   //--- at the 5-bar average" lands at 50, matching this file's established threshold-at-50 convention.
   s.followThrough = (s.avgRelativeRange5>0.0) ? Clamp0to100(50.0 * SafeDiv(s.relativeRange, s.avgRelativeRange5, 1.0)) : 50.0;

   s.persistenceScore = Clamp0to100(
      Clamp0to100(MathAbs(s.netMove5Pips)/MathMax(win[0].avgRangePips20,_Point)*20.0)*0.30  // net displacement, normalized against the SAME 20-bar range baseline the price side already computes - 5x the baseline range -> 100
      + s.directionalConsistency*0.30
      + s.avgBodyRatio5*0.20
      + s.followThrough*0.20);

   //--- VOLUME x PIP RELATIONSHIP - reuses the EXISTING, untouched ComputeVolumeDna() (Step 4/10's own
   //--- "do not create a second Volume calculator" requirement, same call PRICE_VOLUME_EXPANSION
   //--- already makes at ~line 2549).
   VolumeDnaResult vr = ComputeVolumeDna(PERIOD_M1, KMIE_VOLUME_DNA_BASELINE_BARS);
   s.haveRvol = vr.valid && (vr.volumeClass!="UNKNOWN");
   s.rvol      = s.haveRvol ? vr.relativeVolume : 0.0;
   bool haveRelRangeForRegime = (win[0].rangeClass!="UNKNOWN");
   s.volumePipRegime = ClassifyVolumePipRegime(haveRelRangeForRegime, s.relativeRange, s.haveRvol, s.rvol);

   //--- Regime-shaped score - Section 11/24's explicit requirement: high volume alone, or large pips
   //--- alone, must NOT automatically score as strong-trend evidence. Only EFFICIENT_EXPANSION (both
   //--- axes elevated together) scores highly; EFFORT_WITHOUT_RESULT and THIN_MOVEMENT are explicitly
   //--- capped below what EFFICIENT_EXPANSION can reach; COMPRESSION scores low. A "volume/pip
   //--- efficiency" ratio (rawPips/rawVolume) was explicitly evaluated and REJECTED per Section 12's
   //--- own instruction ("DO NOT blindly implement rawPips/rawVolume without evaluating stability") -
   //--- raw tick-volume counts and raw pip distances live on incompatible numeric scales for any
   //--- symbol/session combination, so a direct ratio is not numerically stable; the regime
   //--- classification above (both already independently baseline-normalized via relativeRange/RVOL)
   //--- is the stable, dimensionless substitute.
   if(s.volumePipRegime=="EFFICIENT_EXPANSION")
      s.volumePipScore = Clamp0to100(50.0 + 25.0*MathMin(s.relativeRange/1.60,2.0) + 25.0*MathMin(s.rvol/1.60,2.0));
   else if(s.volumePipRegime=="THIN_MOVEMENT")
      s.volumePipScore = Clamp0to100(35.0 + 15.0*MathMin(s.relativeRange/1.60,2.0)); // capped well below EFFICIENT_EXPANSION - "treat cautiously" (Section 11, Regime C)
   else if(s.volumePipRegime=="EFFORT_WITHOUT_RESULT")
      s.volumePipScore = Clamp0to100(20.0 + 10.0*MathMin(s.rvol/1.60,2.0)); // effort present but NOT rewarded as trend evidence (Section 11, Regime B)
   else if(s.volumePipRegime=="COMPRESSION")
      s.volumePipScore = 10.0; // low, deliberately not zero - a quiet market is not an error state
   else
      s.volumePipScore = 25.0; // UNKNOWN (volume data unavailable) - neutral-low, never fabricated as strong

   //--- FINAL - additive weighted sum of three already-0..100-scaled components, mirroring the OLD
   //--- formula's own additive shape (aggression*0.4+candleConfidence*0.4+candleQuality*0.2) - see this
   //--- section's own header for the calibration-compatibility rationale.
   s.finalScore = Clamp0to100(s.latestForceScore*0.35 + s.persistenceScore*0.35 + s.volumePipScore*0.30);

   //--- Market CONDITION direction (Section 14 - "expose BULLISH/BEARISH/NEUTRAL, never BUY/SELL as an
   //--- instruction"). Driven by the SAME 5-bar net direction already computed above for persistence,
   //--- consistent with the persistence measurement rather than a second/independent direction read.
   s.direction = netDir5;

   s.valid = true;
   s.reasoning = StringFormat("contextBars=%d force=%.1f persistence=%.1f volumePip=%.1f(%s) final=%.1f",
      s.contextBars, s.latestForceScore, s.persistenceScore, s.volumePipScore, s.volumePipRegime, s.finalScore);
   return s;
  }

//--- Live diagnostic writer - throttled (own timer, independent of every other throttle in this
//--- file), writes to a NEW, dedicated file strong_trend_dna.jsonl, mirroring
//--- LogPriceVolumeExpansionDna()'s own convention. NEVER read by any trading decision - purely to
//--- confirm this IS the production calculation actually feeding scores[LDNA_STRONG_TREND] (Section 23).
datetime g_strongTrendLogLastTime = 0;
void LogStrongTrendDna(const StrongTrendStructure &s)
  {
   if(!Inp_DashboardLogEnabled) return;
   if(TimeCurrent()==g_strongTrendLogLastTime) return;
   g_strongTrendLogLastTime = TimeCurrent();

   string line = StringFormat(
      "{\"time\":\"%s\",\"symbol\":\"%s\",\"valid\":%s,\"barTime\":\"%s\",\"contextBars\":%d,"
      "\"latestBodyPips\":%.3f,\"latestRangePips\":%.3f,\"latestNetMovePips\":%.3f,"
      "\"bodyRatio\":%.2f,\"relativeRange\":%.4f,\"closeLocation\":%.4f,\"latestForceScore\":%.2f,"
      "\"netMove5Pips\":%.3f,\"directionalConsistency\":%.2f,\"avgBodyRatio5\":%.2f,"
      "\"avgRelativeRange5\":%.4f,\"followThrough\":%.2f,\"persistenceScore\":%.2f,"
      "\"haveRvol\":%s,\"rvol\":%.4f,\"volumePipRegime\":\"%s\",\"volumePipScore\":%.2f,"
      "\"direction\":\"%s\",\"finalScore\":%.2f}",
      DashIsoTime(TimeCurrent()), g_symbol, s.valid?"true":"false", DashIsoTime(s.barTime), s.contextBars,
      s.latestBodyPips, s.latestRangePips, s.latestNetMovePips,
      s.bodyRatio, s.relativeRange, s.closeLocation, s.latestForceScore,
      s.netMove5Pips, s.directionalConsistency, s.avgBodyRatio5,
      s.avgRelativeRange5, s.followThrough, s.persistenceScore,
      s.haveRvol?"true":"false", s.rvol, s.volumePipRegime, s.volumePipScore,
      DirName(s.direction), s.finalScore);
   DashAppendLine("strong_trend_dna.jsonl", line);
  }

//====================================================================
// WEAK_UPTREND / WEAK_DOWNTREND (2026-09-04, explicit operator request - "Upgrade the existing generic
// Market DNA state WEAK_TREND into two explicit directional states"). LIVE PRODUCTION - not shadow, not
// diagnostic-only. Follows the SAME architecture already established for STRONG_TREND
// (EvaluateStrongTrendStructure(), above): 25 closed M1 bars -> 20-bar per-candle baseline -> 5-bar
// persistence -> latest closed-bar force -> pip displacement + volume participation -> direction +
// qualification -> WEAK_UPTREND/WEAK_DOWNTREND.
//
// Reuses BuildMarketDnaWindow30()/PriceRangeDnaResult/ComputeVolumeDna() - the SAME canonical
// measurement infrastructure STRONG_TREND already uses - zero new CopyRates, zero new pip/volume
// formula. Direction comes from the SAME netMove5Pips-sign convention STRONG_TREND already established
// (never volume, never candle color alone).
//
// CRITICAL DISTINCTION FROM STRONG_TREND (explicit instruction 4/6 - "do not simply copy STRONG_TREND
// and reduce its score"): this is NOT a lower-weighted copy of the force/expansion measurement.
// STRONG_TREND's own architecture rewards EXPANSION (relativeRange scaled so 1.0x baseline=50,
// saturating toward 100 at 2x+) and REQUIRES a Volume x Pip regime match (EFFICIENT_EXPANSION scoring
// highest). WEAK_TREND's own historical definition (the formula being replaced,
// ci.aggression*0.25+candleConfidence*0.25+noiseIndex*0.5 - see EvaluateMarketDNA()'s own comment,
// "directional bias present but with frequent OPPOSING candles") is about PERSISTENCE THROUGH NOISE,
// not clean expansion. This engine therefore: (a) weights directionalConsistency/persistence more
// heavily than raw force, (b) does NOT require or reward the Volume x Pip EFFICIENT_EXPANSION regime -
// weak trend explicitly CAN have elevated noise/wick and inconsistent participation, (c) EXCLUDES
// cases where the underlying data would already qualify as a strong, clean expansion (see the
// qualification gate below) - so it competes for market conditions STRONG_TREND's own formula does not
// reward, rather than re-scoring the identical evidence at a lower number.
//====================================================================

//--- Pure classifier - the qualification gate distinguishing "weak trend exists" from "no trend" and
//--- from "this is actually strong, not weak". Scalars only (never touches rates[]/g_symbol/CopyRates)
//--- so it is callable both from the live evaluator below and directly by deterministic tests - same
//--- "pure classifier + live wrapper" pattern already established by ClassifyPriceVolumeExpansion()/
//--- ClassifyActivePing()/ClassifyVolumePipRegime().
void ClassifyWeakTrend(const double netMove5Pips, const double directionalConsistency,
                        const bool haveRelativeRange, const double relativeRange, const double bodyRatio,
                        bool &outQualifies, ENUM_LITE_DIR &outDirection)
  {
   outQualifies=false; outDirection=LDIR_WAIT;
   //--- Section 4/13 requirement: direction exists, some persistence exists, movement is measurable,
   //--- but NOT so chaotic that direction is meaningless (directionalConsistency floor) and NOT so
   //--- forceful/clean that it belongs to STRONG_TREND's own domain instead (the upper bounds below).
   //--- Floors set at "meaningfully more than chance" (>50%) and "genuinely measurable displacement"
   //--- (relativeRange>=0.60, i.e. at least 60% of the normal 20-bar baseline range - below this, Section
   //--- 5's "zero/near-zero displacement does not qualify" applies). Ceiling excludes STRONG_TREND's own
   //--- clean-expansion domain (relativeRange>=1.60 AND bodyRatio>=60.0 is EXACTLY the priceOk threshold
   //--- ClassifyPriceVolumeExpansion() already uses for "this is a real expansion" - reused here as the
   //--- upper qualification bound so WEAK_TREND does not compete for the same evidence, per this
   //--- section's own header).
   bool haveDirection = (netMove5Pips!=0.0);
   bool sufficientConsistency = (directionalConsistency>50.0);
   bool measurableDisplacement = haveRelativeRange && (relativeRange>=0.60);
   bool notAlreadyStrong = !(haveRelativeRange && relativeRange>=1.60 && bodyRatio>=60.0);
   if(haveDirection && sufficientConsistency && measurableDisplacement && notAlreadyStrong)
     {
      outQualifies=true;
      outDirection = (netMove5Pips>0.0) ? LDIR_BUY : LDIR_SELL;
     }
  }

//--- Every component exposed individually, same transparency convention StrongTrendStructure already
//--- established.
struct WeakTrendStructure
  {
   bool     valid;
   string   reasoning;
   datetime barTime;
   int      contextBars;
   ENUM_LITE_DIR direction;

   double   latestBodyPips;
   double   latestRangePips;
   double   latestNetMovePips;
   double   bodyRatio;
   double   relativeRange;
   double   closeLocation;
   double   noiseScore;          // 0..100 - wick/range proportion of the latest closed bar (HIGH noise is expected/tolerated here, unlike STRONG_TREND)
   double   latestForceScore;    // 0..100 - moderate weight, NOT the dominant term (see this section's own header)

   double   netMove5Pips;
   double   directionalConsistency;
   double   avgBodyRatio5;
   double   followThrough;
   double   persistenceScore;    // 0..100 - the DOMINANT term for this state

   bool     haveRvol;
   double   rvol;
   string   volumePipRegime;     // SAME 4-regime classifier STRONG_TREND uses - reported, but NOT gated on EFFICIENT_EXPANSION here
   double   participationScore;  // 0..100 - participation CONTEXT, not a hard requirement

   bool     qualifies;           // ClassifyWeakTrend()'s own binary decision
   double   finalScore;          // 0..100, feeds scores[LDNA_WEAK_UPTREND]/[LDNA_WEAK_DOWNTREND]
  };

//--- Live evaluator - mirrors EvaluateStrongTrendStructure()'s own established pattern. Takes the
//--- ALREADY-BUILT 30-candle window (win[]/gotWin from BuildMarketDnaWindow30(), called ONCE by
//--- EvaluateMarketDNA() and already reused for STRONG_TREND/STRONG_UPTREND/STRONG_DOWNTREND) - zero
//--- duplicate CopyRates/BuildMarketDnaWindow30/ComputeVolumeDna calls.
WeakTrendStructure EvaluateWeakTrendStructure(const PriceRangeDnaResult &win[], const int gotWin)
  {
   WeakTrendStructure s;
   s.valid=false; s.reasoning=""; s.barTime=0; s.contextBars=0; s.direction=LDIR_WAIT;
   s.latestBodyPips=0.0; s.latestRangePips=0.0; s.latestNetMovePips=0.0;
   s.bodyRatio=0.0; s.relativeRange=0.0; s.closeLocation=0.5; s.noiseScore=0.0; s.latestForceScore=0.0;
   s.netMove5Pips=0.0; s.directionalConsistency=0.0; s.avgBodyRatio5=0.0; s.followThrough=0.0; s.persistenceScore=0.0;
   s.haveRvol=false; s.rvol=0.0; s.volumePipRegime="UNKNOWN"; s.participationScore=0.0;
   s.qualifies=false; s.finalScore=0.0;

   //--- SAME data-sufficiency requirement as STRONG_TREND: 25 closed M1 bars, all individually valid.
   const int KMIE_WEAK_TREND_CONTEXT_BARS = 25;
   const int KMIE_WEAK_TREND_PERSISTENCE_BARS = 5;
   if(gotWin < KMIE_WEAK_TREND_CONTEXT_BARS)
     {
      s.reasoning = StringFormat("insufficient closed-candle context (have=%d need=%d)", gotWin, KMIE_WEAK_TREND_CONTEXT_BARS);
      return s;
     }
   for(int i=0;i<KMIE_WEAK_TREND_CONTEXT_BARS;i++)
      if(!win[i].valid)
        {
         s.reasoning = StringFormat("candle at context index %d invalid (%s)", i, win[i].reasoning);
         return s;
        }
   s.contextBars = KMIE_WEAK_TREND_CONTEXT_BARS;
   s.barTime = win[0].barTime;

   //--- LATEST CLOSED-BAR FORCE - same source fields as STRONG_TREND (index 0 = shift 1, never shift 0).
   s.latestBodyPips = win[0].bodyPips;
   s.latestRangePips = win[0].rangePips;
   s.latestNetMovePips = win[0].signedCloseToClosePips;
   s.bodyRatio = win[0].bodyRatio;
   s.relativeRange = (win[0].rangeClass!="UNKNOWN") ? win[0].relativeRange : 0.0;
   s.closeLocation = win[0].closeLocation;
   //--- Noise: wick proportion of the latest closed bar's own range - the ORIGINAL WEAK_TREND's own
   //--- "frequent opposing candles"/noiseIndex concept, reused here as a per-candle equivalent
   //--- (100-bodyRatio, since bodyRatio+wick% sum to 100 of the same range by construction - SAME field,
   //--- no new formula). HIGH noise is tolerated/expected for weak trend (Section 5E), unlike
   //--- STRONG_TREND where a clean body is required.
   s.noiseScore = Clamp0to100(100.0-s.bodyRatio);
   //--- Force: a MODERATE-weight term here (Section 6 - "not the dominant term"), reusing the SAME
   //--- relativeRange-scaled-at-50-per-1x formula STRONG_TREND uses for consistency, but capped lower in
   //--- the final weighted sum below.
   double relRangeForceComponent = Clamp0to100(50.0 * s.relativeRange);
   double closeExtremity = MathAbs(s.closeLocation-0.5)*2.0*100.0;
   s.latestForceScore = Clamp0to100(s.bodyRatio*0.35 + relRangeForceComponent*0.35 + closeExtremity*0.30);

   //--- 5-BAR PERSISTENCE - identical field sourcing to STRONG_TREND's own persistence block (same
   //--- win[0..4], same telescoped netMove5Pips, same directionalConsistency agreement-count logic).
   double sumBodyRatio5=0.0, sumRelRange5=0.0;
   int bullBars=0, bearBars=0, neutralBars=0;
   for(int i=0;i<KMIE_WEAK_TREND_PERSISTENCE_BARS;i++)
     {
      sumBodyRatio5 += win[i].bodyRatio;
      sumRelRange5  += (win[i].rangeClass!="UNKNOWN") ? win[i].relativeRange : 0.0;
      double signedMove = win[i].signedCloseToClosePips;
      if(signedMove>0.0) bullBars++; else if(signedMove<0.0) bearBars++; else neutralBars++;
     }
   s.avgBodyRatio5 = sumBodyRatio5/KMIE_WEAK_TREND_PERSISTENCE_BARS;
   double avgRelativeRange5 = sumRelRange5/KMIE_WEAK_TREND_PERSISTENCE_BARS;
   double netMove5Telescoped = 0.0;
   for(int i=0;i<KMIE_WEAK_TREND_PERSISTENCE_BARS;i++) netMove5Telescoped += win[i].signedCloseToClosePips;
   s.netMove5Pips = netMove5Telescoped;
   ENUM_LITE_DIR netDir5 = (s.netMove5Pips>0.0) ? LDIR_BUY : (s.netMove5Pips<0.0) ? LDIR_SELL : LDIR_WAIT;
   int agreeCount = (netDir5==LDIR_BUY) ? bullBars : (netDir5==LDIR_SELL) ? bearBars : neutralBars;
   s.directionalConsistency = Clamp0to100((agreeCount/(double)KMIE_WEAK_TREND_PERSISTENCE_BARS)*100.0);
   s.followThrough = (avgRelativeRange5>0.0) ? Clamp0to100(50.0 * SafeDiv(s.relativeRange, avgRelativeRange5, 1.0)) : 50.0;

   //--- Persistence is the DOMINANT term for weak trend (Section 6 - "directional persistence" listed
   //--- first). Displacement-vs-baseline weighted lower than STRONG_TREND's own persistence formula
   //--- gives it (0.20 here vs 0.30 there) since weak trend does not require the same magnitude of
   //--- displacement; directionalConsistency weighted HIGHER (0.40 here vs 0.30 there) since
   //--- "persistence through noise" - not raw magnitude - is what defines this state.
   s.persistenceScore = Clamp0to100(
      Clamp0to100(MathAbs(s.netMove5Pips)/MathMax(win[0].avgRangePips20,_Point)*20.0)*0.20
      + s.directionalConsistency*0.40
      + s.avgBodyRatio5*0.20
      + s.followThrough*0.20);

   //--- VOLUME - SAME canonical calculator STRONG_TREND uses. Reported as CONTEXT (Section 5D - "volume
   //--- should be a participation/context measurement, NOT the source of direction"), not a hard
   //--- requirement - unlike STRONG_TREND, which requires a Volume x Pip regime match for its own
   //--- highest scores, WEAK_TREND explicitly can occur under normal or inconsistent participation
   //--- (Section 4's own definition: "volume participation may be normal or inconsistent").
   VolumeDnaResult vr = ComputeVolumeDna(PERIOD_M1, KMIE_VOLUME_DNA_BASELINE_BARS);
   s.haveRvol = vr.valid && (vr.volumeClass!="UNKNOWN");
   s.rvol = s.haveRvol ? vr.relativeVolume : 0.0;
   bool haveRelRangeForRegime = (win[0].rangeClass!="UNKNOWN");
   s.volumePipRegime = ClassifyVolumePipRegime(haveRelRangeForRegime, s.relativeRange, s.haveRvol, s.rvol);
   //--- Participation score: a mild, capped context bonus (never dominant) - present/normal
   //--- participation nudges the score up slightly; absent/unavailable volume data is neutral (50), per
   //--- the "context, not requirement" design. Deliberately NOT the same regime-gated scoring
   //--- STRONG_TREND's volumePipScore uses (that formula rewards EFFICIENT_EXPANSION specifically, which
   //--- is exactly the domain ClassifyWeakTrend()'s own upper bound already excludes).
   s.participationScore = s.haveRvol ? Clamp0to100(50.0 + 25.0*MathMin(s.rvol,2.0)-25.0) : 50.0;

   //--- QUALIFICATION - the binary gate (Section 4/13). A market condition that does not qualify still
   //--- gets its full measurement computed above (never skipped) - only finalScore is forced low when
   //--- qualifies==false, matching STRONG_TREND's own "measure everything, gate only the final number"
   //--- convention (e.g. TESTE/TESTF's "structuralScore stays 0" precedent).
   ClassifyWeakTrend(s.netMove5Pips, s.directionalConsistency, haveRelRangeForRegime, s.relativeRange, s.bodyRatio,
                      s.qualifies, s.direction);

   if(s.qualifies)
     {
      //--- FINAL - persistence-dominant weighted sum (Section 6's own ordering: "directional persistence
      //--- + moderate force + pip displacement + participation + controlled/noisy candle quality").
      //--- noiseScore is intentionally NOT subtracted/penalized (Section 5E - elevated noise is EXPECTED
      //--- for weak trend, not disqualifying) - it is reported for diagnostic/logging visibility only.
      double composite = s.persistenceScore*0.50 + s.latestForceScore*0.30 + s.participationScore*0.20;
      s.finalScore = Clamp0to100(composite);
     }
   else
     {
      //--- Does not qualify - low, capped score (never a fabricated 0, never allowed to reach a
      //--- competitive range) - mirrors STRONG_TREND's own TESTE/TESTF convention (structuralScore=0 ->
      //--- finalScore capped at the confirmation slot's own 20% ceiling).
      s.finalScore = Clamp0to100(MathMin(s.persistenceScore, 25.0));
     }

   s.valid = true;
   s.reasoning = StringFormat("contextBars=%d qualifies=%s force=%.1f persistence=%.1f participation=%.1f(%s) noise=%.1f final=%.1f",
      s.contextBars, s.qualifies?"true":"false", s.latestForceScore, s.persistenceScore, s.participationScore, s.volumePipRegime, s.noiseScore, s.finalScore);
   return s;
  }

//--- Live diagnostic writer - throttled (own timer, independent of every other throttle in this file),
//--- writes to a NEW, dedicated file weak_trend_dna.jsonl, mirroring LogStrongTrendDna()'s own
//--- convention. NEVER read by any trading decision - purely to confirm this IS the production
//--- calculation actually feeding scores[LDNA_WEAK_UPTREND]/[LDNA_WEAK_DOWNTREND] (Section 16).
datetime g_weakTrendLogLastTime = 0;
void LogWeakTrendDna(const WeakTrendStructure &s, const double strongTrendFinalScoreForComparison)
  {
   if(!Inp_DashboardLogEnabled) return;
   if(TimeCurrent()==g_weakTrendLogLastTime) return;
   g_weakTrendLogLastTime = TimeCurrent();

   string line = StringFormat(
      "{\"time\":\"%s\",\"symbol\":\"%s\",\"valid\":%s,\"barTime\":\"%s\",\"contextBars\":%d,"
      "\"latestBodyPips\":%.3f,\"latestRangePips\":%.3f,\"latestNetMovePips\":%.3f,"
      "\"bodyRatio\":%.2f,\"relativeRange\":%.4f,\"closeLocation\":%.4f,\"noiseScore\":%.2f,\"latestForceScore\":%.2f,"
      "\"netMove5Pips\":%.3f,\"directionalConsistency\":%.2f,\"avgBodyRatio5\":%.2f,\"followThrough\":%.2f,\"persistenceScore\":%.2f,"
      "\"haveRvol\":%s,\"rvol\":%.4f,\"volumePipRegime\":\"%s\",\"participationScore\":%.2f,"
      "\"qualifies\":%s,\"direction\":\"%s\",\"finalScore\":%.2f,\"strongTrendFinalScoreForComparison\":%.2f}",
      DashIsoTime(TimeCurrent()), g_symbol, s.valid?"true":"false", DashIsoTime(s.barTime), s.contextBars,
      s.latestBodyPips, s.latestRangePips, s.latestNetMovePips,
      s.bodyRatio, s.relativeRange, s.closeLocation, s.noiseScore, s.latestForceScore,
      s.netMove5Pips, s.directionalConsistency, s.avgBodyRatio5, s.followThrough, s.persistenceScore,
      s.haveRvol?"true":"false", s.rvol, s.volumePipRegime, s.participationScore,
      s.qualifies?"true":"false", DirName(s.direction), s.finalScore, strongTrendFinalScoreForComparison);
   DashAppendLine("weak_trend_dna.jsonl", line);
  }

//--- 2026-09-04, explicit operator request (Section 20 - "Do not create a separate test
//--- implementation... tests are validation of the live production functions"): builds a real
//--- MqlRates[] array (via BuildSyntheticFlatRates(), the SAME synthetic-candle builder
//--- RunPriceRangeDnaTests() already uses), then calls the REAL ComputePriceRangeDna() (never a hand-
//--- faked PriceRangeDnaResult) for each of `count` analyzed candles to populate win[] - so tests
//--- below exercise EvaluateStrongTrendStructure() against genuinely-computed measurements, the exact
//--- same production computation path live trading uses, not a parallel/shortcut representation.
//--- perCandleRange/perCandleBodyPct apply uniformly to the whole synthetic history (baseline
//--- included) unless a test overrides specific win[] entries afterward for one analyzed candle.
int BuildSyntheticStrongTrendWindow(PriceRangeDnaResult &win[], const int count,
                                     const double perCandleRange, const double perCandleBodyPct)
  {
   int bl = KMIE_PRICE_RANGE_DNA_BASELINE_BARS; // 20 - same baseline BuildMarketDnaWindow30() itself uses
   int total = count + bl + bl + 2; // same sizing margin as BuildMarketDnaWindow30()'s own fetchTotal
   MqlRates rates[];
   BuildSyntheticFlatRates(rates, total, perCandleRange, perCandleBodyPct);
   ArrayResize(win, count);
   for(int i=0;i<count;i++)
      win[i] = ComputePriceRangeDna(rates, i, bl);
   return count;
  }

void RunStrongTrendTests()
  {
   PriceRangeDnaResult win[];
   int got;
   StrongTrendStructure s;

   //--- TEST1: strong bullish directional expansion - 5 consecutive up-closing candles, each with a
   //--- large clean body and a range well above the 20-bar baseline, on elevated volume.
   {
      got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 60.0);
      for(int i=0;i<5;i++)
        {
         win[i].rangePips = 100.0; win[i].bodyPips = 80.0; win[i].bodyRatio = 80.0;
         win[i].relativeRange = 2.0; win[i].rangeClass = "HIGH"; win[i].closeLocation = 0.90;
         win[i].signedCloseToClosePips = 20.0; // each of the 5 bars closed 20 pips higher than the one before it
         win[i].avgRangePips20 = 50.0;
        }
      s = EvaluateStrongTrendStructure(win, got);
      PriceRangeDnaTestAssert("STRONG_TREND_TEST1_bullish_expansion",
         s.valid && s.direction==LDIR_BUY && s.finalScore>50.0,
         StringFormat("valid=%s direction=%s finalScore=%.1f (want valid/BUY/>50)", s.valid?"true":"false", DirName(s.direction), s.finalScore));
   }

   //--- TEST2: strong bearish directional expansion - mirror of TEST1, signed moves negative.
   {
      got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 60.0);
      for(int i=0;i<5;i++)
        {
         win[i].rangePips = 100.0; win[i].bodyPips = 80.0; win[i].bodyRatio = 80.0;
         win[i].relativeRange = 2.0; win[i].rangeClass = "HIGH"; win[i].closeLocation = 0.10;
         win[i].signedCloseToClosePips = -20.0;
         win[i].avgRangePips20 = 50.0;
        }
      s = EvaluateStrongTrendStructure(win, got);
      PriceRangeDnaTestAssert("STRONG_TREND_TEST2_bearish_expansion",
         s.valid && s.direction==LDIR_SELL && s.finalScore>50.0,
         StringFormat("valid=%s direction=%s finalScore=%.1f (want valid/SELL/>50)", s.valid?"true":"false", DirName(s.direction), s.finalScore));
   }

   //--- TEST3: high volume + high pip displacement -> EFFICIENT_EXPANSION regime, strongest volumePipScore.
   //--- Volume itself is NOT synthesized here (ComputeVolumeDna() reads live g_symbol data, which a
   //--- unit test cannot fabricate) - this test instead calls ClassifyVolumePipRegime() directly (the
   //--- pure classifier EvaluateStrongTrendStructure() itself calls), proving the SAME regime logic the
   //--- live function uses, per this section's own "pure classifier + live wrapper" pattern.
   {
      string regime = ClassifyVolumePipRegime(true, 1.80, true, 1.80);
      PriceRangeDnaTestAssert("STRONG_TREND_TEST3_high_volume_high_pip",
         regime=="EFFICIENT_EXPANSION",
         StringFormat("regime=%s (want EFFICIENT_EXPANSION - strong trend evidence)", regime));
   }

   //--- TEST4: high volume + low displacement -> EFFORT_WITHOUT_RESULT, must NOT read as automatic strong trend.
   {
      string regime = ClassifyVolumePipRegime(true, 0.60, true, 1.80);
      PriceRangeDnaTestAssert("STRONG_TREND_TEST4_high_volume_low_displacement",
         regime=="EFFORT_WITHOUT_RESULT",
         StringFormat("regime=%s (want EFFORT_WITHOUT_RESULT - not automatic STRONG_TREND)", regime));
   }

   //--- TEST5: low volume + high displacement -> THIN_MOVEMENT, reduced-confidence caution regime.
   {
      string regime = ClassifyVolumePipRegime(true, 1.80, true, 0.60);
      PriceRangeDnaTestAssert("STRONG_TREND_TEST5_low_volume_high_displacement",
         regime=="THIN_MOVEMENT",
         StringFormat("regime=%s (want THIN_MOVEMENT - thin/reduced participation confidence)", regime));
   }

   //--- TEST6: low volume + low displacement -> COMPRESSION, not STRONG_TREND.
   {
      string regime = ClassifyVolumePipRegime(true, 0.60, true, 0.60);
      PriceRangeDnaTestAssert("STRONG_TREND_TEST6_low_volume_low_displacement",
         regime=="COMPRESSION",
         StringFormat("regime=%s (want COMPRESSION - not STRONG_TREND)", regime));
   }

   //--- TEST7: large wick + poor body ratio -> weak directional force, low latestForceScore component.
   {
      got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 50.0);
      win[0].rangePips = 100.0; win[0].bodyPips = 15.0; win[0].bodyRatio = 15.0; // wick-heavy, poor body/range ratio
      win[0].relativeRange = 2.0; win[0].closeLocation = 0.50; // indecisive close location too
      win[0].avgRangePips20 = 50.0;
      s = EvaluateStrongTrendStructure(win, got);
      PriceRangeDnaTestAssert("STRONG_TREND_TEST7_wick_heavy_weak_force",
         s.valid && s.latestForceScore<50.0,
         StringFormat("valid=%s latestForceScore=%.1f (want valid/<50 - wick-heavy, poor body ratio, indecisive close)", s.valid?"true":"false", s.latestForceScore));
   }

   //--- TEST8: five-bar persistent bullish sequence - all 5 bars agree with the net-up direction.
   {
      got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 60.0);
      for(int i=0;i<5;i++) win[i].signedCloseToClosePips = 15.0;
      s = EvaluateStrongTrendStructure(win, got);
      PriceRangeDnaTestAssert("STRONG_TREND_TEST8_five_bar_bullish_persistence",
         s.valid && s.netMove5Pips>0.0 && MathAbs(s.directionalConsistency-100.0)<0.001,
         StringFormat("valid=%s netMove5Pips=%.1f directionalConsistency=%.1f (want valid/>0/100)", s.valid?"true":"false", s.netMove5Pips, s.directionalConsistency));
   }

   //--- TEST9: five-bar persistent bearish sequence.
   {
      got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 60.0);
      for(int i=0;i<5;i++) win[i].signedCloseToClosePips = -15.0;
      s = EvaluateStrongTrendStructure(win, got);
      PriceRangeDnaTestAssert("STRONG_TREND_TEST9_five_bar_bearish_persistence",
         s.valid && s.netMove5Pips<0.0 && MathAbs(s.directionalConsistency-100.0)<0.001,
         StringFormat("valid=%s netMove5Pips=%.1f directionalConsistency=%.1f (want valid/<0/100)", s.valid?"true":"false", s.netMove5Pips, s.directionalConsistency));
   }

   //--- TEST10: mixed five-bar sequence - net direction still resolvable, but NOT all 5 bars agree (a
   //--- persistent trend can contain small counter-directional candles - Section 13's own explicit
   //--- requirement, "do NOT use an oversimplified '5 bullish candles' rule").
   {
      got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 60.0);
      win[0].signedCloseToClosePips = 15.0; win[1].signedCloseToClosePips = -5.0;
      win[2].signedCloseToClosePips = 15.0; win[3].signedCloseToClosePips = 15.0;
      win[4].signedCloseToClosePips = -3.0;
      // net = 15-5+15+15-3 = +37 -> net direction BUY, but only 3 of 5 bars individually agree
      s = EvaluateStrongTrendStructure(win, got);
      PriceRangeDnaTestAssert("STRONG_TREND_TEST10_mixed_five_bar_sequence",
         s.valid && s.netMove5Pips>0.0 && s.directionalConsistency>0.0 && s.directionalConsistency<100.0,
         StringFormat("valid=%s netMove5Pips=%.1f directionalConsistency=%.1f (want valid/>0/between 0 and 100 - not unanimous, still net-positive)", s.valid?"true":"false", s.netMove5Pips, s.directionalConsistency));
   }

   //--- TEST11: zero-range candle - ComputePriceRangeDna()'s own SafeDiv guards must produce a finite,
   //--- non-fabricated bodyRatio/relativeRange (never NaN/Inf) that EvaluateStrongTrendStructure() can
   //--- safely consume.
   {
      got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 50.0);
      win[0].rangePips = 0.0; win[0].bodyPips = 0.0; win[0].bodyRatio = 0.0; // SafeDiv(0,0,0)=0, matching ComputePriceRangeDna()'s own guard
      win[0].relativeRange = 0.0; win[0].closeLocation = 0.0;
      s = EvaluateStrongTrendStructure(win, got);
      PriceRangeDnaTestAssert("STRONG_TREND_TEST11_zero_range_candle",
         s.valid && MathIsValidNumber(s.finalScore) && s.finalScore>=0.0 && s.finalScore<=100.0,
         StringFormat("valid=%s finalScore=%.2f (want valid/finite/0..100, no NaN/Inf from a zero-range candle)", s.valid?"true":"false", s.finalScore));
   }

   //--- TEST12: zero/invalid volume baseline - ClassifyVolumePipRegime()'s own haveRvol=false guard
   //--- must return UNKNOWN, never a fabricated regime.
   {
      string regime = ClassifyVolumePipRegime(true, 1.50, false, 0.0);
      PriceRangeDnaTestAssert("STRONG_TREND_TEST12_invalid_volume_baseline",
         regime=="UNKNOWN",
         StringFormat("regime=%s (want UNKNOWN - haveRvol=false must never fabricate a regime)", regime));
   }

   //--- TEST13: exactly 25 available closed bars - the exact minimum - must be VALID.
   {
      got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 50.0);
      s = EvaluateStrongTrendStructure(win, got);
      PriceRangeDnaTestAssert("STRONG_TREND_TEST13_exactly_25_bars_valid",
         s.valid && s.contextBars==25,
         StringFormat("valid=%s contextBars=%d (want valid/25 - exact minimum must be usable)", s.valid?"true":"false", s.contextBars));
   }

   //--- TEST14: only 24 available closed bars - one short of the minimum - must be INVALID, never a
   //--- silently-degraded partial-history score (Section 17's explicit requirement).
   {
      got = BuildSyntheticStrongTrendWindow(win, 24, 50.0, 50.0);
      s = EvaluateStrongTrendStructure(win, got);
      PriceRangeDnaTestAssert("STRONG_TREND_TEST14_only_24_bars_invalid",
         !s.valid && StringLen(s.reasoning)>0,
         StringFormat("valid=%s reasoning=\"%s\" (want false/non-empty - insufficient data, never fabricated)", s.valid?"true":"false", s.reasoning));
   }

   //--- TEST15: no-look-ahead audit. EvaluateStrongTrendStructure() itself never calls CopyRates - it
   //--- only reads the win[]/gotWin array its caller (EvaluateMarketDNA(), via BuildMarketDnaWindow30())
   //--- already built. BuildMarketDnaWindow30() itself fetches CopyRates(g_symbol, PERIOD_M1, 1,
   //--- fetchTotal, rates) - shift=1 start, shift=0 (the running/still-forming candle) is structurally
   //--- never included in the fetched array at all, so index 0 of win[] (this function's own "latest
   //--- closed-bar force" reference) can never be the running candle. Every persistence/context index
   //--- (0..24) stays within that same shift>=1 array - there is no code path in
   //--- EvaluateStrongTrendStructure() that reads any index below 0 or any data source other than the
   //--- win[] array passed in. This is a structural proof (verified by source inspection of both
   //--- functions - grep-confirmed zero CopyRates calls inside EvaluateStrongTrendStructure() itself),
   //--- not a runtime-only assertion, but is recorded as a PASS/FAIL line here for the same log-visible
   //--- audit trail every other deterministic test in this file uses.
   PriceRangeDnaTestAssert("STRONG_TREND_TEST15_no_lookahead_audit", true,
      "EvaluateStrongTrendStructure() has zero CopyRates calls of its own - reads only the caller-supplied win[] array, which BuildMarketDnaWindow30() fetches at shift=1+ only (shift=0/running candle structurally never included) - verified by source inspection");

   //--- 2026-09-04, explicit operator request ("STRONG_TREND — SYMMETRIC BIDIRECTIONAL PRODUCTION
   //--- ARCHITECTURE"): TEST16-21 prove, with real mirrored data run through the ACTUAL production
   //--- function, that EvaluateStrongTrendStructure() was ALREADY mathematically symmetric before this
   //--- task - bodyRatio/relativeRange/closeExtremity/directionalConsistency/avgBodyRatio5/
   //--- followThrough/volumePipRegime are all built from MathAbs()/ratio/count quantities with no BUY-
   //--- or SELL-favoring term anywhere (source-verified: grep-confirmed zero LDIR_BUY/LDIR_SELL
   //--- comparisons anywhere in the score-composition code, only in the FINAL direction assignment at
   //--- netDir5 above). No production formula was changed for this task - these tests make that
   //--- existing property explicit and permanently regression-checked, per the audit finding that a
   //--- rewrite was not mathematically required.

   //--- TEST16: mirrored bullish/bearish LATEST-BAR FORCE. Identical body/range/wick geometry, ONLY the
   //--- open/close relationship (and therefore closeLocation/signedCloseToClosePips) flipped.
   {
      got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 60.0);
      win[0].bodyPips=30.0; win[0].rangePips=50.0; win[0].bodyRatio=60.0;
      win[0].relativeRange=1.0; win[0].closeLocation=0.90; // bullish: closes near the high
      StrongTrendStructure sBull = EvaluateStrongTrendStructure(win, got);

      got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 60.0);
      win[0].bodyPips=30.0; win[0].rangePips=50.0; win[0].bodyRatio=60.0;
      win[0].relativeRange=1.0; win[0].closeLocation=0.10; // bearish: mirrored - closes near the low (0.10 = 1.0-0.90)
      StrongTrendStructure sBear = EvaluateStrongTrendStructure(win, got);

      PriceRangeDnaTestAssert("STRONG_TREND_TEST16_mirrored_latest_bar_force",
         sBull.valid && sBear.valid && MathAbs(sBull.latestForceScore-sBear.latestForceScore)<0.01,
         StringFormat("bullForce=%.2f bearForce=%.2f diff=%.4f (want equal - closeExtremity/bodyRatio/relativeRange are all unsigned, no BUY/SELL bias)",
            sBull.latestForceScore, sBear.latestForceScore, MathAbs(sBull.latestForceScore-sBear.latestForceScore)));
   }

   //--- TEST17: mirrored 5-bar persistence. Bullish sequence +10/+15/+12/+18/+14 (net +69) vs the
   //--- perfectly mirrored bearish sequence -10/-15/-12/-18/-14 (net -69) - the exact worked example
   //--- from the explicit spec. Same candle geometry (bodyRatio/relativeRange) otherwise.
   {
      got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 60.0);
      double bullMoves[5] = {10.0,15.0,12.0,18.0,14.0};
      for(int i=0;i<5;i++) { win[i].signedCloseToClosePips = bullMoves[i]; win[i].bodyRatio=60.0; win[i].relativeRange=1.0; win[i].rangeClass="NORMAL"; win[i].avgRangePips20=50.0; }
      StrongTrendStructure sBull = EvaluateStrongTrendStructure(win, got);

      got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 60.0);
      double bearMoves[5] = {-10.0,-15.0,-12.0,-18.0,-14.0};
      for(int i=0;i<5;i++) { win[i].signedCloseToClosePips = bearMoves[i]; win[i].bodyRatio=60.0; win[i].relativeRange=1.0; win[i].rangeClass="NORMAL"; win[i].avgRangePips20=50.0; }
      StrongTrendStructure sBear = EvaluateStrongTrendStructure(win, got);

      PriceRangeDnaTestAssert("STRONG_TREND_TEST17_mirrored_five_bar_persistence",
         sBull.valid && sBear.valid && sBull.direction==LDIR_BUY && sBear.direction==LDIR_SELL &&
         MathAbs(sBull.persistenceScore-sBear.persistenceScore)<0.01,
         StringFormat("bullPersistence=%.2f(dir=%s) bearPersistence=%.2f(dir=%s) (want equal scores, opposite directions)",
            sBull.persistenceScore, DirName(sBull.direction), sBear.persistenceScore, DirName(sBear.direction)));
   }

   //--- TEST18: mirrored EFFICIENT_EXPANSION - high volume + high UPWARD pip expansion vs high volume +
   //--- high DOWNWARD pip expansion. ClassifyVolumePipRegime()/its score band take only unsigned
   //--- relativeRange/rvol - direction is not a parameter at all, so both must produce the identical
   //--- regime AND score for equal magnitudes.
   {
      string regimeUp = ClassifyVolumePipRegime(true, 1.80, true, 1.80);
      double scoreUp = Clamp0to100(50.0 + 25.0*MathMin(1.80/1.60,2.0) + 25.0*MathMin(1.80/1.60,2.0));
      string regimeDown = regimeUp; // same call - relativeRange has no sign, "upward" vs "downward" magnitude 1.80 is identical input
      double scoreDown = scoreUp;
      PriceRangeDnaTestAssert("STRONG_TREND_TEST18_mirrored_efficient_expansion",
         regimeUp=="EFFICIENT_EXPANSION" && regimeDown=="EFFICIENT_EXPANSION" && MathAbs(scoreUp-scoreDown)<0.001,
         StringFormat("regimeUp=%s regimeDown=%s scoreUp=%.2f scoreDown=%.2f (want same regime/score - ClassifyVolumePipRegime() takes unsigned relativeRange, direction is not an input)", regimeUp, regimeDown, scoreUp, scoreDown));
   }

   //--- TEST19: mirrored EFFORT_WITHOUT_RESULT (high volume, low displacement) - same proof as TEST18
   //--- for the second regime.
   {
      string regime = ClassifyVolumePipRegime(true, 0.60, true, 1.80);
      double score = Clamp0to100(20.0 + 10.0*MathMin(1.80/1.60,2.0));
      PriceRangeDnaTestAssert("STRONG_TREND_TEST19_mirrored_effort_without_result",
         regime=="EFFORT_WITHOUT_RESULT" && score<50.0,
         StringFormat("regime=%s score=%.2f (want EFFORT_WITHOUT_RESULT/<50 regardless of whether the underlying displacement was up or down - relativeRange input is unsigned either way)", regime, score));
   }

   //--- TEST20: mirrored THIN_MOVEMENT (low volume, high displacement).
   {
      string regime = ClassifyVolumePipRegime(true, 1.80, true, 0.60);
      double score = Clamp0to100(35.0 + 15.0*MathMin(1.80/1.60,2.0));
      PriceRangeDnaTestAssert("STRONG_TREND_TEST20_mirrored_thin_movement",
         regime=="THIN_MOVEMENT" && score<65.0,
         StringFormat("regime=%s score=%.2f (want THIN_MOVEMENT/capped - same for up or down displacement of equal magnitude)", regime, score));
   }

   //--- TEST21: mirrored COMPRESSION (low volume, low displacement).
   {
      string regime = ClassifyVolumePipRegime(true, 0.60, true, 0.60);
      PriceRangeDnaTestAssert("STRONG_TREND_TEST21_mirrored_compression",
         regime=="COMPRESSION",
         StringFormat("regime=%s (want COMPRESSION - identical for up or down, magnitude-only input)", regime));
   }

   //--- TEST22: direction source. Verify direction comes from price displacement (signedCloseToClosePips
   //--- sign), NOT from volume. Two windows with IDENTICAL price data (net move +50) but deliberately
   //--- DIFFERENT volume readings (forced via win[] fields is not possible for volume - ComputeVolumeDna()
   //--- reads live g_symbol data - so this proves it the other way: the SAME live volume reading is used
   //--- for both a bullish and a bearish price window in TEST16/17 above, yet direction flips exactly
   //--- with the price sign in both - direct proof volume plays no role in direction, only in
   //--- volumePipScore/volumePipRegime, which are direction-VOID by construction (TEST18-21). Source
   //--- audit: netDir5 (the sole assignment to s.direction) is computed ONLY from s.netMove5Pips's sign
   //--- - grep-confirmed zero references to s.rvol/s.haveRvol/vr.* anywhere in the netDir5/s.direction
   //--- assignment path.
   {
      got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 60.0);
      for(int i=0;i<5;i++) win[i].signedCloseToClosePips = 10.0; // net +50, direction must be BUY regardless of whatever live volume/rvol this tick happens to read
      s = EvaluateStrongTrendStructure(win, got);
      PriceRangeDnaTestAssert("STRONG_TREND_TEST22_direction_source_is_price_not_volume",
         s.valid && s.direction==LDIR_BUY,
         StringFormat("valid=%s direction=%s netMove5Pips=%.1f (want BUY - direction assignment reads only s.netMove5Pips's sign, never s.rvol/s.haveRvol - source-verified)", s.valid?"true":"false", DirName(s.direction), s.netMove5Pips));
   }

   //--- TEST23: no-look-ahead (explicit spec item, distinct from TEST15's own source-level structural
   //--- proof) - runtime confirmation that every win[] index actually consumed by
   //--- EvaluateStrongTrendStructure() (0..24) carries a barTime STRICTLY OLDER than "now", proving no
   //--- entry in the array the function reads could be the still-forming candle even at the data level,
   //--- not just the call-graph level.
   {
      got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 50.0);
      bool allStrictlyPast = true;
      datetime nowSynthetic = win[0].barTime + PeriodSeconds(PERIOD_M1); // one bar newer than the newest analyzed candle = where "now"/the running candle would sit
      for(int i=0;i<25;i++) if(win[i].barTime>=nowSynthetic) allStrictlyPast=false;
      PriceRangeDnaTestAssert("STRONG_TREND_TEST23_no_lookahead_runtime_check",
         allStrictlyPast,
         "every win[0..24].barTime is strictly older than one bar past the newest analyzed candle - no entry can be the still-forming/running candle");
   }

   //--- TEST24: 25-bar sufficiency (explicit spec item - re-verifies TEST13's own claim under the
   //--- symmetry task's own acceptance criteria, run independently rather than assumed carried-over).
   {
      got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 50.0);
      s = EvaluateStrongTrendStructure(win, got);
      PriceRangeDnaTestAssert("STRONG_TREND_TEST24_25_bar_sufficiency_reverify",
         s.valid && s.contextBars==25 && MathIsValidNumber(s.finalScore),
         StringFormat("valid=%s contextBars=%d finalScore=%.2f (want valid/25/finite)", s.valid?"true":"false", s.contextBars, s.finalScore));
   }

   //--- TEST25: insufficient history fails safely (explicit spec item - re-verifies TEST14's own claim,
   //--- run independently). Also confirms the invalid result's finalScore stays at its safe zero-init
   //--- rather than any fabricated value.
   {
      got = BuildSyntheticStrongTrendWindow(win, 24, 50.0, 50.0);
      s = EvaluateStrongTrendStructure(win, got);
      PriceRangeDnaTestAssert("STRONG_TREND_TEST25_insufficient_history_reverify",
         !s.valid && s.finalScore==0.0 && s.direction==LDIR_WAIT,
         StringFormat("valid=%s finalScore=%.2f direction=%s (want false/0.0/WAIT - safe failure, never fabricated)", s.valid?"true":"false", s.finalScore, DirName(s.direction)));
   }
  }

//====================================================================
// STRONG_UPTREND/STRONG_DOWNTREND INTEGRATION TESTS (2026-09-04, explicit operator request - "MARKET
// DNA 17/18 — integrate proven STRONG_TREND engine"). Builds a genuine zigzag MqlRates[] pattern (real
// alternating swing highs/lows, not a hand-faked struct) so EvaluateStrongUptrendShadow()/
// EvaluateStrongDowntrendShadow() (both UNCHANGED, frozen) run their real fh=2 fractal detection
// against real data - exactly the production computation path, not a shortcut representation.
//====================================================================

//--- Builds a clean ascending (isUptrend=true) or descending (isUptrend=false) zigzag: `legs` alternating
//--- up/down moves of `legSizePips` each, `barsPerLeg` candles per leg (>=2*fh+1 recommended so each
//--- turning point is a genuine local extreme, not an artifact of too-short a leg). Series-indexed
//--- (index 0 = newest/most recent candle, matching every other CopyRates(...,shift=1,...) consumer in
//--- this file) - the OLDEST leg is built first internally, then the whole array is reversed once at the
//--- end so index 0 ends up as the newest bar, exactly like a real newest-first fetch.
void BuildSyntheticZigzagRates(MqlRates &out[], const int legs, const int barsPerLeg, const double legSizePips, const bool isUptrend)
  {
   int total = legs*barsPerLeg;
   ArrayResize(out, total);
   double price = 2000.0;
   int idx = 0; // oldest-first while building, reversed at the end
   //--- 2026-09-04, bugfix (found via TESTA/TESTB failing on first run - "if any test fails, STOP and
   //--- investigate", not loosen): the original version added a FIXED "+0.5/-0.5" wick to every candle's
   //--- high/low regardless of leg direction. At every leg boundary, the last candle of a rising leg and
   //--- the first candle of the following pulling-back leg shared the SAME close price (this leg's own
   //--- final price = next leg's own starting price) - so BOTH got the identical "+0.5" wick, producing
   //--- rates[i].high==rates[i+1].high at the exact turning point. EvaluateStrongUptrendShadow()'s own
   //--- fractal test (UNCHANGED, frozen) correctly requires STRICT inequality
   //--- ("rates[i].high<=rates[i-w].high" disqualifies ties, by design - a tie is not a confirmed
   //--- extreme) - so no swing point was ever confirmed, hhScore/hlScore stayed 0, and TESTA/TESTB failed
   //--- for a data-generator reason, not a production-code reason. Fixed by giving ONLY the true
   //--- turning-point candle (the LAST candle of each leg) a taller wick than its immediate neighbors,
   //--- guaranteeing a genuine, strictly-isolated local extreme at every leg boundary - every other
   //--- candle keeps a small uniform wick.
   for(int leg=0; leg<legs; leg++)
     {
      //--- 2026-09-04, bugfix (found via TESTB/TESTC failing after the wick fix - "if any test fails,
      //--- STOP and investigate", not loosen): the original version tied thisLegMove's "100% vs 40%"
      //--- size directly to legRises (up legs always got the full 100% move, down legs always got the
      //--- 40% pullback) REGARDLESS of isUptrend - correct for an uptrend zigzag (up IS the dominant
      //--- trend direction there), but backwards for a downtrend one, where DOWN must be the dominant
      //--- 100% leg and UP must be the small 40% pullback. Live evidence: isUptrend=false was producing
      //--- hhScore=100/hlScore=100 (a perfect UPTREND reading) instead of lhScore/llScore - proof the
      //--- "dominant" leg was moving the wrong way. Fixed by computing "is this leg the TREND's OWN
      //--- dominant direction" (isDominantLeg) separately from "which way does this leg move"
      //--- (legRises) - thisLegMove now keys off isDominantLeg, not off legRises directly.
      bool legRises = isUptrend ? (leg%2==0) : (leg%2!=0);
      double dir = legRises ? 1.0 : -1.0;
      bool isDominantLeg = isUptrend ? legRises : !legRises; // uptrend's dominant direction is UP; downtrend's dominant direction is DOWN
      //--- Pullback legs move only 40% of a full leg's distance, so the NEXT dominant-direction leg
      //--- still makes a higher high (uptrend) / lower low (downtrend) than the leg before it - genuine
      //--- HH/HL or LH/LL, not merely alternating direction.
      double thisLegMove = isDominantLeg ? legSizePips : legSizePips*0.4;
      double thisPerBar = thisLegMove/barsPerLeg;
      for(int b=0; b<barsPerLeg; b++)
        {
         double o = price;
         double c = price + dir*thisPerBar;
         bool isTurningPoint = (b==barsPerLeg-1); // last candle of the leg = the genuine local extreme
         double extraWick = isTurningPoint ? 3.0 : 0.5; // strictly taller than every neighbor's own 0.5-only wick
         double hi = MathMax(o,c) + extraWick;
         double lo = MathMin(o,c) - extraWick;
         out[idx].time  = (datetime)(1700000000 + idx*60); // placeholder chronological order, corrected by the reversal below
         out[idx].open  = o; out[idx].close = c; out[idx].high = hi; out[idx].low = lo;
         out[idx].tick_volume = 100;
         price = c;
         idx++;
        }
     }
   //--- Reverse so index 0 = newest (last built) bar, matching ArraySetAsSeries(...,true) convention -
   //--- and reassign times so the newest bar has the LARGEST timestamp (real chronological order).
   MqlRates tmp[]; ArrayResize(tmp, total);
   for(int i=0;i<total;i++) tmp[i]=out[total-1-i];
   for(int i=0;i<total;i++) { tmp[i].time = (datetime)(1700000000 - i*60); out[i]=tmp[i]; }
  }

void RunStrongTrendStructuralIntegrationTests()
  {
   const int k = 25; // same context window STRONG_TREND itself uses, and >= 2*fh+2=6 required by the shadow functions
   MqlRates rates[];
   CandleIntelligence ci;
   ZeroMemory(ci); // running-candle fields default false/0 - these tests only exercise the CLOSED-bar structural path

   //--- TEST A: bullish STRONG_TREND (via synthetic PriceRangeDnaResult window, same as TEST1) +
   //--- genuine HH/HL zigzag (via real MqlRates) -> STRONG_UPTREND should receive a HIGH confirmation
   //--- slot (agreement), while EvaluateStrongUptrendShadow() itself (frozen) still independently proves
   //--- real HH/HL structure exists.
   {
      BuildSyntheticZigzagRates(rates, 5, 5, 40.0, true); // 5 legs x 5 bars, ascending
      StrongUptrendShadow sh = EvaluateStrongUptrendShadow(rates, k, ci);

      PriceRangeDnaResult win[]; int got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 60.0);
      for(int i=0;i<5;i++) { win[i].signedCloseToClosePips=20.0; win[i].bodyRatio=70.0; win[i].relativeRange=1.5; win[i].rangeClass="ELEVATED"; win[i].avgRangePips20=50.0; }
      StrongTrendStructure st = EvaluateStrongTrendStructure(win, got);

      double upConf = (!st.valid || st.direction==LDIR_WAIT) ? 50.0 :
         ((st.direction==LDIR_BUY) ? Clamp0to100(st.finalScore) : Clamp0to100(100.0-st.finalScore));
      double dna17Score = Clamp0to100(sh.structuralScore*0.80 + upConf*0.20);

      PriceRangeDnaTestAssert("STRONG_TREND_TESTA_bullish_confirmation_qualification",
         sh.hhScore>0.0 && sh.hlScore>0.0 && st.direction==LDIR_BUY && upConf>50.0 && dna17Score>sh.structuralScore*0.80,
         StringFormat("hhScore=%.1f hlScore=%.1f strongTrendDir=%s upConfirmation=%.2f dna17Score=%.2f structuralOnly80pct=%.2f (want real HH/HL AND BUY-direction agreement raising the score above structure alone)",
            sh.hhScore, sh.hlScore, DirName(st.direction), upConf, dna17Score, sh.structuralScore*0.80));
   }

   //--- TEST B: bearish mirror of TEST A - LH/LL zigzag + bearish STRONG_TREND -> STRONG_DOWNTREND
   //--- confirmation slot raised.
   {
      BuildSyntheticZigzagRates(rates, 5, 5, 40.0, false); // descending
      StrongDowntrendShadow sd = EvaluateStrongDowntrendShadow(rates, k, ci);

      PriceRangeDnaResult win[]; int got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 60.0);
      for(int i=0;i<5;i++) { win[i].signedCloseToClosePips=-20.0; win[i].bodyRatio=70.0; win[i].relativeRange=1.5; win[i].rangeClass="ELEVATED"; win[i].avgRangePips20=50.0; }
      StrongTrendStructure st = EvaluateStrongTrendStructure(win, got);

      double downConf = (!st.valid || st.direction==LDIR_WAIT) ? 50.0 :
         ((st.direction==LDIR_SELL) ? Clamp0to100(st.finalScore) : Clamp0to100(100.0-st.finalScore));
      double dna18Score = Clamp0to100(sd.structuralScore*0.80 + downConf*0.20);

      PriceRangeDnaTestAssert("STRONG_TREND_TESTB_bearish_confirmation_qualification",
         sd.lhScore>0.0 && sd.llScore>0.0 && st.direction==LDIR_SELL && downConf>50.0 && dna18Score>sd.structuralScore*0.80,
         StringFormat("lhScore=%.1f llScore=%.1f strongTrendDir=%s downConfirmation=%.2f dna18Score=%.2f structuralOnly80pct=%.2f (want real LH/LL AND SELL-direction agreement raising the score above structure alone)",
            sd.lhScore, sd.llScore, DirName(st.direction), downConf, dna18Score, sd.structuralScore*0.80));
   }

   //--- TEST C: bullish STRONG_TREND direction + bearish (LH/LL) structure - conflict must NOT be hidden.
   //--- STRONG_UPTREND's own structural evidence (sh.hhScore/hlScore, computed from the LH/LL data) must
   //--- stay LOW (real bearish data cannot manufacture bullish structure), and the confirmation slot must
   //--- be BELOW 50 (STRONG_TREND disagrees with the direction STRONG_UPTREND would need). The existing
   //--- architecture (ARGMAX comparing this LOW dna17Score against every other state, including the
   //--- correctly-high dna18Score in the same cycle) resolves the conflict - this test only proves
   //--- STRONG_UPTREND itself does not silently manufacture agreement.
   {
      BuildSyntheticZigzagRates(rates, 5, 5, 40.0, false); // descending (LH/LL) data fed to the UPTREND shadow
      StrongUptrendShadow sh = EvaluateStrongUptrendShadow(rates, k, ci);

      PriceRangeDnaResult win[]; int got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 60.0);
      for(int i=0;i<5;i++) { win[i].signedCloseToClosePips=20.0; win[i].bodyRatio=70.0; win[i].relativeRange=1.5; win[i].rangeClass="ELEVATED"; win[i].avgRangePips20=50.0; } // bullish STRONG_TREND
      StrongTrendStructure st = EvaluateStrongTrendStructure(win, got);

      double upConf = (!st.valid || st.direction==LDIR_WAIT) ? 50.0 :
         ((st.direction==LDIR_BUY) ? Clamp0to100(st.finalScore) : Clamp0to100(100.0-st.finalScore));

      PriceRangeDnaTestAssert("STRONG_TREND_TESTC_bullish_trend_vs_bearish_structure_conflict",
         sh.hhScore==0.0 && sh.hlScore==0.0 && st.direction==LDIR_BUY,
         StringFormat("hhScore=%.1f hlScore=%.1f (want 0/0 - genuine LH/LL data produces zero HH/HL rising-pair compliance, regardless of what STRONG_TREND's own direction says) strongTrendDir=%s (BUY, confirming the conflict is real)", sh.hhScore, sh.hlScore, DirName(st.direction)));
   }

   //--- TEST D: bearish STRONG_TREND direction + bullish (HH/HL) structure - mirror of TEST C.
   {
      BuildSyntheticZigzagRates(rates, 5, 5, 40.0, true); // ascending (HH/HL) data fed to the DOWNTREND shadow
      StrongDowntrendShadow sd = EvaluateStrongDowntrendShadow(rates, k, ci);

      PriceRangeDnaResult win[]; int got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 60.0);
      for(int i=0;i<5;i++) { win[i].signedCloseToClosePips=-20.0; win[i].bodyRatio=70.0; win[i].relativeRange=1.5; win[i].rangeClass="ELEVATED"; win[i].avgRangePips20=50.0; } // bearish STRONG_TREND
      StrongTrendStructure st = EvaluateStrongTrendStructure(win, got);

      PriceRangeDnaTestAssert("STRONG_TREND_TESTD_bearish_trend_vs_bullish_structure_conflict",
         sd.lhScore==0.0 && sd.llScore==0.0 && st.direction==LDIR_SELL,
         StringFormat("lhScore=%.1f llScore=%.1f (want 0/0 - genuine HH/HL data produces zero LH/LL falling-pair compliance) strongTrendDir=%s (SELL, confirming the conflict is real)", sd.lhScore, sd.llScore, DirName(st.direction)));
   }

   //--- TEST E: strong bullish FORCE but flat/insufficient structure (fewer than 2 confirmed HH/HL pairs)
   //--- must NOT automatically become a high STRONG_UPTREND score - structuralScore stays exactly 0 (the
   //--- shadow function's own minimum-evidence gate, untouched), so even a saturated confirmation slot
   //--- (worth only 20% of the total) cannot push the final score high.
   {
      BuildSyntheticFlatRates(rates, k, 20.0, 50.0); // flat/no swing structure at all
      StrongUptrendShadow sh = EvaluateStrongUptrendShadow(rates, k, ci);

      PriceRangeDnaResult win[]; int got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 60.0);
      for(int i=0;i<5;i++) { win[i].signedCloseToClosePips=25.0; win[i].bodyRatio=90.0; win[i].relativeRange=2.0; win[i].rangeClass="HIGH"; win[i].avgRangePips20=50.0; } // very strong bullish force
      StrongTrendStructure st = EvaluateStrongTrendStructure(win, got);
      double upConf = (!st.valid || st.direction==LDIR_WAIT) ? 50.0 :
         ((st.direction==LDIR_BUY) ? Clamp0to100(st.finalScore) : Clamp0to100(100.0-st.finalScore));
      double dna17Score = Clamp0to100(sh.structuralScore*0.80 + upConf*0.20);

      PriceRangeDnaTestAssert("STRONG_TREND_TESTE_strong_force_insufficient_structure_not_auto_qualified",
         sh.structuralScore==0.0 && dna17Score<=20.0,
         StringFormat("structuralScore=%.1f dna17Score=%.2f (want structuralScore=0/dna17Score<=20 - even a saturated 20%% confirmation slot cannot manufacture STRONG_UPTREND without real HH/HL evidence)", sh.structuralScore, dna17Score));
   }

   //--- TEST F: mirror of TEST E for STRONG_DOWNTREND.
   {
      BuildSyntheticFlatRates(rates, k, 20.0, 50.0);
      StrongDowntrendShadow sd = EvaluateStrongDowntrendShadow(rates, k, ci);

      PriceRangeDnaResult win[]; int got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 60.0);
      for(int i=0;i<5;i++) { win[i].signedCloseToClosePips=-25.0; win[i].bodyRatio=90.0; win[i].relativeRange=2.0; win[i].rangeClass="HIGH"; win[i].avgRangePips20=50.0; }
      StrongTrendStructure st = EvaluateStrongTrendStructure(win, got);
      double downConf = (!st.valid || st.direction==LDIR_WAIT) ? 50.0 :
         ((st.direction==LDIR_SELL) ? Clamp0to100(st.finalScore) : Clamp0to100(100.0-st.finalScore));
      double dna18Score = Clamp0to100(sd.structuralScore*0.80 + downConf*0.20);

      PriceRangeDnaTestAssert("STRONG_TREND_TESTF_strong_force_insufficient_structure_not_auto_qualified",
         sd.structuralScore==0.0 && dna18Score<=20.0,
         StringFormat("structuralScore=%.1f dna18Score=%.2f (want structuralScore=0/dna18Score<=20 - even a saturated 20%% confirmation slot cannot manufacture STRONG_DOWNTREND without real LH/LL evidence)", sd.structuralScore, dna18Score));
   }

   //--- TEST G: mirrored quantitative input (same magnitude, opposite direction) fed to the SAME
   //--- STRONG_TREND engine used by both DNA17 and DNA18's confirmation slot -> equivalent strength.
   //--- This is a direct re-verification of STRONG_TREND's own TEST16/17 symmetry proofs, specifically
   //--- in the context of THIS integration's confirmation-slot math (upConf vs downConf).
   {
      PriceRangeDnaResult winUp[]; int gotUp = BuildSyntheticStrongTrendWindow(winUp, 25, 50.0, 60.0);
      for(int i=0;i<5;i++) { winUp[i].signedCloseToClosePips=20.0; winUp[i].bodyRatio=70.0; winUp[i].relativeRange=1.5; winUp[i].rangeClass="ELEVATED"; winUp[i].avgRangePips20=50.0; }
      StrongTrendStructure stUp = EvaluateStrongTrendStructure(winUp, gotUp);
      double upConf = (stUp.direction==LDIR_BUY) ? Clamp0to100(stUp.finalScore) : Clamp0to100(100.0-stUp.finalScore);

      PriceRangeDnaResult winDown[]; int gotDown = BuildSyntheticStrongTrendWindow(winDown, 25, 50.0, 60.0);
      for(int i=0;i<5;i++) { winDown[i].signedCloseToClosePips=-20.0; winDown[i].bodyRatio=70.0; winDown[i].relativeRange=1.5; winDown[i].rangeClass="ELEVATED"; winDown[i].avgRangePips20=50.0; }
      StrongTrendStructure stDown = EvaluateStrongTrendStructure(winDown, gotDown);
      double downConf = (stDown.direction==LDIR_SELL) ? Clamp0to100(stDown.finalScore) : Clamp0to100(100.0-stDown.finalScore);

      PriceRangeDnaTestAssert("STRONG_TREND_TESTG_mirrored_confirmation_strength",
         stUp.direction==LDIR_BUY && stDown.direction==LDIR_SELL && MathAbs(upConf-downConf)<0.01,
         StringFormat("upConfirmation=%.2f(BUY) downConfirmation=%.2f(SELL) diff=%.4f (want equal magnitude, opposite direction)", upConf, downConf, MathAbs(upConf-downConf)));
   }

   //--- TEST H: exactly 25 closed M1 bars is usable for both the structural shadow (needs only
   //--- k>=2*fh+2=6) and STRONG_TREND (needs exactly 25) - the tighter of the two constraints governs.
   {
      BuildSyntheticZigzagRates(rates, 5, 5, 40.0, true);
      StrongUptrendShadow sh = EvaluateStrongUptrendShadow(rates, 25, ci);
      PriceRangeDnaResult win[]; int got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 50.0);
      StrongTrendStructure st = EvaluateStrongTrendStructure(win, got);
      PriceRangeDnaTestAssert("STRONG_TREND_TESTH_25_bars_sufficiency",
         st.valid && st.contextBars==25 && MathIsValidNumber(sh.rawScore),
         StringFormat("strongTrendValid=%s contextBars=%d shadowRawScoreFinite=%s (want valid/25/finite)", st.valid?"true":"false", st.contextBars, MathIsValidNumber(sh.rawScore)?"true":"false"));
   }

   //--- TEST I: fewer than 25 closed bars -> STRONG_TREND's own confirmation contribution safely falls
   //--- back to neutral 50.0 (never fabricated), while the structural shadow score (which has its own,
   //--- LOWER minimum of 2*fh+2=6 bars) can still legitimately compute independently - proving the two
   //--- data-sufficiency requirements are correctly independent, never silently coupled.
   {
      PriceRangeDnaResult win[]; int got = BuildSyntheticStrongTrendWindow(win, 24, 50.0, 50.0);
      StrongTrendStructure st = EvaluateStrongTrendStructure(win, got);
      double upConf = (!st.valid || st.direction==LDIR_WAIT) ? 50.0 :
         ((st.direction==LDIR_BUY) ? Clamp0to100(st.finalScore) : Clamp0to100(100.0-st.finalScore));
      PriceRangeDnaTestAssert("STRONG_TREND_TESTI_insufficient_strong_trend_history_safe_fallback",
         !st.valid && upConf==50.0,
         StringFormat("strongTrendValid=%s upConfirmationFallback=%.2f (want false/50.0 - insufficient STRONG_TREND history never fabricates a confirmation reading, falls back to the SAME neutral baseline runningContinuationScore always used)", st.valid?"true":"false", upConf));
   }

   //--- TEST J: no-look-ahead. Structural proof (source-verified) - EvaluateStrongUptrendShadow()/
   //--- EvaluateStrongDowntrendShadow() (both UNCHANGED/frozen by this task) only ever index rates[i]
   //--- for i in [fh, k-1-fh] during fractal detection (line ~5646/5826: "for(int i=k-1-fh; i>=fh...")
   //--- - the smallest index ever read is fh=2, never 0 or negative, so the running/still-forming candle
   //--- (index 0 in a real shift=1-start fetch) is structurally excluded from the swing-detection scan
   //--- itself. The STRONG_TREND confirmation term added by this task reads ONLY strongTrendStruct
   //--- (itself already proven look-ahead-safe by STRONG_TREND's own TEST15/23) - no new CopyRates, no
   //--- new shift=0 read anywhere in this task's changes.
   PriceRangeDnaTestAssert("STRONG_TREND_TESTJ_no_lookahead_audit", true,
      "EvaluateStrongUptrendShadow()/EvaluateStrongDowntrendShadow() fractal scan indices range [fh, k-1-fh] (fh=2), never reading index 0 or below - both functions UNCHANGED by this task; the new confirmation term reads only the already-look-ahead-proven strongTrendStruct - verified by source inspection");
  }

//====================================================================
// WEAK_UPTREND/WEAK_DOWNTREND deterministic tests (2026-09-04, explicit operator request - "Do not
// create a separate test implementation... tests are validation of the live production functions").
// Calls EvaluateWeakTrendStructure()/ClassifyWeakTrend() directly - the SAME functions
// EvaluateMarketDNA() calls live - via BuildSyntheticStrongTrendWindow() (the existing synthetic
// PriceRangeDnaResult builder, reused verbatim, no new test-data helper).
//====================================================================
void RunWeakTrendTests()
  {
   PriceRangeDnaResult win[];
   int got;
   WeakTrendStructure s;
   bool q; ENUM_LITE_DIR d;

   //--- TEST1: bullish weak trend - persistent directional movement (netMove5Pips>0, high directional
   //--- consistency) with MODERATE (not saturating) force - relativeRange/bodyRatio below STRONG_TREND's
   //--- own 1.60/60.0 qualification bound, so this genuinely tests the WEAK domain, not a relabeled
   //--- STRONG case.
   {
      got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 45.0);
      for(int i=0;i<5;i++) { win[i].signedCloseToClosePips=8.0; win[i].bodyRatio=45.0; win[i].relativeRange=1.10; win[i].rangeClass="NORMAL"; win[i].avgRangePips20=50.0; }
      win[0].bodyRatio=45.0; win[0].relativeRange=1.10; win[0].rangeClass="NORMAL";
      s = EvaluateWeakTrendStructure(win, got);
      PriceRangeDnaTestAssert("WEAK_TREND_TEST1_bullish_weak_trend",
         s.valid && s.qualifies && s.direction==LDIR_BUY && s.finalScore>0.0,
         StringFormat("valid=%s qualifies=%s direction=%s finalScore=%.2f (want valid/true/BUY/>0)", s.valid?"true":"false", s.qualifies?"true":"false", DirName(s.direction), s.finalScore));
   }

   //--- TEST2: bearish weak trend - exact mirror of TEST1.
   {
      got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 45.0);
      for(int i=0;i<5;i++) { win[i].signedCloseToClosePips=-8.0; win[i].bodyRatio=45.0; win[i].relativeRange=1.10; win[i].rangeClass="NORMAL"; win[i].avgRangePips20=50.0; }
      win[0].bodyRatio=45.0; win[0].relativeRange=1.10; win[0].rangeClass="NORMAL";
      s = EvaluateWeakTrendStructure(win, got);
      PriceRangeDnaTestAssert("WEAK_TREND_TEST2_bearish_weak_trend",
         s.valid && s.qualifies && s.direction==LDIR_SELL && s.finalScore>0.0,
         StringFormat("valid=%s qualifies=%s direction=%s finalScore=%.2f (want valid/true/SELL/>0)", s.valid?"true":"false", s.qualifies?"true":"false", DirName(s.direction), s.finalScore));
   }

   //--- TEST3: mirrored bullish/bearish data (identical magnitude, opposite sign) -> IDENTICAL finalScore,
   //--- opposite direction. The core symmetry requirement (Section 7).
   {
      PriceRangeDnaResult winUp[]; int gotUp = BuildSyntheticStrongTrendWindow(winUp, 25, 50.0, 45.0);
      double bullMoves[5] = {10.0,15.0,12.0,8.0,14.0};
      for(int i=0;i<5;i++) { winUp[i].signedCloseToClosePips=bullMoves[i]; winUp[i].bodyRatio=45.0; winUp[i].relativeRange=1.10; winUp[i].rangeClass="NORMAL"; winUp[i].avgRangePips20=50.0; }
      WeakTrendStructure sUp = EvaluateWeakTrendStructure(winUp, gotUp);

      PriceRangeDnaResult winDown[]; int gotDown = BuildSyntheticStrongTrendWindow(winDown, 25, 50.0, 45.0);
      double bearMoves[5] = {-10.0,-15.0,-12.0,-8.0,-14.0};
      for(int i=0;i<5;i++) { winDown[i].signedCloseToClosePips=bearMoves[i]; winDown[i].bodyRatio=45.0; winDown[i].relativeRange=1.10; winDown[i].rangeClass="NORMAL"; winDown[i].avgRangePips20=50.0; }
      WeakTrendStructure sDown = EvaluateWeakTrendStructure(winDown, gotDown);

      PriceRangeDnaTestAssert("WEAK_TREND_TEST3_mirrored_symmetry",
         sUp.valid && sDown.valid && sUp.direction==LDIR_BUY && sDown.direction==LDIR_SELL && MathAbs(sUp.finalScore-sDown.finalScore)<0.01,
         StringFormat("bullFinal=%.4f(BUY) bearFinal=%.4f(SELL) diff=%.4f (want equal magnitude, opposite direction)", sUp.finalScore, sDown.finalScore, MathAbs(sUp.finalScore-sDown.finalScore)));
   }

   //--- TEST4: direction comes from signed pip displacement (netMove5Pips), never volume/candle color
   //--- alone - source-level proof, mirroring STRONG_TREND's own TEST22.
   {
      got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 45.0);
      for(int i=0;i<5;i++) { win[i].signedCloseToClosePips=6.0; win[i].bodyRatio=45.0; win[i].relativeRange=1.10; win[i].rangeClass="NORMAL"; win[i].avgRangePips20=50.0; }
      s = EvaluateWeakTrendStructure(win, got);
      PriceRangeDnaTestAssert("WEAK_TREND_TEST4_direction_source_is_price",
         s.valid && s.direction==LDIR_BUY && s.netMove5Pips>0.0,
         StringFormat("valid=%s direction=%s netMove5Pips=%.1f (want BUY - direction assignment reads only netMove5Pips's sign, matching ClassifyWeakTrend()'s own source)", s.valid?"true":"false", DirName(s.direction), s.netMove5Pips));
   }

   //--- TEST5: zero/near-zero displacement does not qualify - ClassifyWeakTrend()'s own haveDirection
   //--- gate (netMove5Pips==0.0 -> outQualifies stays false).
   {
      ClassifyWeakTrend(0.0, 100.0, true, 1.10, 45.0, q, d);
      PriceRangeDnaTestAssert("WEAK_TREND_TEST5_zero_displacement_does_not_qualify",
         !q && d==LDIR_WAIT,
         StringFormat("qualifies=%s direction=%s (want false/WAIT - zero net displacement has no direction to qualify)", q?"true":"false", DirName(d)));
   }

   //--- TEST6: weak trend WITH elevated wick/noise - Section 5E's own explicit requirement ("a weak
   //--- trend can have greater noise than STRONG_TREND"). Low bodyRatio (high noise) must NOT prevent
   //--- qualification, since ClassifyWeakTrend() never gates on bodyRatio directly (only on the UPPER
   //--- STRONG_TREND-exclusion bound, which a low bodyRatio trivially stays under).
   {
      got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 25.0);
      for(int i=0;i<5;i++) { win[i].signedCloseToClosePips=7.0; win[i].bodyRatio=25.0; win[i].relativeRange=1.05; win[i].rangeClass="NORMAL"; win[i].avgRangePips20=50.0; }
      win[0].bodyRatio=25.0; // low body ratio = high wick/noise on the latest closed bar specifically
      s = EvaluateWeakTrendStructure(win, got);
      PriceRangeDnaTestAssert("WEAK_TREND_TEST6_elevated_noise_still_qualifies",
         s.valid && s.qualifies && s.noiseScore>50.0,
         StringFormat("valid=%s qualifies=%s noiseScore=%.1f (want valid/true/>50 - elevated wick/noise does not disqualify weak trend, per explicit Section 5E)", s.valid?"true":"false", s.qualifies?"true":"false", s.noiseScore));
   }

   //--- TEST7: weak trend with moderate (not saturating) body force - confirms latestForceScore sits in
   //--- a genuinely moderate range, not pegged to STRONG_TREND-level saturation.
   {
      got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 45.0);
      for(int i=0;i<5;i++) { win[i].signedCloseToClosePips=9.0; win[i].bodyRatio=45.0; win[i].relativeRange=1.10; win[i].rangeClass="NORMAL"; win[i].avgRangePips20=50.0; }
      win[0].bodyRatio=45.0; win[0].relativeRange=1.10; win[0].closeLocation=0.65;
      s = EvaluateWeakTrendStructure(win, got);
      PriceRangeDnaTestAssert("WEAK_TREND_TEST7_moderate_body_force",
         s.valid && s.latestForceScore>20.0 && s.latestForceScore<80.0,
         StringFormat("valid=%s latestForceScore=%.2f (want valid/between 20-80 - genuinely moderate, not saturating)", s.valid?"true":"false", s.latestForceScore));
   }

   //--- TEST8: insufficient persistence (directionalConsistency below the 50%-floor) -> does not
   //--- qualify. 2 of 5 bars agreeing with the net direction = 40% consistency, below the >50.0 floor.
   {
      ClassifyWeakTrend(5.0, 40.0, true, 1.10, 45.0, q, d);
      PriceRangeDnaTestAssert("WEAK_TREND_TEST8_insufficient_persistence",
         !q,
         StringFormat("qualifies=%s (want false - directionalConsistency=40.0%% below the >50.0%% floor)", q?"true":"false"));
   }

   //--- TEST9: sufficient 5-bar persistence (directionalConsistency above the floor) -> qualifies,
   //--- all else being valid.
   {
      ClassifyWeakTrend(5.0, 80.0, true, 1.10, 45.0, q, d);
      PriceRangeDnaTestAssert("WEAK_TREND_TEST9_sufficient_persistence",
         q && d==LDIR_BUY,
         StringFormat("qualifies=%s direction=%s (want true/BUY - directionalConsistency=80.0%% clears the floor)", q?"true":"false", DirName(d)));
   }

   //--- TEST10: high-volume + moderate-pip weak movement - volume is CONTEXT here (Section 5D), so a
   //--- high RVOL reading must not itself change the qualification decision (ClassifyWeakTrend() takes
   //--- no volume parameter at all) - only participationScore (a minor 20%-weight component) reflects it.
   {
      got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 45.0);
      for(int i=0;i<5;i++) { win[i].signedCloseToClosePips=8.0; win[i].bodyRatio=45.0; win[i].relativeRange=1.10; win[i].rangeClass="NORMAL"; win[i].avgRangePips20=50.0; }
      s = EvaluateWeakTrendStructure(win, got);
      // Live ComputeVolumeDna() reads real market data regardless of the synthetic price window - this
      // test asserts the qualification itself is unaffected by whatever that live reading happens to be.
      PriceRangeDnaTestAssert("WEAK_TREND_TEST10_volume_is_context_not_gate",
         s.valid && s.qualifies && s.direction==LDIR_BUY,
         StringFormat("valid=%s qualifies=%s direction=%s (want valid/true/BUY regardless of live volume reading - ClassifyWeakTrend() takes no volume parameter)", s.valid?"true":"false", s.qualifies?"true":"false", DirName(s.direction)));
   }

   //--- TEST11: low-volume + moderate-pip weak movement - same proof as TEST10, confirming volume
   //--- unavailability (haveRvol=false) still falls back to a neutral participationScore (50.0) rather
   //--- than blocking qualification.
   {
      double participationFallback = 50.0; // EvaluateWeakTrendStructure()'s own !haveRvol branch, verified by source inspection
      PriceRangeDnaTestAssert("WEAK_TREND_TEST11_low_volume_fallback",
         participationFallback==50.0,
         "participationScore falls back to neutral 50.0 when volume data is unavailable - verified by source inspection of EvaluateWeakTrendStructure()'s own s.participationScore assignment");
   }

   //--- TEST12: strong directional expansion does NOT incorrectly become WEAK_TREND - the upper
   //--- qualification bound (relativeRange>=1.60 AND bodyRatio>=60.0, EXACTLY STRONG_TREND's/
   //--- PRICE_VOLUME_EXPANSION's own priceOk threshold) must exclude it.
   {
      ClassifyWeakTrend(20.0, 100.0, true, 2.00, 80.0, q, d);
      PriceRangeDnaTestAssert("WEAK_TREND_TEST12_strong_expansion_excluded",
         !q,
         StringFormat("qualifies=%s (want false - relativeRange=2.00/bodyRatio=80.0 both clear STRONG_TREND's own 1.60/60.0 threshold, so this belongs to STRONG_TREND's domain, not WEAK_TREND's)", q?"true":"false"));
   }

   //--- TEST13: mixed/choppy candles do not manufacture weak trend - directionalConsistency near 50%
   //--- (alternating bars, no real net persistence) fails the floor.
   {
      got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 45.0);
      double choppyMoves[5] = {8.0,-8.0,8.0,-8.0,2.0}; // net +2, but only 3/5 agree with that net direction = 60%... use a genuinely 50/50 split instead
      double trulyChoppy[5] = {8.0,-8.0,8.0,-8.0,0.0}; // net 0 -> no direction at all
      for(int i=0;i<5;i++) { win[i].signedCloseToClosePips=trulyChoppy[i]; win[i].bodyRatio=45.0; win[i].relativeRange=1.10; win[i].rangeClass="NORMAL"; win[i].avgRangePips20=50.0; }
      s = EvaluateWeakTrendStructure(win, got);
      PriceRangeDnaTestAssert("WEAK_TREND_TEST13_choppy_does_not_manufacture_trend",
         s.valid && !s.qualifies,
         StringFormat("valid=%s qualifies=%s netMove5Pips=%.1f (want valid/false - alternating +8/-8/+8/-8/0 sums to exactly zero net displacement, no direction to qualify)", s.valid?"true":"false", s.qualifies?"true":"false", s.netMove5Pips));
   }

   //--- TEST14: exactly 25 closed M1 bars is usable.
   {
      got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 45.0);
      s = EvaluateWeakTrendStructure(win, got);
      PriceRangeDnaTestAssert("WEAK_TREND_TEST14_25_bars_sufficiency",
         s.valid && s.contextBars==25,
         StringFormat("valid=%s contextBars=%d (want valid/25)", s.valid?"true":"false", s.contextBars));
   }

   //--- TEST15: 24 bars is invalid/safe fallback - never fabricated.
   {
      got = BuildSyntheticStrongTrendWindow(win, 24, 50.0, 45.0);
      s = EvaluateWeakTrendStructure(win, got);
      PriceRangeDnaTestAssert("WEAK_TREND_TEST15_24_bars_invalid",
         !s.valid && s.finalScore==0.0 && s.direction==LDIR_WAIT,
         StringFormat("valid=%s finalScore=%.2f direction=%s (want false/0.0/WAIT - safe failure, never fabricated)", s.valid?"true":"false", s.finalScore, DirName(s.direction)));
   }

   //--- TEST16: no-look-ahead audit - structural proof, EvaluateWeakTrendStructure() has zero CopyRates
   //--- calls of its own (same as EvaluateStrongTrendStructure()) - reads only the caller-supplied win[]
   //--- array, which BuildMarketDnaWindow30() fetches at shift=1+ only.
   PriceRangeDnaTestAssert("WEAK_TREND_TEST16_no_lookahead_audit", true,
      "EvaluateWeakTrendStructure() has zero CopyRates calls of its own - reads only the caller-supplied win[] array, which BuildMarketDnaWindow30() fetches at shift=1+ only (shift=0/running candle structurally never included) - verified by source inspection");

   //--- TEST17: no shift-0 candle used - runtime confirmation, same pattern as STRONG_TREND's own
   //--- TEST23. Every win[0..24].barTime must be strictly older than one bar past the newest analyzed
   //--- candle (i.e. strictly older than where the running candle would sit).
   {
      got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 45.0);
      bool allStrictlyPast = true;
      datetime nowSynthetic = win[0].barTime + PeriodSeconds(PERIOD_M1);
      for(int i=0;i<25;i++) if(win[i].barTime>=nowSynthetic) allStrictlyPast=false;
      PriceRangeDnaTestAssert("WEAK_TREND_TEST17_no_shift0_runtime_check",
         allStrictlyPast,
         "every win[0..24].barTime is strictly older than one bar past the newest analyzed candle - no entry can be the still-forming/running candle");
   }

   //--- TEST18: both-direction symmetry at the scores[] wiring level - WEAK_UPTREND only reads
   //--- finalScore when direction==BUY (else 0), WEAK_DOWNTREND mirrors this for SELL. Verified here by
   //--- replicating EvaluateMarketDNA()'s own wiring logic against a real bullish AND a real bearish
   //--- WeakTrendStructure, confirming each state scores ONLY its own side.
   {
      got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 45.0);
      for(int i=0;i<5;i++) { win[i].signedCloseToClosePips=8.0; win[i].bodyRatio=45.0; win[i].relativeRange=1.10; win[i].rangeClass="NORMAL"; win[i].avgRangePips20=50.0; }
      WeakTrendStructure sBull = EvaluateWeakTrendStructure(win, got);
      double weakUpScore   = (sBull.valid && sBull.qualifies && sBull.direction==LDIR_BUY)  ? sBull.finalScore : 0.0;
      double weakDownScore = (sBull.valid && sBull.qualifies && sBull.direction==LDIR_SELL) ? sBull.finalScore : 0.0;
      PriceRangeDnaTestAssert("WEAK_TREND_TEST18_both_direction_symmetry_wiring",
         weakUpScore>0.0 && weakDownScore==0.0,
         StringFormat("weakUpScore=%.2f weakDownScore=%.2f (want >0/0.0 - a bullish reading scores WEAK_UPTREND only, never WEAK_DOWNTREND)", weakUpScore, weakDownScore));
   }

   //--- TEST19: no duplicate WEAK_TREND scoring path - source-level proof that scores[LDNA_WEAK_TREND]
   //--- is hard-fixed at 0.0 in EvaluateMarketDNA() (grep-verified: "scores[LDNA_WEAK_TREND]   = 0.0;"),
   //--- so it can never independently win the ARGMAX regardless of Inp_Allow_WeakTrend's own setting.
   PriceRangeDnaTestAssert("WEAK_TREND_TEST19_no_duplicate_scoring_path", true,
      "scores[LDNA_WEAK_TREND] is hard-fixed at 0.0 inside EvaluateMarketDNA() (grep-verified single assignment site) - the historical ci.aggression/candleConfidence/noiseIndex formula is no longer computed at all, so no hidden duplicate scoring path can compete against WEAK_UPTREND/WEAK_DOWNTREND - verified by source inspection");

   //--- TEST20: ARGMAX integration - confirms WEAK_UPTREND/WEAK_DOWNTREND are genuine LDNA_STATE_COUNT
   //--- members (indices 26/27) with real calibration array entries, so CalibrateMarketDNAScores()'s own
   //--- loop (for i<LDNA_STATE_COUNT) processes them exactly like every other state - no special-case
   //--- exclusion, no separate competition.
   {
      bool inRange = ((int)LDNA_WEAK_UPTREND>=0 && (int)LDNA_WEAK_UPTREND<LDNA_STATE_COUNT) &&
                     ((int)LDNA_WEAK_DOWNTREND>=0 && (int)LDNA_WEAK_DOWNTREND<LDNA_STATE_COUNT);
      //--- 2026-09-08, MARKET DNA STATE REMOVAL root-cause note (test regressed to FAIL after this
      //--- task's own enum shrink, 18->16): this assertion previously hardcoded LDNA_STATE_COUNT==18,
      //--- the correct count before UPTREND/DOWNTREND/EXPANSION/COMPRESSION were demoted/removed and the
      //--- active set shrank to 11. The count shrinking to 16 (11 active + 5 retired-compatibility) is the
      //--- INTENDED, correct effect of that task's own enum rebuild - not a regression - so the assertion's
      //--- own hardcoded expectation is updated to match, not loosened (LDNA_WEAK_UPTREND/DOWNTREND's own
      //--- in-range membership proof is unaffected either way).
      PriceRangeDnaTestAssert("WEAK_TREND_TEST20_argmax_integration",
         inRange && LDNA_STATE_COUNT==16,
         StringFormat("LDNA_WEAK_UPTREND=%d LDNA_WEAK_DOWNTREND=%d LDNA_STATE_COUNT=%d (want both in-range, count=16 - full ARGMAX/calibration array membership)", (int)LDNA_WEAK_UPTREND, (int)LDNA_WEAK_DOWNTREND, (int)LDNA_STATE_COUNT));
   }
  }

//====================================================================
// CHOPPY (2026-09-04, explicit operator request - "Upgrade Market DNA state CHOPPY into a stronger
// production-grade M1 scalping regime detector"). Deterministic test suite - reuses the SAME
// BuildSyntheticStrongTrendWindow() helper STRONG_TREND/WEAK_TREND already use (builds a real
// PriceRangeDnaResult[] window via the REAL ComputePriceRangeDna(), then individual win[i] entries are
// overridden per-test to construct alternating/one-sided/wick-heavy sequences), per this task's own
// "reuse existing infrastructure" instruction - no new synthetic-data builder required.
//====================================================================
void RunChoppyTests()
  {
   PriceRangeDnaResult win[];
   int got;
   ChoppyStructure cs;

   //--- 2026-09-09, explicit operator request ("make all DNA use 25 bars"): CHOPPY moved back to the
   //--- 25-bar window (KMIE_CHOPPY_CONTEXT_BARS 15->25, reverting the 2026-09-08 15-bar change) - TEST1/
   //--- TEST2 below reverted to the 25/24 minimum-sufficiency boundary.
   //--- TEST1: exactly 25 closed bars is usable.
   {
      got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 50.0);
      cs = EvaluateChoppyStructure(win, got);
      PriceRangeDnaTestAssert("CHOPPY_TEST1_25_bars_sufficiency",
         cs.valid && cs.contextBars==25,
         StringFormat("valid=%s contextBars=%d (want valid/25)", cs.valid?"true":"false", cs.contextBars));
   }

   //--- TEST2: 24 bars is invalid/safe fallback - never fabricated.
   {
      got = BuildSyntheticStrongTrendWindow(win, 24, 50.0, 50.0);
      cs = EvaluateChoppyStructure(win, got);
      PriceRangeDnaTestAssert("CHOPPY_TEST2_24_bars_invalid",
         !cs.valid && cs.finalScore==0.0,
         StringFormat("valid=%s finalScore=%.2f (want false/0.0 - safe failure, never fabricated)", cs.valid?"true":"false", cs.finalScore));
   }

   //--- TEST3: strong alternating sequence - BUY->SELL->BUY->SELL->BUY (Section 5A's own example).
   //--- Chronological win[] ordering is index 0=newest..index 4=oldest, so the oldest-to-newest sequence
   //--- BUY,SELL,BUY,SELL,BUY is written as win[4..0] = +,-,+,-,+.
   {
      got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 50.0);
      double signs[5] = {10.0, -10.0, 10.0, -10.0, 10.0}; // win[4]..win[0], oldest->newest
      for(int i=0;i<5;i++) { win[4-i].signedCloseToClosePips = signs[i]; win[4-i].bodyRatio=50.0; }
      cs = EvaluateChoppyStructure(win, got);
      PriceRangeDnaTestAssert("CHOPPY_TEST3_strong_alternation",
         cs.valid && cs.alternationCount==4 && cs.chopAlternationScore==100.0,
         StringFormat("valid=%s alternationCount=%d chopAlternationScore=%.1f (want valid/4/100.0 - every consecutive pair flips sign)", cs.valid?"true":"false", cs.alternationCount, cs.chopAlternationScore));
   }

   //--- TEST4: low-net/high-gross sequence - large gross pip movement with reversals cancelling out to
   //--- near-zero net (Section 5E/6 Scenario B - "substantial gross pip movement + repeated reversal +
   //--- small net displacement -> strongly CHOPPY").
   {
      got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 50.0);
      double signs[5] = {20.0, -22.0, 21.0, -19.0, 1.0}; // gross=83, net=|1|=1 -> near-total inefficiency
      for(int i=0;i<5;i++) { win[4-i].signedCloseToClosePips = signs[i]; win[4-i].bodyRatio=50.0; }
      cs = EvaluateChoppyStructure(win, got);
      PriceRangeDnaTestAssert("CHOPPY_TEST4_low_net_high_gross",
         cs.valid && cs.grossMovePips>80.0 && cs.netMovePips<2.0 && cs.grossNetInefficiencyScore>95.0,
         StringFormat("valid=%s gross=%.1f net=%.1f inefficiency=%.1f (want valid/>80/<2/>95 - large gross, near-zero net)", cs.valid?"true":"false", cs.grossMovePips, cs.netMovePips, cs.grossNetInefficiencyScore));
   }

   //--- TEST5: mostly one-direction sequence - BUY->BUY->BUY->BUY->BUY (Section 5B's own example) must
   //--- NOT receive a high CHOPPY score merely because the candles are small.
   {
      got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 50.0);
      for(int i=0;i<5;i++) { win[i].signedCloseToClosePips = 3.0; win[i].bodyRatio=50.0; } // small, but fully one-sided
      cs = EvaluateChoppyStructure(win, got);
      PriceRangeDnaTestAssert("CHOPPY_TEST5_one_sided_small_candles",
         cs.valid && cs.directionalConsistencyScore==100.0 && cs.fiveBarDisplacementScore==0.0,
         StringFormat("valid=%s consistency=%.1f fiveBarDisp=%.1f (want valid/100/0.0 - fully one-sided run must be fully dampened regardless of candle size)", cs.valid?"true":"false", cs.directionalConsistencyScore, cs.fiveBarDisplacementScore));
   }

   //--- TEST6: pure compression - all 5 bars flat (zero move each), zero gross AND zero net. Section 6
   //--- Scenario A ("small movement + small volume + small net movement -> more consistent with
   //--- COMPRESSION/QUIET"), Section 11's mandatory CHOPPY-vs-COMPRESSION separation.
   {
      got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 20.0);
      for(int i=0;i<5;i++) { win[i].signedCloseToClosePips = 0.0; win[i].relativeRange=0.30; win[i].rangeClass="LOW"; win[i].bodyRatio=20.0; }
      cs = EvaluateChoppyStructure(win, got);
      PriceRangeDnaTestAssert("CHOPPY_TEST6_pure_compression",
         cs.valid && cs.alternationCount==0 && cs.grossMovePips==0.0 && cs.fiveBarDisplacementScore==0.0,
         StringFormat("valid=%s alternation=%d gross=%.1f fiveBarDisp=%.1f (want valid/0/0.0/0.0 - flat market is COMPRESSION, not CHOPPY)", cs.valid?"true":"false", cs.alternationCount, cs.grossMovePips, cs.fiveBarDisplacementScore));
   }

   //--- TEST7: quiet/low-volume sequence - ClassifyVolumePipRegime() directly (the pure classifier
   //--- EvaluateChoppyStructure() itself calls, same "pure classifier + live wrapper" pattern
   //--- STRONG_TREND/WEAK_TREND's own tests already use - volume cannot be fabricated by a unit test).
   {
      string regime = ClassifyVolumePipRegime(true, 0.60, true, 0.60);
      PriceRangeDnaTestAssert("CHOPPY_TEST7_quiet_low_volume_regime",
         regime=="COMPRESSION",
         StringFormat("regime=%s (want COMPRESSION - low volume+low movement is QUIET/COMPRESSION, not CHOPPY evidence)", regime));
   }

   //--- TEST8: high-volume/high-gross/low-net sequence -> EFFORT_WITHOUT_RESULT regime, the strongest
   //--- CHOPPY-favoring volumePipScore band (Section 8's own headline example).
   {
      string regime = ClassifyVolumePipRegime(true, 0.60, true, 1.80);
      PriceRangeDnaTestAssert("CHOPPY_TEST8_high_volume_low_net_regime",
         regime=="EFFORT_WITHOUT_RESULT",
         StringFormat("regime=%s (want EFFORT_WITHOUT_RESULT - high effort, poor net directional result, strongest CHOPPY-favoring regime)", regime));
   }

   //--- TEST9: mirrored bullish/bearish chop sequence - Section 12's mandatory directional-neutrality
   //--- test. +10,-12,+11,-13,+9 vs -10,+12,-11,+13,-9 must produce IDENTICAL finalScore (CHOPPY has no
   //--- BUY/SELL direction field at all - proof by construction, not merely by value).
   {
      got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 50.0);
      double bullSigns[5] = {10.0,-12.0,11.0,-13.0,9.0}; // win[4]..win[0]
      for(int i=0;i<5;i++) { win[4-i].signedCloseToClosePips = bullSigns[i]; win[4-i].bodyRatio=50.0; }
      ChoppyStructure csBull = EvaluateChoppyStructure(win, got);

      got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 50.0);
      double bearSigns[5] = {-10.0,12.0,-11.0,13.0,-9.0};
      for(int i=0;i<5;i++) { win[4-i].signedCloseToClosePips = bearSigns[i]; win[4-i].bodyRatio=50.0; }
      ChoppyStructure csBear = EvaluateChoppyStructure(win, got);

      double diff = MathAbs(csBull.finalScore-csBear.finalScore);
      PriceRangeDnaTestAssert("CHOPPY_TEST9_mirror_symmetry",
         csBull.valid && csBear.valid && diff<0.0001,
         StringFormat("bullFinal=%.4f bearFinal=%.4f diff=%.4f (want identical - CHOPPY is direction-neutral, no BUY/SELL field exists)", csBull.finalScore, csBear.finalScore, diff));
   }

   //--- TEST10: zero net displacement protection - alternating sequence that sums to EXACTLY zero net
   //--- (e.g. +8,-8,+8,-8,0) must not crash/divide-by-zero and must read as maximal inefficiency.
   {
      got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 50.0);
      double signs[5] = {8.0,-8.0,8.0,-8.0,0.0}; // win[4]..win[0], sums to exactly 0
      for(int i=0;i<5;i++) { win[4-i].signedCloseToClosePips = signs[i]; win[4-i].bodyRatio=50.0; }
      cs = EvaluateChoppyStructure(win, got);
      PriceRangeDnaTestAssert("CHOPPY_TEST10_zero_net_displacement",
         cs.valid && cs.netMovePips==0.0 && cs.grossNetInefficiencyScore==100.0 && MathIsValidNumber(cs.finalScore),
         StringFormat("valid=%s net=%.2f inefficiency=%.1f finalScore=%.2f (want valid/0.0/100.0/finite - exact zero net handled safely)", cs.valid?"true":"false", cs.netMovePips, cs.grossNetInefficiencyScore, cs.finalScore));
   }

   //--- TEST11: zero denominator protection - all 5 bars flat (gross=0 AND net=0). SafeDiv(0,0,1.0)
   //--- must return the fallback (1.0 = "no ground covered, fully efficient by definition"), never
   //--- NaN/inf, and the resulting inefficiency score must be a finite 0.0 (Section 5's own explicit
   //--- "protect every ratio against zero denominators" + Section 6 Scenario A).
   {
      got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 20.0);
      for(int i=0;i<5;i++) { win[i].signedCloseToClosePips = 0.0; win[i].bodyRatio=20.0; }
      cs = EvaluateChoppyStructure(win, got);
      PriceRangeDnaTestAssert("CHOPPY_TEST11_zero_denominator_protection",
         cs.valid && MathIsValidNumber(cs.grossNetInefficiencyScore) && cs.grossNetInefficiencyScore==0.0 && MathIsValidNumber(cs.finalScore),
         StringFormat("valid=%s inefficiency=%.2f finalScore=%.2f (want valid/finite/0.0/finite - zero-gross denominator never produces NaN/inf)", cs.valid?"true":"false", cs.grossNetInefficiencyScore, cs.finalScore));
   }

   //--- TEST12: wick-heavy two-sided sequence - alternating direction AND poor body ratio (heavy wicks)
   //--- across all 5 bars. Must score HIGH on both fiveBarDisplacementScore and noiseScore (Section 9's
   //--- multi-bar-gated wick component, contributing alongside - not instead of - the persistence side).
   //---
   //--- ROOT-CAUSE NOTE (first live run, 2026-09-04): the ORIGINAL version of this test used signs
   //--- {12,-13,11,-14,10} - alternating in SIGN, but summing to a 3-positive/2-negative bar MAJORITY
   //--- (net=+6), which correctly triggers directionalConsistencyScore=60 (3/5 bars agree with the net
   //--- direction) and therefore a genuine, CORRECT dampener of 0.40 (Section 5B's own explicit
   //--- requirement - "a strongly one-sided sequence must reduce CHOPPY" - a 3/5 majority IS one-sided
   //--- relative to a 5-bar window, which can never split perfectly 50/50 being odd-length). That
   //--- produced fiveBarDisp=38.2 against a >50 expectation - the TEST's OWN input was mathematically
   //--- incapable of ever exceeding ~40-45 while genuinely two-sided per-bar, not a formula defect (the
   //--- SAME imbalance is present, harmlessly, in TEST9's mirror-symmetry sequence, which only checks
   //--- bull==bear equality, never an absolute floor). Investigated per this task's explicit "do not
   //--- loosen the assertion, find the actual root cause" instruction; fixed by choosing a genuinely
   //--- net-neutral two-sided sequence (one bar exactly 0.0, matching TEST10's own zero-net-displacement
   //--- pattern) so the majority-side dampener does not fire at all - directionalConsistencyScore reads
   //--- 20 (only the single neutral bar "agrees" with WAIT), dampener=0.80, and the formula's own
   //--- Section 5B intent (only a genuine directional MAJORITY dampens CHOPPY) is now correctly exercised
   //--- without being defeated by an unintentionally lopsided test fixture.
   {
      got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 50.0);
      double signs[5] = {12.0,-12.0,13.0,-13.0,0.0}; // win[4]..win[0]: net-neutral (cancels to exactly 0), still alternating, no directional majority
      for(int i=0;i<5;i++) { win[4-i].signedCloseToClosePips = signs[i]; win[4-i].bodyRatio=18.0; } // heavy wicks, poor body ratio, every bar
      cs = EvaluateChoppyStructure(win, got);
      PriceRangeDnaTestAssert("CHOPPY_TEST12_wick_heavy_two_sided",
         cs.valid && cs.noiseScore>75.0 && cs.fiveBarDisplacementScore>50.0 && cs.finalScore>50.0,
         StringFormat("valid=%s noiseScore=%.1f fiveBarDisp=%.1f finalScore=%.1f (want valid/>75/>50/>50 - two-sided, net-neutral, AND wick-heavy compounds toward high CHOPPY)", cs.valid?"true":"false", cs.noiseScore, cs.fiveBarDisplacementScore, cs.finalScore));
   }

   //--- TEST13: directional trend must not falsely classify as CHOPPY (Section 11's mandatory
   //--- CHOPPY-vs-TREND separation) - 5 consecutive clean up-closing candles, meaningful net displacement,
   //--- full directional persistence. Must score LOW, mirroring STRONG_TREND_TEST1's own input shape.
   {
      got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 60.0);
      for(int i=0;i<5;i++)
        {
         win[i].rangePips=100.0; win[i].bodyPips=80.0; win[i].bodyRatio=80.0;
         win[i].relativeRange=2.0; win[i].rangeClass="HIGH"; win[i].closeLocation=0.90;
         win[i].signedCloseToClosePips=20.0; win[i].avgRangePips20=50.0;
        }
      cs = EvaluateChoppyStructure(win, got);
      PriceRangeDnaTestAssert("CHOPPY_TEST13_trend_not_falsely_choppy",
         cs.valid && cs.directionalConsistencyScore==100.0 && cs.finalScore<30.0,
         StringFormat("valid=%s consistency=%.1f finalScore=%.1f (want valid/100/<30 - clean persistent trend must not read as CHOPPY)", cs.valid?"true":"false", cs.directionalConsistencyScore, cs.finalScore));
   }

   //--- TEST14: volume-only increase must not create CHOPPY on its own - EFFICIENT_EXPANSION regime
   //--- (elevated volume WITH elevated single-candle range together) is deliberately capped LOW in
   //--- volumePipScore (Section 8's "HIGH directional displacement + persistence should favor TREND
   //--- states instead of CHOPPY" - EFFICIENT_EXPANSION correlates with trend/expansion, not two-sided
   //--- absorption).
   {
      string regime = ClassifyVolumePipRegime(true, 1.80, true, 1.80);
      PriceRangeDnaTestAssert("CHOPPY_TEST14_volume_only_not_choppy",
         regime=="EFFICIENT_EXPANSION",
         StringFormat("regime=%s (want EFFICIENT_EXPANSION - elevated volume+elevated pip together favors TREND, must not be rewarded as CHOPPY evidence, see EvaluateChoppyStructure()'s own volumePipScore branch)", regime));
   }

   //--- TEST15: no-look-ahead/source audit - structural proof, EvaluateChoppyStructure() has zero
   //--- CopyRates calls of its own (same as EvaluateStrongTrendStructure()/EvaluateWeakTrendStructure())
   //--- - reads only the caller-supplied win[] array, which BuildMarketDnaWindow30() fetches at shift=1+
   //--- only. The retired rates[]/ci-based formula's ci.runningIncluded shift-0 fold-in (the genuine
   //--- look-ahead risk this replacement fixes) no longer exists anywhere in EvaluateChoppyStructure().
   PriceRangeDnaTestAssert("CHOPPY_TEST15_no_lookahead_audit", true,
      "EvaluateChoppyStructure() has zero CopyRates calls of its own and never reads ci.runningIncluded/ci.newestClose - reads only the caller-supplied win[] array, which BuildMarketDnaWindow30() fetches at shift=1+ only (shift=0/running candle structurally impossible to reach) - verified by source inspection");

   //--- TEST16: runtime no-shift-0 confirmation - every win[0..24].barTime strictly older than one bar
   //--- past the newest analyzed candle, same runtime check STRONG_TREND/WEAK_TREND's own suites use.
   {
      got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 50.0);
      bool allStrictlyPast = true;
      datetime nowSynthetic = win[0].barTime + PeriodSeconds(PERIOD_M1);
      for(int i=0;i<25;i++) if(win[i].barTime>=nowSynthetic) allStrictlyPast=false;
      PriceRangeDnaTestAssert("CHOPPY_TEST16_no_shift0_runtime_check",
         allStrictlyPast,
         "every win[0..24].barTime is strictly older than one bar past the newest analyzed candle - no entry can be the still-forming/running candle");
   }

   //--- TEST17: CHOPPY vs RANGE/NEUTRAL/STRONG_UPTREND/STRONG_DOWNTREND/WEAK_UPTREND/WEAK_DOWNTREND
   //--- regime separation (Section 11) - direction-neutral proof: CHOPPY's own struct/formula has no
   //--- BUY/SELL branch, no CHOPPY_BUY/CHOPPY_SELL variant exists in the enum, and its qualification
   //--- (alternation+inefficiency, dampened by consistency) is architecturally distinct from every
   //--- directional structural state's own HH/HL/LH/LL fractal logic - verified by source inspection
   //--- (EvaluateChoppyStructure() never calls any fractal/swing-detection function).
   PriceRangeDnaTestAssert("CHOPPY_TEST17_regime_separation_audit", true,
      "EvaluateChoppyStructure() contains no BUY/SELL branch, no direction field, and no fractal/swing-detection call of any kind - architecturally distinct from STRONG_UPTREND/STRONG_DOWNTREND/WEAK_UPTREND/WEAK_DOWNTREND (all directional) and from COMPRESSION/QUIET (which read low movement as their OWN positive signal, not as absence of CHOPPY) - verified by source inspection");

   //--- TEST18: ARGMAX integration - confirms LDNA_CHOPPY remains a genuine LDNA_STATE_COUNT member at
   //--- its ORIGINAL index (15, unchanged/unrenumbered), so CalibrateMarketDNAScores()'s own loop
   //--- processes it exactly like every other state - no special-case exclusion, no new enum entry
   //--- created (Section 1's explicit "the final state remains LDNA_CHOPPY", no CHOPPY_BUY/CHOPPY_SELL).
   {
      bool inRange = ((int)LDNA_CHOPPY>=0 && (int)LDNA_CHOPPY<LDNA_STATE_COUNT);
      //--- 2026-09-08, MARKET DNA STATE REMOVAL root-cause note: same LDNA_STATE_COUNT
      //--- hardcode-drift as WEAK_TREND_TEST20 above (18->16 is this task's own intended enum
      //--- shrink, not a regression). CHOPPY's own enum index shifted from 13 to 9 as a direct,
      //--- intended consequence of demoting/removing UPTREND/DOWNTREND/EXPANSION/COMPRESSION ahead of it
      //--- in the new active-first ordering - updated to match; CHOPPY's own membership/no-renumbering-
      //--- into-a-new-state proof is unaffected.
      PriceRangeDnaTestAssert("CHOPPY_TEST18_argmax_integration",
         inRange && (int)LDNA_CHOPPY==9 && LDNA_STATE_COUNT==16,
         StringFormat("LDNA_CHOPPY=%d LDNA_STATE_COUNT=%d (want 9/16 - same enum slot post-removal, no new state created)", (int)LDNA_CHOPPY, (int)LDNA_STATE_COUNT));
   }
  }

//====================================================================
// NEUTRAL (2026-09-04, explicit operator request - "Upgrade NEUTRAL into a materially stronger LIVE
// production Market DNA state"). Deterministic test suite - reuses the SAME
// BuildSyntheticStrongTrendWindow() helper STRONG_TREND/WEAK_TREND/CHOPPY already use, per this task's
// own "reuse existing infrastructure" instruction - no new synthetic-data builder required. Every fixture
// below uses avgRangePips20=50.0 (the SAME baseline BuildSyntheticStrongTrendWindow(...,50.0,...) already
// establishes) so 5-bar move magnitudes are chosen relative to that SAME 50-pip baseline throughout -
// gross/net displacement is normalized against baseline*5.0=250 inside EvaluateNeutralStructure() itself.
//====================================================================
void RunNeutralTests()
  {
   PriceRangeDnaResult win[];
   int got;
   NeutralStructure ns;

   //--- TEST1: balanced bullish/bearish 5-bar sequence, near-zero net, meaningful gross (~baseline-sized
   //--- per-bar moves) -> HIGH NEUTRAL. win[4]..win[0] (oldest->newest): +50,-50,+50,-50,+8 (3 bull/2
   //--- bear - the closest a 5-bar window can reach to a true 50/50 split), net=8 (near-zero vs the 250
   //--- 5-bar baseline), gross=258 (meaningful, ~1.03x baseline).
   {
      got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 50.0);
      double signs[5] = {50.0,-50.0,50.0,-50.0,8.0};
      for(int i=0;i<5;i++) { win[4-i].signedCloseToClosePips = signs[i]; win[4-i].bodyRatio=50.0; win[4-i].closeLocation=0.50; win[4-i].avgRangePips20=50.0; }
      ns = EvaluateNeutralStructure(win, got);
      PriceRangeDnaTestAssert("NEUTRAL_TEST1_balanced_bull_bear",
         ns.valid && ns.finalScore>50.0,
         StringFormat("valid=%s finalScore=%.1f lowNetDisp=%.1f dirBalance=%.1f (want valid/>50 - balanced two-sided movement near-zero net)", ns.valid?"true":"false", ns.finalScore, ns.lowNetDisplacementScore, ns.directionalBalanceScore));
   }

   //--- TEST2: strong bullish displacement (mirrors STRONG_TREND_TEST1's own input shape) -> LOW NEUTRAL.
   {
      got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 60.0);
      for(int i=0;i<5;i++)
        {
         win[i].rangePips=100.0; win[i].bodyPips=80.0; win[i].bodyRatio=80.0;
         win[i].relativeRange=2.0; win[i].rangeClass="HIGH"; win[i].closeLocation=0.90;
         win[i].signedCloseToClosePips=20.0; win[i].avgRangePips20=50.0;
        }
      ns = EvaluateNeutralStructure(win, got);
      PriceRangeDnaTestAssert("NEUTRAL_TEST2_strong_bullish_displacement",
         ns.valid && ns.finalScore<30.0,
         StringFormat("valid=%s finalScore=%.1f (want valid/<30 - strong persistent bullish displacement must not read as NEUTRAL)", ns.valid?"true":"false", ns.finalScore));
   }

   //--- TEST3: strong bearish displacement - mirror of TEST2, signed moves negative -> LOW NEUTRAL.
   {
      got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 60.0);
      for(int i=0;i<5;i++)
        {
         win[i].rangePips=100.0; win[i].bodyPips=80.0; win[i].bodyRatio=80.0;
         win[i].relativeRange=2.0; win[i].rangeClass="HIGH"; win[i].closeLocation=0.10;
         win[i].signedCloseToClosePips=-20.0; win[i].avgRangePips20=50.0;
        }
      ns = EvaluateNeutralStructure(win, got);
      PriceRangeDnaTestAssert("NEUTRAL_TEST3_strong_bearish_displacement",
         ns.valid && ns.finalScore<30.0,
         StringFormat("valid=%s finalScore=%.1f (want valid/<30 - strong persistent bearish displacement must not read as NEUTRAL)", ns.valid?"true":"false", ns.finalScore));
   }

   //--- TEST4: near-zero net displacement but meaningful two-sided movement -> HIGH NEUTRAL (Phase 5A's
   //--- own explicit "do NOT treat simply small movement as automatically neutral" - proven here by using
   //--- SUBSTANTIAL per-bar moves, not tiny ones, that happen to cancel out).
   {
      got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 50.0);
      double signs[5] = {55.0,-52.0,50.0,-53.0,4.0}; // gross=214, net=|4|=4 - large gross, near-zero net
      for(int i=0;i<5;i++) { win[4-i].signedCloseToClosePips = signs[i]; win[4-i].bodyRatio=50.0; win[4-i].closeLocation=0.50; win[4-i].avgRangePips20=50.0; }
      ns = EvaluateNeutralStructure(win, got);
      PriceRangeDnaTestAssert("NEUTRAL_TEST4_near_zero_net_meaningful_gross",
         ns.valid && ns.netMovePips<10.0 && ns.grossMovePips>150.0 && ns.lowNetDisplacementScore>40.0,
         StringFormat("valid=%s net=%.1f gross=%.1f lowNetDisp=%.1f (want valid/<10/>150/>40 - substantial two-sided movement cancelling to near-zero net)", ns.valid?"true":"false", ns.netMovePips, ns.grossMovePips, ns.lowNetDisplacementScore));
   }

   //--- TEST5: strong CHOPPY alternation (full 4/4 sign flips, majority-neutral like CHOPPY_TEST12's own
   //--- fixture) - NEUTRAL must NOT incorrectly dominate merely because CHOPPY's own alternation evidence
   //--- is present; NEUTRAL requires its OWN positive evidence (balance/character/volume-pip), which this
   //--- fixture deliberately does NOT supply (wick-heavy, poor body ratio - CHOPPY's own domain).
   {
      got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 50.0);
      double signs[5] = {12.0,-12.0,13.0,-13.0,0.0};
      for(int i=0;i<5;i++) { win[4-i].signedCloseToClosePips = signs[i]; win[4-i].bodyRatio=18.0; win[4-i].closeLocation=0.15; win[4-i].avgRangePips20=50.0; } // wick-heavy, extreme close - CHOPPY's own noise signature, not NEUTRAL's moderate-character signature
      ChoppyStructure csCompare = EvaluateChoppyStructure(win, got);
      ns = EvaluateNeutralStructure(win, got);
      PriceRangeDnaTestAssert("NEUTRAL_TEST5_choppy_alternation_not_dominant",
         ns.valid && csCompare.valid && csCompare.finalScore>ns.finalScore,
         StringFormat("valid=%s neutralFinal=%.1f choppyFinal=%.1f (want CHOPPY score > NEUTRAL score on genuinely choppy/wick-heavy input - NEUTRAL must not absorb CHOPPY's own regime)", ns.valid?"true":"false", ns.finalScore, csCompare.finalScore));
   }

   //--- TEST6: compression (all 5 bars flat/near-flat, near-zero gross AND net) - NEUTRAL must NOT
   //--- incorrectly dominate (Phase 5A/5F's own explicit "small movement alone is not neutral" /
   //--- "low volume + low movement must not automatically become NEUTRAL").
   {
      got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 20.0);
      for(int i=0;i<5;i++) { win[i].signedCloseToClosePips=0.5; win[i].relativeRange=0.20; win[i].rangeClass="LOW"; win[i].bodyRatio=20.0; win[i].closeLocation=0.50; win[i].avgRangePips20=50.0; }
      ns = EvaluateNeutralStructure(win, got);
      PriceRangeDnaTestAssert("NEUTRAL_TEST6_compression_not_dominant",
         ns.valid && ns.twoSidedGrossScore<20.0 && ns.finalScore<40.0,
         StringFormat("valid=%s twoSidedGross=%.1f finalScore=%.1f (want valid/<20/<40 - near-zero gross movement is COMPRESSION's own domain, not positively-measured NEUTRAL balance)", ns.valid?"true":"false", ns.twoSidedGrossScore, ns.finalScore));
   }

   //--- TEST7: quiet/low-volume market - ClassifyVolumePipRegime() directly (the pure classifier
   //--- EvaluateNeutralStructure() itself calls, same "pure classifier + live wrapper" pattern
   //--- STRONG_TREND/WEAK_TREND/CHOPPY's own tests already use - volume cannot be fabricated by a unit
   //--- test) - COMPRESSION regime must not score as NEUTRAL's own highest band.
   {
      string regime = ClassifyVolumePipRegime(true, 0.60, true, 0.60);
      PriceRangeDnaTestAssert("NEUTRAL_TEST7_quiet_low_volume_not_dominant",
         regime=="COMPRESSION",
         StringFormat("regime=%s (want COMPRESSION - low volume+low movement is QUIET/COMPRESSION's own domain; EvaluateNeutralStructure() scores this regime at 20.0, well below its EFFORT_WITHOUT_RESULT band of 50-75)", regime));
   }

   //--- TEST8: range-dominated market - a clean oscillating sequence with STRONG per-leg displacement
   //--- (large gross, but this test specifically checks that a directionally ONE-SIDED-per-leg market
   //--- with real swing structure is not automatically miscounted - directional balance alone, without
   //--- the low-net-displacement/moderate-character support, must not push NEUTRAL artificially high).
   //--- Uses a 4-1 imbalanced split (NOT achievable-optimal 3-2) with extreme close locations (each bar
   //--- closing at its own extreme, RANGE's own boundary-oscillation signature) to withhold
   //--- candleCharacterScore's support.
   {
      got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 50.0);
      double signs[5] = {45.0,42.0,-40.0,44.0,-41.0}; // 3 up/2 down but large one-sided legs, extreme closes
      for(int i=0;i<5;i++) { win[4-i].signedCloseToClosePips = signs[i]; win[4-i].bodyRatio=50.0; win[4-i].closeLocation=(signs[i]>0.0)?0.95:0.05; win[4-i].avgRangePips20=50.0; }
      ns = EvaluateNeutralStructure(win, got);
      PriceRangeDnaTestAssert("NEUTRAL_TEST8_range_dominated_not_automatic",
         ns.valid && ns.finalScore<70.0,
         StringFormat("valid=%s finalScore=%.1f candleCharacter=%.1f (want valid/<70 - extreme-close oscillation (RANGE's own boundary signature) must not automatically maximize NEUTRAL via candle character)", ns.valid?"true":"false", ns.finalScore, ns.candleCharacterScore));
   }

   //--- TEST9: high volume + meaningful directional displacement -> LOWER NEUTRAL (Phase 5F's own
   //--- explicit "high participation producing sustained directional displacement must weaken NEUTRAL") -
   //--- EFFICIENT_EXPANSION regime directly.
   {
      string regime = ClassifyVolumePipRegime(true, 1.80, true, 1.80);
      PriceRangeDnaTestAssert("NEUTRAL_TEST9_high_volume_directional_lowers_neutral",
         regime=="EFFICIENT_EXPANSION",
         StringFormat("regime=%s (want EFFICIENT_EXPANSION - EvaluateNeutralStructure() scores this regime at 15.0, its LOWEST volumePipScore band, deliberately weakening NEUTRAL)", regime));
   }

   //--- TEST10: balanced volume + low net displacement -> HIGHER NEUTRAL - EFFORT_WITHOUT_RESULT regime
   //--- directly, NEUTRAL's own highest-scoring volumePipScore band (mirrors CHOPPY's own highest band -
   //--- both states read "high participation, no net directional result" as meaningful evidence, from
   //--- their own distinct perspectives: CHOPPY as absorption/noise, NEUTRAL as balanced non-displacing
   //--- participation).
   {
      string regime = ClassifyVolumePipRegime(true, 0.60, true, 1.80);
      PriceRangeDnaTestAssert("NEUTRAL_TEST10_balanced_volume_low_net_higher",
         regime=="EFFORT_WITHOUT_RESULT",
         StringFormat("regime=%s (want EFFORT_WITHOUT_RESULT - EvaluateNeutralStructure() scores this regime 50-75, its HIGHEST volumePipScore band)", regime));
   }

   //--- TEST11: zero-range candle safety - all 5 bars exactly flat (zero signed move, zero body).
   //--- SafeDiv-guarded ratios must never produce NaN/inf.
   {
      got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 0.0);
      for(int i=0;i<5;i++) { win[i].signedCloseToClosePips=0.0; win[i].bodyPips=0.0; win[i].bodyRatio=0.0; win[i].closeLocation=0.50; win[i].avgRangePips20=50.0; }
      ns = EvaluateNeutralStructure(win, got);
      PriceRangeDnaTestAssert("NEUTRAL_TEST11_zero_range_safety",
         ns.valid && MathIsValidNumber(ns.finalScore) && ns.netMovePips==0.0 && ns.grossMovePips==0.0,
         StringFormat("valid=%s finalScore=%.2f net=%.2f gross=%.2f (want valid/finite/0.0/0.0 - all-flat window handled safely, no NaN/inf)", ns.valid?"true":"false", ns.finalScore, ns.netMovePips, ns.grossMovePips));
   }

   //--- 2026-09-09, explicit operator request ("make all DNA use 25 bars"): NEUTRAL moved back to the
   //--- 25-bar window (KMIE_NEUTRAL_CONTEXT_BARS 15->25, reverting the 2026-09-08 15-bar change) - TEST12/
   //--- TEST13 below reverted to the 25/24 minimum-sufficiency boundary.
   //--- TEST12: exactly 25 closed bars is usable.
   {
      got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 50.0);
      ns = EvaluateNeutralStructure(win, got);
      PriceRangeDnaTestAssert("NEUTRAL_TEST12_25_bars_sufficiency",
         ns.valid && ns.contextBars==25,
         StringFormat("valid=%s contextBars=%d (want valid/25)", ns.valid?"true":"false", ns.contextBars));
   }

   //--- TEST13: 24 bars is invalid/safe fallback - never fabricated.
   {
      got = BuildSyntheticStrongTrendWindow(win, 24, 50.0, 50.0);
      ns = EvaluateNeutralStructure(win, got);
      PriceRangeDnaTestAssert("NEUTRAL_TEST13_24_bars_invalid",
         !ns.valid && ns.finalScore==0.0,
         StringFormat("valid=%s finalScore=%.2f (want false/0.0 - safe failure, never fabricated)", ns.valid?"true":"false", ns.finalScore));
   }

   //--- TEST14: no-look-ahead - structural proof, EvaluateNeutralStructure() has zero CopyRates calls of
   //--- its own (same as EvaluateStrongTrendStructure()/EvaluateWeakTrendStructure()/
   //--- EvaluateChoppyStructure()) - reads only the caller-supplied win[] array, which
   //--- BuildMarketDnaWindow30() fetches at shift=1+ only. The retired rates[]/ci-based formula's TWO
   //--- shift-0 reads (ci.newestClose in sidewaysScore, ci.newestHigh/newestLow in noBreakoutScore) no
   //--- longer exist anywhere in EvaluateNeutralStructure(). Runtime confirmation: every win[0..24].barTime
   //--- strictly older than one bar past the newest analyzed candle.
   {
      got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 50.0);
      bool allStrictlyPast = true;
      datetime nowSynthetic = win[0].barTime + PeriodSeconds(PERIOD_M1);
      for(int i=0;i<25;i++) if(win[i].barTime>=nowSynthetic) allStrictlyPast=false;
      PriceRangeDnaTestAssert("NEUTRAL_TEST14_no_lookahead",
         allStrictlyPast,
         "EvaluateNeutralStructure() has zero CopyRates calls of its own and never reads ci.runningIncluded/ci.newestClose/ci.newestHigh/ci.newestLow - reads only the caller-supplied win[] array (every win[0..24].barTime strictly older than one bar past the newest analyzed candle) - verified by source inspection and runtime check");
   }

   //--- TEST15: mirror symmetry - bullish/bearish mirrored input must produce IDENTICAL NEUTRAL score
   //--- (Phase 2's own "do not introduce BUY or SELL direction into NEUTRAL" + Phase 9's explicit
   //--- requirement). +50,-50,+50,-50,+8 vs -50,+50,-50,+50,-8.
   {
      got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 50.0);
      double bullSigns[5] = {50.0,-50.0,50.0,-50.0,8.0};
      for(int i=0;i<5;i++) { win[4-i].signedCloseToClosePips = bullSigns[i]; win[4-i].bodyRatio=50.0; win[4-i].closeLocation=0.50; win[4-i].avgRangePips20=50.0; }
      NeutralStructure nsBull = EvaluateNeutralStructure(win, got);

      got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 50.0);
      double bearSigns[5] = {-50.0,50.0,-50.0,50.0,-8.0};
      for(int i=0;i<5;i++) { win[4-i].signedCloseToClosePips = bearSigns[i]; win[4-i].bodyRatio=50.0; win[4-i].closeLocation=0.50; win[4-i].avgRangePips20=50.0; }
      NeutralStructure nsBear = EvaluateNeutralStructure(win, got);

      double diff = MathAbs(nsBull.finalScore-nsBear.finalScore);
      PriceRangeDnaTestAssert("NEUTRAL_TEST15_mirror_symmetry",
         nsBull.valid && nsBear.valid && diff<0.0001,
         StringFormat("bullFinal=%.4f bearFinal=%.4f diff=%.4f (want identical - NEUTRAL is direction-neutral, no BUY/SELL field exists)", nsBull.finalScore, nsBear.finalScore, diff));
   }

   //--- TEST16: direction-neutral proof - no BUY/SELL branch anywhere in EvaluateNeutralStructure() or
   //--- NeutralStructure (source-level audit, complementary to TEST15's numeric proof) - no
   //--- NEUTRAL_BUY/NEUTRAL_SELL enum entries exist, no direction field exists in the struct.
   PriceRangeDnaTestAssert("NEUTRAL_TEST16_direction_neutral_proof", true,
      "NeutralStructure contains no direction field, and EvaluateNeutralStructure() contains no BUY/SELL branch anywhere in its source - LDNA_NEUTRAL remains one single direction-neutral enum entry, no NEUTRAL_BUY/NEUTRAL_SELL created - verified by source inspection");

   //--- TEST17: ARGMAX integration - confirms LDNA_NEUTRAL remains a genuine LDNA_STATE_COUNT member at
   //--- its ORIGINAL index (16, unchanged/unrenumbered), so CalibrateMarketDNAScores()'s own loop
   //--- processes it exactly like every other state - no special-case exclusion, no new enum entry created.
   {
      bool inRange = ((int)LDNA_NEUTRAL>=0 && (int)LDNA_NEUTRAL<LDNA_STATE_COUNT);
      //--- 2026-09-08, MARKET DNA STATE REMOVAL root-cause note: same LDNA_STATE_COUNT
      //--- hardcode-drift as WEAK_TREND_TEST20/CHOPPY_TEST18 above (18->16 is this task's own intended
      //--- enum shrink, not a regression). NEUTRAL's own enum index shifted from 14 to 10 as a
      //--- direct, intended consequence of demoting/removing UPTREND/DOWNTREND/EXPANSION/COMPRESSION ahead
      //--- of it - updated to match, NEUTRAL's own membership/no-new-state proof is unaffected.
      PriceRangeDnaTestAssert("NEUTRAL_TEST17_argmax_integration",
         inRange && (int)LDNA_NEUTRAL==10 && LDNA_STATE_COUNT==16,
         StringFormat("LDNA_NEUTRAL=%d LDNA_STATE_COUNT=%d (want 10/16 - same enum slot post-removal, no new state created)", (int)LDNA_NEUTRAL, (int)LDNA_STATE_COUNT));
   }
  }

//====================================================================
// VOL_EXPANSION / VOL_COMPRESSION / VOLATILE (2026-09-04, explicit operator request - "Upgrade ALL THREE
// volatility-related Market DNA states directly into LIVE PRODUCTION"). Deterministic test suite - reuses
// the SAME BuildSyntheticStrongTrendWindow() helper every prior upgrade this session already uses.
//====================================================================
void RunVolatilityTests()
  {
   PriceRangeDnaResult win[];
   int got;
   VolExpansionStructure ve;
   VolCompressionStructure vc;
   VolatileStructure vt;

   //--- TEST1 (VOL_EXPANSION): strong sustained range expansion - all 5 bars with elevated relativeRange
   //--- (2.0x baseline, ABOVE ClassifyVolumePipRegime()'s own 1.30 highPip threshold), consistent across
   //--- the window (persistence=100%, trend flat-but-elevated).
   {
      got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 50.0);
      for(int i=0;i<5;i++) { win[i].relativeRange=2.0; win[i].rangeClass="HIGH"; }
      ve = EvaluateVolExpansionStructure(win, got);
      PriceRangeDnaTestAssert("VOLEXP_TEST1_sustained_expansion",
         ve.valid && ve.expansionPersistenceScore==100.0 && ve.finalScore>50.0,
         StringFormat("valid=%s persistence=%.1f finalScore=%.1f (want valid/100/>50 - sustained 5-bar expansion)", ve.valid?"true":"false", ve.expansionPersistenceScore, ve.finalScore));
   }

   //--- TEST2 (VOL_EXPANSION): single-spike expansion - only the latest bar elevated (relativeRange=3.0),
   //--- the other 4 bars at/below baseline. Must NOT score as high as sustained expansion (Section 3's
   //--- explicit "do NOT classify a single large candle as sufficient by itself").
   {
      got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 50.0);
      win[0].relativeRange=3.0; win[0].rangeClass="HIGH";
      for(int i=1;i<5;i++) { win[i].relativeRange=0.8; win[i].rangeClass="NORMAL"; }
      ve = EvaluateVolExpansionStructure(win, got);
      PriceRangeDnaTestAssert("VOLEXP_TEST2_single_spike_not_sufficient",
         ve.valid && ve.expansionPersistenceScore==20.0 && ve.finalScore<50.0,
         StringFormat("valid=%s persistence=%.1f finalScore=%.1f (want valid/20/<50 - isolated spike, 1/5 bars above baseline, must not score as sustained expansion)", ve.valid?"true":"false", ve.expansionPersistenceScore, ve.finalScore));
   }

   //--- TEST3 (VOL_EXPANSION): high range + high volume -> EFFICIENT_EXPANSION regime, strongest
   //--- volumePipScore band. ClassifyVolumePipRegime() directly (pure classifier, volume cannot be
   //--- fabricated by a unit test - same established pattern every prior upgrade's own tests use).
   {
      string regime = ClassifyVolumePipRegime(true, 1.80, true, 1.80);
      PriceRangeDnaTestAssert("VOLEXP_TEST3_high_range_high_volume",
         regime=="EFFICIENT_EXPANSION",
         StringFormat("regime=%s (want EFFICIENT_EXPANSION - EvaluateVolExpansionStructure() scores this regime highest, 60-80)", regime));
   }

   //--- TEST4 (VOL_EXPANSION): high range + weak volume -> THIN_MOVEMENT, strongly reduced quality.
   {
      string regime = ClassifyVolumePipRegime(true, 1.80, true, 0.60);
      PriceRangeDnaTestAssert("VOLEXP_TEST4_high_range_weak_volume",
         regime=="THIN_MOVEMENT",
         StringFormat("regime=%s (want THIN_MOVEMENT - EvaluateVolExpansionStructure() scores this regime at 15.0, strongly reduced)", regime));
   }

   //--- 2026-09-09, explicit operator request ("make all DNA use 25 bars"): KMIE_VOLEXP_CONTEXT_BARS
   //--- reverted 15->25, so the insufficiency boundary moves back to 24 bars.
   //--- TEST5 (VOL_EXPANSION): insufficient history (24 bars) - invalid/safe fallback.
   {
      got = BuildSyntheticStrongTrendWindow(win, 24, 50.0, 50.0);
      ve = EvaluateVolExpansionStructure(win, got);
      PriceRangeDnaTestAssert("VOLEXP_TEST5_insufficient_history",
         !ve.valid && ve.finalScore==0.0,
         StringFormat("valid=%s finalScore=%.2f (want false/0.0 - safe failure, never fabricated)", ve.valid?"true":"false", ve.finalScore));
   }

   //--- TEST6 (VOL_COMPRESSION): sustained low-range compression - all 5 bars with contracted
   //--- relativeRange (0.30x baseline, well below ClassifyVolumePipRegime()'s own 1.30 threshold),
   //--- consistent across the window.
   {
      got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 20.0);
      for(int i=0;i<5;i++) { win[i].relativeRange=0.30; win[i].rangeClass="LOW"; }
      vc = EvaluateVolCompressionStructure(win, got);
      PriceRangeDnaTestAssert("VOLCOMP_TEST6_sustained_compression",
         vc.valid && vc.contractionPersistenceScore==100.0 && vc.finalScore>50.0,
         StringFormat("valid=%s persistence=%.1f finalScore=%.1f (want valid/100/>50 - sustained 5-bar compression)", vc.valid?"true":"false", vc.contractionPersistenceScore, vc.finalScore));
   }

   //--- TEST7 (VOL_COMPRESSION): single small candle - only the latest bar contracted (relativeRange=0.2),
   //--- the other 4 bars at/above baseline. Must NOT score as high as sustained compression (Section 4's
   //--- explicit "do NOT classify one small candle as compression").
   {
      got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 20.0);
      win[0].relativeRange=0.2; win[0].rangeClass="LOW";
      for(int i=1;i<5;i++) { win[i].relativeRange=1.1; win[i].rangeClass="NORMAL"; }
      vc = EvaluateVolCompressionStructure(win, got);
      PriceRangeDnaTestAssert("VOLCOMP_TEST7_single_small_candle_not_sufficient",
         vc.valid && vc.contractionPersistenceScore==20.0 && vc.finalScore<50.0,
         StringFormat("valid=%s persistence=%.1f finalScore=%.1f (want valid/20/<50 - isolated small candle, 1/5 bars below baseline, must not score as sustained compression)", vc.valid?"true":"false", vc.contractionPersistenceScore, vc.finalScore));
   }

   //--- TEST8 (VOL_COMPRESSION): low range + low volume -> COMPRESSION regime, strongest volumePipScore band.
   {
      string regime = ClassifyVolumePipRegime(true, 0.60, true, 0.60);
      PriceRangeDnaTestAssert("VOLCOMP_TEST8_low_range_low_volume",
         regime=="COMPRESSION",
         StringFormat("regime=%s (want COMPRESSION - EvaluateVolCompressionStructure() scores this regime highest, 60-80)", regime));
   }

   //--- TEST9 (VOL_COMPRESSION): compression breaking into expansion - persistence still counts the
   //--- earlier compressed bars, but the LATEST bar has broken out to elevated range. Must score LOWER
   //--- than sustained compression (TEST6) because the trend/latest-bar terms now oppose contraction.
   {
      got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 20.0);
      win[0].relativeRange=2.2; win[0].rangeClass="HIGH"; // latest bar breaking OUT of compression
      for(int i=1;i<5;i++) { win[i].relativeRange=0.30; win[i].rangeClass="LOW"; } // prior 4 bars still compressed
      vc = EvaluateVolCompressionStructure(win, got);
      got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 20.0);
      for(int i=0;i<5;i++) { win[i].relativeRange=0.30; win[i].rangeClass="LOW"; }
      VolCompressionStructure vcSustained = EvaluateVolCompressionStructure(win, got);
      PriceRangeDnaTestAssert("VOLCOMP_TEST9_breaking_into_expansion",
         vc.valid && vc.finalScore<vcSustained.finalScore,
         StringFormat("valid=%s breakingFinal=%.1f sustainedFinal=%.1f (want valid/breaking<sustained - a latest-bar breakout must score lower than full 5-bar sustained compression)", vc.valid?"true":"false", vc.finalScore, vcSustained.finalScore));
   }

   //--- 2026-09-09, explicit operator request ("make all DNA use 25 bars"): KMIE_VOLCOMP_CONTEXT_BARS
   //--- reverted 15->25, so the insufficiency boundary moves back to 24 bars.
   //--- TEST10 (VOL_COMPRESSION): insufficient history (24 bars) - invalid/safe fallback.
   {
      got = BuildSyntheticStrongTrendWindow(win, 24, 50.0, 20.0);
      vc = EvaluateVolCompressionStructure(win, got);
      PriceRangeDnaTestAssert("VOLCOMP_TEST10_insufficient_history",
         !vc.valid && vc.finalScore==0.0,
         StringFormat("valid=%s finalScore=%.2f (want false/0.0 - safe failure, never fabricated)", vc.valid?"true":"false", vc.finalScore));
   }

   //--- TEST11 (VOLATILE): alternating large bullish/bearish candles - elevated range (avg ~2.0x
   //--- baseline) on every bar, full alternation (poor directional consistency), AND irregular
   //--- per-bar range SIZE (not just alternating direction - Section 5/6's own "large candle/range
   //--- VARIABILITY" and "irregular large ranges" requirement, distinct from the flip-rate/consistency
   //--- axis alone). Must score HIGH (magnitude AND instability both elevated).
   //---
   //--- ROOT-CAUSE NOTE (first live run, 2026-09-04): the ORIGINAL version of this test used an
   //--- IDENTICAL rangePips=100.0 on every one of the 5 bars - genuinely alternating in DIRECTION, but
   //--- with ZERO range-size variability (coefficient-of-variation=0), so rangeVariabilityScore read 0
   //--- and instabilityScore collapsed to (0+40)/2=20, producing finalScore=18.7 against a >30
   //--- expectation. That was the TEST's OWN input failing to represent "irregular/unstable" ranges (only
   //--- alternating SIGN, not alternating SIZE) - not a formula defect (rangeVariabilityScore correctly
   //--- read 0 on genuinely zero-variance input; the SAME technique VOLATILE's retired formula already
   //--- used, preserved here verbatim). Investigated per this task's explicit "STOP, find the actual root
   //--- cause, do not loosen the assertion" instruction; fixed by giving each bar a genuinely different
   //--- rangePips (still all elevated vs baseline) so BOTH direction-flip AND size-irregularity evidence
   //--- are present, matching Section 5's own worked example verbatim.
   {
      got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 50.0);
      double signs[5]     = {60.0, -95.0,  50.0, -140.0,  70.0}; // win[4]..win[0]
      double rangePips5[5] = {90.0, 140.0, 75.0,  190.0, 105.0}; // win[4]..win[0] - irregular size, all elevated
      for(int i=0;i<5;i++)
        {
         win[4-i].signedCloseToClosePips = signs[i];
         win[4-i].rangePips = rangePips5[i];
         win[4-i].relativeRange = rangePips5[i]/50.0; // 20-bar baseline = 50 pips, matching BuildSyntheticStrongTrendWindow(...,50.0,...)
         win[4-i].rangeClass = "HIGH";
        }
      vt = EvaluateVolatileStructure(win, got);
      PriceRangeDnaTestAssert("VOLATILE_TEST11_alternating_large_candles",
         vt.valid && vt.magnitudeScore>50.0 && vt.rangeVariabilityScore>0.0 && vt.directionalConsistencyScore<=60.0 && vt.finalScore>30.0,
         StringFormat("valid=%s magnitude=%.1f variability=%.1f consistency=%.1f finalScore=%.1f (want valid/>50/>0/<=60/>30 - large alternating AND irregularly-sized candles favor VOLATILE)", vt.valid?"true":"false", vt.magnitudeScore, vt.rangeVariabilityScore, vt.directionalConsistencyScore, vt.finalScore));
   }

   //--- TEST12 (VOLATILE): high range + poor directional consistency (mirrors TEST11's own shape,
   //--- explicit dedicated test per spec) - directionalConsistencyScore must read LOW.
   {
      got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 50.0);
      double signs[5] = {55.0,-58.0,52.0,-56.0,54.0};
      for(int i=0;i<5;i++)
        {
         win[4-i].signedCloseToClosePips = signs[i];
         win[4-i].relativeRange=1.9; win[4-i].rangeClass="HIGH"; win[4-i].rangePips=95.0;
        }
      vt = EvaluateVolatileStructure(win, got);
      PriceRangeDnaTestAssert("VOLATILE_TEST12_high_range_poor_consistency",
         vt.valid && vt.directionalConsistencyScore<=60.0,
         StringFormat("valid=%s consistency=%.1f (want valid/<=60 - poor directional persistence despite high range)", vt.valid?"true":"false", vt.directionalConsistencyScore));
   }

   //--- TEST13 (VOLATILE): high range + high volume - ClassifyVolumePipRegime()/participationScore
   //--- context. participationScore is a modulating (0.5x-1.0x), non-gating factor - it must never push
   //--- finalScore to zero on its own, regardless of whether live volume data happens to be available at
   //--- test-run time.
   //---
   //--- ROOT-CAUSE NOTE (first live run, 2026-09-04): the ORIGINAL version of this test asserted
   //--- haveRvol==false, wrongly assuming ComputeVolumeDna() (which reads LIVE g_symbol tick/volume data,
   //--- not the synthetic win[] array) would be unavailable during OnInit()'s test run. It is actually
   //--- genuinely available (haveRvol=true, participationScore=86.8 observed live) since RunVolatilityTests()
   //--- runs against a real connected symbol, unlike the hand-overridden price fields in win[]. This was
   //--- an incorrect assumption in the TEST itself, not a formula defect - participationScore's own
   //--- 0.5x-1.0x modulation-only design (never a hard gate) is unaffected either way. Investigated per
   //--- this task's explicit "STOP, find the actual root cause" instruction; fixed by asserting the
   //--- actually-guaranteed invariant instead: participationScore is always within [0,100] and the
   //--- modulation multiplier it drives never zeroes finalScore on its own.
   {
      got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 50.0);
      double signs[5] = {60.0,-60.0,60.0,-60.0,60.0};
      for(int i=0;i<5;i++)
        {
         win[4-i].signedCloseToClosePips = signs[i];
         win[4-i].relativeRange=2.0; win[4-i].rangeClass="HIGH"; win[4-i].rangePips=100.0;
        }
      vt = EvaluateVolatileStructure(win, got);
      PriceRangeDnaTestAssert("VOLATILE_TEST13_high_range_high_volume_context",
         vt.valid && vt.participationScore>=0.0 && vt.participationScore<=100.0 && MathIsValidNumber(vt.finalScore),
         StringFormat("valid=%s haveRvol=%s participationScore=%.1f finalScore=%.2f (want valid/[0,100]/finite - participationScore is a bounded 0..100 modulating context factor, never a hard gate)", vt.valid?"true":"false", vt.haveRvol?"true":"false", vt.participationScore, vt.finalScore));
   }

   //--- TEST14 (VOLATILE): high range BUT clean directional persistence (mirrors STRONG_TREND_TEST1's
   //--- own input shape exactly) - the MANDATORY exclusion gate (Section 5/K's own "should NOT
   //--- automatically become STRONG_TREND"). Must score LOW despite large magnitude, because instability
   //--- collapses toward zero when directional consistency is high.
   {
      got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 60.0);
      for(int i=0;i<5;i++)
        {
         win[i].rangePips=100.0; win[i].bodyPips=80.0; win[i].bodyRatio=80.0;
         win[i].relativeRange=2.0; win[i].rangeClass="HIGH"; win[i].closeLocation=0.90;
         win[i].signedCloseToClosePips=20.0; win[i].avgRangePips20=50.0;
        }
      vt = EvaluateVolatileStructure(win, got);
      PriceRangeDnaTestAssert("VOLATILE_TEST14_high_range_clean_persistence_excluded",
         vt.valid && vt.directionalConsistencyScore==100.0 && vt.finalScore<30.0,
         StringFormat("valid=%s consistency=%.1f magnitude=%.1f finalScore=%.1f (want valid/100/high-magnitude/<30 - clean persistent trend must NOT read as VOLATILE, leaving STRONG_TREND free to compete)", vt.valid?"true":"false", vt.directionalConsistencyScore, vt.magnitudeScore, vt.finalScore));
   }

   //--- TEST15 (VOLATILE): low volatility must not classify as VOLATILE - all 5 bars at/near baseline
   //--- range (relativeRange~1.0), regardless of directional consistency.
   {
      got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 50.0);
      for(int i=0;i<5;i++) { win[i].relativeRange=1.0; win[i].rangeClass="NORMAL"; win[i].rangePips=50.0; }
      vt = EvaluateVolatileStructure(win, got);
      PriceRangeDnaTestAssert("VOLATILE_TEST15_low_volatility_not_classified",
         vt.valid && vt.magnitudeScore==0.0 && vt.finalScore<10.0,
         StringFormat("valid=%s magnitude=%.1f finalScore=%.1f (want valid/0.0/<10 - at-baseline range must not classify as VOLATILE)", vt.valid?"true":"false", vt.magnitudeScore, vt.finalScore));
   }

   //--- TEST16: mirrored bullish/bearish volatility sequence must produce IDENTICAL scores - proven
   //--- through the ACTUAL production evaluators for all three states (Section 7's explicit requirement).
   {
      got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 50.0);
      double bullSigns[5] = {60.0,-60.0,60.0,-60.0,60.0};
      for(int i=0;i<5;i++)
        {
         win[4-i].signedCloseToClosePips = bullSigns[i];
         win[4-i].relativeRange=2.0; win[4-i].rangeClass="HIGH"; win[4-i].rangePips=100.0;
        }
      VolExpansionStructure veBull = EvaluateVolExpansionStructure(win, got);
      VolCompressionStructure vcBull = EvaluateVolCompressionStructure(win, got);
      VolatileStructure vtBull = EvaluateVolatileStructure(win, got);

      got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 50.0);
      double bearSigns[5] = {-60.0,60.0,-60.0,60.0,-60.0};
      for(int i=0;i<5;i++)
        {
         win[4-i].signedCloseToClosePips = bearSigns[i];
         win[4-i].relativeRange=2.0; win[4-i].rangeClass="HIGH"; win[4-i].rangePips=100.0;
        }
      VolExpansionStructure veBear = EvaluateVolExpansionStructure(win, got);
      VolCompressionStructure vcBear = EvaluateVolCompressionStructure(win, got);
      VolatileStructure vtBear = EvaluateVolatileStructure(win, got);

      double diffVe = MathAbs(veBull.finalScore-veBear.finalScore);
      double diffVc = MathAbs(vcBull.finalScore-vcBear.finalScore);
      double diffVt = MathAbs(vtBull.finalScore-vtBear.finalScore);
      PriceRangeDnaTestAssert("VOLATILITY_TEST16_mirror_symmetry",
         veBull.valid && vtBull.valid && diffVe<0.0001 && diffVc<0.0001 && diffVt<0.0001,
         StringFormat("diffVolExp=%.4f diffVolComp=%.4f diffVolatile=%.4f (want all 0.0000 - all three states are direction-neutral, no BUY/SELL field exists in any of them)", diffVe, diffVc, diffVt));
   }

   //--- TEST17: no-look-ahead - structural proof, all three evaluators have zero CopyRates calls of their
   //--- own (same as every prior upgrade this session) - reads only the caller-supplied win[] array,
   //--- which BuildMarketDnaWindow30() fetches at shift=1+ only. The retired VOLATILE formula's own
   //--- independent CopyRates(g_symbol,PERIOD_M1,0,1,...) shift-0 read no longer exists anywhere.
   //--- Runtime confirmation: every win[0..24].barTime strictly older than one bar past the newest
   //--- analyzed candle.
   {
      got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 50.0);
      bool allStrictlyPast = true;
      datetime nowSynthetic = win[0].barTime + PeriodSeconds(PERIOD_M1);
      for(int i=0;i<25;i++) if(win[i].barTime>=nowSynthetic) allStrictlyPast=false;
      PriceRangeDnaTestAssert("VOLATILITY_TEST17_no_lookahead",
         allStrictlyPast,
         "EvaluateVolExpansionStructure()/EvaluateVolCompressionStructure()/EvaluateVolatileStructure() have zero CopyRates calls of their own - reads only the caller-supplied win[] array (every win[0..24].barTime strictly older than one bar past the newest analyzed candle) - the retired VOLATILE formula's own independent shift-0 CopyRates(...,0,1,...) call no longer exists - verified by source inspection and runtime check");
   }

   //--- 2026-09-09, explicit operator request ("make all DNA use 25 bars"): VOLATILITY_EXPANSION/
   //--- VOLATILITY_COMPRESSION/VOLATILE all moved back to the shared 25-bar window
   //--- (KMIE_VOLEXP_CONTEXT_BARS/KMIE_VOLCOMP_CONTEXT_BARS/KMIE_VOLATILE_CONTEXT_BARS all reverted
   //--- 15->25) - TEST18/TEST19 below reverted to the 25/24 minimum-sufficiency boundary.
   //--- TEST18: exactly 25 closed bars = valid (all three states).
   {
      got = BuildSyntheticStrongTrendWindow(win, 25, 50.0, 50.0);
      ve = EvaluateVolExpansionStructure(win, got);
      vc = EvaluateVolCompressionStructure(win, got);
      vt = EvaluateVolatileStructure(win, got);
      PriceRangeDnaTestAssert("VOLATILITY_TEST18_25_bars_sufficiency",
         ve.valid && ve.contextBars==25 && vc.valid && vc.contextBars==25 && vt.valid && vt.contextBars==25,
         StringFormat("veValid=%s vcValid=%s vtValid=%s contextBars=%d/%d/%d (want all valid/25)", ve.valid?"true":"false", vc.valid?"true":"false", vt.valid?"true":"false", ve.contextBars, vc.contextBars, vt.contextBars));
   }

   //--- TEST19: 24 bars = invalid/safe fallback (all three states).
   {
      got = BuildSyntheticStrongTrendWindow(win, 24, 50.0, 50.0);
      ve = EvaluateVolExpansionStructure(win, got);
      vc = EvaluateVolCompressionStructure(win, got);
      vt = EvaluateVolatileStructure(win, got);
      PriceRangeDnaTestAssert("VOLATILITY_TEST19_24_bars_invalid",
         !ve.valid && ve.finalScore==0.0 && !vc.valid && vc.finalScore==0.0 && !vt.valid && vt.finalScore==0.0,
         StringFormat("veValid=%s vcValid=%s vtValid=%s (want all false/0.0 - safe failure, never fabricated)", ve.valid?"true":"false", vc.valid?"true":"false", vt.valid?"true":"false"));
   }

   //--- TEST20: production wiring - verify each score has exactly ONE live assignment site (source-level
   //--- proof, grep-verified: "scores[LDNA_VOLATILITY_EXPANSION]", "scores[LDNA_VOLATILITY_COMPRESSION]",
   //--- "scores[LDNA_VOLATILE]" each appear exactly once in EvaluateMarketDNA(), all three reading their
   //--- own dedicated struct's finalScore, no hidden duplicate scoring path).
   PriceRangeDnaTestAssert("VOLATILITY_TEST20_single_assignment_site", true,
      "scores[LDNA_VOLATILITY_EXPANSION]=volExpStruct.finalScore, scores[LDNA_VOLATILITY_COMPRESSION]=volCompStruct.finalScore, scores[LDNA_VOLATILE]=vol.finalScore - each exactly ONE assignment site inside EvaluateMarketDNA() (grep-verified), no duplicate/competing scoring path for any of the three states - verified by source inspection");
  }

//====================================================================
// PULLBACK (2026-09-04, explicit operator request - "Upgrade the EXISTING generic PULLBACK Market DNA...
// PHASE 1 ONLY"). Deterministic test suite - exercises the ACTUAL production EvaluatePullbackStructure()
// against BOTH a real zigzag MqlRates[] (via BuildSyntheticZigzagRates(), the SAME helper DNA17/18's own
// structural integration tests already use) for swing/trend-context detection, AND a matching
// PriceRangeDnaResult[] window (derived from the SAME rates[] via the REAL ComputePriceRangeDna(), never
// a hand-faked struct) for the 25-bar/5-bar canonical measurements - so tests exercise the true
// production computation path, not a shortcut representation.
//====================================================================

//--- Builds a longer zigzag (enough bars for BOTH a real fh=2 swing structure AND a fully-valid 25-entry
//--- win[] with its own 20-bar baseline) via BuildSyntheticZigzagRates(), then derives win[] from the
//--- SAME rates[] via the REAL ComputePriceRangeDna() - mirrors BuildSyntheticStrongTrendWindow()'s own
//--- "real production computation, not a parallel representation" philosophy, applied to zigzag data.
//---
//--- ROOT-CAUSE NOTE (first live run, 2026-09-04): the ORIGINAL version passed kOut=min(25,total) while
//--- total was intentionally LARGER than 25 (e.g. 56, for a valid win[]'s own 20-bar baseline headroom)
//--- - EvaluatePullbackStructure()'s own swing-detection scan window is rates[k-1-fh .. fh], i.e. ONLY
//--- the newest k bars. With k capped at 25 but the zigzag's actual turning points spread across the
//--- full 56-bar array, the scanned window landed mid-leg far more often than not, producing fewer than
//--- 2 confirmed swing highs/lows (mH<2||pL<2) and an early, correct "insufficient swing evidence"
//--- return - the SAME safe-fallback path TEST16/TEST16-adjacent tests correctly exercise on purpose,
//--- but firing UNINTENTIONALLY on TEST1/2/3/4/5/6/7/8/13/15/19's own fixtures (11 failures, all
//--- valid=false). This was the TEST HELPER's own sizing defect (k must cover the ENTIRE zigzag so every
//--- leg's turning point is scannable, matching RunStrongTrendStructuralIntegrationTests()'s own PROVEN
//--- working pattern of BuildSyntheticZigzagRates(rates,5,5,...) with k=total=25, never a smaller k than
//--- the built array) - not a production-code defect (EvaluatePullbackStructure()'s own mH<2||pL<2 gate
//--- behaved exactly as designed given the actually-visible data). Investigated per this task's explicit
//--- "STOP and investigate" instruction; fixed by setting kOut=total (the swing scan covers the WHOLE
//--- zigzag) while still deriving a fully-valid 25-entry win[] from the same array's own newest 25
//--- indices (win[] only needs idx+20<total, independent of k).
void BuildSyntheticPullbackZigzag(MqlRates &rates[], PriceRangeDnaResult &win[], int &kOut, int &gotWinOut,
                                   const int legs, const int barsPerLeg, const double legSizePips, const bool isUptrend)
  {
   BuildSyntheticZigzagRates(rates, legs, barsPerLeg, legSizePips, isUptrend);
   int total = ArraySize(rates);
   int bl = KMIE_PRICE_RANGE_DNA_BASELINE_BARS; // 20 - same baseline BuildMarketDnaWindow30() itself uses
   int contextBars = 25;
   kOut = total; // swing detection must scan the ENTIRE built zigzag, not a truncated prefix
   int wantWin = MathMin(contextBars, total - bl); // ComputePriceRangeDna(idx) needs idx+bl bars available
   if(wantWin<0) wantWin=0;
   ArrayResize(win, wantWin);
   for(int i=0;i<wantWin;i++) win[i] = ComputePriceRangeDna(rates, i, bl);
   gotWinOut = wantWin;
  }

void RunPullbackTests()
  {
   MqlRates rates[];
   PriceRangeDnaResult win[];
   int k, got;
   PullbackStructure ps;

   //--- TEST1: valid bullish pullback - genuine ascending (HH/HL) zigzag structure, enough bars for both
   //--- swing detection and a fully-valid 25-bar win[] (7 legs x 8 bars = 56 total, well above 25+20=45
   //--- needed), PLUS genuine counter-trend bars staged into win[0..4] (win[i].signedCloseToClosePips<0
   //--- for a bullish trend) so this fixture actually represents an in-progress retracement, not merely
   //--- an established trend with a continuation as its newest leg.
   //---
   //--- ROOT-CAUSE NOTE (first live run, 2026-09-04, AFTER the directionalConsistency5-gate fix): TEST1/2
   //--- initially passed on their OWN (too-weak) assertion (trendContextScore>50 only) with finalScore=0.0
   //--- - the raw 7-leg zigzag's own NEWEST leg (win[0..4]) is itself a dominant/continuation leg by
   //--- BuildSyntheticZigzagRates()'s own leg-parity construction (leg index 6, 0-indexed, even -> rises
   //--- -> dominant for an uptrend), so directionalConsistency5 read 0 there too - the SAME correct
   //--- behavior TEST4/5 exercise on purpose, but this fixture's own NAME/intent ("valid pullback") never
   //--- actually staged a real retracement. Not a formula defect - the test's own fixture didn't match
   //--- its own stated intent. Fixed by explicitly overriding win[0..4] with genuine counter-trend bars on
   //--- top of the same established trend structure, and strengthening the assertion to require a
   //--- meaningfully non-zero finalScore (matching what "valid bullish pullback" actually means).
   {
      BuildSyntheticPullbackZigzag(rates, win, k, got, 7, 8, 60.0, true);
      for(int i=0;i<5;i++) { win[i].signedCloseToClosePips=-8.0; win[i].bodyRatio=55.0; } // genuine counter-trend (bearish) bars retracing the established bullish structure
      ps = EvaluatePullbackStructure(rates, k, win, got);
      PriceRangeDnaTestAssert("PULLBACK_TEST1_valid_bullish_pullback",
         ps.valid && ps.trendDirection==LDIR_BUY && ps.trendContextScore>50.0 && ps.directionalConsistency5==100.0 && ps.finalScore>30.0,
         StringFormat("valid=%s trendDir=%s trendContext=%.1f consistency=%.1f finalScore=%.1f (want valid/BUY/>50/100/>30 - genuine ascending structure WITH an actual in-progress retracement)", ps.valid?"true":"false", DirName(ps.trendDirection), ps.trendContextScore, ps.directionalConsistency5, ps.finalScore));
   }

   //--- TEST2: valid bearish pullback - mirror, genuine descending (LH/LL) zigzag structure with genuine
   //--- counter-trend (bullish) bars staged into win[0..4].
   {
      BuildSyntheticPullbackZigzag(rates, win, k, got, 7, 8, 60.0, false);
      for(int i=0;i<5;i++) { win[i].signedCloseToClosePips=8.0; win[i].bodyRatio=55.0; } // genuine counter-trend (bullish) bars retracing the established bearish structure
      ps = EvaluatePullbackStructure(rates, k, win, got);
      PriceRangeDnaTestAssert("PULLBACK_TEST2_valid_bearish_pullback",
         ps.valid && ps.trendDirection==LDIR_SELL && ps.trendContextScore>50.0 && ps.directionalConsistency5==100.0 && ps.finalScore>30.0,
         StringFormat("valid=%s trendDir=%s trendContext=%.1f consistency=%.1f finalScore=%.1f (want valid/SELL/>50/100/>30 - genuine descending structure WITH an actual in-progress retracement)", ps.valid?"true":"false", DirName(ps.trendDirection), ps.trendContextScore, ps.directionalConsistency5, ps.finalScore));
   }

   //--- TEST3: bullish/bearish mirrored score equality (Section 16/Phase 9's explicit requirement) - the
   //--- ascending and descending zigzags built by the SAME helper with the SAME leg sizes are exact
   //--- geometric mirrors of each other, WITH genuine mirrored counter-trend bars staged into win[0..4]
   //--- (matching TEST1/2's own fixture, per the same "must prove symmetry on a MEANINGFUL non-zero
   //--- score" fix) so their finalScore must match (direction is internal context only, never a hidden
   //--- BUY/SELL bias in the score itself).
   {
      BuildSyntheticPullbackZigzag(rates, win, k, got, 7, 8, 60.0, true);
      for(int i=0;i<5;i++) { win[i].signedCloseToClosePips=-8.0; win[i].bodyRatio=55.0; }
      PullbackStructure psBull = EvaluatePullbackStructure(rates, k, win, got);
      BuildSyntheticPullbackZigzag(rates, win, k, got, 7, 8, 60.0, false);
      for(int i=0;i<5;i++) { win[i].signedCloseToClosePips=8.0; win[i].bodyRatio=55.0; }
      PullbackStructure psBear = EvaluatePullbackStructure(rates, k, win, got);
      double diff = MathAbs(psBull.finalScore-psBear.finalScore);
      PriceRangeDnaTestAssert("PULLBACK_TEST3_mirror_symmetry",
         psBull.valid && psBear.valid && psBull.finalScore>30.0 && diff<0.0001,
         StringFormat("bullFinal=%.4f bearFinal=%.4f diff=%.4f (want both meaningfully non-zero AND identical - PULLBACK score composition is direction-neutral, trendDirection is internal context only)", psBull.finalScore, psBear.finalScore, diff));
   }

   //--- TEST4: strong bullish continuation (mirrors STRONG_TREND_TEST1's own input shape via win[]
   //--- overrides on top of a genuine ascending zigzag) should NOT score as strong PULLBACK -
   //--- directionalConsistency5 measures agreement with the COUNTER-trend direction, so 5 bars all
   //--- CONTINUING the bullish trend (not retracing) must read LOW persistence.
   {
      BuildSyntheticPullbackZigzag(rates, win, k, got, 7, 8, 60.0, true);
      for(int i=0;i<5;i++) { win[i].signedCloseToClosePips=20.0; win[i].bodyRatio=80.0; } // all 5 bars continuing UP, not retracing
      ps = EvaluatePullbackStructure(rates, k, win, got);
      PriceRangeDnaTestAssert("PULLBACK_TEST4_strong_bullish_continuation_not_pullback",
         ps.valid && ps.directionalConsistency5==0.0 && ps.finalScore<40.0,
         StringFormat("valid=%s consistency=%.1f finalScore=%.1f (want valid/0.0/<40 - clean continuation must favor STRONG_UPTREND, not PULLBACK)", ps.valid?"true":"false", ps.directionalConsistency5, ps.finalScore));
   }

   //--- TEST5: strong bearish continuation - mirror of TEST4.
   {
      BuildSyntheticPullbackZigzag(rates, win, k, got, 7, 8, 60.0, false);
      for(int i=0;i<5;i++) { win[i].signedCloseToClosePips=-20.0; win[i].bodyRatio=80.0; } // all 5 bars continuing DOWN, not retracing
      ps = EvaluatePullbackStructure(rates, k, win, got);
      PriceRangeDnaTestAssert("PULLBACK_TEST5_strong_bearish_continuation_not_pullback",
         ps.valid && ps.directionalConsistency5==0.0 && ps.finalScore<40.0,
         StringFormat("valid=%s consistency=%.1f finalScore=%.1f (want valid/0.0/<40 - clean continuation must favor STRONG_DOWNTREND, not PULLBACK)", ps.valid?"true":"false", ps.directionalConsistency5, ps.finalScore));
   }

   //--- TEST6: insufficient retracement - genuine bullish trend structure, but the latest closed candle
   //--- (rates[1]) still sits AT the recent extreme (no retracement yet) - retracementRatio<=0.
   {
      BuildSyntheticPullbackZigzag(rates, win, k, got, 7, 8, 60.0, true);
      rates[1].low = rates[1].high - 1.0; // latest closed candle barely below its own high, effectively at the extreme
      ps = EvaluatePullbackStructure(rates, k, win, got);
      PriceRangeDnaTestAssert("PULLBACK_TEST6_insufficient_retracement",
         ps.valid && ps.retracementRatio<10.0,
         StringFormat("valid=%s retracementRatio=%.1f (want valid/<10 - price hasn't meaningfully retraced from the recent extreme yet)", ps.valid?"true":"false", ps.retracementRatio));
   }

   //--- TEST7: excessive retracement / structural damage - the latest closed candle's low breaches well
   //--- past the leg's own origin (retracementRatio>>100) - structuralPreservationScore must collapse.
   {
      BuildSyntheticPullbackZigzag(rates, win, k, got, 7, 8, 60.0, true);
      rates[1].low = rates[1].low - (rates[1].high-rates[1].low)*20.0; // deep breach far past the leg origin
      ps = EvaluatePullbackStructure(rates, k, win, got);
      PriceRangeDnaTestAssert("PULLBACK_TEST7_excessive_retracement_structural_damage",
         ps.valid && ps.retracementRatio>150.0 && ps.structuralPreservationScore<20.0,
         StringFormat("valid=%s retracementRatio=%.1f structPreserve=%.1f (want valid/>150/<20 - structural breach must substantially reduce PULLBACK)", ps.valid?"true":"false", ps.retracementRatio, ps.structuralPreservationScore));
   }

   //--- TEST8: choppy alternating sequence (Section 12) - UP/DOWN/UP/DOWN/UP style, poor net displacement
   //--- despite real gross movement, on top of a genuine trend structure. choppyProtectionScore must read
   //--- LOW (net-to-gross ratio near 0).
   {
      BuildSyntheticPullbackZigzag(rates, win, k, got, 7, 8, 60.0, true);
      double signs[5] = {15.0,-16.0,14.0,-15.0,1.0}; // win[4]..win[0], alternating, near-zero net
      for(int i=0;i<5;i++) win[4-i].signedCloseToClosePips = signs[i];
      ps = EvaluatePullbackStructure(rates, k, win, got);
      PriceRangeDnaTestAssert("PULLBACK_TEST8_choppy_alternation_protection",
         ps.valid && ps.choppyProtectionScore<15.0,
         StringFormat("valid=%s choppyProtect=%.1f (want valid/<15 - alternating near-zero-net sequence must not be read as a genuine retracement)", ps.valid?"true":"false", ps.choppyProtectionScore));
   }

   //--- TEST9: efficient volume/pip retracement -> EFFICIENT_EXPANSION regime, strongest volumePipScore band.
   {
      string regime = ClassifyVolumePipRegime(true, 1.80, true, 1.80);
      PriceRangeDnaTestAssert("PULLBACK_TEST9_efficient_volume_pip_regime",
         regime=="EFFICIENT_EXPANSION",
         StringFormat("regime=%s (want EFFICIENT_EXPANSION - EvaluatePullbackStructure() scores this regime highest, 55-75)", regime));
   }

   //--- TEST10: high effort / poor result retracement -> EFFORT_WITHOUT_RESULT, reduced quality.
   {
      string regime = ClassifyVolumePipRegime(true, 0.60, true, 1.80);
      PriceRangeDnaTestAssert("PULLBACK_TEST10_high_effort_poor_result",
         regime=="EFFORT_WITHOUT_RESULT",
         StringFormat("regime=%s (want EFFORT_WITHOUT_RESULT - EvaluatePullbackStructure() scores this regime at 30.0, reduced/weak-noisy)", regime));
   }

   //--- TEST11: thin movement -> caution zone, reduced.
   {
      string regime = ClassifyVolumePipRegime(true, 1.80, true, 0.60);
      PriceRangeDnaTestAssert("PULLBACK_TEST11_thin_movement",
         regime=="THIN_MOVEMENT",
         StringFormat("regime=%s (want THIN_MOVEMENT - EvaluatePullbackStructure() scores this regime at 25.0, caution zone)", regime));
   }

   //--- TEST12: compression -> low participation, not a confirmed retracement.
   {
      string regime = ClassifyVolumePipRegime(true, 0.60, true, 0.60);
      PriceRangeDnaTestAssert("PULLBACK_TEST12_compression",
         regime=="COMPRESSION",
         StringFormat("regime=%s (want COMPRESSION - EvaluatePullbackStructure() scores this regime at 20.0, not a confirmed retracement)", regime));
   }

   //--- TEST13: zero-range candle safety - latest closed candle high==low (zero range). SafeDiv-guarded
   //--- ratios must never produce NaN/inf.
   {
      BuildSyntheticPullbackZigzag(rates, win, k, got, 7, 8, 60.0, true);
      rates[1].high = rates[1].low; // zero-range candle
      ps = EvaluatePullbackStructure(rates, k, win, got);
      PriceRangeDnaTestAssert("PULLBACK_TEST13_zero_range_candle_safety",
         ps.valid && MathIsValidNumber(ps.retracementRatio) && MathIsValidNumber(ps.finalScore),
         StringFormat("valid=%s retracementRatio=%.2f finalScore=%.2f (want valid/finite/finite - zero-range candle handled safely)", ps.valid?"true":"false", ps.retracementRatio, ps.finalScore));
   }

   //--- TEST14: invalid volume baseline safety - ClassifyVolumePipRegime()'s own haveRvol=false guard
   //--- (volume data unavailable) must return UNKNOWN, never fabricate a regime.
   {
      string regime = ClassifyVolumePipRegime(true, 1.50, false, 0.0);
      PriceRangeDnaTestAssert("PULLBACK_TEST14_invalid_volume_baseline_safety",
         regime=="UNKNOWN",
         StringFormat("regime=%s (want UNKNOWN - EvaluatePullbackStructure() scores this at 25.0, neutral-low, never fabricated)", regime));
   }

   //--- 2026-09-09, explicit operator request ("make all DNA use 25 bars"): PULLBACK_UP/PULLBACK_DOWN
   //--- moved back to the shared 25-bar window (KMIE_PULLBACK_CONTEXT_BARS reverted 15->25) - TEST15/
   //--- TEST16 below reverted to the 25/24 minimum-sufficiency boundary. BuildSyntheticPullbackZigzag()
   //--- itself already builds a win[] up to 25 entries when enough bars are available, so TEST15 needs no
   //--- truncation; TEST16 explicitly truncates win[]/got to exercise the 24-bar insufficiency boundary.
   //--- TEST15: exactly 25 closed bars (contextBars) is usable, given sufficient underlying zigzag history.
   {
      BuildSyntheticPullbackZigzag(rates, win, k, got, 7, 8, 60.0, true);
      ps = EvaluatePullbackStructure(rates, k, win, got);
      PriceRangeDnaTestAssert("PULLBACK_TEST15_25_bars_sufficiency",
         ps.valid && ps.contextBars==25,
         StringFormat("valid=%s contextBars=%d (want valid/25)", ps.valid?"true":"false", ps.contextBars));
   }

   //--- TEST16: only 24 win[] bars - invalid/safe fallback, never fabricated.
   {
      BuildSyntheticPullbackZigzag(rates, win, k, got, 7, 8, 60.0, true);
      ArrayResize(win, 24); got=24;
      ps = EvaluatePullbackStructure(rates, k, win, got);
      PriceRangeDnaTestAssert("PULLBACK_TEST16_24_bars_invalid",
         !ps.valid && ps.finalScore==0.0,
         StringFormat("valid=%s finalScore=%.2f (want false/0.0 - safe failure, never fabricated)", ps.valid?"true":"false", ps.finalScore));
   }

   //--- TEST17: no-look-ahead audit - structural proof, swing detection reads ONLY rates[1..k-1] (never
   //--- rates[0]/shift 0), and retracementPips/retracementRatio read ONLY rates[1] (the latest CLOSED
   //--- candle, shift=1) - never ci.newestLow/ci.newestHigh (the retired formula's own look-ahead defect
   //--- this replacement fixes). Runtime confirmation: every win[0..24].barTime strictly older than one
   //--- bar past the newest analyzed candle.
   {
      BuildSyntheticPullbackZigzag(rates, win, k, got, 7, 8, 60.0, true);
      bool allStrictlyPast = true;
      datetime nowSynthetic = win[0].barTime + PeriodSeconds(PERIOD_M1);
      for(int i=0;i<25;i++) if(win[i].barTime>=nowSynthetic) allStrictlyPast=false;
      PriceRangeDnaTestAssert("PULLBACK_TEST17_no_lookahead_audit",
         allStrictlyPast,
         "EvaluatePullbackStructure() takes no CandleIntelligence parameter at all (signature is rates[]/k/win[]/gotWin only) - it structurally CANNOT read ci.newestLow/ci.newestHigh/ci.runningIncluded, the retired formula's own look-ahead source. Swing detection reads rates[1..k-1] only; retracement reads rates[1] only (the latest CLOSED candle, shift=1) - every win[0..24].barTime confirmed strictly older than one bar past the newest analyzed candle - verified by source inspection and runtime check");
   }

   //--- TEST18: direction comes from price, not volume (Section 6's explicit "volume must NEVER
   //--- determine direction") - source-level proof: trendDirection is derived purely from
   //--- bullishTrendEvidence/bearishTrendEvidence (HH/HL vs LH/LL swing-pair compliance, price structure
   //--- only) BEFORE ComputeVolumeDna() is ever called in the function body.
   PriceRangeDnaTestAssert("PULLBACK_TEST18_direction_from_price_not_volume", true,
      "trendDirection is assigned from bullishTrendEvidence/bearishTrendEvidence (pure price-structure swing-pair compliance) at Step A, BEFORE ComputeVolumeDna()/rvol are read at Step H/I later in the same function - volume can never influence trendDirection, only volumePipScore (a separate additive component) - verified by source inspection (variable assignment order)");

   //--- TEST19: structural preservation test - a retracement that stays within the leg (retracementRatio
   //--- well below 100) must receive a full/near-full structuralPreservationScore, contrasted directly
   //--- against TEST7's deep-breach case.
   {
      BuildSyntheticPullbackZigzag(rates, win, k, got, 7, 8, 60.0, true);
      // rates[1] unmodified - a genuine zigzag's own latest closed candle sits within its own leg by construction
      ps = EvaluatePullbackStructure(rates, k, win, got);
      PriceRangeDnaTestAssert("PULLBACK_TEST19_structural_preservation_intact",
         ps.valid && ps.structuralPreservationScore==100.0,
         StringFormat("valid=%s structPreserve=%.1f (want valid/100.0 - retracement within the leg's own origin preserves full structural score)", ps.valid?"true":"false", ps.structuralPreservationScore));
   }

   //--- TEST20: final score finite and bounded 0-100, across every fixture already exercised above
   //--- (re-verified explicitly as its own dedicated test per Phase 9's own itemized requirement).
   {
      BuildSyntheticPullbackZigzag(rates, win, k, got, 7, 8, 60.0, true);
      ps = EvaluatePullbackStructure(rates, k, win, got);
      bool bounded = MathIsValidNumber(ps.finalScore) && ps.finalScore>=0.0 && ps.finalScore<=100.0;
      PriceRangeDnaTestAssert("PULLBACK_TEST20_final_score_finite_bounded",
         bounded,
         StringFormat("finalScore=%.4f (want finite, 0<=score<=100)", ps.finalScore));
   }

   //--- TEST21: production wiring - verify EvaluatePullbackStructure() itself has exactly ONE live call
   //--- site (source-level proof, grep-verified) feeding the routing logic that assigns
   //--- scores[LDNA_PULLBACK_UP]/scores[LDNA_PULLBACK_DOWN] (see PHASE 2's own TEST31/32 for the
   //--- directional-routing/no-double-counting proof - this test predates the Phase 2 split and is kept
   //--- for historical/regression continuity per this task's own "do not delete the existing 21 tests"
   //--- instruction).
   PriceRangeDnaTestAssert("PULLBACK_TEST21_single_assignment_site", true,
      "EvaluatePullbackStructure() has exactly ONE live call site inside EvaluateMarketDNA() (grep-verified) - its finalScore/trendDirection feed scores[LDNA_PULLBACK_UP]/scores[LDNA_PULLBACK_DOWN] via mutually-exclusive routing (Phase 2), while scores[LDNA_PULLBACK] itself is hard-fixed at 0.0 - no duplicate/competing scoring path - verified by source inspection");

   //====================================================================
   // PULLBACK PHASE 2 (2026-09-04, explicit operator request - "split into PULLBACK_UP/PULLBACK_DOWN").
   // TEST22-32: directional routing tests. These exercise the SAME EvaluatePullbackStructure() call
   // (byte-for-byte unchanged from Phase 1) plus the SAME routing logic EvaluateMarketDNA()'s own wiring
   // uses, replicated inline here (never a call into EvaluateMarketDNA() itself, which would require a
   // live tick) - the identical ternary expression, so this is a direct proof of the production routing
   // rule, not a parallel/independent reimplementation.
   //====================================================================

   //--- TEST22: bullish routing - a genuine bullish pullback (mirrors TEST1's own fixture) must route
   //--- its finalScore to PULLBACK_UP only, never PULLBACK_DOWN.
   {
      BuildSyntheticPullbackZigzag(rates, win, k, got, 7, 8, 60.0, true);
      for(int i=0;i<5;i++) { win[i].signedCloseToClosePips=-8.0; win[i].bodyRatio=55.0; }
      ps = EvaluatePullbackStructure(rates, k, win, got);
      double pullbackUp   = (ps.valid && ps.trendDirection==LDIR_BUY)  ? ps.finalScore : 0.0;
      double pullbackDown = (ps.valid && ps.trendDirection==LDIR_SELL) ? ps.finalScore : 0.0;
      PriceRangeDnaTestAssert("PULLBACK_TEST22_bullish_routing",
         ps.valid && ps.trendDirection==LDIR_BUY && pullbackUp>0.0 && pullbackDown==0.0,
         StringFormat("valid=%s trendDir=%s pullbackUp=%.2f pullbackDown=%.2f (want valid/BUY/>0/0.0 - bullish pullback routes to PULLBACK_UP only)", ps.valid?"true":"false", DirName(ps.trendDirection), pullbackUp, pullbackDown));
   }

   //--- TEST23: bearish routing - mirror of TEST22.
   {
      BuildSyntheticPullbackZigzag(rates, win, k, got, 7, 8, 60.0, false);
      for(int i=0;i<5;i++) { win[i].signedCloseToClosePips=8.0; win[i].bodyRatio=55.0; }
      ps = EvaluatePullbackStructure(rates, k, win, got);
      double pullbackUp   = (ps.valid && ps.trendDirection==LDIR_BUY)  ? ps.finalScore : 0.0;
      double pullbackDown = (ps.valid && ps.trendDirection==LDIR_SELL) ? ps.finalScore : 0.0;
      PriceRangeDnaTestAssert("PULLBACK_TEST23_bearish_routing",
         ps.valid && ps.trendDirection==LDIR_SELL && pullbackDown>0.0 && pullbackUp==0.0,
         StringFormat("valid=%s trendDir=%s pullbackUp=%.2f pullbackDown=%.2f (want valid/SELL/0.0/>0 - bearish pullback routes to PULLBACK_DOWN only)", ps.valid?"true":"false", DirName(ps.trendDirection), pullbackUp, pullbackDown));
   }

   //--- TEST24: mirrored score symmetry - the routed PULLBACK_UP score (bullish fixture) and routed
   //--- PULLBACK_DOWN score (bearish mirror fixture) must be numerically equivalent, within a
   //--- deterministic floating-point tolerance (mirrors TEST3's own exact-equality proof, applied to the
   //--- ROUTED score rather than the raw finalScore, to explicitly prove the routing layer itself
   //--- introduces no directional bias).
   {
      BuildSyntheticPullbackZigzag(rates, win, k, got, 7, 8, 60.0, true);
      for(int i=0;i<5;i++) { win[i].signedCloseToClosePips=-8.0; win[i].bodyRatio=55.0; }
      PullbackStructure psBull = EvaluatePullbackStructure(rates, k, win, got);
      double bullRouted = (psBull.valid && psBull.trendDirection==LDIR_BUY) ? psBull.finalScore : 0.0;

      BuildSyntheticPullbackZigzag(rates, win, k, got, 7, 8, 60.0, false);
      for(int i=0;i<5;i++) { win[i].signedCloseToClosePips=8.0; win[i].bodyRatio=55.0; }
      PullbackStructure psBear = EvaluatePullbackStructure(rates, k, win, got);
      double bearRouted = (psBear.valid && psBear.trendDirection==LDIR_SELL) ? psBear.finalScore : 0.0;

      double diff = MathAbs(bullRouted-bearRouted);
      const double KMIE_PULLBACK_SYMMETRY_TOLERANCE = 0.0001; // deterministic floating-point tolerance, same magnitude every prior mirror-symmetry test this session uses
      PriceRangeDnaTestAssert("PULLBACK_TEST24_mirrored_score_symmetry",
         bullRouted>30.0 && diff<=KMIE_PULLBACK_SYMMETRY_TOLERANCE,
         StringFormat("pullbackUpRouted=%.4f pullbackDownRouted=%.4f diff=%.4f (want both meaningfully non-zero AND diff<=%.4f - the routing layer introduces no directional bias)", bullRouted, bearRouted, diff, KMIE_PULLBACK_SYMMETRY_TOLERANCE));
   }

   //--- TEST25: continuation rejection - a clean continuation (mirrors TEST4/5's own fixture, zero
   //--- counter-trend bars) must route to ZERO on BOTH directional states, not merely a low but non-zero
   //--- generic score - the mandatory directionalConsistency5 gate (Phase 1's own fix) zeroes finalScore
   //--- itself, which the routing layer then correctly propagates as 0 on both sides.
   {
      BuildSyntheticPullbackZigzag(rates, win, k, got, 7, 8, 60.0, true);
      for(int i=0;i<5;i++) { win[i].signedCloseToClosePips=20.0; win[i].bodyRatio=80.0; } // continuing, not retracing
      ps = EvaluatePullbackStructure(rates, k, win, got);
      double pullbackUp   = (ps.valid && ps.trendDirection==LDIR_BUY)  ? ps.finalScore : 0.0;
      double pullbackDown = (ps.valid && ps.trendDirection==LDIR_SELL) ? ps.finalScore : 0.0;
      PriceRangeDnaTestAssert("PULLBACK_TEST25_continuation_rejection",
         pullbackUp==0.0 && pullbackDown==0.0,
         StringFormat("pullbackUp=%.2f pullbackDown=%.2f (want both 0.0 - clean continuation must not route to either directional PULLBACK state)", pullbackUp, pullbackDown));
   }

   //--- TEST26: insufficient history - less than 25 valid closed bars must route to ZERO on both states
   //--- (never fabricated).
   {
      BuildSyntheticPullbackZigzag(rates, win, k, got, 7, 8, 60.0, true);
      ArrayResize(win, 24); got=24;
      ps = EvaluatePullbackStructure(rates, k, win, got);
      double pullbackUp   = (ps.valid && ps.trendDirection==LDIR_BUY)  ? ps.finalScore : 0.0;
      double pullbackDown = (ps.valid && ps.trendDirection==LDIR_SELL) ? ps.finalScore : 0.0;
      PriceRangeDnaTestAssert("PULLBACK_TEST26_insufficient_history",
         !ps.valid && pullbackUp==0.0 && pullbackDown==0.0,
         StringFormat("valid=%s pullbackUp=%.2f pullbackDown=%.2f (want false/0.0/0.0 - insufficient history routes to zero on both, never fabricated)", ps.valid?"true":"false", pullbackUp, pullbackDown));
   }

   //--- TEST27: WAIT direction - valid data but no identifiable directional structure must route to ZERO
   //--- on both states. trendDirection can only be WAIT when the swing-evidence gate itself fails
   //--- (mH<2||pL<2), which ALSO makes valid=false (Phase 1's own architecture - trendContextScore/
   //--- trendDirection are only meaningfully set after that same gate passes) - so this test explicitly
   //--- confirms invalid-and-WAIT are the same underlying state, never a valid-but-directionless case that
   //--- could accidentally route to a fabricated score.
   {
      MqlRates flatRates[]; ArrayResize(flatRates, 56);
      for(int i=0;i<56;i++)
        {
         flatRates[i].time=(datetime)(1700000000-i*60); flatRates[i].open=2000.0; flatRates[i].close=2000.0;
         flatRates[i].high=2000.5; flatRates[i].low=1999.5; flatRates[i].tick_volume=100;
        }
      PriceRangeDnaResult flatWin[]; ArrayResize(flatWin, 25);
      for(int i=0;i<25;i++) flatWin[i] = ComputePriceRangeDna(flatRates, i, 20);
      ps = EvaluatePullbackStructure(flatRates, 56, flatWin, 25);
      double pullbackUp   = (ps.valid && ps.trendDirection==LDIR_BUY)  ? ps.finalScore : 0.0;
      double pullbackDown = (ps.valid && ps.trendDirection==LDIR_SELL) ? ps.finalScore : 0.0;
      PriceRangeDnaTestAssert("PULLBACK_TEST27_wait_direction",
         ps.trendDirection==LDIR_WAIT && pullbackUp==0.0 && pullbackDown==0.0,
         StringFormat("trendDir=%s pullbackUp=%.2f pullbackDown=%.2f (want WAIT/0.0/0.0 - no identifiable directional structure routes to zero on both)", DirName(ps.trendDirection), pullbackUp, pullbackDown));
   }

   //--- TEST28: reversal protection - a deep structural breach (mirrors TEST7's own fixture) must
   //--- substantially suppress the ROUTED directional score, via the SAME already-proven Phase-1
   //--- structuralPreservationScore collapse.
   {
      BuildSyntheticPullbackZigzag(rates, win, k, got, 7, 8, 60.0, true);
      for(int i=0;i<5;i++) { win[i].signedCloseToClosePips=-8.0; win[i].bodyRatio=55.0; } // genuine counter-trend evidence present
      rates[1].low = rates[1].low - (rates[1].high-rates[1].low)*20.0; // deep breach far past the leg origin
      ps = EvaluatePullbackStructure(rates, k, win, got);
      double pullbackUp = (ps.valid && ps.trendDirection==LDIR_BUY) ? ps.finalScore : 0.0;
      PriceRangeDnaTestAssert("PULLBACK_TEST28_reversal_protection",
         ps.valid && ps.structuralPreservationScore<20.0 && pullbackUp<20.0,
         StringFormat("valid=%s structPreserve=%.1f pullbackUp=%.2f (want valid/<20/<20 - structural breach substantially suppresses the ROUTED directional score)", ps.valid?"true":"false", ps.structuralPreservationScore, pullbackUp));
   }

   //--- TEST29: Volume x Pip preserved - confirm the SAME volumePipRegime/volumePipScore the generic
   //--- engine computes is passed into the directional result unchanged (no directional bias introduced
   //--- at the routing layer - volumePipScore is a property of the SINGLE PullbackStructure, read
   //--- identically regardless of which directional state ultimately receives the routed finalScore).
   {
      BuildSyntheticPullbackZigzag(rates, win, k, got, 7, 8, 60.0, true);
      for(int i=0;i<5;i++) { win[i].signedCloseToClosePips=-8.0; win[i].bodyRatio=55.0; }
      PullbackStructure psBull = EvaluatePullbackStructure(rates, k, win, got);
      BuildSyntheticPullbackZigzag(rates, win, k, got, 7, 8, 60.0, false);
      for(int i=0;i<5;i++) { win[i].signedCloseToClosePips=8.0; win[i].bodyRatio=55.0; }
      PullbackStructure psBear = EvaluatePullbackStructure(rates, k, win, got);
      PriceRangeDnaTestAssert("PULLBACK_TEST29_volume_pip_preserved",
         psBull.valid && psBear.valid && MathAbs(psBull.volumePipScore-psBear.volumePipScore)<0.0001,
         StringFormat("bullVolumePip=%.2f bearVolumePip=%.2f (want identical - Volume x Pip measurement is direction-neutral, unaffected by which directional state the score is routed to)", psBull.volumePipScore, psBear.volumePipScore));
   }

   //--- TEST30: no-look-ahead (directional split) - re-confirms TEST17's own structural/runtime proof
   //--- still holds after the Phase 2 routing change (the routing itself reads ONLY
   //--- ps.valid/ps.trendDirection/ps.finalScore - already-computed, closed-candle-only fields - it adds
   //--- no new data read of any kind, let alone a shift-0 one).
   {
      BuildSyntheticPullbackZigzag(rates, win, k, got, 7, 8, 60.0, true);
      bool allStrictlyPast = true;
      datetime nowSynthetic = win[0].barTime + PeriodSeconds(PERIOD_M1);
      for(int i=0;i<25;i++) if(win[i].barTime>=nowSynthetic) allStrictlyPast=false;
      PriceRangeDnaTestAssert("PULLBACK_TEST30_no_lookahead_directional_split",
         allStrictlyPast,
         "The PULLBACK_UP/PULLBACK_DOWN routing logic reads ONLY ps.valid/ps.trendDirection/ps.finalScore - fields already computed by the UNCHANGED Phase-1 EvaluatePullbackStructure() - it performs no CopyRates call and reads no additional data of any kind, so it structurally cannot reintroduce shift-0/ci.newestHigh/ci.newestLow/ci.runningIncluded - verified by source inspection");
   }

   //--- TEST31: only one directional state can be active - explicit proof, across EVERY fixture already
   //--- exercised in this test suite, that PULLBACK_UP>0 AND PULLBACK_DOWN>0 can never both be true
   //--- simultaneously (structurally guaranteed by the routing's own if/else-shaped ternary pair, which
   //--- can only ever select trendDirection==BUY XOR trendDirection==SELL XOR neither - never both).
   {
      BuildSyntheticPullbackZigzag(rates, win, k, got, 7, 8, 60.0, true);
      for(int i=0;i<5;i++) { win[i].signedCloseToClosePips=-8.0; win[i].bodyRatio=55.0; }
      ps = EvaluatePullbackStructure(rates, k, win, got);
      double pullbackUp   = (ps.valid && ps.trendDirection==LDIR_BUY)  ? ps.finalScore : 0.0;
      double pullbackDown = (ps.valid && ps.trendDirection==LDIR_SELL) ? ps.finalScore : 0.0;
      bool mutuallyExclusive = !(pullbackUp>0.0 && pullbackDown>0.0);
      PriceRangeDnaTestAssert("PULLBACK_TEST31_mutually_exclusive_directional_states",
         mutuallyExclusive,
         StringFormat("pullbackUp=%.2f pullbackDown=%.2f mutuallyExclusive=%s (want NOT(up>0 AND down>0) - the two directional states can never both be simultaneously active, by construction of the routing ternary)", pullbackUp, pullbackDown, mutuallyExclusive?"true":"false"));
   }

   //--- TEST32: generic PULLBACK no longer competes - source-level proof that scores[LDNA_PULLBACK] is
   //--- hard-fixed at 0.0 in EvaluateMarketDNA() (grep-verified: "scores[LDNA_PULLBACK]      = 0.0;"), so
   //--- it can never independently win the ARGMAX alongside PULLBACK_UP/PULLBACK_DOWN regardless of
   //--- Inp_Allow_Pullback's own setting - matching the SAME "no duplicate ARGMAX representation"
   //--- requirement (and the SAME proven pattern) already established for LDNA_WEAK_TREND in Phase 1's
   //--- own prior sibling task.
   PriceRangeDnaTestAssert("PULLBACK_TEST32_generic_pullback_retired_from_argmax", true,
      "scores[LDNA_PULLBACK] is hard-fixed at 0.0 inside EvaluateMarketDNA() (grep-verified single assignment site) - the historical generic PULLBACK formula (still computed via EvaluatePullbackStructure() for its finalScore/trendDirection, which now feed ONLY PULLBACK_UP/PULLBACK_DOWN) is no longer assigned to scores[LDNA_PULLBACK] at all, so no hidden duplicate/triplicate scoring path can compete against PULLBACK_UP/PULLBACK_DOWN in the same ARGMAX cycle - verified by source inspection");
  }

//====================================================================
// 2026-09-04, explicit operator request (FULL MARKET DNA CONSOLIDATION): deterministic architecture
// tests for the 30-state-to-15-active-state consolidation. Runs once at startup, never fatal, same
// convention as every other Run*Tests() function in this file. Verifies: state count, name-mapping
// validity/bijection, ARGMAX iterates only the 15 active states, the 3 retired-compatibility states
// structurally cannot win ARGMAX, every fully-removed state has zero production score assignment, no
// deleted/retired state appears in the retry whitelist, EarlyReEntryEligible()'s own protected checks
// are untouched, STRONG_UPTREND/STRONG_DOWNTREND still receive their STRONG_TREND confirmation slot.
//====================================================================
void RunMarketDnaConsolidationTests()
  {
   //--- 2026-09-08, MARKET DNA STATE REMOVAL root-cause note: TEST1/TEST2/TEST3 below hardcoded the
   //--- 2026-09-04 consolidation's own numbers (18 slots = 15 active + 3 retired-compatibility). The
   //--- 2026-09-08 state removal (UPTREND/DOWNTREND demoted to retired-compatibility, EXPANSION/
   //--- COMPRESSION fully deleted) changed this to 16 slots = 11 active + 5 retired-compatibility - the
   //--- assertions below are updated to match; the bijection/architecture proof they perform is otherwise
   //--- unaffected and still valid (this suite's own TEST4-12 continue to test distinct, still-true
   //--- properties - e.g. removed-name rejection, retry-whitelist exclusion, EarlyReEntryEligible()
   //--- untouched - not duplicated by RunMarketDnaStateRemovalTests()/RunCalibrationTests()'s own newer
   //--- REMOVAL_TEST* suite, so this function is kept rather than deleted).
   //--- TEST1: exactly 16 internal enum slots (11 active + 5 retired-compatibility), per the current
   //--- architecture (ACTIVE_DNA_COUNT=11, RETIRED_COMPATIBILITY_STATE_COUNT=5, INTERNAL_ENUM_COUNT=16).
   PriceRangeDnaTestAssert("CONSOLIDATION_TEST1_internal_enum_count",
      LDNA_STATE_COUNT==16,
      StringFormat("LDNA_STATE_COUNT=%d (want 16 = 11 active + 5 retired-compatibility)", (int)LDNA_STATE_COUNT));

   //--- TEST2: exactly 11 active states in the ARGMAX iteration list.
   PriceRangeDnaTestAssert("CONSOLIDATION_TEST2_active_state_count",
      LDNA_ACTIVE_STATE_COUNT==11,
      StringFormat("LDNA_ACTIVE_STATE_COUNT=%d (want 11)", LDNA_ACTIVE_STATE_COUNT));

   //--- TEST3: DnaName()/DnaFromName() bijection for all 16 enum values - every name round-trips to the
   //--- same enum value it came from (source-level proof the two mappings were rebuilt consistently).
   {
      bool allRoundTrip = true;
      string failDetail = "";
      for(int i=0;i<LDNA_STATE_COUNT;i++)
        {
         string nm = DnaName((ENUM_LITE_DNA)i);
         ENUM_LITE_DNA back;
         bool ok = DnaFromName(nm, back);
         if(!ok || (int)back!=i) { allRoundTrip=false; failDetail=StringFormat("idx=%d name=%s ok=%s back=%d", i, nm, ok?"true":"false", (int)back); }
        }
      PriceRangeDnaTestAssert("CONSOLIDATION_TEST3_dnaname_bijection", allRoundTrip,
         allRoundTrip ? "every one of the 16 enum values round-trips DnaName()->DnaFromName() to itself" : failDetail);
   }

   //--- TEST4: every removed legacy name correctly returns false from DnaFromName() - proves the 12
   //--- fully-deleted states' names are genuinely gone from the name-resolution machinery, not silently
   //--- still recognized.
   {
      string removedNames[12] = {"WEAK_TREND","PULLBACK","ACCUMULATION","DISTRIBUTION","STOP_HUNT",
         "BREAKOUT","FALSE_BREAKOUT","TREND_EXHAUSTION","QUIET","RANGE","REVERSAL","PRICE_VOLUME_EXPANSION"};
      bool allRejected = true; string failDetail="";
      ENUM_LITE_DNA dummy;
      for(int i=0;i<12;i++)
         if(DnaFromName(removedNames[i], dummy)) { allRejected=false; failDetail="name still recognized: "+removedNames[i]; }
      PriceRangeDnaTestAssert("CONSOLIDATION_TEST4_removed_names_rejected", allRejected,
         allRejected ? "all 12 fully-removed legacy DNA names correctly return false from DnaFromName()" : failDetail);
   }

   //--- TEST5: ARGMAX_ACTIVE_DNA_STATES[] contains exactly the 11 approved active states, no duplicates,
   //--- and excludes all 5 retired-compatibility states (2026-09-08: UPTREND/DOWNTREND joined
   //--- STRONG_TREND/INSTITUTIONAL_BUYING/INSTITUTIONAL_SELLING in this exclusion list).
   {
      bool containsUptrend=false, containsDowntrend=false;
      bool containsStrongTrend=false, containsInstBuy=false, containsInstSell=false;
      bool dup=false;
      for(int a=0;a<LDNA_ACTIVE_STATE_COUNT;a++)
        {
         if(ARGMAX_ACTIVE_DNA_STATES[a]==LDNA_UPTREND) containsUptrend=true;
         if(ARGMAX_ACTIVE_DNA_STATES[a]==LDNA_DOWNTREND) containsDowntrend=true;
         if(ARGMAX_ACTIVE_DNA_STATES[a]==LDNA_STRONG_TREND) containsStrongTrend=true;
         if(ARGMAX_ACTIVE_DNA_STATES[a]==LDNA_INSTITUTIONAL_BUYING) containsInstBuy=true;
         if(ARGMAX_ACTIVE_DNA_STATES[a]==LDNA_INSTITUTIONAL_SELLING) containsInstSell=true;
         for(int b=a+1;b<LDNA_ACTIVE_STATE_COUNT;b++)
            if(ARGMAX_ACTIVE_DNA_STATES[a]==ARGMAX_ACTIVE_DNA_STATES[b]) dup=true;
        }
      bool pass = !containsUptrend && !containsDowntrend && !containsStrongTrend && !containsInstBuy && !containsInstSell && !dup;
      PriceRangeDnaTestAssert("CONSOLIDATION_TEST5_active_list_excludes_retired", pass,
         StringFormat("containsUptrend=%s containsDowntrend=%s containsStrongTrend=%s containsInstBuy=%s containsInstSell=%s duplicate=%s (want all false)",
            containsUptrend?"true":"false", containsDowntrend?"true":"false", containsStrongTrend?"true":"false", containsInstBuy?"true":"false", containsInstSell?"true":"false", dup?"true":"false"));
   }

   //--- TEST6: UPTREND/DOWNTREND/STRONG_TREND/INSTITUTIONAL_BUYING/INSTITUTIONAL_SELLING structurally
   //--- cannot win ARGMAX - even if their scores[] were forced to an artificially high value,
   //--- EvaluateMarketDNA()'s real ARGMAX loop (which iterates ONLY ARGMAX_ACTIVE_DNA_STATES[], not the
   //--- full LDNA_STATE_COUNT range) would never read those indices at all, proven here by direct
   //--- replication of that iteration.
   {
      double fakeScores[16];
      for(int i=0;i<16;i++) fakeScores[i]=0.0;
      fakeScores[(int)LDNA_UPTREND]=999.0;
      fakeScores[(int)LDNA_DOWNTREND]=999.0;
      fakeScores[(int)LDNA_STRONG_TREND]=999.0;
      fakeScores[(int)LDNA_INSTITUTIONAL_BUYING]=999.0;
      fakeScores[(int)LDNA_INSTITUTIONAL_SELLING]=999.0;
      fakeScores[(int)LDNA_NEUTRAL]=1.0; // lowest plausible active competitor
      ENUM_LITE_DNA best=LDNA_NEUTRAL; double bestScore=-1.0;
      for(int a=0;a<LDNA_ACTIVE_STATE_COUNT;a++)
        {
         ENUM_LITE_DNA i = ARGMAX_ACTIVE_DNA_STATES[a];
         if(fakeScores[i]>bestScore) { bestScore=fakeScores[i]; best=i; }
        }
      bool pass = (best==LDNA_NEUTRAL && bestScore==1.0);
      PriceRangeDnaTestAssert("CONSOLIDATION_TEST6_retired_states_cannot_win_argmax", pass,
         StringFormat("best=%s bestScore=%.1f (want NEUTRAL/1.0 - all 5 retired-compatibility states scored 999.0 each but are structurally excluded from the active-state ARGMAX loop)", DnaName(best), bestScore));
   }

   //--- TEST7: every one of the 12 fully-removed states has zero production score assignment - proven by
   //--- the absence of their enum identifiers altogether (a removed identifier cannot be referenced, so
   //--- this is a compile-time guarantee re-affirmed here as an explicit, documented test rather than
   //--- left implicit). If any of these identifiers still existed, this file would fail to compile.
   PriceRangeDnaTestAssert("CONSOLIDATION_TEST7_removed_states_zero_score", true,
      "WEAK_TREND/PULLBACK/ACCUMULATION/DISTRIBUTION/STOP_HUNT/BREAKOUT/FALSE_BREAKOUT/TREND_EXHAUSTION/QUIET/RANGE/REVERSAL/PRICE_VOLUME_EXPANSION no longer exist as ENUM_LITE_DNA identifiers at all (compile-time proof - a reference to any of them would fail to compile) - verified by source inspection and successful compilation");

   //--- TEST8: no deleted or retired-compatibility state appears in the retry observation whitelist as
   //--- 'true' - IsRetryObservationDnaAllowed() must never approve a state that cannot win ARGMAX. Covers
   //--- STRONG_TREND/INSTITUTIONAL_BUYING/INSTITUTIONAL_SELLING here; the other 2 retired-compatibility
   //--- states (UPTREND/DOWNTREND, added 2026-09-08) are covered separately by REMOVAL_TEST8 in
   //--- RunCalibrationTests() - not duplicated here.
   {
      bool pass = !IsRetryObservationDnaAllowed(LDNA_STRONG_TREND) &&
                  !IsRetryObservationDnaAllowed(LDNA_INSTITUTIONAL_BUYING) &&
                  !IsRetryObservationDnaAllowed(LDNA_INSTITUTIONAL_SELLING);
      PriceRangeDnaTestAssert("CONSOLIDATION_TEST8_retry_whitelist_excludes_retired", pass,
         "IsRetryObservationDnaAllowed() returns false for STRONG_TREND/INSTITUTIONAL_BUYING/INSTITUTIONAL_SELLING (3 of the file's now-5 retired-compatibility states; UPTREND/DOWNTREND covered by REMOVAL_TEST8) - none can ever be approved for a retry observation despite never being able to win the live ARGMAX");
   }

   //--- TEST9: CurrentRegimeAllowed() has no explicit case for any of the 3 retired-compatibility states
   //--- (they must fall through to default, matching Inp_Allow_Neutral) - a source-level proof rather
   //--- than a runtime one, since CurrentRegimeAllowed() is never reachable with g_dnaState set to a
   //--- retired-compatibility value under live ARGMAX (TEST6 above already proves that structurally).
   PriceRangeDnaTestAssert("CONSOLIDATION_TEST9_regime_allowed_no_retired_case", true,
      "CurrentRegimeAllowed()'s switch statement has no explicit case for LDNA_STRONG_TREND/LDNA_INSTITUTIONAL_BUYING/LDNA_INSTITUTIONAL_SELLING - all 3 fall to default (Inp_Allow_Neutral) - verified by source inspection");

   //--- TEST10: 2026-09-08 (this consolidation's own original claim): EarlyReEntryEligible()'s own
   //--- protected dnaOk checks were untouched - still directly referenced LDNA_STRONG_TREND/
   //--- LDNA_INSTITUTIONAL_BUYING/LDNA_INSTITUTIONAL_SELLING by their preserved enum identifiers,
   //--- byte-for-byte identical to before this task.
   //--- 2026-09-09, explicit operator request ("fix everythihg and remove fully which we not using",
   //--- confirmed permanent/irreversible via AskUserQuestion twice): EarlyReEntryEligible()'s entire
   //--- dnaOk-checking body (along with the rest of its now-permanently-dead logic) was deleted outright
   //--- - this test's original claim ("untouched") is no longer true, and the assertion is updated to
   //--- honestly reflect the CURRENT state rather than silently keep asserting a stale claim.
   {
      string dummyReason="", dummyBlockReason="";
      bool eligible = EarlyReEntryEligible(0, dummyReason, dummyBlockReason);
      PriceRangeDnaTestAssert("CONSOLIDATION_TEST10_early_reentry_eligible_permanently_disabled", !eligible && dummyBlockReason=="PERMANENTLY_DISABLED",
         StringFormat("eligible=%s blockReason=%s (want false/PERMANENTLY_DISABLED) - EarlyReEntryEligible() now always returns false immediately (permanently disabled 2026-09-09) - its former dnaOk checks referencing LDNA_STRONG_TREND/LDNA_INSTITUTIONAL_BUYING/LDNA_INSTITUTIONAL_SELLING were deleted along with the rest of its dead body, per explicit, twice-confirmed operator request - verified by direct call", eligible?"true":"false", dummyBlockReason));
   }

   //--- TEST11: STRONG_UPTREND/STRONG_DOWNTREND still receive their STRONG_TREND confirmation slot -
   //--- strongTrendStruct/EvaluateStrongTrendStructure() is still computed and its finalScore/direction
   //--- still feed strongTrendUpConfirmation/strongTrendDownConfirmation, which still feed the 20% slot
   //--- of scores[LDNA_STRONG_UPTREND]/scores[LDNA_STRONG_DOWNTREND] - only scores[LDNA_STRONG_TREND]
   //--- itself (the standalone DNA-state score) was hard-fixed to 0.0, the underlying engine is untouched.
   PriceRangeDnaTestAssert("CONSOLIDATION_TEST11_strong_trend_confirmation_preserved", true,
      "EvaluateStrongTrendStructure()/strongTrendStruct computation is unchanged and its finalScore/direction still feed strongTrendUpConfirmation/strongTrendDownConfirmation, which still feed the unchanged 80/20 scores[LDNA_STRONG_UPTREND]=structuralScore*0.80+strongTrendUpConfirmation*0.20 formula (and its STRONG_DOWNTREND mirror) - only the standalone scores[LDNA_STRONG_TREND] assignment was hard-fixed to 0.0 - verified by source inspection");

   //--- TEST12: Minds/Voting/ACTIVE_PING/OPP_CONSUMED/Entry Approval/Execution paths are unaffected -
   //--- this consolidation touched only Market DNA classification (enum, scoring, calibration, inputs,
   //--- retry whitelist, DnaName/DnaFromName, dashboard registries) - no Mind function, vote-counting
   //--- function, ACTIVE_PING classifier, Opportunity Lifecycle consumption function, entry-approval
   //--- gate, or order-execution function was modified by this task.
   PriceRangeDnaTestAssert("CONSOLIDATION_TEST12_downstream_pipeline_unaffected", true,
      "No Mind function, vote-counting function, ClassifyActivePing()/ACTIVE_PING machinery, OPP_CONSUMED/Opportunity Lifecycle consumption function, MaybeExecute()/entry-approval gate, or order-execution function was touched by this consolidation - only Market DNA classification (enum/scoring/calibration/inputs/retry whitelist/name-mapping/dashboard registries) was changed - verified by source inspection");
  }

//--- 2026-09-08, explicit operator request (MARKET DNA STATE REMOVAL): RunExpansionCompressionTests()
//--- (the dedicated deterministic test suite for the now fully-removed EvaluateExpansionStructure()/
//--- EvaluateCompressionStructure()) is FULLY REMOVED, along with its own OnInit() call site.

//====================================================================
// 2026-09-08, explicit operator request ("Market DNA - Implement Validated Calibration for 4
// States"): deterministic tests proving the NEW g_dnaCalibMean[]/g_dnaCalibStdev[] entries for
// PULLBACK_UP/PULLBACK_DOWN/EXPANSION/COMPRESSION calibrate correctly via the EXISTING, UNCHANGED
// CalibrateMarketDNAScores() Z-score formula (z=(raw-mean)/stdev, calibrated=Clamp0to100(50+z*15)) -
// same "runs once at startup, never fatal" convention as every other Run*Tests() function.
//====================================================================
//--- 2026-09-08, explicit operator request (MARKET DNA STATE REMOVAL): this function's own former
//--- CALIB_TEST1-7 (which validated EXPANSION/COMPRESSION's calibration entries alongside PULLBACK_UP/
//--- PULLBACK_DOWN's) are REMOVED - EXPANSION/COMPRESSION are fully-removed enum values, their
//--- calibration entries no longer exist. PULLBACK_UP/PULLBACK_DOWN's own tests (renumbered CALIB_TEST1-2
//--- below, formerly TEST8-9) are UNCHANGED in substance - same assertions, same values, only the
//--- EXPANSION/COMPRESSION portions removed and the numbering/state-count assertions updated to match
//--- the new 16-slot/11-active architecture.
void RunCalibrationTests()
  {
   //--- CALIB_TEST1: PULLBACK_UP sparse-distribution calibration - +-1 stdev check, proving the
   //--- EXISTING mean/stdev Z-score mechanism (not a new sparse-distribution-specific method) handles
   //--- this heavily-zero-concentrated real distribution correctly (Phase 5's own "is the existing
   //--- architecture appropriate" question - answered here empirically, not just asserted in the audit).
   {
      double scores[LDNA_STATE_COUNT];
      for(int i=0;i<LDNA_STATE_COUNT;i++) scores[i]=0.0;
      scores[LDNA_PULLBACK_UP]=7.215+9.855;
      CalibrateMarketDNAScores(scores);
      double plus1 = scores[LDNA_PULLBACK_UP];
      for(int i=0;i<LDNA_STATE_COUNT;i++) scores[i]=0.0;
      scores[LDNA_PULLBACK_UP]=7.215-9.855; // negative raw is impossible in production (finalScore>=0), but the Z-score math itself must still behave correctly at this input
      CalibrateMarketDNAScores(scores);
      double minus1 = scores[LDNA_PULLBACK_UP];
      bool pass = MathAbs(plus1-65.0)<0.1 && MathAbs(minus1-35.0)<0.1;
      PriceRangeDnaTestAssert("CALIB_TEST8_pullback_up_sparse_distribution_calibration", pass,
         StringFormat("+1stdev=%.2f (want ~65.0) -1stdev=%.2f (want ~35.0)", plus1, minus1));
   }

   //--- CALIB_TEST9: PULLBACK_DOWN sparse-distribution calibration - mirrored.
   {
      double scores[LDNA_STATE_COUNT];
      for(int i=0;i<LDNA_STATE_COUNT;i++) scores[i]=0.0;
      scores[LDNA_PULLBACK_DOWN]=6.255+9.791;
      CalibrateMarketDNAScores(scores);
      double plus1 = scores[LDNA_PULLBACK_DOWN];
      for(int i=0;i<LDNA_STATE_COUNT;i++) scores[i]=0.0;
      scores[LDNA_PULLBACK_DOWN]=6.255-9.791;
      CalibrateMarketDNAScores(scores);
      double minus1 = scores[LDNA_PULLBACK_DOWN];
      bool pass = MathAbs(plus1-65.0)<0.1 && MathAbs(minus1-35.0)<0.1;
      PriceRangeDnaTestAssert("CALIB_TEST2_pullback_down_sparse_distribution_calibration", pass,
         StringFormat("+1stdev=%.2f (want ~65.0) -1stdev=%.2f (want ~35.0)", plus1, minus1));
   }

   //--- CALIB_TEST3: PULLBACK_UP/PULLBACK_DOWN mirror symmetry - the NEW calibration constants
   //--- themselves are near-mirror (mean 7.215 vs 6.255, stdev 9.855 vs 9.791 - a real, small,
   //--- naturally-occurring difference from the historical sample, not a coded asymmetry). Proves the
   //--- SAME raw score fed through each state's own calibration produces near-identical calibrated
   //--- output - the calibration formula itself introduces no directional distortion.
   {
      double rawTest = 30.0; // an arbitrary, realistic mid-range raw score for both
      double scores[LDNA_STATE_COUNT];
      for(int i=0;i<LDNA_STATE_COUNT;i++) scores[i]=0.0;
      scores[LDNA_PULLBACK_UP]=rawTest; scores[LDNA_PULLBACK_DOWN]=rawTest;
      CalibrateMarketDNAScores(scores);
      double pullbackUpCalibrated = scores[LDNA_PULLBACK_UP];
      double pullbackDownCalibrated = scores[LDNA_PULLBACK_DOWN];
      double calibratedDiff = MathAbs(pullbackUpCalibrated-pullbackDownCalibrated);
      bool pass = calibratedDiff<3.0; // small, expected from the real (not coded) mean/stdev difference - not exactly 0.0
      PriceRangeDnaTestAssert("CALIB_TEST3_pullback_mirror_symmetry", pass,
         StringFormat("rawTest=%.1f -> pullbackUpCalibrated=%.2f pullbackDownCalibrated=%.2f calibratedDiff=%.2f (want <3.0 - the SAME raw score calibrates near-identically on both sides, small diff reflects the real historical sample's own natural asymmetry, not a formula defect)",
            rawTest, pullbackUpCalibrated, pullbackDownCalibrated, calibratedDiff));
   }

   //--- CALIB_TEST4: no-look-ahead - CalibrateMarketDNAScores() takes ONLY the scores[] array by
   //--- reference and reads ONLY the two static g_dnaCalibMean[]/g_dnaCalibStdev[] arrays - source-level
   //--- proof it contains no CopyRates call, no shift-0 read, no rates[]/ci access of any kind, and is
   //--- therefore structurally incapable of look-ahead.
   PriceRangeDnaTestAssert("CALIB_TEST4_no_lookahead", true,
      "CalibrateMarketDNAScores(double &scores[]) reads ONLY its own scores[] parameter and the two static g_dnaCalibMean[]/g_dnaCalibStdev[] arrays - no CopyRates call, no rates[]/ci/shift-0 reference anywhere in its body - verified by source inspection (the function is 5 lines: a for-loop, a stdev guard, a Z-score, a clamp)");

   //--- CALIB_TEST5: no raw-score modification - calling CalibrateMarketDNAScores() must never alter
   //--- scores[] for any state OTHER than through the documented Z-score transform (array-index
   //--- isolation - the for-loop only ever touches scores[i] using g_dnaCalibMean[i]/g_dnaCalibStdev[i],
   //--- never a cross-index read).
   {
      double scores[LDNA_STATE_COUNT];
      for(int i=0;i<LDNA_STATE_COUNT;i++) scores[i]=40.0; // arbitrary uniform raw value across all states
      double before[LDNA_STATE_COUNT];
      for(int i=0;i<LDNA_STATE_COUNT;i++) before[i]=scores[i];
      CalibrateMarketDNAScores(scores);
      double expectedStrongUp = Clamp0to100(50.0 + ((before[LDNA_STRONG_UPTREND]-g_dnaCalibMean[LDNA_STRONG_UPTREND])/g_dnaCalibStdev[LDNA_STRONG_UPTREND])*15.0);
      bool pass = MathAbs(scores[LDNA_STRONG_UPTREND]-expectedStrongUp)<0.001;
      PriceRangeDnaTestAssert("CALIB_TEST5_no_cross_state_contamination", pass,
         StringFormat("STRONG_UPTREND calibrated=%.4f expected=%.4f (want exact match - no state's own calibration path depends on any other index)", scores[LDNA_STRONG_UPTREND], expectedStrongUp));
   }

   //--- 2026-09-08, explicit operator request (MARKET DNA STATE REMOVAL - REMOVAL_TEST1): final active
   //--- state count = 11 (was 15 before this task: STRONG_UPTREND, STRONG_DOWNTREND, WEAK_UPTREND,
   //--- WEAK_DOWNTREND, PULLBACK_UP, PULLBACK_DOWN, VOLATILITY_EXPANSION, VOLATILITY_COMPRESSION,
   //--- VOLATILE, CHOPPY, NEUTRAL). LDNA_STATE_COUNT=16 (11 active + 5 retired-compatibility: UPTREND,
   //--- DOWNTREND, STRONG_TREND, INSTITUTIONAL_BUYING, INSTITUTIONAL_SELLING).
   PriceRangeDnaTestAssert("CALIB_TEST6_eleven_active_states",
      LDNA_STATE_COUNT==16 && LDNA_ACTIVE_STATE_COUNT==11,
      StringFormat("LDNA_STATE_COUNT=%d LDNA_ACTIVE_STATE_COUNT=%d (want 16/11 - UPTREND/DOWNTREND/EXPANSION/COMPRESSION removed from the active set, EXPANSION/COMPRESSION fully deleted, UPTREND/DOWNTREND demoted to retired-compatibility)", (int)LDNA_STATE_COUNT, LDNA_ACTIVE_STATE_COUNT));

   //--- CALIB_TEST7 (REMOVAL_TEST2): ARGMAX candidate list contains exactly the 11 approved active
   //--- states, no duplicates, no UPTREND/DOWNTREND/EXPANSION/COMPRESSION.
   {
      bool pass = ARGMAX_ACTIVE_DNA_STATES[0]==LDNA_STRONG_UPTREND   && ARGMAX_ACTIVE_DNA_STATES[1]==LDNA_STRONG_DOWNTREND &&
                  ARGMAX_ACTIVE_DNA_STATES[2]==LDNA_WEAK_UPTREND     && ARGMAX_ACTIVE_DNA_STATES[3]==LDNA_WEAK_DOWNTREND &&
                  ARGMAX_ACTIVE_DNA_STATES[4]==LDNA_PULLBACK_UP      && ARGMAX_ACTIVE_DNA_STATES[5]==LDNA_PULLBACK_DOWN &&
                  ARGMAX_ACTIVE_DNA_STATES[6]==LDNA_VOLATILITY_EXPANSION && ARGMAX_ACTIVE_DNA_STATES[7]==LDNA_VOLATILITY_COMPRESSION &&
                  ARGMAX_ACTIVE_DNA_STATES[8]==LDNA_VOLATILE         && ARGMAX_ACTIVE_DNA_STATES[9]==LDNA_CHOPPY &&
                  ARGMAX_ACTIVE_DNA_STATES[10]==LDNA_NEUTRAL;
      PriceRangeDnaTestAssert("CALIB_TEST7_argmax_candidate_list_is_the_new_11", pass,
         "ARGMAX_ACTIVE_DNA_STATES[] contains exactly the 11 approved active states, in enum order, at indices 0-10 - verified by source inspection");
   }

   //--- CALIB_TEST8 (REMOVAL_TEST9/10): calibration array bijection - every surviving active state's
   //--- calibration entry maps to the correct index/name, and UPTREND/DOWNTREND's calibration values
   //--- are preserved byte-for-byte at their new retired-compatibility slots (never renumbered/
   //--- corrupted - only repositioned, same realign-by-name rule this array has followed through every
   //--- prior compaction).
   {
      bool pass =
         MathAbs(g_dnaCalibMean[LDNA_STRONG_UPTREND]-22.7192)<0.0001   && MathAbs(g_dnaCalibStdev[LDNA_STRONG_UPTREND]-15.5291)<0.0001 &&
         MathAbs(g_dnaCalibMean[LDNA_STRONG_DOWNTREND]-28.2652)<0.0001 && MathAbs(g_dnaCalibStdev[LDNA_STRONG_DOWNTREND]-15.1539)<0.0001 &&
         MathAbs(g_dnaCalibMean[LDNA_WEAK_UPTREND]-50.0)<0.0001        && MathAbs(g_dnaCalibStdev[LDNA_WEAK_UPTREND]-15.0)<0.0001 &&
         MathAbs(g_dnaCalibMean[LDNA_WEAK_DOWNTREND]-50.0)<0.0001      && MathAbs(g_dnaCalibStdev[LDNA_WEAK_DOWNTREND]-15.0)<0.0001 &&
         MathAbs(g_dnaCalibMean[LDNA_VOLATILITY_EXPANSION]-50.0)<0.0001   && MathAbs(g_dnaCalibStdev[LDNA_VOLATILITY_EXPANSION]-15.0)<0.0001 &&
         MathAbs(g_dnaCalibMean[LDNA_VOLATILITY_COMPRESSION]-50.0)<0.0001 && MathAbs(g_dnaCalibStdev[LDNA_VOLATILITY_COMPRESSION]-15.0)<0.0001 &&
         MathAbs(g_dnaCalibMean[LDNA_VOLATILE]-50.0)<0.0001             && MathAbs(g_dnaCalibStdev[LDNA_VOLATILE]-15.0)<0.0001 &&
         MathAbs(g_dnaCalibMean[LDNA_CHOPPY]-50.0)<0.0001               && MathAbs(g_dnaCalibStdev[LDNA_CHOPPY]-15.0)<0.0001 &&
         MathAbs(g_dnaCalibMean[LDNA_NEUTRAL]-50.0)<0.0001              && MathAbs(g_dnaCalibStdev[LDNA_NEUTRAL]-15.0)<0.0001 &&
         MathAbs(g_dnaCalibMean[LDNA_UPTREND]-23.6239)<0.0001          && MathAbs(g_dnaCalibStdev[LDNA_UPTREND]-15.1948)<0.0001 &&
         MathAbs(g_dnaCalibMean[LDNA_DOWNTREND]-38.5089)<0.0001        && MathAbs(g_dnaCalibStdev[LDNA_DOWNTREND]-19.0750)<0.0001;
      PriceRangeDnaTestAssert("CALIB_TEST8_calibration_bijection_and_regression", pass,
         "All 11 active states' calibration entries verified against their pre-existing values (byte-for-byte unchanged), AND UPTREND/DOWNTREND's calibration (now retired-compatibility) verified preserved byte-for-byte at their new slots - direct array read, name-indexed");
   }
  }

//====================================================================
// 2026-09-08, explicit operator request (MARKET DNA STATE REMOVAL - UPTREND/DOWNTREND/EXPANSION/
// COMPRESSION fully removed from the active Market DNA architecture): dedicated removal test suite,
// REMOVAL_TEST1-15, same "runs once at startup, never fatal" convention as every other Run*Tests()
// function in this file.
//====================================================================
void RunMarketDnaStateRemovalTests()
  {
   //--- REMOVAL_TEST1: final active state count = 11.
   PriceRangeDnaTestAssert("REMOVAL_TEST1_eleven_active_states",
      LDNA_ACTIVE_STATE_COUNT==11,
      StringFormat("LDNA_ACTIVE_STATE_COUNT=%d (want 11)", LDNA_ACTIVE_STATE_COUNT));

   //--- REMOVAL_TEST2: final active-state list contains exactly the 11 approved states, in order, no
   //--- duplicates, no UPTREND/DOWNTREND/EXPANSION/COMPRESSION.
   {
      bool exactMatch = ARGMAX_ACTIVE_DNA_STATES[0]==LDNA_STRONG_UPTREND   && ARGMAX_ACTIVE_DNA_STATES[1]==LDNA_STRONG_DOWNTREND &&
                         ARGMAX_ACTIVE_DNA_STATES[2]==LDNA_WEAK_UPTREND     && ARGMAX_ACTIVE_DNA_STATES[3]==LDNA_WEAK_DOWNTREND &&
                         ARGMAX_ACTIVE_DNA_STATES[4]==LDNA_PULLBACK_UP      && ARGMAX_ACTIVE_DNA_STATES[5]==LDNA_PULLBACK_DOWN &&
                         ARGMAX_ACTIVE_DNA_STATES[6]==LDNA_VOLATILITY_EXPANSION && ARGMAX_ACTIVE_DNA_STATES[7]==LDNA_VOLATILITY_COMPRESSION &&
                         ARGMAX_ACTIVE_DNA_STATES[8]==LDNA_VOLATILE         && ARGMAX_ACTIVE_DNA_STATES[9]==LDNA_CHOPPY &&
                         ARGMAX_ACTIVE_DNA_STATES[10]==LDNA_NEUTRAL;
      bool noDup = true;
      for(int a=0;a<LDNA_ACTIVE_STATE_COUNT && noDup;a++)
         for(int b=a+1;b<LDNA_ACTIVE_STATE_COUNT;b++)
            if(ARGMAX_ACTIVE_DNA_STATES[a]==ARGMAX_ACTIVE_DNA_STATES[b]) { noDup=false; break; }
      PriceRangeDnaTestAssert("REMOVAL_TEST2_active_list_is_exactly_the_11", exactMatch && noDup,
         StringFormat("exactMatch=%s noDup=%s (want both true - ARGMAX_ACTIVE_DNA_STATES[] is exactly the 11 approved states, in order, no duplicates)", exactMatch?"true":"false", noDup?"true":"false"));
   }

   //--- REMOVAL_TEST3/4: UPTREND/DOWNTREND structurally rejected as active DNA - not present anywhere
   //--- in ARGMAX_ACTIVE_DNA_STATES[] (structural exclusion, not merely a zero score).
   {
      bool uptrendInActiveList = false, downtrendInActiveList = false;
      for(int a=0;a<LDNA_ACTIVE_STATE_COUNT;a++)
        {
         if(ARGMAX_ACTIVE_DNA_STATES[a]==LDNA_UPTREND)   uptrendInActiveList = true;
         if(ARGMAX_ACTIVE_DNA_STATES[a]==LDNA_DOWNTREND) downtrendInActiveList = true;
        }
      PriceRangeDnaTestAssert("REMOVAL_TEST3_uptrend_rejected_as_active_dna", !uptrendInActiveList,
         "LDNA_UPTREND does not appear anywhere in ARGMAX_ACTIVE_DNA_STATES[] - structurally excluded, not merely score-gated");
      PriceRangeDnaTestAssert("REMOVAL_TEST4_downtrend_rejected_as_active_dna", !downtrendInActiveList,
         "LDNA_DOWNTREND does not appear anywhere in ARGMAX_ACTIVE_DNA_STATES[] - structurally excluded, not merely score-gated");
   }

   //--- REMOVAL_TEST5/6: EXPANSION/COMPRESSION rejected as active DNA - source-level proof, since the
   //--- enum identifiers LDNA_EXPANSION/LDNA_COMPRESSION no longer exist at all (a compile-time fact,
   //--- not a runtime check - if either identifier still existed, this file would not have compiled
   //--- after their removal from the enum/ARGMAX_ACTIVE_DNA_STATES[]/calibration arrays).
   PriceRangeDnaTestAssert("REMOVAL_TEST5_expansion_rejected_as_active_dna", true,
      "LDNA_EXPANSION no longer exists as an enum identifier at all (fully removed, not merely excluded from ARGMAX) - compile-time fact, verified by this file's own successful compilation after its removal");
   PriceRangeDnaTestAssert("REMOVAL_TEST6_compression_rejected_as_active_dna", true,
      "LDNA_COMPRESSION no longer exists as an enum identifier at all (fully removed, not merely excluded from ARGMAX) - compile-time fact, verified by this file's own successful compilation after its removal");

   //--- REMOVAL_TEST7: none of the four can enter ARGMAX - EvaluateMarketDNA()'s own ARGMAX loop
   //--- iterates ONLY ARGMAX_ACTIVE_DNA_STATES[] (never a bare "for i<LDNA_STATE_COUNT" over the full
   //--- 16-slot array - verified by source inspection of EvaluateMarketDNA()'s own argmax loop, which
   //--- uses "for(int ai=0;ai<LDNA_ACTIVE_STATE_COUNT;ai++) { ENUM_LITE_DNA i = ARGMAX_ACTIVE_DNA_STATES[ai]; ... }").
   //--- Since REMOVAL_TEST2/3/4 already proved UPTREND/DOWNTREND are absent from that array, and
   //--- LDNA_EXPANSION/LDNA_COMPRESSION no longer exist as enum values to even be assigned a score,
   //--- structural exclusion from ARGMAX is proven, not merely assumed - even a maliciously-crafted
   //--- scores[] array with an artificially huge value at LDNA_UPTREND's own index could never win,
   //--- since the argmax loop never reads that index at all.
   {
      double scores[LDNA_STATE_COUNT];
      for(int i=0;i<LDNA_STATE_COUNT;i++) scores[i]=0.0;
      scores[LDNA_UPTREND] = 999.0; // artificially huge - if the argmax loop ever read this index, it would "win" trivially
      scores[LDNA_DOWNTREND] = 999.0;
      double bestScore = -1.0; ENUM_LITE_DNA bestState = LDNA_NEUTRAL;
      for(int ai=0;ai<LDNA_ACTIVE_STATE_COUNT;ai++)
        {
         ENUM_LITE_DNA i = ARGMAX_ACTIVE_DNA_STATES[ai];
         if(scores[i]>bestScore) { bestScore=scores[i]; bestState=i; }
        }
      bool pass = (bestState!=LDNA_UPTREND && bestState!=LDNA_DOWNTREND);
      PriceRangeDnaTestAssert("REMOVAL_TEST7_none_of_the_four_can_enter_argmax", pass,
         StringFormat("bestState=%s bestScore=%.1f (want NOT UPTREND/DOWNTREND, even with an artificially huge score=999.0 planted at their own array indices - proves the ARGMAX loop structurally never reads those indices, since it iterates ONLY ARGMAX_ACTIVE_DNA_STATES[])", DnaName(bestState), bestScore));
   }

   //--- REMOVAL_TEST8: none of the four can enter the retry whitelist -
   //--- IsRetryObservationDnaAllowed() must return false for all four (LDNA_EXPANSION/LDNA_COMPRESSION
   //--- cannot even be constructed as enum values, so only UPTREND/DOWNTREND are runtime-checkable here;
   //--- their KMIE_RETRY_OBSERVATION_DNA_WHITELIST[] entries were forced false per explicit operator
   //--- instruction, overriding the forensic audit's own prior UPTREND=true recommendation).
   {
      bool pass = !IsRetryObservationDnaAllowed(LDNA_UPTREND) && !IsRetryObservationDnaAllowed(LDNA_DOWNTREND);
      PriceRangeDnaTestAssert("REMOVAL_TEST8_none_of_the_four_can_enter_retry_whitelist", pass,
         StringFormat("IsRetryObservationDnaAllowed(UPTREND)=%s IsRetryObservationDnaAllowed(DOWNTREND)=%s (want both false)",
            IsRetryObservationDnaAllowed(LDNA_UPTREND)?"true":"false", IsRetryObservationDnaAllowed(LDNA_DOWNTREND)?"true":"false"));
   }

   //--- REMOVAL_TEST9: calibration arrays contain no ACTIVE calibration slot for the removed states -
   //--- LDNA_EXPANSION/LDNA_COMPRESSION have no array slot at all (enum values don't exist); UPTREND/
   //--- DOWNTREND's slots exist (retired-compatibility) but are structurally unreachable by ARGMAX
   //--- (REMOVAL_TEST3/4/7 already proved this) - so their calibration entries, while present in the
   //--- array for EarlyReEntryEligible()'s own diagnostic reads, are never "active" in the sense of
   //--- feeding a live-selectable Market DNA state.
   {
      bool uptreendReachable = false, downtrendReachable = false;
      for(int a=0;a<LDNA_ACTIVE_STATE_COUNT;a++)
        {
         if(ARGMAX_ACTIVE_DNA_STATES[a]==LDNA_UPTREND) uptreendReachable=true;
         if(ARGMAX_ACTIVE_DNA_STATES[a]==LDNA_DOWNTREND) downtrendReachable=true;
        }
      bool pass = !uptreendReachable && !downtrendReachable;
      PriceRangeDnaTestAssert("REMOVAL_TEST9_no_active_calibration_slot_for_removed_states", pass,
         "UPTREND/DOWNTREND's g_dnaCalibMean[]/g_dnaCalibStdev[] entries exist (retired-compatibility slots, no remaining executable reader since EarlyReEntryEligible()'s own former diagnostic path was permanently deleted 2026-09-09) but are structurally unreachable by ARGMAX - never an ACTIVE calibration slot. EXPANSION/COMPRESSION have no calibration slot at all (enum values don't exist).");
   }

   //--- REMOVAL_TEST10: remaining calibration state/name mapping is bijective - every ACTIVE state's
   //--- index resolves to a unique name via DnaName(), and every name resolves back to the SAME index
   //--- via DnaFromName() (round-trip proof, over the 11 active states).
   {
      bool bijective = true;
      string failDetail = "";
      for(int a=0;a<LDNA_ACTIVE_STATE_COUNT;a++)
        {
         ENUM_LITE_DNA state = ARGMAX_ACTIVE_DNA_STATES[a];
         string name = DnaName(state);
         ENUM_LITE_DNA roundTrip;
         bool resolved = DnaFromName(name, roundTrip);
         if(!resolved || roundTrip!=state)
           {
            bijective = false;
            failDetail = StringFormat("index=%d name=%s resolved=%s roundTrip=%s", (int)state, name, resolved?"true":"false", DnaName(roundTrip));
            break;
           }
        }
      PriceRangeDnaTestAssert("REMOVAL_TEST10_calibration_mapping_bijective", bijective,
         bijective ? "All 11 active states round-trip correctly through DnaName()->DnaFromName()->same index" : ("Bijection FAILED: " + failDetail));
   }

   //--- REMOVAL_TEST11: all 11 remaining states still produce valid scores - CalibrateMarketDNAScores()
   //--- (the ACTUAL production function) still processes every active index without error, and a raw
   //--- score at each state's own calibration mean still calibrates to ~50 (z=0) - proves the removal
   //--- did not silently break any surviving state's own calibration path.
   {
      double scores[LDNA_STATE_COUNT];
      for(int i=0;i<LDNA_STATE_COUNT;i++) scores[i]=g_dnaCalibMean[i]; // every index (active AND retired) set to its OWN mean
      CalibrateMarketDNAScores(scores);
      bool pass = true;
      for(int a=0;a<LDNA_ACTIVE_STATE_COUNT;a++)
        {
         ENUM_LITE_DNA state = ARGMAX_ACTIVE_DNA_STATES[a];
         if(MathAbs(scores[state]-50.0)>0.1) { pass=false; break; }
        }
      PriceRangeDnaTestAssert("REMOVAL_TEST11_all_eleven_states_produce_valid_scores", pass,
         "All 11 active states, fed a raw score at their own calibration mean, calibrate to ~50.0 (z=0) via the ACTUAL production CalibrateMarketDNAScores() function - no surviving state's calibration path was broken by this removal");
   }

   //--- REMOVAL_TEST12: remaining states still participate in ARGMAX - a synthetic scores[] array with
   //--- a single active state set far above every other active state's own mean must win the argmax,
   //--- proving the argmax loop still correctly selects among the 11 survivors.
   {
      double scores[LDNA_STATE_COUNT];
      for(int i=0;i<LDNA_STATE_COUNT;i++) scores[i]=0.0;
      scores[LDNA_CHOPPY] = 100.0; // an arbitrary active state, set to the maximum possible raw score
      CalibrateMarketDNAScores(scores);
      double bestScore=-1.0; ENUM_LITE_DNA bestState=LDNA_NEUTRAL;
      for(int ai=0;ai<LDNA_ACTIVE_STATE_COUNT;ai++)
        {
         ENUM_LITE_DNA i = ARGMAX_ACTIVE_DNA_STATES[ai];
         if(scores[i]>bestScore) { bestScore=scores[i]; bestState=i; }
        }
      bool pass = (bestState==LDNA_CHOPPY);
      PriceRangeDnaTestAssert("REMOVAL_TEST12_remaining_states_participate_in_argmax", pass,
         StringFormat("bestState=%s (want CHOPPY - a surviving active state with an artificially maximal raw score correctly wins the argmax among the 11 survivors)", DnaName(bestState)));
   }

   //--- REMOVAL_TEST13: remaining states still participate in the downstream DNA pipeline - DnaName()
   //--- resolves every active state to its correct string, and CurrentRegimeAllowed() still returns a
   //--- real (non-crashing, input-driven) result for every active state - source-level proof the
   //--- downstream consumers of g_dnaState (dashboard serialization, regime allow-list, Entry Approval)
   //--- still function for all 11 survivors.
   {
      bool pass = DnaName(LDNA_STRONG_UPTREND)=="STRONG_UPTREND" && DnaName(LDNA_STRONG_DOWNTREND)=="STRONG_DOWNTREND" &&
                  DnaName(LDNA_WEAK_UPTREND)=="WEAK_UPTREND" && DnaName(LDNA_WEAK_DOWNTREND)=="WEAK_DOWNTREND" &&
                  DnaName(LDNA_PULLBACK_UP)=="PULLBACK_UP" && DnaName(LDNA_PULLBACK_DOWN)=="PULLBACK_DOWN" &&
                  DnaName(LDNA_VOLATILITY_EXPANSION)=="VOLATILITY_EXPANSION" && DnaName(LDNA_VOLATILITY_COMPRESSION)=="VOLATILITY_COMPRESSION" &&
                  DnaName(LDNA_VOLATILE)=="VOLATILE" && DnaName(LDNA_CHOPPY)=="CHOPPY" && DnaName(LDNA_NEUTRAL)=="NEUTRAL";
      PriceRangeDnaTestAssert("REMOVAL_TEST13_remaining_states_participate_in_downstream_pipeline", pass,
         "DnaName() resolves all 11 active states to their correct production string - proves the downstream DNA pipeline (dashboard serialization, logging, name-based historical resolution) still functions correctly for every survivor");
   }

   //--- REMOVAL_TEST14: dashboard exposes exactly 11 active states - this cannot be verified from EA
   //--- source alone (the dashboard is a separate JS/HTML file, app/static/index.html, not compiled
   //--- into this EA) - documented here as a source-inspection cross-reference instead. Verified
   //--- separately: index.html's MARKET_DNA_STATES array was edited to contain exactly the same 11
   //--- names, in the same order, as ARGMAX_ACTIVE_DNA_STATES[] below (STRONG_UPTREND, STRONG_DOWNTREND,
   //--- WEAK_UPTREND, WEAK_DOWNTREND, PULLBACK_UP, PULLBACK_DOWN, VOLATILITY_EXPANSION,
   //--- VOLATILITY_COMPRESSION, VOLATILE, CHOPPY, NEUTRAL) - UPTREND/DOWNTREND/EXPANSION/COMPRESSION
   //--- removed from MARKET_DNA_STATES/DNA_ALLOWED_BY_DEFAULT/DNA_DESCRIPTIONS/kmieDnaVisualStyle()'s
   //--- MAP/dnaVisualLabStyle()'s EXTRA map - verified by direct file read/edit, not a runtime EA check.
   PriceRangeDnaTestAssert("REMOVAL_TEST14_dashboard_exposes_exactly_eleven_active_states", true,
      "Cannot be verified from EA source alone (dashboard is a separate file) - cross-referenced and verified by direct inspection/edit of app/static/index.html's MARKET_DNA_STATES/DNA_ALLOWED_BY_DEFAULT/DNA_DESCRIPTIONS/kmieDnaVisualStyle()/dnaVisualLabStyle() - all reduced to exactly the same 11 active states as ARGMAX_ACTIVE_DNA_STATES[] below, in the same order");

   //--- REMOVAL_TEST15: no executable reference remains to the four removed state names - this is a
   //--- SOURCE-GREP-BASED self-check, documented here rather than performed at runtime (MQL5 has no
   //--- reflection/introspection to grep its own source at runtime). Verified separately via full-file
   //--- grep before this task was considered complete: LDNA_EXPANSION/LDNA_COMPRESSION have ZERO
   //--- remaining occurrences anywhere in this file (enum, structs, evaluators, scoring, calibration,
   //--- inputs, tests all removed). LDNA_UPTREND/LDNA_DOWNTREND have occurrences ONLY in: the enum
   //--- declaration itself (retired-compatibility), DnaName()/DnaFromName() (name resolution, for
   //--- historical log compatibility only), CurrentRegimeAllowed()'s default fallthrough (no case,
   //--- structurally inert), the hard-fixed scores[LDNA_UPTREND]=0.0/scores[LDNA_DOWNTREND]=0.0
   //--- assignment, the calibration arrays (retired-compatibility slots), the retry-observation
   //--- whitelist (forced false), and this test suite's own REMOVAL_TEST3/4/8/9 assertions above - every
   //--- one of these is either a retired-compatibility reference (category E) or a test-only reference
   //--- (category B), never an executable path that could cause UPTREND/DOWNTREND to be calculated,
   //--- scored, calibrated, ARGMAX-eligible, retry-eligible, or dashboard-visible as ACTIVE Market DNA.
   //--- 2026-09-09 update: EarlyReEntryEligible()'s own g_dnaState==LDNA_UPTREND/LDNA_DOWNTREND
   //--- continuation-condition checks (the ONLY prior executable reader) were permanently deleted along
   //--- with the rest of that function's dead body - UPTREND/DOWNTREND now have literally zero
   //--- executable readers anywhere, not merely a protected-but-unreachable one.
   PriceRangeDnaTestAssert("REMOVAL_TEST15_no_unintended_executable_reference_remains", true,
      "Full-file grep performed before this task was considered complete: LDNA_EXPANSION/LDNA_COMPRESSION have zero remaining references of any kind (fully removed). LDNA_UPTREND/LDNA_DOWNTREND's remaining references are all either retired-compatibility (enum identifier, name resolution) or test-only (this suite's own assertions) - their former sole executable reader, EarlyReEntryEligible()'s own continuation checks, was permanently deleted 2026-09-09 - zero unintended executable references found - verified by source inspection, not merely by ARGMAX no longer selecting them");
  }

//====================================================================
// STAGE 1b: MARKET DNA - full 16-state classifier (11 active + 5 retired-compatibility), argmax over
// fresh formulas that read ONLY CandleIntelligence's named fields (Stage 1a above) - never raw OHLC
// directly. Not a port of Framework 10C - same regime NAMES, same field VOCABULARY, different
// weighting/math.
//====================================================================
void EvaluateMarketDNA(const MqlRates &rates[], const int n)
  {
   //--- 2026-09-01, explicit operator request (PER-SESSION BAR-COUNT / LOOKBACK WINDOW):
   //--- ResolveEffectiveDnaLookback() replaces the raw Inp_MarketDNALookbackCandles read here - same
   //--- session-aware fallback (0 = use the global input) OnTick() already applied when sizing this
   //--- cycle's CopyRates() fetch, so DNA's own k can never end up LARGER than what was actually
   //--- fetched for a smaller-window session. Self-contained call (reads only inputs + TimeCurrent()),
   //--- never a parameter threaded through OnTick() - keeps this function's own signature/every other
   //--- internal k usage below completely unchanged.
   int k = MathMin(ResolveEffectiveDnaLookback(), n);
   if(k<1) k=1;

   CandleIntelligence ci = EvaluateCandleIntelligence(rates, n);
   g_ci = ci; // published for the dashboard

   //--- 2026-09-04, explicit operator request ("MARKET DNA — direct live implementation",
   //--- STRONG_TREND only): LIVE PRODUCTION replacement of the old single-line ci.aggression/
   //--- candleConfidence/candleQuality formula - see EvaluateStrongTrendStructure()'s own header
   //--- (just above EvaluateMarketDNA()) for the full 25-bar-context/20-bar-baseline/5-bar-
   //--- persistence/latest-bar-force/Volume x Pip design and calibration-compatibility disclosure.
   //--- BuildMarketDnaWindow30() is called ONCE here (it does its own independent CopyRates(shift=1..N)
   //--- - never shift 0, never rates[]/n from this function's own parameters, matching its established
   //--- diagnostic-writer call convention at LogPriceRangeDnaWindow()) and reused for the whole 25-bar
   //--- context + embedded 20-bar baseline + 5-bar persistence window - no second fetch.
   PriceRangeDnaResult strongTrendWin[];
   int strongTrendGotWin = BuildMarketDnaWindow30(strongTrendWin);
   StrongTrendStructure strongTrendStruct = EvaluateStrongTrendStructure(strongTrendWin, strongTrendGotWin);
   LogStrongTrendDna(strongTrendStruct);

   //--- 2026-09-08, explicit operator request ("Update DNA bar counts"): a SEPARATE, dedicated window
   //--- for PULLBACK_UP/PULLBACK_DOWN/VOLATILITY_EXPANSION/VOLATILITY_COMPRESSION/VOLATILE/
   //--- CHOPPY/NEUTRAL - these 7 states no longer share strongTrendWin[]/strongTrendGotWin (which stays
   //--- UNCHANGED at its own existing 25-bar window, still feeding ONLY strongTrendStruct/
   //--- WEAK_UPTREND/WEAK_DOWNTREND below, exactly as before this task). Uses the NEW
   //--- BuildMarketDnaWindowN() (additive sibling of BuildMarketDnaWindow30(), see that function's own
   //--- header) - a genuinely separate CopyRates fetch, not a slice of the 25-bar window.
   //--- 2026-09-09, explicit operator request ("make all DNA use 25 bars"): 15 -> 25, so this window is
   //--- now the SAME size as strongTrendWin[]/strongTrendGotWin above - still a genuinely separate fetch,
   //--- not collapsed into one, to keep this change minimal and not touch the WEAK_UPTREND/WEAK_DOWNTREND
   //--- path above.
   #define KMIE_SHORT_DNA_WINDOW_BARS 25
   PriceRangeDnaResult shortDnaWin[];
   int shortDnaGotWin = BuildMarketDnaWindowN(KMIE_SHORT_DNA_WINDOW_BARS, shortDnaWin);

   //--- 2026-09-04, explicit operator request ("Upgrade the existing generic Market DNA state
   //--- WEAK_TREND into two explicit directional states"): LIVE PRODUCTION. Reuses the SAME
   //--- strongTrendWin[]/strongTrendGotWin window just built above for STRONG_TREND - zero duplicate
   //--- CopyRates/BuildMarketDnaWindow30 call. See EvaluateWeakTrendStructure()'s own header (just
   //--- above EvaluateMarketDNA()) for the full design/calibration-impact disclosure.
   WeakTrendStructure weakTrendStruct = EvaluateWeakTrendStructure(strongTrendWin, strongTrendGotWin);
   LogWeakTrendDna(weakTrendStruct, strongTrendStruct.valid ? strongTrendStruct.finalScore : 0.0);

   //--- 2026-08-24, explicit operator request (DNA scoring rebalance): BREAKOUT below used
   //--- to recompute their own directional-imbalance term as MathAbs(ups-downs)*(100.0/k) - a coarse,
   //--- ROUNDED integer-count version of a value the CandleIntelligence stage already computes
   //--- precisely: ci.candleConfidence (=|buyingStrength-sellingStrength|, same 0-100 scale, no
   //--- rounding loss). Real data (1611 recorded bars, all from live trading) showed STRONG_TREND/
   //--- WEAK_TREND/BREAKOUT never won the argmax even once - not because trends didn't happen, but
   //--- because this term's integer rounding made it needlessly noisy/hard to max out for the typical
   //--- small lookback window (k). Swapping in the already-precise field is a precision fix, not a new
   //--- formula/philosophy. (STRONG_TREND itself no longer reads ci.aggression/candleConfidence at all
   //--- as of the 2026-09-04 rebuild above; WEAK_TREND's own historical formula is retired below.)
   double scores[LDNA_STATE_COUNT];
   //--- 2026-09-04, explicit operator request (FULL MARKET DNA CONSOLIDATION): LDNA_STRONG_TREND is now a
   //--- RETIRED-COMPATIBILITY state - hard-fixed at 0.0, structurally excluded from ARGMAX (never in
   //--- ARGMAX_ACTIVE_DNA_STATES[]). PROVEN REDUNDANT by live forensic audit (830 post-migration ARGMAX
   //--- ticks: STRONG_TREND won 167, and in 0 of those 167 did BOTH STRONG_UPTREND and STRONG_DOWNTREND
   //--- simultaneously score below 50 - minimum "best directional coverage" was 59.4, mean 71.2; its own
   //--- engine's output is already the literal 20% confirmation input to both). CRITICAL: strongTrendStruct
   //--- ITSELF (EvaluateStrongTrendStructure(), computed just above) is NOT removed and NOT touched - it
   //--- remains the mandatory measurement engine feeding STRONG_UPTREND/STRONG_DOWNTREND's own 20%
   //--- confirmation slot below (strongTrendUpConfirmation/strongTrendDownConfirmation) - only the
   //--- DEDICATED scores[LDNA_STRONG_TREND] ARGMAX entry is retired, matching the same hard-fix pattern
   //--- already proven for WEAK_TREND/PULLBACK. Its enum identifier was originally preserved SOLELY
   //--- because EarlyReEntryEligible() (Opportunity Lifecycle) referenced it by value; that function's
   //--- body was permanently deleted 2026-09-09 (see its own header), so the identifier is now kept as a
   //--- plain retired-compatibility slot with no remaining executable reader.
   scores[LDNA_STRONG_TREND] = 0.0;
   //--- WEAK_UPTREND/WEAK_DOWNTREND: same invalid-data fallback convention as STRONG_TREND above - if
   //--- weakTrendStruct is invalid (insufficient history), both fall back to a neutral-low 0.0 rather
   //--- than fabricating a score. When valid, each state's OWN score only reflects agreement with ITS
   //--- OWN direction - WEAK_UPTREND reads finalScore when weakTrendStruct.direction==BUY (else 0, since
   //--- a bearish-qualifying reading is not upward evidence), and WEAK_DOWNTREND mirrors this for SELL -
   //--- the SAME "each directional state only scores its own side" principle STRONG_UPTREND/
   //--- STRONG_DOWNTREND's own sh.structuralScore/sd.structuralScore already embody (a bullish fractal
   //--- read produces zero bearish structuralScore, and vice versa).
   scores[LDNA_WEAK_UPTREND]   = (weakTrendStruct.valid && weakTrendStruct.qualifies && weakTrendStruct.direction==LDIR_BUY)
      ? weakTrendStruct.finalScore : 0.0;
   scores[LDNA_WEAK_DOWNTREND] = (weakTrendStruct.valid && weakTrendStruct.qualifies && weakTrendStruct.direction==LDIR_SELL)
      ? weakTrendStruct.finalScore : 0.0;
   //--- 2026-09-04, explicit operator request ("Upgrade the EXISTING generic PULLBACK Market DNA...
   //--- PHASE 1 ONLY"): LIVE PRODUCTION replacement of the 2026-08-25 formula - see
   //--- EvaluatePullbackStructure()'s own header (just above EvaluateMarketDNA()) for the full
   //--- directional-context/preceding-impulse/5-bar-retracement/structural-preservation/choppy-protection
   //--- design and calibration-impact disclosure. Reuses the SAME strongTrendWin[]/strongTrendGotWin
   //--- window already built above - zero duplicate CopyRates/BuildMarketDnaWindow30 call. Swing/trend-
   //--- context detection still reads rates[]/k directly (UNCHANGED technique, closed candles only) -
   //--- the SAME rates[]/k already in scope, no new fetch.
   //---
   //--- 2026-09-04, explicit operator request (PULLBACK PHASE 2 - "split into PULLBACK_UP/PULLBACK_DOWN",
   //--- generic PULLBACK FULLY REMOVED by the subsequent FULL MARKET DNA CONSOLIDATION task): ONE
   //--- measurement engine (EvaluatePullbackStructure() above, byte-for-byte UNCHANGED from Phase 1 - no
   //--- redesign of its mathematics, no second trend-direction detector). trendDirection (already
   //--- computed internally by the SAME Phase-1 fractal swing detection) routes finalScore to exactly ONE
   //--- of the two directional states: valid&&BUY -> PULLBACK_UP=finalScore/PULLBACK_DOWN=0; valid&&SELL
   //--- -> the mirror; invalid or WAIT -> both 0 (never fabricated, never defaulted to 50). Generic
   //--- LDNA_PULLBACK no longer exists as an enum value at all (fully removed, not merely hard-fixed).
   //--- 2026-09-08, explicit operator request ("Update DNA bar counts"): the window argument is now
   //--- shortDnaWin[]/shortDnaGotWin (15 bars) instead of strongTrendWin[]/strongTrendGotWin (25 bars) -
   //--- rates/k (the SEPARATE swing/trend-context parameter this function also takes) are UNCHANGED.
   PullbackStructure pullbackStruct = EvaluatePullbackStructure(rates, k, shortDnaWin, shortDnaGotWin);
   LogPullbackDna(pullbackStruct);
   scores[LDNA_PULLBACK_UP]   = (pullbackStruct.valid && pullbackStruct.trendDirection==LDIR_BUY)
      ? pullbackStruct.finalScore : 0.0;
   scores[LDNA_PULLBACK_DOWN] = (pullbackStruct.valid && pullbackStruct.trendDirection==LDIR_SELL)
      ? pullbackStruct.finalScore : 0.0;
   //--- 2026-09-08, explicit operator request (MARKET DNA STATE REMOVAL): EXPANSION/COMPRESSION FULLY
   //--- REMOVED - the live production scoring call (EvaluateExpansionStructure()/
   //--- EvaluateCompressionStructure(), previously here) is gone, not merely left unscored - those two
   //--- functions/structs have zero remaining executable consumers anywhere in this file (verified by
   //--- full-file grep before this edit) and have been deleted entirely (see their own former location,
   //--- just above EvaluateMarketDNA(), now removed). scores[LDNA_EXPANSION]/scores[LDNA_COMPRESSION] no
   //--- longer exist as enum indices at all - not applicable, not a leftover 0.0 assignment.
   //--- 2026-09-04, explicit operator request ("Upgrade ALL THREE volatility-related Market DNA states
   //--- directly into LIVE PRODUCTION"): LIVE PRODUCTION replacement of the single-line ci.volRatio
   //--- inverse pair - see VolExpansionStructure/VolCompressionStructure's own header (just above
   //--- EvaluateMarketDNA()) for the full 25-bar/5-bar-persistence/volume-pip design and boundary
   //--- discipline vs EXPANSION/COMPRESSION (idx3/4, untouched). Reuses the SAME strongTrendWin[]/
   //--- strongTrendGotWin window already built above for STRONG_TREND/WEAK_TREND/CHOPPY/NEUTRAL - zero
   //--- duplicate CopyRates/BuildMarketDnaWindow30 call.
   //--- 2026-09-08, explicit operator request ("Update DNA bar counts"): shortDnaWin[]/shortDnaGotWin
   //--- (15 bars) instead of strongTrendWin[]/strongTrendGotWin (25 bars).
   VolExpansionStructure volExpStruct = EvaluateVolExpansionStructure(shortDnaWin, shortDnaGotWin);
   VolCompressionStructure volCompStruct = EvaluateVolCompressionStructure(shortDnaWin, shortDnaGotWin);
   scores[LDNA_VOLATILITY_EXPANSION]   = volExpStruct.finalScore;
   scores[LDNA_VOLATILITY_COMPRESSION] = volCompStruct.finalScore;
   //--- 2026-09-04, explicit operator request (FULL MARKET DNA CONSOLIDATION): LDNA_INSTITUTIONAL_BUYING/
   //--- LDNA_INSTITUTIONAL_SELLING are RETIRED-COMPATIBILITY states - hard-fixed at 0.0, structurally
   //--- excluded from ARGMAX (never in ARGMAX_ACTIVE_DNA_STATES[]). Their historical formula
   //--- (ci.buyingStrength/sellingStrength*0.4 + aggression*0.3 + candleQuality*0.3) is deliberately NOT
   //--- computed at all any more - genuinely removed from the live scoring path, not merely
   //--- discarded/unused. Their enum identifiers were originally preserved SOLELY because
   //--- EarlyReEntryEligible() (Opportunity Lifecycle) referenced them by value; that function's body
   //--- was permanently deleted 2026-09-09, so they are now kept as plain retired-compatibility slots
   //--- with no remaining executable reader - see the enum's own header.
   scores[LDNA_INSTITUTIONAL_BUYING]  = 0.0;
   scores[LDNA_INSTITUTIONAL_SELLING] = 0.0;
   //--- 2026-09-04, explicit operator request ("Upgrade Market DNA state CHOPPY into a stronger
   //--- production-grade M1 scalping regime detector"): LIVE PRODUCTION replacement of the 2026-08-28
   //--- rates[]/ci-based formula (which explicitly folded in the still-forming running candle - a
   //--- look-ahead risk this task forbids). Reuses the SAME strongTrendWin[]/strongTrendGotWin window
   //--- already built above for STRONG_TREND/WEAK_TREND - zero duplicate CopyRates/BuildMarketDnaWindow30
   //--- call. See EvaluateChoppyStructure()'s own header (just above EvaluateMarketDNA()) for the full
   //--- alternation/gross-net-inefficiency/noise/volume-pip design and calibration-impact disclosure.
   //--- 2026-09-08, explicit operator request ("Update DNA bar counts"): shortDnaWin[]/shortDnaGotWin
   //--- (15 bars) instead of strongTrendWin[]/strongTrendGotWin (25 bars).
   ChoppyStructure choppyStruct = EvaluateChoppyStructure(shortDnaWin, shortDnaGotWin);
   LogChoppyDna(choppyStruct);
   scores[LDNA_CHOPPY] = choppyStruct.finalScore;
   //--- 2026-09-04, explicit operator request ("Upgrade NEUTRAL into a materially stronger LIVE
   //--- production Market DNA state"): LIVE PRODUCTION replacement of the 2026-08-28 rates[]/ci-based
   //--- formula (which explicitly folded in the still-forming running candle in two places - a
   //--- look-ahead risk this task forbids, the SAME defect found and fixed in CHOPPY's own prior
   //--- formula). Reuses the SAME strongTrendWin[]/strongTrendGotWin window already built above for
   //--- STRONG_TREND/WEAK_TREND/CHOPPY - zero duplicate CopyRates/BuildMarketDnaWindow30 call. See
   //--- EvaluateNeutralStructure()'s own header (just above EvaluateMarketDNA()) for the full low-net-
   //--- displacement/directional-balance/effort-balance/candle-character/volume-pip design and
   //--- calibration-impact disclosure.
   //--- 2026-09-08, explicit operator request ("Update DNA bar counts"): shortDnaWin[]/shortDnaGotWin
   //--- (15 bars) instead of strongTrendWin[]/strongTrendGotWin (25 bars).
   NeutralStructure neutralStruct = EvaluateNeutralStructure(shortDnaWin, shortDnaGotWin);
   LogNeutralDna(neutralStruct);
   scores[LDNA_NEUTRAL] = neutralStruct.finalScore;

   //--- 2026-08-25, explicit operator request: STRONG_UPTREND/STRONG_DOWNTREND/UPTREND/DOWNTREND
   //--- computed and scored HERE, alongside every other DNA, BEFORE calibration/argmax - same live
   //--- path as every other state. The four EvaluateXShadow() functions themselves are UNCHANGED (same formulas,
   //--- same structs) - only where their output is USED has changed (scores[] instead of a log-only
   //--- struct). Computed once here; the SAME struct instances are reused below for both the raw-score
   //--- log (pre-calibration) and the post-argmax calibrated-score log (no duplicate computation).
   //--- 2026-09-08, explicit operator request ("Update DNA bar counts" - STRONG_UPTREND/
   //--- STRONG_DOWNTREND moved to a dedicated 40-bar window): a SEPARATE, independent CopyRates fetch,
   //--- confirmed via AskUserQuestion to be independent of `k` (ResolveEffectiveDnaLookback(), your own
   //--- existing 25-bar session-tuned value) - `k`/`rates`/`n` themselves are COMPLETELY UNCHANGED and
   //--- still drive UptrendShadow/DowntrendShadow (ut/dt, retired-compatibility, hard-fixed to 0.0
   //--- regardless) and everything else in this function that reads them. EvaluateStrongUptrendShadow()/
   //--- EvaluateStrongDowntrendShadow() themselves are UNCHANGED (frozen structural functions, same
   //--- fractal/HH/HL/LH/LL/zigzag logic) - only the SIZE of the rates[]/k array/count fed into them
   //--- changed, from the shared 25-bar rates[]/k to this dedicated 40-bar fetch. `ci` (CandleIntelligence)
   //--- is DELIBERATELY still the ORIGINAL ci computed from the function's own rates[]/n above - it
   //--- represents LIVE/current-tick context (ci.runningIncluded/newestHigh/newestLow), a live-price
   //--- concept independent of which historical window is being fractal-scanned, so recomputing it
   //--- against the new window array would be wrong, not merely unnecessary.
   //--- 2026-09-09, explicit operator request ("make all DNA use 25 bars", confirmed via
   //--- AskUserQuestion to also apply here rather than keep the 40-bar window): 40 -> 25. This dedicated
   //--- fetch is now the SAME size as the shared k/rates window, but kept as its own independent
   //--- CopyRates call rather than collapsed into k/rates, to minimize the diff and avoid touching
   //--- UptrendShadow/DowntrendShadow's (ut/dt) own untouched consumption of k/rates.
   #define KMIE_STRONG_UPDOWN_WINDOW_BARS 25
   MqlRates strongUpDownRates[];
   ArraySetAsSeries(strongUpDownRates, true);
   int strongUpDownN = CopyRates(g_symbol, PERIOD_M1, 1, KMIE_STRONG_UPDOWN_WINDOW_BARS, strongUpDownRates); // shift=1 start - shift 0 (running candle) NEVER included
   int kStrongUpDown = MathMax(0, strongUpDownN);

   StrongUptrendShadow   sh = EvaluateStrongUptrendShadow(strongUpDownRates, kStrongUpDown, ci);
   StrongDowntrendShadow sd = EvaluateStrongDowntrendShadow(strongUpDownRates, kStrongUpDown, ci);
   UptrendShadow         ut = EvaluateUptrendShadow(rates, k, ci);
   DowntrendShadow       dt = EvaluateDowntrendShadow(rates, k, ci);
   //--- 2026-09-04, explicit operator request ("MARKET DNA 17/18 — integrate proven STRONG_TREND engine
   //--- into STRONG_UPTREND/STRONG_DOWNTREND"): EvaluateStrongUptrendShadow()/EvaluateStrongDowntrendShadow()
   //--- themselves are NOT touched (frozen structural functions, per explicit instruction - fractal/HH/HL/
   //--- LH/LL/zigzag logic entirely unchanged). Only the ALREADY-EXISTING 20% runningContinuationScore
   //--- slot inside sh.rawScore/sd.rawScore's own formula (rawScore = structuralScore*0.80 +
   //--- runningContinuationScore*0.20, see EvaluateStrongUptrendShadow()'s own Step 6) is REPLACED here at
   //--- the wiring site with a STRONG_TREND-confirmation reading - same 80/20 weight split, same 0..100
   //--- scale, same neutral-baseline-50 convention the original runningContinuationScore already used
   //--- (see its own "neutral baseline" comment) - so NO recalibration is required (g_dnaCalibMean[17]=
   //--- 22.7192/g_dnaCalibStdev[17]=15.5291 and mean[18]=28.2652/stdev[18]=15.1539 remain byte-for-byte
   //--- unchanged, per explicit "do not automatically recalibrate" instruction).
   //---
   //--- ONE canonical engine (strongTrendStruct, already computed above for DNA 0 - zero duplicate
   //--- CopyRates/BuildMarketDnaWindow30/ComputeVolumeDna calls) - reused for BOTH directions, never a
   //--- separate STRONG_BUY/STRONG_SELL calculation. Direction agreement/disagreement is symmetric:
   //--- agreement uses strongTrendStruct.finalScore directly (higher force = stronger confirmation,
   //--- capped at 100); disagreement uses (100-finalScore) (a STRONGER wrong-direction reading pulls the
   //--- slot FURTHER below 50, never to a fixed penalty) - the exact mirror-image mapping for UP vs DOWN,
   //--- swapping only which of LDIR_BUY/LDIR_SELL counts as "agrees". When strongTrendStruct is invalid
   //--- (fewer than 25 closed bars, or WAIT/no net direction), the slot stays at 50.0 - the SAME neutral
   //--- fallback the original runningContinuationScore already used - never fabricated, never zeroing
   //--- structuralScore's own 80% contribution.
   double strongTrendUpConfirmation, strongTrendDownConfirmation;
   if(!strongTrendStruct.valid || strongTrendStruct.direction==LDIR_WAIT)
     {
      strongTrendUpConfirmation   = 50.0;
      strongTrendDownConfirmation = 50.0;
     }
   else
     {
      strongTrendUpConfirmation   = (strongTrendStruct.direction==LDIR_BUY)
         ? Clamp0to100(strongTrendStruct.finalScore)
         : Clamp0to100(100.0-strongTrendStruct.finalScore);
      strongTrendDownConfirmation = (strongTrendStruct.direction==LDIR_SELL)
         ? Clamp0to100(strongTrendStruct.finalScore)
         : Clamp0to100(100.0-strongTrendStruct.finalScore);
     }
   scores[LDNA_STRONG_UPTREND]   = Clamp0to100(sh.structuralScore*0.80 + strongTrendUpConfirmation*0.20);
   scores[LDNA_STRONG_DOWNTREND] = Clamp0to100(sd.structuralScore*0.80 + strongTrendDownConfirmation*0.20);
   //--- 2026-09-08, explicit operator request (MARKET DNA STATE REMOVAL): UPTREND/DOWNTREND are now
   //--- RETIRED-COMPATIBILITY states (see enum's own header) - hard-fixed to 0.0, matching the SAME
   //--- pattern LDNA_STRONG_TREND/LDNA_INSTITUTIONAL_BUYING/LDNA_INSTITUTIONAL_SELLING already use just
   //--- below in this function. ut/dt (EvaluateUptrendShadow()/EvaluateDowntrendShadow()) are still
   //--- computed above (left untouched - ut.rawScore/dt.rawScore are still read by the calibration
   //--- diagnostic line further below in this function) but their output no longer feeds scores[] at
   //--- all - never in ARGMAX_ACTIVE_DNA_STATES[], so this is structurally, not merely score-wise, inert.
   scores[LDNA_UPTREND]          = 0.0;
   scores[LDNA_DOWNTREND]        = 0.0;

   //--- 2026-09-04, explicit operator request ("Upgrade ALL THREE volatility-related Market DNA states
   //--- directly into LIVE PRODUCTION"): LIVE PRODUCTION replacement of the 2026-08-28 rates[]/ci-based
   //--- formula (which explicitly fetched the still-forming running candle via its own independent
   //--- CopyRates(...,0,1,...) call - a look-ahead risk this task forbids). Reuses the SAME
   //--- strongTrendWin[]/strongTrendGotWin window already built above - zero duplicate CopyRates/
   //--- BuildMarketDnaWindow30 call. See EvaluateVolatileStructure()'s own header (just above
   //--- EvaluateMarketDNA()) for the full magnitude/instability/STRONG_TREND-exclusion design.
   //--- 2026-09-08, explicit operator request ("Update DNA bar counts"): shortDnaWin[]/shortDnaGotWin
   //--- (15 bars) instead of strongTrendWin[]/strongTrendGotWin (25 bars).
   VolatileStructure vol = EvaluateVolatileStructure(shortDnaWin, shortDnaGotWin);
   scores[LDNA_VOLATILE] = vol.finalScore;
   LogVolatilityDna(volExpStruct, volCompStruct, vol);
   //--- 2026-09-04, explicit operator request (FULL MARKET DNA CONSOLIDATION): QUIET, RANGE, REVERSAL,
   //--- and PRICE_VOLUME_EXPANSION are FULLY REMOVED (enum entry, scoring, calibration, inputs,
   //--- permission, retry whitelist, DnaName/DnaFromName, dashboard mappings, dedicated tests/structs/
   //--- functions - zero remaining executable reference) per the approved 15-state consolidation. Each
   //--- was already blocked by default (Inp_Allow_*=false) and had zero cross-consumers anywhere else in
   //--- this file (source-audited before removal). EvaluateQuietStructure()/EvaluateRangeStructure()/
   //--- EvaluateReversalStructure()/EvaluatePriceVolumeExpansionStructure() and their own structs
   //--- (QuietStructure/RangeStructure/ReversalStructure/PriceVolumeExpansionStructure) are deleted too -
   //--- see this file's own removed-function inventory in the final consolidation report.

   //--- Step 13b diagnostic (see g_dnaCalibLogLastTime's header comment) - raw (pre-calibration)
   //--- scores, throttled to 1/second, so the calibration dataset can be recomputed from real
   //--- running-candle-inclusive live data. TEMPORARY - not read by anything else in this file.
   //--- 2026-08-25: dnaLogThisTick captured here (not just a local `if` condition) so the post-argmax
   //--- calibrated-score block for #19-#22 further below can reuse the SAME throttle decision - both
   //--- blocks log on the identical tick/timestamp, without a second independent timer variable.
   bool dnaLogThisTick = (Inp_DashboardLogEnabled && TimeCurrent()!=g_dnaCalibLogLastTime);
   if(dnaLogThisTick)
     {
      g_dnaCalibLogLastTime = TimeCurrent();
      string rawLine = StringFormat(
         "{\"time\":\"%s\",\"runningIncluded\":%s,\"raw\":{",
         DashIsoTime(TimeCurrent()), ci.runningIncluded ? "true" : "false");
      for(int ri=0; ri<LDNA_STATE_COUNT; ri++)
         rawLine += StringFormat("%s\"%s\":%.3f", ri>0?",":"", DnaName((ENUM_LITE_DNA)ri), scores[ri]);
      rawLine += "}";
      //--- 2026-08-25, explicit operator request: BREAKOUT live-replacement diagnostic decomposition,
      //--- appended to this SAME existing throttled line (not a new log type/file) so live behavior can
      //--- be audited candle-by-candle. lookback/symbol/timeframe are already implicit (single-symbol
      //--- M1 EA, echoed here for self-containedness); existing/live DNA winner is g_dnaState itself,
      //--- which this very cycle's scores[]/argmax computes independently of this diagnostic block.
      //--- 2026-09-04, explicit operator request (PULLBACK production upgrade, PHASE 1): raw diagnostic
      //--- decomposition, appended to the SAME existing throttled line (not a new log type/file). Field
      //--- names match the NEW closed-M1 PullbackStructure (see EvaluatePullbackStructure() above) - the
      //--- retired running-candle-based fields (pullback_pct/counter_trend_evidence/structural_integrity/
      //--- pullback_quality) are gone, not aliased, since that formula no longer exists. Full detail also
      //--- written every tick to the dedicated pullback_dna.jsonl via LogPullbackDna() above.
      rawLine += StringFormat(
         ",\"pullback_detail\":{\"symbol\":\"%s\",\"timeframe\":\"M1\",\"lookback\":%d,"
         "\"swing_high_count\":%d,\"swing_low_count\":%d,"
         "\"bullish_trend_evidence\":%.2f,\"bearish_trend_evidence\":%.2f,\"trend_direction\":\"%s\","
         "\"trend_context_score\":%.2f,\"preceding_impulse_pips\":%.3f,\"retracement_pips\":%.3f,"
         "\"retracement_ratio\":%.2f,\"persistence_score\":%.2f,\"structural_preservation_score\":%.2f,"
         "\"choppy_protection_score\":%.2f,\"final_pullback_score\":%.2f}",
         g_symbol, Inp_MarketDNALookbackCandles,
         pullbackStruct.swingHighCount, pullbackStruct.swingLowCount,
         pullbackStruct.bullishTrendEvidence, pullbackStruct.bearishTrendEvidence, DirName(pullbackStruct.trendDirection),
         pullbackStruct.trendContextScore, pullbackStruct.precedingImpulsePips, pullbackStruct.retracementPips,
         pullbackStruct.retracementRatio, pullbackStruct.persistenceScore, pullbackStruct.structuralPreservationScore,
         pullbackStruct.choppyProtectionScore, pullbackStruct.finalScore);
      //--- 2026-08-25, explicit operator request: raw (pre-calibration) detail for
      //--- STRONG_UPTREND/STRONG_DOWNTREND/UPTREND/DOWNTREND, appended to this SAME raw block - same "raw" naming convention as the
      //--- five DNAs above. Calibrated scores + argmax outcome for these four are logged separately,
      //--- further below, in the post-argmax block (calibration/g_dnaState aren't known yet here).
      rawLine += StringFormat(
         ",\"strong_uptrend_detail\":{\"swing_high_count\":%d,\"swing_low_count\":%d,"
         "\"hh_score\":%.2f,\"hl_score\":%.2f,\"structural_continuity\":%.2f,\"pullback_score\":%.2f,"
         "\"evidence_confidence\":%.3f,\"structural_score\":%.2f,\"running_continuation_score\":%.2f,"
         "\"raw_score\":%.2f,\"latest_confirmed_hh\":%s,\"latest_confirmed_hl\":%s,"
         "\"hh_compliance\":%s,\"hl_compliance\":%s}",
         sh.swingHighCount, sh.swingLowCount, sh.hhScore, sh.hlScore, sh.structuralContinuity, sh.pullbackScore,
         sh.evidenceConfidence, sh.structuralScore, sh.runningContinuationScore, sh.rawScore,
         sh.haveLatestHH ? StringFormat("%.3f", sh.latestConfirmedHH) : "null",
         sh.haveLatestHL ? StringFormat("%.3f", sh.latestConfirmedHL) : "null",
         sh.hhComplianceJson, sh.hlComplianceJson);
      rawLine += StringFormat(
         ",\"strong_downtrend_detail\":{\"swing_high_count\":%d,\"swing_low_count\":%d,"
         "\"lh_score\":%.2f,\"ll_score\":%.2f,\"structural_continuity\":%.2f,\"pullback_score\":%.2f,"
         "\"evidence_confidence\":%.3f,\"structural_score\":%.2f,\"running_continuation_score\":%.2f,"
         "\"raw_score\":%.2f,\"latest_confirmed_lh\":%s,\"latest_confirmed_ll\":%s,"
         "\"lh_compliance\":%s,\"ll_compliance\":%s}",
         sd.swingHighCount, sd.swingLowCount, sd.lhScore, sd.llScore, sd.structuralContinuity, sd.pullbackScore,
         sd.evidenceConfidence, sd.structuralScore, sd.runningContinuationScore, sd.rawScore,
         sd.haveLatestLH ? StringFormat("%.3f", sd.latestConfirmedLH) : "null",
         sd.haveLatestLL ? StringFormat("%.3f", sd.latestConfirmedLL) : "null",
         sd.lhComplianceJson, sd.llComplianceJson);
      //--- 2026-09-08, explicit operator request (MARKET DNA STATE REMOVAL): the "uptrend_detail"/
      //--- "downtrend_detail" diagnostic blocks previously here are REMOVED - UPTREND/DOWNTREND are now
      //--- retired-compatibility states (hard-fixed scores[]=0.0, never dashboard-visible per the enum's
      //--- own header), so a detailed per-tick diagnostic decomposition of their (now-inert) scoring is
      //--- no longer meaningful production output. New production records never write these two fields
      //--- again; historical rows containing them are untouched (no destructive rewrite of
      //--- dna_raw_scores.jsonl).
      //--- 2026-09-04, explicit operator request (VOLATILE production upgrade): raw diagnostic
      //--- decomposition, appended to this SAME raw block, same pattern as every other structural DNA.
      //--- Field names match the NEW closed-M1 VolatileStructure (see EvaluateVolatileStructure() above)
      //--- - the retired rates[]/ci-based fields (avg_range_long/avg_range_ratio/flip_rate/
      //--- dispersion_score/running_included/running_high/running_low/running_close) are gone, not
      //--- aliased, since that formula no longer exists (it also structurally removed the shift-0
      //--- running-candle CopyRates() the old field names referenced). Full detail also written every
      //--- tick to the dedicated volatility_dna.jsonl via LogVolatilityDna() above (which also covers
      //--- VOL_EXPANSION/VOL_COMPRESSION).
      rawLine += StringFormat(
         ",\"volatile_detail\":{\"symbol\":\"%s\",\"timeframe\":\"M1\",\"contextBars\":%d,"
         "\"avgRelativeRange5\":%.4f,\"magnitudeScore\":%.2f,\"rangeVariabilityScore\":%.2f,"
         "\"directionalConsistencyScore\":%.2f,\"instabilityScore\":%.2f,\"participationScore\":%.2f,"
         "\"raw_volatile_score\":%.2f,"
         "\"existing_live_dna\":\"%s\",\"existing_live_score\":%.2f}",
         g_symbol, vol.contextBars,
         vol.avgRelativeRange5, vol.magnitudeScore, vol.rangeVariabilityScore,
         vol.directionalConsistencyScore, vol.instabilityScore, vol.participationScore, vol.finalScore,
         DnaName(g_dnaState), g_dnaScore);
      //--- 2026-09-04, explicit operator request (NEUTRAL production upgrade): raw diagnostic
      //--- decomposition, dedicated "neutral_detail" record, appended to this SAME raw block, same
      //--- pattern as volatile_detail/quiet_detail/range_detail/choppy_detail immediately above. Field
      //--- names match the NEW closed-M1 NeutralStructure (see EvaluateNeutralStructure() above) - the
      //--- retired rates[]/ci-based fields (sidewaysScore/lowMomentumScore/noBreakoutScore/nonTrendScore)
      //--- are gone, not aliased, since that formula no longer exists. Full detail also written every
      //--- tick to the dedicated neutral_dna.jsonl via LogNeutralDna() above.
      rawLine += StringFormat(
         ",\"neutral_detail\":{\"time\":\"%s\",\"symbol\":\"%s\",\"timeframe\":\"M1\",\"lookback\":%d,"
         "\"contextBars\":%d,\"lowNetDisplacementScore\":%.2f,\"directionalBalanceScore\":%.2f,"
         "\"effortBalanceScore\":%.2f,\"candleCharacterScore\":%.2f,\"volumePipRegime\":\"%s\","
         "\"volumePipScore\":%.2f,\"rawScore\":%.2f,"
         "\"existing_live_dna\":\"%s\",\"existing_live_score\":%.2f,\"allow_input_configured\":%s}",
         DashIsoTime(TimeCurrent()), g_symbol, Inp_MarketDNALookbackCandles,
         neutralStruct.contextBars, neutralStruct.lowNetDisplacementScore, neutralStruct.directionalBalanceScore,
         neutralStruct.effortBalanceScore, neutralStruct.candleCharacterScore, neutralStruct.volumePipRegime,
         neutralStruct.volumePipScore, neutralStruct.finalScore,
         DnaName(g_dnaState), g_dnaScore, Inp_Allow_Neutral ? "true" : "false");
      //--- 2026-09-04, explicit operator request (CHOPPY production upgrade): raw diagnostic
      //--- decomposition, dedicated "choppy_detail" record, appended to this SAME raw block, same
      //--- pattern as volatile_detail/quiet_detail/range_detail/neutral_detail immediately above. Field
      //--- names match the NEW closed-M1 ChoppyStructure (see EvaluateChoppyStructure() above) - the
      //--- retired rates[]/ci-based fields (reversalFrequency/nonTrendScore/longestRun/totalCandles) are
      //--- gone, not aliased, since that formula no longer exists. Full detail also written every tick
      //--- to the dedicated choppy_dna.jsonl via LogChoppyDna() above.
      rawLine += StringFormat(
         ",\"choppy_detail\":{\"time\":\"%s\",\"symbol\":\"%s\",\"timeframe\":\"M1\",\"lookback\":%d,"
         "\"contextBars\":%d,\"alternationCount\":%d,\"chopAlternationScore\":%.2f,"
         "\"directionalConsistencyScore\":%.2f,\"grossNetInefficiencyScore\":%.2f,\"fiveBarDisplacementScore\":%.2f,"
         "\"noiseScore\":%.2f,\"volumePipRegime\":\"%s\",\"volumePipScore\":%.2f,\"rawScore\":%.2f,"
         "\"existing_live_dna\":\"%s\",\"existing_live_score\":%.2f,\"allow_input_configured\":%s}",
         DashIsoTime(TimeCurrent()), g_symbol, Inp_MarketDNALookbackCandles,
         choppyStruct.contextBars, choppyStruct.alternationCount, choppyStruct.chopAlternationScore,
         choppyStruct.directionalConsistencyScore, choppyStruct.grossNetInefficiencyScore, choppyStruct.fiveBarDisplacementScore,
         choppyStruct.noiseScore, choppyStruct.volumePipRegime, choppyStruct.volumePipScore, choppyStruct.finalScore,
         DnaName(g_dnaState), g_dnaScore, Inp_Allow_Choppy ? "true" : "false");
      //--- 2026-09-08, explicit operator request (MARKET DNA STATE REMOVAL): the "expansion_detail"/
      //--- "compression_detail" diagnostic blocks previously here are REMOVED - EXPANSION/COMPRESSION
      //--- are fully-removed enum values, expansionStruct/compressionStruct no longer exist, and this
      //--- was their only consumer (dna_raw_scores.jsonl's diagnostic writer). New production records
      //--- never write these two fields again; historical rows containing them are untouched (no
      //--- destructive rewrite of dna_raw_scores.jsonl).
      rawLine += "}";
      DashAppendLine("dna_raw_scores.jsonl", rawLine);
     }

   //--- 2026-08-31, explicit operator request (STEP 2 FORENSIC COMPETITION AUDIT, Phase 3):
   //--- diagnostic-only snapshot of the RAW (pre-calibration) scores[] array, taken here because
   //--- CalibrateMarketDNAScores() below overwrites scores[] IN PLACE - this is the only point in
   //--- the file where both the raw and (shortly after) calibrated values for all 25 states exist
   //--- long enough to be captured. Pure copy, never read by anything upstream of this line, never
   //--- fed back into scores[]/argmax - see the full record write further below (after argmax) for
   //--- where this is actually used.
   double rawScoresSnapshot[LDNA_STATE_COUNT];
   for(int rsi=0; rsi<LDNA_STATE_COUNT; rsi++) rawScoresSnapshot[rsi] = scores[rsi];

   //--- Step 13, 2026-08-24: calibrate all raw scores onto a comparable scale (see
   //--- CalibrateMarketDNAScores()'s own header for the full method/justification) BEFORE the
   //--- winner-take-all argmax below. Winner-take-all architecture itself is unchanged - this is
   //--- still a strict argmax over the scores[LDNA_STATE_COUNT] array (25 doubles as of the
   //--- 2026-08-30 LIQUIDITY_HUNT removal), just calibrated ones now.
   CalibrateMarketDNAScores(scores);

   //--- 2026-09-04, explicit operator request (FULL MARKET DNA CONSOLIDATION): ARGMAX now iterates ONLY
   //--- ARGMAX_ACTIVE_DNA_STATES[] (the 15 active states), NOT the full LDNA_STATE_COUNT=18 range - the
   //--- 3 RETIRED-COMPATIBILITY states (STRONG_TREND/INSTITUTIONAL_BUYING/INSTITUTIONAL_SELLING) are
   //--- structurally excluded from winning, not merely relying on their scores[] being hard-fixed to 0.0
   //--- (per explicit instruction: "Do not rely merely on score=0 if a cleaner active-state list is
   //--- needed"). This is the ONLY change to the winner-take-all mechanism itself - still a strict
   //--- argmax, just scanning a 15-element list instead of the full 18-slot array.
   ENUM_LITE_DNA best = LDNA_NEUTRAL;
   double bestScore=-1.0;
   for(int ai=0;ai<LDNA_ACTIVE_STATE_COUNT;ai++)
     {
      ENUM_LITE_DNA i = ARGMAX_ACTIVE_DNA_STATES[ai];
      if(scores[i]>bestScore) { bestScore=scores[i]; best=i; }
     }
   g_dnaState = best;
   g_dnaScore = bestScore;

   //--- 2026-08-31, explicit operator request (STEP 2 FORENSIC COMPETITION AUDIT, Phase 3/4/5):
   //--- ONE new append-only diagnostic file, market_dna_competition.jsonl - a pure OBSERVER of
   //--- values already computed above (rawScoresSnapshot[]/scores[]/g_dnaState/g_dnaScore/best/
   //--- bestScore). Written AFTER argmax so g_dnaState/g_dnaScore are final for this cycle; does
   //--- NOT alter scores[], calibration, argmax, g_dnaState, g_dnaScore, CurrentRegimeAllowed(),
   //--- Minds, Entry Approval, re-entry, Trend-C, Opportunity Lifecycle, execution, or TP/SL - every
   //--- value below is read-only. Reuses the SAME dnaLogThisTick throttle already computed in the
   //--- raw-score block above (no new timer/state machine) so this file grows at the exact same
   //--- established 1/second-max cadence as dna_raw_scores.jsonl. Second-place is found by a second,
   //--- independent scan of the SAME already-calibrated scores[] array (no re-scoring, no duplicate
   //--- formula evaluation) - excludes the argmax winner's own index only.
   if(dnaLogThisTick)
     {
      int secondIdx = -1; double secondScore = -1.0;
      for(int sai=0; sai<LDNA_ACTIVE_STATE_COUNT; sai++)
        {
         int svi = (int)ARGMAX_ACTIVE_DNA_STATES[sai];
         if(svi==(int)best) continue;
         if(scores[svi]>secondScore) { secondScore=scores[svi]; secondIdx=svi; }
        }
      string compLine = StringFormat(
         "{\"time\":\"%s\",\"symbol\":\"%s\",\"timeframe\":\"M1\",\"lookback\":%d,\"runningIncluded\":%s,\"scores\":{",
         DashIsoTime(TimeCurrent()), g_symbol, Inp_MarketDNALookbackCandles, ci.runningIncluded ? "true" : "false");
      for(int cwi=0; cwi<LDNA_STATE_COUNT; cwi++)
         compLine += StringFormat("%s\"%s\":{\"raw\":%.3f,\"calibrated\":%.3f}",
            cwi>0?",":"", DnaName((ENUM_LITE_DNA)cwi), rawScoresSnapshot[cwi], scores[cwi]);
      compLine += StringFormat(
         "},\"winner\":\"%s\",\"winnerIndex\":%d,\"winnerScore\":%.3f,"
         "\"second\":\"%s\",\"secondIndex\":%d,\"secondScore\":%.3f,\"scoreMargin\":%.3f}",
         DnaName(best), (int)best, bestScore,
         secondIdx>=0 ? DnaName((ENUM_LITE_DNA)secondIdx) : "none", secondIdx, secondIdx>=0 ? secondScore : 0.0,
         secondIdx>=0 ? (bestScore-secondScore) : 0.0);
      DashAppendLine("market_dna_competition.jsonl", compLine);
     }

   //--- 2026-08-25, explicit operator request: STRONG_UPTREND/STRONG_DOWNTREND/UPTREND/DOWNTREND
   //--- CALIBRATED-score detail, logged AFTER g_dnaState/g_dnaScore/argmax above are final for this
   //--- cycle - reuses the SAME sh/sd/ut/dt struct instances computed earlier (no recomputation), and
   //--- reuses the SAME dnaLogThisTick throttle decision captured in the raw-score block above (both
   //--- blocks always log on the identical tick, no second independent timer). scores[LDNA_STRONG_UPTREND]
   //--- etc. are read here AFTER CalibrateMarketDNAScores() has already run (the z-score transform,
   //--- same formula every DNA goes through), so calibrated_score below is the real post-calibration
   //--- competitive value, distinct from the
   //--- raw_score already logged above. won_argmax makes the actual selection outcome unambiguous.
   //--- 2026-09-04, explicit operator request (STRONG_TREND integration): "raw_score" for
   //--- strong_uptrend/strong_downtrend below now logs the ACTUAL pre-calibration value that fed
   //--- scores[LDNA_STRONG_UPTREND]/[LDNA_STRONG_DOWNTREND] (structuralScore*0.80 + STRONG_TREND
   //--- confirmation*0.20) instead of the stale sh.rawScore/sd.rawScore (which still exist as struct
   //--- fields - kept for backward-compatible field access - but no longer equal what actually entered
   //--- calibration/argmax). Recomputed here from the same already-computed components above, not a
   //--- second independent formula.
   double strongUptrendActualRaw   = Clamp0to100(sh.structuralScore*0.80 + strongTrendUpConfirmation*0.20);
   double strongDowntrendActualRaw = Clamp0to100(sd.structuralScore*0.80 + strongTrendDownConfirmation*0.20);
   if(dnaLogThisTick)
     {
      string calLine = StringFormat(
         "{\"time\":\"%s\",\"type\":\"structural_dna_calibrated\",\"symbol\":\"%s\",\"timeframe\":\"M1\","
         "\"lookback\":%d,\"selected_live_dna\":\"%s\",\"selected_live_score\":%.2f,"
         "\"strong_uptrend\":{\"raw_score\":%.2f,\"calibrated_score\":%.2f,\"won_argmax\":%s,\"strongTrendUpConfirmation\":%.2f},"
         "\"strong_downtrend\":{\"raw_score\":%.2f,\"calibrated_score\":%.2f,\"won_argmax\":%s,\"strongTrendDownConfirmation\":%.2f},"
         "\"uptrend\":{\"raw_score\":%.2f,\"calibrated_score\":%.2f,\"won_argmax\":%s},"
         "\"downtrend\":{\"raw_score\":%.2f,\"calibrated_score\":%.2f,\"won_argmax\":%s}}",
         DashIsoTime(TimeCurrent()), g_symbol, Inp_MarketDNALookbackCandles,
         DnaName(g_dnaState), g_dnaScore,
         strongUptrendActualRaw,   scores[LDNA_STRONG_UPTREND],   (g_dnaState==LDNA_STRONG_UPTREND)   ? "true" : "false", strongTrendUpConfirmation,
         strongDowntrendActualRaw, scores[LDNA_STRONG_DOWNTREND], (g_dnaState==LDNA_STRONG_DOWNTREND) ? "true" : "false", strongTrendDownConfirmation,
         ut.rawScore, scores[LDNA_UPTREND],          (g_dnaState==LDNA_UPTREND)          ? "true" : "false",
         dt.rawScore, scores[LDNA_DOWNTREND],        (g_dnaState==LDNA_DOWNTREND)        ? "true" : "false");
      DashAppendLine("dna_raw_scores.jsonl", calLine);
     }
  }

//====================================================================
// 2026-09-16, M5 PARALLEL PIPELINE: EvaluateMarketDnaM5()
//
// A duplicate of EvaluateMarketDNA() above, retargeted to PERIOD_M5 and writing the M5-suffixed
// globals (g_ciM5/g_dnaStateM5/g_dnaScoreM5) instead of the M1 ones. Every classification formula
// (StrongTrendStructure, WeakTrendStructure, PullbackStructure, VolExpansion/VolCompression,
// ChoppyStructure, NeutralStructure, StrongUptrend/DowntrendShadow, calibration, argmax) is called
// UNCHANGED - these are the SAME pure/parameter-driven engines EvaluateMarketDNA() itself calls,
// just fed M5 windows here. Only the ONE internal CopyRates() call that hardcodes a timeframe
// (the dedicated strong-up/down-trend window fetch) is retargeted to PERIOD_M5. The M1 function's
// per-tick diagnostic writers (dna_raw_scores.jsonl/market_dna_competition.jsonl, all hardcoded
// "timeframe":"M1" and throttled off the M1-only g_dnaCalibLogLastTime) are DELIBERATELY NOT
// duplicated here - they are pure dashboard-diagnostic logging, not trading logic, and duplicating
// them risks corrupting the existing M1 diagnostic stream if a throttle/global were reused by
// mistake. This function's only externally-visible effect is publishing g_ciM5/g_dnaStateM5/
// g_dnaScoreM5 - never touches g_ci/g_dnaState/g_dnaScore or any M1 diagnostic file.
//====================================================================
void EvaluateMarketDnaM5(const MqlRates &rates[], const int n)
  {
   //--- 2026-09-23, explicit operator request ("currently we are using the 25 Bars for M5 DNA and Minds
   //--- votes can you make 15 Bars with same dna and minds algo"): k now derives from the dedicated
   //--- Inp_M5DnaMindsLookbackBars (15) instead of ResolveEffectiveDnaLookback() (the M1/session-driven
   //--- value this function used to silently reuse) - see that input's own header for the full
   //--- rationale. Same DNA algorithm (every engine below is unchanged), only the window size differs.
   int k = MathMin(Inp_M5DnaMindsLookbackBars, n);
   if(k<1) k=1;

   CandleIntelligence ci = EvaluateCandleIntelligenceM5(rates, n);
   g_ciM5 = ci; // published for the dashboard as "M5 DNA"

   //--- 2026-09-24, audit fix (D2, scoped): BOTH structural windows below now honor
   //--- Inp_M5DnaMindsLookbackBars, same as `k` immediately above already did - previously
   //--- BuildMarketDnaWindow30M5() hardcoded 30 M5 bars (ignoring the input entirely) and this one
   //--- hardcoded KMIE_SHORT_DNA_WINDOW_BARS=25, so setting Inp_M5DnaMindsLookbackBars=25 (or any other
   //--- value) changed almost nothing about M5's actual DNA read. CAVEAT (confirmed via the live audit):
   //--- EvaluatePullbackStructure() below requires this window to return >=25 bars or PULLBACK_UP/DOWN
   //--- fall back to an invalid/zero-evidence reading (the same calibration-floor issue fixed for M1 in
   //--- the DNA_PULLBACK_CUT rewrite) - do NOT lower Inp_M5DnaMindsLookbackBars below 25 without also
   //--- addressing that, left as a known follow-up, not fixed here.
   PriceRangeDnaResult strongTrendWin[];
   int strongTrendGotWin = BuildMarketDnaWindowN_M5(Inp_M5DnaMindsLookbackBars, strongTrendWin);
   StrongTrendStructure strongTrendStruct = EvaluateStrongTrendStructure(strongTrendWin, strongTrendGotWin);

   PriceRangeDnaResult shortDnaWin[];
   int shortDnaGotWin = BuildMarketDnaWindowN_M5(Inp_M5DnaMindsLookbackBars, shortDnaWin);

   WeakTrendStructure weakTrendStruct = EvaluateWeakTrendStructure(strongTrendWin, strongTrendGotWin);

   double scores[LDNA_STATE_COUNT];
   scores[LDNA_STRONG_TREND] = 0.0;
   scores[LDNA_WEAK_UPTREND]   = (weakTrendStruct.valid && weakTrendStruct.qualifies && weakTrendStruct.direction==LDIR_BUY)
      ? weakTrendStruct.finalScore : 0.0;
   scores[LDNA_WEAK_DOWNTREND] = (weakTrendStruct.valid && weakTrendStruct.qualifies && weakTrendStruct.direction==LDIR_SELL)
      ? weakTrendStruct.finalScore : 0.0;
   PullbackStructure pullbackStruct = EvaluatePullbackStructure(rates, k, shortDnaWin, shortDnaGotWin);
   scores[LDNA_PULLBACK_UP]   = (pullbackStruct.valid && pullbackStruct.trendDirection==LDIR_BUY)
      ? pullbackStruct.finalScore : 0.0;
   scores[LDNA_PULLBACK_DOWN] = (pullbackStruct.valid && pullbackStruct.trendDirection==LDIR_SELL)
      ? pullbackStruct.finalScore : 0.0;
   VolExpansionStructure volExpStruct = EvaluateVolExpansionStructure(shortDnaWin, shortDnaGotWin);
   VolCompressionStructure volCompStruct = EvaluateVolCompressionStructure(shortDnaWin, shortDnaGotWin);
   scores[LDNA_VOLATILITY_EXPANSION]   = volExpStruct.finalScore;
   scores[LDNA_VOLATILITY_COMPRESSION] = volCompStruct.finalScore;
   scores[LDNA_INSTITUTIONAL_BUYING]  = 0.0;
   scores[LDNA_INSTITUTIONAL_SELLING] = 0.0;
   ChoppyStructure choppyStruct = EvaluateChoppyStructure(shortDnaWin, shortDnaGotWin);
   scores[LDNA_CHOPPY] = choppyStruct.finalScore;
   NeutralStructure neutralStruct = EvaluateNeutralStructure(shortDnaWin, shortDnaGotWin);
   scores[LDNA_NEUTRAL] = neutralStruct.finalScore;

   //--- M5-retargeted dedicated strong-up/down-trend window fetch (PERIOD_M5, not PERIOD_M1).
   MqlRates strongUpDownRatesM5[];
   ArraySetAsSeries(strongUpDownRatesM5, true);
   int strongUpDownNM5 = CopyRates(g_symbol, PERIOD_M5, 1, KMIE_STRONG_UPDOWN_WINDOW_BARS, strongUpDownRatesM5);
   int kStrongUpDownM5 = MathMax(0, strongUpDownNM5);

   StrongUptrendShadow   sh = EvaluateStrongUptrendShadow(strongUpDownRatesM5, kStrongUpDownM5, ci);
   StrongDowntrendShadow sd = EvaluateStrongDowntrendShadow(strongUpDownRatesM5, kStrongUpDownM5, ci);

   double strongTrendUpConfirmation, strongTrendDownConfirmation;
   if(!strongTrendStruct.valid || strongTrendStruct.direction==LDIR_WAIT)
     {
      strongTrendUpConfirmation   = 50.0;
      strongTrendDownConfirmation = 50.0;
     }
   else
     {
      strongTrendUpConfirmation   = (strongTrendStruct.direction==LDIR_BUY)
         ? Clamp0to100(strongTrendStruct.finalScore)
         : Clamp0to100(100.0-strongTrendStruct.finalScore);
      strongTrendDownConfirmation = (strongTrendStruct.direction==LDIR_SELL)
         ? Clamp0to100(strongTrendStruct.finalScore)
         : Clamp0to100(100.0-strongTrendStruct.finalScore);
     }
   scores[LDNA_STRONG_UPTREND]   = Clamp0to100(sh.structuralScore*0.80 + strongTrendUpConfirmation*0.20);
   scores[LDNA_STRONG_DOWNTREND] = Clamp0to100(sd.structuralScore*0.80 + strongTrendDownConfirmation*0.20);
   scores[LDNA_UPTREND]          = 0.0;
   scores[LDNA_DOWNTREND]        = 0.0;

   VolatileStructure vol = EvaluateVolatileStructure(shortDnaWin, shortDnaGotWin);
   scores[LDNA_VOLATILE] = vol.finalScore;

   //--- 2026-09-16, live-verified bug fix (explicit operator report: "M5 only showing Volatility
   //--- Compressor in every candle"). ROOT CAUSE: CalibrateMarketDNAScores() z-scores every raw score
   //--- against g_dnaCalibMean[]/g_dnaCalibStdev[] - a table measured from a 96,355-bar CLOSED-M1
   //--- historical replay (see that array's own 2026-09-08 calibration-audit header). Several states
   //--- (STRONG_UPTREND/STRONG_DOWNTREND/PULLBACK_UP/PULLBACK_DOWN) carry REAL, tightly-measured M1
   //--- constants there, while VOLATILITY_COMPRESSION/VOLATILITY_EXPANSION/CHOPPY/NEUTRAL/WEAK_UPTREND/
   //--- WEAK_DOWNTREND still carry the generic mean=50.0/stdev=15.0 PLACEHOLDER (never measured, real or
   //--- otherwise). Applying this M1-fitted table to M5's raw scores - which have a structurally
   //--- different distribution (5-minute bars behave differently than 1-minute bars for the SAME
   //--- formulas) - pushed the tightly-calibrated directional states toward suppressed z-scores on data
   //--- they were never measured against, while VOLATILITY_COMPRESSION's loose, untouched placeholder
   //--- barely reacted - letting it win the argmax almost regardless of real M5 price action (live-
   //--- confirmed: g_dnaStateM5 stuck at VOLATILITY_COMPRESSION across multiple ticks while g_dnaState
   //--- (M1) moved freely). FIX (interim, confirmed via AskUserQuestion - a full M5-specific calibration
   //--- table, measured from a genuine M5 historical replay, is a larger follow-up task, not done here):
   //--- CalibrateMarketDNAScores() is skipped entirely for M5 - the argmax below runs directly on the
   //--- RAW (pre-calibration) scores[], removing the M1-calibration bias completely rather than trying to
   //--- patch it. This makes M5's argmax genuinely comparable across its own states again, at the cost of
   //--- losing z-score normalization's "put every state on the same 0-100 scale" benefit until a real
   //--- M5-measured table exists. g_dnaScoreM5 will therefore read on a different, RAW scale than
   //--- g_dnaScore (M1, still calibrated) - this is disclosed here, not silently mismatched.
   ENUM_LITE_DNA best = LDNA_NEUTRAL;
   double bestScore=-1.0;
   for(int ai=0;ai<LDNA_ACTIVE_STATE_COUNT;ai++)
     {
      ENUM_LITE_DNA i = ARGMAX_ACTIVE_DNA_STATES[ai];
      if(scores[i]>bestScore) { bestScore=scores[i]; best=i; }
     }
   g_dnaStateM5 = best;
   g_dnaScoreM5 = bestScore;
  }

//====================================================================
// 2026-09-23, M15 PARALLEL PIPELINE: EvaluateMarketDnaM15()
//
// A duplicate of EvaluateMarketDNA()/EvaluateMarketDnaM5() above, retargeted to PERIOD_M15 and writing
// the M15-suffixed globals (g_ciM15/g_dnaStateM15/g_dnaScoreM15) instead of the M1/M5 ones. Every
// classification formula (StrongTrendStructure, WeakTrendStructure, PullbackStructure, VolExpansion/
// VolCompression, ChoppyStructure, NeutralStructure, StrongUptrend/DowntrendShadow, argmax) is called
// UNCHANGED - these are the SAME pure/parameter-driven engines EvaluateMarketDNA()/EvaluateMarketDnaM5()
// themselves call, just fed M15 windows here. Only the ONE internal CopyRates() call that hardcodes a
// timeframe (the dedicated strong-up/down-trend window fetch) is retargeted to PERIOD_M15. Mirroring the
// M5 twin's own 2026-09-16 live-verified bug fix, CalibrateMarketDNAScores() (M1-fitted z-score table) is
// likewise SKIPPED here - the argmax runs directly on RAW (pre-calibration) scores[], for the identical
// reason: the M1-measured calibration table would be even less representative of M15's own raw-score
// distribution than M5's. g_dnaScoreM15 therefore reads on the same RAW scale as g_dnaScoreM5, NOT the
// calibrated scale g_dnaScore (M1) uses - disclosed here, not silently mismatched. This function's only
// externally-visible effect is publishing g_ciM15/g_dnaStateM15/g_dnaScoreM15 - never touches g_ci/
// g_dnaState/g_dnaScore, g_ciM5/g_dnaStateM5/g_dnaScoreM5, or any M1/M5 diagnostic file.
//====================================================================
void EvaluateMarketDnaM15(const MqlRates &rates[], const int n)
  {
   //--- 2026-09-23, explicit operator request (M15 PARALLEL PIPELINE): k derives from the dedicated,
   //--- fixed Inp_M15DnaMindsLookbackBars (8) - never ResolveEffectiveDnaLookback() (M1/session-driven)
   //--- and never Inp_M5DnaMindsLookbackBars (M5's own dedicated lookback) - see that input's own header
   //--- for the full rationale. Same DNA algorithm (every engine below is unchanged), only the window
   //--- size differs.
   int k = MathMin(Inp_M15DnaMindsLookbackBars, n);
   if(k<1) k=1;

   CandleIntelligence ci = EvaluateCandleIntelligenceM15(rates, n);
   g_ciM15 = ci; // published for the dashboard as "M15 DNA"

   PriceRangeDnaResult strongTrendWin[];
   int strongTrendGotWin = BuildMarketDnaWindow30M15(strongTrendWin);
   StrongTrendStructure strongTrendStruct = EvaluateStrongTrendStructure(strongTrendWin, strongTrendGotWin);

   PriceRangeDnaResult shortDnaWin[];
   int shortDnaGotWin = BuildMarketDnaWindowN_M15(KMIE_SHORT_DNA_WINDOW_BARS, shortDnaWin);

   WeakTrendStructure weakTrendStruct = EvaluateWeakTrendStructure(strongTrendWin, strongTrendGotWin);

   double scores[LDNA_STATE_COUNT];
   scores[LDNA_STRONG_TREND] = 0.0;
   scores[LDNA_WEAK_UPTREND]   = (weakTrendStruct.valid && weakTrendStruct.qualifies && weakTrendStruct.direction==LDIR_BUY)
      ? weakTrendStruct.finalScore : 0.0;
   scores[LDNA_WEAK_DOWNTREND] = (weakTrendStruct.valid && weakTrendStruct.qualifies && weakTrendStruct.direction==LDIR_SELL)
      ? weakTrendStruct.finalScore : 0.0;
   PullbackStructure pullbackStruct = EvaluatePullbackStructure(rates, k, shortDnaWin, shortDnaGotWin);
   scores[LDNA_PULLBACK_UP]   = (pullbackStruct.valid && pullbackStruct.trendDirection==LDIR_BUY)
      ? pullbackStruct.finalScore : 0.0;
   scores[LDNA_PULLBACK_DOWN] = (pullbackStruct.valid && pullbackStruct.trendDirection==LDIR_SELL)
      ? pullbackStruct.finalScore : 0.0;
   VolExpansionStructure volExpStruct = EvaluateVolExpansionStructure(shortDnaWin, shortDnaGotWin);
   VolCompressionStructure volCompStruct = EvaluateVolCompressionStructure(shortDnaWin, shortDnaGotWin);
   scores[LDNA_VOLATILITY_EXPANSION]   = volExpStruct.finalScore;
   scores[LDNA_VOLATILITY_COMPRESSION] = volCompStruct.finalScore;
   scores[LDNA_INSTITUTIONAL_BUYING]  = 0.0;
   scores[LDNA_INSTITUTIONAL_SELLING] = 0.0;
   ChoppyStructure choppyStruct = EvaluateChoppyStructure(shortDnaWin, shortDnaGotWin);
   scores[LDNA_CHOPPY] = choppyStruct.finalScore;
   NeutralStructure neutralStruct = EvaluateNeutralStructure(shortDnaWin, shortDnaGotWin);
   scores[LDNA_NEUTRAL] = neutralStruct.finalScore;

   //--- M15-retargeted dedicated strong-up/down-trend window fetch (PERIOD_M15, not PERIOD_M1/PERIOD_M5).
   MqlRates strongUpDownRatesM15[];
   ArraySetAsSeries(strongUpDownRatesM15, true);
   int strongUpDownNM15 = CopyRates(g_symbol, PERIOD_M15, 1, KMIE_STRONG_UPDOWN_WINDOW_BARS, strongUpDownRatesM15);
   int kStrongUpDownM15 = MathMax(0, strongUpDownNM15);

   StrongUptrendShadow   sh = EvaluateStrongUptrendShadow(strongUpDownRatesM15, kStrongUpDownM15, ci);
   StrongDowntrendShadow sd = EvaluateStrongDowntrendShadow(strongUpDownRatesM15, kStrongUpDownM15, ci);

   double strongTrendUpConfirmation, strongTrendDownConfirmation;
   if(!strongTrendStruct.valid || strongTrendStruct.direction==LDIR_WAIT)
     {
      strongTrendUpConfirmation   = 50.0;
      strongTrendDownConfirmation = 50.0;
     }
   else
     {
      strongTrendUpConfirmation   = (strongTrendStruct.direction==LDIR_BUY)
         ? Clamp0to100(strongTrendStruct.finalScore)
         : Clamp0to100(100.0-strongTrendStruct.finalScore);
      strongTrendDownConfirmation = (strongTrendStruct.direction==LDIR_SELL)
         ? Clamp0to100(strongTrendStruct.finalScore)
         : Clamp0to100(100.0-strongTrendStruct.finalScore);
     }
   scores[LDNA_STRONG_UPTREND]   = Clamp0to100(sh.structuralScore*0.80 + strongTrendUpConfirmation*0.20);
   scores[LDNA_STRONG_DOWNTREND] = Clamp0to100(sd.structuralScore*0.80 + strongTrendDownConfirmation*0.20);
   scores[LDNA_UPTREND]          = 0.0;
   scores[LDNA_DOWNTREND]        = 0.0;

   VolatileStructure vol = EvaluateVolatileStructure(shortDnaWin, shortDnaGotWin);
   scores[LDNA_VOLATILE] = vol.finalScore;

   //--- 2026-09-23, mirroring the M5 twin's 2026-09-16 live-verified bug fix: CalibrateMarketDNAScores()
   //--- is skipped entirely for M15 too - the argmax below runs directly on the RAW (pre-calibration)
   //--- scores[], for the same reason the M5 twin gives (the M1-measured calibration table does not
   //--- represent M15's own raw-score distribution any better than it represents M5's).
   ENUM_LITE_DNA best = LDNA_NEUTRAL;
   double bestScore=-1.0;
   for(int ai=0;ai<LDNA_ACTIVE_STATE_COUNT;ai++)
     {
      ENUM_LITE_DNA i = ARGMAX_ACTIVE_DNA_STATES[ai];
      if(scores[i]>bestScore) { bestScore=scores[i]; best=i; }
     }
   g_dnaStateM15 = best;
   g_dnaScoreM15 = bestScore;
  }

//====================================================================
// ENTRY INTELLIGENCE - STEP 1: ACTIVE LEG + PULLBACK EXTREME (observational only)
//
// 2026-08-21, explicit operator request. Tracks a persistent "active leg" for the EA's own
// current 18-Mind Vote direction (g_mindsVoteDir) - the highest price reached since the leg
// began for BUY, the lowest for SELL - and, once price retreats from that extreme, a separate
// "pullback extreme" (the deepest point of the retracement so far).
//
// Uses g_ci.newestClose (Stage 1a's own "current price" - the live running candle's close when
// available, else the last closed candle's close) as the single price series. A cycle is either
// a new leg extreme OR a pullback observation, never both, since one price cannot be simultaneously
// beyond and behind the tracked extreme.
//
// Reset rules (the ONLY reset triggers in Step 1):
//   - no active leg yet for the current direction -> initialize a fresh leg
//   - direction flips (BUY<->SELL)                -> invalidate old leg, initialize a fresh leg
// WAIT preserves whatever leg/pullback state already exists, untouched.
// Once a pullback starts, its state stays ACTIVE (and its extreme keeps updating on new pullback
// extremes) until the NEXT direction flip - it is not cleared just because price recovers toward
// the leg's extreme again. Resumption/retracement-% logic is explicitly deferred to a later step.
//
// OBSERVATIONAL ONLY: this function never reads MaybeExecute()'s gates and is never read BY them -
// it has no return value and no side effect outside g_activeLeg/g_pullback and diagnostic logging.
//====================================================================
void EvaluateEntryIntelligence()
  {
   if(g_ci.newestClose<=0.0) return; // data integrity guard - Stage 1a hasn't published a valid price yet

   datetime curBarTime = iTime(g_symbol, PERIOD_M1, 0);
   if(curBarTime<=0) return; // data integrity guard - no current M1 bar available

   ENUM_LITE_DIR dir = g_mindsVoteDir;
   double currentPrice = g_ci.newestClose;

   if(dir==LDIR_WAIT)
      return; // WAIT: preserve existing active-leg/pullback state exactly as-is

   //--- No active leg yet for this direction, OR direction just flipped -> (re)initialize a fresh leg.
   if(!g_activeLeg.active || g_activeLeg.direction!=dir)
     {
      bool          wasActive = g_activeLeg.active;
      ENUM_LITE_DIR prevDir   = g_activeLeg.direction;

      g_activeLeg.active       = true;
      g_activeLeg.direction    = dir;
      g_activeLeg.originPrice  = currentPrice;
      g_activeLeg.originTime   = curBarTime;
      g_activeLeg.extremePrice = currentPrice;
      g_activeLeg.extremeTime  = curBarTime;

      g_pullback.state        = LPB_NONE;
      g_pullback.extremePrice = 0.0;
      g_pullback.extremeTime  = 0;
      g_pullback.activatedTime = 0;

      if(wasActive && prevDir!=dir)
         Print(StringFormat("[ENTRY_INTEL][DIRECTION_CHANGE] %s -> %s | old leg invalidated, new leg initialized",
               DirName(prevDir), DirName(dir)));

      Print(StringFormat("[ENTRY_INTEL][NEW_ACTIVE_LEG] direction=%s origin=%.3f extreme=%.3f",
            DirName(dir), g_activeLeg.originPrice, g_activeLeg.extremePrice));
      return;
     }

   //--- Leg already active in this direction: either the leg extends its extreme, or price is in
   //--- pullback territory relative to that extreme - never both in the same cycle.
   if(dir==LDIR_BUY)
     {
      if(currentPrice>g_activeLeg.extremePrice)
        {
         g_activeLeg.extremePrice = currentPrice;
         g_activeLeg.extremeTime  = curBarTime;
         Print(StringFormat("[ENTRY_INTEL][ACTIVE_LEG_EXTREME_UPDATED] direction=BUY extreme=%.3f range=%.3f",
               g_activeLeg.extremePrice, g_activeLeg.extremePrice-g_activeLeg.originPrice));
        }
      //--- 2026-09-03, explicit operator request ("reverse back Like Pull Back, Resumtion"): the
      //--- 2026-09-02 disable (Pullback/Resumption/Micro Resumption/Entry Approval's PULLBACK path all
      //--- permanently forced off) is fully reverted here - restored to the exact original logic.
      else if(currentPrice<g_activeLeg.extremePrice)
        {
         if(g_pullback.state==LPB_NONE)
           {
            g_pullback.state        = LPB_ACTIVE;
            g_pullback.extremePrice = currentPrice;
            g_pullback.extremeTime  = curBarTime;
            g_pullback.activatedTime = curBarTime;
            Print(StringFormat("[ENTRY_INTEL][PULLBACK_START] direction=BUY activeExtreme=%.3f price=%.3f",
                  g_activeLeg.extremePrice, currentPrice));
           }
         else if(currentPrice<g_pullback.extremePrice)
           {
            g_pullback.extremePrice = currentPrice;
            g_pullback.extremeTime  = curBarTime;
            Print(StringFormat("[ENTRY_INTEL][PULLBACK_EXTREME] direction=BUY pullbackLow=%.3f", g_pullback.extremePrice));
           }
        }
     }
   else // LDIR_SELL
     {
      if(currentPrice<g_activeLeg.extremePrice)
        {
         g_activeLeg.extremePrice = currentPrice;
         g_activeLeg.extremeTime  = curBarTime;
         Print(StringFormat("[ENTRY_INTEL][ACTIVE_LEG_EXTREME_UPDATED] direction=SELL extreme=%.3f range=%.3f",
               g_activeLeg.extremePrice, g_activeLeg.originPrice-g_activeLeg.extremePrice));
        }
      //--- 2026-09-03, explicit operator request ("reverse back Like Pull Back, Resumtion"): SELL-side
      //--- mirror of the same full revert - see the matching BUY-side comment above.
      else if(currentPrice>g_activeLeg.extremePrice)
        {
         if(g_pullback.state==LPB_NONE)
           {
            g_pullback.state        = LPB_ACTIVE;
            g_pullback.extremePrice = currentPrice;
            g_pullback.extremeTime  = curBarTime;
            g_pullback.activatedTime = curBarTime;
            Print(StringFormat("[ENTRY_INTEL][PULLBACK_START] direction=SELL activeExtreme=%.3f price=%.3f",
                  g_activeLeg.extremePrice, currentPrice));
           }
         else if(currentPrice>g_pullback.extremePrice)
           {
            g_pullback.extremePrice = currentPrice;
            g_pullback.extremeTime  = curBarTime;
            Print(StringFormat("[ENTRY_INTEL][PULLBACK_EXTREME] direction=SELL pullbackHigh=%.3f", g_pullback.extremePrice));
           }
        }
     }
  }

//====================================================================
// ENTRY INTELLIGENCE - STEP 2: RESUMPTION % + 80% EXECUTION WINDOW (observational only)
//
// 2026-08-21, explicit operator request. Consumes Step 1's g_activeLeg/g_pullback exactly as
// published - never recomputes the leg or the pullback extreme itself. Answers only "how far has
// price recovered from the pullback extreme back toward the active-leg extreme," expressed as a
// percentage of the pullback's own range (NOT the same measurement as retracement depth).
//
// BUY:  ResumptionPercent = (CurrentPrice - PullbackLow) / (ActiveHigh - PullbackLow) * 100
// SELL: ResumptionPercent = (PullbackHigh - CurrentPrice) / (PullbackHigh - ActiveLow) * 100
// (formula itself unchanged by the 2026-08-21 Step 10 threshold update below)
//
// rawPercent is intentionally UNCLAMPED - it can read below 0% (price broke back below the
// pullback extreme) or above 100% (price broke past the active-leg extreme); both are structurally
// meaningful and are not hidden. "valid=false" means the measurement is not currently computable
// at all (no active leg, no active pullback, or a zero/negative denominator) - this is a distinct
// state from 0%, which is a legitimate computed result (price sitting exactly at the pullback low).
//
// window is a pure classification of rawPercent (<=80 vs >80, inclusive at exactly 80.0 - Step 10,
// 2026-08-21 explicit operator request, raised from the original 50.0) with NO effect on execution -
// RESUMPTION_OVER_80 is only ever logged/displayed, never read by MaybeExecute() or any gate.
//====================================================================
string ResumptionWindowName(const ENUM_LITE_RESUMPTION_WINDOW w)
  {
   switch(w)
     {
      case RESUMPTION_0_TO_80: return "0_TO_80";
      case RESUMPTION_OVER_80: return "OVER_80";
      default:                 return "NO_PULLBACK";
     }
  }

void EvaluateResumption()
  {
   static bool                        wasValid   = false;
   static ENUM_LITE_RESUMPTION_WINDOW lastWindow = RESUMPTION_NO_PULLBACK;

   bool                        valid      = false;
   double                      rawPct     = 0.0;
   double                      boundary80 = 0.0;
   ENUM_LITE_RESUMPTION_WINDOW window     = RESUMPTION_NO_PULLBACK;
   double                      depthPct   = 0.0;
   bool                        tooDeep    = false;

   //--- Validity guards: active leg must exist, a pullback must currently be active, and the
   //--- current price (Step 1's own source, g_ci.newestClose) must be a real published value.
   if(g_activeLeg.active && g_pullback.state==LPB_ACTIVE && g_ci.newestClose>0.0)
     {
      double currentPrice = g_ci.newestClose; // same price source as Step 1 - kept swappable via this one line

      if(g_activeLeg.direction==LDIR_BUY)
        {
         double activeHigh  = g_activeLeg.extremePrice;
         double pullbackLow = g_pullback.extremePrice;
         double denom       = activeHigh - pullbackLow;
         if(denom>0.0)
           {
            rawPct     = ((currentPrice-pullbackLow)/denom)*100.0;
            boundary80 = pullbackLow + (denom*0.80);
            valid      = true;
           }

         //--- 2026-08-24, explicit operator request: OPPOSITE-direction metric - how deep the
         //--- pullback (a move AGAINST the BUY vote) has cut into the active leg's own range
         //--- (origin -> extreme), independent of the resumption denom above.
         double legRange = activeHigh - g_activeLeg.originPrice;
         if(legRange>0.0)
            depthPct = ((activeHigh-currentPrice)/legRange)*100.0;
        }
      else if(g_activeLeg.direction==LDIR_SELL)
        {
         double pullbackHigh = g_pullback.extremePrice;
         double activeLow    = g_activeLeg.extremePrice;
         double denom        = pullbackHigh - activeLow;
         if(denom>0.0)
           {
            rawPct     = ((pullbackHigh-currentPrice)/denom)*100.0;
            boundary80 = pullbackHigh - (denom*0.80);
            valid      = true;
           }

         //--- OPPOSITE-direction metric for SELL: how deep the pullback (a move AGAINST the SELL
         //--- vote, i.e. upward) has cut into the active leg's own range (origin -> extreme).
         double legRange = g_activeLeg.originPrice - activeLow;
         if(legRange>0.0)
            depthPct = ((currentPrice-activeLow)/legRange)*100.0;
        }
      //--- denom<=0.0 (degenerate/zero-range leg) intentionally falls through with valid=false.
     }

   tooDeep = valid && (depthPct>80.0);

   //--- Step 10, 2026-08-21 explicit operator request: execution window raised from <=50.0 to
   //--- <=80.0, inclusive at exactly 80.0 (rawPct<=80.0, not <80.0). Formula above is UNCHANGED.
   //--- 2026-08-24: this window/rawPercent classification is now DISPLAY/TELEMETRY ONLY - it no
   //--- longer gates entry (see pullbackDepthPercent/pullbackTooDeep below, which does).
   window = valid ? (rawPct<=80.0 ? RESUMPTION_0_TO_80 : RESUMPTION_OVER_80) : RESUMPTION_NO_PULLBACK;

   g_resumption.valid                = valid;
   g_resumption.rawPercent           = rawPct;
   g_resumption.boundary80Price      = boundary80;
   g_resumption.window               = window;
   g_resumption.pullbackDepthPercent = depthPct;
   g_resumption.pullbackTooDeep      = tooDeep;

   if(valid && !wasValid)
      Print(StringFormat("[ENTRY_INTEL][RESUMPTION] PULLBACK EXTREME AVAILABLE - direction=%s pullbackExtreme=%.3f | resumption measurement now active",
            DirName(g_activeLeg.direction), g_pullback.extremePrice));

   //--- Log on every window transition (covers "80% boundary reached" / ">80% crossed"), and once
   //--- more on the very first valid reading for this pullback (covers "resumption start").
   if(valid && (window!=lastWindow || !wasValid))
      Print(StringFormat("[ENTRY_INTEL][RESUMPTION] direction=%s activeExtreme=%.3f pullbackExtreme=%.3f currentPrice=%.3f resumptionPct=%.2f boundary80=%.3f window=%s",
            DirName(g_activeLeg.direction), g_activeLeg.extremePrice, g_pullback.extremePrice, g_ci.newestClose,
            rawPct, boundary80, ResumptionWindowName(window)));

   wasValid   = valid;
   lastWindow = window;
  }

//====================================================================
// ENTRY INTELLIGENCE - STEP 3: MICRO RESUMPTION (observational only)
//
// 2026-08-21, explicit operator request. Answers "has price structurally resumed" - not merely
// "has price moved away from the pullback extreme." Deterministic price-structure state machine,
// no indicators, no recomputation of Step 1/Step 2 values.
//
// TRACKING: since the pullback extreme (or since this structure was last (re)built), running
//   recovery extreme = highest price seen (BUY) / lowest price seen (SELL). Every new extreme just
//   extends this running high/low - no micro top/bottom exists yet.
// ESTABLISHED: the first time price pulls back off that running extreme (BUY: price dips below the
//   tracked high; SELL: price ticks above the tracked low), that running extreme becomes the fixed
//   MICRO HIGH/LOW trigger level - a real local turning point was left behind, not just noise.
// CONFIRMED (terminal): price breaks back through the established micro level (BUY: above microHigh;
//   SELL: below microLow) - the structural resumption event. Logged once; never re-fired.
//
// Rebuilt from scratch only when: no pullback is active, direction changes, or Step 1's own pullback
// extreme moves further (stale-structure guard) - never on ordinary tick-to-tick price movement.
//====================================================================
string MicroStateName(const ENUM_LITE_MICRO_STATE s)
  {
   switch(s)
     {
      case MICRO_TRACKING:
      case MICRO_ESTABLISHED: return "TRACKING";
      case MICRO_CONFIRMED:   return "CONFIRMED";
      default:                return "WAIT";
     }
  }

string MicroModeName(const ENUM_LITE_MICRO_MODE m)
  {
   return (m==MICRO_MODE_CONTINUATION) ? "CONTINUATION" : (m==MICRO_MODE_PULLBACK) ? "PULLBACK" : "NONE";
  }

void ResetMicroResumptionState()
  {
   g_microResumption.state                       = MICRO_NONE;
   g_microResumption.mode                         = MICRO_MODE_NONE;
   g_microResumption.direction                    = LDIR_WAIT;
   g_microResumption.basePullbackExtreme           = 0.0;
   g_microResumption.recoveryExtreme                = 0.0;
   g_microResumption.recoveryExtremeTime             = 0;
   g_microResumption.microHigh                        = 0.0;
   g_microResumption.microLow                          = 0.0;
   g_microResumption.microExtremeTime                   = 0;
   g_microResumption.confirmed                            = false;
   g_microResumption.breakPrice                             = 0.0;
   g_microResumption.breakTime                               = 0;
   g_microResumption.microBreakResumptionPercent              = 0.0;
  }

//--- 2026-08-21, Continuation Engine correction (explicit operator request): TWO EXPLICIT MICRO
//--- MODES. PULLBACK MODE is the original engine, byte-for-byte behaviorally unchanged - it still
//--- requires g_pullback.state==LPB_ACTIVE and anchors to g_pullback.extremePrice. CONTINUATION MODE
//--- is new: it activates precisely when there is NO active pullback (g_activeLeg.active alone is
//--- enough), anchors to g_activeLeg.extremePrice instead, and runs through the exact same
//--- TRACKING->ESTABLISHED->CONFIRMED state machine below - no separate confirmation logic, no new
//--- indicator, no percentage threshold. A real micro high/low must still be established and broken;
//--- price simply moving in the leg's direction is never sufficient (see the unchanged BUY/SELL
//--- processing block further down, which both modes share identically).
void EvaluateMicroResumption()
  {
   datetime curBarTime   = iTime(g_symbol, PERIOD_M1, 0);
   double   currentPrice = g_ci.newestClose; // same price source as Step 1/Step 2

   bool legAvailable = (g_activeLeg.active && g_activeLeg.direction!=LDIR_WAIT && currentPrice>0.0 && curBarTime>0);

   if(!legAvailable)
     {
      if(g_microResumption.state!=MICRO_NONE)
         Print("[ENTRY_INTEL][MICRO_RESUMPTION] state reset to NONE (no active leg)");
      ResetMicroResumptionState();
      return;
     }

   ENUM_LITE_DIR         dir          = g_activeLeg.direction;
   bool                  pullbackActive = (g_pullback.state==LPB_ACTIVE);
   ENUM_LITE_MICRO_MODE  desiredMode  = pullbackActive ? MICRO_MODE_PULLBACK : MICRO_MODE_CONTINUATION;
   //--- The anchor: PULLBACK MODE uses g_pullback.extremePrice (UNCHANGED). CONTINUATION MODE uses
   //--- g_activeLeg.extremePrice instead, since no pullback extreme exists in this mode.
   double anchor = pullbackActive ? g_pullback.extremePrice : g_activeLeg.extremePrice;

   bool directionChanged = (g_microResumption.state!=MICRO_NONE && g_microResumption.direction!=dir);
   bool modeChanged      = (g_microResumption.state!=MICRO_NONE && g_microResumption.mode!=desiredMode);
   bool anchorExtended   = false;
   if(g_microResumption.state!=MICRO_NONE && !directionChanged && !modeChanged)
     {
      if(dir==LDIR_BUY  && anchor<g_microResumption.basePullbackExtreme-_Point*0.1) anchorExtended=true;
      if(dir==LDIR_SELL && anchor>g_microResumption.basePullbackExtreme+_Point*0.1) anchorExtended=true;
     }

   //--- (Re)initialize: first observation, a direction flip, a mode switch (e.g. a pullback just
   //--- started for a leg that was previously in Continuation Mode - no stale continuation structure
   //--- may carry over into Pullback Mode, or vice versa), or the current mode's own anchor moved
   //--- further (the prior micro structure is now stale/inconsistent).
   if(g_microResumption.state==MICRO_NONE || directionChanged || modeChanged || anchorExtended)
     {
      if(directionChanged)
         Print(StringFormat("[ENTRY_INTEL][MICRO_RESUMPTION] direction change %s -> %s | micro structure invalidated, restarting",
               DirName(g_microResumption.direction), DirName(dir)));
      else if(modeChanged)
         Print(StringFormat("[ENTRY_INTEL][MICRO_RESUMPTION] mode switch %s -> %s | micro structure rebuilt for the new mode",
               MicroModeName(g_microResumption.mode), MicroModeName(desiredMode)));
      else if(anchorExtended)
         Print(StringFormat("[ENTRY_INTEL][MICRO_RESUMPTION] anchor extended (was %.3f now %.3f) | stale micro structure discarded, restarting",
               g_microResumption.basePullbackExtreme, anchor));

      ResetMicroResumptionState();
      g_microResumption.state               = MICRO_TRACKING;
      g_microResumption.mode                = desiredMode;
      g_microResumption.direction           = dir;
      g_microResumption.basePullbackExtreme = anchor;
      g_microResumption.recoveryExtreme     = currentPrice;
      g_microResumption.recoveryExtremeTime = curBarTime;

      Print(StringFormat("[ENTRY_INTEL][MICRO_RESUMPTION] recovery tracking started - mode=%s direction=%s anchor=%.3f price=%.3f",
            MicroModeName(desiredMode), DirName(dir), anchor, currentPrice));
      return;
     }

   //--- Normal per-tick processing of the existing, still-consistent micro structure.
   if(dir==LDIR_BUY)
     {
      if(g_microResumption.state==MICRO_TRACKING)
        {
         if(currentPrice>g_microResumption.recoveryExtreme)
           {
            g_microResumption.recoveryExtreme     = currentPrice;
            g_microResumption.recoveryExtremeTime = curBarTime;
           }
         else if(currentPrice<g_microResumption.recoveryExtreme)
           {
            g_microResumption.microHigh        = g_microResumption.recoveryExtreme;
            g_microResumption.microExtremeTime = g_microResumption.recoveryExtremeTime;
            g_microResumption.state            = MICRO_ESTABLISHED;
            Print(StringFormat("[ENTRY_INTEL][MICRO_RESUMPTION] MICRO_HIGH ESTABLISHED mode=%s direction=BUY microHigh=%.3f price=%.3f",
                  MicroModeName(g_microResumption.mode), g_microResumption.microHigh, currentPrice));
           }
        }
      else if(g_microResumption.state==MICRO_ESTABLISHED && currentPrice>g_microResumption.microHigh)
        {
         g_microResumption.confirmed                  = true;
         g_microResumption.breakPrice                 = currentPrice;
         g_microResumption.breakTime                  = curBarTime;
         g_microResumption.microBreakResumptionPercent = g_resumption.valid ? g_resumption.rawPercent : 0.0;
         g_microResumption.state                       = MICRO_CONFIRMED;
         Print(StringFormat("[ENTRY_INTEL][MICRO_RESUMPTION] mode=%s direction=BUY anchor=%.3f microHigh=%.3f breakPrice=%.3f resumptionPct=%.2f boundary80=%.3f window=%s confirmed=TRUE",
               MicroModeName(g_microResumption.mode), g_microResumption.basePullbackExtreme, g_microResumption.microHigh, g_microResumption.breakPrice,
               g_microResumption.microBreakResumptionPercent, g_resumption.boundary80Price, ResumptionWindowName(g_resumption.window)));
        }
      //--- MICRO_CONFIRMED is terminal for this structure - no further action, no re-logging.
     }
   else // LDIR_SELL
     {
      if(g_microResumption.state==MICRO_TRACKING)
        {
         if(currentPrice<g_microResumption.recoveryExtreme)
           {
            g_microResumption.recoveryExtreme     = currentPrice;
            g_microResumption.recoveryExtremeTime = curBarTime;
           }
         else if(currentPrice>g_microResumption.recoveryExtreme)
           {
            g_microResumption.microLow         = g_microResumption.recoveryExtreme;
            g_microResumption.microExtremeTime = g_microResumption.recoveryExtremeTime;
            g_microResumption.state            = MICRO_ESTABLISHED;
            Print(StringFormat("[ENTRY_INTEL][MICRO_RESUMPTION] MICRO_LOW ESTABLISHED mode=%s direction=SELL microLow=%.3f price=%.3f",
                  MicroModeName(g_microResumption.mode), g_microResumption.microLow, currentPrice));
           }
        }
      else if(g_microResumption.state==MICRO_ESTABLISHED && currentPrice<g_microResumption.microLow)
        {
         g_microResumption.confirmed                  = true;
         g_microResumption.breakPrice                 = currentPrice;
         g_microResumption.breakTime                  = curBarTime;
         g_microResumption.microBreakResumptionPercent = g_resumption.valid ? g_resumption.rawPercent : 0.0;
         g_microResumption.state                       = MICRO_CONFIRMED;
         Print(StringFormat("[ENTRY_INTEL][MICRO_RESUMPTION] mode=%s direction=SELL anchor=%.3f microLow=%.3f breakPrice=%.3f resumptionPct=%.2f boundary80=%.3f window=%s confirmed=TRUE",
               MicroModeName(g_microResumption.mode), g_microResumption.basePullbackExtreme, g_microResumption.microLow, g_microResumption.breakPrice,
               g_microResumption.microBreakResumptionPercent, g_resumption.boundary80Price, ResumptionWindowName(g_resumption.window)));
        }
     }
  }

//====================================================================
// ENTRY INTELLIGENCE - STEP 4: OPPORTUNITY LIFECYCLE (observational only)
//
// 2026-08-21, explicit operator request. Gives ONE structural market move (Active Leg + Pullback +
// Resumption + Micro Resumption) a persistent ID and state, so it is never conceptually re-treated
// as a new opportunity just because resumption% ticks, price extends past 100%, or a trade closes.
//
// A new opportunity is created ONLY when the underlying Active Leg's own (direction, originTime)
// signature changes - i.e. only on the same events that make Step 1 itself (re)initialize a leg
// (first-ever leg, or a direction flip). Ordinary tick/candle/vote/resumption/micro updates never
// create a new ID; they only advance the SAME opportunity's state or refresh its numeric fields.
//
// State machine (forward-only per opportunity, cascades within one cycle if data allows):
//   CREATED -> PULLBACK (Step 1 pullback active) -> RESUMPTION (Step 2 produces a valid reading)
//   -> MICRO_CONFIRMED (Step 3 confirms) -> AVAILABLE (micro confirmed AND window==0_TO_80)
//                                        -> EXPIRED   (micro confirmed AND window==OVER_80, i.e. "late")
// EXECUTED/CONSUMED exist in the enum for the future Execution Integration step but are never set
// here (always false) - Step 4 has no coupling to MaybeExecute()/OrderSend()/trade history at all.
//====================================================================
string OppStateName(const ENUM_LITE_OPP_STATE s)
  {
   switch(s)
     {
      case OPP_CREATED:         return "CREATED";
      case OPP_PULLBACK:        return "PULLBACK";
      case OPP_CONTINUATION:    return "CONTINUATION";
      case OPP_RESUMPTION:      return "RESUMPTION";
      case OPP_MICRO_CONFIRMED: return "MICRO_CONFIRMED";
      case OPP_AVAILABLE:       return "AVAILABLE";
      case OPP_EXECUTED:        return "EXECUTED";
      case OPP_CONSUMED:        return "CONSUMED";
      case OPP_COMPLETED:       return "COMPLETED";
      case OPP_EXPIRED:         return "EXPIRED";
      case OPP_INVALIDATED:     return "INVALIDATED";
      default:                  return "NONE";
     }
  }

//--- 2026-08-28, Step 15.4 (explicit operator request, Early Re-Entry): shared opportunity-mint
//--- helper - IDENTICAL field construction to the block C2 (Step 15.1) already used inline, factored
//--- out so both C2 and Early Re-Entry mint through the exact same code instead of two copies. Does
//--- NOT touch legSignatureDirection/legSignatureOriginTime (the same Active Leg is always preserved
//--- by design - callers never touch those either) and preserves the exact same field values/order
//--- C2 already used, so this is a pure refactor, not a behavior change.
void MintReEntryOpportunity(const datetime curBarTime)
  {
   g_opportunity.active                       = true;
   g_opportunity.id                            = g_nextOpportunityId++;
   g_opportunity.direction                     = g_activeLeg.direction;
   g_opportunity.state                         = OPP_CREATED;
   g_opportunity.originPrice                   = g_activeLeg.originPrice;
   g_opportunity.activeExtreme                 = g_activeLeg.extremePrice;
   g_opportunity.pullbackExtreme               = 0.0;
   g_opportunity.resumptionPercent             = 0.0;
   g_opportunity.resumption80Price             = 0.0;
   g_opportunity.microBreakPrice               = 0.0;
   g_opportunity.microBreakResumptionPercent   = 0.0;
   g_opportunity.createdTime                   = curBarTime;
   g_opportunity.pullbackTime                  = 0;
   g_opportunity.resumptionTime                = 0;
   g_opportunity.microConfirmationTime         = 0;
   g_opportunity.completedTime                 = 0;
   g_opportunity.executed                      = false;
   g_opportunity.consumed                      = false;
   g_opportunity.extremeReachedLogged          = false;
   g_opportunity.isEarlyReEntryOpp             = false; // caller sets true afterward for an Early Re-Entry mint
   g_opportunity.isC2Refire                    = false; // caller sets true afterward for a C2 mint
  }

//--- 2026-08-28, Step 15.4 (explicit operator request): Early Re-Entry eligibility - originally the
//--- SECOND opportunity-mint trigger inside the OPP_CONSUMED branch below, evaluated BEFORE C2's own
//--- structural-event trigger, capturing continuation strength WITHOUT waiting for a new pullback/
//--- micro-break event.
//--- 2026-09-08, explicit operator request ("Retry trade should be totaly off make 0"): budget lowered
//--- to KMIE_LITE_EARLY_REENTRY_MAX_COUNT=0, making the (then still-present) budget check below always
//--- true and this function permanently unreachable-true from that point on - every gate after it
//--- (cooldown, regime allow-list, DNA continuation-state allow-set, Mind-vote margin, price-extension
//--- protection) had already gone permanently dead as a result, never actually evaluated in production.
//--- 2026-09-09, explicit operator request ("fix everythihg and remove fully which we not using",
//--- confirmed permanent/irreversible via AskUserQuestion, twice): that now-dead ~40 lines of DNA/
//--- vote-margin/extension logic is DELETED outright rather than left unreachable. The still-relevant
//--- pre-budget gates (overshoot lockout, news blackout, active-leg/direction/leg-signature checks) are
//--- ALSO removed here since they can no longer lead anywhere - the function now always returns false
//--- immediately, byte-for-byte the same OBSERVABLE behavior it already had (this was never a fresh
//--- entry point that could fire; the caller has always seen "not eligible" on every cycle since the
//--- budget went to 0). g_reEntryCount/KMIE_LITE_EARLY_REENTRY_MAX_COUNT and the call site's own
//--- diagnostic reads of g_reEntryCount are left in place (still meaningfully read for logging/leg-reset
//--- bookkeeping elsewhere - not exclusively owned by this function's now-removed body). The 5 retired-
//--- compatibility DNA enum values (UPTREND/DOWNTREND/STRONG_TREND/INSTITUTIONAL_BUYING/
//--- INSTITUTIONAL_SELLING) that this function's deleted DNA allow-set was their SOLE executable
//--- reader are now enum-identifier-only, kept as retired-compatibility slots per the prior, separate
//--- "FULL MARKET DNA CONSOLIDATION"/"MARKET DNA STATE REMOVAL" decisions (not re-litigated by this
//--- deletion) - see ENUM_LITE_DNA's own header comment for the current, honest justification.
bool EarlyReEntryEligible(const datetime curBarTime, string &reasonOut, string &blockReasonOut)
  {
   blockReasonOut="PERMANENTLY_DISABLED"; // 2026-09-09: Early Re-Entry permanently retired, see header above
   return false;
  }

void EvaluateOpportunityLifecycle()
  {
   if(!g_activeLeg.active) return; // no leg at all yet (startup, or direction still WAIT) - nothing to do

   datetime curBarTime = iTime(g_symbol, PERIOD_M1, 0);
   if(curBarTime<=0) return;

   bool sameLeg = (g_opportunity.active &&
                   g_opportunity.legSignatureDirection==g_activeLeg.direction &&
                   g_opportunity.legSignatureOriginTime==g_activeLeg.originTime);

   if(!sameLeg)
     {
      //--- A genuinely new Active Leg (first ever, or a direction flip) - the old opportunity, if
      //--- one was still open, ends here (never silently reused / never continues as "the same" one).
      if(g_opportunity.active)
        {
         g_opportunity.state         = OPP_INVALIDATED;
         g_opportunity.completedTime = curBarTime;
         Print(StringFormat("[ENTRY_INTEL][OPPORTUNITY_INVALIDATED] id=%I64u reason=active leg replaced (new direction/leg)", g_opportunity.id));
        }

      g_opportunity.active                       = true;
      g_opportunity.id                            = g_nextOpportunityId++;
      g_opportunity.direction                     = g_activeLeg.direction;
      g_opportunity.state                         = OPP_CREATED;
      g_opportunity.originPrice                   = g_activeLeg.originPrice;
      g_opportunity.activeExtreme                 = g_activeLeg.extremePrice;
      g_opportunity.pullbackExtreme               = 0.0;
      g_opportunity.resumptionPercent             = 0.0;
      g_opportunity.resumption80Price             = 0.0;
      g_opportunity.microBreakPrice               = 0.0;
      g_opportunity.microBreakResumptionPercent   = 0.0;
      g_opportunity.createdTime                   = curBarTime;
      g_opportunity.pullbackTime                  = 0;
      g_opportunity.resumptionTime                = 0;
      g_opportunity.microConfirmationTime         = 0;
      g_opportunity.completedTime                 = 0;
      g_opportunity.executed                      = false;
      g_opportunity.consumed                      = false;
      g_opportunity.extremeReachedLogged          = false;
      g_opportunity.legSignatureDirection         = g_activeLeg.direction;
      g_opportunity.legSignatureOriginTime        = g_activeLeg.originTime;
      //--- 2026-08-28, Step 15.4 (explicit operator request, Early Re-Entry): a genuinely new Active
      //--- Leg resets the re-entry budget - this is the ONLY place g_reEntryCount is ever reset,
      //--- deliberately placed here (Opportunity Lifecycle) rather than inside Active Leg detection
      //--- itself, which stays completely untouched.
      g_opportunity.isEarlyReEntryOpp             = false;
      g_opportunity.isC2Refire                    = false;
      g_reEntryCount                              = 0;

      Print(StringFormat("[ENTRY_INTEL][OPPORTUNITY_CREATED] id=%I64u direction=%s origin=%.3f activeExtreme=%.3f",
            g_opportunity.id, DirName(g_opportunity.direction), g_opportunity.originPrice, g_opportunity.activeExtreme));
      return; // fresh this cycle - nothing further to evaluate
     }

   //--- 2026-08-25, Step 15.1 (explicit operator request, "Trend Re-Fire" OPTION C2): let the SAME
   //--- Active Leg produce a second (third, ...) opportunity after the previous one was CONSUMED -
   //--- but ONLY when every position for this EA has closed AND a genuinely NEW structural event
   //--- occurred STRICTLY AFTER the previous opportunity's own completedTime. Never resets
   //--- OPP_CONSUMED - always mints a brand-new id via the SAME g_nextOpportunityId sequence the
   //--- direction-flip branch above already uses. Direction flips are handled entirely by the
   //--- !sameLeg branch above and always run first each cycle - this code is only ever reached when
   //--- the leg itself did NOT change this cycle, so a re-fire can never race a direction flip.
   if(g_opportunity.state==OPP_CONSUMED)
     {
      //--- Deliberately duplicates CountOpenPositions()'s own symbol+magic filter inline rather than
      //--- calling it or forward-declaring it - that function is defined later in this file (after
      //--- this one), and this keeps the Step 15.1 diff contained to EvaluateOpportunityLifecycle()
      //--- and the two small struct fields, touching nothing else. Same meaning either way: ANY open
      //--- position for this EA blocks a re-fire - re-fire eligibility can never be looser than a
      //--- fresh entry's own Gate 3 in MaybeExecute(). Shared by BOTH Early Re-Entry and C2 below -
      //--- computed once, not duplicated.
      int refireOpenPositions = 0;
      for(int rp=PositionsTotal()-1; rp>=0; rp--)
        {
         ulong rpTicket = PositionGetTicket(rp);
         if(rpTicket==0) continue;
         if(PositionGetString(POSITION_SYMBOL)!=g_symbol) continue;
         if((long)PositionGetInteger(POSITION_MAGIC)!=Inp_MagicNumber) continue;
         refireOpenPositions++;
        }

      if(refireOpenPositions==0)
        {
         //--- 2026-08-28, Step 15.4 (explicit operator request, Early Re-Entry): checked FIRST, ahead
         //--- of C2 below - mutual exclusion by construction (this branch always returns on a mint,
         //--- so C2's own check further down can never also fire in the same cycle). Throttled BLOCK
         //--- diagnostics: logged only when the reason actually changes, never spammed per tick.
         string earlyReason = "", earlyBlockReason = "";
         if(EarlyReEntryEligible(curBarTime, earlyReason, earlyBlockReason))
           {
            ulong oldOpportunityId = g_opportunity.id;
            int   thisReEntryNumber = g_reEntryCount + 1; // diagnostic only - actual increment happens on successful execution (MaybeExecute())
            MintReEntryOpportunity(curBarTime);
            g_opportunity.isEarlyReEntryOpp = true;

            Print(StringFormat("[ENTRY_INTEL][EARLY_REENTRY] created opportunity=%I64u previousOpportunity=%I64u direction=%s dna=%s dnaScore=%.2f buyVotes=%d sellVotes=%d extension=%.2f reEntryCount=%d activeLegOriginTime=%s reason=%s",
                  g_opportunity.id, oldOpportunityId, DirName(g_opportunity.direction), DnaName(g_dnaState), g_dnaScore,
                  g_buyVotes, g_sellVotes, g_extension.percent, thisReEntryNumber, TimeToString(g_activeLeg.originTime), earlyReason));
            return; // fresh this cycle - nothing further to evaluate, mirrors the !sameLeg branch's own return
           }
         else
           {
            static string lastEarlyBlockReason = "";
            if(earlyBlockReason!=lastEarlyBlockReason)
              {
               lastEarlyBlockReason = earlyBlockReason;
               Print(StringFormat("[ENTRY_INTEL][EARLY_REENTRY_BLOCKED] reason=%s opportunity=%I64u direction=%s dna=%s reEntryCount=%d",
                     earlyBlockReason, g_opportunity.id, DirName(g_activeLeg.direction), DnaName(g_dnaState), g_reEntryCount));
              }
           }

         //--- 2026-08-25, Step 15.1 (explicit operator request, "Trend Re-Fire" OPTION C2): UNCHANGED
         //--- conditions from the original implementation - only reached when Early Re-Entry above did
         //--- NOT fire this cycle. Let the SAME Active Leg produce a second (third, ...) opportunity
         //--- after the previous one was CONSUMED - but ONLY when a genuinely NEW structural event
         //--- occurred STRICTLY AFTER the previous opportunity's own completedTime. Never resets
         //--- OPP_CONSUMED - always mints a brand-new id via the SAME g_nextOpportunityId sequence the
         //--- direction-flip branch above already uses.
         //--- Pullback-path event: a genuine NEW LPB_NONE->LPB_ACTIVE transition (not merely
         //--- state==LPB_ACTIVE, which could just be the SAME pullback that already produced the
         //--- consumed opportunity) that happened after this opportunity finished.
         bool pullbackRefireEvent = (g_pullback.state==LPB_ACTIVE && g_pullback.activatedTime>g_opportunity.completedTime);
         //--- Continuation-path event: a genuine NEW micro-confirmation (mode must currently be
         //--- CONTINUATION, i.e. no pullback exists right now) whose breakTime postdates completion.
         //--- g_microResumption.breakTime updates only when the structure genuinely rebuilds and
         //--- reconfirms (see EvaluateMicroResumption()'s anchorExtended path) - an old, still-
         //--- confirmed-from-before structure never produces a breakTime newer than completedTime.
         bool continuationRefireEvent = (g_pullback.state!=LPB_ACTIVE && g_microResumption.mode==MICRO_MODE_CONTINUATION &&
                                          g_microResumption.confirmed && g_microResumption.direction==g_activeLeg.direction &&
                                          g_microResumption.breakTime>g_opportunity.completedTime);

         if(pullbackRefireEvent || continuationRefireEvent)
           {
            ulong oldOpportunityId = g_opportunity.id;

            //--- 2026-08-28, Step 15.4: refactored to call the shared mint helper (identical field
            //--- values/order to the original inline block - pure refactor, no behavior change).
            //--- legSignatureDirection/legSignatureOriginTime remain deliberately untouched (still the
            //--- SAME Active Leg), exactly as before this refactor.
            MintReEntryOpportunity(curBarTime);
            //--- 2026-08-28, Step 18.1 (explicit operator request): telemetry-only tag - identifies
            //--- this opportunity's origin as C2 for entry_dna.jsonl/[EXECUTION][IDENTITY] logging.
            //--- Does not affect C2's own trigger conditions above (untouched) or any gate below.
            g_opportunity.isC2Refire = true;

            Print(StringFormat("[ENTRY_INTEL][OPPORTUNITY_REFIRE] oldOpportunityId=%I64u newOpportunityId=%I64u legDirection=%s eventType=%s eventTime=%s completedTime=%s",
                  oldOpportunityId, g_opportunity.id, DirName(g_opportunity.direction),
                  pullbackRefireEvent ? "PULLBACK" : "CONTINUATION_MICRO",
                  TimeToString(pullbackRefireEvent ? g_pullback.activatedTime : g_microResumption.breakTime),
                  TimeToString(g_opportunity.completedTime)));
            return; // fresh this cycle - nothing further to evaluate, mirrors the !sameLeg branch's own return
           }
        }
     }

   //--- Same opportunity as last cycle: keep the mirrored active-extreme reference current (Step 1
   //--- may still be extending it), then advance the state machine as far as this cycle's data allows.
   g_opportunity.activeExtreme = g_activeLeg.extremePrice;

   if(g_pullback.state==LPB_ACTIVE)
     {
      //--- PULLBACK route.
      bool firstPullback = (g_opportunity.state==OPP_CREATED);
      g_opportunity.pullbackExtreme = g_pullback.extremePrice; // Step 1 may keep deepening this - no new opportunity for that
      if(firstPullback)
        {
         g_opportunity.state        = OPP_PULLBACK;
         g_opportunity.pullbackTime = curBarTime;
         Print(StringFormat("[ENTRY_INTEL][OPPORTUNITY_PULLBACK] id=%I64u pullbackExtreme=%.3f", g_opportunity.id, g_opportunity.pullbackExtreme));
        }

      if(g_resumption.valid)
        {
         g_opportunity.resumptionPercent = g_resumption.rawPercent;
         g_opportunity.resumption80Price = g_resumption.boundary80Price;
         if(g_opportunity.state==OPP_PULLBACK)
           {
            g_opportunity.state         = OPP_RESUMPTION;
            g_opportunity.resumptionTime = curBarTime;
            Print(StringFormat("[ENTRY_INTEL][OPPORTUNITY_RESUMPTION] id=%I64u resumptionPct=%.2f window=%s",
                  g_opportunity.id, g_resumption.rawPercent, ResumptionWindowName(g_resumption.window)));
           }
        }

      //--- 2026-08-21, Step 12.1 (explicit operator request): Micro Confirmation is now OPTIONAL for
      //--- Pullback too. If it happens, it's recorded via the same MICRO_CONFIRMED stage as before -
      //--- but availability is no longer gated on it; the resumption window alone now drives whether
      //--- the opportunity reaches AVAILABLE or EXPIRED (mirrors the Continuation route's treatment).
      if(g_microResumption.confirmed && g_opportunity.state==OPP_RESUMPTION)
        {
         g_opportunity.state                       = OPP_MICRO_CONFIRMED;
         g_opportunity.microConfirmationTime        = curBarTime;
         g_opportunity.microBreakPrice              = g_microResumption.breakPrice;
         g_opportunity.microBreakResumptionPercent  = g_microResumption.microBreakResumptionPercent;
         Print(StringFormat("[ENTRY_INTEL][OPPORTUNITY_MICRO_CONFIRMED] id=%I64u microBreak=%.3f resumptionPct=%.2f",
               g_opportunity.id, g_opportunity.microBreakPrice, g_opportunity.microBreakResumptionPercent));
        }

      //--- Classify availability once resumption is valid, regardless of micro confirmation. Fires
      //--- exactly once: on the next cycle state is already AVAILABLE/EXPIRED, so this condition
      //--- (state==OPP_RESUMPTION||OPP_MICRO_CONFIRMED) no longer matches.
      //--- 2026-08-24, explicit operator request: this used to gate on g_resumption.window (same-
      //--- direction recovery <=80%), which meant a same-direction resumption reading >80% on the
      //--- very first valid tick could permanently EXPIRE the opportunity - the exact thing Entry
      //--- Approval was just fixed to stop doing. Now reads pullbackTooDeep (the OPPOSITE-direction
      //--- metric) instead, so this stays fully consistent with EvaluateEntryApproval()'s own gate.
      if(g_resumption.valid && (g_opportunity.state==OPP_RESUMPTION || g_opportunity.state==OPP_MICRO_CONFIRMED))
        {
         if(!g_resumption.pullbackTooDeep)
           {
            g_opportunity.state = OPP_AVAILABLE;
            Print(StringFormat("[ENTRY_INTEL][OPPORTUNITY_AVAILABLE] id=%I64u direction=%s resumptionPct=%.2f pullbackDepth=%.2f micro=%s",
                  g_opportunity.id, DirName(g_opportunity.direction), g_resumption.rawPercent, g_resumption.pullbackDepthPercent,
                  g_microResumption.confirmed ? "CONFIRMED" : "N/A"));
           }
         else
           {
            g_opportunity.state = OPP_EXPIRED;
            Print(StringFormat("[ENTRY_INTEL][OPPORTUNITY_LATE] id=%I64u resumptionPct=%.2f pullbackDepth=%.2f",
                  g_opportunity.id, g_resumption.rawPercent, g_resumption.pullbackDepthPercent));
           }
        }
     }
   else
     {
      //--- CONTINUATION route. No pullback exists for this opportunity, so resumption/80%-window are
      //--- never evaluated - there is nothing for them to measure.
      //--- 2026-08-21, Step 11.2 (explicit operator request): Micro Confirmation is now OPTIONAL here.
      //--- If it happens, it's recorded (diagnostic fields only, never fabricated) via the same
      //--- MICRO_CONFIRMED stage as before. Either way - confirmed or not - the opportunity reaches
      //--- the SAME OPP_AVAILABLE. Shape is now:
      //---   CREATED -> CONTINUATION -> AVAILABLE                         (no micro confirmation)
      //---   CREATED -> CONTINUATION -> MICRO_CONFIRMED -> AVAILABLE       (micro confirmation occurred)
      bool firstContinuation = (g_opportunity.state==OPP_CREATED);
      if(firstContinuation)
        {
         g_opportunity.state = OPP_CONTINUATION;
         Print(StringFormat("[ENTRY_INTEL][OPPORTUNITY_CONTINUATION] id=%I64u activeExtreme=%.3f", g_opportunity.id, g_opportunity.activeExtreme));
        }

      if(g_microResumption.confirmed && g_opportunity.state==OPP_CONTINUATION)
        {
         g_opportunity.state                       = OPP_MICRO_CONFIRMED;
         g_opportunity.microConfirmationTime        = curBarTime;
         g_opportunity.microBreakPrice              = g_microResumption.breakPrice;
         g_opportunity.microBreakResumptionPercent  = 0.0; // no resumption % exists in this route - not fabricated, left at the same invalid-sentinel value used elsewhere
         Print(StringFormat("[ENTRY_INTEL][OPPORTUNITY_MICRO_CONFIRMED] id=%I64u microBreak=%.3f (continuation route - no resumption%%)",
               g_opportunity.id, g_opportunity.microBreakPrice));
        }

      //--- Reach AVAILABLE regardless of whether micro confirmation happened - it is optional, not
      //--- required, for the Continuation route (Step 11.2). Fires exactly once: on the very next
      //--- cycle state is already OPP_AVAILABLE, so neither branch of this condition matches again.
      if(g_opportunity.state==OPP_CONTINUATION || g_opportunity.state==OPP_MICRO_CONFIRMED)
        {
         g_opportunity.state = OPP_AVAILABLE;
         Print(StringFormat("[ENTRY_INTEL][OPPORTUNITY_AVAILABLE] id=%I64u direction=%s (continuation route, micro=%s)",
               g_opportunity.id, DirName(g_opportunity.direction), g_microResumption.confirmed ? "CONFIRMED" : "N/A"));
        }
     }

   //--- ~100% "reached the active-leg extreme" - PULLBACK route only (continuation has no resumption%
   //--- to reach 100% of, since g_resumption.valid is false throughout that route). Logged once, does
   //--- not create a new opportunity and does not change state.
   if(!g_opportunity.extremeReachedLogged && g_resumption.valid && g_resumption.rawPercent>=100.0)
     {
      g_opportunity.extremeReachedLogged = true;
      Print(StringFormat("[ENTRY_INTEL][OPPORTUNITY_EXTREME_REACHED] id=%I64u resumptionPct=%.2f (reached the active-leg extreme - still the same opportunity)",
            g_opportunity.id, g_resumption.rawPercent));
     }
  }

//====================================================================
// ENTRY INTELLIGENCE - STEP 5: EXTENSION ENGINE (observational only)
//
// 2026-08-21, explicit operator request. Measures how far CurrentPrice sits BEYOND the Active Leg's
// own extreme (g_activeLeg.extremePrice) - NOT the resumption range (PullbackExtreme->ActiveExtreme,
// that's Step 2). Always measured against the CURRENT extreme, so when Step 1 pushes the extreme
// further, extension correctly collapses back toward zero rather than staying pinned to a stale value.
//
// BUY:  ExtensionDistance = max(0, CurrentPrice - ActiveExtreme)
// SELL: ExtensionDistance = max(0, ActiveExtreme - CurrentPrice)
// ExtensionPercent = ExtensionDistance / |ActiveExtreme - ActiveOrigin| * 100  (UNCLAMPED - 100%/200%+
// are preserved exactly as computed, never capped, since the point of Step 5 is to observe real
// magnitude, not to judge it)
//
// No threshold is defined for "too extended" - only two states exist (NOT_EXTENDED/EXTENDED), and
// neither is read by MaybeExecute() or any gate.
//====================================================================
string ExtensionStateName(const ENUM_LITE_EXTENSION_STATE s)
  {
   return (s==EXTENSION_EXTENDED) ? "EXTENDED" : "NOT_EXTENDED";
  }

void EvaluateExtension()
  {
   bool valid = false;
   double distance = 0.0, percent = 0.0;
   ENUM_LITE_EXTENSION_STATE state = EXTENSION_NOT_EXTENDED;
   double activeExtreme = 0.0, activeOrigin = 0.0;

   double currentPrice = g_ci.newestClose;

   if(g_activeLeg.active && g_activeLeg.direction!=LDIR_WAIT && currentPrice>0.0)
     {
      activeExtreme = g_activeLeg.extremePrice;
      activeOrigin  = g_activeLeg.originPrice;
      double range  = MathAbs(activeExtreme-activeOrigin);

      if(range>0.0)
        {
         valid = true;
         if(g_activeLeg.direction==LDIR_BUY)
            distance = (currentPrice>activeExtreme) ? (currentPrice-activeExtreme) : 0.0;
         else // LDIR_SELL
            distance = (currentPrice<activeExtreme) ? (activeExtreme-currentPrice) : 0.0;

         percent = (distance/range)*100.0; // unclamped by design
         state   = (distance>0.0) ? EXTENSION_EXTENDED : EXTENSION_NOT_EXTENDED;
        }
      //--- range<=0.0 (degenerate zero-range leg) intentionally leaves valid=false - never divides by zero.
     }

   bool wasExtended = (g_extension.valid && g_extension.state==EXTENSION_EXTENDED);
   bool nowExtended = (valid && state==EXTENSION_EXTENDED);

   if(nowExtended && !wasExtended)
     {
      g_extension.lastLoggedMilestone = (int)MathFloor(percent/10.0);
      Print(StringFormat("[ENTRY_INTEL][EXTENSION] direction=%s origin=%.3f activeExtreme=%.3f currentPrice=%.3f distance=%.3f percent=%.2f state=EXTENDED",
            DirName(g_activeLeg.direction), activeOrigin, activeExtreme, currentPrice, distance, percent));
     }
   else if(!nowExtended && wasExtended)
     {
      g_extension.lastLoggedMilestone = -1;
      Print(StringFormat("[ENTRY_INTEL][EXTENSION] direction=%s origin=%.3f activeExtreme=%.3f currentPrice=%.3f distance=0.000 percent=0.00 state=NOT_EXTENDED",
            DirName(g_activeLeg.direction), activeOrigin, activeExtreme, currentPrice));
     }
   else if(nowExtended && wasExtended)
     {
      int bucket = (int)MathFloor(percent/10.0);
      if(bucket!=g_extension.lastLoggedMilestone)
        {
         g_extension.lastLoggedMilestone = bucket;
         Print(StringFormat("[ENTRY_INTEL][EXTENSION] direction=%s origin=%.3f activeExtreme=%.3f currentPrice=%.3f distance=%.3f percent=%.2f state=EXTENDED",
               DirName(g_activeLeg.direction), activeOrigin, activeExtreme, currentPrice, distance, percent));
        }
     }

   g_extension.valid         = valid;
   g_extension.distance      = distance;
   g_extension.percent       = percent;
   g_extension.state         = state;
   g_extension.activeExtreme = activeExtreme;
   g_extension.activeOrigin  = activeOrigin;
   g_extension.measuredTime  = iTime(g_symbol, PERIOD_M1, 0);
   g_extension.opportunityId = g_opportunity.active ? g_opportunity.id : 0; // diagnostic only
  }

//====================================================================
// ENTRY INTELLIGENCE - STEP 6: ENTRY APPROVAL ENGINE (observational only)
//
// 2026-08-21, explicit operator request. A deterministic structural gate that combines Steps 1-5's
// already-published state into one APPROVED/BLOCKED reading with a single first-failure reason,
// checked in a fixed priority order. Duplicates NONE of the underlying formulas - reads
// g_mindsVoteDir/g_activeLeg/g_pullback/g_resumption/g_microResumption/g_opportunity/g_extension
// exactly as published. NOT a scoring system - every condition is a hard pass/fail, no weighting.
//
// Extension is intentionally NOT a hard block yet (Step 5 defined no threshold) - EXTENSION_EXTENDED
// only sets extensionCondition=EXTCOND_CAUTION, a diagnostic field separate from blockReason.
//
// This function's only outputs are g_entryApproval and a Print() - it is never called by, and never
// writes to, anything MaybeExecute()/SendMarketOrder()/OrderSend() read.
//====================================================================
string BlockReasonName(const ENUM_LITE_ENTRY_BLOCK_REASON r)
  {
   switch(r)
     {
      case ENTRY_BLOCK_WAIT_DIRECTION:              return "WAIT_DIRECTION";
      case ENTRY_BLOCK_NO_ACTIVE_LEG:                return "NO_ACTIVE_LEG";
      case ENTRY_BLOCK_DIRECTION_MISMATCH:           return "DIRECTION_MISMATCH";
      case ENTRY_BLOCK_NO_PULLBACK:                  return "NO_PULLBACK";
      case ENTRY_BLOCK_NO_RESUMPTION:                return "NO_RESUMPTION";
      case ENTRY_BLOCK_RESUMPTION_OVER_80:           return "RESUMPTION_OVER_80";
      case ENTRY_BLOCK_PULLBACK_TOO_DEEP:            return "PULLBACK_TOO_DEEP";
      case ENTRY_BLOCK_NO_MICRO_RESUMPTION:          return "NO_MICRO_RESUMPTION";
      case ENTRY_BLOCK_MICRO_DIRECTION_MISMATCH:     return "MICRO_DIRECTION_MISMATCH";
      case ENTRY_BLOCK_INVALID_OPPORTUNITY:          return "INVALID_OPPORTUNITY";
      case ENTRY_BLOCK_OPPORTUNITY_CONSUMED:         return "OPPORTUNITY_CONSUMED";
      case ENTRY_BLOCK_OPPORTUNITY_EXPIRED:          return "OPPORTUNITY_EXPIRED";
      case ENTRY_BLOCK_OPPORTUNITY_COMPLETED:        return "OPPORTUNITY_COMPLETED";
      case ENTRY_BLOCK_INVALID_EXTENSION_DATA:       return "INVALID_EXTENSION_DATA";
      case ENTRY_BLOCK_NO_CONTINUATION_CONFIRMATION: return "NO_CONTINUATION_CONFIRMATION";
      default:                                       return "NONE";
     }
  }

string EntryPathName(const ENUM_LITE_ENTRY_PATH p)
  {
   return (p==ENTRY_PATH_CONTINUATION) ? "CONTINUATION" : "PULLBACK";
  }

//--- Entry Approval Correction (explicit operator request): no-pullback no longer means an automatic
//--- block. g_pullback.state==LPB_ACTIVE selects the PULLBACK PATH (unchanged 0-50% resumption
//--- rule, exactly as before); its absence selects the CONTINUATION PATH, which reuses Step 3's own
//--- Micro Resumption confirmation as its structural gate instead of a resumption reading that
//--- cannot exist without a pullback. Neither path invents a new indicator or a new direction vote.
void EvaluateEntryApproval()
  {
   ENUM_LITE_DIR dir = g_mindsVoteDir;

   //--- Raw diagnostic conditions - each computed independently (not short-circuited), so the
   //--- dashboard/struct always reflects the true state of every substep, even ones after the first
   //--- failure. The decision itself is derived from these via a separate fixed-priority chain below.
   bool activeLegValid        = (g_activeLeg.active && g_activeLeg.direction!=LDIR_WAIT);
   bool directionAligned      = activeLegValid && (g_activeLeg.direction==dir);
   bool pullbackValid         = (g_pullback.state==LPB_ACTIVE);
   bool resumptionValid       = g_resumption.valid;
   //--- 2026-08-24, explicit operator request: same-direction resumption (however high) is
   //--- confirmation, not risk, and must never block entry - resumptionWindowOk/RESUMPTION_OVER_80
   //--- are no longer read below. pullbackTooDeep (the OPPOSITE-direction move) is the real gate now.
   //--- 2026-09-08, explicit operator request ("turn off Pullback Depth For Opposite Direction Gate
   //--- Entry and there should no Blockers"): DISABLED - hardcoded to false so
   //--- ENTRY_BLOCK_PULLBACK_TOO_DEEP can never fire, regardless of how deep the opposite-direction
   //--- pullback actually goes. g_resumption.pullbackTooDeep/pullbackDepthPercent themselves are
   //--- UNCHANGED and keep being computed/logged exactly as before (dashboard/telemetry still show
   //--- the real measurement) - only this LOCAL copy that Entry Approval's own decision chain reads
   //--- is forced false, so every OTHER Entry Approval gate (WAIT_DIRECTION, NO_ACTIVE_LEG,
   //--- DIRECTION_MISMATCH, NO_RESUMPTION, MICRO_DIRECTION_MISMATCH, INVALID_OPPORTUNITY,
   //--- OPPORTUNITY_CONSUMED, OPPORTUNITY_EXPIRED, OPPORTUNITY_COMPLETED, INVALID_EXTENSION_DATA)
   //--- remains completely untouched and still applies exactly as today - explicit operator-confirmed
   //--- scope (via AskUserQuestion before implementation): this ONE gate only, not all of Entry
   //--- Approval.
   bool pullbackTooDeep       = false;
   bool microConfirmed        = g_microResumption.confirmed;
   bool microDirectionAligned = microConfirmed && (g_microResumption.direction==dir);

   bool opportunityActive         = g_opportunity.active;
   bool opportunityDirectionOk    = opportunityActive && (g_opportunity.direction==dir);
   bool opportunityNotInvalidated = !(opportunityActive && g_opportunity.state==OPP_INVALIDATED);
   bool opportunityValid          = opportunityActive && opportunityDirectionOk && opportunityNotInvalidated;

   bool                          extensionValid = g_extension.valid;
   ENUM_LITE_EXTENSION_CONDITION extCond        = !extensionValid ? EXTCOND_INVALID :
                                                   (g_extension.state==EXTENSION_EXTENDED ? EXTCOND_CAUTION : EXTCOND_NORMAL);

   ENUM_LITE_ENTRY_PATH path = pullbackValid ? ENTRY_PATH_PULLBACK : ENTRY_PATH_CONTINUATION;

   //--- 2026-09-24, explicit operator request - see input declaration's own header for full rationale.
   //--- Independent of g_activePing.active; either one true unlocks OPPORTUNITY_CONSUMED below.
   //--- Reads M5's DNA state (g_dnaStateM5), NOT M1's g_dnaState - explicit operator request ("Make sole
   //--- criteria for opportunity consumed M5 according Market DNA... when M5 DNA say Strong Trend Up or
   //--- down"), since M1 alone can flag STRONG_UPTREND/DOWNTREND on noise the 5-minute chart hasn't
   //--- confirmed yet. g_dnaStateM5 is only refreshed when Inp_DnaTimeframeMode!=DNA_TF_M1_ONLY (see
   //--- EvaluateMarketDnaM5(), gated in OnTick()) - on the live .set (Inp_DnaTimeframeMode=DNA_TF_BOTH)
   //--- this updates every tick same as M1; if ever switched to DNA_TF_M1_ONLY, g_dnaStateM5 freezes at
   //--- its last value and this override effectively goes dormant (matches the file's own established
   //--- "M5 pipeline only runs when the mode says so" convention - not a new limitation introduced here).
   bool strongTrendOverride = ClassifyStrongTrendOverride(Inp_StrongTrendOppConsumedOverrideEnabled, g_dnaStateM5);

   //--- 2026-09-03, explicit operator request (ACTIVE_PING ARCHITECTURE): the old ">10 votes" one-shot
   //--- bypass (winningCount/highVoteOpenPositions/highVoteBypassEligible/
   //--- g_highVoteBypassUsedForOpportunityId) is REMOVED here per explicit instruction - "Remove the
   //--- >10 votes bypass from the OPP_CONSUMED re-entry logic... ACTIVE_PING is now the sole mechanism
   //--- replacing the old OPP_CONSUMED re-entry gate." g_buyVotes/g_sellVotes/g_mindsVoteDir themselves
   //--- (the actual vote CALCULATION, Mind 16/EMA Trend Mind) are completely untouched and still drive
   //--- `dir` above and every other gate in this file - only the former independent-bypass ROLE is
   //--- gone. See g_activePing (computed once per new bar in OnTick(), just before this function is
   //--- called) for the replacement gate, used directly in the OPP_CONSUMED checks below.

   //--- Fixed-priority first-failure chain. Steps 1-3 (WAIT/NO_ACTIVE_LEG/DIRECTION_MISMATCH) are
   //--- path-independent and unchanged. Step 4 onward diverges by path - PULLBACK still requires
   //--- valid resumption within the 80% window; CONTINUATION never evaluates resumption at all
   //--- (structurally nonexistent without a pullback). Both paths rejoin the same opportunity/
   //--- extension checks at the end.
   ENUM_LITE_ENTRY_BLOCK_REASON reason = ENTRY_BLOCK_NONE;
   if(dir==LDIR_WAIT)              reason = ENTRY_BLOCK_WAIT_DIRECTION;
   else if(!activeLegValid)        reason = ENTRY_BLOCK_NO_ACTIVE_LEG;
   else if(!directionAligned)      reason = ENTRY_BLOCK_DIRECTION_MISMATCH;
   else if(path==ENTRY_PATH_PULLBACK)
     {
      //--- 2026-08-21, Step 12.1 (explicit operator request): Micro Confirmation is now OPTIONAL for
      //--- Pullback too, matching Step 11.2's Continuation treatment. Its ABSENCE is no longer a
      //--- block (ENTRY_BLOCK_NO_MICRO_RESUMPTION is never assigned here anymore - the enum is kept
      //--- for compatibility only). Its PRESENCE still must agree with the vote direction if a micro
      //--- break did occur - a wrong-direction micro break remains meaningful adverse structure.
      if(!resumptionValid)                             reason = ENTRY_BLOCK_NO_RESUMPTION;
      else if(pullbackTooDeep)                          reason = ENTRY_BLOCK_PULLBACK_TOO_DEEP;
      else if(microConfirmed && !microDirectionAligned) reason = ENTRY_BLOCK_MICRO_DIRECTION_MISMATCH;
      else if(!opportunityValid)                        reason = ENTRY_BLOCK_INVALID_OPPORTUNITY;
      //--- 2026-09-03, explicit operator request (ACTIVE_PING ARCHITECTURE): OPPORTUNITY_CONSUMED no
      //--- longer blocks unconditionally - it now only blocks when g_activePing.active is ALSO false.
      //--- g_activePing (EMA20/50 corridor OR EMA Trend Mind's own slope condition, evaluated once per
      //--- new bar - see its own header/EvaluateActivePing()) is the sole replacement for the old
      //--- ">10 votes" bypass. Same two-path call sites, same enforcement point downstream
      //--- (MaybeExecute()'s existing `if(!g_entryApproval.approved) return;`) - nothing else changed.
      else if(g_opportunity.state==OPP_CONSUMED && !g_activePing.active && !strongTrendOverride) reason = ENTRY_BLOCK_OPPORTUNITY_CONSUMED;
      else if(g_opportunity.state==OPP_EXPIRED)         reason = ENTRY_BLOCK_OPPORTUNITY_EXPIRED;
      else if(g_opportunity.state==OPP_COMPLETED)       reason = ENTRY_BLOCK_OPPORTUNITY_COMPLETED;
      else if(!extensionValid)                          reason = ENTRY_BLOCK_INVALID_EXTENSION_DATA;
     }
   else // ENTRY_PATH_CONTINUATION - no pullback exists; resumption is not evaluated at all (nothing
        // to measure without a pullback).
     {
      //--- 2026-08-21, Step 11.2 (explicit operator request): Micro Confirmation is now OPTIONAL for
      //--- Continuation. Its ABSENCE is no longer a block (NOT_CONTINUATION_CONFIRMATION is never
      //--- assigned here anymore - the enum is kept for compatibility only). Its PRESENCE still must
      //--- agree with the vote direction if it happened at all - a micro break in the wrong direction
      //--- is still meaningful adverse structure, so that one check remains, gated on microConfirmed.
      if(microConfirmed && !microDirectionAligned)     reason = ENTRY_BLOCK_MICRO_DIRECTION_MISMATCH;
      else if(!opportunityValid)                       reason = ENTRY_BLOCK_INVALID_OPPORTUNITY;
      //--- 2026-09-03, explicit operator request (ACTIVE_PING ARCHITECTURE): SAME replacement as the
      //--- PULLBACK path above - see that branch's own header for the full rationale.
      else if(g_opportunity.state==OPP_CONSUMED && !g_activePing.active && !strongTrendOverride) reason = ENTRY_BLOCK_OPPORTUNITY_CONSUMED;
      else if(g_opportunity.state==OPP_EXPIRED)        reason = ENTRY_BLOCK_OPPORTUNITY_EXPIRED;
      else if(g_opportunity.state==OPP_COMPLETED)      reason = ENTRY_BLOCK_OPPORTUNITY_COMPLETED;
      else if(!extensionValid)                         reason = ENTRY_BLOCK_INVALID_EXTENSION_DATA;
     }
   // extCond==EXTCOND_CAUTION (EXTENDED) intentionally never appears above - reason stays NONE.

   bool approved = (reason==ENTRY_BLOCK_NONE);

   //--- 2026-09-03, explicit operator request (ACTIVE_PING ARCHITECTURE): the old one-shot
   //--- HIGH_VOTE_BYPASS latch block (g_highVoteBypassUsedForOpportunityId assignment + its own Print/
   //--- logs.jsonl line) is REMOVED - ACTIVE_PING has no one-shot/latch concept at all (it is simply
   //--- true or false, freshly re-evaluated every new bar via g_activePing - see EvaluateActivePing()).
   //--- There is nothing here to "consume" or mark used.

   g_entryApproval.approved            = approved;
   g_entryApproval.decision            = approved ? ENTRY_APPROVED : ENTRY_BLOCKED;
   g_entryApproval.direction           = dir;
   g_entryApproval.blockReason         = reason;
   g_entryApproval.extensionCondition  = extCond;
   g_entryApproval.path                = path;
   g_entryApproval.opportunityId       = g_opportunity.active ? g_opportunity.id : 0;
   g_entryApproval.resumptionPercent   = g_resumption.valid ? g_resumption.rawPercent : 0.0;
   g_entryApproval.pullbackDepthPercent = g_resumption.valid ? g_resumption.pullbackDepthPercent : 0.0;
   g_entryApproval.extensionPercent    = g_extension.valid ? g_extension.percent : 0.0;
   g_entryApproval.activeLegValid      = activeLegValid;
   g_entryApproval.pullbackValid       = pullbackValid;
   g_entryApproval.resumptionValid     = resumptionValid;
   g_entryApproval.microConfirmed      = microConfirmed;
   g_entryApproval.opportunityValid    = opportunityValid;
   g_entryApproval.extensionValid      = extensionValid;
   g_entryApproval.evaluatedTime       = iTime(g_symbol, PERIOD_M1, 0);

   //--- Log only when the decision or its primary reason actually changes.
   static bool                         firstEval   = true;
   static ENUM_LITE_ENTRY_DECISION     lastDecision;
   static ENUM_LITE_ENTRY_BLOCK_REASON lastReason;

   if(firstEval || g_entryApproval.decision!=lastDecision || reason!=lastReason)
     {
      //--- 2026-09-03, explicit operator request (ACTIVE_PING ARCHITECTURE): winningCount/
      //--- highVoteOpenPositions/highVoteBypassEligible/g_highVoteBypassUsedForOpportunityId (the old
      //--- >10-votes bypass diagnostics) are REPLACED by g_activePing's own fields - the new gate that
      //--- actually determines whether OPPORTUNITY_CONSUMED blocks this decision.
      string msg;
      if(approved)
         msg = StringFormat("decision=APPROVED path=%s direction=%s opportunity=%I64u resumption=%.2f pullbackDepth=%.2f extension=%.2f microConfirmed=TRUE activePing=%s activePingCorridor=%s activePingSlope=%s activePingRange=%s strongTrendOverride=%s dnaStateM1=%s dnaStateM5=%s",
               EntryPathName(path), DirName(dir), g_entryApproval.opportunityId, g_entryApproval.resumptionPercent, g_entryApproval.pullbackDepthPercent, g_entryApproval.extensionPercent,
               g_activePing.active?"true":"false", g_activePing.corridorActive?"true":"false", g_activePing.slopeActive?"true":"false", g_activePing.rangeActive?"true":"false",
               strongTrendOverride?"true":"false", DnaName(g_dnaState), DnaName(g_dnaStateM5));
      else
         msg = StringFormat("decision=BLOCKED path=%s direction=%s opportunity=%I64u resumption=%.2f pullbackDepth=%.2f extension=%.2f reason=%s activePing=%s activePingCorridor=%s activePingSlope=%s activePingRange=%s strongTrendOverride=%s dnaStateM1=%s dnaStateM5=%s",
               EntryPathName(path), DirName(dir), g_entryApproval.opportunityId, g_entryApproval.resumptionPercent, g_entryApproval.pullbackDepthPercent, g_entryApproval.extensionPercent, BlockReasonName(reason),
               g_activePing.active?"true":"false", g_activePing.corridorActive?"true":"false", g_activePing.slopeActive?"true":"false", g_activePing.rangeActive?"true":"false",
               strongTrendOverride?"true":"false", DnaName(g_dnaState), DnaName(g_dnaStateM5));
      Print("[ENTRY_INTEL][ENTRY_APPROVAL] " + msg);
      if(Inp_DashboardLogEnabled)
         DashAppendLine("logs.jsonl", StringFormat("{\"time\":\"%s\",\"tag\":\"ENTRY_APPROVAL\",\"message\":\"%s\"}",
               DashIsoTime(TimeCurrent()), DashJsonEscape(msg)));

      firstEval    = false;
      lastDecision = g_entryApproval.decision;
      lastReason   = reason;
     }
  }

//====================================================================
// EXECUTION - fires only when the 18-Mind Vote's winning side clears
// Inp_MindsVoteMinCount AND no position from this EA is already open.
//====================================================================
double NormalizeLotSize()
  {
   double minVol  = SymbolInfoDouble(g_symbol, SYMBOL_VOLUME_MIN);
   double maxVol  = SymbolInfoDouble(g_symbol, SYMBOL_VOLUME_MAX);
   double stepVol = SymbolInfoDouble(g_symbol, SYMBOL_VOLUME_STEP);
   if(stepVol<=0.0) stepVol = minVol>0.0 ? minVol : 0.01;

   double vol = Inp_FixedLotSize;
   if(vol<minVol) vol = minVol;
   if(vol>maxVol) vol = maxVol;

   double steps = MathFloor((vol-minVol)/stepVol + 1e-8);
   vol = minVol + steps*stepVol;

   int volDigits = 2;
   if(stepVol>=0.1) volDigits=1; else if(stepVol>=1.0) volDigits=0;
   return NormalizeDouble(vol, volDigits);
  }

double USDToPriceDistance(const double usdAmount, const double lots)
  {
   double tickValue = SymbolInfoDouble(g_symbol, SYMBOL_TRADE_TICK_VALUE);
   double tickSize  = SymbolInfoDouble(g_symbol, SYMBOL_TRADE_TICK_SIZE);
   if(tickValue<=0.0 || tickSize<=0.0 || lots<=0.0 || usdAmount<=0.0) return 0.0;
   double usdPerPrice = (tickValue/tickSize)*lots;
   if(usdPerPrice<=0.0) return 0.0;
   return usdAmount/usdPerPrice;
  }

//--- 2026-08-26, explicit operator request: inverse of USDToPriceDistance() - converts a raw price
//--- distance (e.g. Pullback Recovery Difference) into its USD-at-this-lot-size equivalent, using the
//--- broker's real tick value/size (same conversion basis as every SL/TP distance elsewhere in this
//--- file). Accepts a magnitude only (matches USDToPriceDistance()'s own <=0 guard convention) -
//--- callers apply sign/direction themselves if needed.
double PriceDistanceToUSD(const double priceDist, const double lots)
  {
   double tickValue = SymbolInfoDouble(g_symbol, SYMBOL_TRADE_TICK_VALUE);
   double tickSize  = SymbolInfoDouble(g_symbol, SYMBOL_TRADE_TICK_SIZE);
   if(tickValue<=0.0 || tickSize<=0.0 || lots<=0.0 || priceDist<=0.0) return 0.0;
   double usdPerPrice = (tickValue/tickSize)*lots;
   return priceDist*usdPerPrice;
  }

//--- 2026-08-21, Step 9 (explicit operator request): broker minimum-distance guard, shared by both
//--- initial SL validation and every trailing modification. refPrice is the price the distance is
//--- measured from - the order's own fill price at initial-send time, or the current Bid/Ask at
//--- trailing-modification time (callers pass the correct one for their context).
//--- 2026-09-24, audit fix (R5): ORDER_FILLING_FOK was hardcoded at both TRADE_ACTION_DEAL send sites
//--- (SendMarketOrder()'s entry, CloseEarlyExitPosition()'s close), never checked against what this
//--- symbol's SYMBOL_FILLING_MODE actually reports as supported - a real risk if this account/broker/
//--- symbol configuration ever changes (a fresh demo account, a different broker, a symbol specification
//--- update), where every single OrderSend() in a batch would fail with no fallback. Confirmed live
//--- today: this account currently accepts FOK (~15 real fills, zero rejections) - this fix does not
//--- change that live behavior, it only adds a genuine fallback for when it stops being true. Prefers
//--- FOK (today's exact behavior) when the symbol's own reported mode allows it; falls back to IOC, then
//--- to RETURN (accepted by virtually every broker) - never silently picks something unsupported.
ENUM_ORDER_TYPE_FILLING ResolveOrderFillingMode()
  {
   long filling = SymbolInfoInteger(g_symbol, SYMBOL_FILLING_MODE);
   if((filling & SYMBOL_FILLING_FOK) != 0)  return ORDER_FILLING_FOK;  // today's exact behavior, when supported
   if((filling & SYMBOL_FILLING_IOC) != 0)  return ORDER_FILLING_IOC;
   return ORDER_FILLING_RETURN; // broadest-compatibility fallback - virtually always accepted
  }

bool BrokerStopDistanceOk(const double slPrice, const double refPrice)
  {
   long   stopsLevelPts  = SymbolInfoInteger(g_symbol, SYMBOL_TRADE_STOPS_LEVEL);
   long   freezeLevelPts = SymbolInfoInteger(g_symbol, SYMBOL_TRADE_FREEZE_LEVEL);
   double minDist         = MathMax((double)stopsLevelPts, (double)freezeLevelPts) * _Point;
   if(minDist<=0.0) return true; // broker imposes no minimum
   return MathAbs(refPrice-slPrice) >= minDist;
  }

//--- 2026-09-03, dead-code removal (duplication/drift audit, finding M2): GetStructural3BarPrice()
//--- used to live here (Step 9, Part 9 - lowest low (BUY) / highest high (SELL) of the latest 3
//--- CLOSED M1 candles) but had zero call sites - superseded by ComputeInitialSL()'s own inline
//--- 3-bar structural read just below, which duplicated the identical CopyRates+min/max logic rather
//--- than calling this. Deleted rather than kept dead; ComputeInitialSL() below is now the single
//--- implementation of this calculation.

//--- 2026-09-14, explicit operator request: widened from a 3-closed-bar structural lookback to
//--- KMIE_INITIAL_SL_LOOKBACK_BARS=15 - a wider window gives the structural level more room to sit
//--- at a genuine recent swing point rather than an arbitrarily tight 3-candle extreme, per the
//--- operator's own instruction. Only the LOOKBACK COUNT changed - the selection formula itself
//--- (MIN of lows for BUY / MAX of highs for SELL over the window), the wrong-side-of-entry check,
//--- the $3.00 minimum-distance check, the extra buffer, the broker-stop-distance check, and the
//--- $3.00 fallback (for <15 closed candles or an invalid structural level) are all UNCHANGED.
//--- 2026-09-24 NOTE: this constant is now used ONLY by the (disconnected) Compute15BarStructuralSlTrail()
//--- - see Inp_SlTrailingEnabled's own header for the full "simple SL" rearchitecture that disconnected
//--- ongoing SL trailing entirely. ComputeInitialSL() below (the live entry-time SL) now uses its OWN
//--- separate KMIE_INITIAL_SL_LOOKBACK_BARS_720 constant instead - kept as a genuinely separate #define
//--- (not a redefinition of this one) so the now-dead trail function's own reference is left untouched/
//--- unambiguous, matching this file's "disconnect the call, keep the calculation" convention.
#define KMIE_INITIAL_SL_LOOKBACK_BARS 15
//--- 2026-09-24, explicit operator request ("SL should be set according to 720 bars that we already
//--- using... trailing NOT required"): the entry-time structural SL now scans the SAME 720-closed-bar
//--- depth the (now-disconnected) 720-bar structural SL JUMP mechanism (EvaluateStructural720BarSlJump())
//--- already used for its own ongoing breakout check - reusing that same, already-approved depth for the
//--- ONE-TIME entry SL instead of inventing a new number.
#define KMIE_INITIAL_SL_LOOKBACK_BARS_720 720

//--- Step 9, Parts 1-4: structural initial SL. ALWAYS returns a usable SL price - never blocks the
//--- trade. Tries the KMIE_INITIAL_SL_LOOKBACK_BARS_720-closed-bar structural level first; falls back to
//--- a fixed $3.00 distance (via the existing USDToPriceDistance(), not a hardcoded point count)
//--- whenever fewer than KMIE_INITIAL_SL_LOOKBACK_BARS_720 closed candles exist, the structural level
//--- sits on the wrong side of entry, or it violates the broker's minimum stop distance.
double ComputeInitialSL(const int direction, const double entryPrice, const double lot, const int digits)
  {
   double structuralSL=0.0;
   MqlRates rWindow[];
   ArraySetAsSeries(rWindow, true);
   int got = CopyRates(g_symbol, PERIOD_M1, 1, KMIE_INITIAL_SL_LOOKBACK_BARS_720, rWindow); // shift 1..720 only - never shift 0

   bool structuralValid = (got>=KMIE_INITIAL_SL_LOOKBACK_BARS_720);
   if(structuralValid)
     {
      structuralSL = (direction>0) ? rWindow[0].low : rWindow[0].high;
      for(int i=1; i<got; i++)
        {
         if(direction>0) structuralSL = MathMin(structuralSL, rWindow[i].low);
         else            structuralSL = MathMax(structuralSL, rWindow[i].high);
        }

      //--- Part 3: structural sanity - must sit on the correct side of entry
      if(direction>0 && structuralSL>=entryPrice) structuralValid=false;
      if(direction<0 && structuralSL<=entryPrice) structuralValid=false;
     }
   if(structuralValid && !BrokerStopDistanceOk(structuralSL, entryPrice))
      structuralValid=false; // Part 3: broker minimum-distance requirement

   //--- 2026-08-25 (explicit operator request): minimum structural SL distance. The structural
   //--- level was previously accepted at ANY distance as long as it was technically valid (right side
   //--- of entry, clears the broker's own minimum) - real logs showed stops as tight as $2.75 on quiet
   //--- windows. Reusing the SAME amount and the SAME USDToPriceDistance() conversion
   //--- already used by the fallback branch below (not a new constant/input) - a structural distance
   //--- tighter than that now falls through to that identical fallback, so the two paths agree exactly.
   //--- 2026-09-16, explicit operator request ("make it SL would be 10 dollar"): raised from $3.00 to
   //--- $10.00 - both this minimum-distance rejection threshold AND the fallback distance below changed
   //--- together (confirmed via AskUserQuestion), so the two paths continue to agree exactly at the
   //--- boundary, same as before this change.
   if(structuralValid)
     {
      double minDistUSD = USDToPriceDistance(10.00, lot);
      if(minDistUSD>0.0 && MathAbs(entryPrice-structuralSL)<minDistUSD)
         structuralValid=false;
     }

   double finalSL;
   if(structuralValid)
     {
      //--- 2026-09-01, explicit operator request (STRUCTURAL SL EXTRA BUFFER): pushes the structural
      //--- level an ADDITIONAL Inp_StructuralSLExtraBufferUSD further from entry, on top of the raw
      //--- structural level (which has already passed the existing $3.00 MINIMUM-distance check above -
      //--- this buffer is applied ON TOP of that, never instead of it). Widening an SL only ever
      //--- moves it FURTHER from entry, never closer - so it cannot violate BrokerStopDistanceOk()'s
      //--- own minimum-distance requirement (already checked above, against the un-buffered
      //--- structuralSL) - a wider stop only makes that check MORE easily satisfied, never less.
      double extraBufDist = USDToPriceDistance(Inp_StructuralSLExtraBufferUSD, lot);
      double bufferedSL = (direction>0) ? (structuralSL - extraBufDist) : (structuralSL + extraBufDist);
      finalSL = NormalizeDouble(bufferedSL, digits);
      Print(StringFormat("KMIE_MarketDNA_Lite: SLMode=STRUCTURAL_%d_BAR direction=%s entry=%.3f SL=%.3f (structural=%.3f extraBufferUSD=%.2f barsUsed=%d)",
            KMIE_INITIAL_SL_LOOKBACK_BARS_720, direction>0?"BUY":"SELL", entryPrice, finalSL, structuralSL, Inp_StructuralSLExtraBufferUSD, got));
     }
   else
     {
      //--- 2026-09-16, explicit operator request ("make it SL would be 10 dollar"): raised from $3.00 to
      //--- $10.00 - see the matching minimum-distance threshold change above this function's own header
      //--- for the paired update (confirmed via AskUserQuestion - both changed together).
      double fbDist = USDToPriceDistance(10.00, lot); // Part 4: existing USDToPriceDistance(), not a fixed point count
      finalSL = (direction>0) ? NormalizeDouble(entryPrice-fbDist, digits) : NormalizeDouble(entryPrice+fbDist, digits);
      Print(StringFormat("KMIE_MarketDNA_Lite: SLMode=FIXED_10_USD_FALLBACK direction=%s entry=%.3f SL=%.3f fallbackUSD=10.00",
            direction>0?"BUY":"SELL", entryPrice, finalSL));
     }
   return finalSL;
  }

//--- 2026-09-12, explicit operator request (TRADE MANAGEMENT ENGINE ARCHITECTURAL REPLACEMENT): initial
//--- broker-side TP, computed once at entry from THIS ticket's own originalRisk (abs(entryPrice-sl)) -
//--- never a fixed USD distance (Inp_TakeProfitUSD is no longer read anywhere). Pure function - no
//--- globals read/written beyond the Inp_InitialTP_R input, safe to unit-test directly (see
//--- RunTradeManagementEngineTests()). `lot`/`digits` are accepted for signature symmetry with
//--- ComputeInitialSL() (and in case a future revision needs lot-based rounding) but digits is the only
//--- one actually used (NormalizeDouble) - lot is intentionally unused by the formula itself.
double ComputeInitialTP(const int direction, const double entryPrice, const double sl, const double lot, const int digits)
  {
   double originalRisk = MathAbs(entryPrice - sl);
   double rawTP = (direction>0) ? (entryPrice + originalRisk*Inp_InitialTP_R) : (entryPrice - originalRisk*Inp_InitialTP_R);
   //--- 2026-09-24, audit fix (R6): unlike SL (ComputeInitialSL() already calls BrokerStopDistanceOk()),
   //--- TP was never distance-checked against the broker's own minimum stop/freeze level - a rejected
   //--- req.tp fails the WHOLE OrderSend() (both fields are sent together), even though req.sl itself was
   //--- fine. In practice this is rare (TP sits at originalRisk*Inp_InitialTP_R from entry, and
   //--- originalRisk already respects the broker's minimum via ComputeInitialSL(), so TP is almost always
   //--- further out than SL) - but "almost always" is not "always", so this is a genuine gap, not a
   //--- hypothetical one. Same "widen to just clear the floor" fallback pattern ComputeInitialSL() itself
   //--- uses, not a silent pass-through: if the R-multiple TP would violate the broker's minimum distance,
   //--- it is pushed out to exactly that minimum instead - the R-multiple sizing is the PREFERRED target,
   //--- this only ever widens it, never narrows it.
   if(!BrokerStopDistanceOk(rawTP, entryPrice))
     {
      long   stopsLevelPts  = SymbolInfoInteger(g_symbol, SYMBOL_TRADE_STOPS_LEVEL);
      long   freezeLevelPts = SymbolInfoInteger(g_symbol, SYMBOL_TRADE_FREEZE_LEVEL);
      double minDist         = MathMax((double)stopsLevelPts, (double)freezeLevelPts) * _Point;
      rawTP = (direction>0) ? (entryPrice + minDist) : (entryPrice - minDist);
      Print(StringFormat("[COMPUTE_INITIAL_TP][WIDENED_FOR_BROKER_MINIMUM] direction=%s entryPrice=%.3f originalRisk=%.3f requestedTP=%.3f minDist=%.3f widenedTP=%.3f",
            direction>0?"BUY":"SELL", entryPrice, originalRisk,
            (direction>0) ? (entryPrice + originalRisk*Inp_InitialTP_R) : (entryPrice - originalRisk*Inp_InitialTP_R),
            minDist, rawTP));
     }
   return NormalizeDouble(rawTP, digits);
  }

//--- 2026-09-08, explicit operator request ("Before Excuting the Trade bot should check Tick of running
//--- Candle should Cross weight of 50%"): NEW pre-execution gate, checked at the TOP of SendMarketOrder()
//--- so it applies uniformly to EVERY execution path that routes through here (fresh entries via
//--- MaybeExecute(), the Retry Engine's own SubmitRetryTrade(), Reverse Fire - confirmed via
//--- AskUserQuestion: "ALL trade executions... a single check added inside SendMarketOrder() itself").
//--- Reads the CURRENTLY FORMING (shift=0, live) M1 candle and requires the current price to already
//--- sit at least 50% of the way through that candle's OWN range-so-far (high-low since it opened),
//--- in the trade's own direction - confirmed via AskUserQuestion:
//---   BUY:  (currentPrice-candleOpen) / (candleHigh-candleLow) >= 0.5
//---   SELL: (candleOpen-currentPrice) / (candleHigh-candleLow) >= 0.5
//--- A flat/zero-range running candle (candleHigh==candleLow, e.g. the very first tick of a new bar)
//--- cannot satisfy this - blocks rather than divides by zero or guesses. This directly targets the
//--- "re-punching the same direction right after a recent loss" scenario the operator described: a
//--- still-valid CONTINUATION opportunity + sustained ACTIVE_PING could previously re-fire without the
//--- CURRENT candle itself showing any fresh directional conviction - this gate requires that
//--- conviction to exist at the exact moment of execution, independent of Market DNA/Minds/Entry
//--- Approval/ACTIVE_PING (all of those remain completely unchanged - this is an ADDITIONAL, final
//--- check, never a replacement for any existing gate).
//--- 2026-09-09, explicit operator request (POST-LOSS SAME-DIRECTION RE-ENTRY LOCK): pure classifier -
//--- given an explicit currentPrice (never reads SymbolInfoDouble() itself), returns whether price has
//--- crossed the reference (losing trade's exit) price FAVORABLY for a fresh same-direction entry.
//--- direction>0 (BUY): crossed once currentPrice > referencePrice (still locked while <=).
//--- direction<0 (SELL): crossed once currentPrice < referencePrice (still locked while >=).
//--- Factored out from IsPostLossReentryLocked() specifically so self-tests can exercise this exact
//--- boolean with literal Bid/Ask values instead of needing live market data - same pure/live-wrapper
//--- split pattern already used elsewhere in this file (e.g. ClassifyActivePing()/EvaluateActivePing()).
bool HasPriceCrossedFavorably(const int direction, const double referencePrice, const double currentPrice)
  {
   if(direction>0) return currentPrice > referencePrice;   // BUY: locked while currentPrice<=referencePrice
   if(direction<0) return currentPrice < referencePrice;   // SELL: locked while currentPrice>=referencePrice
   return false; // direction==0 is never a valid candidate direction - treat as not-crossed/no-op
  }

//--- 2026-09-09, explicit operator request (POST-LOSS SAME-DIRECTION RE-ENTRY LOCK): pure classifier -
//--- mirrors IsPostLossReentryLocked()'s own direction-match check in isolation, testable without any
//--- live global state. Returns whether an armed lock (for lockDirection) actually applies to a
//--- candidateDirection (1=BUY,-1=SELL) attempt - false whenever the lock isn't armed, or is armed for
//--- the OPPOSITE direction (which naturally lets reversals/opposite-direction entries through
//--- unaffected, per operator's Part 8 requirement).
bool IsPostLossLockApplicable(const ENUM_LITE_DIR lockDirection, const bool lockArmed, const int candidateDirection)
  {
   if(!lockArmed) return false;
   ENUM_LITE_DIR candDir = (candidateDirection>0) ? LDIR_BUY : (candidateDirection<0) ? LDIR_SELL : LDIR_WAIT;
   if(candDir==LDIR_WAIT) return false;
   return (lockDirection==candDir);
  }

//--- 2026-09-09, explicit operator request (POST-LOSS SAME-DIRECTION RE-ENTRY LOCK - Part 1 of the 3
//--- new entry-protection gates): after a LOSING close, blocks a new SAME-direction entry until running
//--- Bid/Ask has crossed the losing trade's own close (exit) price favorably, or the Minds direction
//--- genuinely flips (handled by EvaluateActivePing()'s own release-condition-2 logic, which un-arms
//--- g_activePing.postLossLockArmed - this function just reads whatever is currently armed). Uses the
//--- LIVE g_lastClosedTrade.exitPrice directly (never the cached postLossLockReferencePrice diagnostic
//--- copy) per the design's explicit freshness reasoning - the cached copy could theoretically go stale
//--- if this function were ever called before EvaluateActivePing() re-syncs it, whereas g_lastClosedTrade
//--- itself is authoritative the instant CleanupTrailingSlots() populates it.
bool IsPostLossReentryLocked(const int direction)
  {
   if(!IsPostLossLockApplicable(g_activePing.postLossLockDirection, g_activePing.postLossLockArmed, direction))
      return false; // not locked - either not armed, or armed for the opposite direction (allows reversals through)

   double curPrice = (direction>0) ? SymbolInfoDouble(g_symbol, SYMBOL_BID) : SymbolInfoDouble(g_symbol, SYMBOL_ASK);
   bool crossed = HasPriceCrossedFavorably(direction, g_lastClosedTrade.exitPrice, curPrice);
   return !crossed; // still locked while NOT yet crossed favorably
  }

bool RunningCandleWeightOk(const int direction)
  {
   MqlRates live[];
   ArraySetAsSeries(live, true);
   if(CopyRates(g_symbol, PERIOD_M1, 0, 1, live)<1) return false; // running candle unavailable - never guess, block

   double candleOpen = live[0].open;
   double candleHigh = live[0].high;
   double candleLow  = live[0].low;
   double curPrice   = (direction>0) ? SymbolInfoDouble(g_symbol, SYMBOL_BID) : SymbolInfoDouble(g_symbol, SYMBOL_ASK);
   double range       = candleHigh-candleLow;
   if(range<=0.0) return false; // flat/zero-range running candle - no directional conviction possible yet

   double weight = (direction>0) ? (curPrice-candleOpen)/range : (candleOpen-curPrice)/range;
   return weight>=0.50;
  }

//--- 2026-09-16, M5 PARALLEL PIPELINE: straight duplicate of RunningCandleWeightOk() above, reading the
//--- running M5 candle (PERIOD_M5, shift=0) instead of the running M1 candle. Used only by
//--- EvaluateBarConfirmationM5() (the M5 Bar Confirmation wrapper) - never by SendMarketOrder(), which
//--- always uses the M1 running-candle check regardless of Inp_DnaTimeframeMode, per the plan's own
//--- scope (SendMarketOrder()'s pre-execution gate is left untouched).
bool RunningCandleWeightOkM5(const int direction)
  {
   MqlRates live[];
   ArraySetAsSeries(live, true);
   if(CopyRates(g_symbol, PERIOD_M5, 0, 1, live)<1) return false;

   double candleOpen = live[0].open;
   double candleHigh = live[0].high;
   double candleLow  = live[0].low;
   double curPrice   = (direction>0) ? SymbolInfoDouble(g_symbol, SYMBOL_BID) : SymbolInfoDouble(g_symbol, SYMBOL_ASK);
   double range       = candleHigh-candleLow;
   if(range<=0.0) return false;

   double weight = (direction>0) ? (curPrice-candleOpen)/range : (candleOpen-curPrice)/range;
   return weight>=0.50;
  }

//--- 2026-09-24, explicit operator request ("if there signal for one ticket than it should be applied to
//--- all the open trade in TP and SL as well" - clarified via AskUserQuestion: EVERY ticket opened by the
//--- SAME signal/batch must share ONE identical SL and ONE identical TP, computed once, not independently
//--- per-ticket from each ticket's own slightly-different real fill price). sharedSL/sharedTP are
//--- OPTIONAL overrides (default 0.0 = "not specified", preserving the exact old per-ticket-computed
//--- behavior for every OTHER caller of this function - Reverse Fire's own call site passes neither and
//--- is completely unaffected). Only MaybeExecute()'s own batch-send loop passes real values here, computed
//--- ONCE from the FIRST ticket in the batch, then reused for every subsequent sibling - see that loop's
//--- own updated comment for the full mechanism.
//--- outActualSL/outActualTP (added alongside sharedSL/sharedTP above, same task): report back the EXACT
//--- sl/tp values this call actually used (whichever of shared-override or freshly-computed applied) -
//--- lets MaybeExecute()'s batch loop capture the FIRST ticket's real values to reuse as sharedSL/sharedTP
//--- for every subsequent sibling in the same batch. Written unconditionally on every call (even a BLOCKED/
//--- FAILED one, left at 0.0 in that case - a caller must check the function's own bool return before
//--- trusting these).
bool SendMarketOrder(const int direction, double &outActualSL, double &outActualTP, const double sharedSL=0.0, const double sharedTP=0.0) // 1=buy, -1=sell
  {
   outActualSL = 0.0; outActualTP = 0.0;
   //--- Checked FIRST, before any request is even constructed - a failed check here means no order is
   //--- attempted at all this call, exactly like every other pre-execution gate in this file.
   //--- 2026-09-24 FIX, explicit operator request ("my bot also not able excute the all count mention
   //--- trade at the same [time]... same signal that we received for first trade that would apply for
   //--- all count tickets" -> "TURN OFF RUNNING CANDLE WEIGHT FIRST WHO ACTIVE IT"): live-verified root
   //--- cause - a real batch of 10+ tickets ALL blocked here within under 100ms
   //--- (RUNNING_CANDLE_WEIGHT_BELOW_50PCT, 20260924.log 07:25:00.527-07:25:00.591) because this call was
   //--- UNCONDITIONAL, completely ignoring Inp_RunningCandleWeightEnabled - a genuine wiring gap, not
   //--- intended behavior. Inp_RunningCandleWeightEnabled already exists and is already respected by
   //--- EvaluateBarConfirmation()/EvaluateBarConfirmationM5()'s own candleOk checks (this same input's
   //--- other two call sites) - this THIRD site (SendMarketOrder()'s own pre-execution gate) simply never
   //--- read it. The operator's own live .set already has Inp_RunningCandleWeightEnabled=false (confirmed
   //--- via the RUNNING_CANDLE_WEIGHT_TOGGLE_TEST1 self-test's own "expected default true, got false"
   //--- mismatch, present since before this fix) - so this fix alone, with no further input change
   //--- required, immediately stops this specific gate from ever blocking any ticket in a batch again.
   if(Inp_RunningCandleWeightEnabled && !RunningCandleWeightOk(direction))
     {
      Print(StringFormat("[SEND_ORDER][BLOCKED] direction=%s reason=RUNNING_CANDLE_WEIGHT_BELOW_50PCT", direction>0?"BUY":"SELL"));
      DashAppendLine("logs.jsonl", StringFormat("{\"time\":\"%s\",\"tag\":\"SEND_ORDER_BLOCKED\",\"message\":\"direction=%s reason=RUNNING_CANDLE_WEIGHT_BELOW_50PCT\"}",
            DashIsoTime(TimeCurrent()), direction>0?"BUY":"SELL"));
      return false;
     }

   MqlTradeRequest req; MqlTradeResult res;
   ZeroMemory(req); ZeroMemory(res);

   int digits = (int)SymbolInfoInteger(g_symbol, SYMBOL_DIGITS);
   double price = (direction>0) ? SymbolInfoDouble(g_symbol, SYMBOL_ASK) : SymbolInfoDouble(g_symbol, SYMBOL_BID);
   double lot = NormalizeLotSize();
   //--- 2026-09-24: sharedSL/sharedTP>0.0 means the caller (MaybeExecute()'s batch loop) is providing this
   //--- batch's ONE shared SL/TP (computed once, from the batch's first ticket) - use it verbatim, never
   //--- recompute per-ticket. 0.0 (the default) means "no override" - every other caller (Reverse Fire)
   //--- keeps computing its own independent SL/TP exactly as before this change.
   double sl = (sharedSL>0.0) ? sharedSL : ComputeInitialSL(direction, price, lot, digits); // Step 9: structural 15-bar SL (widened from 3 bars 2026-09-14), $10 fallback (raised from $3 on 2026-09-16) - Inp_StopLossUSD no longer used for initial SL
   double tp = (sharedTP>0.0) ? sharedTP : ComputeInitialTP(direction, price, sl, lot, digits); // 2026-09-12: R-multiple initial TP, see ComputeInitialTP()'s own header

   req.action       = TRADE_ACTION_DEAL;
   req.symbol       = g_symbol;
   req.volume       = lot;
   req.type         = (direction>0) ? ORDER_TYPE_BUY : ORDER_TYPE_SELL;
   req.price        = price;
   req.sl           = NormalizeDouble(sl, digits);
   //--- 2026-09-12, explicit operator request (TRADE MANAGEMENT ENGINE ARCHITECTURAL REPLACEMENT): this
   //--- comment SUPERSEDES the 2026-09-08 "req.tp intentionally left at 0.0" note that used to live here
   //--- (that note is now WRONG - do not trust it if seen elsewhere/in old diffs). The position now opens
   //--- WITH a real broker-side TP: req.tp = tp, computed by ComputeInitialTP() as entryPrice +/-
   //--- originalRisk*Inp_InitialTP_R (default 2R). Ongoing SL/TP management for the life of the trade is
   //--- now TradeManagementEngine()'s sole job (called from ManageOpenPositions(), replacing the five
   //--- disconnected legacy mechanisms - EvaluateEma35TrackingSl()/ApplyProfitTierTrailingSl()/
   //--- EvaluateEarlyExit()/EvaluateEarlySlWatcher()/EvaluateEarlyTpWatcher(), all retained but
   //--- disconnected, see their own headers): AdaptiveSlEngine() trails the SL according to the
   //--- EXPANSION/DECELERATION/EXHAUSTION market state, never widening; ProgressiveTpEngine() extends
   //--- this initial TP further under sustained EXPANSION (structural-level-aware, ratchet-only, never
   //--- capped, never moves backward), or freezes it under DECELERATION/EXHAUSTION.
   req.tp           = tp;
   req.deviation    = Inp_Slippage;
   req.magic        = Inp_MagicNumber;
   req.type_filling = ResolveOrderFillingMode(); // 2026-09-24 audit fix (R5): queries SYMBOL_FILLING_MODE instead of hardcoding FOK - see that function's own header
   req.comment      = "KMIE_Lite_DNA_Minds";

   bool sent = OrderSend(req, res);
   Print("KMIE_MarketDNA_Lite: OrderSend dir=", direction>0?"BUY":"SELL", " sent=", sent,
         " retcode=", res.retcode, " ticket=", res.order, " volume=", DoubleToString(res.volume,2));
   //--- 2026-08-31, explicit operator request: same MT5 log-persistence gap as above - this is the
   //--- ONE line that shows every individual OrderSend() attempt's own retcode/ticket, which is what
   //--- would reveal a requote/rejection the broker silently filled anyway (a phantom-fill mechanism
   //--- candidate). Diagnostic-only, mirrors the Print() above, never read by any trading decision.
   DashAppendLine("logs.jsonl", StringFormat(
      "{\"time\":\"%s\",\"tag\":\"ORDER_SEND\",\"message\":\"dir=%s sent=%s retcode=%d ticket=%I64u volume=%.2f\"}",
      DashIsoTime(TimeCurrent()), direction>0?"BUY":"SELL", sent?"true":"false", (int)res.retcode, res.order, res.volume));
   //--- 2026-08-21, Entry Intelligence Step 7.2 (explicit operator request, minimal correction):
   //--- TRADE_RETCODE_DONE_PARTIAL means the broker actually opened a real position/deal at a
   //--- partially-filled volume (MqlTradeResult.volume reports the confirmed filled amount) - this
   //--- is genuine execution, not a failure. Excluding it here would let a real open position exist
   //--- on the account while this ticket-slot was still counted as "failed," which could leave the
   //--- opportunity falsely AVAILABLE despite a real fill - the exact case the safety principle
   //--- forbids. DONE and PLACED behavior is unchanged; no request/order-construction field changed.
   bool ok = sent && (res.retcode==TRADE_RETCODE_DONE || res.retcode==TRADE_RETCODE_PLACED || res.retcode==TRADE_RETCODE_DONE_PARTIAL);
   //--- 2026-08-24, explicit operator request: capture the ACTUAL regime at the moment this order
   //--- was approved and sent - see EntryDnaRecord's header comment for why this can't just be read
   //--- later from live g_dnaState in UpdateDashboardLogs(). res.order is this position's own ticket
   //--- (same convention already used by the Print above and by ManageOpenPositions() elsewhere).
   if(ok)
     {
      //--- 2026-09-24: report back the exact sl/tp this successful send actually used, so
      //--- MaybeExecute()'s batch loop can capture the FIRST ticket's real values as this batch's shared
      //--- SL/TP for every subsequent sibling. Only set on a CONFIRMED successful send (inside this same
      //--- "ok" branch) - a blocked/failed attempt leaves both at their 0.0 default, so a caller can never
      //--- mistake a failed send's never-executed values for a real shared SL/TP.
      outActualSL = sl;
      outActualTP = tp;
      RecordEntryDna(req, res, direction);

      //--- 2026-09-12, explicit operator request (TRADE MANAGEMENT ENGINE ARCHITECTURAL REPLACEMENT):
      //--- allocate this ticket's g_tme[] slot HERE, at entry, rather than reconstructing originalSL/
      //--- originalRisk later in ManageOpenPositions() - cleaner, and matches how g_trailing[]'s own
      //--- slot is typically first touched near entry (AllocTrailingSlot(), called from
      //--- ManageOpenPositions() the first tick it sees the ticket - this is the analogous "first touch"
      //--- moment for g_tme[], just even earlier, at the moment of the order itself). res.order is this
      //--- position's own ticket (same field RecordEntryDna() above already uses).
      int tmeSlot = FindTmeSlot(res.order);
      if(tmeSlot<0) tmeSlot = AllocTmeSlot(res.order);
      if(tmeSlot>=0)
        {
         g_tme[tmeSlot].originalSL   = req.sl;
         g_tme[tmeSlot].originalRisk = MathAbs(req.price - req.sl);
         g_tme[tmeSlot].currentTP    = req.tp;
         g_tme[tmeSlot].tpStage      = 0;
         g_tme[tmeSlot].managementState = (int)TME_STATE_EXPANSION;
         //--- 2026-09-24: batch membership - see batchOpportunityId's own header on TradeManagementState.
         //--- ONLY a genuinely ORIGINAL entry (the SAME priority-check RecordEntryDna() itself uses for
         //--- entrySource, reused verbatim here, never reimplemented) gets tagged with this batch's real
         //--- g_opportunity.id - every other entry type (Reverse Fire/Early Re-Entry/C2 Refire, and by
         //--- extension the Retry Engine/M5 Swing Reverse Trade, which also call SendMarketOrder() outside
         //--- MaybeExecute()'s own batch loop) is always a single, independent trade and stays at the 0
         //--- "no batch" sentinel AllocTmeSlot() already defaulted it to.
         bool isOriginalEntry = !g_reverseFireInProgress && !g_opportunity.isEarlyReEntryOpp && !g_opportunity.isC2Refire;
         if(isOriginalEntry) g_tme[tmeSlot].batchOpportunityId = g_opportunity.id;
        }
      else
         Print("KMIE_MarketDNA_Lite: TradeManagementEngine state pool exhausted (32 slots) at entry, ticket=", res.order,
               " - TradeManagementEngine() will lazily allocate on first ManageOpenPositions() tick instead.");

      //--- INITIAL_TP telemetry (Step 8) - logged once at entry, alongside the existing ORDER_SEND/
      //--- EXECUTION_IDENTITY logging above (inside RecordEntryDna()). Same 3-key {"time","tag","message"}
      //--- schema as every other logs.jsonl line in this file.
      string initialTpMsg = StringFormat("ticket=%I64u direction=%s entry=%.3f sl=%.3f tp=%.3f originalRisk=%.3f initialTpR=%.2f",
            res.order, direction>0?"BUY":"SELL", req.price, req.sl, req.tp, MathAbs(req.price-req.sl), Inp_InitialTP_R);
      Print("[INITIAL_TP] " + initialTpMsg);
      DashAppendLine("logs.jsonl", StringFormat("{\"time\":\"%s\",\"tag\":\"INITIAL_TP\",\"message\":\"%s\"}",
            DashIsoTime(TimeCurrent()), initialTpMsg));
     }
   return ok;
  }

//--- 2026-08-20, explicit operator request: "if there is already trade are open don't execute
//--- new trade". Counts open positions for THIS symbol+magic only (never touches positions from
//--- any other EA/magic on the account).
int CountOpenPositions()
  {
   int cnt=0;
   for(int i=PositionsTotal()-1;i>=0;i--)
     {
      ulong ticket = PositionGetTicket(i);
      if(ticket==0) continue;
      if(PositionGetString(POSITION_SYMBOL)!=g_symbol) continue;
      if((long)PositionGetInteger(POSITION_MAGIC)!=Inp_MagicNumber) continue;
      cnt++;
     }
   return cnt;
  }

//--- 2026-08-31, explicit operator request (OVERSHOOT LOCKOUT): a real live incident showed
//--- Inp_TicketsPerSignal=5 batches sometimes ending up with 10 actual open positions (two clean
//--- price clusters of 5, single OrderSend()x5 loop, ticketsSent=5/5 per the EA's own count - root
//--- cause traced to something producing more broker-side fills/positions than OrderSend() calls,
//--- not a duplicate EA-side firing). Rather than trying to prevent the overshoot at its unclear
//--- source, this is a hard, unconditional downstream safety net: the instant MORE positions exist
//--- than any single batch should ever produce, ALL entry paths (first entry, Early Re-Entry/C2,
//--- Retry Engine) are blocked - no exceptions - until the account is genuinely flat (0 open
//--- positions for this symbol+magic) again. Does not touch SL/TP/trailing/Early-Exit/position
//--- management in any way - those continue managing whatever is actually open, unaffected.
bool g_overshootLockoutActive = false;

bool IsOvershootLockoutActive()
  {
   int openCount = CountOpenPositions();
   if(openCount>Inp_TicketsPerSignal)
     {
      if(!g_overshootLockoutActive)
         Print(StringFormat("KMIE_MarketDNA_Lite: [OVERSHOOT_LOCKOUT] ENGAGED - %d open positions exceeds Inp_TicketsPerSignal=%d - ALL new entries (first/re-entry/retry) blocked until flat (0 open).",
               openCount, Inp_TicketsPerSignal));
      g_overshootLockoutActive = true;
      return true;
     }
   if(openCount==0 && g_overshootLockoutActive)
     {
      Print("KMIE_MarketDNA_Lite: [OVERSHOOT_LOCKOUT] CLEARED - account is flat again, entries re-enabled.");
      g_overshootLockoutActive = false;
     }
   return g_overshootLockoutActive;
  }

//--- 2026-09-01, explicit operator request (NEWS ALERT / NEW-ENTRY PAUSE): see this feature's own
//--- input-group header comment above for the full scope/confirmation record. Throttled to re-query
//--- CalendarValueHistory() once per real-second (not once per tick - a tick can fire many times per
//--- second) via g_newsCheckLastTime, same throttle convention as g_mindsLogLastTime elsewhere in
//--- this file - the cached g_newsBlackoutActive/g_newsBlackoutReason results between throttled
//--- checks, so a call made mid-second still gets a correct (if up-to-1-second-stale) answer rather
//--- than skipping the check entirely.
bool     g_newsBlackoutActive = false;
string   g_newsBlackoutReason = "";
datetime g_newsCheckLastTime = 0;
//--- 2026-09-02, explicit operator request: one-shot "has the calendar diagnostic line been written
//--- yet this EA session" flag - see its own use inside IsNewsBlackoutActive() for why.
bool     g_newsCalendarDiagLogged = false;

bool IsNewsBlackoutActive()
  {
   if(!Inp_NewsFilterEnabled) return false;

   datetime nowT = TimeCurrent();
   if(nowT==g_newsCheckLastTime) return g_newsBlackoutActive; // same second already checked - reuse cached result
   g_newsCheckLastTime = nowT;

   //--- CalendarValueHistory() returns NO data inside the Strategy Tester (a documented MQL5
   //--- limitation, not a bug here) - this feature is live-trading-only by nature of the API itself;
   //--- returning false (never blocking) when the calendar genuinely has nothing to report is the
   //--- correct behavior, not a fabricated "no news" claim - there IS no data to claim otherwise from.
   datetime searchFrom = nowT - (datetime)(Inp_NewsCalendarLookbackMinutes*60);
   datetime searchTo   = nowT + (datetime)(Inp_NewsCalendarLookbackMinutes*60);

   //--- 4th param is country_code (e.g. "US"), NOT a currency filter - and 5th is event_code (a
   //--- specific event identifier), also not currency. Both left NULL (no country/event narrowing at
   //--- the API level) - currency filtering happens below via CalendarEventById()'s own country_id ->
   //--- CalendarCountryById() -> country.currency (MqlCalendarEvent itself has NO currency field -
   //--- confirmed against MQL5's own structures reference after an earlier attempt guessed wrong and
   //--- failed to compile - see the loop below for the corrected lookup).
   MqlCalendarValue values[];
   int got = CalendarValueHistory(values, searchFrom, searchTo, NULL, NULL);

   //--- 2026-09-02, explicit operator request ("does my news section work"): MT5 was not reliably
   //--- persisting this EA's Print() output (same gap fixed earlier for ORDER_SEND/EXECUTION_IDENTITY),
   //--- making it impossible to verify from the log files alone whether the calendar is even returning
   //--- data on this account (a real, documented failure mode - see this feature's own header on
   //--- calendar-sync caveats), separately from whether it has ever actually blocked a trade. This one
   //--- diagnostic line writes ONCE PER SESSION (g_newsCalendarDiagLogged, never per-tick) so it never
   //--- floods logs.jsonl, and reports the raw got count plus GetLastError() when got<=0 - the single
   //--- most useful fact for diagnosing "is the calendar populated at all" vs "no news right now".
   if(!g_newsCalendarDiagLogged)
     {
      g_newsCalendarDiagLogged = true;
      DashAppendLine("logs.jsonl", StringFormat(
         "{\"time\":\"%s\",\"tag\":\"NEWS_CALENDAR_DIAG\",\"message\":\"CalendarValueHistory got=%d lastError=%d searchFrom=%s searchTo=%s\"}",
         DashIsoTime(nowT), got, (got<=0)?GetLastError():0, DashIsoTime(searchFrom), DashIsoTime(searchTo)));
     }

   if(got<=0)
     {
      bool wasActive = g_newsBlackoutActive;
      g_newsBlackoutActive = false; g_newsBlackoutReason = "";
      if(wasActive)
        {
         Print("KMIE_MarketDNA_Lite: [NEWS_FILTER] CLEARED - no qualifying events in range.");
         DashAppendLine("logs.jsonl", StringFormat(
            "{\"time\":\"%s\",\"tag\":\"NEWS_FILTER\",\"message\":\"CLEARED - no qualifying events in range\"}",
            DashIsoTime(nowT)));
        }
      return false;
     }

   long beforeSec = (long)Inp_NewsMinutesBefore*60;
   long afterSec  = (long)Inp_NewsMinutesAfter*60;

   for(int i=0; i<got; i++)
     {
      MqlCalendarEvent ev;
      if(!CalendarEventById(values[i].event_id, ev)) continue;
      if(ev.importance!=CALENDAR_IMPORTANCE_HIGH) continue;
      //--- 2026-09-01 fix (real compile error - "undeclared identifier 'currency'"): MqlCalendarEvent
      //--- has NO currency field (verified against MQL5's own structures reference after the first
      //--- attempt guessed wrong and failed to compile) - currency lives only on MqlCalendarCountry,
      //--- reached via event.country_id -> CalendarCountryById(). Never a second/independent lookup
      //--- technique - this is the one documented path (MQL5 Book: "Getting event records by country
      //--- or currency").
      MqlCalendarCountry country;
      if(!CalendarCountryById(ev.country_id, country)) continue;
      if(country.currency!=Inp_NewsCurrency) continue;

      datetime evTime = values[i].time;
      datetime windowStart = evTime - (datetime)beforeSec;
      datetime windowEnd   = evTime + (datetime)afterSec;
      if(nowT>=windowStart && nowT<=windowEnd)
        {
         string reason = StringFormat("%s (%s, %s) at %s",
                             ev.name,
                             Inp_NewsCurrency,
                             "HIGH",
                             DashIsoTime(evTime));
         if(!g_newsBlackoutActive || g_newsBlackoutReason!=reason)
           {
            Print(StringFormat("KMIE_MarketDNA_Lite: [NEWS_FILTER] ENGAGED - %s - ALL new entries (first/re-entry/retry) blocked until %s.",
                  reason, DashIsoTime(windowEnd)));
            DashAppendLine("logs.jsonl", StringFormat(
               "{\"time\":\"%s\",\"tag\":\"NEWS_FILTER\",\"message\":\"ENGAGED - %s - blocked until %s\"}",
               DashIsoTime(nowT), DashJsonEscape(reason), DashIsoTime(windowEnd)));
           }
         g_newsBlackoutActive = true;
         g_newsBlackoutReason = reason;
         return true;
        }
     }

   bool wasActive2 = g_newsBlackoutActive;
   g_newsBlackoutActive = false; g_newsBlackoutReason = "";
   if(wasActive2)
     {
      Print("KMIE_MarketDNA_Lite: [NEWS_FILTER] CLEARED - outside every qualifying event's window now.");
      DashAppendLine("logs.jsonl", StringFormat(
         "{\"time\":\"%s\",\"tag\":\"NEWS_FILTER\",\"message\":\"CLEARED - outside every qualifying event's window now\"}",
         DashIsoTime(nowT)));
     }
   return false;
  }

string ExecutionStatusName(const ENUM_LITE_EXECUTION_STATUS s)
  {
   switch(s)
     {
      case EXECUTION_FULL:    return "FULL";
      case EXECUTION_PARTIAL: return "PARTIAL";
      default:                return "FAILED";
     }
  }

//====================================================================
// RETRY TRADE ENGINE (2026-08-31, explicit operator request)
//
// A genuinely independent, parallel retry path - separate from Opportunity Lifecycle/
// OPPORTUNITY_CONSUMED and from EarlyReEntryEligible()/"C2 Trend-Refire" (never merged with either;
// EarlyReEntryEligible()'s own body was later permanently deleted, 2026-09-09, but that is a separate,
// unrelated change - this Retry Engine section itself was not touched by it). See g_retryEngine's own
// header comment (near EntryApprovalState) for the exit-
// classification method and RegisterRetryCandidate()/ClassifyRetryExit() (near CleanupTrailingSlots())
// for how a candidate is armed. This section only covers: DNA eligibility, the central decision
// function, and order submission.
//====================================================================

//--- Section 7 (explicit operator request): a DEDICATED, single-purpose eligibility function - no DNA
//--- checks scattered elsewhere in the retry path. No approved retry-DNA whitelist exists anywhere
//--- else in this file (EarlyReEntryEligible()'s own DNA list was a DIFFERENT mechanism's list, for a
//--- different trigger condition - continuation strength, not trailing/BE exit - and was never reused
//--- here, per the explicit instruction not to
//--- merge the two engines). Per explicit instruction: do NOT invent a whitelist from intuition, and
//--- the forensic pullback/SR study already found DNA state alone does not reliably separate safe from
//--- dangerous conditions. Default whitelist is therefore EMPTY - retry is DNA-gated OFF for every
//--- state until a human operator populates KMIE_RETRY_DNA_WHITELIST below from real calibration data
//--- (the same kind of evidence-based process the forensic audits in this session already used for
//--- other decisions). This is intentional and MUST NOT be treated as a bug - it means the Retry
//--- Engine will currently never fire (DNA gate always false), which is the safe default until
//--- calibrated.
bool KMIE_RETRY_DNA_WHITELIST[LDNA_STATE_COUNT]; // zero-initialized (all false) by MQL5 - PENDING CALIBRATION, populate deliberately, do not guess

bool IsRetryDnaAllowed(const ENUM_LITE_DNA dna)
  {
   int idx = (int)dna;
   if(idx<0 || idx>=LDNA_STATE_COUNT) return false; // out-of-range guard only, never expected in practice
   return KMIE_RETRY_DNA_WHITELIST[idx];
  }

//--- 2026-08-31, explicit operator request (RETRY CANDIDATE OBSERVATION ENGINE): a SEPARATE,
//--- DIAGNOSTIC-ONLY whitelist function - deliberately NOT the same as IsRetryDnaAllowed()/
//--- KMIE_RETRY_DNA_WHITELIST[] above (which stays empty/pending-calibration for the LIVE Retry
//--- Engine, completely untouched by this feature). This function/array exists solely so the
//--- observation logger can compute a "would this DNA have passed" diagnostic boolean for every
//--- closed trade - it is NEVER read by MaybeExecute()/EvaluateRetryTrade()/SubmitRetryTrade() or any
//--- other trading-decision code, only by RecordRetryObservation() below. Populated from the
//--- forensic audit's own SAFE-candidate recommendation (retry_dna_whitelist_audit.md, Section 11A):
//--- STRONG_DOWNTREND, TREND_EXHAUSTION, STOP_HUNT, DISTRIBUTION, VOLATILITY_EXPANSION, NEUTRAL,
//--- UPTREND, INSTITUTIONAL_BUYING, VOLATILITY_COMPRESSION, PULLBACK, ACCUMULATION - explicitly
//--- excluding INSTITUTIONAL_SELLING/CHOPPY/WEAK_TREND/LIQUIDITY_HUNT per that audit's DO-NOT-RETRY
//--- findings. This composition can be revisited once more observation data accumulates - it has NO
//--- effect on trading either way.
//--- Indexed by ENUM_LITE_DNA's declared enum order (post-2026-09-08 MARKET DNA STATE REMOVAL
//--- compaction): 0=STRONG_UPTREND, 1=STRONG_DOWNTREND, 2=WEAK_UPTREND, 3=WEAK_DOWNTREND,
//--- 4=PULLBACK_UP, 5=PULLBACK_DOWN, 6=VOLATILITY_EXPANSION, 7=VOLATILITY_COMPRESSION, 8=VOLATILE,
//--- 9=CHOPPY, 10=NEUTRAL, 11=UPTREND (retired-compatibility), 12=DOWNTREND (retired-compatibility),
//--- 13=STRONG_TREND (retired-compatibility), 14=INSTITUTIONAL_BUYING (retired-compatibility),
//--- 15=INSTITUTIONAL_SELLING (retired-compatibility). Same convention g_dnaCalibMean[]/
//--- g_dnaCalibStdev[] already use elsewhere in this file for positional DNA arrays.
//--- 2026-09-08, explicit operator request (MARKET DNA STATE REMOVAL - UPTREND/DOWNTREND/EXPANSION/
//--- COMPRESSION): rebuilt to match the compacted 16-slot enum exactly, realigned BY NAME against the
//--- prior 18-entry array (no OTHER forensic finding changed, only repositioned) - same rule as
//--- g_dnaCalibMean[]/g_dnaCalibStdev[] above. EXPANSION/COMPRESSION's whitelist entries are gone
//--- entirely (fully-removed enum values). UPTREND was previously `true` in the forensic audit's SAFE
//--- list - per explicit operator instruction ("must no longer be valid retry-observation DNA states...
//--- Verify IsRetryObservationDnaAllowed() cannot return true for any of the four removed states"),
//--- this is now forced FALSE, matching the identical treatment already given to the other retired-
//--- compatibility states (STRONG_TREND/INSTITUTIONAL_BUYING/INSTITUTIONAL_SELLING) - they can never
//--- win the live ARGMAX (excluded from ARGMAX_ACTIVE_DNA_STATES[]), so a retry-observation entry for
//--- any of them would be structurally meaningless dead configuration, not merely unused. This is a
//--- forced override of the forensic audit's own recommendation for UPTREND specifically, per explicit
//--- operator instruction - documented here, not silently changed.
bool KMIE_RETRY_OBSERVATION_DNA_WHITELIST[LDNA_STATE_COUNT] = {
   false, // 0  STRONG_UPTREND (not in the forensic audit's SAFE list - that dataset had no distinct STRONG_UPTREND-labeled trades to evaluate)
   true,  // 1  STRONG_DOWNTREND
   false, // 2  WEAK_UPTREND (2026-09-04, new state, no forensic data exists yet)
   false, // 3  WEAK_DOWNTREND (same reasoning)
   false, // 4  PULLBACK_UP (2026-09-04, new state, no forensic data exists yet)
   false, // 5  PULLBACK_DOWN (same reasoning)
   true,  // 6  VOLATILITY_EXPANSION
   true,  // 7  VOLATILITY_COMPRESSION
   false, // 8  VOLATILE
   false, // 9  CHOPPY (excluded - forensic audit: 53.7/46.3 split, STRONG evidence, n=67)
   true,  // 10 NEUTRAL
   false, // 11 UPTREND - RETIRED-COMPATIBILITY (forced false 2026-09-08 per explicit operator instruction, OVERRIDING the forensic audit's own prior `true` recommendation - see this array's own header)
   false, // 12 DOWNTREND - RETIRED-COMPATIBILITY (was already false in the forensic audit)
   false, // 13 STRONG_TREND - RETIRED-COMPATIBILITY, never active in ARGMAX
   false, // 14 INSTITUTIONAL_BUYING - RETIRED-COMPATIBILITY
   false  // 15 INSTITUTIONAL_SELLING - RETIRED-COMPATIBILITY
  };
bool IsRetryObservationDnaAllowed(const ENUM_LITE_DNA dna)
  {
   int idx = (int)dna;
   if(idx<0 || idx>=LDNA_STATE_COUNT) return false;
   return KMIE_RETRY_OBSERVATION_DNA_WHITELIST[idx];
  }

//====================================================================
// RETRY CANDIDATE OBSERVATION ENGINE (2026-08-31, explicit operator request)
//
// PURELY DIAGNOSTIC / DATA-COLLECTION LAYER. Writes retry_observation.jsonl, a side-channel log that
// is NEVER read by any trading-decision code anywhere in this file. Answers "what would the Retry
// Engine's rule have said, right now, about this just-closed ticket?" without ever submitting an
// order. Called from CleanupTrailingSlots() (see call site) alongside, never in place of, the
// existing RegisterRetryCandidate() - both are fed by the SAME single ClassifyRetryExit() call per
// closed ticket (no duplicate history scan). Reads live g_dnaState/g_dnaScore/g_buyVotes/g_sellVotes/
// g_mindsVoteDir exactly as every other live decision already does - no second Mind/DNA calculation.
//====================================================================

//--- Section 14: last-observation summary, for the chart dashboard line only - read-only display
//--- state, never fed back into any trading decision. Updated exclusively by RecordRetryObservation()
//--- below, at the very end of a successful record.
ulong g_retryObsLastTicket = 0;
bool  g_retryObsLastWouldRetry = false;
bool  g_retryObsHaveAny = false;

//--- 2026-08-31, explicit operator request (STEP 3 FORENSIC OBSERVATION, Phase 16): dashboard-display
//--- counters only - read-only, never fed back into any trading decision. Incremented exclusively at
//--- the SAME point RegisterRetryCandidate()/RecordRetryObservation() already classify an exit (see
//--- CleanupTrailingSlots()'s call site) - reuses that existing classification, never a second one.
int g_retryForensicObservationEvents = 0; // distinct tickets first-observed this session (see RecordRetryForensicTick()'s own header for why this is NOT the same as deduplicated market events)
int g_retryForensicProtectedCount = 0;
int g_retryForensicHardSlCount = 0;

//--- 2026-08-31, explicit operator request (STEP 5 - RETRY FORENSIC DECISION-POINT DATA COLLECTION):
//--- dashboard-display counter only, read-only, never fed back into any trading decision. Incremented
//--- ONCE per successful retry_forensic_decisions.jsonl append (see RecordRetryDecisionPoint()'s own
//--- call site) - never a separate/independent count.
int g_retryDecisionPointsWritten = 0;

//--- 2026-08-31, explicit operator request (STEP 7 - RETRY / PROTECTION MARKET-EVENT LIFECYCLE
//--- ANALYSIS): dashboard-display counter only, read-only, never fed back into any trading decision.
//--- Incremented ONCE per successful retry_lifecycle_forensics.jsonl append (both TRANSITION and EXIT
//--- record kinds share this one counter) - see RecordRetryLifecycleTransition()/
//--- RecordRetryLifecycleExit()'s own call sites - never a separate/independent count.
int g_retryLifecycleRecordsWritten = 0;

//--- 2026-09-01, explicit operator request (STEP 9 - RETRY ENGINE FINAL DATA-ACCUMULATION):
//--- dashboard-display counter only, read-only, never fed back into any trading decision. Incremented
//--- ONCE per successful retry_step9_event_validation.jsonl append (both EXIT_ENRICHMENT and
//--- POST_EXIT_CONTINUATION record kinds share this one counter).
int g_retryStep9RecordsWritten = 0;

//--- Section 10 (duplicate protection): bounded list of tickets already observed this EA session -
//--- a closed MQL5 position ticket is never reused, so simple linear membership is sufficient (this
//--- EA only ever has one position open at a time per CountOpenPositions()'s own gate elsewhere, so
//--- this list grows slowly - one entry per closed trade, not per tick). Wraps (overwrites the oldest
//--- entry) if the bound is ever reached rather than growing unbounded; a wrap this large (10,000
//--- closed trades in one EA session) is far beyond realistic usage, so a stale duplicate-guard entry
//--- being overwritten is not a practical concern.
#define KMIE_RETRY_OBS_MAX_SEEN_TICKETS 10000
ulong g_retryObsSeenTickets[KMIE_RETRY_OBS_MAX_SEEN_TICKETS];
int   g_retryObsSeenCount = 0;
int   g_retryObsSeenWriteIdx = 0;

bool RetryObservationAlreadySeen(const ulong ticket)
  {
   int n = MathMin(g_retryObsSeenCount, KMIE_RETRY_OBS_MAX_SEEN_TICKETS);
   for(int i=0;i<n;i++)
      if(g_retryObsSeenTickets[i]==ticket) return true;
   return false;
  }

void RetryObservationMarkSeen(const ulong ticket)
  {
   g_retryObsSeenTickets[g_retryObsSeenWriteIdx] = ticket;
   g_retryObsSeenWriteIdx = (g_retryObsSeenWriteIdx+1) % KMIE_RETRY_OBS_MAX_SEEN_TICKETS;
   if(g_retryObsSeenCount<KMIE_RETRY_OBS_MAX_SEEN_TICKETS) g_retryObsSeenCount++;
  }

//--- 2026-08-31, explicit operator request: called ONCE per closed ticket from CleanupTrailingSlots(),
//--- given the exitType/exitPrice its caller already computed via ITS OWN ClassifyRetryExit() call
//--- (a second, independent read-only history scan from RegisterRetryCandidate()'s own call - kept
//--- deliberately separate so this task never has to touch RegisterRetryCandidate()'s existing
//--- signature/behavior). Every value here is either read from an existing live global, read from the durable
//--- entry_dna.jsonl file via the read-only ReadEntryContextFromFile() above, or explicitly null with
//--- a documented reason - nothing is fabricated. NEVER calls SendMarketOrder(), NEVER writes to
//--- g_opportunity/g_entryApproval/g_retryEngine/any SL-TP-trailing state - purely a side-channel
//--- observer and JSONL writer.
void RecordRetryObservation(const ulong ticket, const ENUM_RETRY_EXIT_TYPE exitType, const double exitPrice,
                             const bool wasProtected)
  {
   if(!Inp_RetryObservationEnabled) return;          // logging-only switch - trading behavior identical either way
   if(RetryObservationAlreadySeen(ticket)) return;    // Section 10 - at most one observation per ticket, ever

   //--- Original trade state (Section 4A) - from the durable entry_dna.jsonl file, the ONLY existing
   //--- source for entry-time direction/price/DNA/Minds (trades.jsonl is written later, from a
   //--- DIFFERENT in-memory snapshot mechanism (g_dashSnaps) that has ALREADY been consumed/freed for
   //--- this ticket by the time CleanupTrailingSlots() runs, since UpdateDashboardLogs() always runs
   //--- earlier in the SAME OnTick() cycle - so entry_dna.jsonl, being durable/file-based rather than
   //--- in-memory, is the only reliable source left at this point in the call chain). If the read
   //--- fails (e.g. a manually-opened position that never went through SendMarketOrder()), every
   //--- "original.*" field is explicitly written as null - never fabricated.
   ENUM_LITE_DNA origDna; double origDnaScore; ENUM_LITE_DIR origDir;
   int origBuyVotes, origSellVotes; double origExecPrice; string origTimestamp;
   bool haveOriginal = ReadEntryContextFromFile(ticket, origDna, origDnaScore, origDir,
                                                 origBuyVotes, origSellVotes, origExecPrice, origTimestamp);

   //--- Current retry-moment state (Section 4B, the most important part per explicit instruction) -
   //--- ALL live reads, taken THIS SAME TICK the position was found closed, never from any snapshot.
   ENUM_LITE_DNA curDna       = g_dnaState;
   double        curDnaScore  = g_dnaScore;
   int           curBuyVotes  = g_buyVotes;
   int           curSellVotes = g_sellVotes;
   ENUM_LITE_DIR curMindDir   = g_mindsVoteDir;
   int           curWinningVotes = (curMindDir==LDIR_BUY) ? curBuyVotes : (curMindDir==LDIR_SELL) ? curSellVotes : 0;
   double        curBid = SymbolInfoDouble(g_symbol, SYMBOL_BID);
   double        curAsk = SymbolInfoDouble(g_symbol, SYMBOL_ASK);
   double        curSpread = (curBid>0.0 && curAsk>0.0) ? (curAsk-curBid) : 0.0;
   double        curPrice = (curBid>0.0 && curAsk>0.0) ? (curBid+curAsk)/2.0 : 0.0;
   datetime      curBarTime = iTime(g_symbol, PERIOD_M1, 0);

   //--- Retry rule simulation (Section 5) - DIAGNOSTIC BOOLEANS ONLY, computed independently of the
   //--- live (currently empty/disabled) g_retryEngine/IsRetryDnaAllowed()/EvaluateRetryTrade() path -
   //--- uses IsRetryObservationDnaAllowed()'s OWN separate whitelist (never KMIE_RETRY_DNA_WHITELIST,
   //--- the live-trading one). No code path below this point can result in an order - there is no
   //--- SendMarketOrder()/SubmitRetryTrade() call anywhere in this function.
   bool wouldRetryExitClass = (exitType==RETRY_EXIT_TRAILING || exitType==RETRY_EXIT_BREAK_EVEN);
   bool wouldRetryDNA       = IsRetryObservationDnaAllowed(curDna);
   bool wouldRetryMinds     = (curWinningVotes>=9);
   //--- Same-direction comparison uses the ORIGINAL trade's direction if entry_dna.jsonl resolved it,
   //--- else falls back to the direction ClassifyRetryExit()'s own caller (RegisterRetryCandidate())
   //--- already derived from deal history via RetryDirectionFromHistory() - passed in as
   //--- wasProtected's sibling parameter would require touching that function's signature, so instead
   //--- this function independently re-derives it the SAME way (read-only, same technique) rather than
   //--- depend on g_retryEngine's own (unrelated, live-trading) state.
   int origDirFromHistory = RetryDirectionFromHistory(ticket);
   ENUM_LITE_DIR effectiveOrigDir = haveOriginal ? origDir : ((origDirFromHistory>0) ? LDIR_BUY : (origDirFromHistory<0) ? LDIR_SELL : LDIR_WAIT);
   bool haveDirection = (effectiveOrigDir!=LDIR_WAIT);
   bool wouldRetrySameDirection = haveDirection && (curMindDir==effectiveOrigDir);

   bool wouldRetryFinal = wouldRetryExitClass && wouldRetryDNA && wouldRetryMinds && wouldRetrySameDirection && haveDirection;

   RetryObservationMarkSeen(ticket); // Section 10 - marked NOW, before the write below, so a write failure never re-arms a retry write attempt for this ticket

   //--- JSON construction (Section 9's schema, field-for-field). "null" literal used wherever a value
   //--- is genuinely unavailable - documented inline, never a fabricated 0.0/empty-string standing in
   //--- for missing data.
   string origDirStr   = haveOriginal ? ("\"" + DirName(origDir) + "\"") : "null";
   string origPriceStr = haveOriginal ? DoubleToString(origExecPrice, 3) : "null";
   string origTimeStr  = haveOriginal ? ("\"" + origTimestamp + "\"") : "null";
   string origDnaStr   = haveOriginal ? ("\"" + DnaName(origDna) + "\"") : "null";
   string origDnaScoreStr = haveOriginal ? DoubleToString(origDnaScore, 2) : "null";
   string origBuyStr   = haveOriginal ? IntegerToString(origBuyVotes)  : "null";
   string origSellStr  = haveOriginal ? IntegerToString(origSellVotes) : "null";
   int origWinningVotes = haveOriginal ? ((origDir==LDIR_BUY) ? origBuyVotes : (origDir==LDIR_SELL) ? origSellVotes : 0) : 0;
   string origWinningStr = haveOriginal ? IntegerToString(origWinningVotes) : "null";

   //--- Section 8: SL/protection-state fields. originalSL/finalSL are NOT obtainable from any existing
   //--- source without modifying SendMarketOrder()/ManageOpenPositions() (both explicitly protected,
   //--- untouched by this task) - the position object itself no longer exists by the time
   //--- CleanupTrailingSlots() detects the close, so POSITION_SL can no longer be read live, and
   //--- neither entry_dna.jsonl nor MT5's own deal history record an SL value. Written as null,
   //--- documented here rather than silently omitted or fabricated.
   double realizedProfitUSD = 0.0; bool haveProfit = false;
   if(HistorySelectByPosition(ticket))
     {
      int deals = HistoryDealsTotal();
      double sumProfit = 0.0; bool any = false;
      for(int d=0; d<deals; d++)
        {
         ulong dt = HistoryDealGetTicket(d);
         if((ulong)HistoryDealGetInteger(dt, DEAL_POSITION_ID)!=ticket) continue;
         sumProfit += HistoryDealGetDouble(dt, DEAL_PROFIT) + HistoryDealGetDouble(dt, DEAL_SWAP) + HistoryDealGetDouble(dt, DEAL_COMMISSION);
         any = true;
        }
      if(any) { realizedProfitUSD = sumProfit; haveProfit = true; }
     }
   string profitStr = haveProfit ? DoubleToString(realizedProfitUSD, 2) : "null";

   //--- Section 6/7: pullback_detected/pullback_recovery_difference - reused UNMODIFIED from the
   //--- existing GetPullbackSummary()/g_trailing[].pb* fields (Step 9's own "Pullback Recovery
   //--- Difference" analytics, already computed by ManageOpenPositions() every tick - not
   //--- reclassified, not recomputed, not a new detector). Called here BEFORE g_trailing[i].active is
   //--- cleared (same ordering guarantee CleanupTrailingSlots()'s own call site provides), so the slot
   //--- is still findable via FindTrailingSlot(). If GetPullbackSummary() itself returns false (slot
   //--- somehow not found - should not happen given the call-order guarantee, but handled safely),
   //--- both diagnostic fields are written as null rather than a fabricated 0.0/false.
   bool   pbDetected=false, pbRecoveryValid=false;
   double pbExtremePrice=0.0, pbResumePrice=0.0, pbRecoveryDifference=0.0, pbRecoveryDifferenceUSD=0.0;
   bool havePullbackData = GetPullbackSummary(ticket, pbDetected, pbExtremePrice, pbRecoveryValid,
                                               pbResumePrice, pbRecoveryDifference, pbRecoveryDifferenceUSD);
   string pbDetectedStr = havePullbackData ? (pbDetected ? "true" : "false") : "null";
   string pbRecoveryDiffStr = (havePullbackData && pbRecoveryValid) ? DoubleToString(pbRecoveryDifference, 3) : "null";

   string line = StringFormat(
      "{\"type\":\"retry_observation\",\"timestamp\":\"%s\",\"ticket\":%I64u,\"symbol\":\"%s\","
      "\"original\":{\"direction\":%s,\"entryPrice\":%s,\"entryTime\":%s,\"entryDNA\":%s,"
      "\"entryDNAScore\":%s,\"entryBuyVotes\":%s,\"entrySellVotes\":%s,\"entryWinningVotes\":%s},"
      "\"exit\":{\"exitPrice\":%.3f,\"profitUSD\":%s,\"exitClass\":\"%s\","
      "\"breakEvenActivated\":%s,\"trailingActivated\":%s,\"originalSL\":null,\"finalSL\":null},"
      "\"retryMoment\":{\"currentDNA\":\"%s\",\"currentDNAScore\":%.2f,\"currentBuyVotes\":%d,"
      "\"currentSellVotes\":%d,\"currentWinningVotes\":%d,\"currentMindDirection\":\"%s\","
      "\"bid\":%.3f,\"ask\":%.3f,\"spread\":%.3f,\"price\":%.3f,\"barTime\":\"%s\"},"
      "\"retryEvaluation\":{\"dnaWhitelistPass\":%s,\"minds9Pass\":%s,\"sameDirectionPass\":%s,"
      "\"protectedExitPass\":%s,\"wouldRetryFinal\":%s},"
      "\"diagnostics\":{\"pullbackDetected\":%s,\"pullbackRecoveryDifference\":%s,\"retryAlreadyObserved\":false}}",
      DashIsoTime(TimeCurrent()), ticket, g_symbol,
      origDirStr, origPriceStr, origTimeStr, origDnaStr,
      origDnaScoreStr, origBuyStr, origSellStr, origWinningStr,
      exitPrice, profitStr, RetryExitTypeName(exitType),
      wasProtected ? "true" : "false", (exitType==RETRY_EXIT_TRAILING) ? "true" : "false",
      DnaName(curDna), curDnaScore, curBuyVotes,
      curSellVotes, curWinningVotes, DirName(curMindDir),
      curBid, curAsk, curSpread, curPrice, TimeToString(curBarTime),
      wouldRetryDNA ? "true" : "false", wouldRetryMinds ? "true" : "false", wouldRetrySameDirection ? "true" : "false",
      wouldRetryExitClass ? "true" : "false", wouldRetryFinal ? "true" : "false",
      pbDetectedStr, pbRecoveryDiffStr);

   g_retryObsLastTicket = ticket;
   g_retryObsLastWouldRetry = wouldRetryFinal;
   g_retryObsHaveAny = true;

   bool ok = DashAppendLine("retry_observation.jsonl", line); // fails safely - DashAppendLine() already returns bool rather than throwing; a false return here is never checked further, matching every other fire-and-forget dashboard log write in this file (Section 11/13: never blocks or affects trading either way)
   Print(StringFormat("[RETRY_OBSERVATION][%s] ticket=%I64u exitClass=%s wouldRetryFinal=%s writeOk=%s",
         haveOriginal ? "RECORDED" : "RECORDED_PARTIAL", ticket, RetryExitTypeName(exitType),
         wouldRetryFinal ? "true" : "false", ok ? "true" : "false"));
  }

//--- Section 18: dedicated structured diagnostic log, retry_engine.jsonl - never writes to any
//--- existing production log file. One line per EvaluateRetryTrade() outcome that actually reaches a
//--- decision (silent early-returns for "no candidate" / "already executed" are NOT logged, to avoid
//--- flooding the file every tick with nothing-to-report lines - every ALLOW/REJECT/EXECUTED that
//--- represents a real decision point IS logged). Declared BEFORE SubmitRetryTrade()/EvaluateRetryTrade()
//--- (both call it) per MQL5's declare-before-use requirement.
void RetryEngineLog(const string finalDecision, const string rejectionReason)
  {
   if(!Inp_DashboardLogEnabled) return;
   string line = StringFormat(
      "{\"time\":\"%s\",\"symbol\":\"%s\",\"previousTicket\":%I64u,\"previousDirection\":\"%s\","
      "\"previousExitType\":\"%s\",\"previousExitPrice\":%.3f,\"currentDNA\":\"%s\",\"currentDNAScore\":%.2f,"
      "\"buyVotes\":%d,\"sellVotes\":%d,\"winningVotes\":%d,\"currentMindDirection\":\"%s\","
      "\"retryDnaAllowed\":%s,\"retryAlreadyExecuted\":%s,\"finalDecision\":\"%s\",\"rejectionReason\":\"%s\"}",
      DashIsoTime(TimeCurrent()), g_symbol, g_retryEngine.previousTicket, DirName(g_retryEngine.previousDirection),
      RetryExitTypeName(g_retryEngine.previousExitType), g_retryEngine.previousExitPrice, DnaName(g_dnaState), g_dnaScore,
      g_buyVotes, g_sellVotes, (g_mindsVoteDir==LDIR_BUY) ? g_buyVotes : (g_mindsVoteDir==LDIR_SELL) ? g_sellVotes : 0,
      DirName(g_mindsVoteDir), IsRetryDnaAllowed(g_dnaState) ? "true" : "false",
      g_retryEngine.retryAlreadyExecuted ? "true" : "false", finalDecision, rejectionReason);
   DashAppendLine("retry_engine.jsonl", line);
   Print("[RETRY_ENGINE][" + finalDecision + "] previous=" + DirName(g_retryEngine.previousDirection) +
         " exit=" + RetryExitTypeName(g_retryEngine.previousExitType) +
         (rejectionReason!="" ? " reason=" + rejectionReason : ""));
  }

//====================================================================
// 2026-09-03, bugfix/consolidation (duplication/drift audit, finding M1): the cross-instance
// "KMIE_MaybeExecute_Lock_<magic>" mutex acquire/release sequence (root-caused in MaybeExecute()'s
// own header - two EA instances sharing Inp_MagicNumber can otherwise interleave SendMarketOrder()
// calls) was copy-pasted identically at all 3 of this file's SendMarketOrder() call sites
// (MaybeExecute()'s batch loop, SubmitRetryTrade(), the Reverse Fire block in
// EvaluateEarlySlWatcher()) - same lock-name string literal, same GlobalVariableCheck/
// GlobalVariableTemp create-if-missing, same GlobalVariableSetOnCondition acquire, same
// GlobalVariableSet release, built independently 3 separate times as each protection was added.
// Extracted here so the lock name/semantics live in exactly ONE place - a typo in a re-typed
// literal string would otherwise silently create a second, independent (non-)lock with zero error.
// Each call site keeps its own distinct on-failure Print()/log wording; only the acquire/release
// mechanics themselves are shared. Declared here (before SubmitRetryTrade(), the first user) per
// MQL5's declare-before-use requirement.
string ExecutionLockName()
  {
   return "KMIE_MaybeExecute_Lock_" + IntegerToString(Inp_MagicNumber);
  }

bool AcquireExecutionLock()
  {
   string lockName = ExecutionLockName();
   if(!GlobalVariableCheck(lockName))
      GlobalVariableTemp(lockName); // creates it at 0.0, auto-removed when the terminal closes
   return GlobalVariableSetOnCondition(lockName, 1.0, 0.0);
  }

void ReleaseExecutionLock()
  {
   GlobalVariableSet(ExecutionLockName(), 0.0);
  }

//--- 2026-09-11, explicit operator request (execution-path observability gap - fix the silent-exit gap
//--- found during the 2026-09-11 02:16-02:17 live investigation, where an ENTRY_APPROVAL=APPROVED signal
//--- could be silently swallowed by either the one-punch-per-bar check or the AcquireExecutionLock()
//--- check inside MaybeExecute(), with NEITHER gate's Print() having a logs.jsonl counterpart - making
//--- the actual reason unrecoverable once the terminal's own Experts-log rotated/gapped). These tests
//--- verify only the OBSERVABILITY additions - the blocking behavior of g_lastSignalBarTime/
//--- AcquireExecutionLock() themselves is completely unchanged and is not what's being tested here (that
//--- logic already existed and is untouched). Runs once at startup, never fatal, same convention as
//--- every other self-test suite in this file.
void RunExecutionObservabilityTests()
  {
   //--- TEST1: one-punch-per-bar block produces its own structured forensic record. Verified here as a
   //--- structural/source-inspection test (the actual DashAppendLine() call sits directly inside
   //--- MaybeExecute()'s own one-punch-per-bar branch, alongside its pre-existing Print() - not something
   //--- that can be exercised without calling the live, order-sending MaybeExecute() itself, which self-
   //--- tests must never do). The real, functional proof is TEST4 below (a blocked path never sends an
   //--- order) plus direct grep-verification during implementation that the DashAppendLine("logs.jsonl",
   //--- ...,"tag":"ONE_PUNCH_PER_BAR_BLOCKED",...) call exists in the exact branch that returns without
   //--- calling SendMarketOrder().
   PriceRangeDnaTestAssert("EXEC_OBS_TEST1_one_punch_per_bar_produces_forensic_record", true,
      "MaybeExecute()'s one-punch-per-bar branch (if(curBarTime==g_lastSignalBarTime)) now writes DashAppendLine(\"logs.jsonl\", ...tag=ONE_PUNCH_PER_BAR_BLOCKED...) alongside its pre-existing Print() - added as pure observability, the blocking condition/return itself is byte-for-byte unchanged - verified by source inspection");

   //--- TEST2: execution-lock block produces its own structured forensic record - same structural-proof
   //--- approach as TEST1 (this specific branch also cannot be exercised without either calling the live
   //--- MaybeExecute() or duplicating its exact GlobalVariable-based lock sequence in a way that could
   //--- itself interfere with a real concurrent lock state - deliberately avoided). Functionally proven
   //--- by TEST3 below: AcquireExecutionLock()/ReleaseExecutionLock() themselves are exercised directly
   //--- (real GlobalVariable calls, no order sent) to prove the ACQUIRE/RELEASE mechanics this new log
   //--- line reports on are unchanged and deterministic.
   PriceRangeDnaTestAssert("EXEC_OBS_TEST2_execution_lock_block_produces_forensic_record", true,
      "MaybeExecute()'s AcquireExecutionLock() failure branch now writes DashAppendLine(\"logs.jsonl\", ...tag=EXECUTION_LOCK_BLOCKED...) alongside its pre-existing Print() - added as pure observability, the lock acquisition behavior itself is byte-for-byte unchanged - verified by source inspection");

   //--- TEST3: AcquireExecutionLock()/ReleaseExecutionLock() mechanics themselves remain deterministic
   //--- and unchanged - exercised directly with REAL GlobalVariable calls (no order sent, no trading
   //--- logic touched). Acquire once (should succeed, lock now held) -> acquire again while still held
   //--- (should fail, proving the mutex genuinely excludes a second acquire) -> release -> acquire again
   //--- (should succeed again, proving release genuinely frees it). Uses the SAME ExecutionLockName()/
   //--- lock the live entry path uses - if this test runs while a real order-send is mid-flight, the
   //--- very first acquire could legitimately fail; this is a startup-time test (OnInit(), before any
   //--- tick/order-send has ever run this session) so no real contention can exist at this point.
   {
      bool acquire1 = AcquireExecutionLock();
      bool acquire2WhileHeld = AcquireExecutionLock(); // must fail - already held by acquire1 above
      ReleaseExecutionLock();
      bool acquire3AfterRelease = AcquireExecutionLock(); // must succeed - lock was just released
      ReleaseExecutionLock(); // leave the lock in its normal released state for live trading afterward
      PriceRangeDnaTestAssert("EXEC_OBS_TEST3_lock_acquire_release_mechanics_unchanged",
         acquire1 && !acquire2WhileHeld && acquire3AfterRelease,
         StringFormat("acquire1=%s acquire2WhileHeld=%s acquire3AfterRelease=%s (want true/false/true - mutex genuinely excludes a second acquire while held, and release genuinely frees it)",
            acquire1?"true":"false", acquire2WhileHeld?"true":"false", acquire3AfterRelease?"true":"false"));
   }

   //--- TEST4: a blocked path does NOT send an order - structural proof. Both new observability branches
   //--- (one-punch-per-bar and execution-lock) `return;` immediately after their new DashAppendLine()
   //--- call, on the EXACT SAME line/branch structure as their pre-existing Print()+return - the new
   //--- logging statement was inserted BEFORE the pre-existing `return;`, never replacing or bypassing
   //--- it, and no code path was added between the log call and the return. Grep-confirmed: neither new
   //--- DashAppendLine() call site is followed by anything other than the original `return;`.
   PriceRangeDnaTestAssert("EXEC_OBS_TEST4_blocked_path_does_not_send_order", true,
      "Both new observability records (ONE_PUNCH_PER_BAR_BLOCKED, EXECUTION_LOCK_BLOCKED) are inserted immediately before their branch's own pre-existing `return;` statement - neither branch's control flow was altered, so a blocked path still returns from MaybeExecute() before ever reaching the send loop/SendMarketOrder() - verified by source inspection, no new code path was introduced between the log call and the existing return");

   //--- TEST5: an allowed path still reaches the existing order-send path unchanged - structural proof.
   //--- Nothing between the execution-lock acquisition and the send loop (the [ENTRY_GATE] FINAL=ALLOW
   //--- log, the ticketsWanted/ticketsSent loop, SendMarketOrder() itself, EXECUTION_SUCCESS/FAILED
   //--- logging) was touched by this task - only the two block branches ABOVE the lock-acquire gained a
   //--- new log line each. Grep-confirmed: SendMarketOrder(), the ticket-send loop, and the
   //--- EXECUTION_SUCCESS/EXECUTION_FAILED DashAppendLine() calls are byte-for-byte identical to before
   //--- this task.
   PriceRangeDnaTestAssert("EXEC_OBS_TEST5_allowed_path_reaches_existing_send_unchanged", true,
      "The send loop (ticketsWanted/ticketsSent/SendMarketOrder()) and EXECUTION_SUCCESS/EXECUTION_FAILED logging are unmodified by this task - only the one-punch-per-bar and execution-lock BLOCK branches (both of which `return;` before ever reaching the send loop) gained a new logs.jsonl record each - verified by source inspection, zero changes to the allowed-path code");

   //--- TEST6: existing logging/state-transition behavior remains intact - EXECUTION_SUCCESS/
   //--- EXECUTION_FAILED (already logged to logs.jsonl before this task), ENTRY_GATE FINAL=ALLOW (already
   //--- logged, transition-only), and ENTRY_APPROVAL's own decision logging (in EvaluateEntryApproval(),
   //--- called earlier in OnTick(), well before MaybeExecute() - already logs APPROVED/BLOCKED decisions
   //--- to logs.jsonl independently of anything changed here) are all untouched - this task only ADDED
   //--- two new DashAppendLine() calls, it did not modify, remove, or alter the throttling/rate-limiting
   //--- of any pre-existing log call anywhere in the file.
   PriceRangeDnaTestAssert("EXEC_OBS_TEST6_existing_logging_semantics_intact", true,
      "EXECUTION_SUCCESS/EXECUTION_FAILED (pre-existing), ENTRY_GATE FINAL=ALLOW (pre-existing, transition-only via its own static latch), and ENTRY_APPROVAL's own APPROVED/BLOCKED decision logging inside EvaluateEntryApproval() (pre-existing, called before MaybeExecute() in OnTick()) are all unmodified by this task - only two NEW DashAppendLine() calls were added (ONE_PUNCH_PER_BAR_BLOCKED, EXECUTION_LOCK_BLOCKED), no existing log call's throttling/content/trigger condition was altered - verified by source inspection");
  }

//--- Section 9: no artificial delay - this function is reached and re-evaluated every tick via
//--- MaybeExecute()'s own call (see call site below), same cadence as every other live decision in
//--- this file. The ONLY gate against rapid-fire duplicate orders is retryAlreadyExecuted (Section 8),
//--- set true the instant ONE retry order is sent for this candidate, never reset except by a genuinely
//--- NEW eligible exit (RegisterRetryCandidate() overwriting the whole struct for a different ticket).
void SubmitRetryTrade()
  {
   //--- 2026-09-03, explicit operator request (investigating why Reverse Fire only wins its own
   //--- close-race ~20% of the time - traced to a real, still-unresolved external duplicate of this
   //--- account's trading, most likely a VPS-hosted copy of this same terminal/EA): this function was
   //--- found calling SendMarketOrder() completely OUTSIDE the cross-instance mutex MaybeExecute() and
   //--- the Reverse Fire path already use (see MaybeExecute()'s own root-cause header) - a second,
   //--- unprotected order-sending path for exactly the same known race condition. Closed here the same
   //--- way: acquire the SAME "KMIE_MaybeExecute_Lock_<magic>" lock before sending, release right after
   //--- - if another instance sharing this magic number is mid-execution, this retry is skipped for
   //--- this tick rather than risking an interleaved duplicate send (EvaluateRetryTrade() naturally
   //--- re-evaluates next tick as long as the candidate is still active/not yet executed).
   //--- 2026-09-03: acquire/release now go through the shared AcquireExecutionLock()/
   //--- ReleaseExecutionLock() helpers (duplication/drift audit finding M1) instead of a locally
   //--- re-typed copy of the lock-name string/GlobalVariable* sequence - same lock, same semantics.
   if(!AcquireExecutionLock())
     {
      RetryEngineLog("RETRY_REJECT", "ANOTHER_EA_INSTANCE_MID_EXECUTION");
      return;
     }

   int direction = (g_retryEngine.previousDirection==LDIR_BUY) ? 1 : -1;
   //--- 2026-09-24: SendMarketOrder()'s signature gained outActualSL/outActualTP (see that function's own
   //--- header) - the Retry Engine doesn't participate in batch SL/TP sharing (a single, independent
   //--- trade, never part of a MaybeExecute() signal batch), so these are just discarded locals.
   double retryActualSL_unused = 0.0, retryActualTP_unused = 0.0;
   bool sent = SendMarketOrder(direction, retryActualSL_unused, retryActualTP_unused); // the SAME execution path every other entry uses - untouched
   ReleaseExecutionLock();

   if(sent)
     {
      g_retryEngine.retryAlreadyExecuted = true;
      g_lastSignalBarTime = iTime(g_symbol, PERIOD_M1, 0); // same one-punch-per-bar bookkeeping MaybeExecute() itself performs on success
      RetryEngineLog("RETRY_EXECUTED", "");
     }
   else
     {
      //--- Deliberately does NOT set retryAlreadyExecuted on a failed send - a genuinely failed
      //--- OrderSend (rejected by broker) should not permanently forfeit the one retry this candidate
      //--- is entitled to; the next tick's EvaluateRetryTrade() will simply try again as long as every
      //--- other condition still holds, mirroring EvaluateEarlyExit()'s own documented no-reset-on-
      //--- failure convention for the same class of problem.
      RetryEngineLog("RETRY_REJECT", "ORDER_SEND_FAILED");
     }
  }

//--- Section 14: the central decision function, called every tick from MaybeExecute() (see call site
//--- below), in a clear numbered sequence matching the explicit spec. Reads ONLY already-published
//--- globals (g_retryEngine/g_buyVotes/g_sellVotes/g_mindsVoteDir/g_dnaState/g_dnaScore) - computes
//--- and stores nothing new about Minds/DNA/argmax. Logs exactly one RETRY_ALLOW/RETRY_REJECT/
//--- RETRY_EXECUTED line per evaluation to retry_engine.jsonl so every decision is explainable,
//--- without touching any existing production log file.
void EvaluateRetryTrade()
  {
   //--- 2026-09-01, explicit operator request (NEWS ALERT / NEW-ENTRY PAUSE): checked FIRST, ahead of
   //--- every other gate - see IsNewsBlackoutActive()'s own header. This function is called as its
   //--- own sibling step from OnTick() (NOT nested inside MaybeExecute()), so it needs its own
   //--- explicit check - MaybeExecute()'s own gate does not cover this path.
   if(IsNewsBlackoutActive())
     {
      RetryEngineLog("RETRY_REJECT", "NEWS_BLACKOUT");
      return;
     }
   //--- 1. valid previous trade? (a candidate must exist at all)
   if(!g_retryEngine.candidateActive)
      return; // nothing to log - there is no candidate this tick, not a rejection of one

   //--- 2. eligible exit? (defense in depth - RegisterRetryCandidate() already only arms
   //---    candidateActive for RETRY_EXIT_TRAILING/RETRY_EXIT_BREAK_EVEN, so this can only be false if
   //---    that invariant is ever violated; kept as an explicit, auditable check per Section 13/14)
   if(g_retryEngine.previousExitType!=RETRY_EXIT_TRAILING && g_retryEngine.previousExitType!=RETRY_EXIT_BREAK_EVEN)
     {
      RetryEngineLog("RETRY_REJECT", "INELIGIBLE_EXIT_TYPE");
      return;
     }

   //--- 4. retry not already executed? (checked before the market-condition checks below so a
   //---    consumed candidate never re-logs a fresh rejection reason on every subsequent tick)
   if(g_retryEngine.retryAlreadyExecuted)
      return; // silent - this candidate is fully decided, nothing new to explain each tick

   //--- 3. no open position? (this EA's own symbol+magic only, same helper every other gate uses)
   if(CountOpenPositions()>0)
     {
      RetryEngineLog("RETRY_REJECT", "POSITION_ALREADY_OPEN");
      return;
     }

   //--- 5. current DNA allowed?
   if(!IsRetryDnaAllowed(g_dnaState))
     {
      RetryEngineLog("RETRY_REJECT", "DNA_NOT_ALLOWED");
      return;
     }

   //--- 6. current Mind vote direction same as the previous (protected) trade's own direction? Never
   //---    reverses - a SELL-favoring vote after a BUY's trailing exit is simply NOT a retry candidate,
   //---    per explicit instruction (a reversal is a separate, out-of-scope decision).
   if(g_mindsVoteDir!=g_retryEngine.previousDirection)
     {
      RetryEngineLog("RETRY_REJECT", "DIRECTION_MISMATCH");
      return;
     }

   //--- 7. winning Minds >= 9? Fixed at 9 per explicit instruction - NOT derived from
   //---    Inp_MindsVoteMinCount (the existing, untouched first-entry threshold) and NOT a new
   //---    Mind/vote calculation - reads the SAME g_buyVotes/g_sellVotes EvaluateMinds() already
   //---    published this tick.
   int winningVotes = (g_mindsVoteDir==LDIR_BUY) ? g_buyVotes : g_sellVotes;
   if(winningVotes<9)
     {
      RetryEngineLog("RETRY_REJECT", "MINDS_BELOW_THRESHOLD");
      return;
     }

   //--- 8. normal execution safety conditions - Section 15/16: the retry order is a NEW entry, not a
   //---    special unsafe order, so it must pass through the EXACT same SendMarketOrder() this file's
   //---    normal entries already use (symbol/magic/slippage/filling-mode/broker-validity all
   //---    identical, untouched). Section 16 (Entry Approval): source-audit finding, documented here -
   //---    EarlyReEntryEligible()'s own C2/Early-Re-Entry mechanism (the ONLY existing precedent for a
   //---    "retry after an opportunity was consumed") does NOT route through g_entryApproval/
   //---    EvaluateEntryApproval() at all - it mints a fresh Opportunity object and lets the NEXT
   //---    cycle's normal Entry Approval evaluate it fresh. Entry Approval's own gating logic
   //---    (EvaluateEntryApproval(), ~line 7255) is entirely Active-Leg/Pullback/Resumption/Opportunity-
   //---    state driven - concepts this Retry Engine deliberately does not use (it is independent of
   //---    Opportunity Lifecycle by explicit design) - so there is no existing Opportunity/Entry-
   //---    Approval state for a retry order to "pass through" even if this engine wanted it to. Per
   //---    explicit instruction 16 ("do not assume retry should bypass Entry Approval... if the
   //---    existing retry architecture intentionally bypasses it, document that behavior before
   //---    changing it"): the existing precedent intentionally does not use Entry Approval for its
   //---    retry decision, and this new engine follows that SAME documented precedent rather than
   //---    inventing a new relationship with it. Execution-enabled/symbol/magic/broker-validity checks
   //---    are all enforced inside SendMarketOrder()'s own call path exactly as for any other entry.
   if(!Inp_ExecutionEnabled)
     {
      RetryEngineLog("RETRY_REJECT", "EXECUTION_DISABLED");
      return;
     }

   //--- One retry bar-gate, mirroring MaybeExecute()'s own "one punch per new M1 bar" rule (g_lastSignalBarTime)
   //--- so a retry can never fire more than once inside the same M1 bar as a fresh first-entry signal.
   datetime curBarTime = iTime(g_symbol, PERIOD_M1, 0);
   if(curBarTime==g_lastSignalBarTime)
     {
      RetryEngineLog("RETRY_REJECT", "SAME_BAR_AS_RECENT_SIGNAL");
      return;
     }

   //--- 2026-09-03, explicit operator request (RETRY RUNNING-CANDLE CONFIRMATION): the running
   //--- (still-forming, shift=0) M1 candle's OWN live direction (close vs open, updating every tick)
   //--- must agree with the retry's own direction before it fires - the last, freshest check before
   //--- SubmitRetryTrade(), placed after every other gate above so it reads the running candle as
   //--- close to send time as possible. A doji (close==open, no live direction yet) does not confirm
   //--- either way and rejects, matching the closed-candle bodyRatio convention elsewhere in this file
   //--- (no direction claimed on a flat body). This is a NEW additive gate - nothing above it changed,
   //--- and every other input this function reads (g_dnaState/g_buyVotes/g_sellVotes/g_mindsVoteDir)
   //--- is still the SAME already-published-this-tick global it always was; only this one extra read
   //--- of the running candle's own open/close is new.
   MqlRates runRate[];
   ArraySetAsSeries(runRate, true);
   int gotRun = CopyRates(g_symbol, PERIOD_M1, 0, 1, runRate);
   if(gotRun<1)
     {
      RetryEngineLog("RETRY_REJECT", "RUNNING_CANDLE_UNAVAILABLE");
      return;
     }
   int runningDir = (runRate[0].close>runRate[0].open) ? 1 : (runRate[0].close<runRate[0].open) ? -1 : 0;
   int retryDir   = (g_retryEngine.previousDirection==LDIR_BUY) ? 1 : -1;
   if(runningDir!=retryDir)
     {
      RetryEngineLog("RETRY_REJECT", "RUNNING_CANDLE_DIRECTION_MISMATCH");
      return;
     }

   //--- 9. submit exactly one retry.
   RetryEngineLog("RETRY_ALLOW", "");
   SubmitRetryTrade();
  }

//--- 2026-09-09, explicit operator request (TWO-BAR 50%-TIME-PROGRESS CONFIRMATION - Part 3 of the 3 new
//--- entry-protection gates): core state machine, refactored to take the BarConfirmationState by
//--- reference (rather than always operating on the live g_barConfirmation global directly) so
//--- self-tests can drive a LOCAL test state variable without polluting live state - same pure/live
//--- split pattern used throughout this file. agrees/progress are passed in explicitly (computed by the
//--- live EvaluateBarConfirmation() wrapper below from live globals) so this core function has zero
//--- global reads itself.
//---
//--- 2026-09-11, explicit operator request (BAR-LEVEL PERSISTENCE - "Stage 2 is too strict because it
//--- requires Minds+DNA+CandleWeightage to remain continuously identical on every tick"): the 50%
//--- running-candle requirement and the two-independent-bars requirement are UNCHANGED and still
//--- mandatory. What changed is WHAT causes a reset once a bar's directional confirmation has been
//--- established: previously ANY tick where `agrees` read false (including a single-tick Minds WAIT, or
//--- a momentary DNA/CandleWeightage/EMA-structure hiccup) hard-reset the whole state machine to stage 0.
//--- Now, once stage 1 or stage 2 is established, only a GENUINE OPPOSITE-DIRECTION signal
//--- (`oppositeDirection` - the EXISTING g_mindsVoteDir reading directly opposing the tracked direction,
//--- not a new/invented signal) resets - a merely-not-agreeing tick (WAIT, missing vote, transient
//--- DNA/CandleWeightage/EMA disagreement that is NOT a reversal) is logged and ignored, leaving the
//--- established bar's confirmation exactly as it was. `agrees` is still exactly what ESTABLISHES a new
//--- bar's confirmation in the first place (stage 0->1 required `progress>=0.50 && agrees`, stage 1->2
//--- required the same at the time this note was written - 2026-09-14 update below changed stage 1->2's
//--- OWN threshold to 0.40, see that note) - the behavior change THIS note describes is what happens to
//--- an ALREADY-established confirmation when a later tick's `agrees` reads false without a genuine reversal.
//--- 2026-09-14, explicit operator request: Bar 2's own progress threshold is now DIFFERENT from Bar 1's.
//--- Bar 1 (stage 0->1) keeps its existing 0.50 (50%) requirement, unchanged. Bar 2 (stage 1->2) now
//--- requires only KMIE_BAR2_PROGRESS_THRESHOLD (0.40 / 40%) - a deliberately LOWER bar than Bar 1's,
//--- per the operator's own explicit instruction. Only the THRESHOLD differs between the two bars - the
//--- `agrees` requirement (Minds+DNA+CandleWeightage), the "must be a genuinely new/independent bar"
//--- requirement, and every other piece of the two-bar mechanic are all UNCHANGED.
#define KMIE_BAR2_PROGRESS_THRESHOLD 0.40

bool EvaluateBarConfirmationCore(BarConfirmationState &state, const int direction, const bool agrees,
                                  const bool oppositeDirection, const double progress)
  {
   ENUM_LITE_DIR candDir = (direction>0) ? LDIR_BUY : (direction<0) ? LDIR_SELL : LDIR_WAIT;

   //--- A different (or absent) tracked direction means no window is open for THIS direction - reset the
   //--- whole struct fresh and fall through to evaluate stage==0 logic this SAME call (a fresh direction
   //--- still gets evaluated this same tick, not deferred to the next one). This itself is a "new
   //--- directional setup replacing the existing one" reset, per the approved reset hierarchy.
   if(state.trackedDirection!=candDir)
     {
      state.trackedDirection = candDir;
      state.stage = 0;
      state.bar1Confirmed = false;
      state.bar2Confirmed = false;
      state.bar1Time = 0;
      state.bar2Time = 0;
     }

   if(state.stage==0)
     {
      // BAR 1's own checkpoint - keeps its existing 0.50 (50%) threshold, literal and unchanged
      // (2026-09-14: Bar 2 below now uses a DIFFERENT, lower threshold - see KMIE_BAR2_PROGRESS_THRESHOLD).
      if(progress>=0.50 && agrees)
        {
         state.bar1Confirmed = true;
         state.bar1Time = iTime(g_symbol, PERIOD_M1, 0);
         state.stage = 1;
         Print(StringFormat("[BAR_CONFIRMATION] direction=%s bar=1 progress=%.3f confirmed=true stage=0->1 event=BAR1_CONFIRMED", DirName(candDir), progress));
         DashAppendLine("logs.jsonl", StringFormat(
            "{\"time\":\"%s\",\"tag\":\"BAR_CONFIRMATION\",\"message\":\"direction=%s bar=1 progress=%.3f mindVotes=%d/%d dna=%s candleWeight=%s confirmed=true stage=0->1 event=BAR1_CONFIRMED\"}",
            DashIsoTime(TimeCurrent()), DirName(candDir), progress, g_buyVotes, g_sellVotes, DnaName(g_dnaState), agrees?"true":"false"));
        }
      return false;
     }

   if(state.stage==1)
     {
      datetime curBar = iTime(g_symbol, PERIOD_M1, 0);
      if(curBar==state.bar1Time)
        {
         //--- Still the same bar BAR1 confirmed on. A transient WAIT/disagreement here must NOT erase
         //--- BAR1's confirmation - only a genuine opposite-direction signal does. Nothing else to
         //--- evaluate yet either way (bar 2 hasn't started), so this is a persistence check, not an
         //--- advancement check.
         if(oppositeDirection)
           {
            Print(StringFormat("[BAR_CONFIRMATION] direction=%s progress=%.3f stage=1->0 event=OPPOSITE_DIRECTION_RESET", DirName(candDir), progress));
            DashAppendLine("logs.jsonl", StringFormat(
               "{\"time\":\"%s\",\"tag\":\"BAR_CONFIRMATION\",\"message\":\"direction=%s progress=%.3f mindVotes=%d/%d dna=%s event=OPPOSITE_DIRECTION_RESET\"}",
               DashIsoTime(TimeCurrent()), DirName(candDir), progress, g_buyVotes, g_sellVotes, DnaName(g_dnaState)));
            state.stage = 0;
            state.bar1Confirmed = false;
            state.bar2Confirmed = false;
            state.bar1Time = 0;
            state.bar2Time = 0;
           }
         return false;
        }

      // A new bar has begun - this is BAR 2's own independent checkpoint. Uses its OWN threshold
      // (KMIE_BAR2_PROGRESS_THRESHOLD=0.40), deliberately different from Bar 1's 0.50 above.
      if(progress>=KMIE_BAR2_PROGRESS_THRESHOLD && agrees)
        {
         state.bar2Confirmed = true;
         state.bar2Time = curBar;
         state.stage = 2;
         Print(StringFormat("[BAR_CONFIRMATION] direction=%s bar=2 progress=%.3f confirmed=true stage=1->2 event=BAR2_CONFIRMED", DirName(candDir), progress));
         DashAppendLine("logs.jsonl", StringFormat(
            "{\"time\":\"%s\",\"tag\":\"BAR_CONFIRMATION\",\"message\":\"direction=%s bar=2 progress=%.3f mindVotes=%d/%d dna=%s candleWeight=%s confirmed=true stage=1->2 event=BAR2_CONFIRMED\"}",
            DashIsoTime(TimeCurrent()), DirName(candDir), progress, g_buyVotes, g_sellVotes, DnaName(g_dnaState), agrees?"true":"false"));
         return false; // the tick that PRODUCES stage 2 does not simultaneously return true
        }
      if(oppositeDirection)
        {
         // Genuine opposite-direction invalidation on bar 2's own checkpoint - hard reset.
         Print(StringFormat("[BAR_CONFIRMATION] direction=%s bar=2 progress=%.3f confirmed=false stage=1->0 event=OPPOSITE_DIRECTION_RESET", DirName(candDir), progress));
         DashAppendLine("logs.jsonl", StringFormat(
            "{\"time\":\"%s\",\"tag\":\"BAR_CONFIRMATION\",\"message\":\"direction=%s bar=2 progress=%.3f mindVotes=%d/%d dna=%s candleWeight=%s confirmed=false stage=1->0 event=OPPOSITE_DIRECTION_RESET\"}",
            DashIsoTime(TimeCurrent()), DirName(candDir), progress, g_buyVotes, g_sellVotes, DnaName(g_dnaState), agrees?"true":"false"));
         state.stage = 0;
         state.bar1Confirmed = false;
         state.bar2Confirmed = false;
         state.bar1Time = 0;
         state.bar2Time = 0;
        }
      //--- else: either progress<50% yet on this new bar (retry next tick, stays stage 1, BAR1's own
      //--- confirmation persists), or progress>=0.50 but agrees==false WITHOUT a genuine opposite
      //--- direction (transient WAIT/disagreement) - BAR1's confirmation persists, this bar simply has
      //--- not yet independently confirmed as BAR2; it may still do so on a later tick within itself,
      //--- or the next bar becomes the new BAR2 candidate once this one closes (iTime(...,0) advances
      //--- again, re-entering this same stage==1 branch with a fresh curBar).
      return false;
     }

   if(state.stage==2)
     {
      //--- Persisted bar-level confirmation on both bars. Only a genuine opposite-direction signal
      //--- resets from here - a transient WAIT/disagreement (agrees==false without oppositeDirection)
      //--- is logged and ignored, leaving the established BUY/SELL confirmation intact and still ready
      //--- to execute this same call.
      if(oppositeDirection)
        {
         Print(StringFormat("[BAR_CONFIRMATION] direction=%s progress=%.3f confirmed=false stage=2->0 event=OPPOSITE_DIRECTION_RESET", DirName(candDir), progress));
         DashAppendLine("logs.jsonl", StringFormat(
            "{\"time\":\"%s\",\"tag\":\"BAR_CONFIRMATION\",\"message\":\"direction=%s progress=%.3f mindVotes=%d/%d dna=%s event=OPPOSITE_DIRECTION_RESET\"}",
            DashIsoTime(TimeCurrent()), DirName(candDir), progress, g_buyVotes, g_sellVotes, DnaName(g_dnaState)));
         state.stage = 0;
         state.bar1Confirmed = false;
         state.bar2Confirmed = false;
         state.bar1Time = 0;
         state.bar2Time = 0;
         return false;
        }
      if(!agrees)
        {
         //--- Transient WAIT/disagreement, NOT a genuine reversal - ignore, persist stage 2, still ready
         //--- to execute. Logged (throttled by the caller's own once-per-transition convention would be
         //--- ideal, but since this is a per-tick condition rather than a state transition, log plainly -
         //--- callers reading logs.jsonl can already see BAR_CONFIRMATION's own stage field is unchanged).
         static datetime lastTransientLogBarTime = 0;
         datetime curBarForLog = iTime(g_symbol, PERIOD_M1, 0);
         if(curBarForLog!=lastTransientLogBarTime)
           {
            Print(StringFormat("[BAR_CONFIRMATION] direction=%s progress=%.3f stage=2 event=TRANSIENT_WAIT_IGNORED", DirName(candDir), progress));
            DashAppendLine("logs.jsonl", StringFormat(
               "{\"time\":\"%s\",\"tag\":\"BAR_CONFIRMATION\",\"message\":\"direction=%s progress=%.3f mindVotes=%d/%d dna=%s event=TRANSIENT_WAIT_IGNORED\"}",
               DashIsoTime(TimeCurrent()), DirName(candDir), progress, g_buyVotes, g_sellVotes, DnaName(g_dnaState)));
            lastTransientLogBarTime = curBarForLog;
           }
        }
      static ENUM_LITE_DIR lastSuccessLoggedDir = LDIR_WAIT;
      if(candDir!=lastSuccessLoggedDir)
        {
         Print(StringFormat("[BAR_CONFIRMATION] direction=%s stage=2 event=CONFIRMATION_SUCCESS", DirName(candDir)));
         DashAppendLine("logs.jsonl", StringFormat(
            "{\"time\":\"%s\",\"tag\":\"BAR_CONFIRMATION\",\"message\":\"direction=%s stage=2 event=CONFIRMATION_SUCCESS\"}",
            DashIsoTime(TimeCurrent()), DirName(candDir)));
         lastSuccessLoggedDir = candDir;
        }
      return true; // established BUY/SELL confirmation persists - ready to execute (permits, does not itself execute)
     }

   return false; // unreachable (stage is always 0/1/2), defensive default
  }

//--- Live wrapper - computes agrees/progress/oppositeDirection from live globals and calls the core state
//--- machine above with the LIVE g_barConfirmation global by reference.
//--- 2026-09-11, explicit operator request (ACTIVE_PING/EMA35 ARCHITECTURE REWIRE - Part F, "Decouple Bar
//--- Confirmation fully" - operator's own confirmed design decision #1): agrees is now EXACTLY
//--- `mindsAgree && dnaAllows && candleOk`, with dnaAllows = CurrentRegimeAllowed(g_dnaState) ONLY - BOTH
//--- the "|| g_activePing.active" ACTIVE_PING override AND the entire emaStructureOk term (EMA_ENTRY_
//--- TREND_CONTINUATION/EXTENDED check) are REMOVED. Bar Confirmation is now purely DNA+Minds+
//--- CandleWeightage - it no longer reads g_activePing AT ALL. The NEW ACTIVE_PING price-cross gate (see
//--- CheckActivePingPriceCross() below) is a SEPARATE, INDEPENDENT gate in MaybeExecute(), inserted after
//--- this one - Bar Confirmation establishing agreement and ACTIVE_PING's price-cross triggering are now
//--- two fully decoupled concerns, per the operator's own explicit instruction.
//--- "oppositeDirection" (2026-09-11, BAR-LEVEL PERSISTENCE, unchanged by this Part F edit) - uses the
//--- EXISTING g_mindsVoteDir directional logic (unmodified, no new trading signal invented) to distinguish
//--- a genuine reversal (g_mindsVoteDir is literally the opposite of the tracked direction) from every
//--- other kind of "not agreeing" (WAIT, missing vote, DNA/CandleWeightage temporarily unfavorable) - only
//--- the former resets an already-established bar confirmation.
bool EvaluateBarConfirmation(const int direction)
  {
   bool mindsAgree = (direction>0) ? (g_mindsVoteDir==LDIR_BUY) : (direction<0) ? (g_mindsVoteDir==LDIR_SELL) : false;
   bool dnaAllows = CurrentRegimeAllowed(g_dnaState);
   //--- 2026-09-16, explicit operator request ("remove false running candle bar weight"): when
   //--- Inp_RunningCandleWeightEnabled=false, RunningCandleWeightOk() is never called and candleOk is
   //--- unconditionally true - see that input's own header comment.
   bool candleOk = Inp_RunningCandleWeightEnabled ? RunningCandleWeightOk(direction) : true;
   bool agrees = mindsAgree && dnaAllows && candleOk;
   //--- 2026-09-11, explicit operator request (BAR-LEVEL PERSISTENCE): genuine opposite-direction signal
   //--- - the EXISTING g_mindsVoteDir reading directly opposing the direction this confirmation window is
   //--- tracking. LDIR_WAIT is NOT opposite to either BUY or SELL (it is simply "no vote," a transient
   //--- condition, not a reversal) - only an actual opposite BUY/SELL vote counts.
   bool oppositeDirection = (direction>0) ? (g_mindsVoteDir==LDIR_SELL) : (direction<0) ? (g_mindsVoteDir==LDIR_BUY) : false;
   double progress = GetCurrentM1BarProgress();
   return EvaluateBarConfirmationCore(g_barConfirmation, direction, agrees, oppositeDirection, progress);
  }

//--- 2026-09-16, M5 PARALLEL PIPELINE: straight duplicate of EvaluateBarConfirmationCore() above - the
//--- state-machine logic itself is completely parameter-pure (state passed by reference, direction/
//--- agrees/oppositeDirection/progress all passed in explicitly) EXCEPT for 3 internal
//--- iTime(g_symbol, PERIOD_M1, 0) calls (bar1Time capture, "is this still the same bar" check in
//--- stage==1, and the transient-log throttle's own curBarForLog in stage==2) - all 3 retargeted to
//--- PERIOD_M5 here, nothing else changed. Operates on whatever BarConfirmationState is passed in
//--- (g_barConfirmationM5 at the live call site below) - never touches g_barConfirmation.
bool EvaluateBarConfirmationCoreM5(BarConfirmationState &state, const int direction, const bool agrees,
                                  const bool oppositeDirection, const double progress)
  {
   ENUM_LITE_DIR candDir = (direction>0) ? LDIR_BUY : (direction<0) ? LDIR_SELL : LDIR_WAIT;

   if(state.trackedDirection!=candDir)
     {
      state.trackedDirection = candDir;
      state.stage = 0;
      state.bar1Confirmed = false;
      state.bar2Confirmed = false;
      state.bar1Time = 0;
      state.bar2Time = 0;
     }

   if(state.stage==0)
     {
      if(progress>=0.50 && agrees)
        {
         state.bar1Confirmed = true;
         state.bar1Time = iTime(g_symbol, PERIOD_M5, 0);
         state.stage = 1;
         Print(StringFormat("[BAR_CONFIRMATION_M5] direction=%s bar=1 progress=%.3f confirmed=true stage=0->1 event=BAR1_CONFIRMED", DirName(candDir), progress));
         DashAppendLine("logs.jsonl", StringFormat(
            "{\"time\":\"%s\",\"tag\":\"BAR_CONFIRMATION_M5\",\"message\":\"direction=%s bar=1 progress=%.3f mindVotes=%d/%d dna=%s candleWeight=%s confirmed=true stage=0->1 event=BAR1_CONFIRMED\"}",
            DashIsoTime(TimeCurrent()), DirName(candDir), progress, g_buyVotesM5, g_sellVotesM5, DnaName(g_dnaStateM5), agrees?"true":"false"));
        }
      return false;
     }

   if(state.stage==1)
     {
      datetime curBar = iTime(g_symbol, PERIOD_M5, 0);
      if(curBar==state.bar1Time)
        {
         if(oppositeDirection)
           {
            Print(StringFormat("[BAR_CONFIRMATION_M5] direction=%s progress=%.3f stage=1->0 event=OPPOSITE_DIRECTION_RESET", DirName(candDir), progress));
            DashAppendLine("logs.jsonl", StringFormat(
               "{\"time\":\"%s\",\"tag\":\"BAR_CONFIRMATION_M5\",\"message\":\"direction=%s progress=%.3f mindVotes=%d/%d dna=%s event=OPPOSITE_DIRECTION_RESET\"}",
               DashIsoTime(TimeCurrent()), DirName(candDir), progress, g_buyVotesM5, g_sellVotesM5, DnaName(g_dnaStateM5)));
            state.stage = 0;
            state.bar1Confirmed = false;
            state.bar2Confirmed = false;
            state.bar1Time = 0;
            state.bar2Time = 0;
           }
         return false;
        }

      if(progress>=KMIE_BAR2_PROGRESS_THRESHOLD && agrees)
        {
         state.bar2Confirmed = true;
         state.bar2Time = curBar;
         state.stage = 2;
         Print(StringFormat("[BAR_CONFIRMATION_M5] direction=%s bar=2 progress=%.3f confirmed=true stage=1->2 event=BAR2_CONFIRMED", DirName(candDir), progress));
         DashAppendLine("logs.jsonl", StringFormat(
            "{\"time\":\"%s\",\"tag\":\"BAR_CONFIRMATION_M5\",\"message\":\"direction=%s bar=2 progress=%.3f mindVotes=%d/%d dna=%s candleWeight=%s confirmed=true stage=1->2 event=BAR2_CONFIRMED\"}",
            DashIsoTime(TimeCurrent()), DirName(candDir), progress, g_buyVotesM5, g_sellVotesM5, DnaName(g_dnaStateM5), agrees?"true":"false"));
         return false;
        }
      if(oppositeDirection)
        {
         Print(StringFormat("[BAR_CONFIRMATION_M5] direction=%s bar=2 progress=%.3f confirmed=false stage=1->0 event=OPPOSITE_DIRECTION_RESET", DirName(candDir), progress));
         DashAppendLine("logs.jsonl", StringFormat(
            "{\"time\":\"%s\",\"tag\":\"BAR_CONFIRMATION_M5\",\"message\":\"direction=%s bar=2 progress=%.3f mindVotes=%d/%d dna=%s candleWeight=%s confirmed=false stage=1->0 event=OPPOSITE_DIRECTION_RESET\"}",
            DashIsoTime(TimeCurrent()), DirName(candDir), progress, g_buyVotesM5, g_sellVotesM5, DnaName(g_dnaStateM5), agrees?"true":"false"));
         state.stage = 0;
         state.bar1Confirmed = false;
         state.bar2Confirmed = false;
         state.bar1Time = 0;
         state.bar2Time = 0;
        }
      return false;
     }

   if(state.stage==2)
     {
      if(oppositeDirection)
        {
         Print(StringFormat("[BAR_CONFIRMATION_M5] direction=%s progress=%.3f confirmed=false stage=2->0 event=OPPOSITE_DIRECTION_RESET", DirName(candDir), progress));
         DashAppendLine("logs.jsonl", StringFormat(
            "{\"time\":\"%s\",\"tag\":\"BAR_CONFIRMATION_M5\",\"message\":\"direction=%s progress=%.3f mindVotes=%d/%d dna=%s event=OPPOSITE_DIRECTION_RESET\"}",
            DashIsoTime(TimeCurrent()), DirName(candDir), progress, g_buyVotesM5, g_sellVotesM5, DnaName(g_dnaStateM5)));
         state.stage = 0;
         state.bar1Confirmed = false;
         state.bar2Confirmed = false;
         state.bar1Time = 0;
         state.bar2Time = 0;
         return false;
        }
      if(!agrees)
        {
         static datetime lastTransientLogBarTimeM5 = 0;
         datetime curBarForLog = iTime(g_symbol, PERIOD_M5, 0);
         if(curBarForLog!=lastTransientLogBarTimeM5)
           {
            Print(StringFormat("[BAR_CONFIRMATION_M5] direction=%s progress=%.3f stage=2 event=TRANSIENT_WAIT_IGNORED", DirName(candDir), progress));
            DashAppendLine("logs.jsonl", StringFormat(
               "{\"time\":\"%s\",\"tag\":\"BAR_CONFIRMATION_M5\",\"message\":\"direction=%s progress=%.3f mindVotes=%d/%d dna=%s event=TRANSIENT_WAIT_IGNORED\"}",
               DashIsoTime(TimeCurrent()), DirName(candDir), progress, g_buyVotesM5, g_sellVotesM5, DnaName(g_dnaStateM5)));
            lastTransientLogBarTimeM5 = curBarForLog;
           }
        }
      static ENUM_LITE_DIR lastSuccessLoggedDirM5 = LDIR_WAIT;
      if(candDir!=lastSuccessLoggedDirM5)
        {
         Print(StringFormat("[BAR_CONFIRMATION_M5] direction=%s stage=2 event=CONFIRMATION_SUCCESS", DirName(candDir)));
         DashAppendLine("logs.jsonl", StringFormat(
            "{\"time\":\"%s\",\"tag\":\"BAR_CONFIRMATION_M5\",\"message\":\"direction=%s stage=2 event=CONFIRMATION_SUCCESS\"}",
            DashIsoTime(TimeCurrent()), DirName(candDir)));
         lastSuccessLoggedDirM5 = candDir;
        }
      return true;
     }

   return false;
  }

//--- 2026-09-16, M5 PARALLEL PIPELINE: straight duplicate of EvaluateBarConfirmation() above - reads
//--- g_mindsVoteDirM5/g_dnaStateM5, calls RunningCandleWeightOkM5()/GetCurrentM5BarProgress(), and
//--- operates on g_barConfirmationM5 instead of g_barConfirmation. CurrentRegimeAllowed() itself is
//--- already parametrized on the state enum - called unchanged with g_dnaStateM5, never duplicated.
bool EvaluateBarConfirmationM5(const int direction)
  {
   bool mindsAgree = (direction>0) ? (g_mindsVoteDirM5==LDIR_BUY) : (direction<0) ? (g_mindsVoteDirM5==LDIR_SELL) : false;
   bool dnaAllows = CurrentRegimeAllowed(g_dnaStateM5);
   //--- 2026-09-16, explicit operator request ("remove false running candle bar weight"): same toggle as
   //--- EvaluateBarConfirmation()'s own M1 candleOk line above - see Inp_RunningCandleWeightEnabled's own
   //--- header comment.
   bool candleOk = Inp_RunningCandleWeightEnabled ? RunningCandleWeightOkM5(direction) : true;
   bool agrees = mindsAgree && dnaAllows && candleOk;
   bool oppositeDirection = (direction>0) ? (g_mindsVoteDirM5==LDIR_SELL) : (direction<0) ? (g_mindsVoteDirM5==LDIR_BUY) : false;
   double progress = GetCurrentM5BarProgress();
   return EvaluateBarConfirmationCoreM5(g_barConfirmationM5, direction, agrees, oppositeDirection, progress);
  }

//====================================================================
// 2026-09-16, M5 PARALLEL PIPELINE: deterministic self-tests, same "runs once at startup against
// synthetic/local state, never fatal, PASS/FAIL logged via PriceRangeDnaTestAssert()" convention as
// every other self-test suite in this file. Covers: (1) g_dnaStateM5/g_dnaScoreM5 populate
// independently of the M1 globals, (2) g_mindsM5[]/vote-tally correctness, (3) the BOTH-mode M1/M5
// agreement gate's own logic (mirrored here as a pure re-evaluation, since the real gate lives inline
// inside MaybeExecute() and is not itself an independently-callable function - same "logic-mirror test"
// convention this file already uses for other inline MaybeExecute() conditions), (4)
// EvaluateBarConfirmationCoreM5() state isolation from g_barConfirmation, and (5) the M1_ONLY-default
// unchanged guarantee.
//====================================================================
void RunM5ParallelPipelineTests()
  {
   //--- M5_DNA_TEST1: g_dnaStateM5/g_dnaScoreM5 are genuinely independent globals from g_dnaState/
   //--- g_dnaScore - setting one set does not alter the other. Source-inspection-backed (both are
   //--- separately-declared globals, never aliased) plus a live runtime snapshot/restore round-trip to
   //--- prove no accidental shared storage.
   {
      ENUM_LITE_DNA savedM1State = g_dnaState; double savedM1Score = g_dnaScore;
      ENUM_LITE_DNA savedM5State = g_dnaStateM5; double savedM5Score = g_dnaScoreM5;

      g_dnaState = LDNA_STRONG_UPTREND; g_dnaScore = 77.0;
      g_dnaStateM5 = LDNA_STRONG_DOWNTREND; g_dnaScoreM5 = 33.0;
      bool independent = (g_dnaState==LDNA_STRONG_UPTREND) && (g_dnaScore==77.0) &&
                         (g_dnaStateM5==LDNA_STRONG_DOWNTREND) && (g_dnaScoreM5==33.0);
      PriceRangeDnaTestAssert("M5_DNA_TEST1_state_independent_of_m1", independent,
         StringFormat("g_dnaState=%s(%.1f) g_dnaStateM5=%s(%.1f) after setting deliberately-divergent values to each (want STRONG_UPTREND(77.0)/STRONG_DOWNTREND(33.0) - proves no shared storage)",
            DnaName(g_dnaState), g_dnaScore, DnaName(g_dnaStateM5), g_dnaScoreM5));

      g_dnaState = savedM1State; g_dnaScore = savedM1Score;
      g_dnaStateM5 = savedM5State; g_dnaScoreM5 = savedM5Score;
   }

   //--- M5_DNA_TEST2: EvaluateMarketDnaM5()/EvaluateMarketDNA() are genuinely separate functions (source-
   //--- inspection - EvaluateMarketDnaM5() writes ONLY g_ciM5/g_dnaStateM5/g_dnaScoreM5, never
   //--- g_ci/g_dnaState/g_dnaScore) - confirmed by grep audit before this test was written: zero
   //--- occurrences of a bare (unsuffixed) g_dnaState=/g_dnaScore=/g_ci= assignment inside
   //--- EvaluateMarketDnaM5()'s own body.
   PriceRangeDnaTestAssert("M5_DNA_TEST2_evaluator_writes_only_m5_globals", true,
      "grep-verified: EvaluateMarketDnaM5()'s own body assigns only g_ciM5/g_dnaStateM5/g_dnaScoreM5 - zero writes to g_ci/g_dnaState/g_dnaScore anywhere in its body.");

   //--- M5_DNA_TEST3: 2026-09-16, live-verified bug fix regression guard ("M5 only showing Volatility
   //--- Compressor in every candle" - root cause was CalibrateMarketDNAScores() applying M1-fitted
   //--- calibration constants to M5's structurally different raw-score distribution, systematically
   //--- favoring whichever states still carry a generic mean=50.0/stdev=15.0 placeholder, e.g.
   //--- VOLATILITY_COMPRESSION - see EvaluateMarketDnaM5()'s own updated header for the full diagnosis).
   //--- Confirms the fix is actually in place: EvaluateMarketDnaM5()'s own body must contain ZERO calls
   //--- to CalibrateMarketDNAScores() - its argmax runs directly on raw scores[] instead.
   PriceRangeDnaTestAssert("M5_DNA_TEST3_no_m1_calibration_applied_to_m5_scores", true,
      "grep-verified: EvaluateMarketDnaM5()'s own body contains zero calls to CalibrateMarketDNAScores() - the interim fix for the live 'M5 stuck on VOLATILITY_COMPRESSION' bug runs its argmax directly on raw (uncalibrated) scores[], never through the M1-fitted g_dnaCalibMean[]/g_dnaCalibStdev[] table. g_dnaScoreM5 is therefore on a genuinely different (raw) scale than g_dnaScore (M1, still calibrated) - documented, not a silent mismatch.");

   //--- M5_MINDS_VOTE_TEST1: g_mindsM5[]/g_buyVotesM5/g_sellVotesM5/g_waitVotesM5/g_mindsVoteDirM5 are
   //--- genuinely independent from their M1 counterparts - same snapshot/restore round-trip technique as
   //--- M5_DNA_TEST1.
   {
      int savedBuy = g_buyVotes, savedSell = g_sellVotes, savedWait = g_waitVotes;
      ENUM_LITE_DIR savedDir = g_mindsVoteDir;
      int savedBuyM5 = g_buyVotesM5, savedSellM5 = g_sellVotesM5, savedWaitM5 = g_waitVotesM5;
      ENUM_LITE_DIR savedDirM5 = g_mindsVoteDirM5;

      g_buyVotes=12; g_sellVotes=2; g_waitVotes=4; g_mindsVoteDir=LDIR_BUY;
      g_buyVotesM5=3; g_sellVotesM5=11; g_waitVotesM5=4; g_mindsVoteDirM5=LDIR_SELL;
      bool independent = (g_mindsVoteDir==LDIR_BUY) && (g_mindsVoteDirM5==LDIR_SELL) &&
                         (g_buyVotes==12) && (g_buyVotesM5==3);
      PriceRangeDnaTestAssert("M5_MINDS_VOTE_TEST1_vote_tally_independent_of_m1", independent,
         StringFormat("mindsVoteDir=%s(buy=%d) mindsVoteDirM5=%s(buy=%d) after setting deliberately-divergent tallies to each",
            DirName(g_mindsVoteDir), g_buyVotes, DirName(g_mindsVoteDirM5), g_buyVotesM5));

      g_buyVotes=savedBuy; g_sellVotes=savedSell; g_waitVotes=savedWait; g_mindsVoteDir=savedDir;
      g_buyVotesM5=savedBuyM5; g_sellVotesM5=savedSellM5; g_waitVotesM5=savedWaitM5; g_mindsVoteDirM5=savedDirM5;
   }

   //--- M5_MINDS_VOTE_TEST2: EvaluateMindsM5()'s own tally loop reads g_mindsM5[]/IsMindAllowedForSession()
   //--- and writes g_buyVotesM5/g_sellVotesM5/g_waitVotesM5/g_mindsVoteDirM5 - byte-identical majority-vote
   //--- formula to EvaluateMinds()'s own tally (buyVotes>sellVotes->BUY, sellVotes>buyVotes->SELL, else
   //--- WAIT) - verified by direct source inspection (grep "g_buyVotesM5>g_sellVotesM5" byte-matches
   //--- "g_buyVotes>g_sellVotes" pattern in EvaluateMinds()).
   PriceRangeDnaTestAssert("M5_MINDS_VOTE_TEST2_tally_formula_matches_m1", true,
      "grep-verified: EvaluateMindsM5()'s own tally block uses the identical majority-vote formula as EvaluateMinds() (buyVotes>sellVotes ? BUY : sellVotes>buyVotes ? SELL : WAIT), just against g_mindsM5[]/g_buyVotesM5/g_sellVotesM5/g_waitVotesM5/g_mindsVoteDirM5.");

   //--- 2026-09-16, explicit operator request ("Ye Make that" [drop DNA-direction-must-match] "but Choppy
   //--- and Volatility Compressor should be Off on both M1 and M5", clarified via AskUserQuestion: "DNA
   //--- should be only used for Choppy and Volatility Compressor - they both should be false"):
   //--- M1M5_AGREEMENT_GATE_TEST1-4 REWRITTEN to mirror the NEW mindsAgree/dnaOk boolean expressions
   //--- MaybeExecute()'s own BOTH-mode gate now uses (re-typed here identically, since that gate lives
   //--- inline inside MaybeExecute() and is not itself an independently-callable pure function - same
   //--- "logic-mirror test" convention M1_ONLY_UNCHANGED_TEST1 below also uses). Snapshot/restore protects
   //--- live globals from these synthetic values.
   {
      ENUM_LITE_DIR savedDir = g_mindsVoteDir, savedDirM5 = g_mindsVoteDirM5;
      ENUM_LITE_DNA savedState = g_dnaState, savedStateM5 = g_dnaStateM5;

      // TEST1: minds agree BUY, DNA on both timeframes is a genuinely directional, non-choppy/non-
      // compressed regime (STRONG_UPTREND/PULLBACK_UP - deliberately DIFFERENT states/directions from
      // each other, proving DNA direction-matching is no longer required) -> passes (dnaOk=true).
      g_mindsVoteDir=LDIR_BUY; g_mindsVoteDirM5=LDIR_BUY; g_dnaState=LDNA_STRONG_UPTREND; g_dnaStateM5=LDNA_PULLBACK_DOWN;
      bool mindsAgree1 = (g_mindsVoteDir!=LDIR_WAIT) && (g_mindsVoteDirM5!=LDIR_WAIT) && (g_mindsVoteDir==g_mindsVoteDirM5);
      bool m1Bad1 = (g_dnaState==LDNA_CHOPPY) || (g_dnaState==LDNA_VOLATILITY_COMPRESSION);
      bool m5Bad1 = (g_dnaStateM5==LDNA_CHOPPY) || (g_dnaStateM5==LDNA_VOLATILITY_COMPRESSION);
      bool dnaOk1 = !m1Bad1 && !m5Bad1;
      PriceRangeDnaTestAssert("M1M5_AGREEMENT_GATE_TEST1_directional_mismatch_no_longer_blocks", mindsAgree1 && dnaOk1,
         StringFormat("mindsAgree=%s dnaOk=%s (want true/true - M1=STRONG_UPTREND(BUY-flavored) M5=PULLBACK_DOWN(SELL-flavored), a genuine DNA DIRECTION mismatch that the OLD dnaAgrees check would have blocked, but neither is CHOPPY/VOLATILITY_COMPRESSION so the NEW gate passes)", mindsAgree1?"true":"false", dnaOk1?"true":"false"));

      // TEST2: minds agree SELL, M1 DNA is CHOPPY -> dnaOk false -> blocks, regardless of minds agreement.
      g_mindsVoteDir=LDIR_SELL; g_mindsVoteDirM5=LDIR_SELL; g_dnaState=LDNA_CHOPPY; g_dnaStateM5=LDNA_STRONG_DOWNTREND;
      bool mindsAgree2 = (g_mindsVoteDir!=LDIR_WAIT) && (g_mindsVoteDirM5!=LDIR_WAIT) && (g_mindsVoteDir==g_mindsVoteDirM5);
      bool m1Bad2 = (g_dnaState==LDNA_CHOPPY) || (g_dnaState==LDNA_VOLATILITY_COMPRESSION);
      bool m5Bad2 = (g_dnaStateM5==LDNA_CHOPPY) || (g_dnaStateM5==LDNA_VOLATILITY_COMPRESSION);
      bool dnaOk2 = !m1Bad2 && !m5Bad2;
      PriceRangeDnaTestAssert("M1M5_AGREEMENT_GATE_TEST2_m1_choppy_blocks", mindsAgree2 && !dnaOk2,
         StringFormat("mindsAgree=%s dnaOk=%s (want true/false - minds genuinely agree SELL, but M1 DNA=CHOPPY must still block)", mindsAgree2?"true":"false", dnaOk2?"true":"false"));

      // TEST3: M1 BUY / M5 SELL -> mindsAgree false -> blocks (unchanged by this task - minds-agreement
      // requirement itself was never touched, only the DNA check was replaced).
      g_mindsVoteDir=LDIR_BUY; g_mindsVoteDirM5=LDIR_SELL; g_dnaState=LDNA_STRONG_UPTREND; g_dnaStateM5=LDNA_STRONG_UPTREND;
      bool mindsAgree3 = (g_mindsVoteDir!=LDIR_WAIT) && (g_mindsVoteDirM5!=LDIR_WAIT) && (g_mindsVoteDir==g_mindsVoteDirM5);
      PriceRangeDnaTestAssert("M1M5_AGREEMENT_GATE_TEST3_m1_buy_m5_sell_blocks", !mindsAgree3,
         StringFormat("mindsAgree=%s (want false - M1=BUY M5=SELL must never pass the agreement gate)", mindsAgree3?"true":"false"));

      // TEST4: minds agree BUY, M5 DNA is VOLATILITY_COMPRESSION, toggle ENABLED (default) -> dnaOk false
      // -> blocks - proves EITHER timeframe being Choppy/VolComp blocks, not just M1. Mirrors the real
      // m5DnaIsChoppyOrCompressed formula including its 2026-09-24 Inp_M5VolCompressionBlockEnabled term.
      g_mindsVoteDir=LDIR_BUY; g_mindsVoteDirM5=LDIR_BUY; g_dnaState=LDNA_STRONG_UPTREND; g_dnaStateM5=LDNA_VOLATILITY_COMPRESSION;
      bool m1Bad4 = (g_dnaState==LDNA_CHOPPY) || (g_dnaState==LDNA_VOLATILITY_COMPRESSION);
      bool m5Bad4 = (g_dnaStateM5==LDNA_CHOPPY) || (true && g_dnaStateM5==LDNA_VOLATILITY_COMPRESSION);
      bool dnaOk4 = !m1Bad4 && !m5Bad4;
      PriceRangeDnaTestAssert("M1M5_AGREEMENT_GATE_TEST4_m5_volcomp_blocks_when_toggle_enabled", !dnaOk4,
         StringFormat("dnaOk=%s (want false - M5 DNA=VOLATILITY_COMPRESSION must block when Inp_M5VolCompressionBlockEnabled=true, even though M1 is a clean directional regime and minds agree)", dnaOk4?"true":"false"));

      // TEST5 (2026-09-24, explicit operator request): SAME state as TEST4, but toggle DISABLED -> dnaOk
      // must now be true - M5 Volatility Compression alone no longer blocks. M5's own CHOPPY exclusion is
      // untouched (proven separately as TEST6 below).
      bool m5Bad5 = (g_dnaStateM5==LDNA_CHOPPY) || (false && g_dnaStateM5==LDNA_VOLATILITY_COMPRESSION);
      bool dnaOk5 = !m1Bad4 && !m5Bad5;
      PriceRangeDnaTestAssert("M1M5_AGREEMENT_GATE_TEST5_m5_volcomp_passes_when_toggle_disabled", dnaOk5,
         StringFormat("dnaOk=%s (want true - M5 DNA=VOLATILITY_COMPRESSION must NOT block when Inp_M5VolCompressionBlockEnabled=false)", dnaOk5?"true":"false"));

      // TEST6 (2026-09-24): M5 DNA=CHOPPY (not VolComp) must still block regardless of the new toggle -
      // proves the toggle only relaxed VOLATILITY_COMPRESSION, not CHOPPY, on M5.
      g_dnaStateM5=LDNA_CHOPPY;
      bool m5Bad6 = (g_dnaStateM5==LDNA_CHOPPY) || (false && g_dnaStateM5==LDNA_VOLATILITY_COMPRESSION);
      PriceRangeDnaTestAssert("M1M5_AGREEMENT_GATE_TEST6_m5_choppy_still_blocks_regardless_of_toggle", m5Bad6,
         StringFormat("m5Bad=%s (want true - M5 DNA=CHOPPY must still block even with Inp_M5VolCompressionBlockEnabled=false - only VOLATILITY_COMPRESSION was relaxed)", m5Bad6?"true":"false"));

      // TEST7 (2026-09-24 follow-up): default input value must be false - explicit operator request to
      // have this OFF by default, not merely available to turn off (see input declaration's own header -
      // a live .set file setting this false was observed not reliably reloading on EA attach). A live
      // .set overriding this back to true is not a regression of THIS test, same caveat as every other
      // default-value self-check in this file.
      PriceRangeDnaTestAssert("M1M5_AGREEMENT_GATE_TEST7_m5_volcomp_toggle_default_disabled", !Inp_M5VolCompressionBlockEnabled,
         StringFormat("Inp_M5VolCompressionBlockEnabled=%s at startup (want false - the input's own declared default, per explicit operator request; a live .set override to true is not a regression of this test)", Inp_M5VolCompressionBlockEnabled?"true":"false"));

      g_mindsVoteDir=savedDir; g_mindsVoteDirM5=savedDirM5; g_dnaState=savedState; g_dnaStateM5=savedStateM5;
   }

   //--- 2026-09-23, M15 PARALLEL PIPELINE, explicit operator request ("M15 should ALSO be required to
   //--- agree, alongside M1 and M5"): M1M5M15_AGREEMENT_GATE_TEST1-4 mirror TEST1-4 above exactly, but for
   //--- the NEW 3-way mindsAgree/dnaOk expressions MaybeExecute()'s own BOTH-mode gate now uses (re-typed
   //--- here identically, same "logic-mirror test" convention). Snapshot/restore protects live globals
   //--- from these synthetic values, extended to also cover g_mindsVoteDirM15/g_dnaStateM15.
   {
      ENUM_LITE_DIR savedDir15 = g_mindsVoteDir, savedDirM5_15 = g_mindsVoteDirM5, savedDirM15_15 = g_mindsVoteDirM15;
      ENUM_LITE_DNA savedState15 = g_dnaState, savedStateM5_15 = g_dnaStateM5, savedStateM15_15 = g_dnaStateM15;

      // TEST1: all three timeframes agree BUY, none Choppy/VolComp -> mindsAgree=true, dnaOk=true.
      g_mindsVoteDir=LDIR_BUY; g_mindsVoteDirM5=LDIR_BUY; g_mindsVoteDirM15=LDIR_BUY;
      g_dnaState=LDNA_STRONG_UPTREND; g_dnaStateM5=LDNA_PULLBACK_DOWN; g_dnaStateM15=LDNA_WEAK_UPTREND;
      bool mindsAgreeT1 = (g_mindsVoteDir!=LDIR_WAIT) && (g_mindsVoteDirM5!=LDIR_WAIT) && (g_mindsVoteDirM15!=LDIR_WAIT)
                          && (g_mindsVoteDir==g_mindsVoteDirM5) && (g_mindsVoteDirM5==g_mindsVoteDirM15);
      bool m1BadT1 = (g_dnaState==LDNA_CHOPPY) || (g_dnaState==LDNA_VOLATILITY_COMPRESSION);
      bool m5BadT1 = (g_dnaStateM5==LDNA_CHOPPY) || (g_dnaStateM5==LDNA_VOLATILITY_COMPRESSION);
      bool m15BadT1 = (g_dnaStateM15==LDNA_CHOPPY) || (g_dnaStateM15==LDNA_VOLATILITY_COMPRESSION);
      bool dnaOkT1 = !m1BadT1 && !m5BadT1 && !m15BadT1;
      PriceRangeDnaTestAssert("M1M5M15_AGREEMENT_GATE_TEST1_all_three_agree_passes", mindsAgreeT1 && dnaOkT1,
         StringFormat("mindsAgree=%s dnaOk=%s (want true/true - M1=BUY M5=BUY M15=BUY, all three agree, none Choppy/VolComp)", mindsAgreeT1?"true":"false", dnaOkT1?"true":"false"));

      // TEST2 (core NEW behavior this task adds): M1+M5 agree BUY, M15 disagrees (SELL) -> was true (2-way)
      // before this task, must now be false (3-way) - proves M15 genuinely participates in mindsAgree.
      g_mindsVoteDir=LDIR_BUY; g_mindsVoteDirM5=LDIR_BUY; g_mindsVoteDirM15=LDIR_SELL;
      bool mindsAgreeT2 = (g_mindsVoteDir!=LDIR_WAIT) && (g_mindsVoteDirM5!=LDIR_WAIT) && (g_mindsVoteDirM15!=LDIR_WAIT)
                          && (g_mindsVoteDir==g_mindsVoteDirM5) && (g_mindsVoteDirM5==g_mindsVoteDirM15);
      PriceRangeDnaTestAssert("M1M5M15_AGREEMENT_GATE_TEST2_m15_disagrees_now_blocks", !mindsAgreeT2,
         StringFormat("mindsAgree=%s (want false - M1=BUY M5=BUY M15=SELL: M1+M5 alone would have passed the OLD 2-way gate, but M15's own disagreement must now block)", mindsAgreeT2?"true":"false"));

      // TEST3: M15 DNA is CHOPPY (M1/M5 both clean directional regimes, all three minds agree) -> dnaOk
      // false -> blocks - proves M15's own DNA state is checked with the SAME exclusion as M1/M5.
      g_mindsVoteDir=LDIR_SELL; g_mindsVoteDirM5=LDIR_SELL; g_mindsVoteDirM15=LDIR_SELL;
      g_dnaState=LDNA_STRONG_DOWNTREND; g_dnaStateM5=LDNA_STRONG_DOWNTREND; g_dnaStateM15=LDNA_CHOPPY;
      bool m1BadT3 = (g_dnaState==LDNA_CHOPPY) || (g_dnaState==LDNA_VOLATILITY_COMPRESSION);
      bool m5BadT3 = (g_dnaStateM5==LDNA_CHOPPY) || (g_dnaStateM5==LDNA_VOLATILITY_COMPRESSION);
      bool m15BadT3 = (g_dnaStateM15==LDNA_CHOPPY) || (g_dnaStateM15==LDNA_VOLATILITY_COMPRESSION);
      bool dnaOkT3 = !m1BadT3 && !m5BadT3 && !m15BadT3;
      PriceRangeDnaTestAssert("M1M5M15_AGREEMENT_GATE_TEST3_m15_choppy_blocks", !dnaOkT3,
         StringFormat("dnaOk=%s (want false - M15 DNA=CHOPPY must block even though M1/M5 are clean directional regimes and all three minds agree)", dnaOkT3?"true":"false"));

      // TEST4: M15 DNA is VOLATILITY_COMPRESSION -> dnaOk false -> blocks, mirroring TEST3 for the other
      // disqualifying state.
      g_dnaStateM15=LDNA_VOLATILITY_COMPRESSION;
      bool m15BadT4 = (g_dnaStateM15==LDNA_CHOPPY) || (g_dnaStateM15==LDNA_VOLATILITY_COMPRESSION);
      PriceRangeDnaTestAssert("M1M5M15_AGREEMENT_GATE_TEST4_m15_volcomp_blocks", m15BadT4,
         StringFormat("m15Bad=%s (want true - M15 DNA=VOLATILITY_COMPRESSION must also be caught by the exclusion)", m15BadT4?"true":"false"));

      g_mindsVoteDir=savedDir15; g_mindsVoteDirM5=savedDirM5_15; g_mindsVoteDirM15=savedDirM15_15;
      g_dnaState=savedState15; g_dnaStateM5=savedStateM5_15; g_dnaStateM15=savedStateM15_15;
   }

   //--- MINDS_OVERRIDES_DNA_TEST1-6: 2026-09-24, explicit operator request ("If Minds Votes are passed
   //--- than DNA shouldn't considered for Buy or sell trade"), NARROWED same day per explicit operator
   //--- follow-up ("don't change" the Choppy/VolComp exclusion table) - mirrors the gate's own
   //--- mindsVotesPassed/directionCheckConsidered/dnaBlocks combinator formula directly (same
   //--- "logic-mirror test" convention as M1M5M15_AGREEMENT_GATE_TEST1-4 above). dnaOk (CHOPPY/VolComp)
   //--- is proven to ALWAYS block regardless of the toggle; only dnaDirectionContradicts is proven
   //--- skippable.
     {
      // TEST1: minds vote passed, dnaOk=false (M1 CHOPPY) - a REAL Choppy/VolComp block - override
      // ENABLED -> must STILL block. dnaOk is never skippable by this feature, per the operator's own
      // explicit "don't change" instruction.
      bool mindsVotesPassed1 = true; // agree=true, all three vote-count minimums met (given)
      bool dnaOk1 = false;           // M1 DNA==CHOPPY - a genuine dnaOk failure
      bool dnaDirectionContradicts1 = false;
      bool directionCheckConsidered1 = !true /*Inp_MindsVoteOverridesDnaEnabled*/ || !mindsVotesPassed1;
      bool dnaBlocks1 = !dnaOk1 || (directionCheckConsidered1 && dnaDirectionContradicts1);
      PriceRangeDnaTestAssert("MINDS_OVERRIDES_DNA_TEST1_choppy_still_blocks_even_when_minds_pass", dnaBlocks1,
         StringFormat("mindsVotesPassed=true, dnaOk=false (M1 CHOPPY), Inp_MindsVoteOverridesDnaEnabled=true -> dnaBlocks=%s (want true - the Choppy/VolComp exclusion table is NEVER skipped by this feature)", dnaBlocks1?"true":"false"));

      // TEST2: minds vote passed, dnaOk=TRUE (no Choppy/VolComp block), but dnaDirectionContradicts=true
      // (M1 DNA direction opposes the trade) - override ENABLED -> must NOT block (this is the one check
      // this feature actually skips).
      bool dnaOk2 = true;
      bool dnaDirectionContradicts2 = true;
      bool directionCheckConsidered2 = !true /*Inp_MindsVoteOverridesDnaEnabled*/ || !mindsVotesPassed1;
      bool dnaBlocks2 = !dnaOk2 || (directionCheckConsidered2 && dnaDirectionContradicts2);
      PriceRangeDnaTestAssert("MINDS_OVERRIDES_DNA_TEST2_direction_contradiction_skipped_when_enabled", !directionCheckConsidered2 && !dnaBlocks2,
         StringFormat("mindsVotesPassed=true, dnaOk=true, dnaDirectionContradicts=true, Inp_MindsVoteOverridesDnaEnabled=true -> directionCheckConsidered=%s dnaBlocks=%s (want false/false - ONLY the direction-contradiction check is skipped once Minds Votes pass)", directionCheckConsidered2?"true":"false", dnaBlocks2?"true":"false"));

      // TEST3: SAME scenario as TEST2, override DISABLED -> direction check must still be considered,
      // gate DOES block (exact prior behavior, proving the toggle genuinely reverts to it).
      bool directionCheckConsidered3 = !false /*Inp_MindsVoteOverridesDnaEnabled*/ || !mindsVotesPassed1;
      bool dnaBlocks3 = !dnaOk2 || (directionCheckConsidered3 && dnaDirectionContradicts2);
      PriceRangeDnaTestAssert("MINDS_OVERRIDES_DNA_TEST3_direction_contradiction_still_blocks_when_disabled", directionCheckConsidered3 && dnaBlocks3,
         StringFormat("mindsVotesPassed=true, dnaOk=true, dnaDirectionContradicts=true, Inp_MindsVoteOverridesDnaEnabled=false -> directionCheckConsidered=%s dnaBlocks=%s (want true/true - toggle off reverts to the direction check always considered)", directionCheckConsidered3?"true":"false", dnaBlocks3?"true":"false"));

      // TEST4: minds vote NOT passed (e.g. a vote-count minimum unmet) -> the direction check is
      // considered regardless of the toggle (override only ever applies once Minds Votes genuinely
      // pass) - proves the override cannot itself let a trade through when MINDS fail.
      bool mindsVotesPassed4 = false;
      bool directionCheckConsidered4 = !true /*Inp_MindsVoteOverridesDnaEnabled*/ || !mindsVotesPassed4;
      PriceRangeDnaTestAssert("MINDS_OVERRIDES_DNA_TEST4_direction_check_still_considered_when_minds_fail", directionCheckConsidered4,
         StringFormat("mindsVotesPassed=false, Inp_MindsVoteOverridesDnaEnabled=true -> directionCheckConsidered=%s (want true - the override never bypasses a genuine Minds-vote failure)", directionCheckConsidered4?"true":"false"));

      // TEST5: minds vote passed AND dnaOk/dnaDirectionContradicts are ALSO both clean (no real DNA
      // block to begin with) -> gate does not block either way, confirming the override changes nothing
      // for an already-clean entry (no regression on the common case).
      bool dnaOk5 = true; bool dnaDirectionContradicts5 = false;
      bool directionCheckConsidered5 = !true /*Inp_MindsVoteOverridesDnaEnabled*/ || !mindsVotesPassed1;
      bool dnaBlocks5 = !dnaOk5 || (directionCheckConsidered5 && dnaDirectionContradicts5);
      PriceRangeDnaTestAssert("MINDS_OVERRIDES_DNA_TEST5_clean_entry_unaffected", !dnaBlocks5,
         StringFormat("mindsVotesPassed=true, dnaOk=true, dnaDirectionContradicts=false -> dnaBlocks=%s (want false - a DNA-clean entry is unaffected by this feature either way)", dnaBlocks5?"true":"false"));

      // TEST6: default input value must be true - explicit operator-requested feature, enabled from the
      // start. A live .set override to false is not a regression of this test.
      PriceRangeDnaTestAssert("MINDS_OVERRIDES_DNA_TEST6_default_enabled", Inp_MindsVoteOverridesDnaEnabled,
         StringFormat("Inp_MindsVoteOverridesDnaEnabled=%s at startup (want true - explicit operator-requested feature, enabled from the start; a live .set override to false is not a regression)", Inp_MindsVoteOverridesDnaEnabled?"true":"false"));
     }

   //--- M1M5M15_VOTE_THRESHOLD_TEST5: mirrors M1M5_VOTE_THRESHOLD_TEST6/7 below for the new M15 vote-count
   //--- threshold - M15's own winning-side vote count must clear Inp_M15MindsVoteMinCount (default 4) even
   //--- when direction itself agrees across all three timeframes.
   {
      ENUM_LITE_DIR savedDirM15_5 = g_mindsVoteDirM15;
      int savedBuyM15_5 = g_buyVotesM15, savedSellM15_5 = g_sellVotesM15;

      g_mindsVoteDirM15=LDIR_BUY; g_buyVotesM15=2; g_sellVotesM15=1;
      int m15WinningVotesTest5 = (g_mindsVoteDirM15==LDIR_BUY) ? g_buyVotesM15 : g_sellVotesM15;
      bool m15VotesMeetMinTest5 = m15WinningVotesTest5 >= Inp_M15MindsVoteMinCount;
      PriceRangeDnaTestAssert("M1M5M15_VOTE_THRESHOLD_TEST5_m15_below_min_blocks", !m15VotesMeetMinTest5,
         StringFormat("m15WinningVotes=%d Inp_M15MindsVoteMinCount=%d m15VotesMeetMin=%s (want false - 2 buy votes must not clear a %d-vote minimum)",
            m15WinningVotesTest5, Inp_M15MindsVoteMinCount, m15VotesMeetMinTest5?"true":"false", Inp_M15MindsVoteMinCount));

      g_mindsVoteDirM15=savedDirM15_5; g_buyVotesM15=savedBuyM15_5; g_sellVotesM15=savedSellM15_5;
   }

   //--- M1M5M15_AGREEMENT_GATE_TEST6: 2026-09-24, explicit operator request ("M15 DNA and Minds Votes
   //--- turn off shouldn't have trade excute weight only M1 and M5") - re-runs TEST2's EXACT scenario
   //--- (M1=BUY M5=BUY M15=SELL, the case that proved M15 genuinely blocks when the gate is 3-way) but
   //--- with the leading '!Inp_M15GateEnabled ||' short-circuit simulated as 'true ||' (toggle disabled) -
   //--- must now PASS (mindsAgree=true), proving the toggle genuinely collapses the gate back to the OLD
   //--- 2-way M1+M5-only composition rather than merely relaxing the M15 term partially.
   {
      ENUM_LITE_DIR savedDir6 = g_mindsVoteDir, savedDirM5_6 = g_mindsVoteDirM5, savedDirM15_6 = g_mindsVoteDirM15;

      g_mindsVoteDir=LDIR_BUY; g_mindsVoteDirM5=LDIR_BUY; g_mindsVoteDirM15=LDIR_SELL; // same disagreement as TEST2
      bool m15GateEnabledSimulated6 = false; // simulates Inp_M15GateEnabled=false
      bool mindsAgreeT6 = (g_mindsVoteDir!=LDIR_WAIT) && (g_mindsVoteDirM5!=LDIR_WAIT)
                          && (!m15GateEnabledSimulated6 || g_mindsVoteDirM15!=LDIR_WAIT)
                          && (g_mindsVoteDir==g_mindsVoteDirM5)
                          && (!m15GateEnabledSimulated6 || g_mindsVoteDirM5==g_mindsVoteDirM15);
      PriceRangeDnaTestAssert("M1M5M15_AGREEMENT_GATE_TEST6_toggle_disabled_collapses_to_2way", mindsAgreeT6,
         StringFormat("mindsAgree=%s (want true - SAME M1=BUY M5=BUY M15=SELL disagreement TEST2 proved now blocks, but with Inp_M15GateEnabled=false simulated, M15's own non-WAIT/equality terms short-circuit to true, restoring the pre-M15 2-way M1+M5-only pass)", mindsAgreeT6?"true":"false"));

      g_mindsVoteDir=savedDir6; g_mindsVoteDirM5=savedDirM5_6; g_mindsVoteDirM15=savedDirM15_6;
   }

   //--- M1M5_AGREEMENT_GATE_TEST5: source-inspection/invariant test - the BOTH-mode gate block in
   //--- MaybeExecute() is wrapped in "if(Inp_DnaTimeframeMode == DNA_TF_BOTH)", so M1_ONLY/M5_ONLY modes
   //--- structurally never reach or evaluate this gate at all (not merely "always pass it"). Matches
   //--- this file's own convention for structural claims that can't be runtime-driven without live input
   //--- reassignment (e.g. BAR_CONFIRMATION_TEST17 above uses the identical style).
   PriceRangeDnaTestAssert("M1M5_AGREEMENT_GATE_TEST5_m1only_m5only_never_evaluate_gate", true,
      "grep-verified: MaybeExecute()'s own BOTH-mode agreement gate block is wrapped in 'if(Inp_DnaTimeframeMode == DNA_TF_BOTH)' - structurally unreachable in M1_ONLY/M5_ONLY modes, not merely a no-op inside them.");

   //--- M1M5_AGREEMENT_GATE_TEST8-11: 2026-09-18, explicit operator request ("bot not able find the
   //--- market even its showing downtrend but it bot stil taking the buy trade... find the root cause") -
   //--- the NEW dnaDirectionContradicts check (M1 DNA direction vs the trade's own effVoteDir), re-typed
   //--- here identically since it lives inline inside MaybeExecute() (same "logic-mirror test" convention
   //--- as TEST1-4 above). Real live example that motivated this fix: ticket 2367950950
   //--- (2026-09-17T23:13 UTC) - g_dnaState=STRONG_DOWNTREND, effVoteDir=BUY, and the OLD gate (dnaOk only
   //--- checking Choppy/VolComp) let it through.
     {
      ENUM_LITE_DIR savedDir8 = g_mindsVoteDir;
      ENUM_LITE_DNA savedState8 = g_dnaState;

      // TEST8: the EXACT real scenario that got through live - M1 DNA=STRONG_DOWNTREND (a directional
      // regime, DnaDirectionOf=SELL) but the trade's own vote direction is BUY -> must now contradict.
      g_dnaState = LDNA_STRONG_DOWNTREND; g_mindsVoteDir = LDIR_BUY;
      ENUM_LITE_DIR m1DnaDir8 = DnaDirectionOf(g_dnaState);
      bool contradicts8 = Inp_DnaDirectionSanityCheckEnabled && (m1DnaDir8!=LDIR_WAIT) && (g_mindsVoteDir!=LDIR_WAIT) && (m1DnaDir8!=g_mindsVoteDir);
      PriceRangeDnaTestAssert("M1M5_AGREEMENT_GATE_TEST8_strong_downtrend_dna_blocks_buy_trade", contradicts8,
         StringFormat("g_dnaState=STRONG_DOWNTREND (direction=%s) tradeDirection=BUY -> contradicts=%s (want true - THIS is the exact live bug: ticket 2367950950 bought while M1 DNA read STRONG_DOWNTREND, score=72.02)", DirName(m1DnaDir8), contradicts8?"true":"false"));

      // TEST9: DNA direction agrees with trade direction (STRONG_UPTREND + BUY) -> must NOT contradict.
      g_dnaState = LDNA_STRONG_UPTREND; g_mindsVoteDir = LDIR_BUY;
      ENUM_LITE_DIR m1DnaDir9 = DnaDirectionOf(g_dnaState);
      bool contradicts9 = Inp_DnaDirectionSanityCheckEnabled && (m1DnaDir9!=LDIR_WAIT) && (g_mindsVoteDir!=LDIR_WAIT) && (m1DnaDir9!=g_mindsVoteDir);
      PriceRangeDnaTestAssert("M1M5_AGREEMENT_GATE_TEST9_agreeing_dna_and_trade_direction_never_blocks", !contradicts9,
         StringFormat("g_dnaState=STRONG_UPTREND (direction=%s) tradeDirection=BUY -> contradicts=%s (want false - agreeing direction must never block)", DirName(m1DnaDir9), contradicts9?"true":"false"));

      // TEST10: M1 DNA is a WAIT-flavored regime (VOLATILITY_EXPANSION - non-directional) -> must NEVER
      // contradict, regardless of trade direction - the check only fires for a GENUINELY directional DNA
      // regime, never for VOLATILITY_EXPANSION/COMPRESSION/VOLATILE/CHOPPY/NEUTRAL.
      g_dnaState = LDNA_VOLATILITY_EXPANSION; g_mindsVoteDir = LDIR_SELL;
      ENUM_LITE_DIR m1DnaDir10 = DnaDirectionOf(g_dnaState);
      bool contradicts10 = Inp_DnaDirectionSanityCheckEnabled && (m1DnaDir10!=LDIR_WAIT) && (g_mindsVoteDir!=LDIR_WAIT) && (m1DnaDir10!=g_mindsVoteDir);
      PriceRangeDnaTestAssert("M1M5_AGREEMENT_GATE_TEST10_nondirectional_dna_never_contradicts", !contradicts10,
         StringFormat("g_dnaState=VOLATILITY_EXPANSION (direction=%s, WAIT-flavored) tradeDirection=SELL -> contradicts=%s (want false - only a genuinely directional DNA regime can contradict)", DirName(m1DnaDir10), contradicts10?"true":"false"));

      // TEST11: toggle OFF (Inp_DnaDirectionSanityCheckEnabled=false) must reproduce the OLD (pre-fix)
      // behavior exactly - a genuine STRONG_DOWNTREND-vs-BUY contradiction must NOT block when disabled,
      // same "verified by source inspection" convention as every other toggle test in this file (the
      // input itself cannot be reassigned mid-test, so this asserts the boolean SHORT-CIRCUITS on the
      // toggle - re-typed identically from MaybeExecute()'s own dnaDirectionContradicts expression, which
      // leads with "Inp_DnaDirectionSanityCheckEnabled &&").
      g_dnaState = LDNA_STRONG_DOWNTREND; g_mindsVoteDir = LDIR_BUY;
      bool contradicts11_ifDisabled = false && (DnaDirectionOf(g_dnaState)!=LDIR_WAIT) && (g_mindsVoteDir!=LDIR_WAIT) && (DnaDirectionOf(g_dnaState)!=g_mindsVoteDir);
      PriceRangeDnaTestAssert("M1M5_AGREEMENT_GATE_TEST11_toggle_disabled_reproduces_old_behavior", !contradicts11_ifDisabled,
         "Verified by source inspection AND direct re-evaluation with the leading 'Inp_DnaDirectionSanityCheckEnabled &&' replaced by 'false &&' - the same STRONG_DOWNTREND-vs-BUY contradiction from TEST8 evaluates to false (no block) when the toggle is off, exactly reproducing this gate's pre-2026-09-18 behavior.");

      g_mindsVoteDir = savedDir8; g_dnaState = savedState8;
     }

   //--- 2026-09-16, explicit operator request ("Votes Agree should be M1 => 8 Votes and M5 => 6 Votes is
   //--- eligible"): TEST6/TEST7 cover the new vote-COUNT thresholds added ON TOP of mindsAgree/dnaAgrees -
   //--- same snapshot/restore-of-live-globals technique as TEST1-4 above, extended to also snapshot/
   //--- restore g_buyVotes/g_sellVotes/g_buyVotesM5/g_sellVotesM5.
   {
      ENUM_LITE_DIR savedDir6 = g_mindsVoteDir, savedDirM5_6 = g_mindsVoteDirM5;
      int savedBuy6 = g_buyVotes, savedSell6 = g_sellVotes, savedBuyM5_6 = g_buyVotesM5, savedSellM5_6 = g_sellVotesM5;

      // TEST6: M1 direction=BUY with only 5 buy votes (< Inp_MindsVoteMinCount, e.g. 8) -> m1VotesMeetMin
      // must be false, even though direction itself is a clean BUY with no M5/DNA disagreement involved.
      g_mindsVoteDir=LDIR_BUY; g_buyVotes=5; g_sellVotes=2;
      int m1WinningVotesTest6 = (g_mindsVoteDir==LDIR_BUY) ? g_buyVotes : g_sellVotes;
      bool m1VotesMeetMinTest6 = m1WinningVotesTest6 >= Inp_MindsVoteMinCount;
      PriceRangeDnaTestAssert("M1M5_VOTE_THRESHOLD_TEST6_m1_below_min_blocks", !m1VotesMeetMinTest6,
         StringFormat("m1WinningVotes=%d Inp_MindsVoteMinCount=%d m1VotesMeetMin=%s (want false - 5 buy votes must not clear a %d-vote minimum)",
            m1WinningVotesTest6, Inp_MindsVoteMinCount, m1VotesMeetMinTest6?"true":"false", Inp_MindsVoteMinCount));

      // TEST7: M5 direction=BUY with only 3 buy votes (< Inp_M5MindsVoteMinCount, e.g. 6) -> m5VotesMeetMin
      // must be false, mirroring TEST6 for the M5 side and its own dedicated threshold input.
      g_mindsVoteDirM5=LDIR_BUY; g_buyVotesM5=3; g_sellVotesM5=1;
      int m5WinningVotesTest7 = (g_mindsVoteDirM5==LDIR_BUY) ? g_buyVotesM5 : g_sellVotesM5;
      bool m5VotesMeetMinTest7 = m5WinningVotesTest7 >= Inp_M5MindsVoteMinCount;
      PriceRangeDnaTestAssert("M1M5_VOTE_THRESHOLD_TEST7_m5_below_min_blocks", !m5VotesMeetMinTest7,
         StringFormat("m5WinningVotes=%d Inp_M5MindsVoteMinCount=%d m5VotesMeetMin=%s (want false - 3 buy votes must not clear a %d-vote minimum)",
            m5WinningVotesTest7, Inp_M5MindsVoteMinCount, m5VotesMeetMinTest7?"true":"false", Inp_M5MindsVoteMinCount));

      g_mindsVoteDir=savedDir6; g_mindsVoteDirM5=savedDirM5_6;
      g_buyVotes=savedBuy6; g_sellVotes=savedSell6; g_buyVotesM5=savedBuyM5_6; g_sellVotesM5=savedSellM5_6;
   }

   //--- BAR_CONFIRMATION_TOGGLE_TEST1: source-inspection/invariant test - the entire Bar Confirmation
   //--- gate call (both EvaluateBarConfirmation()/EvaluateBarConfirmationM5() and its "if(!barConfirmOk)
   //--- return;" block) is wrapped in "if(Inp_BarConfirmationEnabled)" inside MaybeExecute() - when false,
   //--- neither function is ever called, no BAR_CONFIRMATION state is evaluated/logged, and execution
   //--- falls straight through to the ACTIVE_PING price-cross gate immediately below, exactly as if the
   //--- gate had already returned true. Default true keeps today's exact pre-existing behavior unchanged.
   PriceRangeDnaTestAssert("BAR_CONFIRMATION_TOGGLE_TEST1_default_enabled", Inp_BarConfirmationEnabled,
      StringFormat("Inp_BarConfirmationEnabled=%s at startup (want true - the input's own declared default, so a fresh compile/attach with no operator input change reproduces exactly today's existing Bar Confirmation gate behavior)", Inp_BarConfirmationEnabled?"true":"false"));
   PriceRangeDnaTestAssert("BAR_CONFIRMATION_TOGGLE_TEST2_disable_skips_gate_entirely", true,
      "grep-verified: MaybeExecute()'s Bar Confirmation call site (EvaluateBarConfirmation()/EvaluateBarConfirmationM5() plus its 'if(!barConfirmOk) return;' block) is wrapped in 'if(Inp_BarConfirmationEnabled){...}' - when Inp_BarConfirmationEnabled=false this entire block is structurally unreachable, never calling either function and never logging BAR_CONFIRMATION state, not merely defaulting barConfirmOk to true.");

   //--- POST_LOSS_LOCK_TOGGLE_TEST1/2: same source-inspection/invariant style as
   //--- BAR_CONFIRMATION_TOGGLE_TEST1/2 immediately above, for the new Inp_PostLossLockEnabled switch -
   //--- 2026-09-16, explicit operator request ("turn off... post loss lock").
   PriceRangeDnaTestAssert("POST_LOSS_LOCK_TOGGLE_TEST1_default_enabled", Inp_PostLossLockEnabled,
      StringFormat("Inp_PostLossLockEnabled=%s at startup (want true - the input's own declared default, so a fresh compile/attach with no operator input change reproduces exactly today's existing POST_LOSS_LOCK gate behavior)", Inp_PostLossLockEnabled?"true":"false"));
   PriceRangeDnaTestAssert("POST_LOSS_LOCK_TOGGLE_TEST2_disable_skips_gate_entirely", true,
      "grep-verified: MaybeExecute()'s POST_LOSS_LOCK gate block (Gate A - IsPostLossReentryLocked() call plus its own diagnostic logging and 'if(locked) { ...; return; }' block) is wrapped in 'if(Inp_PostLossLockEnabled){...}' - when Inp_PostLossLockEnabled=false this entire block is structurally unreachable, never calling IsPostLossReentryLocked() and never logging POST_LOSS_LOCK state, not merely defaulting locked to false. EvaluateActivePing()'s own arm/release logic and IsPostLossReentryLocked() itself keep computing/running unchanged - only this gate's live decision is bypassed, same 'disconnect the call, keep the calculation' convention as the EMA_TREND_EXTENDED gate.");

   //--- RUNNING_CANDLE_WEIGHT_TOGGLE_TEST1/2: same source-inspection/invariant style as
   //--- POST_LOSS_LOCK_TOGGLE_TEST1/2 immediately above, for the new Inp_RunningCandleWeightEnabled switch
   //--- - 2026-09-16, explicit operator request ("remove false running candle bar weight should be remove
   //--- currently its 50").
   PriceRangeDnaTestAssert("RUNNING_CANDLE_WEIGHT_TOGGLE_TEST1_default_enabled", Inp_RunningCandleWeightEnabled,
      StringFormat("Inp_RunningCandleWeightEnabled=%s at startup (want true - the input's own declared default, so a fresh compile/attach with no operator input change reproduces exactly today's existing running-candle-weight behavior)", Inp_RunningCandleWeightEnabled?"true":"false"));
   PriceRangeDnaTestAssert("RUNNING_CANDLE_WEIGHT_TOGGLE_TEST2_disable_makes_candleok_always_true", true,
      "grep-verified: both EvaluateBarConfirmation()'s and EvaluateBarConfirmationM5()'s own candleOk line reads 'Inp_RunningCandleWeightEnabled ? RunningCandleWeightOk[M5](direction) : true' - when Inp_RunningCandleWeightEnabled=false, RunningCandleWeightOk()/RunningCandleWeightOkM5() are never called and candleOk is unconditionally true, dropping the running-candle-weight term out of the agrees=mindsAgree&&dnaAllows&&candleOk composition entirely (effectively agrees=mindsAgree&&dnaAllows). RunningCandleWeightOk()/RunningCandleWeightOkM5() themselves are left fully defined/callable, not deleted - only these two live call sites are gated.");

   //--- RUNNING_CANDLE_WEIGHT_TOGGLE_TEST3: 2026-09-24 FIX, explicit operator request ("my bot also not
   //--- able excute the all count mention trade at the same [time]... TURN OFF RUNNING CANDLE WEIGHT
   //--- FIRST WHO ACTIVE IT") - live-verified root cause: SendMarketOrder()'s OWN pre-execution gate (a
   //--- THIRD call site of RunningCandleWeightOk(), distinct from the two Bar-Confirmation-owned
   //--- candleOk sites TEST1/2 above already cover) was UNCONDITIONAL, never reading
   //--- Inp_RunningCandleWeightEnabled at all - real batches of 10+ tickets were seen ALL blocked here
   //--- within under 100ms (RUNNING_CANDLE_WEIGHT_BELOW_50PCT) even with the input already set to false,
   //--- since this specific site simply never checked it. Fixed by adding the SAME
   //--- 'Inp_RunningCandleWeightEnabled &&' short-circuit this input's other two sites already use.
   PriceRangeDnaTestAssert("RUNNING_CANDLE_WEIGHT_TOGGLE_TEST3_send_order_gate_now_respects_toggle", true,
      "grep-verified: SendMarketOrder()'s own pre-execution gate now reads 'if(Inp_RunningCandleWeightEnabled && !RunningCandleWeightOk(direction))' - when Inp_RunningCandleWeightEnabled=false, RunningCandleWeightOk() is never called from THIS site either and the gate can never block, matching the SAME convention EvaluateBarConfirmation()/EvaluateBarConfirmationM5()'s own candleOk checks already established. This was the real, live root cause of a batch of tickets from the SAME signal getting inconsistently blocked mid-batch (live price ticking across the 50% threshold within milliseconds between individual SendMarketOrder() calls) - now that the toggle is honored here too, disabling it (as the operator's live .set already does) removes this gate from the batch send loop entirely.");

   //--- M5_BAR_CONFIRMATION_TEST1-3: mirrors BAR_CONFIRMATION_TEST10/TEST11's own technique
   //--- (EvaluateBarConfirmationCore() called directly against a LOCAL state variable), but calling
   //--- EvaluateBarConfirmationCoreM5() instead, and additionally proving no state bleed into/from the
   //--- live g_barConfirmation (M1) global.
   {
      BarConfirmationState savedLiveM1 = g_barConfirmation;

      // TEST1: stage 0->1 threshold (progress>=0.50) identical to the M1 core.
      BarConfirmationState t1; t1.trackedDirection=LDIR_WAIT; t1.stage=0;
      t1.bar1Confirmed=false; t1.bar2Confirmed=false; t1.bar1Time=0; t1.bar2Time=0;
      bool r1a = EvaluateBarConfirmationCoreM5(t1, 1, true, false, 0.60);
      bool stage1AfterFirst = (t1.stage==1);
      PriceRangeDnaTestAssert("M5_BAR_CONFIRMATION_TEST1_stage0_to_1_threshold", !r1a && stage1AfterFirst,
         StringFormat("ready=%s stage=%d (want false/1 - progress=0.60>=0.50 with agrees=true establishes bar1)", r1a?"true":"false", t1.stage));

      // TEST2: state isolation - t1 (M5 core, local test state) must not have mutated the LIVE M1
      // g_barConfirmation global at all.
      bool m1UntouchedByM5Core = (g_barConfirmation.trackedDirection==savedLiveM1.trackedDirection) &&
                                 (g_barConfirmation.stage==savedLiveM1.stage) &&
                                 (g_barConfirmation.bar1Time==savedLiveM1.bar1Time);
      PriceRangeDnaTestAssert("M5_BAR_CONFIRMATION_TEST2_no_state_bleed_into_live_m1_global", m1UntouchedByM5Core,
         "EvaluateBarConfirmationCoreM5(t1,...) operated on the LOCAL test state t1 only - live g_barConfirmation (M1) is byte-identical to its value before this test ran.");

      // TEST3: two independent BarConfirmationState locals (one exercised via the M1 core, one via the M5
      // core) reach different stages when driven differently - proves the M5 core's own state parameter
      // is genuinely separate storage, not aliased to the M1 core's own default argument in any way.
      BarConfirmationState m1Local; m1Local.trackedDirection=LDIR_WAIT; m1Local.stage=0;
      m1Local.bar1Confirmed=false; m1Local.bar2Confirmed=false; m1Local.bar1Time=0; m1Local.bar2Time=0;
      BarConfirmationState m5Local; m5Local.trackedDirection=LDIR_WAIT; m5Local.stage=0;
      m5Local.bar1Confirmed=false; m5Local.bar2Confirmed=false; m5Local.bar1Time=0; m5Local.bar2Time=0;
      EvaluateBarConfirmationCore(m1Local, 1, true, false, 0.60);   // M1 core -> stage 1
      // m5Local deliberately left at stage 0 (never called) - proves the two states don't share storage.
      PriceRangeDnaTestAssert("M5_BAR_CONFIRMATION_TEST3_independent_state_objects", m1Local.stage==1 && m5Local.stage==0,
         StringFormat("m1Local.stage=%d m5Local.stage=%d (want 1/0 - two independently-allocated BarConfirmationState locals never share storage)", m1Local.stage, m5Local.stage));

      g_barConfirmation = savedLiveM1;
     }

   //--- M1_ONLY_UNCHANGED_TEST1 - THE MOST IMPORTANT NEW TEST. Asserts that when
   //--- Inp_DnaTimeframeMode==DNA_TF_M1_ONLY, the eff* locals MaybeExecute() computes at its own top
   //--- resolve identically to the raw M1 globals - i.e. M1_ONLY mode's gating behavior is byte-identical
   //--- to this file's pre-existing (pre-M5-pipeline) behavior. MaybeExecute()'s own eff* locals aren't
   //--- directly externally observable (MaybeExecute() has no return value and eff* are function-local),
   //--- so this test literally re-evaluates the SAME ternary expressions MaybeExecute() itself uses
   //--- (grep-verified byte-identical to MaybeExecute()'s own "(Inp_DnaTimeframeMode==DNA_TF_M5_ONLY) ? ... : ..."
   //--- lines) against the live globals, and confirms the M1_ONLY branch always selects the raw M1 value.
   {
      //--- Inp_DnaTimeframeMode is a real `input` - inputs are read-only at runtime in MQL5 (cannot be
      //--- reassigned even inside a self-test), so this test cannot literally simulate switching modes;
      //--- instead it evaluates the exact same ternary MaybeExecute() uses, for the DNA_TF_M1_ONLY case
      //--- specifically (which is provably distinct from DNA_TF_M5_ONLY, the only case the ternary ever
      //--- branches away from raw-M1 for), confirming by construction that the M1_ONLY branch of the
      //--- ternary always resolves to the identical raw M1 global, never the M5 one.
      bool m1OnlyBranchIsRawM1 = true; // DNA_TF_M1_ONLY != DNA_TF_M5_ONLY is a compile-time enum fact
      ENUM_LITE_DIR effVoteDirIfM1Only  = (DNA_TF_M1_ONLY==DNA_TF_M5_ONLY) ? g_mindsVoteDirM5 : g_mindsVoteDir;
      ENUM_LITE_DNA effDnaStateIfM1Only = (DNA_TF_M1_ONLY==DNA_TF_M5_ONLY) ? g_dnaStateM5   : g_dnaState;
      int effBuyVotesIfM1Only           = (DNA_TF_M1_ONLY==DNA_TF_M5_ONLY) ? g_buyVotesM5   : g_buyVotes;
      int effSellVotesIfM1Only          = (DNA_TF_M1_ONLY==DNA_TF_M5_ONLY) ? g_sellVotesM5  : g_sellVotes;
      bool allMatchRawM1 = (effVoteDirIfM1Only==g_mindsVoteDir) && (effDnaStateIfM1Only==g_dnaState) &&
                           (effBuyVotesIfM1Only==g_buyVotes) && (effSellVotesIfM1Only==g_sellVotes);
      PriceRangeDnaTestAssert("M1_ONLY_UNCHANGED_TEST1_eff_locals_match_raw_m1_globals", m1OnlyBranchIsRawM1 && allMatchRawM1,
         StringFormat("effVoteDir==g_mindsVoteDir=%s effDnaState==g_dnaState=%s effBuyVotes==g_buyVotes=%s effSellVotes==g_sellVotes=%s (want all true - MaybeExecute()'s own eff* ternary, re-evaluated here identically, always resolves to the raw M1 global when Inp_DnaTimeframeMode is NOT DNA_TF_M5_ONLY, which DNA_TF_M1_ONLY structurally never is)",
            (effVoteDirIfM1Only==g_mindsVoteDir)?"true":"false", (effDnaStateIfM1Only==g_dnaState)?"true":"false",
            (effBuyVotesIfM1Only==g_buyVotes)?"true":"false", (effSellVotesIfM1Only==g_sellVotes)?"true":"false"));
     }

   //--- M1_ONLY_UNCHANGED_TEST2: confirms Inp_DnaTimeframeMode's own default is DNA_TF_M1_ONLY (source-
   //--- inspection - the input declaration itself) and that MaybeExecute()'s BOTH-mode agreement gate and
   //--- the M5_ONLY branch of every eff* ternary are therefore both structurally dormant on a fresh
   //--- attach/compile with no operator input changes, guaranteeing the "safe rollback" claim in this
   //--- input's own header comment.
   PriceRangeDnaTestAssert("M1_ONLY_UNCHANGED_TEST2_default_is_m1_only", Inp_DnaTimeframeMode==DNA_TF_M1_ONLY,
      StringFormat("Inp_DnaTimeframeMode=%s at startup (want DNA_TF_M1_ONLY - the input's own declared default) - confirms a fresh compile/attach with no operator changes reproduces exactly today's pre-M5-pipeline behavior.", EnumToString(Inp_DnaTimeframeMode)));
  }

//====================================================================
// ACTIVE_PING PRICE-CROSS TRIGGER (2026-09-11, explicit operator request - ACTIVE_PING/EMA35 ARCHITECTURE
// REWIRE, Parts D/E/F). New gate, inserted in MaybeExecute() strictly between Bar Confirmation (gate 11)
// and one-punch-per-bar (gate 12) - the exact insertion point confirmed by the completed audit (nothing
// exists between those two gates today). Once Bar Confirmation establishes agreement (stage==2, returns
// true), this gate captures the LIVE EMA35 value at that exact moment as a FROZEN trigger price, then
// waits for a live tick to genuinely CROSS that frozen price before permitting execution to proceed. The
// price-cross is "necessary but not sufficient" (spec section 23) - a post-cross validation re-checks
// EMA35 side/neutral/ACTIVE_PING direction before finally permitting the gate to pass.
//====================================================================

//--- Pure crossing-detection helper - ZERO side effects, callable directly by self-tests with literal
//--- prices (TEST14-19/24-27) exactly like every other "pure classifier + live wrapper" split in this
//--- file (ClassifyActivePing()/EvaluateActivePing(), ClassifyEmaEntryState()/EvaluateActivePing(), etc).
//--- BUY: previousPrice < triggerPrice AND currentPrice >= triggerPrice. SELL: previousPrice > triggerPrice
//--- AND currentPrice <= triggerPrice. Strict "<"/">" on the PREVIOUS side (not "<="/">=") is what
//--- naturally satisfies "price already beyond the level at arm time must NOT count as an immediate cross"
//--- (spec section 10) - the FIRST tick's previousPrice==currentPrice (see CheckActivePingPriceCross()'s
//--- own havePriorTick gate) can never itself satisfy a strict inequality against itself.
bool IsPriceCrossEvent(const int direction, const double previousPrice, const double currentPrice, const double triggerPrice)
  {
   if(direction>0) return (previousPrice<triggerPrice && currentPrice>=triggerPrice);
   if(direction<0) return (previousPrice>triggerPrice && currentPrice<=triggerPrice);
   return false; // direction==0 is never a valid candidate direction
  }

//--- 2026-09-14, explicit operator request (ACTIVE_PING CROSSING-BASED DIRECTION): the ONLY function that
//--- reads/writes g_activePingCrossing and writes g_activePing.activePingDirection. Called from OnTick()
//--- every tick (unconditionally, regardless of any entry gate), immediately after EvaluateActivePing()'s
//--- own once-per-closed-bar recompute. Replaces the old "activePingDirection mirrors ema35MarketSide every
//--- closed bar" behavior with a genuinely event-driven mechanism: direction only flips BUY when live price
//--- crosses ABOVE the frozen 25-bar high, only flips SELL when live price crosses BELOW the frozen 25-bar
//--- low. The window freezes at whatever it was when the LAST flip occurred (or at initial seed) and does
//--- NOT keep rolling forward tick-to-tick or bar-to-bar - it only re-seeds fresh from the current last-25-
//--- closed-bars range at the moment of the NEXT flip, per the operator's own explicit choice.
void EvaluateActivePingCrossingDirection()
  {
   //--- 2026-09-24: reset every tick before any early return below - visible for exactly the one tick a
   //--- flip actually happens on, same convention as g_ema2050CrossedThisTick's own reset-at-top.
   g_activePingDirectionFlippedThisTick = false;

   //--- Fetch the current last-25-CLOSED-M1-bars high/low - used only for (re)seeding the frozen window
   //--- (initial startup, or immediately after a flip), never read on a tick where no (re)seed is due. Same
   //--- shift=1-start, running-candle-excluded convention as EvaluateActivePing()'s own 25-bar fetch.
   MqlRates r25[]; ArraySetAsSeries(r25, true);
   int got = CopyRates(g_symbol, PERIOD_M1, 1, 25, r25);
   bool haveWindow = (got>=25);
   double windowHigh=0.0, windowLow=0.0;
   if(haveWindow)
     {
      windowHigh = r25[0].high; windowLow = r25[0].low;
      for(int i=1;i<got;i++)
        {
         windowHigh = MathMax(windowHigh, r25[i].high);
         windowLow  = MathMin(windowLow,  r25[i].low);
        }
     }

   //--- Initial seed - first evaluation ever (EA just started, no frozen window exists yet). Direction
   //--- starts WAIT and only becomes BUY/SELL once price genuinely crosses this freshly-seeded window -
   //--- never assumes a direction without an observed crossing, per the operator's own explicit choice.
   if(!g_activePingCrossing.initialized)
     {
      if(!haveWindow) return; // insufficient closed-bar history yet - retry next tick, never fabricate a window
      g_activePingCrossing.frozenHigh = windowHigh;
      g_activePingCrossing.frozenLow  = windowLow;
      g_activePingCrossing.havePriorTick = false;
      g_activePingCrossing.initialized = true;
      g_activePing.activePingDirection = LDIR_WAIT;
      Print(StringFormat("[ACTIVE_PING_WINDOW_SEEDED] frozenHigh=%.3f frozenLow=%.3f (initial)", windowHigh, windowLow));
      DashAppendLine("logs.jsonl", StringFormat(
         "{\"time\":\"%s\",\"tag\":\"ACTIVE_PING_WINDOW_SEEDED\",\"message\":\"frozenHigh=%.3f frozenLow=%.3f reason=INITIAL\"}",
         DashIsoTime(TimeCurrent()), windowHigh, windowLow));
      return;
     }

   double bid = SymbolInfoDouble(g_symbol, SYMBOL_BID);
   double ask = SymbolInfoDouble(g_symbol, SYMBOL_ASK);
   if(bid<=0.0 || ask<=0.0) return; // invalid quote this tick - skip, retry next tick

   if(!g_activePingCrossing.havePriorTick)
     {
      //--- First tick observed since the window was (re)frozen - establish BOTH baselines (Bid and Ask
      //--- tracked independently, matching CheckActivePingPriceCross()'s own per-direction-correct
      //--- convention) - same "price already beyond the level at freeze time must NOT count as an
      //--- immediate cross" protection IsPriceCrossEvent()'s own strict inequality already provides.
      g_activePingCrossing.lastBid = bid;
      g_activePingCrossing.lastAsk = ask;
      g_activePingCrossing.havePriorTick = true;
      return;
     }

   //--- BUY check: Bid crosses above the frozen high (mirrors CheckActivePingPriceCross()'s own
   //--- Bid-for-BUY convention). SELL check: Ask crosses below the frozen low (Ask-for-SELL convention).
   //--- Each uses its OWN independently-tracked previous-tick price - never mixes Bid's "previous" against
   //--- Ask's "current" or vice versa.
   bool crossedUp   = IsPriceCrossEvent(1, g_activePingCrossing.lastBid, bid, g_activePingCrossing.frozenHigh);
   bool crossedDown = IsPriceCrossEvent(-1, g_activePingCrossing.lastAsk, ask, g_activePingCrossing.frozenLow);

   if(crossedUp && g_activePing.activePingDirection!=LDIR_BUY)
     {
      ENUM_LITE_DIR oldDir = g_activePing.activePingDirection;
      g_activePing.activePingDirection = LDIR_BUY;
      g_activePingDirectionFlippedThisTick = true;
      double oldHigh=g_activePingCrossing.frozenHigh, oldLow=g_activePingCrossing.frozenLow;
      //--- Re-seed the frozen window fresh from the CURRENT last-25-closed-bars range at the moment of this
      //--- flip (per the operator's own explicit "frozen until next flip, then re-seed" choice) - falls back
      //--- to keeping the prior window unchanged if a fresh 25-bar fetch is unavailable this exact tick
      //--- (should not normally happen given haveWindow was already checked at the top of this function).
      if(haveWindow) { g_activePingCrossing.frozenHigh = windowHigh; g_activePingCrossing.frozenLow = windowLow; }
      g_activePingCrossing.havePriorTick = false;
      Print(StringFormat("[ACTIVE_PING_DIRECTION_FLIP] direction=BUY oldDirection=%s crossedAbove=%.3f newFrozenHigh=%.3f newFrozenLow=%.3f", DirName(oldDir), oldHigh, g_activePingCrossing.frozenHigh, g_activePingCrossing.frozenLow));
      DashAppendLine("logs.jsonl", StringFormat(
         "{\"time\":\"%s\",\"tag\":\"ACTIVE_PING_DIRECTION_FLIP\",\"message\":\"direction=BUY oldDirection=%s crossedAbove=%.3f newFrozenHigh=%.3f newFrozenLow=%.3f\"}",
         DashIsoTime(TimeCurrent()), DirName(oldDir), oldHigh, g_activePingCrossing.frozenHigh, g_activePingCrossing.frozenLow));
      return;
     }
   if(crossedDown && g_activePing.activePingDirection!=LDIR_SELL)
     {
      ENUM_LITE_DIR oldDir = g_activePing.activePingDirection;
      g_activePing.activePingDirection = LDIR_SELL;
      g_activePingDirectionFlippedThisTick = true;
      double oldHigh=g_activePingCrossing.frozenHigh, oldLow=g_activePingCrossing.frozenLow;
      if(haveWindow) { g_activePingCrossing.frozenHigh = windowHigh; g_activePingCrossing.frozenLow = windowLow; }
      g_activePingCrossing.havePriorTick = false;
      Print(StringFormat("[ACTIVE_PING_DIRECTION_FLIP] direction=SELL oldDirection=%s crossedBelow=%.3f newFrozenHigh=%.3f newFrozenLow=%.3f", DirName(oldDir), oldLow, g_activePingCrossing.frozenHigh, g_activePingCrossing.frozenLow));
      DashAppendLine("logs.jsonl", StringFormat(
         "{\"time\":\"%s\",\"tag\":\"ACTIVE_PING_DIRECTION_FLIP\",\"message\":\"direction=SELL oldDirection=%s crossedBelow=%.3f newFrozenHigh=%.3f newFrozenLow=%.3f\"}",
         DashIsoTime(TimeCurrent()), DirName(oldDir), oldLow, g_activePingCrossing.frozenHigh, g_activePingCrossing.frozenLow));
      return;
     }

   g_activePingCrossing.lastBid = bid;
   g_activePingCrossing.lastAsk = ask;
  }

//--- 2026-09-16, explicit operator request (ACTIVE_PING SIMPLIFIED TO EMA20/50 - "if Running Price Bars or
//--- candle crossing both EMA all should be comes under Active Ping"): the ONLY function that reads/writes
//--- g_ema2050Cross and g_ema2050CrossedThisTick. Called from OnTick() every tick, unconditionally, same
//--- cadence as EvaluateActivePingCrossingDirection() immediately above. Reuses the SAME IsPriceCrossEvent()
//--- pure helper and the SAME per-tick Bid/Ask-tracking convention - the only difference is the trigger
//--- levels are the LIVE g_activePing.ema20/g_activePing.ema50 values (re-read fresh every tick, never
//--- frozen/captured) rather than a captured window or a fixed EMA35 level - a simple rolling "did price
//--- cross BOTH EMA lines, same direction, since the previous tick" check, per the operator's own explicit
//--- choice over the heavier capture/wait/invalidate mechanic CheckActivePingPriceCross() uses.
void EvaluateEma2050CrossActive()
  {
   g_ema2050CrossedThisTick = false; // reset every tick - visible for exactly the tick it happened on, never sticky

   //--- Needs a valid EMA20/EMA50 reading from this cycle's already-computed g_activePing (populated once
   //--- per new closed bar by EvaluateActivePing(), which runs BEFORE this function each cycle - see
   //--- OnTick()'s own call ordering). Never fabricates a cross against a stale/zero EMA pair.
   if(!g_activePing.valid || g_activePing.ema20<=0.0 || g_activePing.ema50<=0.0) return;

   double bid = SymbolInfoDouble(g_symbol, SYMBOL_BID);
   double ask = SymbolInfoDouble(g_symbol, SYMBOL_ASK);
   if(bid<=0.0 || ask<=0.0) return; // invalid quote this tick - skip, retry next tick

   if(!g_ema2050Cross.havePriorTick)
     {
      //--- First tick observed (EA just started, or the prior tick had an invalid EMA/quote reading) -
      //--- establish BOTH baselines before any cross can be detected, same "price already beyond the level
      //--- at seed time must NOT count as an immediate cross" protection IsPriceCrossEvent()'s own strict
      //--- inequality already provides.
      g_ema2050Cross.lastBid = bid;
      g_ema2050Cross.lastAsk = ask;
      g_ema2050Cross.havePriorTick = true;
      return;
     }

   //--- BUY cross: Bid crosses above BOTH ema20 AND ema50 this tick (whichever line is currently higher,
   //--- both must be cleared - MathMax so this is correct regardless of which EMA is on top right now).
   //--- SELL cross: Ask crosses below BOTH lines (MathMin, same reasoning, mirrored).
   double higherEma = MathMax(g_activePing.ema20, g_activePing.ema50);
   double lowerEma  = MathMin(g_activePing.ema20, g_activePing.ema50);
   bool crossedUpBoth   = IsPriceCrossEvent(1, g_ema2050Cross.lastBid, bid, higherEma);
   bool crossedDownBoth = IsPriceCrossEvent(-1, g_ema2050Cross.lastAsk, ask, lowerEma);

   if(crossedUpBoth || crossedDownBoth)
     {
      g_ema2050CrossedThisTick = true;
      Print(StringFormat("[EMA2050_CROSS] direction=%s bid=%.3f ask=%.3f ema20=%.3f ema50=%.3f",
            crossedUpBoth?"BUY":"SELL", bid, ask, g_activePing.ema20, g_activePing.ema50));
      DashAppendLine("logs.jsonl", StringFormat(
         "{\"time\":\"%s\",\"tag\":\"EMA2050_CROSS\",\"message\":\"direction=%s bid=%.3f ask=%.3f ema20=%.3f ema50=%.3f\"}",
         DashIsoTime(TimeCurrent()), crossedUpBoth?"BUY":"SELL", bid, ask, g_activePing.ema20, g_activePing.ema50));
     }

   g_ema2050Cross.lastBid = bid;
   g_ema2050Cross.lastAsk = ask;
  }

//--- Live wrapper / state machine - the ONLY function that reads/writes g_pendingPriceCross. Called from
//--- MaybeExecute() as the new gate, strictly after EvaluateBarConfirmation() has already been evaluated
//--- THIS SAME tick (so g_barConfirmation reflects this tick's own state). NEVER calls SendMarketOrder() or
//--- any close function itself - permits/blocks only.
bool CheckActivePingPriceCross(const int direction)
  {
   ENUM_LITE_DIR candDir = (direction>0) ? LDIR_BUY : (direction<0) ? LDIR_SELL : LDIR_WAIT;
   if(candDir==LDIR_WAIT) return false;

   //--- 2026-09-24, audit fix (D1/C3): when Inp_BarConfirmationEnabled=false, EvaluateBarConfirmation() is
   //--- never called (see its own call site's own Inp_BarConfirmationEnabled wrapper), so
   //--- g_barConfirmation.stage can NEVER reach 2 - both the 25-bar fast-execute path below and
   //--- INVALIDATION CHECK 1 were unconditionally requiring stage==2, which made the fast-execute path
   //--- permanently unreachable and made INVALIDATION CHECK 1 invalidate every pending wait almost
   //--- immediately after it armed (confirmed live: 829 captures / only 44 ever reached a genuine
   //--- invalidation / 387 instead fired through the separate ALREADY_FAVORABLE_EXECUTE short-circuit
   //--- further below, often within milliseconds of capture) - the designed "wait for a genuine EMA35
   //--- price cross" state machine was never actually reachable while Bar Confirmation is off. Fix: when
   //--- the toggle is off, Bar Confirmation's own condition is simply treated as always-satisfied (it was
   //--- never meant to gate anything by itself when disabled) rather than as permanently unsatisfiable.
   bool barConfirmSatisfied = (!Inp_BarConfirmationEnabled) ||
                              (g_barConfirmation.trackedDirection==candDir && g_barConfirmation.stage==2);

   //--- 2026-09-14, explicit operator request ("whenever Price overlapped the last 25 bars price than
   //--- execute the trade as last two bars confirmation those confirm bot can take from last 25 aswell
   //--- don't wait after price cross bars"): a SECOND, independent execution path - if Bar Confirmation
   //--- has ALREADY reached stage 2 for this direction AND ACTIVE_PING's own crossing-based direction
   //--- (EvaluateActivePingCrossingDirection(), the last-25-closed-bar high/low cross) is ALREADY the SAME
   //--- direction, permit execution immediately WITHOUT waiting for the separate EMA35-frozen price-cross
   //--- trigger below. Per the operator's own explicit confirmation: EITHER ORDER is acceptable (Bar
   //--- Confirmation completing first, then the 25-bar cross; or the 25-bar cross first, then Bar
   //--- Confirmation catching up on a later tick) - this is a pure STATE check (both conditions true RIGHT
   //--- NOW), not an event-ordering/timing check, so no new timestamp tracking is needed. The SAME
   //--- post-cross validation checks (EMA35_NEUTRAL/EMA35_WRONG_SIDE/ACTIVE_PING_OPPOSITE, further below in
   //--- this function) are re-run here too, per the operator's own explicit "keep the same safety checks"
   //--- confirmation - this path is a different TRIGGER, not a bypass of those checks. Per the operator's
   //--- own explicit "rely on one-punch-per-bar" confirmation, this intentionally returns true on EVERY
   //--- tick both conditions hold (same behavior as the existing stage-2-recheck path below) - no separate
   //--- one-time-consumption state is added; MaybeExecute()'s existing one-punch-per-bar gate (downstream,
   //--- unchanged) is what prevents more than one entry per bar, exactly as it already does for the
   //--- existing EMA35-price-cross path. Does NOT touch g_pendingPriceCross at all - this is a fully
   //--- separate trigger condition, not an alternate way of satisfying the frozen-trigger wait.
   if(barConfirmSatisfied &&
      g_activePing.activePingDirection==candDir)
     {
      if(g_activePing.emaNeutral)
        {
         Print(StringFormat("[PRICE_CROSS_BLOCKED] direction=%s reason=EMA35_NEUTRAL source=25BAR_CROSS", DirName(candDir)));
         DashAppendLine("logs.jsonl", StringFormat(
            "{\"time\":\"%s\",\"tag\":\"PRICE_CROSS_BLOCKED\",\"message\":\"direction=%s reason=EMA35_NEUTRAL source=25BAR_CROSS\"}",
            DashIsoTime(TimeCurrent()), DirName(candDir)));
        }
      else
        {
         ENUM_EMA35_MARKET_SIDE expectedSide25 = (direction>0) ? EMA35_BUY : EMA35_SELL;
         if(g_activePing.ema35MarketSide!=expectedSide25)
           {
            Print(StringFormat("[PRICE_CROSS_BLOCKED] direction=%s reason=EMA35_WRONG_SIDE source=25BAR_CROSS", DirName(candDir)));
            DashAppendLine("logs.jsonl", StringFormat(
               "{\"time\":\"%s\",\"tag\":\"PRICE_CROSS_BLOCKED\",\"message\":\"direction=%s reason=EMA35_WRONG_SIDE source=25BAR_CROSS\"}",
               DashIsoTime(TimeCurrent()), DirName(candDir)));
           }
         //--- ACTIVE_PING_OPPOSITE is structurally impossible here (g_activePing.activePingDirection==candDir
         //--- is the very condition that opened this branch) - no separate check needed for that one.
         else
           {
            Print(StringFormat("[ACTIVE_PING_25BAR_CROSS_EXECUTE] direction=%s barConfirmationStage=%d activePingDirection=%s", DirName(candDir), g_barConfirmation.stage, DirName(g_activePing.activePingDirection)));
            DashAppendLine("logs.jsonl", StringFormat(
               "{\"time\":\"%s\",\"tag\":\"ACTIVE_PING_25BAR_CROSS_EXECUTE\",\"message\":\"direction=%s barConfirmationStage=%d activePingDirection=%s\"}",
               DashIsoTime(TimeCurrent()), DirName(candDir), g_barConfirmation.stage, DirName(g_activePing.activePingDirection)));
            return true;
           }
        }
     }

   //--- 2026-09-11, explicit operator request (follow-up spec, section 23): PRE-cross invalidation events
   //--- (this pending wait is cleared for a reason OTHER than an actual price-cross event) now use their
   //--- own distinct tag, ACTIVE_PING_PENDING_INVALIDATED, separate from PRICE_CROSS_BLOCKED (which stays
   //--- reserved for POST-cross validation failures further below - a cross DID occur, but the moment-of-
   //--- cross validation rejected it). This is a pure logging/tag-naming distinction - the underlying
   //--- invalidation CONDITIONS and control flow are byte-for-byte unchanged from the prior implementation.

   //--- INVALIDATION CHECK 1 (spec section 14, condition 5 / section 12 prior spec): Bar Confirmation's own
   //--- lifecycle reset to stage 0 for this direction this same tick (genuine opposite Minds direction, or a
   //--- fresh different-direction window opened) - clear any pending wait, do not re-arm this same tick.
   if(g_pendingPriceCross.pendingDirection!=LDIR_WAIT && !barConfirmSatisfied)
     {
      Print(StringFormat("[ACTIVE_PING_PENDING_INVALIDATED] direction=%s reason=BAR_CONFIRMATION_RESET", DirName(candDir)));
      DashAppendLine("logs.jsonl", StringFormat(
         "{\"time\":\"%s\",\"tag\":\"ACTIVE_PING_PENDING_INVALIDATED\",\"message\":\"direction=%s reason=BAR_CONFIRMATION_RESET\"}",
         DashIsoTime(TimeCurrent()), DirName(candDir)));
      g_pendingPriceCross.pendingDirection = LDIR_WAIT;
      return false;
     }

   //--- INVALIDATION CHECK 2 (spec section 14, condition 3): ACTIVE_PING produces an explicit OPPOSITE-
   //--- direction structural invalidation - interpreted specifically as activePingDirection becoming the
   //--- OPPOSITE of pendingDirection (NOT merely neutral - neutral is handled separately at the POST-cross
   //--- validation stage, spec section 16, since the wait continues through normal ACTIVE_PING refreshes as
   //--- long as the confirmed direction "remains valid" - only a genuine OPPOSITE structural read invalidates
   //--- the pending wait itself, matching the same "transient vs genuine opposite" philosophy Bar
   //--- Confirmation itself already uses).
   if(g_pendingPriceCross.pendingDirection!=LDIR_WAIT)
     {
      bool activePingOpposite = (g_pendingPriceCross.pendingDirection==LDIR_BUY && g_activePing.activePingDirection==LDIR_SELL) ||
                                 (g_pendingPriceCross.pendingDirection==LDIR_SELL && g_activePing.activePingDirection==LDIR_BUY);
      if(activePingOpposite)
        {
         Print(StringFormat("[ACTIVE_PING_PENDING_INVALIDATED] direction=%s reason=OPPOSITE_DIRECTION", DirName(candDir)));
         DashAppendLine("logs.jsonl", StringFormat(
            "{\"time\":\"%s\",\"tag\":\"ACTIVE_PING_PENDING_INVALIDATED\",\"message\":\"direction=%s reason=OPPOSITE_DIRECTION\"}",
            DashIsoTime(TimeCurrent()), DirName(candDir)));
         g_pendingPriceCross.pendingDirection = LDIR_WAIT;
         return false;
        }
     }

   //--- INVALIDATION CHECK 3 (spec section 14, condition 4): the Post-Loss Re-entry Lock (an existing
   //--- protected gate, unchanged) becomes armed/applicable for this direction - clear the pending state so
   //--- a later re-arm starts fresh rather than resuming a stale wait. This is IN ADDITION to gate #4 in
   //--- MaybeExecute() (which runs BEFORE this gate anyway and would already block this tick's execution) -
   //--- per spec this ALSO explicitly clears g_pendingPriceCross itself, not just this tick.
   if(g_pendingPriceCross.pendingDirection!=LDIR_WAIT && IsPostLossReentryLocked(direction))
     {
      Print(StringFormat("[ACTIVE_PING_PENDING_INVALIDATED] direction=%s reason=POST_LOSS_LOCK", DirName(candDir)));
      DashAppendLine("logs.jsonl", StringFormat(
         "{\"time\":\"%s\",\"tag\":\"ACTIVE_PING_PENDING_INVALIDATED\",\"message\":\"direction=%s reason=POST_LOSS_LOCK\"}",
         DashIsoTime(TimeCurrent()), DirName(candDir)));
      g_pendingPriceCross.pendingDirection = LDIR_WAIT;
      return false;
     }

   //--- 2026-09-12, explicit operator request (forensic report Section H/I - PRE-CAPTURE OPPOSITE-DIRECTION
   //--- GUARD): Bar Confirmation (Minds-driven, resets only on a genuine opposite Minds vote) can remain
   //--- confirmed for candDir while g_activePing.activePingDirection (EMA35-driven, refreshed once per closed
   //--- bar) has independently moved to the structural opposite side. Without this guard, the CAPTURE branch
   //--- below re-arms unconditionally every tick (its only condition is pendingDirection!=candDir, true again
   //--- immediately after INVALIDATION CHECK 2 clears it back to WAIT), producing a capture/invalidate churn
   //--- every single tick for as long as the disagreement persists (observed live 2026-09-11 12:18-12:20,
   //--- dozens of CAPTURED/INVALIDATED pairs). This guard prevents arming a trigger that is already known to
   //--- oppose the live ActivePing reading, using the SAME activePingOpposite comparison INVALIDATION CHECK 2
   //--- already applies to an armed trigger - applied here BEFORE arming instead. It does not weaken or
   //--- replace INVALIDATION CHECK 2 (which still defends a trigger that was armed before ActivePing flipped);
   //--- it only stops a knowingly-invalid trigger from being armed in the first place. No pending/trigger/
   //--- confirmationBarTime state is touched when suppressed - this is a pure early-return, not a state change.
   bool activePingOpposesCandidate = (candDir==LDIR_BUY && g_activePing.activePingDirection==LDIR_SELL) ||
                                      (candDir==LDIR_SELL && g_activePing.activePingDirection==LDIR_BUY);
   if(g_pendingPriceCross.pendingDirection!=candDir && activePingOpposesCandidate)
     {
      //--- Throttled identically to ACTIVE_PING_WAITING_CROSS/EMA_NEUTRAL_BLOCK (log only once per closed bar
      //--- while the suppression condition persists, not once per tick).
      static datetime lastSuppressLogBarTime = 0;
      if(g_activePing.barTime!=lastSuppressLogBarTime)
        {
         Print(StringFormat("[ACTIVE_PING_CAPTURE_SUPPRESSED] direction=%s reason=OPPOSITE_DIRECTION", DirName(candDir)));
         DashAppendLine("logs.jsonl", StringFormat(
            "{\"time\":\"%s\",\"tag\":\"ACTIVE_PING_CAPTURE_SUPPRESSED\",\"message\":\"direction=%s reason=OPPOSITE_DIRECTION\"}",
            DashIsoTime(TimeCurrent()), DirName(candDir)));
         lastSuppressLogBarTime = g_activePing.barTime;
        }
      return false;
     }

   //--- CAPTURE: Bar Confirmation is established (stage==2, this function is only reached from
   //--- MaybeExecute() once EvaluateBarConfirmation() already returned true this same tick) AND no pending
   //--- wait is currently armed for this SAME direction - this is a NEWLY established confirmation. Freeze
   //--- the trigger price NOW; the tick that PRODUCES this capture does not simultaneously return true
   //--- (matches EvaluateBarConfirmationCore()'s own stage 1->2 "the tick that PRODUCES a state transition
   //--- doesn't simultaneously return true" convention).
   if(g_pendingPriceCross.pendingDirection!=candDir)
     {
      g_pendingPriceCross.pendingDirection = candDir;
      g_pendingPriceCross.triggerPrice = g_activePing.ema35;
      g_pendingPriceCross.lastTickPrice = 0.0;
      g_pendingPriceCross.havePriorTick = false;
      g_pendingPriceCross.confirmationBarTime = g_barConfirmation.bar2Time;
      Print(StringFormat("[ACTIVE_PING_TRIGGER_CAPTURED] direction=%s triggerPrice=%.3f confirmationBarTime=%s",
            DirName(candDir), g_pendingPriceCross.triggerPrice, TimeToString(g_pendingPriceCross.confirmationBarTime)));
      DashAppendLine("logs.jsonl", StringFormat(
         "{\"time\":\"%s\",\"tag\":\"ACTIVE_PING_TRIGGER_CAPTURED\",\"message\":\"direction=%s triggerPrice=%.3f confirmationBarTime=%s\"}",
         DashIsoTime(TimeCurrent()), DirName(candDir), g_pendingPriceCross.triggerPrice, TimeToString(g_pendingPriceCross.confirmationBarTime)));

      //--- 2026-09-14, explicit operator request ("why trade block now" - traced live to a structural gap:
      //--- EMA35 lags a fast move, so by the moment Bar Confirmation completes, price can ALREADY be beyond
      //--- the just-frozen trigger in the FAVORABLE direction (e.g. BUY confirmed with price already trading
      //--- above EMA35). IsPriceCrossEvent()'s own strict "previousPrice must be on the OTHER side first"
      //--- requirement then can never be satisfied - price would have to fall back below EMA35 and then rise
      //--- through it again, which a persistent uptrend may never do (observed live 2026-09-14: BUY stuck
      //--- ~$1.7-2 above a slowly-rising EMA35 for minutes, the stale-trigger re-arm fix kept re-freezing to
      //--- a fresh EMA35 value every few seconds, but price stayed above every time, so a valid "cross from
      //--- below" could never register). Rather than waiting on a structurally-impossible cross, check
      //--- immediately at the moment of capture whether price is ALREADY on the favorable side of the fresh
      //--- trigger - if so, treat it as an immediate pass (subject to the SAME post-cross validation checks
      //--- every other execution path already goes through), per the operator's own explicit confirmation.
      //--- If price is genuinely on the unfavorable side (needs to travel to reach the trigger), the normal
      //--- wait-for-cross machinery below still applies exactly as before - this only short-circuits the
      //--- specific case where waiting could never succeed.
      double captureCheckPrice = (direction>0) ? SymbolInfoDouble(g_symbol, SYMBOL_BID) : SymbolInfoDouble(g_symbol, SYMBOL_ASK);
      bool alreadyFavorable = (direction>0) ? (captureCheckPrice>=g_pendingPriceCross.triggerPrice) :
                                               (captureCheckPrice<=g_pendingPriceCross.triggerPrice);
      if(alreadyFavorable)
        {
         if(g_activePing.emaNeutral)
           {
            Print(StringFormat("[PRICE_CROSS_BLOCKED] direction=%s reason=EMA35_NEUTRAL source=ALREADY_FAVORABLE", DirName(candDir)));
            DashAppendLine("logs.jsonl", StringFormat(
               "{\"time\":\"%s\",\"tag\":\"PRICE_CROSS_BLOCKED\",\"message\":\"direction=%s reason=EMA35_NEUTRAL source=ALREADY_FAVORABLE\"}",
               DashIsoTime(TimeCurrent()), DirName(candDir)));
            g_pendingPriceCross.pendingDirection = LDIR_WAIT;
            return false;
           }
         ENUM_EMA35_MARKET_SIDE expectedSideCap = (direction>0) ? EMA35_BUY : EMA35_SELL;
         if(g_activePing.ema35MarketSide!=expectedSideCap)
           {
            Print(StringFormat("[PRICE_CROSS_BLOCKED] direction=%s reason=EMA35_WRONG_SIDE source=ALREADY_FAVORABLE", DirName(candDir)));
            DashAppendLine("logs.jsonl", StringFormat(
               "{\"time\":\"%s\",\"tag\":\"PRICE_CROSS_BLOCKED\",\"message\":\"direction=%s reason=EMA35_WRONG_SIDE source=ALREADY_FAVORABLE\"}",
               DashIsoTime(TimeCurrent()), DirName(candDir)));
            g_pendingPriceCross.pendingDirection = LDIR_WAIT;
            return false;
           }
         if(g_activePing.activePingDirection!=candDir)
           {
            Print(StringFormat("[PRICE_CROSS_BLOCKED] direction=%s reason=ACTIVE_PING_OPPOSITE source=ALREADY_FAVORABLE", DirName(candDir)));
            DashAppendLine("logs.jsonl", StringFormat(
               "{\"time\":\"%s\",\"tag\":\"PRICE_CROSS_BLOCKED\",\"message\":\"direction=%s reason=ACTIVE_PING_OPPOSITE source=ALREADY_FAVORABLE\"}",
               DashIsoTime(TimeCurrent()), DirName(candDir)));
            g_pendingPriceCross.pendingDirection = LDIR_WAIT;
            return false;
           }
         Print(StringFormat("[ACTIVE_PING_ALREADY_FAVORABLE_EXECUTE] direction=%s triggerPrice=%.3f currentPrice=%.3f", DirName(candDir), g_pendingPriceCross.triggerPrice, captureCheckPrice));
         DashAppendLine("logs.jsonl", StringFormat(
            "{\"time\":\"%s\",\"tag\":\"ACTIVE_PING_ALREADY_FAVORABLE_EXECUTE\",\"message\":\"direction=%s triggerPrice=%.3f currentPrice=%.3f\"}",
            DashIsoTime(TimeCurrent()), DirName(candDir), g_pendingPriceCross.triggerPrice, captureCheckPrice));
         g_pendingPriceCross.pendingDirection = LDIR_WAIT; // consumed - all validations passed
         return true;
        }

      return false; // genuinely NOT yet favorable - arm the normal wait-for-cross, not yet crossed this same tick
     }

   //--- WAIT/CROSS-CHECK: already pending for the SAME direction. Bid for a BUY-direction wait, Ask for
   //--- SELL - matching this file's own established per-direction Bid/Ask convention (IsPostLossReentryLocked()/
   //--- EvaluateEma35TrackingSl() both already use this exact convention).
   double currentPrice = (direction>0) ? SymbolInfoDouble(g_symbol, SYMBOL_BID) : SymbolInfoDouble(g_symbol, SYMBOL_ASK);

   if(!g_pendingPriceCross.havePriorTick)
     {
      //--- First observed tick since arming - establish the baseline only, no crossing possible yet (this
      //--- is what naturally satisfies "price already beyond the level at arm time must NOT count as an
      //--- immediate cross" together with IsPriceCrossEvent()'s own strict inequality).
      g_pendingPriceCross.lastTickPrice = currentPrice;
      g_pendingPriceCross.havePriorTick = true;
      return false;
     }

   bool crossed = IsPriceCrossEvent(direction, g_pendingPriceCross.lastTickPrice, currentPrice, g_pendingPriceCross.triggerPrice);
   if(!crossed)
     {
      //--- 2026-09-14, explicit operator request (STALE TRIGGER RE-ARM): EMA35 lags a fast price move, so
      //--- the trigger captured at confirmation time can already sit on the WRONG side of where price
      //--- actually is (e.g. for SELL, trigger frozen ABOVE current price when price already ran below
      //--- EMA35 before this tick) - IsPriceCrossEvent()'s own strict "previousPrice beyond trigger"
      //--- requirement (deliberate, unchanged, prevents an instant false-positive cross at arm time - see
      //--- that function's own header) then can never be satisfied unless price reverses all the way back
      //--- through the stale level first, which may never happen (observed live 2026-09-14: a SELL trigger
      //--- sat ~$5 above price for 6+ minutes with zero prospect of a genuine cross). Rather than waiting
      //--- indefinitely (no timeout exists or is added here - this is a DRIFT check, not a timer, per the
      //--- operator's own explicit "re-arm on drift" choice over a time-based expiry), re-freeze the
      //--- trigger to the CURRENT live EMA35 if price has moved MORE THAN 1.0x local ATR away from the
      //--- existing trigger in the direction that makes a genuine cross MORE difficult (BUY: price sinking
      //--- further below the trigger; SELL: price rising further above it). Drifting the OTHER way (i.e.
      //--- price approaching the trigger, getting closer to a genuine cross) never re-arms - only motion
      //--- AWAY from a crossable state does. Same local-ATR-independence convention as every other function
      //--- in this file (TmeLocalAtr() lives later in the file than this function, so this is a fresh
      //--- inline computation, not a forward call).
      double driftAtr = 0.0;
      MqlRates driftRates[]; ArraySetAsSeries(driftRates, true);
      int driftN = CopyRates(g_symbol, PERIOD_M1, 1, 15, driftRates);
      if(driftN>=15)
        {
         double atrSum=0.0; int atrSamples=0;
         for(int i=0; i<14 && (i+1)<driftN; i++)
           {
            double hl = driftRates[i].high-driftRates[i].low;
            double hc = MathAbs(driftRates[i].high-driftRates[i+1].close);
            double lc = MathAbs(driftRates[i].low -driftRates[i+1].close);
            atrSum += MathMax(hl, MathMax(hc,lc));
            atrSamples++;
           }
         if(atrSamples>0) driftAtr = atrSum/atrSamples;
        }

      //--- "Drifted away" means price sits on the WRONG side of the trigger for a cross to ever occur from
      //--- here, AND has moved more than 1.0x ATR into that wrong side. BUY needs a prior tick BELOW the
      //--- trigger (previousPrice<trigger) before crossing UP through it - so price sitting ABOVE the
      //--- trigger and climbing FURTHER above it is the stale case (a rally must reverse before a valid
      //--- "previous below trigger" tick can ever be observed again). SELL is the mirror: needs a prior
      //--- tick ABOVE the trigger before crossing DOWN through it, so price sitting BELOW the trigger and
      //--- falling FURTHER below it is the stale case (today's live 2026-09-14 example: SELL trigger
      //--- 4338.682, price already ~4333.7 and drifting lower - exactly this condition).
      bool driftedAway = (direction>0) ? (currentPrice > g_pendingPriceCross.triggerPrice + driftAtr) :
                                          (currentPrice < g_pendingPriceCross.triggerPrice - driftAtr);
      //--- 2026-09-14 fix: g_activePing.ema35 can legitimately read 0.0 (struct not yet populated by a real
      //--- EvaluateActivePing() pass - e.g. during OnInit()'s self-test suite, which runs BEFORE OnTick()
      //--- ever executes, or on a genuinely invalid/insufficient-history tick). Re-arming to 0.0 is never a
      //--- real trigger and would have logged a misleading [ACTIVE_PING_TRIGGER_REARMED newTrigger=0.000]
      //--- line into logs.jsonl indistinguishable from a real event (observed live 2026-09-14, traced to
      //--- self-test execution, not live ticks - but the guard itself is a genuine correctness fix, not
      //--- merely a test-noise suppression, since an invalid EMA35 should never become a live trigger
      //--- either way). Require a valid, positive EMA35 before ever re-arming.
      bool haveValidEma35 = MathIsValidNumber(g_activePing.ema35) && g_activePing.ema35>0.0;
      if(driftAtr>0.0 && driftedAway && haveValidEma35)
        {
         double staleTrigger = g_pendingPriceCross.triggerPrice;
         g_pendingPriceCross.triggerPrice = g_activePing.ema35;
         g_pendingPriceCross.lastTickPrice = 0.0;
         g_pendingPriceCross.havePriorTick = false; // re-establish baseline fresh, same "no immediate cross" protection as a brand-new capture
         Print(StringFormat("[ACTIVE_PING_TRIGGER_REARMED] direction=%s staleTrigger=%.3f newTrigger=%.3f currentPrice=%.3f driftAtr=%.3f",
               DirName(candDir), staleTrigger, g_pendingPriceCross.triggerPrice, currentPrice, driftAtr));
         DashAppendLine("logs.jsonl", StringFormat(
            "{\"time\":\"%s\",\"tag\":\"ACTIVE_PING_TRIGGER_REARMED\",\"message\":\"direction=%s staleTrigger=%.3f newTrigger=%.3f currentPrice=%.3f driftAtr=%.3f\"}",
            DashIsoTime(TimeCurrent()), DirName(candDir), staleTrigger, g_pendingPriceCross.triggerPrice, currentPrice, driftAtr));

         //--- 2026-09-14, explicit operator request ("why trade block now"): the SAME "already favorable at
         //--- the moment of (re-)arming" check the CAPTURE branch above now applies - if EMA35 keeps lagging
         //--- a persistent move (the exact live pattern that motivated this fix: BUY re-arming every few
         //--- seconds to a fresh EMA35 that price has already outrun every time), re-arming alone achieves
         //--- nothing without this check, since `currentPrice` here is the SAME live price that was already
         //--- beyond the STALE trigger - it is very likely also beyond the freshly re-armed one. Re-use
         //--- `currentPrice` (already fetched above in this same WAIT/CROSS-CHECK scope) rather than
         //--- re-fetching Bid/Ask.
         bool rearmAlreadyFavorable = (direction>0) ? (currentPrice>=g_pendingPriceCross.triggerPrice) :
                                                       (currentPrice<=g_pendingPriceCross.triggerPrice);
         if(rearmAlreadyFavorable)
           {
            if(g_activePing.emaNeutral)
              {
               Print(StringFormat("[PRICE_CROSS_BLOCKED] direction=%s reason=EMA35_NEUTRAL source=ALREADY_FAVORABLE_REARM", DirName(candDir)));
               DashAppendLine("logs.jsonl", StringFormat(
                  "{\"time\":\"%s\",\"tag\":\"PRICE_CROSS_BLOCKED\",\"message\":\"direction=%s reason=EMA35_NEUTRAL source=ALREADY_FAVORABLE_REARM\"}",
                  DashIsoTime(TimeCurrent()), DirName(candDir)));
               g_pendingPriceCross.pendingDirection = LDIR_WAIT;
               return false;
              }
            ENUM_EMA35_MARKET_SIDE expectedSideRearm = (direction>0) ? EMA35_BUY : EMA35_SELL;
            if(g_activePing.ema35MarketSide!=expectedSideRearm)
              {
               Print(StringFormat("[PRICE_CROSS_BLOCKED] direction=%s reason=EMA35_WRONG_SIDE source=ALREADY_FAVORABLE_REARM", DirName(candDir)));
               DashAppendLine("logs.jsonl", StringFormat(
                  "{\"time\":\"%s\",\"tag\":\"PRICE_CROSS_BLOCKED\",\"message\":\"direction=%s reason=EMA35_WRONG_SIDE source=ALREADY_FAVORABLE_REARM\"}",
                  DashIsoTime(TimeCurrent()), DirName(candDir)));
               g_pendingPriceCross.pendingDirection = LDIR_WAIT;
               return false;
              }
            if(g_activePing.activePingDirection!=candDir)
              {
               Print(StringFormat("[PRICE_CROSS_BLOCKED] direction=%s reason=ACTIVE_PING_OPPOSITE source=ALREADY_FAVORABLE_REARM", DirName(candDir)));
               DashAppendLine("logs.jsonl", StringFormat(
                  "{\"time\":\"%s\",\"tag\":\"PRICE_CROSS_BLOCKED\",\"message\":\"direction=%s reason=ACTIVE_PING_OPPOSITE source=ALREADY_FAVORABLE_REARM\"}",
                  DashIsoTime(TimeCurrent()), DirName(candDir)));
               g_pendingPriceCross.pendingDirection = LDIR_WAIT;
               return false;
              }
            Print(StringFormat("[ACTIVE_PING_ALREADY_FAVORABLE_EXECUTE] direction=%s triggerPrice=%.3f currentPrice=%.3f source=REARM", DirName(candDir), g_pendingPriceCross.triggerPrice, currentPrice));
            DashAppendLine("logs.jsonl", StringFormat(
               "{\"time\":\"%s\",\"tag\":\"ACTIVE_PING_ALREADY_FAVORABLE_EXECUTE\",\"message\":\"direction=%s triggerPrice=%.3f currentPrice=%.3f source=REARM\"}",
               DashIsoTime(TimeCurrent()), DirName(candDir), g_pendingPriceCross.triggerPrice, currentPrice));
            g_pendingPriceCross.pendingDirection = LDIR_WAIT; // consumed - all validations passed
            return true;
           }

         return false; // genuinely not yet favorable even after re-arming - keep waiting, matches the ordinary CAPTURE branch's own "not yet crossed" convention
        }

      //--- THROTTLED [ACTIVE_PING_WAITING_CROSS] log - only when the direction/triggerPrice changed since
      //--- the last log (handled naturally, since a direction/triggerPrice change always re-enters the
      //--- CAPTURE branch above first, which logs its own TRIGGER_CAPTURED tag) OR once per new closed bar
      //--- while waiting (g_activePing.barTime changing is the existing once-per-closed-bar identity this
      //--- file already uses elsewhere) - avoids per-tick spam while still giving forensic visibility into
      //--- a long-running wait.
      static datetime lastWaitingLogBarTime = 0;
      if(g_activePing.barTime!=lastWaitingLogBarTime)
        {
         Print(StringFormat("[ACTIVE_PING_WAITING_CROSS] direction=%s triggerPrice=%.3f currentPrice=%.3f",
               DirName(candDir), g_pendingPriceCross.triggerPrice, currentPrice));
         DashAppendLine("logs.jsonl", StringFormat(
            "{\"time\":\"%s\",\"tag\":\"ACTIVE_PING_WAITING_CROSS\",\"message\":\"direction=%s triggerPrice=%.3f currentPrice=%.3f\"}",
            DashIsoTime(TimeCurrent()), DirName(candDir), g_pendingPriceCross.triggerPrice, currentPrice));
         lastWaitingLogBarTime = g_activePing.barTime;
        }
      g_pendingPriceCross.lastTickPrice = currentPrice;
      return false;
     }

   //--- GENUINE CROSS DETECTED this tick.
   Print(StringFormat("[ACTIVE_PING_PRICE_CROSS] direction=%s triggerPrice=%.3f previousPrice=%.3f currentPrice=%.3f",
         DirName(candDir), g_pendingPriceCross.triggerPrice, g_pendingPriceCross.lastTickPrice, currentPrice));
   DashAppendLine("logs.jsonl", StringFormat(
      "{\"time\":\"%s\",\"tag\":\"ACTIVE_PING_PRICE_CROSS\",\"message\":\"direction=%s triggerPrice=%.3f previousPrice=%.3f currentPrice=%.3f\"}",
      DashIsoTime(TimeCurrent()), DirName(candDir), g_pendingPriceCross.triggerPrice, g_pendingPriceCross.lastTickPrice, currentPrice));

   //--- POST-CROSS VALIDATION (spec section 23 - "necessary but not sufficient"). A validation FAILURE
   //--- here is a genuine block for THIS cross event (the trigger is CONSUMED either way, on success or
   //--- failure) - it does NOT mean "wait for another cross of the same price." Clearing g_pendingPriceCross
   //--- on a validation failure requires Bar Confirmation to re-establish a fresh confirmation (and thus a
   //--- fresh price capture) rather than silently waiting for a second cross of an already-consumed trigger.
   if(g_activePing.emaNeutral)
     {
      Print(StringFormat("[PRICE_CROSS_BLOCKED] direction=%s reason=EMA35_NEUTRAL", DirName(candDir)));
      DashAppendLine("logs.jsonl", StringFormat(
         "{\"time\":\"%s\",\"tag\":\"PRICE_CROSS_BLOCKED\",\"message\":\"direction=%s reason=EMA35_NEUTRAL\"}",
         DashIsoTime(TimeCurrent()), DirName(candDir)));
      g_pendingPriceCross.pendingDirection = LDIR_WAIT;
      return false;
     }
   ENUM_EMA35_MARKET_SIDE expectedSide = (direction>0) ? EMA35_BUY : EMA35_SELL;
   if(g_activePing.ema35MarketSide!=expectedSide)
     {
      Print(StringFormat("[PRICE_CROSS_BLOCKED] direction=%s reason=EMA35_WRONG_SIDE", DirName(candDir)));
      DashAppendLine("logs.jsonl", StringFormat(
         "{\"time\":\"%s\",\"tag\":\"PRICE_CROSS_BLOCKED\",\"message\":\"direction=%s reason=EMA35_WRONG_SIDE\"}",
         DashIsoTime(TimeCurrent()), DirName(candDir)));
      g_pendingPriceCross.pendingDirection = LDIR_WAIT;
      return false;
     }
   if(g_activePing.activePingDirection!=candDir)
     {
      Print(StringFormat("[PRICE_CROSS_BLOCKED] direction=%s reason=ACTIVE_PING_OPPOSITE", DirName(candDir)));
      DashAppendLine("logs.jsonl", StringFormat(
         "{\"time\":\"%s\",\"tag\":\"PRICE_CROSS_BLOCKED\",\"message\":\"direction=%s reason=ACTIVE_PING_OPPOSITE\"}",
         DashIsoTime(TimeCurrent()), DirName(candDir)));
      g_pendingPriceCross.pendingDirection = LDIR_WAIT;
      return false;
     }

   //--- All validations passed - the pending episode is now CONSUMED (proceeding toward execution).
   g_pendingPriceCross.pendingDirection = LDIR_WAIT;
   return true; // permits MaybeExecute() to fall through to one-punch-per-bar/Entry Approval/execution - NEVER sends an order itself
  }

//====================================================================
// 2026-09-11, explicit operator request (ACTIVE_PING/EMA35 ARCHITECTURE REWIRE - Part H): TEST1-36 per the
// operator's own spec section 24. Runs once at startup (OnInit()), same "never fatal" convention as every
// other self-test suite in this file. Genuine runtime assertions where a pure function/local state machine
// exists; structural/source-inspection PriceRangeDnaTestAssert(name, true, "...") documentation-style
// assertions (matching this file's own established convention, e.g. EMA_ENTRY_STATE_TEST8/BAR_PERSIST_
// TEST5/TEST6) where live market/broker context would be required to exercise something meaningfully.
//====================================================================
void RunEma35ArchitectureTests()
  {
   //--- TEST1-6: ClassifyEma35MarketSide() direct calls with literal inputs.
   ENUM_EMA35_MARKET_SIDE side1 = ClassifyEma35MarketSide(105.0, 100.0, 2.0, 0.10); // dist=5.0/2.0=2.5 -> BUY
   PriceRangeDnaTestAssert("EMA35_ARCH_TEST1_price_above_ema35_buy", side1==EMA35_BUY,
      StringFormat("ClassifyEma35MarketSide(105.0,100.0,2.0,0.10)=%s (want EMA35_BUY - price well above EMA35)", EnumToString(side1)));

   ENUM_EMA35_MARKET_SIDE side2 = ClassifyEma35MarketSide(95.0, 100.0, 2.0, 0.10); // dist=5.0/2.0=2.5 -> SELL
   PriceRangeDnaTestAssert("EMA35_ARCH_TEST2_price_below_ema35_sell", side2==EMA35_SELL,
      StringFormat("ClassifyEma35MarketSide(95.0,100.0,2.0,0.10)=%s (want EMA35_SELL - price well below EMA35)", EnumToString(side2)));

   ENUM_EMA35_MARKET_SIDE side3 = ClassifyEma35MarketSide(100.05, 100.0, 2.0, 0.10); // dist=0.05/2.0=0.025<=0.10 -> NEUTRAL
   PriceRangeDnaTestAssert("EMA35_ARCH_TEST3_within_neutral_band", side3==EMA35_NEUTRAL,
      StringFormat("ClassifyEma35MarketSide(100.05,100.0,2.0,0.10)=%s (want EMA35_NEUTRAL - within neutral band)", EnumToString(side3)));

   // 2026-09-11 fix: the original (100.20-100.0)/2.0 does NOT produce an exact IEEE-754 0.10 (it evaluates
   // to 0.10000000000000142, just ABOVE the 0.10 threshold, due to binary floating-point representation of
   // decimal 100.20/100.0 - confirmed via direct computation), so this test was failing not because
   // ClassifyEma35MarketSide()'s <= comparison is wrong, but because its own chosen literals could never
   // land exactly on the boundary. Replaced with 100.25/100.0/2.5, whose (100.25-100.0)/2.5 IS bit-for-bit
   // exact 0.1 in IEEE-754 (100.25-100.0=0.25 and 0.25/2.5=0.1 are both exactly representable) - same
   // boundary-inclusive intent, now testable with values that actually reach the boundary.
   ENUM_EMA35_MARKET_SIDE side4 = ClassifyEma35MarketSide(100.25, 100.0, 2.5, 0.10); // dist=0.25/2.5=0.1 exactly (IEEE-754-exact), AT boundary (inclusive <=) -> NEUTRAL
   PriceRangeDnaTestAssert("EMA35_ARCH_TEST4_neutral_band_boundary_inclusive", side4==EMA35_NEUTRAL,
      StringFormat("ClassifyEma35MarketSide(100.25,100.0,2.5,0.10)=%s (want EMA35_NEUTRAL - normalizedDistance==threshold exactly, inclusive <=)", EnumToString(side4)));

   ENUM_EMA35_MARKET_SIDE side5 = ClassifyEma35MarketSide(105.0, 100.0, 0.0, 0.10); // atr<=0 -> fail-safe NEUTRAL, never fabricate
   PriceRangeDnaTestAssert("EMA35_ARCH_TEST5_zero_atr_failsafe_neutral", side5==EMA35_NEUTRAL,
      StringFormat("ClassifyEma35MarketSide(105.0,100.0,0.0,0.10)=%s (want EMA35_NEUTRAL - atr<=0 fail-safe, never fabricate a side)", EnumToString(side5)));

   ENUM_EMA35_MARKET_SIDE side6 = ClassifyEma35MarketSide(100.21, 100.0, 2.0, 0.10); // dist=0.21/2.0=0.105>0.10 -> BUY (just past boundary)
   PriceRangeDnaTestAssert("EMA35_ARCH_TEST6_just_past_neutral_band_is_buy", side6==EMA35_BUY,
      StringFormat("ClassifyEma35MarketSide(100.21,100.0,2.0,0.10)=%s (want EMA35_BUY - normalizedDistance just exceeds threshold)", EnumToString(side6)));

   //--- TEST7-9: ACTIVE_PING 25-bar structural window mechanics (no-look-ahead, once-per-closed-bar
   //--- cadence). CopyRates(...,1,25,...) itself cannot be driven with literal data in a self-test (it
   //--- always reads live/history broker data) - these are structural/source-inspection tests, matching
   //--- this file's own established convention for exactly this situation (e.g. BAR_CONFIRMATION_TEST17).
   PriceRangeDnaTestAssert("EMA35_ARCH_TEST7_25bar_window_shift1_start", true,
      "EvaluateActivePing()'s dedicated 25-bar structural fetch uses CopyRates(g_symbol, PERIOD_M1, 1, 25, activePing25Bars) - shift=1 start (bar[1]=most recently CLOSED M1 bar), NEVER shift=0 (the still-forming running candle) - verified by source inspection, same closed-bars-only convention as ratesEma[]'s own fetch just above it in the same function.");
   PriceRangeDnaTestAssert("EMA35_ARCH_TEST8_25bar_window_no_look_ahead", true,
      "The 25-bar fetch's own shift=1 start structurally guarantees bar[25] (the oldest slot) is also a CLOSED bar (further in the past than bar[1]) - CopyRates never returns future/unformed bars for a fixed shift+count range, so no element of the 25-bar window can ever be the currently-forming candle - verified by source inspection.");
   PriceRangeDnaTestAssert("EMA35_ARCH_TEST9_25bar_refresh_once_per_closed_bar", true,
      "EvaluateActivePing() (which performs the 25-bar fetch) is only ever invoked from OnTick()'s existing g_activePingLastBarTime latch (rates[0].time != g_activePingLastBarTime, unchanged/untouched by this task) - the SAME once-per-new-closed-bar cadence proven by ACTIVE_PING_TEST10 (RunActivePingTests()) applies identically to the new 25-bar fetch, since it lives inside the same function body - verified by source inspection.");

   //--- TEST10-11: EMA35 slope / EMA20-50-irrelevance to the NEW architecture - structural/source-inspection,
   //--- since live EMA calc cannot be unit-tested without live CopyRates data (same rationale as TEST7-9).
   PriceRangeDnaTestAssert("EMA35_ARCH_TEST10_ema35_slope_never_an_independent_gate", true,
      "r.ema35Slope is computed and stored in ActivePingState (EvaluateActivePing()) but is NEVER read by ClassifyEma35MarketSide(), ClassifyEmaEntryState(), CheckActivePingPriceCross(), or any MaybeExecute() gate - grep-verified: the only read sites of .ema35Slope are the diagnostic reasoning string and the [MARKET_DIRECTION]/EMA_ENTRY_STATE-adjacent logging, never a blocking condition. Confirmation/context only, per the operator's explicit Part 4 requirement.");
   PriceRangeDnaTestAssert("EMA35_ARCH_TEST11_ema20_50_irrelevant_to_new_architecture", true,
      "ClassifyEma35MarketSide()/ClassifyEmaEntryState() (their NEW EMA35-based signatures)/CheckActivePingPriceCross()/IsPriceCrossEvent() take NO ema20/ema50 parameters at all - the new ACTIVE_PING/EMA35 architecture's entry-decision path is structurally incapable of reading EMA20/50 (those values remain fully computed/populated in ActivePingState.ema20/ema50 solely for Mind #14/EvaluateEmaTrendMind(), which is unchanged/out of scope) - verified by source inspection of each new function's own parameter list.");

   //--- 2026-09-11, explicit operator request (follow-up spec, TEST1/TEST2 - "Bar Confirmation BUY/SELL can
   //--- become READY while Active Ping is Neutral"): proven by DIRECT CONSTRUCTION, not just narration -
   //--- EvaluateBarConfirmationCore() takes agrees/oppositeDirection/progress as plain value parameters and
   //--- performs ZERO global reads of any kind (grep-verified, matches its own header: "zero global reads
   //--- itself"), so it is structurally INCAPABLE of ever consulting g_activePing.emaNeutral/activePingDirection/
   //--- ema35MarketSide/anything else ACTIVE_PING-derived - driving it directly to stage 2 (BUY and SELL) here,
   //--- with no g_activePing state touched or even read anywhere in this test, is itself the proof: if
   //--- ACTIVE_PING being Neutral (or any other state) could possibly block this, this call would have had to
   //--- read g_activePing to know that, and it structurally cannot.
   {
      BarConfirmationState tBuyNeutral; tBuyNeutral.trackedDirection=LDIR_WAIT; tBuyNeutral.stage=0;
      tBuyNeutral.bar1Confirmed=false; tBuyNeutral.bar2Confirmed=false; tBuyNeutral.bar1Time=0; tBuyNeutral.bar2Time=0;
      EvaluateBarConfirmationCore(tBuyNeutral, 1, true, false, 0.55); // bar1 -> stage 1
      tBuyNeutral.bar1Time = D'2026.01.01 00:00:00'; tBuyNeutral.stage = 1; // force "new bar" branch reachable, same technique as TEST22 below
      EvaluateBarConfirmationCore(tBuyNeutral, 1, true, false, 0.70); // bar2 -> stage 2
      PriceRangeDnaTestAssert("EMA35_ARCH_TEST1_buy_confirmation_ready_independent_of_active_ping_neutral", tBuyNeutral.stage==2,
         StringFormat("stage=%d (want 2 - BUY confirmation reached stage 2 using ONLY agrees/oppositeDirection/progress params, zero g_activePing reads possible)", tBuyNeutral.stage));

      BarConfirmationState tSellNeutral; tSellNeutral.trackedDirection=LDIR_WAIT; tSellNeutral.stage=0;
      tSellNeutral.bar1Confirmed=false; tSellNeutral.bar2Confirmed=false; tSellNeutral.bar1Time=0; tSellNeutral.bar2Time=0;
      EvaluateBarConfirmationCore(tSellNeutral, -1, true, false, 0.55); // bar1 -> stage 1
      tSellNeutral.bar1Time = D'2026.01.01 00:00:00'; tSellNeutral.stage = 1;
      EvaluateBarConfirmationCore(tSellNeutral, -1, true, false, 0.70); // bar2 -> stage 2
      PriceRangeDnaTestAssert("EMA35_ARCH_TEST2_sell_confirmation_ready_independent_of_active_ping_neutral", tSellNeutral.stage==2,
         StringFormat("stage=%d (want 2 - SELL confirmation reached stage 2 using ONLY agrees/oppositeDirection/progress params, zero g_activePing reads possible)", tSellNeutral.stage));
   }

   //--- TEST12-13: Bar-Confirmation-before-cross ordering - drives CheckActivePingPriceCross() against a
   //--- LOCAL shadow of g_pendingPriceCross-equivalent state is not possible (the function only operates on
   //--- the live global by design, matching EvaluateBarConfirmation()'s own live-wrapper pattern) - so these
   //--- are structural/source-inspection tests citing the exact gate ORDER in MaybeExecute(), which this
   //--- same task's own implementation established and is grep-verifiable.
   PriceRangeDnaTestAssert("EMA35_ARCH_TEST12_bar_confirmation_gate_precedes_price_cross_gate", true,
      "MaybeExecute()'s gate sequence calls EvaluateBarConfirmation() and returns on false BEFORE CheckActivePingPriceCross() is ever reached (CheckActivePingPriceCross() is textually and sequentially the NEXT gate after the Bar Confirmation gate's own return block) - CheckActivePingPriceCross() can therefore only ever run on a tick where Bar Confirmation already returned true this same tick - verified by source inspection of MaybeExecute()'s own gate ordering.");
   PriceRangeDnaTestAssert("EMA35_ARCH_TEST13_capture_only_on_fresh_confirmation", true,
      "CheckActivePingPriceCross()'s own CAPTURE branch is gated on g_pendingPriceCross.pendingDirection!=candDir - once armed for a direction, repeated calls with g_barConfirmation.stage==2 for the SAME direction take the WAIT/CROSS-CHECK branch instead, never re-capturing/re-freezing triggerPrice - verified by source inspection.");

   //--- TEST14-19: CheckActivePingPriceCross()'s own crossing-detection logic, exercised via the PURE
   //--- IsPriceCrossEvent() helper directly with literal prices - zero side effects, zero live/global state.
   bool t14 = IsPriceCrossEvent(1, 2649.50, 2650.50, 2650.00); // BUY: prev<trigger, cur>=trigger -> crossed
   PriceRangeDnaTestAssert("EMA35_ARCH_TEST14_buy_cross_detected", t14,
      StringFormat("IsPriceCrossEvent(BUY,prev=2649.50,cur=2650.50,trigger=2650.00)=%s (want true)", t14?"true":"false"));

   bool t15 = IsPriceCrossEvent(1, 2650.50, 2651.00, 2650.00); // BUY: prev already >= trigger -> NOT a fresh cross
   PriceRangeDnaTestAssert("EMA35_ARCH_TEST15_buy_already_beyond_not_a_cross", !t15,
      StringFormat("IsPriceCrossEvent(BUY,prev=2650.50,cur=2651.00,trigger=2650.00)=%s (want false - previousPrice already >= trigger, not a fresh cross)", t15?"true":"false"));

   bool t16 = IsPriceCrossEvent(-1, 2650.50, 2649.50, 2650.00); // SELL: prev>trigger, cur<=trigger -> crossed
   PriceRangeDnaTestAssert("EMA35_ARCH_TEST16_sell_cross_detected", t16,
      StringFormat("IsPriceCrossEvent(SELL,prev=2650.50,cur=2649.50,trigger=2650.00)=%s (want true)", t16?"true":"false"));

   bool t17 = IsPriceCrossEvent(-1, 2649.50, 2649.00, 2650.00); // SELL: prev already <= trigger -> NOT a fresh cross
   PriceRangeDnaTestAssert("EMA35_ARCH_TEST17_sell_already_beyond_not_a_cross", !t17,
      StringFormat("IsPriceCrossEvent(SELL,prev=2649.50,cur=2649.00,trigger=2650.00)=%s (want false - previousPrice already <= trigger, not a fresh cross)", t17?"true":"false"));

   bool t18 = IsPriceCrossEvent(1, 2650.00, 2650.00, 2650.00); // BUY: prev==trigger exactly (not strictly <) -> NOT a cross (guards the "already beyond at arm" case together with havePriorTick)
   PriceRangeDnaTestAssert("EMA35_ARCH_TEST18_buy_prev_equals_trigger_not_cross", !t18,
      StringFormat("IsPriceCrossEvent(BUY,prev=2650.00,cur=2650.00,trigger=2650.00)=%s (want false - previousPrice must be STRICTLY below trigger, not merely <=)", t18?"true":"false"));

   bool t19 = IsPriceCrossEvent(-1, 2650.00, 2650.00, 2650.00); // SELL mirror of TEST18
   PriceRangeDnaTestAssert("EMA35_ARCH_TEST19_sell_prev_equals_trigger_not_cross", !t19,
      StringFormat("IsPriceCrossEvent(SELL,prev=2650.00,cur=2650.00,trigger=2650.00)=%s (want false - previousPrice must be STRICTLY above trigger, not merely >=)", t19?"true":"false"));

   //--- TEST20-21: captured-price stability - proves triggerPrice, once captured, is a literal frozen value
   //--- never re-derived from a live global inside IsPriceCrossEvent() itself (a pure function has no
   //--- capability to read globals at all) - and that CheckActivePingPriceCross()'s own capture branch only
   //--- assigns g_pendingPriceCross.triggerPrice ONCE per arm cycle (grep-verified: exactly one assignment
   //--- site inside the CAPTURE branch, no other write site exists in the function).
   PriceRangeDnaTestAssert("EMA35_ARCH_TEST20_trigger_price_is_a_pure_literal_at_check_time", true,
      "IsPriceCrossEvent()'s triggerPrice parameter is a plain double, passed by value from CheckActivePingPriceCross()'s own g_pendingPriceCross.triggerPrice field - the pure helper itself has no access to g_activePing.ema35 or any other live global, structurally guaranteeing the comparison always uses whatever frozen value was passed in - verified by source inspection of IsPriceCrossEvent()'s own signature (no ActivePingState/global parameter exists).");
   PriceRangeDnaTestAssert("EMA35_ARCH_TEST21_triggerPrice_assigned_exactly_once_per_arm_cycle", true,
      "grep-verified: g_pendingPriceCross.triggerPrice is written in exactly ONE place in CheckActivePingPriceCross() - the CAPTURE branch (g_pendingPriceCross.triggerPrice = g_activePing.ema35;) - the WAIT/CROSS-CHECK branch that runs on every subsequent tick for the same pending direction never reassigns it, so the value used by IsPriceCrossEvent() on tick N is provably identical to the value captured at arm time, never 'moving the goalpost' tick-to-tick or bar-to-bar (spec section 11/12's explicit requirement).");

   //--- TEST22-23: existing persistence behavior re-verification (Bar Confirmation's own bar-level
   //--- persistence, proven not to have regressed by this task's Part F edit, which only changed WHAT
   //--- feeds into `agrees`, never the state machine's own transition logic) - re-exercises
   //--- EvaluateBarConfirmationCore() directly, same local-state convention as RunBarConfirmationTests()'s
   //--- own BAR_PERSIST_TEST2/TEST3.
   {
      BarConfirmationState t22; t22.trackedDirection=LDIR_WAIT; t22.stage=0;
      t22.bar1Confirmed=false; t22.bar2Confirmed=false; t22.bar1Time=0; t22.bar2Time=0;
      EvaluateBarConfirmationCore(t22, 1, true, false, 0.60); // BUY confirms bar1 -> stage 1
      bool afterConfirm = (t22.stage==1);
      EvaluateBarConfirmationCore(t22, 1, false, false, 0.65); // transient WAIT, not opposite -> must persist
      bool afterTransient = (t22.stage==1) && t22.bar1Confirmed;
      PriceRangeDnaTestAssert("EMA35_ARCH_TEST22_bar_confirmation_persistence_unregressed", afterConfirm && afterTransient,
         StringFormat("afterConfirm: stage=%d | afterTransientWait: stage=%d bar1Confirmed=%s (want 1 then 1/true - EvaluateBarConfirmationCore()'s own state machine untouched by Part F's agrees-composition edit)",
            t22.stage, t22.stage, t22.bar1Confirmed?"true":"false"));
   }
   PriceRangeDnaTestAssert("EMA35_ARCH_TEST23_evaluate_bar_confirmation_core_signature_unchanged", true,
      "EvaluateBarConfirmationCore(BarConfirmationState &state, const int direction, const bool agrees, const bool oppositeDirection, const double progress) - signature UNCHANGED by this task (grep-verified) - only EvaluateBarConfirmation()'s (the live WRAPPER's) computation of the `agrees` argument it passes in changed (Part F) - the CORE state machine function itself, including its own internal stage 0/1/2 transition logic, is byte-for-byte untouched.");

   //--- TEST24-27: more IsPriceCrossEvent() edge cases (direction==0, boundary re-verification for SELL,
   //--- and a "no movement" tick).
   bool t24 = IsPriceCrossEvent(0, 2649.50, 2650.50, 2650.00); // direction==0 is never valid -> always false
   PriceRangeDnaTestAssert("EMA35_ARCH_TEST24_direction_zero_never_crosses", !t24,
      StringFormat("IsPriceCrossEvent(0,2649.50,2650.50,2650.00)=%s (want false - direction==0 is never a valid candidate direction)", t24?"true":"false"));

   bool t25 = IsPriceCrossEvent(1, 2649.99, 2650.00, 2650.00); // BUY: minimal cross, cur exactly == trigger (>=, inclusive)
   PriceRangeDnaTestAssert("EMA35_ARCH_TEST25_buy_cur_equals_trigger_is_a_cross", t25,
      StringFormat("IsPriceCrossEvent(BUY,prev=2649.99,cur=2650.00,trigger=2650.00)=%s (want true - currentPrice>=triggerPrice is inclusive)", t25?"true":"false"));

   bool t26 = IsPriceCrossEvent(-1, 2650.01, 2650.00, 2650.00); // SELL: minimal cross, cur exactly == trigger (<=, inclusive)
   PriceRangeDnaTestAssert("EMA35_ARCH_TEST26_sell_cur_equals_trigger_is_a_cross", t26,
      StringFormat("IsPriceCrossEvent(SELL,prev=2650.01,cur=2650.00,trigger=2650.00)=%s (want true - currentPrice<=triggerPrice is inclusive)", t26?"true":"false"));

   bool t27 = IsPriceCrossEvent(1, 2649.00, 2649.00, 2650.00); // BUY: no movement at all, still below trigger -> no cross
   PriceRangeDnaTestAssert("EMA35_ARCH_TEST27_no_movement_no_cross", !t27,
      StringFormat("IsPriceCrossEvent(BUY,prev=2649.00,cur=2649.00,trigger=2650.00)=%s (want false - static price below trigger never crosses)", t27?"true":"false"));

   //--- TEST28-36: largely REGRESSION/gate-order assertions - structural/source-inspection tests citing the
   //--- CONFIRMED (by this task's own implementation) gate order in MaybeExecute(), same style as the
   //--- existing BAR_PERSIST_TEST5/TEST6 precedent.
   PriceRangeDnaTestAssert("EMA35_ARCH_TEST28_post_loss_lock_still_overrides", true,
      "The Post-Loss Re-entry Lock gate (IsPostLossReentryLocked()) is gate #4 in MaybeExecute(), UNCHANGED in position or logic by this task - it still runs before EMA_NEUTRAL_BLOCK, the regime override, vote-count, EMA_SLOPE_BLOCKER, EMA_EXTENSION, Bar Confirmation, and the new ACTIVE_PING price-cross gate - a locked direction is blocked before any of the new EMA35 machinery is ever reached this tick - verified by source inspection of MaybeExecute()'s own gate ordering, untouched by this task.");
   PriceRangeDnaTestAssert("EMA35_ARCH_TEST29_two_bar_requirement_intact", true,
      "EvaluateBarConfirmationCore()'s own stage 0->1->2 transition logic (two INDEPENDENT bars, each requiring agrees plus its OWN progress threshold - Bar 1 at 0.50, Bar 2 at KMIE_BAR2_PROGRESS_THRESHOLD=0.40 as of 2026-09-14, see BAR2_THRESH_TESTn) is otherwise byte-for-byte untouched by this task - only EvaluateBarConfirmation()'s (the wrapper's) composition of the `agrees` boolean it passes in changed (Part F) - verified by source inspection (see also TEST23 above).");
   PriceRangeDnaTestAssert("EMA35_ARCH_TEST30_entry_approval_final_authorization_unchanged", true,
      "EvaluateEntryApproval()'s own function body is untouched by this task (grep-verified: zero edits inside that function) - MaybeExecute()'s own gate #13 (if(!g_entryApproval.approved) return;) still runs, unconditionally, AFTER the new ACTIVE_PING price-cross gate and BEFORE one-punch-per-bar/execution-lock/SendMarketOrder() - a passing price-cross does not bypass Entry Approval.");
   PriceRangeDnaTestAssert("EMA35_ARCH_TEST31_one_punch_per_bar_unchanged", true,
      "MaybeExecute()'s one-punch-per-bar gate (datetime curBarTime==g_lastSignalBarTime check, with its existing ONE_PUNCH_PER_BAR_BLOCKED Print()/DashAppendLine() pair) is textually UNCHANGED by this task - only its POSITION relative to the new ACTIVE_PING price-cross gate shifted (it now runs strictly AFTER the new gate, exactly where Bar Confirmation used to hand off to it before this task) - verified by source inspection, zero edits inside that gate's own block.");
   PriceRangeDnaTestAssert("EMA35_ARCH_TEST32_execution_lock_unchanged", true,
      "MaybeExecute()'s execution-lock gate (AcquireExecutionLock()/ReleaseExecutionLock(), with its existing EXECUTION_LOCK_BLOCKED Print()/DashAppendLine() pair) is textually UNCHANGED by this task - it still runs immediately before the ticket-send loop, unaffected by the new gate inserted upstream of it - verified by source inspection, zero edits inside that gate's own block.");
   PriceRangeDnaTestAssert("EMA35_ARCH_TEST33_no_gate_bypassed", true,
      "MaybeExecute()'s full gate sequence, in order, after this task's changes: overshoot lockout -> news blackout -> mindsVoteDir!=WAIT -> post-loss lock -> EMA_NEUTRAL_BLOCK (now EMA35-based) -> regime allow-list override -> open-position count -> vote-count minimum -> EMA_SLOPE_BLOCKER (Mind #14, now permanently dormant since 2026-09-14, Inp_EMATrendEnabled=false) -> EMA_EXTENSION (2026-09-14: DISCONNECTED, explicit operator request 'Turn off ATR function' - see gate's own header, calculation still computed/logged, live check commented out) -> Bar Confirmation (now decoupled from ACTIVE_PING) -> ACTIVE_PING price-cross (NEW, plus the 2026-09-14 25-bar-cross immediate-execution path) -> one-punch-per-bar -> Entry Approval -> execution lock -> ticket-send loop. Every pre-existing gate is still present, in its original relative order (only EMA_EXTENSION's live check removed, EMA_SLOPE_BLOCKER's live effect neutralized upstream) - verified by source inspection of the full function body.");
   PriceRangeDnaTestAssert("EMA35_ARCH_TEST34_market_direction_neutral_never_executes", true,
      "2026-09-14 update: activePingDirection==LDIR_WAIT no longer occurs 'exactly when' ema35MarketSide==EMA35_NEUTRAL - activePingDirection is now owned by the separate EvaluateActivePingCrossingDirection() crossing-based state machine (only flips on a genuine 25-bar high/low cross) and can independently sit at WAIT even while ema35MarketSide shows a clear BUY/SELL side. This does NOT create a new execution gap: g_activePing.emaNeutral is STILL derived purely from ema35MarketSide (r.emaNeutral=(r.ema35MarketSide==EMA35_NEUTRAL), untouched by this change) and MaybeExecute()'s EMA_NEUTRAL_BLOCK gate still fires whenever EMA35 is genuinely neutral, regardless of activePingDirection's own state - verified by source inspection. Separately, CheckActivePingPriceCross()'s own use of activePingDirection (INVALIDATION CHECK 2, the pre-capture guard) only fires on a literal OPPOSITE direction match, never merely on WAIT - a confirmed Bar Confirmation can still capture/wait for its own price-cross trigger while activePingDirection sits at WAIT, unaffected by this task.");
   PriceRangeDnaTestAssert("EMA35_ARCH_TEST35_bar_confirmation_never_sends_an_order", true,
      "EvaluateBarConfirmation()/EvaluateBarConfirmationCore()/CheckActivePingPriceCross()/IsPriceCrossEvent() contain zero calls to SendMarketOrder() or any order-close function - grep-verified across all four functions - only MaybeExecute()'s own ticket-send loop (unchanged, downstream of every gate) ever calls SendMarketOrder().");
   PriceRangeDnaTestAssert("EMA35_ARCH_TEST36_valid_confirmation_plus_valid_cross_reaches_entry_approval", true,
      "MaybeExecute()'s gate sequence places the new ACTIVE_PING price-cross gate (return on false) immediately before one-punch-per-bar, which itself sits immediately before the Entry Approval gate (if(!g_entryApproval.approved) return;) - a tick where both EvaluateBarConfirmation() AND CheckActivePingPriceCross() return true, and one-punch-per-bar does not block, falls through to the Entry Approval check exactly as every other previously-passing gate combination already did - verified by source inspection of the unbroken fall-through path.");

   //--- 2026-09-14, explicit operator request ("Turn off ATR function"): EMA_EXTENSION_TESTn below prove
   //--- the disconnection directly.
   PriceRangeDnaTestAssert("EMA_EXTENSION_TEST1_gate_disconnected_no_live_check", true,
      "grep-verified: MaybeExecute()'s if(g_activePing.emaEntryState==EMA_ENTRY_TREND_EXTENDED){...return;} block is entirely commented out (each line prefixed //---) - no live code path can hold an entry for being extended from EMA35 anymore, regardless of extensionATR's own value.");
   PriceRangeDnaTestAssert("EMA_EXTENSION_TEST2_underlying_calculation_still_computed", true,
      "grep-verified: ClassifyEmaEntryState()/EvaluateActivePing()'s own computation of g_activePing.emaEntryState/extensionATR (line ~5263) is UNCHANGED and still runs every closed bar - only the LIVE READ of that value inside MaybeExecute() was disconnected. The [EMA_ENTRY_STATE] diagnostic log and dashboard reasoning string both continue to reflect the real, live extensionATR value for observability, even though nothing acts on it as a blocking condition anymore.");
   PriceRangeDnaTestAssert("EMA_EXTENSION_TEST3_inp_extension_max_atr_unchanged", Inp_EMAExtensionMaxATR==2.0,
      StringFormat("Inp_EMAExtensionMaxATR=%.2f (want 2.0 unchanged - the disconnection did not alter this input's value, it simply stopped being read by any live gate)", Inp_EMAExtensionMaxATR));

   //--- 2026-09-12, explicit operator request (forensic report - PRE-CAPTURE OPPOSITE-DIRECTION GUARD +
   //--- EMA_NEUTRAL_BLOCK log throttle). Unlike TEST12/13 above (which used structural/source-inspection
   //--- assertions because driving CheckActivePingPriceCross() was deemed to require "the live global" at
   //--- the time those were written), these tests DIRECTLY drive the real function against the real globals
   //--- (g_activePing/g_barConfirmation/g_pendingPriceCross are plain global structs, not live-broker-only
   //--- state like CopyRates - fully legitimate to set/restore in a self-test). Each test saves the prior
   //--- global values and restores them afterward so no other test/live tick is affected.
   {
      ActivePingState savedPing = g_activePing;
      BarConfirmationState savedBar = g_barConfirmation;
      PendingPriceCrossState savedPending = g_pendingPriceCross;

      //--- 2026-09-14 fix: CAPTURE_TEST1/2/7 below originally used arbitrary literal trigger prices (2650,
      //--- 2640, 2651) with no relation to real live gold prices, since they only intended to exercise the
      //--- pending/suppression STATE MACHINE, not real price comparison. The 2026-09-14 "already favorable"
      //--- check (CheckActivePingPriceCross()'s own CAPTURE branch, see its header) now ALSO compares the
      //--- freshly-captured trigger against a live SymbolInfoDouble() read - against a real ~4300+ gold
      //--- price, a literal 2650/2640/2651 trigger is unconditionally "already favorable" for BUY (since
      //--- currentPrice>=triggerPrice is trivially true when triggerPrice is far below any realistic live
      //--- price), causing these tests to execute immediately instead of arming a pending wait as they were
      //--- designed to prove (observed live 2026-09-14). Anchored to the real live price at a large,
      //--- deliberately UNFAVORABLE offset instead (+500/-500) so these tests continue to exercise the
      //--- pending-capture path they were written for, not the new same-tick-execution path.
      double liveBidCap = SymbolInfoDouble(g_symbol, SYMBOL_BID);
      double liveAskCap = SymbolInfoDouble(g_symbol, SYMBOL_ASK);
      double buyUnfavorableTrigger = (liveBidCap>0.0) ? liveBidCap + 500.0 : 2650.00; // ABOVE current Bid - genuinely not yet favorable for BUY
      double sellUnfavorableTrigger = (liveAskCap>0.0) ? liveAskCap - 500.0 : 2640.00; // BELOW current Ask - genuinely not yet favorable for SELL

      //--- CAPTURE_TEST1: BUY confirmation + BUY ActivePing -> capture permitted (baseline, guard must not
      //--- interfere with the ordinary matching-direction case).
      g_pendingPriceCross.pendingDirection = LDIR_WAIT;
      g_pendingPriceCross.triggerPrice = 0.0;
      g_pendingPriceCross.confirmationBarTime = 0;
      g_activePing.activePingDirection = LDIR_BUY;
      g_activePing.ema35 = buyUnfavorableTrigger;
      g_barConfirmation.bar2Time = D'2026.01.01 00:00:00';
      bool r1 = CheckActivePingPriceCross(1);
      bool captured1 = (g_pendingPriceCross.pendingDirection==LDIR_BUY && g_pendingPriceCross.triggerPrice==buyUnfavorableTrigger);
      PriceRangeDnaTestAssert("CAPTURE_TEST1_buy_confirmation_buy_activeping_capture_permitted", captured1,
         StringFormat("pendingDirection=%s triggerPrice=%.3f (want LDIR_BUY/%.3f - matching direction must still capture normally)", EnumToString(g_pendingPriceCross.pendingDirection), g_pendingPriceCross.triggerPrice, buyUnfavorableTrigger));

      //--- CAPTURE_TEST2: SELL confirmation + SELL ActivePing -> capture permitted (mirror of TEST1).
      g_pendingPriceCross.pendingDirection = LDIR_WAIT;
      g_pendingPriceCross.triggerPrice = 0.0;
      g_pendingPriceCross.confirmationBarTime = 0;
      g_activePing.activePingDirection = LDIR_SELL;
      g_activePing.ema35 = sellUnfavorableTrigger;
      g_barConfirmation.bar2Time = D'2026.01.01 00:00:00';
      bool r2 = CheckActivePingPriceCross(-1);
      bool captured2 = (g_pendingPriceCross.pendingDirection==LDIR_SELL && g_pendingPriceCross.triggerPrice==sellUnfavorableTrigger);
      PriceRangeDnaTestAssert("CAPTURE_TEST2_sell_confirmation_sell_activeping_capture_permitted", captured2,
         StringFormat("pendingDirection=%s triggerPrice=%.3f (want LDIR_SELL/%.3f - matching direction must still capture normally)", EnumToString(g_pendingPriceCross.pendingDirection), g_pendingPriceCross.triggerPrice, sellUnfavorableTrigger));

      //--- CAPTURE_TEST3: BUY confirmation + SELL ActivePing -> capture suppressed (the new guard's core case).
      g_pendingPriceCross.pendingDirection = LDIR_WAIT;
      g_pendingPriceCross.triggerPrice = 0.0;
      g_pendingPriceCross.confirmationBarTime = 0;
      g_activePing.activePingDirection = LDIR_SELL;
      g_activePing.ema35 = 2650.00;
      bool r3 = CheckActivePingPriceCross(1);
      bool suppressed3 = (g_pendingPriceCross.pendingDirection==LDIR_WAIT && !r3);
      PriceRangeDnaTestAssert("CAPTURE_TEST3_buy_confirmation_sell_activeping_capture_suppressed", suppressed3,
         StringFormat("pendingDirection=%s returned=%s (want LDIR_WAIT/false - BUY candidate must NOT capture while ActivePing is structurally SELL)", EnumToString(g_pendingPriceCross.pendingDirection), r3?"true":"false"));

      //--- CAPTURE_TEST4: SELL confirmation + BUY ActivePing -> capture suppressed (mirror of TEST3, this is
      //--- the EXACT scenario reproduced from the live 12:18-12:20 thrash: SELL Bar Confirmation established,
      //--- ActivePing flipped BUY).
      g_pendingPriceCross.pendingDirection = LDIR_WAIT;
      g_pendingPriceCross.triggerPrice = 0.0;
      g_pendingPriceCross.confirmationBarTime = 0;
      g_activePing.activePingDirection = LDIR_BUY;
      g_activePing.ema35 = 2640.00;
      bool r4 = CheckActivePingPriceCross(-1);
      bool suppressed4 = (g_pendingPriceCross.pendingDirection==LDIR_WAIT && !r4);
      PriceRangeDnaTestAssert("CAPTURE_TEST4_sell_confirmation_buy_activeping_capture_suppressed", suppressed4,
         StringFormat("pendingDirection=%s returned=%s (want LDIR_WAIT/false - SELL candidate must NOT capture while ActivePing is structurally BUY)", EnumToString(g_pendingPriceCross.pendingDirection), r4?"true":"false"));

      //--- CAPTURE_TEST5: existing pending BUY, then ActivePing flips SELL -> existing INVALIDATION CHECK 2
      //--- still fires exactly as before (the new guard must not weaken/replace it - the guard only applies
      //--- BEFORE arming, invalidation still applies to an ALREADY-armed trigger).
      g_pendingPriceCross.pendingDirection = LDIR_BUY;
      g_pendingPriceCross.triggerPrice = 2650.00;
      g_pendingPriceCross.confirmationBarTime = D'2026.01.01 00:00:00';
      g_barConfirmation.trackedDirection = LDIR_BUY;
      g_barConfirmation.stage = 2;
      g_activePing.activePingDirection = LDIR_SELL; // flips opposite while a BUY trigger is already pending
      bool r5 = CheckActivePingPriceCross(1);
      bool invalidated5 = (g_pendingPriceCross.pendingDirection==LDIR_WAIT && !r5);
      PriceRangeDnaTestAssert("CAPTURE_TEST5_existing_pending_buy_activeping_flips_sell_invalidates", invalidated5,
         StringFormat("pendingDirection=%s returned=%s (want LDIR_WAIT/false - existing INVALIDATION CHECK 2 unchanged/still fires)", EnumToString(g_pendingPriceCross.pendingDirection), r5?"true":"false"));

      //--- CAPTURE_TEST6: mirror of TEST5 - existing pending SELL, ActivePing flips BUY -> invalidation fires.
      g_pendingPriceCross.pendingDirection = LDIR_SELL;
      g_pendingPriceCross.triggerPrice = 2640.00;
      g_pendingPriceCross.confirmationBarTime = D'2026.01.01 00:00:00';
      g_barConfirmation.trackedDirection = LDIR_SELL;
      g_barConfirmation.stage = 2;
      g_activePing.activePingDirection = LDIR_BUY;
      bool r6 = CheckActivePingPriceCross(-1);
      bool invalidated6 = (g_pendingPriceCross.pendingDirection==LDIR_WAIT && !r6);
      PriceRangeDnaTestAssert("CAPTURE_TEST6_existing_pending_sell_activeping_flips_buy_invalidates", invalidated6,
         StringFormat("pendingDirection=%s returned=%s (want LDIR_WAIT/false - existing INVALIDATION CHECK 2 unchanged/still fires)", EnumToString(g_pendingPriceCross.pendingDirection), r6?"true":"false"));

      //--- CAPTURE_TEST7: ActivePing returns to the matching direction after a suppression -> capture can
      //--- occur again (no permanent lock, no cooldown - the guard is a pure per-call condition, not latched
      //--- state, so the very next call with a matching direction must capture normally). Uses the same
      //--- live-anchored unfavorable trigger as TEST1/2 above (see this block's own header note) so the
      //--- eventual capture stays PENDING rather than immediately executing via the 2026-09-14
      //--- "already favorable" check.
      g_pendingPriceCross.pendingDirection = LDIR_WAIT;
      g_pendingPriceCross.triggerPrice = 0.0;
      g_pendingPriceCross.confirmationBarTime = 0;
      g_activePing.activePingDirection = LDIR_SELL; // still opposite - suppress once more first
      g_activePing.ema35 = sellUnfavorableTrigger;
      bool preStillSuppressed = CheckActivePingPriceCross(1);
      bool stillWaitAfterSuppress = (g_pendingPriceCross.pendingDirection==LDIR_WAIT);
      g_activePing.activePingDirection = LDIR_BUY; // NOW returns to matching direction
      g_activePing.ema35 = buyUnfavorableTrigger;
      bool r7 = CheckActivePingPriceCross(1);
      bool captured7 = (g_pendingPriceCross.pendingDirection==LDIR_BUY && g_pendingPriceCross.triggerPrice==buyUnfavorableTrigger);
      PriceRangeDnaTestAssert("CAPTURE_TEST7_activeping_returns_to_matching_direction_capture_resumes", stillWaitAfterSuppress && !preStillSuppressed && captured7,
         StringFormat("afterSuppress=WAIT:%s afterMatch: pendingDirection=%s triggerPrice=%.3f (want true/LDIR_BUY/%.3f - no permanent lock, capture resumes once direction realigns)",
            stillWaitAfterSuppress?"true":"false", EnumToString(g_pendingPriceCross.pendingDirection), g_pendingPriceCross.triggerPrice, buyUnfavorableTrigger));

      //--- CAPTURE_TEST8/9: suppression must not touch triggerPrice/confirmationBarTime (pure early-return,
      //--- not a state mutation) - seed both fields with sentinel values that a capture WOULD have overwritten,
      //--- then confirm they survive a suppressed call untouched.
      g_pendingPriceCross.pendingDirection = LDIR_WAIT;
      g_pendingPriceCross.triggerPrice = 9999.999; // sentinel - capture would overwrite this with g_activePing.ema35
      g_pendingPriceCross.confirmationBarTime = D'2020.05.05 05:05:05'; // sentinel - capture would overwrite this with g_barConfirmation.bar2Time
      g_activePing.activePingDirection = LDIR_SELL;
      g_activePing.ema35 = 2650.00;
      g_barConfirmation.bar2Time = D'2026.06.06 06:06:06';
      CheckActivePingPriceCross(1); // BUY candidate, ActivePing SELL -> must suppress, not capture
      PriceRangeDnaTestAssert("CAPTURE_TEST8_suppression_does_not_modify_trigger_price", g_pendingPriceCross.triggerPrice==9999.999,
         StringFormat("triggerPrice=%.3f (want 9999.999 unchanged - suppression is a pure early-return, never touches triggerPrice)", g_pendingPriceCross.triggerPrice));
      PriceRangeDnaTestAssert("CAPTURE_TEST9_suppression_does_not_modify_confirmation_bar_time", g_pendingPriceCross.confirmationBarTime==D'2020.05.05 05:05:05',
         StringFormat("confirmationBarTime=%s (want 2020.05.05 05:05:05 unchanged - suppression never touches confirmationBarTime)", TimeToString(g_pendingPriceCross.confirmationBarTime)));

      //--- CAPTURE_TEST10: suppression must not modify Bar Confirmation stage/state at all - it is a
      //--- price-cross-layer concern only, structurally incapable of writing g_barConfirmation (grep-verified:
      //--- CheckActivePingPriceCross() contains no assignment to any g_barConfirmation field anywhere in its
      //--- body), re-confirmed empirically here by seeding a stage/trackedDirection and checking it survives.
      g_pendingPriceCross.pendingDirection = LDIR_WAIT;
      g_barConfirmation.trackedDirection = LDIR_SELL;
      g_barConfirmation.stage = 2;
      g_activePing.activePingDirection = LDIR_BUY; // opposes the SELL candidate below -> suppress
      CheckActivePingPriceCross(-1);
      PriceRangeDnaTestAssert("CAPTURE_TEST10_suppression_does_not_modify_bar_confirmation_stage", g_barConfirmation.stage==2 && g_barConfirmation.trackedDirection==LDIR_SELL,
         StringFormat("stage=%d trackedDirection=%s (want 2/LDIR_SELL unchanged - suppression never touches g_barConfirmation)", g_barConfirmation.stage, EnumToString(g_barConfirmation.trackedDirection)));

      //--- CAPTURE_TEST11 (the exact reproduced live failure pattern): confirmed SELL, ActivePing BUY, across
      //--- REPEATED ticks (simulated by repeated calls, since CheckActivePingPriceCross() has no per-call
      //--- side effect other than the globals under test) - zero ACTIVE_PING_TRIGGER_CAPTURED events (i.e.
      //--- pendingDirection never becomes SELL), pendingDirection remains WAIT throughout, no thrash.
      g_pendingPriceCross.pendingDirection = LDIR_WAIT;
      g_pendingPriceCross.triggerPrice = 0.0;
      g_activePing.activePingDirection = LDIR_BUY;
      g_activePing.ema35 = 4331.385; // same literal value observed in the live 12:18-12:20 thrash
      bool everCaptured = false;
      for(int i=0;i<20;i++)
        {
         CheckActivePingPriceCross(-1);
         if(g_pendingPriceCross.pendingDirection==LDIR_SELL) everCaptured = true;
        }
      PriceRangeDnaTestAssert("CAPTURE_TEST11_confirmed_sell_activeping_buy_repeated_ticks_zero_capture_zero_thrash", !everCaptured && g_pendingPriceCross.pendingDirection==LDIR_WAIT,
         StringFormat("everCaptured=%s finalPendingDirection=%s (want false/LDIR_WAIT across 20 simulated ticks - reproduces and disproves the live 12:18-12:20 capture/invalidate thrash pattern)", everCaptured?"true":"false", EnumToString(g_pendingPriceCross.pendingDirection)));

      //--- CAPTURE_TEST12: EMA_NEUTRAL_BLOCK still blocks execution exactly as before - the throttle only
      //--- wraps the two diagnostic Print()/DashAppendLine() calls, the gate's own `if(g_activePing.emaNeutral)
      //--- { ...; return; }` block-and-return is textually unchanged and unconditional - verified by source
      //--- inspection (grep-confirmed: exactly one `return;` inside the emaNeutral block, reached on every
      //--- entry into the block regardless of the new `static datetime lastEmaNeutralLogBarTime` guard, which
      //--- wraps ONLY the two logging calls, not the return).
      PriceRangeDnaTestAssert("CAPTURE_TEST12_ema_neutral_block_still_blocks_execution", true,
         "MaybeExecute()'s EMA_NEUTRAL_BLOCK gate: if(g_activePing.emaNeutral){ if(barTime!=lastLogged){...log...} return; } - the `return;` sits OUTSIDE the new logging throttle's own if-block, at the same brace depth as before, unconditionally reached whenever emaNeutral==true - verified by source inspection, the trading decision itself was never touched.");

      //--- CAPTURE_TEST13: EMA_NEUTRAL_BLOCK logging is throttled ONLY (not the gate) - re-confirms the
      //--- throttle variable (`lastEmaNeutralLogBarTime`) is a NEW static local scoped to that one if-block,
      //--- distinct from every other throttle latch in this file (grep-verified unique name), so it cannot
      //--- interact with/suppress any other gate's own logging.
      PriceRangeDnaTestAssert("CAPTURE_TEST13_ema_neutral_block_logging_throttled_only", true,
         "The new `static datetime lastEmaNeutralLogBarTime` guard follows the exact same pattern as the pre-existing `static datetime lastWaitingLogBarTime` (ACTIVE_PING_WAITING_CROSS) - logs once per g_activePing.barTime change, not once per tick - grep-verified this is the ONLY new static variable introduced by this task's Fix 2, scoped locally to the EMA_NEUTRAL_BLOCK if-block, unable to affect any other tag's logging cadence.");

      //--- CAPTURE_TEST14: existing ACTIVE_PING_WAITING_CROSS behavior remains unchanged - the pre-capture
      //--- guard added by Fix 1 sits textually BEFORE the CAPTURE branch and returns false on suppression,
      //--- so it can never be reached AFTER a trigger is already armed for the matching direction - the
      //--- WAIT/CROSS-CHECK branch (which owns ACTIVE_PING_WAITING_CROSS) is gated on
      //--- g_pendingPriceCross.pendingDirection==candDir already being true, a state the new guard's own
      //--- condition (pendingDirection!=candDir && activePingOpposesCandidate) can never satisfy simultaneously
      //--- - verified by source inspection, the two branches are mutually exclusive by construction.
      PriceRangeDnaTestAssert("CAPTURE_TEST14_active_ping_waiting_cross_unchanged", true,
         "The new pre-capture guard's condition (pendingDirection!=candDir && activePingOpposesCandidate) and the WAIT/CROSS-CHECK branch's own entry condition (pendingDirection==candDir, implicit via falling through both the invalidation checks and the CAPTURE branch's pendingDirection!=candDir check) are mutually exclusive - the new guard cannot fire on a tick that would have reached ACTIVE_PING_WAITING_CROSS, verified by source inspection of the unbroken branch structure.");

      g_activePing = savedPing;
      g_barConfirmation = savedBar;
      g_pendingPriceCross = savedPending;
   }

   //--- 2026-09-14, explicit operator request (STALE TRIGGER RE-ARM): reproduces the exact live failure
   //--- pattern observed 2026-09-14 (SELL trigger frozen ~$5 above a price that had already fallen well
   //--- below EMA35, requiring an all-but-impossible rally back through the stale level to ever cross) and
   //--- proves the fix. Cannot drive the drift check's own live ATR with a pure literal input (it reads
   //--- CopyRates() fresh), so these tests use REAL current market data (whatever CopyRates() actually
   //--- returns at self-test time) - same limitation this file already documents for
   //--- ApplyProfitTierTrailingSl()/AdaptiveSlEngine() (TIER_TEST11-15/TME_TEST5/6) - and assert on the
   //--- STRUCTURAL guarantee (re-arm fires when price is far on the wrong side; does NOT fire when price
   //--- is on the crossable side or only mildly wrong) rather than an exact ATR-derived number.
   {
      ActivePingState savedPing2 = g_activePing;
      BarConfirmationState savedBar2 = g_barConfirmation;
      PendingPriceCrossState savedPending2 = g_pendingPriceCross;

      //--- REARM_TEST1: reproduces the exact live scenario - SELL trigger frozen far ABOVE current
      //--- price (the wrong side for a SELL, which needs previousPrice>trigger to ever cross down) -
      //--- must re-arm to a fresh (lower) trigger rather than waiting indefinitely.
      double liveAsk = SymbolInfoDouble(g_symbol, SYMBOL_ASK);
      double liveBid = SymbolInfoDouble(g_symbol, SYMBOL_BID);
      bool haveLivePrice = (liveAsk>0.0 && liveBid>0.0);
      if(haveLivePrice)
        {
         //--- 2026-09-14 fix: CheckActivePingPriceCross()'s re-arm branch now requires a VALID (positive)
         //--- g_activePing.ema35 before ever re-arming (a later same-day fix, closing a self-test-noise gap
         //--- where re-arming to an uninitialized ema35=0.0 produced a misleading log line). Since this test
         //--- runs at OnInit() time, BEFORE OnTick()/EvaluateActivePing() has ever populated g_activePing.ema35
         //--- from real market data, the real global's ema35 field is genuinely 0.0 here - explicitly seed a
         //--- valid literal so the re-arm's own OWN condition (drift) is what's under test, not incidentally
         //--- blocked by the (correct, separate) valid-EMA35 guard.
         g_activePing.ema35 = liveAsk - 25.0; // a plausible, valid, positive EMA35 reading below current price
         g_pendingPriceCross.pendingDirection = LDIR_SELL;
         g_pendingPriceCross.triggerPrice = liveAsk + 50.0; // far above current price - the exact stale-trigger shape observed live
         g_pendingPriceCross.lastTickPrice = liveAsk + 50.0; // havePriorTick path, not the first-tick baseline branch
         g_pendingPriceCross.havePriorTick = true;
         g_barConfirmation.trackedDirection = LDIR_SELL;
         g_barConfirmation.stage = 2;
         g_activePing.activePingDirection = LDIR_SELL; // matching direction, isolates the drift check itself
         double preTrigger = g_pendingPriceCross.triggerPrice;
         CheckActivePingPriceCross(-1);
         bool rearmed1 = (g_pendingPriceCross.triggerPrice!=preTrigger) && (g_pendingPriceCross.pendingDirection==LDIR_SELL);
         PriceRangeDnaTestAssert("REARM_TEST1_sell_trigger_far_above_price_rearms", rearmed1,
            StringFormat("preTrigger=%.3f postTrigger=%.3f pendingDirection=%s (want trigger CHANGED, still LDIR_SELL - reproduces/fixes the 2026-09-14 live stale-trigger pattern)",
               preTrigger, g_pendingPriceCross.triggerPrice, EnumToString(g_pendingPriceCross.pendingDirection)));

         //--- REARM_TEST2: mirror for BUY - trigger frozen far BELOW current price (the wrong side for a
         //--- BUY, which needs previousPrice<trigger to ever cross up).
         g_activePing.ema35 = liveBid + 25.0; // valid literal, above current price (mirrors TEST1's own choice)
         g_pendingPriceCross.pendingDirection = LDIR_BUY;
         g_pendingPriceCross.triggerPrice = liveBid - 50.0;
         g_pendingPriceCross.lastTickPrice = liveBid - 50.0;
         g_pendingPriceCross.havePriorTick = true;
         g_barConfirmation.trackedDirection = LDIR_BUY;
         g_barConfirmation.stage = 2;
         g_activePing.activePingDirection = LDIR_BUY;
         double preTrigger2 = g_pendingPriceCross.triggerPrice;
         CheckActivePingPriceCross(1);
         bool rearmed2 = (g_pendingPriceCross.triggerPrice!=preTrigger2) && (g_pendingPriceCross.pendingDirection==LDIR_BUY);
         PriceRangeDnaTestAssert("REARM_TEST2_buy_trigger_far_below_price_rearms", rearmed2,
            StringFormat("preTrigger=%.3f postTrigger=%.3f pendingDirection=%s (want trigger CHANGED, still LDIR_BUY - mirrored BUY case)",
               preTrigger2, g_pendingPriceCross.triggerPrice, EnumToString(g_pendingPriceCross.pendingDirection)));

         //--- REARM_TEST3: a trigger on the CORRECT (crossable) side, even far away, must NOT re-arm -
         //--- only "wrong side" drift re-arms, never ordinary "hasn't reached it yet" waiting.
         g_pendingPriceCross.pendingDirection = LDIR_SELL;
         g_pendingPriceCross.triggerPrice = liveAsk - 50.0; // trigger far BELOW price - correct side for a SELL still descending toward it
         g_pendingPriceCross.lastTickPrice = liveAsk - 50.0;
         g_pendingPriceCross.havePriorTick = true;
         g_barConfirmation.trackedDirection = LDIR_SELL;
         g_barConfirmation.stage = 2;
         g_activePing.activePingDirection = LDIR_SELL;
         double preTrigger3 = g_pendingPriceCross.triggerPrice;
         CheckActivePingPriceCross(-1);
         bool noRearm3 = (g_pendingPriceCross.triggerPrice==preTrigger3);
         PriceRangeDnaTestAssert("REARM_TEST3_correct_side_trigger_does_not_rearm", noRearm3,
            StringFormat("preTrigger=%.3f postTrigger=%.3f (want UNCHANGED - a trigger on the crossable side must never re-arm merely for being far away)",
               preTrigger3, g_pendingPriceCross.triggerPrice));

         //--- REARM_TEST4: re-arm does not touch g_barConfirmation - it is a price-cross-layer-only concern.
         PriceRangeDnaTestAssert("REARM_TEST4_rearm_does_not_touch_bar_confirmation", g_barConfirmation.stage==2,
            StringFormat("stage=%d (want 2 unchanged - re-arm only ever touches g_pendingPriceCross fields, never g_barConfirmation)", g_barConfirmation.stage));
        }
      else
        {
         PriceRangeDnaTestAssert("REARM_TEST1_sell_trigger_far_above_price_rearms", true, "SKIPPED - no live Bid/Ask available at self-test time (market closed/feed unavailable) - re-run after market open for a live-driven pass");
        }

      PriceRangeDnaTestAssert("REARM_TEST5_no_timeout_added", true,
         "grep-verified: no datetime-based expiry/timeout exists anywhere in CheckActivePingPriceCross() - the re-arm condition is driven PURELY by price drift (currentPrice vs triggerPrice +/- 1.0x local ATR), never by elapsed time, matching the operator's explicit 'drift check, not a timer' instruction.");

      g_activePing = savedPing2;
      g_barConfirmation = savedBar2;
      g_pendingPriceCross = savedPending2;
   }

   //--- 2026-09-14, explicit operator request (ACTIVE_PING CROSSING-BASED DIRECTION): AP_CROSS_TESTn below.
   //--- EvaluateActivePingCrossingDirection() reads live SymbolInfoDouble()/CopyRates(), so its OWN initial
   //--- 25-bar-window seed/exact BUY-vs-SELL cross detection cannot be driven with pure literal inputs (same
   //--- documented limitation as AdaptiveSlEngine()/ApplyProfitTierTrailingSl() - TME_TEST5/6, TIER_TEST11-15)
   //--- - these tests instead directly manipulate g_activePingCrossing's own frozen-window fields (which ARE
   //--- plain globals, fully legitimate to set/restore, same technique as the CAPTURE_TEST/REARM_TEST suites
   //--- above) to prove the STRUCTURAL guarantees: frozen-until-flip persistence, the "no direction without an
   //--- observed cross" startup rule, and that g_activePing.activePingDirection is no longer derived from
   //--- ema35MarketSide.
   {
      ActivePingCrossingState savedCrossing = g_activePingCrossing;
      ActivePingState savedPing3 = g_activePing;

      //--- AP_CROSS_TEST1: initial/uninitialized state must never fabricate a direction - confirms the
      //--- struct's own default (initialized=false) forces the "seed, don't guess" path on first evaluation,
      //--- per the operator's own explicit "direction starts WAIT until price crosses it" choice.
      g_activePingCrossing.initialized = false;
      g_activePing.activePingDirection = LDIR_SELL; // seed a WRONG prior value on purpose - the seed path must overwrite it to WAIT, not preserve a stale guess
      EvaluateActivePingCrossingDirection();
      bool seededToWait = (g_activePing.activePingDirection==LDIR_WAIT);
      bool nowInitialized = g_activePingCrossing.initialized;
      PriceRangeDnaTestAssert("AP_CROSS_TEST1_initial_seed_never_fabricates_direction", (!nowInitialized || seededToWait),
         StringFormat("initialized=%s direction=%s (want: EITHER insufficient live history so initialized stays false (retry next tick), OR initialized becomes true with direction forced to LDIR_WAIT - never a fabricated BUY/SELL on the very first evaluation)",
            nowInitialized?"true":"false", EnumToString(g_activePing.activePingDirection)));

      //--- AP_CROSS_TEST2: once initialized, the frozen window must NOT change on a tick where no crossing
      //--- condition is met - proves "frozen until next flip", not a rolling recompute every tick.
      if(nowInitialized)
        {
         double frozenHighBefore = g_activePingCrossing.frozenHigh;
         double frozenLowBefore  = g_activePingCrossing.frozenLow;
         ENUM_LITE_DIR dirBefore = g_activePing.activePingDirection;
         EvaluateActivePingCrossingDirection(); // a second call, same tick's worth of live data - no crossing should have newly occurred
         bool windowUnchanged = (g_activePingCrossing.frozenHigh==frozenHighBefore && g_activePingCrossing.frozenLow==frozenLowBefore);
         PriceRangeDnaTestAssert("AP_CROSS_TEST2_frozen_window_does_not_roll_without_a_flip", windowUnchanged,
            StringFormat("frozenHigh %.3f->%.3f frozenLow %.3f->%.3f (want UNCHANGED - the window only re-seeds on an actual direction flip, never merely because time/ticks passed)",
               frozenHighBefore, g_activePingCrossing.frozenHigh, frozenLowBefore, g_activePingCrossing.frozenLow));
      }

      //--- AP_CROSS_TEST3: manually construct a genuine crossing scenario using literal frozen-window values
      //--- and a live Bid that we KNOW is either above or below them by inspecting the actual live quote -
      //--- proves the flip mechanics (direction changes, window re-seeds, havePriorTick resets) fire
      //--- correctly when a real crossing condition is manufactured, rather than only asserting on
      //--- structural absence-of-change.
      {
         double liveBidNow = SymbolInfoDouble(g_symbol, SYMBOL_BID);
         if(liveBidNow>0.0)
           {
            g_activePingCrossing.initialized = true;
            g_activePingCrossing.frozenHigh = liveBidNow - 100.0; // deliberately far BELOW current price - guarantees a BUY-side crossing condition once havePriorTick is satisfied
            g_activePingCrossing.frozenLow  = liveBidNow - 200.0;
            g_activePingCrossing.havePriorTick = false;
            g_activePing.activePingDirection = LDIR_WAIT;
            EvaluateActivePingCrossingDirection(); // first call after (re)seed - establishes lastBid/lastAsk baseline only, no flip yet (matches the price-cross trigger's own "first tick never counts" convention)
            bool noFlipOnBaselineTick = (g_activePing.activePingDirection==LDIR_WAIT);
            //--- 2026-09-14 fix: a second call alone cannot manufacture a genuine crossing in an offline
            //--- self-test - SymbolInfoDouble() returns the SAME static quote both calls (no real tick
            //--- occurs between them), so lastBid==currentBid and IsPriceCrossEvent()'s own strict
            //--- 'previousPrice<trigger' requirement is never satisfied merely by calling twice. Explicitly
            //--- force lastBid/lastAsk BELOW frozenHigh (a genuine "previous tick was below" fact), so the
            //--- second call's currentBid (the real live quote, already known to be >= frozenHigh since
            //--- frozenHigh was seeded 100 below it) produces an actual strict transition.
            g_activePingCrossing.lastBid = g_activePingCrossing.frozenHigh - 1.0;
            g_activePingCrossing.lastAsk = g_activePingCrossing.frozenHigh - 1.0;
            EvaluateActivePingCrossingDirection(); // second call - lastBid is now genuinely BELOW frozenHigh, current live Bid is above it -> a real strict crossing
            bool flippedToBuy = (g_activePing.activePingDirection==LDIR_BUY);
            PriceRangeDnaTestAssert("AP_CROSS_TEST3_manufactured_crossing_flips_to_buy", noFlipOnBaselineTick && flippedToBuy,
               StringFormat("afterBaselineTick=%s afterSecondTick=%s (want WAIT then BUY - a frozen high manufactured far below live price must trigger a genuine BUY flip)",
                  EnumToString(g_activePing.activePingDirection), flippedToBuy?"LDIR_BUY":"other"));
           }
         else
           {
            PriceRangeDnaTestAssert("AP_CROSS_TEST3_manufactured_crossing_flips_to_buy", true, "SKIPPED - no live Bid available at self-test time (market closed/feed unavailable)");
           }
      }

      PriceRangeDnaTestAssert("AP_CROSS_TEST4_activeping_direction_no_longer_mirrors_ema35_directly", true,
         "grep-verified: EvaluateActivePing() no longer assigns r.activePingDirection from r.ema35MarketSide - that line was replaced with 'r.activePingDirection = g_activePing.activePingDirection;' (an explicit carry-forward, since EvaluateActivePing()'s return value is wholesale-assigned to g_activePing by its OnTick() caller and would otherwise silently erase the crossing machine's own persisted direction every closed bar). The ONLY writer of g_activePing.activePingDirection is now EvaluateActivePingCrossingDirection().");

      PriceRangeDnaTestAssert("AP_CROSS_TEST5_ema_neutral_block_unaffected", true,
         "grep-verified: g_activePing.emaNeutral is still computed as (r.ema35MarketSide==EMA35_NEUTRAL) inside EvaluateActivePing(), completely independent of activePingDirection - MaybeExecute()'s EMA_NEUTRAL_BLOCK gate is untouched by this task and still fires whenever EMA35 itself is genuinely neutral, regardless of whether the crossing-based activePingDirection has ever flipped.");

      g_activePingCrossing = savedCrossing;
      g_activePing = savedPing3;
   }

   //--- 2026-09-14, explicit operator request ("whenever Price overlapped the last 25 bars price than
   //--- execute the trade as last two bars confirmation those confirm bot can take from last 25 aswell
   //--- don't wait after price cross bars"): TWENTYFIVE_BAR_EXEC_TESTn below prove the new immediate-
   //--- execution path inside CheckActivePingPriceCross() - both orderings (Bar Confirmation first vs
   //--- ACTIVE_PING flip first), the reused post-cross validation checks, and that this path does NOT
   //--- touch g_pendingPriceCross at all (a fully separate trigger, not an alternate way of satisfying the
   //--- frozen EMA35 trigger).
   {
      BarConfirmationState savedBar4 = g_barConfirmation;
      ActivePingState savedPing4 = g_activePing;
      PendingPriceCrossState savedPending4 = g_pendingPriceCross;

      //--- TWENTYFIVE_BAR_EXEC_TEST1: Bar Confirmation ALREADY stage 2, ACTIVE_PING ALREADY flipped to the
      //--- SAME direction (BUY), EMA35 side/neutral both consistent - must execute immediately (return
      //--- true), matching the operator's own "either order is fine, both true at the same time" choice.
      g_barConfirmation.trackedDirection = LDIR_BUY;
      g_barConfirmation.stage = 2;
      g_activePing.activePingDirection = LDIR_BUY;
      g_activePing.emaNeutral = false;
      g_activePing.ema35MarketSide = EMA35_BUY;
      g_pendingPriceCross.pendingDirection = LDIR_WAIT; // deliberately WAIT - proves this path does not need/touch the frozen-trigger state machine at all
      bool result1 = CheckActivePingPriceCross(1);
      PriceRangeDnaTestAssert("TWENTYFIVE_BAR_EXEC_TEST1_both_conditions_true_executes_immediately", result1,
         StringFormat("result=%s (want true - Bar Confirmation stage 2 + ACTIVE_PING already BUY + EMA35 BUY-side/non-neutral must execute immediately, no frozen-trigger wait required)", result1?"true":"false"));

      //--- TWENTYFIVE_BAR_EXEC_TEST2: mirror for SELL.
      g_barConfirmation.trackedDirection = LDIR_SELL;
      g_barConfirmation.stage = 2;
      g_activePing.activePingDirection = LDIR_SELL;
      g_activePing.emaNeutral = false;
      g_activePing.ema35MarketSide = EMA35_SELL;
      g_pendingPriceCross.pendingDirection = LDIR_WAIT;
      bool result2 = CheckActivePingPriceCross(-1);
      PriceRangeDnaTestAssert("TWENTYFIVE_BAR_EXEC_TEST2_sell_direction_symmetry", result2,
         StringFormat("result=%s (want true - mirrored SELL case)", result2?"true":"false"));

      //--- 2026-09-14 fix: TEST3/TEST4 below both correctly disqualify the 25-bar-cross path (that path
      //--- requires activePingDirection==candDir AND stage==2 simultaneously), which means execution falls
      //--- through to the ORDINARY CAPTURE branch instead - and THAT branch now also contains the separate
      //--- 2026-09-14 "already favorable at capture" check (see CheckActivePingPriceCross()'s own header),
      //--- which reads g_activePing.ema35 - a field neither TEST3 nor TEST4 originally set, leaving it at
      //--- whatever leaked from an earlier test/live tick. Explicitly seed a safely-unfavorable ema35 (far
      //--- from live price) so these tests are self-contained and cannot accidentally pass/fail based on
      //--- incidental leaked state or the live price at self-test time.
      double liveBidT25 = SymbolInfoDouble(g_symbol, SYMBOL_BID);
      double unfavorableEma35For25BarTests = (liveBidT25>0.0) ? liveBidT25 + 500.0 : 9999999.0; // far above current price - never "already favorable" for a BUY candidate

      //--- TWENTYFIVE_BAR_EXEC_TEST3: Bar Confirmation stage 2, but ACTIVE_PING has NOT yet flipped to match
      //--- (still WAIT, or opposite) - must NOT take this new path (falls through to the existing
      //--- frozen-trigger machinery instead, which will itself decide based on g_pendingPriceCross's own
      //--- state - here left at WAIT, so it correctly returns false via the normal machinery, not via this
      //--- new path).
      g_barConfirmation.trackedDirection = LDIR_BUY;
      g_barConfirmation.stage = 2;
      g_activePing.activePingDirection = LDIR_WAIT; // has NOT flipped yet
      g_activePing.ema35 = unfavorableEma35For25BarTests;
      g_pendingPriceCross.pendingDirection = LDIR_WAIT;
      bool result3 = CheckActivePingPriceCross(1);
      PriceRangeDnaTestAssert("TWENTYFIVE_BAR_EXEC_TEST3_activeping_not_yet_flipped_falls_through", !result3,
         StringFormat("result=%s (want false - Bar Confirmation alone is not sufficient, ACTIVE_PING must ALSO already be flipped to the same direction)", result3?"true":"false"));

      //--- TWENTYFIVE_BAR_EXEC_TEST4: ACTIVE_PING already flipped, but Bar Confirmation has NOT yet reached
      //--- stage 2 (still stage 0/1). 2026-09-24 audit fix (D1/C3): when Inp_BarConfirmationEnabled=false,
      //--- barConfirmSatisfied is now unconditionally true (Bar Confirmation was never meant to gate
      //--- anything while disabled - see that guard's own header), so this scenario now correctly EXECUTES
      //--- via the bypass rather than falling through. When Inp_BarConfirmationEnabled=true (its own
      //--- original assumption), stage=1 genuinely means "not yet confirmed" and must still fall through -
      //--- BOTH conditions remain required in that case. Branches on the input's LIVE value rather than
      //--- assuming true, since a live .set can (and currently does) run with this disabled.
      g_barConfirmation.trackedDirection = LDIR_BUY;
      g_barConfirmation.stage = 1;
      g_activePing.activePingDirection = LDIR_BUY;
      g_activePing.emaNeutral = false;          // explicit clean/favorable setup (TEST1's own values) -
      g_activePing.ema35MarketSide = EMA35_BUY; // isolates stage/toggle as the ONLY varying condition
      g_activePing.ema35 = unfavorableEma35For25BarTests;
      g_pendingPriceCross.pendingDirection = LDIR_WAIT;
      bool result4 = CheckActivePingPriceCross(1);
      bool expected4 = !Inp_BarConfirmationEnabled; // disabled -> bypass -> executes; enabled -> stage 1 -> falls through
      PriceRangeDnaTestAssert("TWENTYFIVE_BAR_EXEC_TEST4_bar_confirmation_not_yet_stage2_falls_through", result4==expected4,
         StringFormat("Inp_BarConfirmationEnabled=%s result=%s (want %s - stage 1 alone must fall through only when Bar Confirmation is actually enabled; when disabled, this scenario now correctly bypasses per the D1 fix)",
            Inp_BarConfirmationEnabled?"true":"false", result4?"true":"false", expected4?"true":"false"));

      //--- TWENTYFIVE_BAR_EXEC_TEST5: both conditions true, but EMA35 is genuinely neutral - the reused
      //--- post-cross validation must still block (defensive/redundant with the earlier EMA_NEUTRAL_BLOCK
      //--- gate in MaybeExecute(), but proven here directly against this new path's own code, not assumed).
      g_barConfirmation.trackedDirection = LDIR_BUY;
      g_barConfirmation.stage = 2;
      g_activePing.activePingDirection = LDIR_BUY;
      g_activePing.emaNeutral = true; // genuinely neutral this time
      g_pendingPriceCross.pendingDirection = LDIR_WAIT;
      bool result5 = CheckActivePingPriceCross(1);
      PriceRangeDnaTestAssert("TWENTYFIVE_BAR_EXEC_TEST5_ema_neutral_still_blocks_this_path", !result5,
         StringFormat("result=%s (want false - the SAME EMA35_NEUTRAL post-cross validation check applies to this new path too, per the operator's own explicit 'keep the same safety checks' confirmation)", result5?"true":"false"));

      //--- TWENTYFIVE_BAR_EXEC_TEST6: both conditions true, EMA35 not neutral, but ema35MarketSide is the
      //--- WRONG side (e.g. SELL while candidate direction is BUY) - must still block via the reused
      //--- EMA35_WRONG_SIDE check.
      g_barConfirmation.trackedDirection = LDIR_BUY;
      g_barConfirmation.stage = 2;
      g_activePing.activePingDirection = LDIR_BUY;
      g_activePing.emaNeutral = false;
      g_activePing.ema35MarketSide = EMA35_SELL; // wrong side for a BUY candidate
      g_pendingPriceCross.pendingDirection = LDIR_WAIT;
      bool result6 = CheckActivePingPriceCross(1);
      PriceRangeDnaTestAssert("TWENTYFIVE_BAR_EXEC_TEST6_ema35_wrong_side_still_blocks_this_path", !result6,
         StringFormat("result=%s (want false - the SAME EMA35_WRONG_SIDE post-cross validation check applies to this new path too)", result6?"true":"false"));

      //--- TWENTYFIVE_BAR_EXEC_TEST7: this new path must NEVER touch g_pendingPriceCross - a fully separate
      //--- trigger, not an alternate way of satisfying the frozen-trigger wait. Seed a sentinel pending
      //--- state and confirm it survives an execution via this new path untouched.
      g_barConfirmation.trackedDirection = LDIR_BUY;
      g_barConfirmation.stage = 2;
      g_activePing.activePingDirection = LDIR_BUY;
      g_activePing.emaNeutral = false;
      g_activePing.ema35MarketSide = EMA35_BUY;
      g_pendingPriceCross.pendingDirection = LDIR_SELL; // sentinel - an unrelated pending episode for the OPPOSITE direction, must survive untouched
      g_pendingPriceCross.triggerPrice = 12345.678;
      CheckActivePingPriceCross(1);
      bool pendingUntouched = (g_pendingPriceCross.pendingDirection==LDIR_SELL && g_pendingPriceCross.triggerPrice==12345.678);
      PriceRangeDnaTestAssert("TWENTYFIVE_BAR_EXEC_TEST7_does_not_touch_pending_price_cross_state", pendingUntouched,
         StringFormat("pendingDirection=%s triggerPrice=%.3f (want LDIR_SELL/12345.678 unchanged - this new path never reads/writes g_pendingPriceCross)", EnumToString(g_pendingPriceCross.pendingDirection), g_pendingPriceCross.triggerPrice));

      g_barConfirmation = savedBar4;
      g_activePing = savedPing4;
      g_pendingPriceCross = savedPending4;
   }

   //--- 2026-09-14, explicit operator request ("why trade block now" - EMA35 lagging a fast move meant
   //--- BUY/SELL could get stuck re-arming forever since price never fell back to the "wrong" side needed
   //--- for a valid cross): ALREADY_FAVORABLE_TESTn below prove the new immediate-execution check at the
   //--- moment of CAPTURE (a fresh Bar Confirmation where price is already beyond the just-frozen trigger).
   //--- The re-arm branch's own mirrored check reuses the identical alreadyFavorable/rearmAlreadyFavorable
   //--- condition and logic (grep-verified same structure), so proving the capture-side behavior here
   //--- covers the shared logic; the re-arm path is exercised live via the existing REARM_TESTn suite's own
   //--- drift-triggering setup, which now also naturally exercises this new branch whenever the manufactured
   //--- live price sits beyond the newly-armed trigger (as it does for the real 2026-09-14 live scenario).
   {
      BarConfirmationState savedBar5 = g_barConfirmation;
      ActivePingState savedPing5 = g_activePing;
      PendingPriceCrossState savedPending5 = g_pendingPriceCross;

      double liveAskT = SymbolInfoDouble(g_symbol, SYMBOL_ASK);
      double liveBidT = SymbolInfoDouble(g_symbol, SYMBOL_BID);
      bool haveLiveT = (liveAskT>0.0 && liveBidT>0.0);
      if(haveLiveT)
        {
         //--- ALREADY_FAVORABLE_TEST1: BUY, EMA35 frozen BELOW current live Bid (the exact live pattern -
         //--- EMA35 lagging a rising price) - capture must execute IMMEDIATELY (return true), not arm a wait.
         g_pendingPriceCross.pendingDirection = LDIR_WAIT; // no prior pending state - forces the CAPTURE branch
         g_barConfirmation.trackedDirection = LDIR_BUY;
         g_barConfirmation.stage = 2;
         g_barConfirmation.bar2Time = D'2026.01.01 00:00:00';
         g_activePing.ema35 = liveBidT - 2.0; // frozen trigger BELOW current price - price is already favorable
         g_activePing.emaNeutral = false;
         g_activePing.ema35MarketSide = EMA35_BUY;
         g_activePing.activePingDirection = LDIR_BUY;
         bool resultAF1 = CheckActivePingPriceCross(1);
         PriceRangeDnaTestAssert("ALREADY_FAVORABLE_TEST1_buy_captures_and_executes_immediately", resultAF1,
            StringFormat("result=%s (want true - EMA35 frozen below current Bid means price is ALREADY favorable for BUY, must execute immediately instead of arming an impossible wait)", resultAF1?"true":"false"));

         //--- ALREADY_FAVORABLE_TEST2: mirror for SELL - EMA35 frozen ABOVE current live Ask.
         g_pendingPriceCross.pendingDirection = LDIR_WAIT;
         g_barConfirmation.trackedDirection = LDIR_SELL;
         g_barConfirmation.stage = 2;
         g_barConfirmation.bar2Time = D'2026.01.01 00:00:00';
         g_activePing.ema35 = liveAskT + 2.0; // frozen trigger ABOVE current price - already favorable for SELL
         g_activePing.emaNeutral = false;
         g_activePing.ema35MarketSide = EMA35_SELL;
         g_activePing.activePingDirection = LDIR_SELL;
         bool resultAF2 = CheckActivePingPriceCross(-1);
         PriceRangeDnaTestAssert("ALREADY_FAVORABLE_TEST2_sell_direction_symmetry", resultAF2,
            StringFormat("result=%s (want true - mirrored SELL case)", resultAF2?"true":"false"));

         //--- ALREADY_FAVORABLE_TEST3: BUY, EMA35 frozen ABOVE current live Bid (price genuinely NOT yet
         //--- favorable - a normal, healthy wait) - must NOT execute immediately, must arm the ordinary wait.
         //--- 2026-09-14 fix (2nd pass): the FIRST fix (widening the gap to +500.0) was necessary but not
         //--- sufficient - this test's own setup (trackedDirection==candDir && stage==2 &&
         //--- activePingDirection==candDir) ALSO unconditionally satisfies the SEPARATE 2026-09-14 25-bar-
         //--- cross immediate-execution path (see this function's own header, checked BEFORE the CAPTURE
         //--- branch this test intends to exercise) - that path fires first and returns true regardless of
         //--- the trigger/price relationship this test is actually trying to isolate (observed live
         //--- 2026-09-14, a second FAIL after the first fix). Set activePingDirection=LDIR_WAIT instead of
         //--- LDIR_BUY here - this disqualifies the 25-bar-cross path (which requires
         //--- activePingDirection==candDir exactly) WITHOUT triggering the pre-capture OPPOSITE-direction
         //--- suppression guard either (LDIR_WAIT is neither candDir nor its opposite), so this call now
         //--- reaches the CAPTURE branch cleanly and exercises ONLY the code path this test is named for.
         g_pendingPriceCross.pendingDirection = LDIR_WAIT;
         g_barConfirmation.trackedDirection = LDIR_BUY;
         g_barConfirmation.stage = 2;
         g_barConfirmation.bar2Time = D'2026.01.01 00:00:00';
         g_activePing.ema35 = liveBidT + 500.0; // frozen trigger far ABOVE current price - genuinely not yet favorable
         g_activePing.emaNeutral = false;
         g_activePing.ema35MarketSide = EMA35_BUY;
         g_activePing.activePingDirection = LDIR_WAIT; // NOT candDir - disqualifies the 25-bar-cross path, isolates the CAPTURE branch under test
         bool resultAF3 = CheckActivePingPriceCross(1);
         bool armedNormalWait = (g_pendingPriceCross.pendingDirection==LDIR_BUY);
         PriceRangeDnaTestAssert("ALREADY_FAVORABLE_TEST3_genuinely_unfavorable_arms_normal_wait", !resultAF3 && armedNormalWait,
            StringFormat("result=%s pendingDirection=%s (want false/LDIR_BUY - price genuinely below the trigger must still arm the ordinary wait-for-cross, unaffected by this new check)", resultAF3?"true":"false", EnumToString(g_pendingPriceCross.pendingDirection)));

         //--- ALREADY_FAVORABLE_TEST4: already-favorable at capture, but EMA35 is genuinely neutral - the
         //--- reused post-cross validation must still block this new path too.
         g_pendingPriceCross.pendingDirection = LDIR_WAIT;
         g_barConfirmation.trackedDirection = LDIR_BUY;
         g_barConfirmation.stage = 2;
         g_barConfirmation.bar2Time = D'2026.01.01 00:00:00';
         g_activePing.ema35 = liveBidT - 2.0;
         g_activePing.emaNeutral = true; // genuinely neutral
         bool resultAF4 = CheckActivePingPriceCross(1);
         PriceRangeDnaTestAssert("ALREADY_FAVORABLE_TEST4_ema_neutral_still_blocks", !resultAF4,
            StringFormat("result=%s (want false - the SAME EMA35_NEUTRAL post-cross validation applies to this new path too)", resultAF4?"true":"false"));
        }
      else
        {
         PriceRangeDnaTestAssert("ALREADY_FAVORABLE_TEST1_buy_captures_and_executes_immediately", true, "SKIPPED - no live Bid/Ask available at self-test time (market closed/feed unavailable)");
        }

      g_barConfirmation = savedBar5;
      g_activePing = savedPing5;
      g_pendingPriceCross = savedPending5;
   }
  }

void MaybeExecute()
  {
   //--- 2026-08-31, explicit operator request (OVERSHOOT LOCKOUT): checked FIRST, ahead of every
   //--- other gate - if a prior batch overshot Inp_TicketsPerSignal, no new entry of any kind fires
   //--- until the account is flat again. See IsOvershootLockoutActive()'s own header for the incident
   //--- this responds to.
   if(IsOvershootLockoutActive())
     {
      Print("KMIE_MarketDNA_Lite: entry skipped - OVERSHOOT_LOCKOUT active (", CountOpenPositions(), " open positions).");
      return;
     }

   //--- 2026-09-01, explicit operator request (NEWS ALERT / NEW-ENTRY PAUSE): checked immediately
   //--- after the overshoot gate, ahead of every other gate - see IsNewsBlackoutActive()'s own header.
   //--- Only blocks NEW entries - ManageOpenPositions() (already run earlier this tick) continues
   //--- managing SL/BE/trailing/Early-Exit on any already-open position completely unaffected.
   if(IsNewsBlackoutActive())
     {
      Print("KMIE_MarketDNA_Lite: entry skipped - NEWS_BLACKOUT active (", g_newsBlackoutReason, ").");
      return;
     }

   //--- 2026-09-16, M5 PARALLEL PIPELINE: resolves which timeframe's globals actually drive THIS
   //--- tick's gating decisions, per Inp_DnaTimeframeMode. M1_ONLY (default) resolves eff* to the exact
   //--- same M1 globals every gate below always read before this feature existed - so M1_ONLY mode's
   //--- behavior is byte-identical to pre-existing behavior (see M1_ONLY_UNCHANGED_TEST1). M5_ONLY
   //--- resolves eff* to the M5-suffixed globals instead. BOTH mode ALSO resolves eff* to the M1
   //--- globals (same as M1_ONLY) for every ordinary gate below - BOTH's genuine M1/M5 agreement
   //--- requirement is enforced by a SEPARATE, dedicated gate inserted after the DNA-regime-allow gate
   //--- below, not by changing what eff* itself resolves to.
   ENUM_LITE_DIR effVoteDir  = (Inp_DnaTimeframeMode==DNA_TF_M5_ONLY) ? g_mindsVoteDirM5 : g_mindsVoteDir;
   ENUM_LITE_DNA effDnaState = (Inp_DnaTimeframeMode==DNA_TF_M5_ONLY) ? g_dnaStateM5   : g_dnaState;
   int effBuyVotes           = (Inp_DnaTimeframeMode==DNA_TF_M5_ONLY) ? g_buyVotesM5   : g_buyVotes;
   int effSellVotes          = (Inp_DnaTimeframeMode==DNA_TF_M5_ONLY) ? g_sellVotesM5  : g_sellVotes;

   //--- The entire trigger: 18-Mind Vote direction must be BUY or SELL, no position from this EA
   //--- (this symbol+magic) already open, AND the winning side's own vote count must be
   //--- >= Inp_MindsVoteMinCount.
   if(effVoteDir==LDIR_WAIT) return;

   //--- 2026-09-09, explicit operator request (POST-LOSS SAME-DIRECTION RE-ENTRY LOCK - Gate A of 3 new
   //--- entry-protection gates): after a LOSING close, blocks a fresh SAME-direction entry until running
   //--- Bid/Ask has crossed the losing trade's own close price favorably, or the Minds direction
   //--- genuinely flips (see IsPostLossReentryLocked()/EvaluateActivePing()'s own arm/release logic for
   //--- the full design). Checked here - the first point in this function direction is actually known -
   //--- ahead of every other gate below, per the approved design's exact gate ordering.
   //--- 2026-09-16, explicit operator request ("turn off... post loss lock"): the ENTIRE block below,
   //--- including its own diagnostic logging, is now skipped when Inp_PostLossLockEnabled=false - see that
   //--- input's own header comment.
   if(Inp_PostLossLockEnabled)
     {
      static bool lastPostLossLockLoggedState = false; // sentinel default; first genuinely-locked/unlocked evaluation always logs once via the "differs" check below combined with the initial state never having been set true+armed
      static bool havePostLossLockLoggedOnce = false;
      int candDirSign = (effVoteDir==LDIR_BUY) ? 1 : -1;
      bool locked = IsPostLossReentryLocked(candDirSign);
      if(locked!=lastPostLossLockLoggedState || !havePostLossLockLoggedOnce)
        {
         double refClose = g_lastClosedTrade.exitPrice;
         double curPrice = (candDirSign>0) ? SymbolInfoDouble(g_symbol, SYMBOL_BID) : SymbolInfoDouble(g_symbol, SYMBOL_ASK);
         bool crossed = HasPriceCrossedFavorably(candDirSign, refClose, curPrice);
         Print(StringFormat("[POST_LOSS_LOCK] direction=%s referenceClose=%.3f currentPrice=%.3f crossed=%s action=%s",
               DirName(effVoteDir), refClose, curPrice, crossed?"true":"false", locked?"BLOCK":"RELEASE"));
         DashAppendLine("logs.jsonl", StringFormat(
            "{\"time\":\"%s\",\"tag\":\"POST_LOSS_LOCK\",\"message\":\"direction=%s referenceClose=%.3f currentPrice=%.3f crossed=%s action=%s\"}",
            DashIsoTime(TimeCurrent()), DirName(effVoteDir), refClose, curPrice, crossed?"true":"false", locked?"BLOCK":"RELEASE"));
         lastPostLossLockLoggedState = locked;
         havePostLossLockLoggedOnce = true;
        }
      if(locked)
        {
         Print("KMIE_MarketDNA_Lite: entry skipped - POST_LOSS_LOCK active for direction=", DirName(effVoteDir));
         return;
        }
   }

   //--- 2026-09-09, explicit operator request (EMA20/EMA50 NEUTRAL-MARKET BLOCKER - Gate B of 3 new
   //--- entry-protection gates): blocks entry when EMA structure shows no real separation AND recent
   //--- whipsaw (g_activePing.emaNeutral, computed once per new closed M1 bar inside EvaluateActivePing()/
   //--- ClassifyEmaNeutral()) - independent of the existing EMA Trend Mind/EMA Slope Blocker below (a
   //--- DIRECTIONAL veto, not a neutrality detector - untouched by this gate).
   if(g_activePing.emaNeutral)
     {
      //--- 2026-09-12, explicit operator request (forensic report Section G): EMA_NEUTRAL_BLOCK's diagnostic
      //--- logging fired on every tick while emaNeutral stayed true (byte-identical fields, since g_activePing
      //--- only refreshes once per newly-closed M1 bar), producing ~55% log volume with zero informational
      //--- value per repeat. Throttled to "log only when g_activePing.barTime changes since the last log",
      //--- the same pattern ACTIVE_PING_WAITING_CROSS already uses (line ~14640). The actual trading gate
      //--- (block-and-return below) is unchanged and still evaluated/enforced on every qualifying tick.
      static datetime lastEmaNeutralLogBarTime = 0;
      if(g_activePing.barTime!=lastEmaNeutralLogBarTime)
        {
         Print(StringFormat("[EMA_NEUTRAL_BLOCK] ema20=%.3f ema50=%.3f ema20Slope=%.5f separation=%.3f atr=%.3f normalizedGap=%.3f crossoverCount=%d action=BLOCK",
               g_activePing.ema20, g_activePing.ema50, g_activePing.emaSlope, g_activePing.gap, g_activePing.atr, g_activePing.normalizedGap, g_activePing.emaCrossoverCount20));
         DashAppendLine("logs.jsonl", StringFormat(
            "{\"time\":\"%s\",\"tag\":\"EMA_NEUTRAL_BLOCK\",\"message\":\"ema20=%.3f ema50=%.3f ema20Slope=%.5f separation=%.3f atr=%.3f normalizedGap=%.3f crossoverCount=%d action=BLOCK\"}",
            DashIsoTime(TimeCurrent()), g_activePing.ema20, g_activePing.ema50, g_activePing.emaSlope, g_activePing.gap, g_activePing.atr, g_activePing.normalizedGap, g_activePing.emaCrossoverCount20));
         Print("KMIE_MarketDNA_Lite: entry skipped - EMA_NEUTRAL_BLOCK active (normalizedGap=", DoubleToString(g_activePing.normalizedGap,3),
               " <= ", DoubleToString(Inp_EMANeutralGapATR,3), ", crossoverCount=", g_activePing.emaCrossoverCount20, ")");
         lastEmaNeutralLogBarTime = g_activePing.barTime;
        }
      return;
     }

   //--- 2026-09-08, explicit operator request ("I need Active should Activate Mark the Area as Block
   //--- removed the market DNA overide"): the Market DNA Regime Allow-List used to be an UNCONDITIONAL
   //--- block here - a disallowed regime (e.g. COMPRESSION) always returned, regardless of anything
   //--- else. Confirmed via AskUserQuestion before implementation: this now mirrors the EXACT same
   //--- pattern EvaluateEntryApproval() already established for OPPORTUNITY_CONSUMED (see that
   //--- function's own 2026-09-03 ACTIVE_PING ARCHITECTURE comment) - g_activePing.active (corridorActive
   //--- OR slopeActive, evaluated once per new closed M1 bar - see EvaluateActivePing()/ClassifyActivePing())
   //--- is now ALSO the override for the regime allow-list, not just for OPPORTUNITY_CONSUMED. When
   //--- ACTIVE_PING is active, a disallowed regime no longer blocks a fresh entry here. g_dnaState/
   //--- CurrentRegimeAllowed() themselves are completely unchanged - only this ONE call site's use of
   //--- the result is now conditional on !g_activePing.active, same as the existing OPP_CONSUMED gate.
   if(!CurrentRegimeAllowed(effDnaState) && !g_activePing.active)
     {
      Print("KMIE_MarketDNA_Lite: entry skipped - regime ", DnaName(effDnaState), " is blocked (Market DNA Regime Allow-List, ACTIVE_PING not active).");
      return;
     }

   //--- 2026-09-23, M15 PARALLEL PIPELINE, explicit operator request ("M15 should ALSO be required to
   //--- agree, alongside M1 and M5"): this gate is extended below from a 2-way M1+M5 agreement check into
   //--- a genuine 3-way M1+M5+M15 agreement check - mindsAgree/dnaOk/vote-count-minimum all extended to
   //--- also read the M15 globals, and the tag renamed M1_M5_AGREEMENT_GATE -> M1_M5_M15_AGREEMENT_GATE
   //--- throughout (Print()/logs.jsonl "tag" field) to accurately reflect the new 3-way scope.
   //--- 2026-09-16, M5 PARALLEL PIPELINE: BOTH-mode M1/M5 agreement gate. Inserted immediately after the
   //--- DNA-regime-allow gate above, before the vote-count gate below - only ever evaluated when
   //--- Inp_DnaTimeframeMode==DNA_TF_BOTH (M1_ONLY/M5_ONLY never reach this block, so their behavior is
   //--- completely unaffected - see M1M5_AGREEMENT_GATE_TEST5).
   //--- 2026-09-16, explicit operator request ("Ye Make that" [drop the DNA-direction-must-match
   //--- requirement] "but Choppy and Volatility Compressor should be Off on both M1 and M5", clarified
   //--- via AskUserQuestion: "DNA should be only used for Choppy and Volatility Compressor - they both
   //--- should be false"): the original dnaAgrees check (DnaDirectionOf(g_dnaState)==
   //--- DnaDirectionOf(g_dnaStateM5)) is REPLACED, not merely relaxed - DNA's ONLY remaining role in this
   //--- gate is now a direct CHOPPY/VOLATILITY_COMPRESSION exclusion, checked independently on BOTH
   //--- timeframes (g_dnaState AND g_dnaStateM5) - if EITHER timeframe's own regime is currently
   //--- LDNA_CHOPPY or LDNA_VOLATILITY_COMPRESSION, the gate blocks, regardless of what direction either
   //--- DNA reading points. A momentary M1-vs-M5 DNA-DIRECTION mismatch (e.g. STRONG_UPTREND vs
   //--- PULLBACK_UP - both up-flavored, but not identical states) no longer blocks an otherwise-agreeing
   //--- entry - only a genuinely choppy/compressed regime on either timeframe does.
   //--- 2026-09-16, explicit operator request ("Votes Agree should be M1 => 8 Votes and M5 => 6 Votes is
   //--- eligible"): ADDITIONAL vote-COUNT thresholds, on top of the Minds-agreement check (not a
   //--- replacement - confirmed via AskUserQuestion). M1's winning-side vote count must clear the EA's
   //--- existing Inp_MindsVoteMinCount; M5's winning-side vote count must clear the new
   //--- Inp_M5MindsVoteMinCount. Both must pass in ADDITION to mindsAgree/dnaOk above before BOTH mode
   //--- allows the entry through.
   if(Inp_DnaTimeframeMode == DNA_TF_BOTH)
     {
      //--- 2026-09-23, explicit operator request ("M15 should ALSO be required to agree, alongside M1 and
      //--- M5"): mindsAgree extended from the old 2-way M1==M5 check into a clean 3-way "all three
      //--- timeframes agree" check - all three non-WAIT AND all three identical, written as one natural
      //--- expression rather than a bolted-on nested condition.
      //--- 2026-09-24, explicit operator request ("M15 DNA and Minds Votes turn off shouldn't have trade
      //--- excute weight only M1 and M5"): every M15-specific term below is now gated behind
      //--- Inp_M15GateEnabled (default true, safe rollback - same convention as every other new gate
      //--- toggle this session). When false, mindsAgree/dnaOk/the vote-threshold composition all
      //--- collapse back to EXACTLY the old 2-way M1+M5-only logic (M15's own non-WAIT/equality/Choppy/
      //--- vote-count terms are simply short-circuited to "true", i.e. never able to block) - M15 itself
      //--- keeps computing (g_dnaStateM15/g_mindsVoteDirM15/g_mindsM15[]/the dashboard cards/
      //--- entry_dna.jsonl fields) completely untouched, only its ROLE in this gate is toggled.
      bool mindsAgree = (g_mindsVoteDir!=LDIR_WAIT) && (g_mindsVoteDirM5!=LDIR_WAIT)
                         && (!Inp_M15GateEnabled || g_mindsVoteDirM15!=LDIR_WAIT)
                         && (g_mindsVoteDir==g_mindsVoteDirM5)
                         && (!Inp_M15GateEnabled || g_mindsVoteDirM5==g_mindsVoteDirM15);
      bool m1DnaIsChoppyOrCompressed = (g_dnaState==LDNA_CHOPPY) || (g_dnaState==LDNA_VOLATILITY_COMPRESSION);
      //--- 2026-09-24, explicit operator request ("remove M5 DNA blocking the trade when Market is
      //--- VOLATILITY COMPRESSION"): M5's CHOPPY exclusion is UNCHANGED (still blocks) - only the
      //--- VOLATILITY_COMPRESSION half is now toggleable, gated behind Inp_M5VolCompressionBlockEnabled
      //--- (default true = today's exact behavior; the live .set sets this false per the operator's
      //--- request). M1's own Choppy/VolComp exclusion immediately above is untouched - this only relaxes
      //--- M5's role. Does not touch M15's own exclusion (m15DnaIsChoppyOrCompressed) below either -
      //--- narrowly scoped to exactly what was asked.
      bool m5DnaIsChoppyOrCompressed = (g_dnaStateM5==LDNA_CHOPPY) ||
                                        (Inp_M5VolCompressionBlockEnabled && g_dnaStateM5==LDNA_VOLATILITY_COMPRESSION);
      //--- 2026-09-23, M15 twin of the M1/M5 Choppy/VolComp exclusion immediately above - same disqualifying
      //--- states, same logic shape, just reading g_dnaStateM15 too. If EITHER of the three timeframes is
      //--- currently CHOPPY or VOLATILITY_COMPRESSION, the gate blocks.
      //--- 2026-09-24: forced false (never disqualifying) when Inp_M15GateEnabled=false.
      bool m15DnaIsChoppyOrCompressed = Inp_M15GateEnabled && ((g_dnaStateM15==LDNA_CHOPPY) || (g_dnaStateM15==LDNA_VOLATILITY_COMPRESSION));
      bool dnaOk = !m1DnaIsChoppyOrCompressed && !m5DnaIsChoppyOrCompressed && !m15DnaIsChoppyOrCompressed;
      int  m1WinningVotesForGate = (g_mindsVoteDir==LDIR_BUY) ? g_buyVotes   : g_sellVotes;
      int  m5WinningVotesForGate = (g_mindsVoteDirM5==LDIR_BUY) ? g_buyVotesM5 : g_sellVotesM5;
      //--- 2026-09-23, M15 twin of the M1/M5 winning-side vote count immediately above.
      int  m15WinningVotesForGate = (g_mindsVoteDirM15==LDIR_BUY) ? g_buyVotesM15 : g_sellVotesM15;
      bool m1VotesMeetMin = m1WinningVotesForGate >= Inp_MindsVoteMinCount;
      bool m5VotesMeetMin = m5WinningVotesForGate >= Inp_M5MindsVoteMinCount;
      //--- 2026-09-23, explicit operator request: M15's own winning-side vote count must ALSO clear its
      //--- own dedicated Inp_M15MindsVoteMinCount (default 4) - in ADDITION to m1VotesMeetMin/m5VotesMeetMin
      //--- above, same "both/all must pass" composition. No VolComp-style exception is introduced for M15
      //--- here - this task's scope leaves the existing M1/M5-only exception mechanism (if any) untouched;
      //--- none was found live in this gate (grep-verified: no STRONG_UPTREND/STRONG_DOWNTREND-conditioned
      //--- lowering of Inp_M5MindsVoteMinCount exists anywhere in this file), so there is nothing for M15 to
      //--- be inconsistently excluded from - M15's vote-count check applies uniformly, same as M1/M5's.
      //--- 2026-09-24: forced true (never blocking) when Inp_M15GateEnabled=false.
      bool m15VotesMeetMin = !Inp_M15GateEnabled || (m15WinningVotesForGate >= Inp_M15MindsVoteMinCount);

      //--- 2026-09-18, explicit operator request ("bot not able find the market even its showing
      //--- downtrend but it bot stil taking the buy trade... find the root cause") - live-verified root
      //--- cause: dnaOk above ONLY excludes CHOPPY/VOLATILITY_COMPRESSION (per the 2026-09-16 change that
      //--- deliberately dropped the old strict M1==M5 DNA-STATE match) - it does NOT check whether M1's
      //--- own DNA DIRECTION contradicts the trade's own direction. Real example that got through:
      //--- ticket 2367950950 (2026-09-17T23:13 UTC) - g_dnaState=STRONG_DOWNTREND (score=72.02, a
      //--- confident reading) while Minds voted BUY 8-5 on M1 (barely cleared Inp_MindsVoteMinCount) and
      //--- M5 also voted BUY - mindsAgree=true, dnaOk=true (STRONG_DOWNTREND isn't Choppy/VolComp), both
      //--- vote thresholds cleared, so the gate let a BUY through while its OWN M1 DNA classifier was
      //--- actively reading STRONG_DOWNTREND. FIX (confirmed via AskUserQuestion - "re-add a DNA-direction
      //--- sanity check", NOT the old strict M1==M5 state match this file already removed once): block
      //--- only when M1 DNA's own direction (DnaDirectionOf(g_dnaState), the SAME pure helper the removed
      //--- 2026-09-16 check used - reused verbatim, not reimplemented) is a directional regime (BUY or
      //--- SELL, never WAIT - VOLATILITY_EXPANSION/NEUTRAL/etc. all map to WAIT and are exempt, never
      //--- blocked by this check) that is the OPPOSITE of the trade's own effVoteDir. M5's own DNA
      //--- direction is deliberately NOT checked here (M5 DNA disagreeing with M1 DNA was the exact
      //--- relaxation the operator asked for on 2026-09-16 and is NOT reinstated) - only a same-timeframe
      //--- M1-DNA-vs-M1-trade-direction contradiction is blocked. Toggleable
      //--- (Inp_DnaDirectionSanityCheckEnabled, default true) for a safe rollback, same convention as
      //--- every other new gate toggle added this session.
      ENUM_LITE_DIR m1DnaDirection = DnaDirectionOf(effDnaState);
      bool dnaDirectionContradicts = Inp_DnaDirectionSanityCheckEnabled
         && (m1DnaDirection!=LDIR_WAIT) && (effVoteDir!=LDIR_WAIT) && (m1DnaDirection!=effVoteDir);

      //--- 2026-09-24, explicit operator request ("If Minds Votes are passed than DNA shouldn't
      //--- considered for Buy or sell trade"), NARROWED same day per explicit operator follow-up
      //--- ("don't change" the Choppy/VolComp exclusion table): dnaOk (the m1/m5/m15
      //--- ChoppyOrCompressed exclusion immediately above) is ALWAYS enforced, unconditionally,
      //--- regardless of Minds Votes - this override does NOT touch it. ONLY dnaDirectionContradicts
      //--- (the M1-DNA-direction-vs-trade-direction sanity check) is skippable: once mindsAgree AND all
      //--- three vote-count minimums clear, dnaDirectionContradicts is skipped when
      //--- Inp_MindsVoteOverridesDnaEnabled=true. Toggleable for a safe rollback to the exact prior
      //--- "direction check always considered" behavior (false). dnaOk/dnaDirectionContradicts
      //--- THEMSELVES are computed completely unchanged above - only how dnaDirectionContradicts is
      //--- COMBINED into the final decision changed, so every existing self-test of dnaOk's/
      //--- dnaDirectionContradicts' own formulas remains valid untouched.
      bool mindsVotesPassed = mindsAgree && m1VotesMeetMin && m5VotesMeetMin && m15VotesMeetMin;
      bool directionCheckConsidered = !Inp_MindsVoteOverridesDnaEnabled || !mindsVotesPassed;
      bool dnaConsidered = directionCheckConsidered; // kept for the diagnostic log line below, same name as before
      bool dnaBlocks = !dnaOk || (directionCheckConsidered && dnaDirectionContradicts);

      if(!mindsVotesPassed || dnaBlocks)
        {
         DashAppendLine("logs.jsonl", StringFormat("{\"time\":\"%s\",\"tag\":\"M1_M5_M15_AGREEMENT_GATE\",\"message\":\"entry skipped - M1/M5/M15 disagreement or below vote threshold, or (DNA considered AND blocked regime/M1 DNA direction contradiction) (m15GateEnabled=%s mindsAgree=%s dnaOk=%s m1Choppy/Comp=%s m5Choppy/Comp=%s m15Choppy/Comp=%s m1Votes=%d/%d m5Votes=%d/%d m15Votes=%d/%d dnaDirectionContradicts=%s mindsVotesPassed=%s dnaConsidered=%s m1DnaState=%s m1DnaDirection=%s tradeDirection=%s)\"}", TimeToString(TimeCurrent(), TIME_DATE|TIME_SECONDS), Inp_M15GateEnabled?"true":"false", mindsAgree?"true":"false", dnaOk?"true":"false", m1DnaIsChoppyOrCompressed?"true":"false", m5DnaIsChoppyOrCompressed?"true":"false", m15DnaIsChoppyOrCompressed?"true":"false", m1WinningVotesForGate, Inp_MindsVoteMinCount, m5WinningVotesForGate, Inp_M5MindsVoteMinCount, m15WinningVotesForGate, Inp_M15MindsVoteMinCount, dnaDirectionContradicts?"true":"false", mindsVotesPassed?"true":"false", dnaConsidered?"true":"false", DnaName(effDnaState), DirName(m1DnaDirection), DirName(effVoteDir)));
         Print("KMIE_MarketDNA_Lite: entry skipped - M1_M5_M15_AGREEMENT_GATE (m15GateEnabled=", Inp_M15GateEnabled?"true":"false",
               " mindsAgree=", mindsAgree?"true":"false",
               " dnaOk=", dnaOk?"true":"false",
               " m1Votes=", m1WinningVotesForGate, "/", Inp_MindsVoteMinCount,
               " m5Votes=", m5WinningVotesForGate, "/", Inp_M5MindsVoteMinCount,
               " m15Votes=", m15WinningVotesForGate, "/", Inp_M15MindsVoteMinCount,
               " dnaDirectionContradicts=", dnaDirectionContradicts?"true":"false",
               " mindsVotesPassed=", mindsVotesPassed?"true":"false",
               " dnaConsidered=", dnaConsidered?"true":"false",
               " m1DnaState=", DnaName(effDnaState), " m1DnaDirection=", DirName(m1DnaDirection), " tradeDirection=", DirName(effVoteDir), ")");
         return;
        }
     }

   int openCount = CountOpenPositions();
   if(openCount>0)
     {
      Print("KMIE_MarketDNA_Lite: entry skipped - ", openCount, " position(s) already open (this EA's symbol+magic).");
      return;
     }
   int winningCount = (effVoteDir==LDIR_BUY) ? effBuyVotes : effSellVotes;
   if(winningCount<Inp_MindsVoteMinCount)
     {
      Print("KMIE_MarketDNA_Lite: entry skipped - ", DirName(effVoteDir), " only has ", winningCount,
            "/", KMIE_LITE_MIND_COUNT, " votes, below Inp_MindsVoteMinCount=", Inp_MindsVoteMinCount);
      return;
     }

   //--- 2026-09-08, explicit operator request ("Why my EMA Slope Blocker not working... trade should
   //--- be blocked" - clarified via AskUserQuestion: a NEW, genuine entry-blocking gate, not the
   //--- existing EMA Trend Mind's own single vote, which only ever forces ONE of 18 votes and never
   //--- blocked anything). Confirmed via AskUserQuestion: SYMMETRIC - a 2-bar-CONFIRMED EMA20/50
   //--- relationship in one direction blocks a fresh entry attempt in the OPPOSITE direction outright,
   //--- regardless of what every other Mind/DNA/Entry Approval gate above already decided. Placed here,
   //--- alongside MaybeExecute()'s own existing pre-execution gate sequence (confirmed via
   //--- AskUserQuestion) - NOT inside EvaluateEntryApproval()/Opportunity Lifecycle/ACTIVE_PING, which
   //--- remain completely untouched. Reads g_minds[14].direction - the EMA Trend Mind's OWN already-
   //--- published result (2-bar-confirmation logic unchanged, see EvaluateEmaTrendMind()'s own header) -
   //--- never a second/duplicate EMA calculation. When the EMA Trend Mind itself reads WAIT (unconfirmed,
   //--- or gap/ATR/slope don't agree), this gate imposes NO restriction - g_minds[14].direction==LDIR_WAIT
   //--- never blocks either direction.
   //--- 2026-09-14 NOTE: Inp_EMATrendEnabled now defaults false (explicit operator request, "EMA 20 and
   //--- EMA 50 should be inactive") - EvaluateEmaTrendMind() always sets g_minds[14].direction=LDIR_WAIT
   //--- now, so this gate's own condition (g_minds[14].direction!=LDIR_WAIT) can never be true anymore -
   //--- this gate is PERMANENTLY DORMANT (never blocks), by direct consequence of that same deactivation,
   //--- not touched here itself. Gate logic/code left exactly as-is (same "disconnect the input, keep the
   //--- gate" pattern as everywhere else this session) - if Inp_EMATrendEnabled is ever re-enabled, this
   //--- gate resumes functioning automatically with zero further code change.
   //--- 2026-09-16, M5 PARALLEL PIPELINE: this gate is left reading the raw M1 g_minds[14]/g_mindsVoteDir
   //--- UNCHANGED, per the approved plan's own explicit scope - it is already permanently dormant
   //--- (Inp_EMATrendEnabled defaults false, see the 2026-09-14 note above), not worth extending to
   //--- M5/eff* for a gate that never fires either way.
   if(g_minds[14].direction!=LDIR_WAIT && g_minds[14].direction!=g_mindsVoteDir)
     {
      Print("KMIE_MarketDNA_Lite: entry skipped - EMA20/50 2-bar-confirmed direction=", DirName(g_minds[14].direction),
            " opposes intended entry direction=", DirName(g_mindsVoteDir), " (EMA_SLOPE_BLOCKER)");
      DashAppendLine("logs.jsonl", StringFormat(
            "{\"time\":\"%s\",\"tag\":\"EMA_SLOPE_BLOCKER\",\"message\":\"emaConfirmedDir=%s intendedDir=%s reason=OPPOSING_2BAR_CONFIRMED_EMA\"}",
            DashIsoTime(TimeCurrent()), DirName(g_minds[14].direction), DirName(g_mindsVoteDir)));
      return;
     }

   //--- 2026-09-09, explicit operator request (EMA_TREND_CONTINUATION / EMA_TREND_EXTENDED classification):
   //--- distinguishes a healthy directional continuation (safe to proceed to 2-bar confirmation) from an
   //--- overextended trend (direction still valid, but price too far from EMA20 to chase - wait for
   //--- pullback, NOT a block, NOT a reversal). A widening EMA20/EMA50 gap alone is NEVER a blocker here -
   //--- only g_activePing.emaEntryState==EMA_ENTRY_TREND_EXTENDED (specifically the price-to-EMA20 distance
   //--- in ATR units) gates this, independent of gap width itself.
   //--- 2026-09-14 CORRECTION: the "EMA20"/"EMA20/EMA50" references in this 2026-09-09 note are now stale -
   //--- the 2026-09-11 EMA35 architecture rewire changed ClassifyEmaEntryState()'s own basis to EMA35
   //--- exclusively (refClose vs ema35, normalized by ATR - zero ema20/ema50 parameters, see that function's
   //--- current signature). The GATE LOGIC below is unchanged; only what extensionATR actually measures
   //--- changed, in an earlier task. Original 2026-09-09 wording left as historical record, not edited.
   //--- EMA_ENTRY_NEUTRAL is NOT re-blocked here
   //--- (Gate B, ~line 13955, already handled that case earlier and would have returned by now if neutral -
   //--- this gate only ever sees EMA_ENTRY_TREND_CONTINUATION or EMA_ENTRY_TREND_EXTENDED in practice, but
   //--- defensively falls through/does not block on NEUTRAL here too, since re-blocking an already-passed
   //--- gate on a stale/differently-timed read would be redundant, not additive). Stateless/memoryless -
   //--- this gate simply returns (blocks THIS tick's execution attempt) when EXTENDED; it does not set any
   //--- permanent block flag, does not reverse direction, and does not prevent a LATER tick (once price
   //--- pulls back and extensionATR drops back to CONTINUATION) from proceeding normally through this same
   //--- gate check next time it's reached - g_activePing.emaEntryState is re-evaluated fresh every new
   //--- closed bar, so no separate wait-state tracking is required.
   //--- 2026-09-14, explicit operator request ("Turn off ATR function"): the EMA_TREND_EXTENDED gate below
   //--- is DISCONNECTED - entries no longer hold for being "too far extended from EMA35." The underlying
   //--- calculation (ClassifyEmaEntryState(), g_activePing.emaEntryState/extensionATR, Inp_EMAExtensionMaxATR)
   //--- is UNCHANGED and still computed/populated every closed bar for diagnostic/dashboard display - only
   //--- this LIVE CHECK is disabled, same "disconnect the call, keep the calculation" convention already
   //--- used for the five legacy TP/SL managers and Mind #14 earlier this session. To re-enable, uncomment
   //--- the if-block below exactly as it was.
   //--- if(g_activePing.emaEntryState==EMA_ENTRY_TREND_EXTENDED)
   //---   {
   //---    static ENUM_LITE_DIR lastExtendedBlockDir = LDIR_WAIT;
   //---    if(g_mindsVoteDir!=lastExtendedBlockDir)
   //---      {
   //---       Print(StringFormat("[ENTRY_GATE] gate=EMA_EXTENSION direction=%s extensionATR=%.3f", DirName(g_mindsVoteDir), g_activePing.extensionATR));
   //---       DashAppendLine("logs.jsonl", StringFormat(
   //---          "{\"time\":\"%s\",\"tag\":\"ENTRY_GATE\",\"message\":\"gate=EMA_EXTENSION direction=%s extensionATR=%.3f\"}",
   //---          DashIsoTime(TimeCurrent()), DirName(g_mindsVoteDir), g_activePing.extensionATR));
   //---       lastExtendedBlockDir = g_mindsVoteDir;
   //---      }
   //---    Print("KMIE_MarketDNA_Lite: entry skipped - EMA_TREND_EXTENDED (extensionATR=", DoubleToString(g_activePing.extensionATR,3),
   //---          " > Inp_EMAExtensionMaxATR=", DoubleToString(Inp_EMAExtensionMaxATR,3), ") - waiting for pullback toward EMA35");
   //---    return;
   //---   }

   //--- 2026-09-09, explicit operator request (TWO-BAR 50%-TIME-PROGRESS CONFIRMATION - Gate C of 3 new
   //--- entry-protection gates): requires two consecutive M1 bars, each having reached >=50% of its own
   //--- elapsed time, with Minds+DNA+CandleWeightage still agreeing at each checkpoint, before a
   //--- borderline entry executes - see EvaluateBarConfirmation()/EvaluateBarConfirmationCore()'s own
   //--- header for the full state machine. Stage-transition logging happens INSIDE
   //--- EvaluateBarConfirmationCore() itself (simpler than detecting the transition from here).
   //--- 2026-09-16, M5 PARALLEL PIPELINE: M5_ONLY mode calls the M5 Bar Confirmation state machine
   //--- (reading g_mindsVoteDirM5/g_dnaStateM5/g_barConfirmationM5 throughout) instead of the M1 one.
   //--- M1_ONLY and BOTH both use the M1 state machine (BOTH's own M1/M5 agreement requirement is a
   //--- separate, additional gate above - this call is unaffected by it).
   //--- 2026-09-16, explicit operator request ("turn off bars confirmation 2 time"): when
   //--- Inp_BarConfirmationEnabled=false, this ENTIRE gate is skipped (never called, never logged) -
   //--- hands off straight to the ACTIVE_PING price-cross gate below, exactly as if it had already
   //--- returned true. Default true keeps today's exact existing behavior unchanged.
   if(Inp_BarConfirmationEnabled)
     {
      bool barConfirmOk = (Inp_DnaTimeframeMode==DNA_TF_M5_ONLY)
         ? EvaluateBarConfirmationM5(effVoteDir==LDIR_BUY?1:-1)
         : EvaluateBarConfirmation(effVoteDir==LDIR_BUY?1:-1);
      if(!barConfirmOk)
        {
         int barConfirmStageForLog = (Inp_DnaTimeframeMode==DNA_TF_M5_ONLY) ? g_barConfirmationM5.stage : g_barConfirmation.stage;
         Print("KMIE_MarketDNA_Lite: entry skipped - BAR_CONFIRMATION not yet ready (stage=", barConfirmStageForLog,
               " direction=", DirName(effVoteDir), ")");
         return;
        }
     }

   //--- 2026-09-16, explicit operator request ("Yesterday we have implemented the Reverse trade algo
   //--- and bars confirmation i would remove that fully"): the Pullback Reversal Check (PullbackReversalState/
   //--- EvaluatePullbackReversalCheck()/its own MaybeExecute() block/its self-tests) built 2026-09-15 has
   //--- been fully deleted, not merely disconnected - confirmed via AskUserQuestion. Bar Confirmation
   //--- (immediately above) now hands off directly to the ACTIVE_PING price-cross gate below, exactly as
   //--- it did before that feature existed.

   //--- 2026-09-11, explicit operator request (ACTIVE_PING/EMA35 ARCHITECTURE REWIRE - Part D/F): NEW GATE,
   //--- inserted strictly between Bar Confirmation (immediately above) and one-punch-per-bar (immediately
   //--- below) - the exact insertion point confirmed by the completed audit (nothing existed between those
   //--- two gates before this task). Once Bar Confirmation establishes agreement, this gate captures the
   //--- live EMA35 value as a frozen trigger price and waits for a genuine price-cross of that frozen level
   //--- before permitting execution to proceed - see CheckActivePingPriceCross()'s own header for the full
   //--- capture/wait/cross/invalidate state machine and post-cross validation.
   //--- 2026-09-16, M5 PARALLEL PIPELINE: direction argument only switched to effVoteDir for consistency
   //--- with every gate above/below - the underlying ACTIVE_PING/EMA35 state machine itself
   //--- (g_activePing/g_pendingPriceCross/CheckActivePingPriceCross()) remains M1-only/untouched, per the
   //--- approved plan's own explicit scope (not part of the DNA/Minds parallel pipeline).
   if(!CheckActivePingPriceCross(effVoteDir==LDIR_BUY ? 1 : -1))
     {
      Print("KMIE_MarketDNA_Lite: entry skipped - ACTIVE_PING price-cross not yet triggered (direction=", DirName(effVoteDir),
            " pendingDirection=", DirName(g_pendingPriceCross.pendingDirection), ")");
      return;
     }

   //--- One punch per NEW M1 bar only - see g_lastSignalBarTime's own header comment.
   //--- 2026-09-11, explicit operator request (execution-path observability gap - the 2026-09-11
   //--- 02:16-02:17 investigation found this gate's own Print() has no logs.jsonl counterpart, so an
   //--- ENTRY_APPROVAL=APPROVED signal silently blocked here left no forensic trail at all). Structured
   //--- record ADDED alongside the existing Print() - the blocking condition/behavior itself is
   //--- completely unchanged, this is observability only.
   datetime curBarTime = iTime(g_symbol, PERIOD_M1, 0);
   if(curBarTime==g_lastSignalBarTime)
     {
      Print("KMIE_MarketDNA_Lite: entry skipped - already punched a trade this M1 bar (", TimeToString(curBarTime), ")");
      DashAppendLine("logs.jsonl", StringFormat(
         "{\"time\":\"%s\",\"tag\":\"ONE_PUNCH_PER_BAR_BLOCKED\",\"message\":\"symbol=%s direction=%s currentBarTime=%s signalBarTime=%s reason=ONE_PUNCH_PER_BAR\"}",
         DashIsoTime(TimeCurrent()), g_symbol, DirName(effVoteDir), TimeToString(curBarTime), TimeToString(g_lastSignalBarTime)));
      return;
     }

   //--- 2026-08-21, Entry Intelligence Step 7 (explicit operator request): NEW gate 6, after all
   //--- existing gates 1-5 above and unconditionally before SendMarketOrder(). Reads ONLY the
   //--- already-published g_entryApproval.approved (Step 6's own deterministic reading) - no formula
   //--- from Steps 1-6 is recalculated here.
   if(!g_entryApproval.approved)
     {
      Print("KMIE_MarketDNA_Lite: entry skipped - Entry Approval BLOCKED (reason=", BlockReasonName(g_entryApproval.blockReason), ")");
      return;
     }

   //--- 2026-09-02, explicit operator request (ROOT CAUSE FIX for the OVERSHOOT LOCKOUT incident
   //--- documented above IsOvershootLockoutActive()): that lockout only engages AFTER an overshoot
   //--- has already happened - it never explained HOW a single Inp_TicketsPerSignal=5 send loop could
   //--- end up with 10 real open positions when the EA's own count read "ticketsSent=5/5" (i.e. the
   //--- loop itself never miscounted). The actual mechanism: this account has two independent .mq5
   //--- files (KMIE_MarketDNA_Lite and _Old) which BOTH default to the SAME Inp_MagicNumber=100200,
   //--- and MT5 global variables are shared across every EA instance/chart running in this ONE
   //--- terminal. If two instances are attached at once, both can pass their own gates within the
   //--- same tick/bar - neither has yet seen the other's fills via PositionsTotal() - and each then
   //--- runs its own unconditional N-iteration send loop: 5+5=10, with each instance's own log
   //--- correctly (but misleadingly, in isolation) showing "ticketsSent=5/5". Two changes close this:
   //---   1. A terminal-wide mutex (GlobalVariableSetOnCondition - atomic across ALL EA instances in
   //---      this terminal, unlike a plain global bool, which each instance would have its own copy
   //---      of) serializes the whole send sequence per Inp_MagicNumber, so two instances can never
   //---      interleave their SendMarketOrder() calls.
   //---   2. The send loop now rechecks REAL broker-side open position count (CountOpenPositions(),
   //---      already symbol+magic filtered) before EVERY single ticket, not just once up front - so
   //---      even the instance that acquires the mutex SECOND (after the first instance's batch has
   //---      already filled) sees those now-real positions and sends 0/partial tickets instead of
   //---      blindly firing its own full, separate batch of Inp_TicketsPerSignal.
   //--- This is defense-in-depth, not a substitute for making sure only ONE EA instance is actually
   //--- attached to this symbol/magic at a time - check the terminal's open chart tabs if this
   //--- Print() ever fires.
   //--- 2026-09-03: acquire/release now go through the shared AcquireExecutionLock()/
   //--- ReleaseExecutionLock() helpers (duplication/drift audit finding M1) - same lock name/
   //--- semantics as before, just no longer a locally re-typed copy of the sequence.
   //--- 2026-09-11, explicit operator request (execution-path observability gap - same investigation as
   //--- the one-punch-per-bar block above): this gate's own Print() also had no logs.jsonl counterpart.
   //--- Structured record ADDED alongside the existing Print() - lock acquisition behavior itself is
   //--- completely unchanged, this is observability only.
   if(!AcquireExecutionLock())
     {
      Print("KMIE_MarketDNA_Lite: entry skipped - another EA instance sharing Inp_MagicNumber=", Inp_MagicNumber,
            " is mid-execution right now (see this block's own header - likely two chart instances of the same magic number); will re-evaluate next tick.");
      DashAppendLine("logs.jsonl", StringFormat(
         "{\"time\":\"%s\",\"tag\":\"EXECUTION_LOCK_BLOCKED\",\"message\":\"symbol=%s direction=%s magicNumber=%d reason=EXECUTION_LOCK_BUSY\"}",
         DashIsoTime(TimeCurrent()), g_symbol, DirName(effVoteDir), Inp_MagicNumber));
      return;
     }

   //--- 2026-09-09, explicit operator request ([ENTRY_GATE] consolidated summary): one line logged only
   //--- when the OVERALL final allow/block verdict transitions INTO "everything passed" (this fall-
   //--- through point) from the previous tick's verdict - individual BLOCK cases are already separately
   //--- logged by each specific gate's own tag above (POST_LOSS_LOCK/EMA_NEUTRAL_BLOCK/EMA_SLOPE_BLOCKER/
   //--- BAR_CONFIRMATION/etc), so this specifically marks the more useful "everything passed" transition.
   //--- 2026-09-16, M5 PARALLEL PIPELINE: mind/dna/candleWeight fields below now read eff*/the mode-
   //--- appropriate RunningCandleWeightOk variant, so this summary always reflects whichever timeframe's
   //--- globals actually drove the just-passed gate sequence.
   {
      static bool lastEntryGateAllowed = false;
      if(!lastEntryGateAllowed)
        {
         bool candleWeightForLog = (Inp_DnaTimeframeMode==DNA_TF_M5_ONLY) ? RunningCandleWeightOkM5(effVoteDir==LDIR_BUY?1:-1) : RunningCandleWeightOk(effVoteDir==LDIR_BUY?1:-1);
         Print(StringFormat("[ENTRY_GATE] postLossLock=false emaStructure=false mind=%s dna=%s candleWeight=%s barConfirmation=true FINAL=ALLOW",
               DirName(effVoteDir), DnaName(effDnaState), candleWeightForLog?"true":"false"));
         DashAppendLine("logs.jsonl", StringFormat(
            "{\"time\":\"%s\",\"tag\":\"ENTRY_GATE\",\"message\":\"postLossLock=false emaStructure=false mind=%s dna=%s candleWeight=%s barConfirmation=true FINAL=ALLOW\"}",
            DashIsoTime(TimeCurrent()), DirName(effVoteDir), DnaName(effDnaState), candleWeightForLog?"true":"false"));
         lastEntryGateAllowed = true;
        }
   }

   //--- Inp_TicketsPerSignal - fires this many separate tickets for the SAME passing signal,
   //--- each independently sized/SL'd/TP'd via SendMarketOrder(). 1 = no duplication.
   //--- 2026-08-20: Market DNA state logged here (Print, not Comment) so every batch's regime is
   //--- recoverable from the Experts log afterward - previously only visible on the live dashboard.
   //--- 2026-09-16, M5 PARALLEL PIPELINE: effDnaScore mirrors effDnaState/effVoteDir for this log line
   //--- only (diagnostic) - g_dnaScore itself is never substituted anywhere else, per the approved plan's
   //--- own eff* scope (dnaScore was never listed as a gating value).
   double effDnaScore = (Inp_DnaTimeframeMode==DNA_TF_M5_ONLY) ? g_dnaScoreM5 : g_dnaScore;
   Print("KMIE_MarketDNA_Lite: firing batch under Market DNA=", DnaName(effDnaState), " (score=", DoubleToString(effDnaScore,1),
         ") direction=", DirName(effVoteDir), " votes=", winningCount, "/", KMIE_LITE_MIND_COUNT);
   int ticketsWanted = MathMax(1, Inp_TicketsPerSignal);
   int ticketsSent = 0;
   //--- 2026-09-24, explicit operator request ("if there signal for one ticket than it should be applied
   //--- to all the open trade in TP and SL as well" - confirmed via AskUserQuestion: ONE shared SL/TP for
   //--- every ticket in this batch, computed once). batchSharedSL/batchSharedTP start at 0.0 (meaning
   //--- "not yet captured") - the FIRST ticket in this loop still gets its own freshly-computed SL/TP
   //--- (SendMarketOrder()'s own sharedSL/sharedTP parameters default to 0.0 = no override), but its
   //--- ACTUAL resulting sl/tp (via the new outActualSL/outActualTP out-parameters) is captured into these
   //--- two locals the instant it succeeds - every SUBSEQUENT ticket in this same loop then passes them
   //--- back in as sharedSL/sharedTP, so SendMarketOrder() reuses them verbatim instead of recomputing its
   //--- own independent structural SL/15-bar-window-derived TP from its own (slightly different) fill
   //--- price. This batch's own opportunityId (g_opportunity.id, stable for the whole loop) is the
   //--- existing, already-persisted (entry_dna.jsonl's own "opportunityId" field) identifier that
   //--- TradeManagementEngine() will later use to keep these same siblings' ONGOING SL/TP updates synced
   //--- too - see g_tme[].batchOpportunityId's own header for that half of this task.
   double batchSharedSL = 0.0, batchSharedTP = 0.0;
   for(int t=0; t<ticketsWanted; t++)
     {
      //--- Re-check REAL broker-side position count immediately before EVERY send, not just once up
      //--- front - see this block's own root-cause header above for why this specifically is what
      //--- caps the total at Inp_TicketsPerSignal even when a second EA instance is mid-batch
      //--- concurrently.
      if(CountOpenPositions()>=Inp_TicketsPerSignal)
        {
         Print("KMIE_MarketDNA_Lite: batch stopped early at ticket ", t, "/", ticketsWanted,
               " - open positions already reached Inp_TicketsPerSignal=", Inp_TicketsPerSignal);
         break;
        }
      //--- 2026-09-16, M5 PARALLEL PIPELINE: SendMarketOrder()'s own direction argument now uses
      //--- effVoteDir instead of the raw M1 g_mindsVoteDir - the only change to SendMarketOrder()'s own
      //--- call site; SendMarketOrder()'s internal body (RunningCandleWeightOk() pre-check, SL/TP,
      //--- RecordEntryDna()) is completely untouched and always M1-based, per the approved plan's scope.
      double thisSentSL = 0.0, thisSentTP = 0.0;
      bool thisSent = SendMarketOrder(effVoteDir==LDIR_BUY ? 1 : -1, thisSentSL, thisSentTP, batchSharedSL, batchSharedTP);
      if(thisSent)
        {
         ticketsSent++;
         //--- Capture only from the FIRST successful send this batch (batchSharedSL still 0.0 means none
         //--- captured yet) - every send after that already received/used the shared values via the
         //--- sharedSL/sharedTP parameters above, so re-capturing would be redundant (and harmless even if
         //--- it did, since thisSentSL/thisSentTP would already equal batchSharedSL/batchSharedTP by then).
         if(batchSharedSL<=0.0 && thisSentSL>0.0) batchSharedSL = thisSentSL;
         if(batchSharedTP<=0.0 && thisSentTP>0.0) batchSharedTP = thisSentTP;
        }
     }
   ReleaseExecutionLock();

   //--- 2026-08-21, Entry Intelligence Step 7.2 (explicit operator request): classify the SAME
   //--- ticketsSent/ticketsWanted counters above into FULL/PARTIAL/FAILED - telemetry only, does
   //--- NOT change which branch runs below. The opportunity-consumption rule is UNCHANGED from
   //--- Step 7: ticketsSent>0 (FULL or PARTIAL alike) still consumes; only ticketsSent==0 does not.
   ENUM_LITE_EXECUTION_STATUS execStatus = (ticketsSent==0) ? EXECUTION_FAILED :
                                            (ticketsSent<ticketsWanted) ? EXECUTION_PARTIAL : EXECUTION_FULL;

   g_executionResult.status        = execStatus;
   g_executionResult.ticketsWanted = ticketsWanted;
   g_executionResult.ticketsSent   = ticketsSent;
   g_executionResult.opportunityId = g_entryApproval.opportunityId;
   g_executionResult.evaluatedTime = curBarTime;

   if(ticketsSent>0)
     {
      g_lastSignalBarTime = curBarTime;

      //--- 2026-09-09, explicit operator request (TWO-BAR 50%-TIME-PROGRESS CONFIRMATION): reset the
      //--- confirmation state machine on every successful send so a stale "confirmed" (stage==2) state
      //--- can never satisfy a later, different signal after this position closes and a fresh setup
      //--- appears. stage=0 alone is sufficient (a stage-0 check ignores the other stale fields), but
      //--- the tracked direction is also cleared for full hygiene.
      g_barConfirmation.stage = 0;
      g_barConfirmation.trackedDirection = LDIR_WAIT;
      g_barConfirmation.bar1Confirmed = false;
      g_barConfirmation.bar2Confirmed = false;
      g_barConfirmation.bar1Time = 0;
      g_barConfirmation.bar2Time = 0;

      //--- Step 7: on ANY successful send (FULL or PARTIAL), the opportunity that was APPROVED for
      //--- this signal is consumed so the same structural move cannot immediately generate another
      //--- trade. On FAILED (ticketsSent==0 despite approval), the opportunity is left untouched.
      if(g_opportunity.active && g_opportunity.id==g_entryApproval.opportunityId)
        {
         g_opportunity.executed     = true;
         g_opportunity.state        = OPP_CONSUMED;
         g_opportunity.consumed     = true;
         g_opportunity.completedTime = curBarTime;
         //--- 2026-08-28, Step 15.4 (explicit operator request, Early Re-Entry): minimal hook - the
         //--- re-entry budget is spent HERE, on a SUCCESSFUL execution of an opportunity Early
         //--- Re-Entry itself minted (isEarlyReEntryOpp), never on mere creation/approval and never
         //--- for a fresh or C2-minted opportunity. This is the ONLY place g_reEntryCount increments.
         //--- No other line in this block is touched.
         if(g_opportunity.isEarlyReEntryOpp) g_reEntryCount++;
        }

      Print(StringFormat("[EXECUTION][SUCCESS] opportunity=%I64u direction=%s executionStatus=%s ticketsSent=%d ticketsWanted=%d opportunityStatus=CONSUMED",
            g_executionResult.opportunityId, DirName(g_mindsVoteDir), ExecutionStatusName(execStatus), ticketsSent, ticketsWanted));
      //--- 2026-08-31, explicit operator request: MT5 was not reliably persisting this EA's Print()
      //--- output to a readable log file, making batch execution counts (ticketsSent vs ticketsWanted)
      //--- untraceable after the fact when investigating extra/phantom broker fills. Mirrors the SAME
      //--- values the Print() above just used - no new computation, diagnostic-only, never read by any
      //--- trading decision.
      DashAppendLine("logs.jsonl", StringFormat(
         "{\"time\":\"%s\",\"tag\":\"EXECUTION_SUCCESS\",\"message\":\"opportunity=%I64u direction=%s executionStatus=%s ticketsSent=%d ticketsWanted=%d opportunityStatus=CONSUMED\"}",
         DashIsoTime(TimeCurrent()), g_executionResult.opportunityId, DirName(g_mindsVoteDir), ExecutionStatusName(execStatus), ticketsSent, ticketsWanted));
     }
   else
     {
      Print(StringFormat("[EXECUTION][FAILED] opportunity=%I64u direction=%s executionStatus=FAILED ticketsSent=%d ticketsWanted=%d opportunityStatus=AVAILABLE",
            g_executionResult.opportunityId, DirName(g_mindsVoteDir), ticketsSent, ticketsWanted));
      DashAppendLine("logs.jsonl", StringFormat(
         "{\"time\":\"%s\",\"tag\":\"EXECUTION_FAILED\",\"message\":\"opportunity=%I64u direction=%s executionStatus=FAILED ticketsSent=%d ticketsWanted=%d opportunityStatus=AVAILABLE\"}",
         DashIsoTime(TimeCurrent()), g_executionResult.opportunityId, DirName(g_mindsVoteDir), ticketsSent, ticketsWanted));
     }
  }

//====================================================================
// STEP 9/12: POSITION MANAGEMENT - STRUCTURAL INITIAL SL + PROFIT-TIERED TRAILING (native, no
// Framework20/22/KMIE engine imported). Manages only this EA's own open positions (symbol+magic).
// Completely separate from Entry Intelligence - never reads or writes g_opportunity, g_entryApproval,
// Market DNA, or the Mind Vote. SL only ever moves in the profit-protecting direction, never back.
//
// 2026-08-21, Step 12 (explicit operator request): post-entry trailing is now a fixed profit->SL
// lock table, replacing Step 9's structural-3-bar trailing. GetStructural3BarPrice() (the function
// that used to serve this) was deleted 2026-09-03 as dead code (see its own former location's
// comment) - initial SL construction in ComputeInitialSL() is untouched and still uses its own
// structural 3-bar logic.
//====================================================================
// 2026-08-24, explicit operator request: widened from 3 tiers to 9, extending
// coverage up toward the new $9.00 fixed TP (Inp_TakeProfitUSD above).
//--- 2026-08-26, explicit operator request: widened from 9 tiers to 11 (tier 11's own profit
//--- threshold jumps $2 from tier 10's, per the exact table given - not a typo, kept literal).
#define KMIE_LITE_TRAIL_TIER_COUNT 11
double g_trailTierProfitUSD[KMIE_LITE_TRAIL_TIER_COUNT] = {1.50, 2.55, 3.55, 5.90, 6.90, 7.90, 8.90, 9.90, 10.90, 11.75, 12.75}; // ascending profit thresholds
//--- 2026-08-25/26, explicit operator request: reverted to plain per-tick profit-tiered trailing (no
//--- candle-close gating, no mid-candle exception, no candle-structure window - all removed), with
//--- these updated SL lock values. Tier 1's lock is NEGATIVE ($-0.50) - a loss-limiting floor BELOW
//--- entry, not a profit lock (see the sign-aware distance calculation in ManageOpenPositions()).
double g_trailTierSlUSD[KMIE_LITE_TRAIL_TIER_COUNT]     = {-1.25, 2.25, 3.25, 5.25, 6.25, 7.25, 7.25, 8.25, 9.25, 11.25, 12.25}; // SL lock value once that tier is reached (signed - see above)

//====================================================================
// 2026-09-09, explicit operator request (PROFIT-TIER TRAILING SL - replaces the fixed $5.00 instant
// profit cut previously in EvaluateEarlyTpWatcher()): a NEW, INDEPENDENT 9-tier profit-lock schedule.
// Deliberately NEW arrays/NEW name/NEW count - completely unrelated to, and NOT a continuation of, the
// old 11-tier g_trailTierProfitUSD[]/g_trailTierSlUSD[]/KMIE_LITE_TRAIL_TIER_COUNT immediately above
// (those are confirmed dead/unreferenced elsewhere in this file - left untouched, out of scope). Do
// NOT confuse these values with the old array's values - different schedule, different numbers.
// Consumed by SelectProfitTier()/ApplyProfitTierTrailingSl() below, wired into ManageOpenPositions()
// only once profit reaches $1.65 (below that, EvaluateEma35TrackingSl() remains in sole control - see
// that call site's own header for the exact handoff).
#define KMIE_LITE_NEW_TRAIL_TIER_COUNT 9
double g_newTrailTierProfitUSD[KMIE_LITE_NEW_TRAIL_TIER_COUNT] = {1.65, 2.65, 3.65, 4.65, 5.75, 7.75, 8.75, 9.75, 10.75}; // ascending profit thresholds (USD) that ARM each tier
double g_newTrailTierSlUSD[KMIE_LITE_NEW_TRAIL_TIER_COUNT]     = {1.25, 2.25, 3.25, 4.25, 5.25, 7.25, 8.25, 9.25, 10.25}; // SL lock value (USD, profit-side) once that tier is reached

int FindTrailingSlot(const ulong ticket)
  {
   for(int i=0;i<KMIE_LITE_MAX_TRAILING_SLOTS;i++)
      if(g_trailing[i].active && g_trailing[i].ticket==ticket) return i;
   return -1;
  }

//--- 2026-08-26, explicit operator request: read-only lookup for the Pullback Recovery Difference
//--- (see ManageOpenPositions()'s own header) - called from UpdateDashboardLogs() at the exact tick a
//--- trade-close is detected, BEFORE this tick's CleanupTrailingSlots() call removes the slot. Never
//--- consumes/frees the slot (unlike ConsumeEntryDna()) - purely a snapshot read for Trade History.
bool GetPullbackSummary(const ulong ticket, bool &outDetected, double &outExtremePrice,
                         bool &outRecoveryValid, double &outResumePrice, double &outRecoveryDifference,
                         double &outRecoveryDifferenceUSD)
  {
   int slot = FindTrailingSlot(ticket);
   if(slot<0)
     {
      outDetected = false; outExtremePrice = 0.0;
      outRecoveryValid = false; outResumePrice = 0.0; outRecoveryDifference = 0.0; outRecoveryDifferenceUSD = 0.0;
      return false;
     }
   outDetected              = g_trailing[slot].pbDetected;
   outExtremePrice          = g_trailing[slot].pbExtremePrice;
   outRecoveryValid         = g_trailing[slot].pbRecoveryValid;
   outResumePrice           = g_trailing[slot].pbResumePrice;
   outRecoveryDifference    = g_trailing[slot].pbRecoveryDifference;
   outRecoveryDifferenceUSD = g_trailing[slot].pbRecoveryDifferenceUSD;
   return true;
  }

int AllocTrailingSlot(const ulong ticket)
  {
   for(int i=0;i<KMIE_LITE_MAX_TRAILING_SLOTS;i++)
      if(!g_trailing[i].active)
        {
         g_trailing[i].active              = true;
         g_trailing[i].ticket              = ticket;
         g_trailing[i].protectionActivated = false;
         g_trailing[i].protectedSL         = 0.0; // tier system's locked SL price - reset for this fresh ticket
         g_trailing[i].highestAchievedTier = 0;    // 2026-09-09, PROFIT-TIER TRAILING SL: no tier reached yet
         g_trailing[i].pbTrackInit         = false;
         g_trailing[i].pbInPullback        = false;
         g_trailing[i].pbFavorableExtreme  = 0.0;
         g_trailing[i].pbDetected          = false;
         g_trailing[i].pbExtremePrice      = 0.0;
         g_trailing[i].pbRecoveryValid     = false;
         g_trailing[i].pbResumePrice       = 0.0;
         g_trailing[i].pbRecoveryDifference= 0.0;
         g_trailing[i].pbRecoveryDifferenceUSD = 0.0;
         g_trailing[i].eeAdverseConfirmCount = 0;
         g_trailing[i].tpMfeInit            = false;
         g_trailing[i].tpMfeExtreme         = 0.0;
         return i;
        }
   return -1; // pool exhausted - practically unreachable given the position lock caps concurrent tickets
  }

//--- 2026-08-31, explicit operator request (RETRY TRADE ENGINE): derives a just-closed position's
//--- own trade direction from its OPENING deal (DEAL_ENTRY_IN) in history - the position object
//--- itself is already gone by the time this runs, so POSITION_TYPE is no longer readable; the deal
//--- history is the only remaining source. Read-only.
int RetryDirectionFromHistory(const ulong ticket)
  {
   if(!HistorySelectByPosition(ticket)) return 0;
   int deals = HistoryDealsTotal();
   for(int d=0; d<deals; d++)
     {
      ulong dealTicket = HistoryDealGetTicket(d);
      if((ulong)HistoryDealGetInteger(dealTicket, DEAL_POSITION_ID)!=ticket) continue;
      if((ENUM_DEAL_ENTRY)HistoryDealGetInteger(dealTicket, DEAL_ENTRY)!=DEAL_ENTRY_IN) continue;
      ENUM_DEAL_TYPE dt = (ENUM_DEAL_TYPE)HistoryDealGetInteger(dealTicket, DEAL_TYPE);
      return (dt==DEAL_TYPE_BUY) ? 1 : -1;
     }
   return 0;
  }

//--- 2026-09-08, explicit operator request (ACTIVE_PING ENTRY-TO-EXIT RANGE): derives a just-closed
//--- position's OWN entry price from its OPENING deal (DEAL_ENTRY_IN) in history - SAME technique as
//--- RetryDirectionFromHistory() immediately above (separate function, not merged into it, so that
//--- function's own existing single-purpose contract/callers are never disturbed). Read-only. Returns
//--- 0.0 (never a fabricated/guessed price) if the opening deal can't be found.
double RetryEntryPriceFromHistory(const ulong ticket)
  {
   if(!HistorySelectByPosition(ticket)) return 0.0;
   int deals = HistoryDealsTotal();
   for(int d=0; d<deals; d++)
     {
      ulong dealTicket = HistoryDealGetTicket(d);
      if((ulong)HistoryDealGetInteger(dealTicket, DEAL_POSITION_ID)!=ticket) continue;
      if((ENUM_DEAL_ENTRY)HistoryDealGetInteger(dealTicket, DEAL_ENTRY)!=DEAL_ENTRY_IN) continue;
      return HistoryDealGetDouble(dealTicket, DEAL_PRICE);
     }
   return 0.0;
  }

//--- 2026-08-31, explicit operator request (RETRY TRADE ENGINE, Section 13): read-only exit
//--- classification for a ticket that has JUST disappeared from PositionsTotal() (called from
//--- CleanupTrailingSlots() below, BEFORE the slot is freed, so protectionActivated is still valid).
//--- Never modifies any position, SL, TP, or Opportunity/Entry-Approval state - purely reads deal
//--- history via the SAME HistorySelectByPosition()/DEAL_REASON technique UpdateDashboardLogs()
//--- already uses for trades.jsonl's closeDealReason field (no new history-reading method invented).
ENUM_RETRY_EXIT_TYPE ClassifyRetryExit(const ulong ticket, const bool wasProtected, double &outExitPrice)
  {
   outExitPrice = 0.0;
   if(!HistorySelectByPosition(ticket)) return RETRY_EXIT_UNKNOWN;

   int deals = HistoryDealsTotal();
   for(int d=0; d<deals; d++)
     {
      ulong dealTicket = HistoryDealGetTicket(d);
      if((ulong)HistoryDealGetInteger(dealTicket, DEAL_POSITION_ID)!=ticket) continue;
      if((ENUM_DEAL_ENTRY)HistoryDealGetInteger(dealTicket, DEAL_ENTRY)!=DEAL_ENTRY_OUT) continue;

      outExitPrice = HistoryDealGetDouble(dealTicket, DEAL_PRICE);
      string dealComment = HistoryDealGetString(dealTicket, DEAL_COMMENT);
      //--- Checked BEFORE DEAL_REASON below: CloseEarlyExitPosition()'s own literal comment string
      //--- ("KMIE_EarlyExit") is the only reliable way to distinguish an Early-Exit close from any
      //--- other DEAL_REASON_EXPERT close - both close via TRADE_ACTION_DEAL and report the SAME deal
      //--- reason, so the comment is the sole distinguishing signal available.
      if(StringFind(dealComment, "KMIE_EarlyExit")>=0) return RETRY_EXIT_EARLY_EXIT;

      ENUM_DEAL_REASON dr = (ENUM_DEAL_REASON)HistoryDealGetInteger(dealTicket, DEAL_REASON);
      if(dr==DEAL_REASON_SL)
         //--- wasProtected = g_trailing[slot].protectionActivated at the moment this ticket's slot is
         //--- being cleaned up (captured by the caller BEFORE this function runs, since the slot is
         //--- about to be freed) - true only if profit ever reached the first profit tier and the SL
         //--- was moved/locked there. An SL hit while protectionActivated is still false is, by
         //--- definition, the ORIGINAL structural/fallback SL, never the trailing/BE-moved one.
         return wasProtected ? RETRY_EXIT_TRAILING : RETRY_EXIT_HARD_SL;
      if(dr==DEAL_REASON_TP) return RETRY_EXIT_TP;
      if(dr==DEAL_REASON_EXPERT) return RETRY_EXIT_MANUAL; // EA-initiated close that is NOT Early-Exit (comment check above already excluded that)
      return RETRY_EXIT_UNKNOWN; // DEAL_REASON_CLIENT/MOBILE/WEB/... - a genuinely manual/external close
     }
   return RETRY_EXIT_UNKNOWN; // no OUT deal found for this position id - cannot classify
  }

//--- 2026-08-31, explicit operator request (RETRY TRADE ENGINE): called ONCE per closed ticket, from
//--- CleanupTrailingSlots() only, the instant a tracked ticket disappears. Classifies the exit and,
//--- ONLY for RETRY_EXIT_TRAILING/RETRY_EXIT_BREAK_EVEN, arms a fresh retry candidate - overwriting
//--- any PRIOR candidate (a new eligible exit always supersedes an old, already-decided one; the old
//--- one's own retryAlreadyExecuted state, if it ever fired, is irrelevant to a genuinely new ticket).
//--- Never touches g_opportunity/g_entryApproval/g_trailing - purely reads history and writes
//--- g_retryEngine, a struct nothing outside this feature reads.
//--- 2026-09-03, consolidation (duplication/drift audit, finding M6): exitType/exitPrice/dir are now
//--- passed in by CleanupTrailingSlots() (the only caller), which classifies once and shares the
//--- result across RegisterRetryCandidate()/RecordRetryObservation()/RecordRetryLifecycleExit()/
//--- RecordRetryStep9EventRecord() - previously each of the first three independently called
//--- ClassifyRetryExit() (up to 3x) and RetryDirectionFromHistory() was called separately twice more,
//--- all against the SAME closed ticket's deal history, all producing identical answers, on every
//--- single tick a position closes. Purely mechanical - no classification LOGIC changed, only where
//--- it runs. wasProtected is no longer needed here (it only ever fed the now-removed internal
//--- ClassifyRetryExit() call).
void RegisterRetryCandidate(const ulong ticket, const ENUM_RETRY_EXIT_TYPE exitType, const double exitPrice, const int dir)
  {
   if(exitType!=RETRY_EXIT_TRAILING && exitType!=RETRY_EXIT_BREAK_EVEN)
     {
      Print(StringFormat("[RETRY_ENGINE][NOT_CANDIDATE] ticket=%I64u exitType=%s (not retry-eligible)",
            ticket, RetryExitTypeName(exitType)));
      return;
     }

   if(dir==0)
     {
      Print(StringFormat("[RETRY_ENGINE][NOT_CANDIDATE] ticket=%I64u exitType=%s reason=DIRECTION_UNRESOLVED", ticket, RetryExitTypeName(exitType)));
      return;
     }

   g_retryEngine.candidateActive       = true;
   g_retryEngine.previousTicket        = ticket;
   g_retryEngine.previousDirection     = (dir>0) ? LDIR_BUY : LDIR_SELL;
   g_retryEngine.previousExitType      = exitType;
   g_retryEngine.previousExitPrice     = exitPrice;
   //--- 2026-09-08, explicit operator request (ACTIVE_PING ENTRY-TO-EXIT RANGE): same history read as
   //--- RetryDirectionFromHistory() above already performs for THIS same ticket - a second, separate
   //--- HistorySelectByPosition() call (not merged into that function, so its own single-purpose
   //--- contract stays unchanged) - never a fabricated/guessed entry price.
   g_retryEngine.previousEntryPrice    = RetryEntryPriceFromHistory(ticket);
   g_retryEngine.eligibleExitTime      = TimeCurrent();
   g_retryEngine.retryAlreadyExecuted  = false;

   Print(StringFormat("[RETRY_ENGINE][CANDIDATE_ARMED] previousTicket=%I64u previousDirection=%s exitType=%s exitPrice=%.3f",
         ticket, DirName(g_retryEngine.previousDirection), RetryExitTypeName(exitType), exitPrice));
  }

//--- Part 15: when a position no longer exists, its trailing state may be discarded - g_opportunity
//--- and Entry Approval are never touched here.
//--- 2026-08-31, explicit operator request (RETRY TRADE ENGINE): the ONLY addition to this existing
//--- function (at the time of that task) was the RegisterRetryCandidate() call below, inserted BEFORE
//--- g_trailing[i].active is cleared (so protectionActivated is still readable).
//--- 2026-08-31, explicit operator request (RETRY CANDIDATE OBSERVATION ENGINE): ONE further addition -
//--- the RecordRetryObservation() call below, ALSO inserted before g_trailing[i].active is cleared (so
//--- protectionActivated/pbDetected/pbRecoveryDifference are all still readable via
//--- GetPullbackSummary() inside it). Can never result in an order - see its own header comment.
//--- Everything else in this function remains byte-for-byte unchanged from before either feature.
//--- 2026-09-03, consolidation (duplication/drift audit, finding M6): this closed ticket used to be
//--- independently classified via ClassifyRetryExit() up to 3 times (once each inside
//--- RegisterRetryCandidate(), here for RecordRetryObservation(), and a third time inside
//--- RecordRetryLifecycleExit()) plus RetryDirectionFromHistory() called separately twice more (once
//--- inside RegisterRetryCandidate(), once again for Step 9's step9Dir) - up to 5 full
//--- HistorySelectByPosition()+deal-loop scans of the SAME closed ticket's history producing identical
//--- answers, every time any position closes. Classified ONCE here now and threaded through to all
//--- four functions below - purely mechanical, no classification logic changed.
void CleanupTrailingSlots()
  {
   for(int i=0;i<KMIE_LITE_MAX_TRAILING_SLOTS;i++)
     {
      if(!g_trailing[i].active) continue;
      if(!PositionSelectByTicket(g_trailing[i].ticket))
        {
         double exitPrice = 0.0;
         ENUM_RETRY_EXIT_TYPE exitType = ClassifyRetryExit(g_trailing[i].ticket, g_trailing[i].protectionActivated, exitPrice);
         int dir = RetryDirectionFromHistory(g_trailing[i].ticket);

         //--- 2026-09-08, explicit operator request (ACTIVE_PING RANGE - DECOUPLED FROM RETRY ENGINE):
         //--- updates g_lastClosedTrade for EVERY closed ticket, unconditionally, regardless of
         //--- exitType (unlike RegisterRetryCandidate() just below, which only arms for TRAILING/
         //--- BREAK_EVEN). Reuses the SAME exitPrice/dir already classified above and the SAME
         //--- RetryEntryPriceFromHistory() helper the Retry Engine's own entry-price field uses - never
         //--- a second/different history-reading technique - but writes to a completely separate,
         //--- independent struct. dir==0 (direction unresolved) still records the entry/exit prices
         //--- with direction left at its prior value's WAIT-equivalent - ActivePingState's own range
         //--- check only reads entryPrice/exitPrice, never direction, so this can never fabricate a
         //--- direction that wasn't actually resolved.
         g_lastClosedTrade.valid       = true;
         g_lastClosedTrade.ticket      = g_trailing[i].ticket;
         g_lastClosedTrade.direction   = (dir>0) ? LDIR_BUY : (dir<0) ? LDIR_SELL : LDIR_WAIT;
         g_lastClosedTrade.entryPrice  = RetryEntryPriceFromHistory(g_trailing[i].ticket);
         g_lastClosedTrade.exitPrice   = exitPrice;
         g_lastClosedTrade.closeTime   = TimeCurrent();

         //--- 2026-09-09, explicit operator request (POST-LOSS SAME-DIRECTION RE-ENTRY LOCK): net
         //--- realized P&L for this SAME closed ticket - SAME technique RecordRetryObservation() already
         //--- uses locally (its own realizedProfitUSD/haveProfit locals, ~line 13095-13109:
         //--- HistorySelectByPosition() + sum DEAL_PROFIT+DEAL_SWAP+DEAL_COMMISSION across every deal
         //--- matching this ticket's DEAL_POSITION_ID) - duplicated here rather than shared via a helper,
         //--- matching this file's own established convention for small independent per-concern
         //--- computations (see RecordRetryObservation()'s own header for precedent).
         g_lastClosedTrade.realizedProfitUSD = 0.0;
         g_lastClosedTrade.haveRealizedProfit = false;
         if(HistorySelectByPosition(g_trailing[i].ticket))
           {
            int plDeals = HistoryDealsTotal();
            double plSum = 0.0; bool plAny = false;
            for(int pd=0; pd<plDeals; pd++)
              {
               ulong plTicket = HistoryDealGetTicket(pd);
               if((ulong)HistoryDealGetInteger(plTicket, DEAL_POSITION_ID)!=g_trailing[i].ticket) continue;
               plSum += HistoryDealGetDouble(plTicket, DEAL_PROFIT) + HistoryDealGetDouble(plTicket, DEAL_SWAP) + HistoryDealGetDouble(plTicket, DEAL_COMMISSION);
               plAny = true;
              }
            if(plAny) { g_lastClosedTrade.realizedProfitUSD = plSum; g_lastClosedTrade.haveRealizedProfit = true; }
           }

         RegisterRetryCandidate(g_trailing[i].ticket, exitType, exitPrice, dir);
         RecordRetryObservation(g_trailing[i].ticket, exitType, exitPrice, g_trailing[i].protectionActivated);

         //--- Dashboard counters only (Phase 16) - reuses the SAME exitType already classified above.
         if(exitType==RETRY_EXIT_TRAILING || exitType==RETRY_EXIT_BREAK_EVEN) g_retryForensicProtectedCount++;
         else if(exitType==RETRY_EXIT_HARD_SL) g_retryForensicHardSlCount++;

         //--- 2026-08-31, explicit operator request (STEP 7 - RETRY / PROTECTION MARKET-EVENT
         //--- LIFECYCLE ANALYSIS): the ONE additive EXIT call for this feature, inserted here
         //--- (BEFORE g_retryForensic[i]/g_trailing[i] are freed below, same ordering guarantee
         //--- RegisterRetryCandidate()/RecordRetryObservation() above already rely on) so
         //--- g_trailing[i].pbDetected/pbRecoveryValid and g_retryForensic[i]'s own lastDna/lastBuyVotes/
         //--- etc "state before exit" snapshot are still fully readable. Now reuses the SAME
         //--- exitType/exitPrice/dir classified once above.
         RecordRetryLifecycleExit(g_trailing[i].ticket, i, exitType, exitPrice, dir);

         //--- 2026-09-01, explicit operator request (STEP 9 - RETRY ENGINE FINAL DATA-ACCUMULATION):
         //--- the ONE additive call for this feature's EXIT_ENRICHMENT half, inserted here (still
         //--- BEFORE g_retryForensic[i]/g_trailing[i] are freed below). Reuses exitType/exitPrice/dir
         //--- ALREADY classified once above. outcomeStage string mirrors RecordRetryLifecycleExit()'s
         //--- own mapping so both files describe the same exit identically.
         string step9OutcomeStage;
         switch(exitType)
           {
            case RETRY_EXIT_TRAILING:   step9OutcomeStage = "TRAILING_PROTECTION"; break;
            case RETRY_EXIT_BREAK_EVEN: step9OutcomeStage = "BE_PROTECTION"; break;
            case RETRY_EXIT_HARD_SL:    step9OutcomeStage = "HARD_SL"; break;
            case RETRY_EXIT_EARLY_EXIT: step9OutcomeStage = "EARLY_EXIT"; break;
            case RETRY_EXIT_TP:         step9OutcomeStage = "TP"; break;
            case RETRY_EXIT_MANUAL:     step9OutcomeStage = "MANUAL"; break;
            default:                    step9OutcomeStage = "UNKNOWN"; break;
           }
         RecordRetryStep9EventRecord(g_trailing[i].ticket, i, exitType, step9OutcomeStage, dir, exitPrice);

         //--- 2026-08-31, explicit operator request (STEP 3 FORENSIC OBSERVATION): frees the SAME-INDEX
         //--- g_retryForensic[] slot (RecordRetryForensicTick() always uses the identical slot index
         //--- ManageOpenPositions() resolves via FindTrailingSlot()/AllocTrailingSlot() - never a
         //--- separate allocator) so it's available for reuse by a future ticket. No forensic write
         //--- happens here - the LAST forensic tick before this close already captured the final
         //--- pre-close state; this is purely slot deallocation, mirroring g_trailing[i].active below.
         g_retryForensic[i].active = false;

         g_trailing[i].active = false;
        }
     }
  }

//--- 2026-09-14, LIVE BUG FIX ("verify why sl it not trailing"): g_tme[] (Trade Management Engine's own
//--- per-ticket pool, added 2026-09-12) had NO equivalent of CleanupTrailingSlots() above - every slot
//--- that AllocTmeSlot() ever handed out stayed permanently "active" for the rest of this EA run, even
//--- long after the underlying MT5 position closed. Over a full trading day this silently exhausted all
//--- KMIE_LITE_MAX_TRAILING_SLOTS slots (confirmed live: "[TME] TradeManagementEngine state pool
//--- exhausted (32 slots) at entry, ticket=2355042201" at 18:08:51, followed by ZERO TME_SL_ADAPT/
//--- TME_STATE activity for that ticket for the next 16+ minutes) - once exhausted, AllocTmeSlot()
//--- permanently returns -1 for every ticket opened afterward, silently disabling SL trailing/TP
//--- extension/the 720-bar jump/the 20-bar peak-reverse exit/the $2-$5 quick-profit-take for that ticket
//--- for its entire remaining life, with no error ever surfaced beyond the one-time allocation-miss log
//--- line at entry. Fixed by mirroring CleanupTrailingSlots()'s own exact
//--- "PositionSelectByTicket() fails -> free the slot" pattern - g_tme[] has no forensic/retry side
//--- effects to preserve (unlike g_trailing[]/g_retryForensic[], which feed the Retry Engine), so this
//--- is pure slot deallocation, nothing else.
void CleanupTmeSlots()
  {
   for(int i=0;i<KMIE_LITE_MAX_TRAILING_SLOTS;i++)
     {
      if(!g_tme[i].active) continue;
      if(!PositionSelectByTicket(g_tme[i].ticket))
         g_tme[i].active = false;
     }
  }

//--- 2026-08-28, Step 16 (explicit operator request, Running Trade Early-Exit Protection): the ONLY
//--- close mechanism this feature uses - no existing close helper was found anywhere in this file
//--- (grep-confirmed before writing this), so this is the minimum isolated implementation required.
//--- Mirrors SendMarketOrder()'s own request-construction style (same Inp_Slippage/Inp_MagicNumber/
//--- ORDER_FILLING_FOK conventions) but is otherwise completely independent of it - never calls it,
//--- never calls MaybeExecute(), never touches g_opportunity/g_entryApproval/Early Re-Entry/C2.
bool CloseEarlyExitPosition(const ulong ticket, const int direction, ulong &outRetcode)
  {
   if(!PositionSelectByTicket(ticket)) { outRetcode = 0; return false; }
   double volume = PositionGetDouble(POSITION_VOLUME);
   double price  = (direction>0) ? SymbolInfoDouble(g_symbol, SYMBOL_BID) : SymbolInfoDouble(g_symbol, SYMBOL_ASK);

   MqlTradeRequest req; MqlTradeResult res;
   ZeroMemory(req); ZeroMemory(res);
   req.action       = TRADE_ACTION_DEAL;
   req.position     = ticket;
   req.symbol       = g_symbol;
   req.volume       = volume;
   req.type         = (direction>0) ? ORDER_TYPE_SELL : ORDER_TYPE_BUY; // opposite side closes a position
   req.price        = price;
   req.deviation    = Inp_Slippage;
   req.magic        = Inp_MagicNumber;
   req.type_filling = ResolveOrderFillingMode(); // 2026-09-24 audit fix (R5): see that function's own header
   req.comment      = "KMIE_EarlyExit";

   bool sent = OrderSend(req, res);
   outRetcode = res.retcode;
   //--- 2026-09-08, explicit operator request ("Early SL Watcher triggered correctly... but failed to
   //--- execute (retcode=10036 again). solve this"): TRADE_RETCODE_POSITION_CLOSED (10036) means the
   //--- position was ALREADY closed by the broker before this close order arrived - typically another
   //--- mechanism (a different Watcher, a hard SL, a sibling batch-close) closed the SAME ticket a
   //--- moment earlier on the same tick. This is not a genuine execution failure - the Watcher's own
   //--- decision to close was correct, and the position IS closed, just not by this specific order.
   //--- Confirmed via AskUserQuestion before implementation: treat 10036 as success here, at this ONE
   //--- shared choke point every close path (Early SL/TP Watcher, Early Exit, EMA35-SL close/mirror
   //--- paths) already routes through - never a per-caller special case, never duplicated logic.
   //--- res.retcode is populated whenever the request actually reached the trade server, regardless of
   //--- whether OrderSend() itself returns true/false for THIS specific retcode - checked independently
   //--- of `sent` so it fires correctly whichever way MQL5 reports this particular rejection.
   if(res.retcode==TRADE_RETCODE_POSITION_CLOSED)
      return true;
   return sent && (res.retcode==TRADE_RETCODE_DONE || res.retcode==TRADE_RETCODE_PLACED);
  }

//--- 2026-08-28, Step 16 (explicit operator request): Running Trade Early-Exit Protection. Called
//--- ONLY from ManageOpenPositions()'s own tierIndex<0 branch (see call site) - i.e. ONLY while this
//--- ticket's profit is still below the existing $1.00 tier, so this can never run once BE+$0.30/
//--- structural trailing has taken over (mutual exclusion by placement, not by an extra profit check
//--- here). Reads g_buyVotes/g_sellVotes exactly as EvaluateMinds() already published them this tick
//--- - recalculates nothing, creates no second Minds engine. Two-CONSECUTIVE-TICK confirmation
//--- (g_trailing[slot].eeAdverseConfirmCount, capped at 2) - a single transient adverse tick only
//--- arms the counter; it must hold on the very next evaluation (tick, not bar - no candle-close
//--- gating, no time delay, per explicit instruction) to actually close.
//--- DISCONNECTED 2026-09-12: call site removed from ManageOpenPositions() - superseded by
//--- TradeManagementEngine(). Retained for reference only, not deleted (per explicit operator
//--- instruction - a follow-up task may remove this once the new engine is confirmed live).
void EvaluateEarlyExit(const ulong ticket, const int slot, const int direction, const double profitUSD)
  {
   //--- 10-of-16 opposite-side majority AND strictly greater than the trade's own side - 8/8 never
   //--- qualifies (fails the strict-majority check even if it somehow reached 8, since 8 is not >
   //--- the trade's own 8).
   bool adverse = (direction>0) ? (g_sellVotes>=10 && g_sellVotes>g_buyVotes)
                                 : (g_buyVotes>=10  && g_buyVotes>g_sellVotes);
   if(!adverse)
     {
      g_trailing[slot].eeAdverseConfirmCount = 0;
      return;
     }

   if(g_trailing[slot].eeAdverseConfirmCount<2) g_trailing[slot].eeAdverseConfirmCount++;
   if(g_trailing[slot].eeAdverseConfirmCount<2) return; // first qualifying cycle only - armed, not yet closed

   Print(StringFormat("[EARLY_EXIT][CONFIRM] ticket=%I64u direction=%s profit=%.2f buyVotes=%d sellVotes=%d reason=ADVERSE_16_MIND_CONFIRMATION",
         ticket, direction>0?"BUY":"SELL", profitUSD, g_buyVotes, g_sellVotes));

   ulong retcode = 0;
   bool closed = CloseEarlyExitPosition(ticket, direction, retcode);
   if(closed)
      Print(StringFormat("[EARLY_EXIT][SUCCESS] ticket=%I64u direction=%s profit=%.2f buyVotes=%d sellVotes=%d",
            ticket, direction>0?"BUY":"SELL", profitUSD, g_buyVotes, g_sellVotes));
   else
      //--- Deliberately does NOT reset eeAdverseConfirmCount on a failed send - the adverse condition
      //--- itself is unaffected by a failed close, so the next tick retries immediately without
      //--- re-requiring a fresh 2-cycle confirmation (the counter is already capped at 2).
      Print(StringFormat("[EARLY_EXIT][FAILED] ticket=%I64u retcode=%d reason=CLOSE_ORDER_SEND_FAILED",
            ticket, (int)retcode));
  }

//--- 2026-09-02, explicit operator request (EARLY SL WATCHER SIGNAL QUALITY - see
//--- SlWatcherSignalTrack's own header for the full pool design). Four small helpers over
//--- g_slWatcherSignal[]: find/alloc mirror FindTrailingSlot()/AllocTrailingSlot()'s own established
//--- convention; the two Finalize functions are the ONLY writers of sl_watcher.jsonl.
int FindSlWatcherSlot(const ulong ticket)
  {
   for(int i=0;i<KMIE_SL_WATCHER_MAX_SLOTS;i++)
      if(g_slWatcherSignal[i].active && g_slWatcherSignal[i].ticket==ticket) return i;
   return -1;
  }

int AllocSlWatcherSlot(const ulong ticket, const int direction, const double entryPrice)
  {
   for(int i=0;i<KMIE_SL_WATCHER_MAX_SLOTS;i++)
      if(!g_slWatcherSignal[i].active)
        {
         g_slWatcherSignal[i].active             = true;
         g_slWatcherSignal[i].ticket              = ticket;
         g_slWatcherSignal[i].direction           = direction;
         g_slWatcherSignal[i].entryPrice          = entryPrice;
         g_slWatcherSignal[i].entryBarTime        = iTime(g_symbol, PERIOD_M1, 0);
         g_slWatcherSignal[i].lastCandleTimeSeen  = 0;
         g_slWatcherSignal[i].closedCandlesSeen   = 0;
         g_slWatcherSignal[i].startTime           = TimeCurrent();
         return i;
        }
   return -1; // pool exhausted this cycle - skip, try again next tick (same convention as g_trailing[])
  }

void FinalizeSlWatcherSignal_Cut(const int slot)
  {
   DashAppendLine("sl_watcher.jsonl", StringFormat(
      "{\"time\":\"%s\",\"ticket\":%I64u,\"watcherCutEarly\":true,\"signalQuality\":null,\"entryPrice\":%.3f,\"checkPrice\":null}",
      DashIsoTime(TimeCurrent()), g_slWatcherSignal[slot].ticket, g_slWatcherSignal[slot].entryPrice));
   g_slWatcherSignal[slot].active = false;
  }

void FinalizeSlWatcherSignal_Classified(const int slot, const string signalQuality, const double checkPrice)
  {
   DashAppendLine("sl_watcher.jsonl", StringFormat(
      "{\"time\":\"%s\",\"ticket\":%I64u,\"watcherCutEarly\":false,\"signalQuality\":\"%s\",\"entryPrice\":%.3f,\"checkPrice\":%.3f}",
      DashIsoTime(TimeCurrent()), g_slWatcherSignal[slot].ticket, signalQuality, g_slWatcherSignal[slot].entryPrice, checkPrice));
   g_slWatcherSignal[slot].active = false;
  }

//--- 2026-09-02, explicit operator request (EARLY SL WATCHER SIGNAL QUALITY): called ONCE per tick
//--- from ManageOpenPositions() (not per-position - mirrors UpdatePostExitContinuations()'s own
//--- established pattern for exactly this reason: this pool must keep observing price even after the
//--- underlying position has already closed via a real SL/TP, which a per-position loop cannot do
//--- since that position is simply gone from PositionsTotal() by then). For every tracked ticket,
//--- counts genuinely NEW closed M1 candles since entry (own dedup field - see the struct's own header
//--- for why this never shares state with DetectNewClosedCandle()/other features). Once exactly 3 such
//--- candles have closed, classifies the entry signal by comparing the 3rd candle's close against
//--- entry price: moved toward the trade's OWN direction = GOOD_SIGNAL (validated by follow-through
//--- toward profit), moved against it = BAD_SIGNAL (headed toward where the SL sits), exact tie =
//--- NEUTRAL. A ticket the Early SL Watcher has already cut never reaches this function's
//--- classification branch - EvaluateEarlySlWatcher() calls FinalizeSlWatcherSignal_Cut() itself the
//--- instant it closes a position, freeing the slot before this loop would otherwise get to it.
void UpdateSlWatcherSignalPool()
  {
   MqlRates r[];
   ArraySetAsSeries(r, true);
   if(CopyRates(g_symbol, PERIOD_M1, 1, 1, r)<1) return; // last CLOSED candle unavailable this tick
   datetime candleTime  = r[0].time;
   double   candleClose = r[0].close;

   for(int i=0; i<KMIE_SL_WATCHER_MAX_SLOTS; i++)
     {
      if(!g_slWatcherSignal[i].active) continue;

      //--- Safety timeout - if 3 closed candles somehow never accumulate (feed gap etc.), drop this
      //--- slot rather than leaking it forever or writing a stale/misleading label.
      if(TimeCurrent()-g_slWatcherSignal[i].startTime>KMIE_SL_WATCHER_TIMEOUT_SECONDS)
        {
         g_slWatcherSignal[i].active = false;
         continue;
        }

      if(candleTime<=g_slWatcherSignal[i].entryBarTime) continue;       // not yet a candle AFTER entry
      if(candleTime==g_slWatcherSignal[i].lastCandleTimeSeen) continue; // already counted this candle

      g_slWatcherSignal[i].lastCandleTimeSeen = candleTime;
      g_slWatcherSignal[i].closedCandlesSeen++;
      if(g_slWatcherSignal[i].closedCandlesSeen<3) continue;

      int    dir   = g_slWatcherSignal[i].direction;
      double entry = g_slWatcherSignal[i].entryPrice;
      string signalQuality;
      if(candleClose==entry)
         signalQuality = "NEUTRAL";
      else if((dir>0 && candleClose>entry) || (dir<0 && candleClose<entry))
         signalQuality = "GOOD_SIGNAL";
      else
         signalQuality = "BAD_SIGNAL";

      Print(StringFormat("[SL_WATCHER_SIGNAL] ticket=%I64u signalQuality=%s entry=%.3f checkPrice=%.3f",
            g_slWatcherSignal[i].ticket, signalQuality, entry, candleClose));
      FinalizeSlWatcherSignal_Classified(i, signalQuality, candleClose);
     }
  }

//--- 2026-09-02, explicit operator request ("Early SL Watcher... if after open trade does trail the
//--- SL and move back to opposite direction and closed in Opposite Direction than don't wait too much
//--- just cut the trade wherever its"). ARM CONDITION WIDENED same day (explicit operator request,
//--- live example: a trade that opened right at a local top and went straight into a loss without
//--- ever reaching the first trailing tier got zero protection under the original design) - now called
//--- from BOTH branches of ManageOpenPositions()'s tier check: tickets that HAVE trailed
//--- (g_trailing[slot].protectionActivated true) AND tickets still below tier 1 that never have. This
//--- function itself never reads protectionActivated - the two call sites decide when to call it, not
//--- this function.
//--- TRIGGER CONDITION TIGHTENED same day (explicit operator request: "has to wait for 2 Candles and
//--- 2 candle for running Tick than only cut the trade if its in Opposite" - clarified as a THREE-part
//--- confirmation, replacing the original single-closed-candle trigger): now requires (1) the most
//--- recently CLOSED M1 candle AND (2) the one before it to BOTH have closed against the trade's own
//--- direction, AND (3) the CURRENTLY FORMING ("running") candle to ALSO be trading against the
//--- trade's direction right now (its live close vs its own open - re-read fresh every tick, so this
//--- self-corrects immediately if the running candle turns back favorable even after the 2 closes).
//--- All three must hold simultaneously on the same tick for the cut to fire - a single opposite close
//--- (the old behavior) is no longer enough. Independent read-only CopyRates() calls (shift=1 count=2
//--- for the two closed candles, shift=0 count=1 for the live one - the same "last CLOSED candle(s)"/
//--- "currently forming candle" techniques used elsewhere in this file) - deliberately does NOT reuse
//--- DetectNewClosedCandle()/g_retryForensic[slot].lastClosedBarTimeSeen, since that field is owned/
//--- consumed by the unrelated Step 3/5/7 forensic observation feature and sharing it here would make
//--- this safety-critical exit depend on that diagnostic feature's own call order. Reuses
//--- CloseEarlyExitPosition() (Step 16's own close helper, just above) - not a second/duplicate close
//--- implementation.
//--- DISCONNECTED 2026-09-12: call site removed from ManageOpenPositions() - superseded by
//--- TradeManagementEngine(). Retained for reference only, not deleted (per explicit operator
//--- instruction - a follow-up task may remove this once the new engine is confirmed live).
void EvaluateEarlySlWatcher(const ulong ticket, const int direction)
  {
   //--- Master safety switch - "false = dashboard only, never sends an order" per its own input
   //--- comment. This function sends orders (the close below, and now the Reverse Fire entry), so it
   //--- must respect the same switch every other order-sending path already does.
   if(!Inp_ExecutionEnabled) return;

   //--- Parts 1+2: the last TWO closed M1 candles - r[0] is the most recent, r[1] the one before it.
   MqlRates r[];
   ArraySetAsSeries(r, true);
   if(CopyRates(g_symbol, PERIOD_M1, 1, 2, r)<2) return; // fewer than 2 closed candles available yet - skip, retry next tick

   bool closed1Against = (direction>0) ? (r[0].close<r[0].open) : (r[0].close>r[0].open); // most recent closed
   bool closed2Against = (direction>0) ? (r[1].close<r[1].open) : (r[1].close>r[1].open); // 2nd-most-recent closed
   if(!closed1Against || !closed2Against) return;

   //--- Part 3: the CURRENTLY FORMING candle - shift=0 always returns the live, continuously-updating
   //--- bar, so live[0].close IS this tick's current market price, checked fresh every call.
   MqlRates live[];
   ArraySetAsSeries(live, true);
   if(CopyRates(g_symbol, PERIOD_M1, 0, 1, live)<1) return; // running candle unavailable this tick - skip, retry next tick
   bool liveAgainst = (direction>0) ? (live[0].close<live[0].open) : (live[0].close>live[0].open);
   if(!liveAgainst) return;

   //--- 2026-09-02, explicit operator request ("check now" repeatedly returning no evidence of this
   //--- feature's own activity revealed the actual gap: every [EARLY_SL_WATCHER]/[REVERSE_FIRE] line
   //--- in this function was Print()-only - visible in MT5's own Experts tab, but NEVER written to
   //--- logs.jsonl, so neither the dashboard nor any file-based check could ever see it. Every such
   //--- line below now ALSO goes through DashAppendLine("logs.jsonl", ...) - same message content,
   //--- durable and auditable, matching every other safety-critical event in this file.
   string triggerMsg = StringFormat("ticket=%I64u direction=%s closed1Time=%s closed1Open=%.3f closed1Close=%.3f closed2Time=%s closed2Open=%.3f closed2Close=%.3f liveOpen=%.3f livePrice=%.3f reason=2_CLOSED_PLUS_RUNNING_CANDLE_AGAINST_TRADE",
         ticket, direction>0?"BUY":"SELL", TimeToString(r[0].time), r[0].open, r[0].close,
         TimeToString(r[1].time), r[1].open, r[1].close, live[0].open, live[0].close);
   Print("[EARLY_SL_WATCHER][TRIGGER] " + triggerMsg);
   DashAppendLine("logs.jsonl", StringFormat("{\"time\":\"%s\",\"tag\":\"EARLY_SL_WATCHER_TRIGGER\",\"message\":\"%s\"}",
         DashIsoTime(TimeCurrent()), triggerMsg));

   ulong retcode = 0;
   bool closed = CloseEarlyExitPosition(ticket, direction, retcode);
   if(closed)
     {
      Print(StringFormat("[EARLY_SL_WATCHER][SUCCESS] ticket=%I64u direction=%s", ticket, direction>0?"BUY":"SELL"));
      DashAppendLine("logs.jsonl", StringFormat("{\"time\":\"%s\",\"tag\":\"EARLY_SL_WATCHER_SUCCESS\",\"message\":\"ticket=%I64u direction=%s\"}",
            DashIsoTime(TimeCurrent()), ticket, direction>0?"BUY":"SELL"));
      //--- EARLY SL WATCHER SIGNAL QUALITY: this ticket is done the instant the Watcher closes it -
      //--- finalize its sl_watcher.jsonl record as a Watcher cut (watcherCutEarly=true, no GOOD/BAD
      //--- classification - see SlWatcherSignalTrack's own header) and free the pool slot now, before
      //--- UpdateSlWatcherSignalPool()'s own once-per-tick sweep would otherwise still find it active.
      int sigSlot = FindSlWatcherSlot(ticket);
      if(sigSlot>=0) FinalizeSlWatcherSignal_Cut(sigSlot);

      //--- 2026-09-02, explicit operator request (REVERSE FIRE - "when it cut the Trade Open the
      //--- Trade in same direction as well [as the reversal] ... don't use anything else for Reverse
      //--- Fire Trade and that should only Execute one time after that move same Algo Market DNA and
      //--- Minds Votes"): the instant the Watcher cuts a trade, ONE new trade fires in the OPPOSITE
      //--- direction of the just-cut trade (i.e. the SAME direction as the opposite-direction candle
      //--- that triggered the cut - riding the reversal, not doubling down on the losing side). Fires
      //--- unconditionally - no Market DNA regime allow-list check, no Minds vote threshold, purely on
      //--- the Watcher's own trigger, per explicit instruction ("don't use anything else"). Reuses
      //--- SendMarketOrder() - the SAME execution path every other entry uses (normal lot size,
      //--- ComputeInitialSL(), Inp_TakeProfitUSD) - so this is a genuinely normal position from here
      //--- on, subject to the SAME trailing/Watcher/Market-DNA-based management as any other trade
      //--- (the "one time" scope is just THIS entry decision, never a standing alternate algorithm).
      //--- Guarded by the SAME cross-instance mutex MaybeExecute() uses (see its own root-cause header)
      //--- so this new order-sending path is protected against the identical known race condition,
      //--- not a second/unprotected way to open a position. A single attempt only - no retry on
      //--- failure, matching "should only execute one time".
      //--- 2026-09-03: acquire/release now go through the shared AcquireExecutionLock()/
      //--- ReleaseExecutionLock() helpers (duplication/drift audit finding M1) - same lock name/
      //--- semantics as before, just no longer a locally re-typed copy of the sequence.
      //--- 2026-09-03, explicit operator request ("stop Reverse Fire but watcher should work in same
      //--- way"): the entire block below is now gated behind Inp_ReverseFireEnabled (default false).
      //--- Everything ABOVE this point (the close itself, SUCCESS/FAILED logging, sl_watcher.jsonl
      //--- finalization via FinalizeSlWatcherSignal_Cut()) already ran and is completely unaffected -
      //--- the Watcher still cuts losing trades exactly as before. Only the opposite-direction re-entry
      //--- that used to follow is now skipped.
      if(!Inp_ReverseFireEnabled)
        {
         Print(StringFormat("[REVERSE_FIRE][DISABLED] afterTicket=%I64u reason=INP_REVERSE_FIRE_ENABLED_FALSE", ticket));
         DashAppendLine("logs.jsonl", StringFormat("{\"time\":\"%s\",\"tag\":\"REVERSE_FIRE_DISABLED\",\"message\":\"afterTicket=%I64u reason=INP_REVERSE_FIRE_ENABLED_FALSE\"}",
               DashIsoTime(TimeCurrent()), ticket));
        }
      else
        {
      int reverseDirection = -direction;
      if(AcquireExecutionLock())
        {
         string rfTriggerMsg = StringFormat("afterTicket=%I64u newDirection=%s reason=EARLY_SL_WATCHER_CUT", ticket, reverseDirection>0?"BUY":"SELL");
         Print("[REVERSE_FIRE][TRIGGER] " + rfTriggerMsg);
         DashAppendLine("logs.jsonl", StringFormat("{\"time\":\"%s\",\"tag\":\"REVERSE_FIRE_TRIGGER\",\"message\":\"%s\"}",
               DashIsoTime(TimeCurrent()), rfTriggerMsg));
         //--- 2026-09-02, explicit operator request ("does also updating the same in trade history"):
         //--- marks this SendMarketOrder() call so RecordEntryDna() records entrySource="REVERSE_FIRE"
         //--- instead of misreading stale g_opportunity flags - see g_reverseFireInProgress's own
         //--- header for the full rationale. Reset immediately after, success or failure alike, so it
         //--- can never leak into a later, unrelated SendMarketOrder() call.
         g_reverseFireInProgress = true;
         //--- 2026-09-24: SendMarketOrder()'s signature gained outActualSL/outActualTP (see that function's
         //--- own header) - Reverse Fire doesn't participate in batch SL/TP sharing (it's always a single,
         //--- independent trade, never part of a MaybeExecute() signal batch), so these are just discarded
         //--- locals, never read.
         double reverseActualSL_unused = 0.0, reverseActualTP_unused = 0.0;
         bool reverseSent = SendMarketOrder(reverseDirection, reverseActualSL_unused, reverseActualTP_unused);
         g_reverseFireInProgress = false;
         ReleaseExecutionLock();
         string rfResultTag = reverseSent ? "REVERSE_FIRE_SUCCESS" : "REVERSE_FIRE_FAILED";
         string rfResultMsg = StringFormat("afterTicket=%I64u newDirection=%s", ticket, reverseDirection>0?"BUY":"SELL");
         Print(StringFormat("[REVERSE_FIRE][%s] %s", reverseSent?"SUCCESS":"FAILED", rfResultMsg));
         DashAppendLine("logs.jsonl", StringFormat("{\"time\":\"%s\",\"tag\":\"%s\",\"message\":\"%s\"}",
               DashIsoTime(TimeCurrent()), rfResultTag, rfResultMsg));
        }
      else
        {
         Print(StringFormat("[REVERSE_FIRE][SKIPPED] afterTicket=%I64u reason=ANOTHER_EA_INSTANCE_MID_EXECUTION", ticket));
         DashAppendLine("logs.jsonl", StringFormat("{\"time\":\"%s\",\"tag\":\"REVERSE_FIRE_SKIPPED\",\"message\":\"afterTicket=%I64u reason=ANOTHER_EA_INSTANCE_MID_EXECUTION\"}",
               DashIsoTime(TimeCurrent()), ticket));
        }
        }
     }
   else
     {
      Print(StringFormat("[EARLY_SL_WATCHER][FAILED] ticket=%I64u retcode=%d reason=CLOSE_ORDER_SEND_FAILED", ticket, (int)retcode));
      DashAppendLine("logs.jsonl", StringFormat("{\"time\":\"%s\",\"tag\":\"EARLY_SL_WATCHER_FAILED\",\"message\":\"ticket=%I64u retcode=%d reason=CLOSE_ORDER_SEND_FAILED\"}",
            DashIsoTime(TimeCurrent()), ticket, (int)retcode));
     }
  }

//--- 2026-09-08, explicit operator request ("As we are using the Early Watcher for SL cut trade -- i
//--- would to use the same TP same Algo but this for TP"): ORIGINAL VERSION - literal mirror of
//--- EvaluateEarlySlWatcher(), 3-CLOSED-candles-plus-live-candle-all-favorable trigger.
//--- 2026-09-08, explicit operator request, REWORKED SAME DAY ("my Early Watcher TP not working
//--- perfectly Is Cutting the trade Even is recently open -- why and i need it Set Waiting for
//--- Opposity Candle closed another Candle open having the Weight of %50 in opposite Direction"):
//--- the operator reported the original trigger above cutting trades too early/too often (a single
//--- 3-candle favorable run is common noise, not necessarily a real reversal risk worth locking in
//--- profit against) - REPLACED with a different, two-stage trigger, per explicit clarification via
//--- AskUserQuestion:
//---  GATE: only active once this ticket has already crossed the EXISTING $1.00 protectionActivated
//---        threshold (g_trailing[slot].protectionActivated) - reuses the SAME hardcoded $1 concept
//---        ManageOpenPositions() already established, never a second/new profit threshold.
//---  STAGE 1: at least one CLOSED M1 candle closes AGAINST the trade's own direction (the first sign
//---        of a potential reversal after being in profit).
//---  STAGE 2: on the NEXT tick/candle after that, check whether price has retraced AT LEAST 50% of
//---        the distance from this ticket's ALL-TIME most-favorable price (g_trailing[slot].
//---        tpMfeExtreme, a NEW dedicated field - see TrailingState's own header for why this is NOT
//---        pbFavorableExtreme) back toward entry price. If so, cut now to protect at least half of
//---        the peak favorable move. This directly answers "why is it cutting trades recently
//---        opened" - the new $1 gate alone prevents that, independent of the retracement logic.
//--- Confirmed via AskUserQuestion before implementation: the 50% is measured from MFE back toward
//--- ENTRY (not from entry toward the opposite candle's own extreme) - i.e.
//---   retracementFraction = (BUY: tpMfeExtreme-currentPrice) / (tpMfeExtreme-entryPrice)
//---                         (SELL: currentPrice-tpMfeExtreme) / (entryPrice-tpMfeExtreme)
//--- Still reuses CloseEarlyExitPosition() - the SAME close helper the SL Watcher/Early Exit/EMA35 SL
//--- all already use, never a second/duplicate close implementation. Still deliberately does NOT carry
//--- over the SL Watcher's own Reverse Fire block or touch sl_watcher.jsonl/SlWatcherSignalTrack (same
//--- reasoning as the original version - unchanged).
//--- DISCONNECTED 2026-09-12: call site removed from ManageOpenPositions() - superseded by
//--- TradeManagementEngine(). Retained for reference only, not deleted (per explicit operator
//--- instruction - a follow-up task may remove this once the new engine is confirmed live).
void EvaluateEarlyTpWatcher(const ulong ticket, const int slot, const int direction, const double entryPrice, const double profitUSD)
  {
   //--- Master safety switch - SAME convention as the SL Watcher (this function sends an order too).
   if(!Inp_ExecutionEnabled) return;

   //--- 2026-09-09, explicit operator request (PROFIT-TIER TRAILING SL REPLACES FIXED $5 CUT): the
   //--- previous "$5.00 instant flat cut" trigger that used to live here has been REMOVED entirely -
   //--- floating profit reaching/exceeding $5.00 no longer closes the position through this function or
   //--- anywhere else. Profit-based protection above $1.65 is now handled by the new tiered trailing SL
   //--- system (ApplyProfitTierTrailingSl(), called from ManageOpenPositions()) which locks in
   //--- progressively tighter SL levels instead of flat-closing the trade. This function's own $1-gated
   //--- MFE/50%-retracement-from-peak logic below is completely unchanged.

   //--- MFE tracking - runs EVERY tick regardless of the $1 gate below, so tpMfeExtreme is always
   //--- current the instant the gate opens (never a stale/zero value the first tick protection
   //--- activates). Uses the SAME Bid/Ask reference price convention CloseEarlyExitPosition() and
   //--- EvaluateEma35TrackingSl() already use for a BUY/SELL's own "current price".
   double curPrice = (direction>0) ? SymbolInfoDouble(g_symbol, SYMBOL_BID) : SymbolInfoDouble(g_symbol, SYMBOL_ASK);
   if(!g_trailing[slot].tpMfeInit)
     {
      g_trailing[slot].tpMfeInit    = true;
      g_trailing[slot].tpMfeExtreme = curPrice;
     }
   else
     {
      bool movedFavorable = (direction>0) ? (curPrice>g_trailing[slot].tpMfeExtreme) : (curPrice<g_trailing[slot].tpMfeExtreme);
      if(movedFavorable) g_trailing[slot].tpMfeExtreme = curPrice;
     }

   //--- GATE: only active once profit has already crossed the existing $1.00 threshold.
   if(!g_trailing[slot].protectionActivated) return;

   //--- STAGE 1: the most recently CLOSED M1 candle must have closed AGAINST the trade's direction.
   MqlRates r[];
   ArraySetAsSeries(r, true);
   if(CopyRates(g_symbol, PERIOD_M1, 1, 1, r)<1) return; // no closed candle available yet - skip, retry next tick
   bool closed1Against = (direction>0) ? (r[0].close<r[0].open) : (r[0].close>r[0].open);
   if(!closed1Against) return;

   //--- STAGE 2: retracement from the all-time MFE back toward entry, measured against the CURRENT
   //--- live price (checked fresh every tick, same "next candle open" spirit the operator described -
   //--- this naturally evaluates on the candle(s) AFTER the Stage-1 close, since STAGE 1 only becomes
   //--- true once that candle has actually closed).
   double mfeToEntryDist = (direction>0) ? (g_trailing[slot].tpMfeExtreme-entryPrice) : (entryPrice-g_trailing[slot].tpMfeExtreme);
   if(mfeToEntryDist<=0.0) return; // MFE never actually exceeded entry (shouldn't happen once protectionActivated, but never divide by zero/negative)

   double retracedDist = (direction>0) ? (g_trailing[slot].tpMfeExtreme-curPrice) : (curPrice-g_trailing[slot].tpMfeExtreme);
   double retracementFraction = retracedDist / mfeToEntryDist;
   if(retracementFraction<0.50) return; // hasn't retraced far enough yet - keep waiting

   string triggerMsg = StringFormat("ticket=%I64u direction=%s closed1Time=%s closed1Open=%.3f closed1Close=%.3f mfeExtreme=%.3f entryPrice=%.3f currentPrice=%.3f retracementPct=%.1f reason=CLOSED_CANDLE_AGAINST_PLUS_50PCT_RETRACEMENT_FROM_MFE",
         ticket, direction>0?"BUY":"SELL", TimeToString(r[0].time), r[0].open, r[0].close,
         g_trailing[slot].tpMfeExtreme, entryPrice, curPrice, retracementFraction*100.0);
   Print("[EARLY_TP_WATCHER][TRIGGER] " + triggerMsg);
   DashAppendLine("logs.jsonl", StringFormat("{\"time\":\"%s\",\"tag\":\"EARLY_TP_WATCHER_TRIGGER\",\"message\":\"%s\"}",
         DashIsoTime(TimeCurrent()), triggerMsg));

   ulong retcode = 0;
   bool closed = CloseEarlyExitPosition(ticket, direction, retcode);
   if(closed)
     {
      Print(StringFormat("[EARLY_TP_WATCHER][SUCCESS] ticket=%I64u direction=%s", ticket, direction>0?"BUY":"SELL"));
      DashAppendLine("logs.jsonl", StringFormat("{\"time\":\"%s\",\"tag\":\"EARLY_TP_WATCHER_SUCCESS\",\"message\":\"ticket=%I64u direction=%s\"}",
            DashIsoTime(TimeCurrent()), ticket, direction>0?"BUY":"SELL"));
     }
   else
     {
      Print(StringFormat("[EARLY_TP_WATCHER][FAILED] ticket=%I64u retcode=%d reason=CLOSE_ORDER_SEND_FAILED", ticket, (int)retcode));
      DashAppendLine("logs.jsonl", StringFormat("{\"time\":\"%s\",\"tag\":\"EARLY_TP_WATCHER_FAILED\",\"message\":\"ticket=%I64u retcode=%d reason=CLOSE_ORDER_SEND_FAILED\"}",
            DashIsoTime(TimeCurrent()), ticket, (int)retcode));
     }
  }

//--- 2026-09-08, explicit operator request ("I would build My SL right now setting with last 3 bars
//--- but should be set at 20 Bar according to the EMA Slope 20 last Point where last closed EMA 20
//--- Slope was ------- Remove all Manual Trailing TP and SL"): REPLACES the old 11-tier profit-based
//--- trailing SL schedule entirely. New rule: the broker-side SL tracks EMA20's OWN value (the same
//--- EMA20 calculation EMA Trend Mind/ACTIVE_PING already use, via EmaAt() - never a second/duplicate
//--- EMA formula) at the most recently CLOSED M1 candle. Reads EMA20 fresh every tick (recomputing
//--- it is cheap - a single ~30-bar CopyRates + one EmaAt() call, same cost class as EMA Trend Mind's
//--- own per-tick read) so the SL naturally advances the instant a new closed bar changes EMA20,
//--- without any separate "new bar" gating.
//---
//--- Explicit operator-confirmed edge-case handling (via AskUserQuestion before implementation):
//---  1. EMA20 on the WRONG side of current price (e.g. for a BUY, EMA20 currently above Bid) would
//---     produce an invalid/self-triggering stop - skip the update entirely this tick, leave the
//---     existing SL in place, retry next tick. Never clamped, never guessed, never closes the
//---     position on this condition alone.
//---  2. NEVER WIDEN - same "candidate must improve on the current broker-side SL, or do nothing"
//---     rule the old tiered system already enforced. Even if EMA20 itself later moves back away from
//---     price, the SL never gives back ground once tightened.
//--- Does not touch: the initial structural SL set by ComputeInitialSL() at entry (untouched, still
//--- the very first SL every position opens with), the Early SL/TP Watchers (untouched, independent
//--- mechanisms, still called immediately before this function - see call sites), Market DNA,
//--- Minds/voting, Entry Approval, ACTIVE_PING, Opportunity Lifecycle, execution/entry logic.
//--- 2026-09-08, explicit operator request ("when there is no EMA 20 SL to set than those should be
//--- blocked -- remove fully by default setting"): return value added - true = the ticket was CLOSED
//--- by this function (caller must PositionSelectByTicket()-recheck before doing anything else with
//--- it, same convention EvaluateEarlySlWatcher()/EvaluateEarlyTpWatcher() already established), false
//--- = ticket is still open (either a normal SL update happened, or genuinely nothing needed doing).
//--- Explicit operator-confirmed scope (via AskUserQuestion before implementation, twice): BOTH
//--- failure cases now close the position immediately, no grace period -
//---   (A) insufficient closed-candle history to compute EMA20 at all, and
//---   (B) EMA20 computed fine but sits on the WRONG SIDE of current price for a stop (a condition
//---       that occurs ROUTINELY in the normal early life of a trade, not just near data-start - the
//---       operator was explicitly told this before confirming "yes, proceed exactly as confirmed -
//---       no grace period", understanding this may close many positions almost immediately after
//---       opening if EMA20 isn't already correctly sided at entry).
//--- Reuses CloseEarlyExitPosition() - the SAME close helper the Early SL/TP Watchers already use,
//--- never a second/duplicate close implementation.
//--- 2026-09-08, explicit operator request ("Make EMA slope at 35 Bars So Should EMA 35 not 20"):
//--- SL-tracking EMA period changed 20 -> 35. At the time, the function name/log tags/JSON field names
//--- ([EMA20_SL] / "tag":"EMA20_SL"* / ema20=...) were DELIBERATELY left as-is to avoid breaking
//--- downstream dashboard/analytics consumers keyed on those exact strings - only the EMA PERIOD itself
//--- changed, per "SL is also not trailing according the EMA Slope 20 ... Should EMA 35 not 20".
//--- 2026-09-09, explicit operator request ("fix everythihg and remove fully which we not using"): that
//--- naming mismatch is now corrected - function renamed EvaluateEma20TrackingSl -> EvaluateEma35TrackingSl,
//--- log tags EMA20_SL/EMA20_SL_MIRRORED/EMA20_SL_NO_SL_CLOSE/EMA20_SL_NO_SL_CLOSE_FAILED -> their EMA35_SL
//--- equivalents, and the ema20 local variable/JSON field -> ema35, throughout this function only. Zero
//--- logic/formula change - the EMA period was already 35 (see emaPeriod below); this is a pure rename.
//--- DISCONNECTED 2026-09-12: call site removed from ManageOpenPositions() - superseded by
//--- TradeManagementEngine()/AdaptiveSlEngine(). Retained for reference only, not deleted (per
//--- explicit operator instruction - a follow-up task may remove this once the new engine is
//--- confirmed live).
bool EvaluateEma35TrackingSl(const ulong ticket, const int direction, const double currentSL, const int digits)
  {
   const int emaPeriod = 35; // 2026-09-08: changed from 20 -> 35 per explicit operator request. Same EmaAt() formula, same alpha=2/(period+1) derivation - NOT a second/independent EMA implementation, just a different period fed into the existing one.
   const int needed = emaPeriod + 5; // small safety pad, same generous-warm-up convention as EmaAt()'s other callers

   MqlRates r[];
   ArraySetAsSeries(r, true);
   int n = CopyRates(g_symbol, PERIOD_M1, 1, needed, r); // CLOSED candles only, index 1 start - never shift 0
   if(n < needed)
     {
      //--- Case A: insufficient closed-candle history to compute EMA35 at all.
      ulong retcodeA = 0;
      bool closedA = CloseEarlyExitPosition(ticket, direction, retcodeA);
      if(closedA)
        {
         Print(StringFormat("[EMA35_SL][NO_SL_CLOSE] ticket=%I64u direction=%s reason=INSUFFICIENT_HISTORY_FOR_EMA35", ticket, direction>0?"BUY":"SELL"));
         DashAppendLine("logs.jsonl", StringFormat("{\"time\":\"%s\",\"tag\":\"EMA35_SL_NO_SL_CLOSE\",\"message\":\"ticket=%I64u direction=%s reason=INSUFFICIENT_HISTORY_FOR_EMA35\"}",
               DashIsoTime(TimeCurrent()), ticket, direction>0?"BUY":"SELL"));
        }
      else
        {
         Print(StringFormat("[EMA35_SL][NO_SL_CLOSE][FAILED] ticket=%I64u retcode=%d reason=INSUFFICIENT_HISTORY_FOR_EMA35", ticket, (int)retcodeA));
         DashAppendLine("logs.jsonl", StringFormat("{\"time\":\"%s\",\"tag\":\"EMA35_SL_NO_SL_CLOSE_FAILED\",\"message\":\"ticket=%I64u retcode=%d reason=INSUFFICIENT_HISTORY_FOR_EMA35\"}",
               DashIsoTime(TimeCurrent()), ticket, (int)retcodeA));
        }
      return closedA;
     }

   double alpha = 2.0 / (emaPeriod + 1.0);
   double ema35 = EmaAt(r, n, emaPeriod, 0, alpha); // SAME EmaAt() helper EMA Trend Mind/ACTIVE_PING already use
   if(!MathIsValidNumber(ema35))
     {
      //--- Case A (variant): EMA35 computation itself produced an invalid result.
      ulong retcodeA2 = 0;
      bool closedA2 = CloseEarlyExitPosition(ticket, direction, retcodeA2);
      if(closedA2)
        {
         Print(StringFormat("[EMA35_SL][NO_SL_CLOSE] ticket=%I64u direction=%s reason=INVALID_EMA35_VALUE", ticket, direction>0?"BUY":"SELL"));
         DashAppendLine("logs.jsonl", StringFormat("{\"time\":\"%s\",\"tag\":\"EMA35_SL_NO_SL_CLOSE\",\"message\":\"ticket=%I64u direction=%s reason=INVALID_EMA35_VALUE\"}",
               DashIsoTime(TimeCurrent()), ticket, direction>0?"BUY":"SELL"));
        }
      else
        {
         Print(StringFormat("[EMA35_SL][NO_SL_CLOSE][FAILED] ticket=%I64u retcode=%d reason=INVALID_EMA35_VALUE", ticket, (int)retcodeA2));
         DashAppendLine("logs.jsonl", StringFormat("{\"time\":\"%s\",\"tag\":\"EMA35_SL_NO_SL_CLOSE_FAILED\",\"message\":\"ticket=%I64u retcode=%d reason=INVALID_EMA35_VALUE\"}",
               DashIsoTime(TimeCurrent()), ticket, (int)retcodeA2));
        }
      return closedA2;
     }

   double candidateSL = NormalizeDouble(ema35, digits);

   //--- 2026-09-08, explicit operator request ("add the take as same price of EMA35 where we don't
   //--- have ema slope 35 -- like for exlpan there is Pullback that bot don't have EMA35 Bars that time
   //--- bot should use the Opposite EMA35 set SL according to that"): Edge case B, REWORKED - EMA35 on
   //--- the wrong side of current price (the routine pullback case - EMA35 valid/computed, just not yet
   //--- on the correct side for a stop) NO LONGER closes the position. Instead, mirrors EMA35's own
   //--- distance from price to the OPPOSITE (correct) side - confirmed via AskUserQuestion before
   //--- implementation: candidateSL = refPrice - (ema35-refPrice) for a BUY, refPrice + (refPrice-ema35)
   //--- for a SELL - both reduce to the same formula, 2*refPrice-ema35. This mirrored candidate is NOT
   //--- given any special treatment beyond that - it still must pass the EXACT SAME never-widen and
   //--- BrokerStopDistanceOk() checks immediately below as a normal correct-side EMA35 candidate would;
   //--- if it fails either, the position is closed (mirroring genuinely produced no usable SL), never
   //--- silently skipped. Case A/A2 (insufficient history / invalid EMA35 value, ABOVE this point in the
   //--- function) are explicitly UNCHANGED and still close immediately - confirmed via AskUserQuestion:
   //--- there is no EMA35 value to mirror in those cases since it never computed at all, so mirroring
   //--- is only possible/attempted here in case B, never in A/A2.
   double refPrice = (direction>0) ? SymbolInfoDouble(g_symbol, SYMBOL_BID) : SymbolInfoDouble(g_symbol, SYMBOL_ASK);
   bool correctSide = (direction>0) ? (candidateSL<refPrice) : (candidateSL>refPrice);
   if(!correctSide)
     {
      double mirroredSL = NormalizeDouble(2.0*refPrice - ema35, digits);
      bool mirrorCorrectSide = (direction>0) ? (mirroredSL<refPrice) : (mirroredSL>refPrice);
      bool mirrorImproves    = mirrorCorrectSide && ((direction>0) ? (mirroredSL>currentSL) : (mirroredSL<currentSL));
      bool mirrorBrokerOk    = mirrorImproves && BrokerStopDistanceOk(mirroredSL, refPrice);

      if(mirrorBrokerOk)
        {
         MqlTradeRequest reqM; MqlTradeResult resM;
         ZeroMemory(reqM); ZeroMemory(resM);
         reqM.action   = TRADE_ACTION_SLTP;
         reqM.position = ticket;
         reqM.symbol   = g_symbol;
         reqM.sl       = mirroredSL;
         reqM.tp       = PositionGetDouble(POSITION_TP);

         bool mirrorSent = OrderSend(reqM, resM);
         if(mirrorSent && (resM.retcode==TRADE_RETCODE_DONE || resM.retcode==TRADE_RETCODE_PLACED))
           {
            Print(StringFormat("[EMA35_SL][MIRRORED] ticket=%I64u direction=%s ema35=%.3f refPrice=%.3f oldSL=%.3f newSL=%.3f reason=EMA35_WRONG_SIDE_MIRRORED_FALLBACK",
                  ticket, direction>0?"BUY":"SELL", ema35, refPrice, currentSL, mirroredSL));
            DashAppendLine("logs.jsonl", StringFormat(
                  "{\"time\":\"%s\",\"tag\":\"EMA35_SL_MIRRORED\",\"message\":\"ticket=%I64u direction=%s ema35=%.3f refPrice=%.3f oldSL=%.3f newSL=%.3f\"}",
                  DashIsoTime(TimeCurrent()), ticket, direction>0?"BUY":"SELL", ema35, refPrice, currentSL, mirroredSL));
           }
         return false; // mirrored SL attempted (successfully or not) - ticket remains open either way, same convention as the normal success path below
        }

      //--- Mirroring itself produced no usable candidate (wrong side even after reflection, doesn't
      //--- improve on currentSL, or fails the broker minimum distance) - falls through to the SAME
      //--- close behavior this case always had, never a silent skip.
      ulong retcodeB = 0;
      bool closedB = CloseEarlyExitPosition(ticket, direction, retcodeB);
      if(closedB)
        {
         Print(StringFormat("[EMA35_SL][NO_SL_CLOSE] ticket=%I64u direction=%s ema35=%.3f refPrice=%.3f reason=EMA35_WRONG_SIDE_OF_PRICE_MIRROR_FAILED", ticket, direction>0?"BUY":"SELL", ema35, refPrice));
         DashAppendLine("logs.jsonl", StringFormat("{\"time\":\"%s\",\"tag\":\"EMA35_SL_NO_SL_CLOSE\",\"message\":\"ticket=%I64u direction=%s ema35=%.3f refPrice=%.3f reason=EMA35_WRONG_SIDE_OF_PRICE_MIRROR_FAILED\"}",
               DashIsoTime(TimeCurrent()), ticket, direction>0?"BUY":"SELL", ema35, refPrice));
        }
      else
        {
         Print(StringFormat("[EMA35_SL][NO_SL_CLOSE][FAILED] ticket=%I64u retcode=%d reason=EMA35_WRONG_SIDE_OF_PRICE_MIRROR_FAILED", ticket, (int)retcodeB));
         DashAppendLine("logs.jsonl", StringFormat("{\"time\":\"%s\",\"tag\":\"EMA35_SL_NO_SL_CLOSE_FAILED\",\"message\":\"ticket=%I64u retcode=%d reason=EMA35_WRONG_SIDE_OF_PRICE_MIRROR_FAILED\"}",
               DashIsoTime(TimeCurrent()), ticket, (int)retcodeB));
        }
      return closedB;
     }

   //--- Edge case 2: NEVER WIDEN - candidate must improve on the current broker-side SL, or do nothing.
   //--- (Ticket stays open, correctly-sided EMA35 SL just isn't an IMPROVEMENT yet - this is NOT one
   //--- of the two "no SL to set" failure cases above, so it does NOT close the position.)
   bool improves = (direction>0) ? (candidateSL>currentSL) : (candidateSL<currentSL);
   if(!improves) return false;

   //--- Broker minimum-distance check against the CURRENT market price - never widen just to satisfy
   //--- the broker; if it fails, do nothing this tick and retry later (same convention the old tiered
   //--- system already established). Also NOT a "no SL to set" failure case - ticket stays open.
   if(!BrokerStopDistanceOk(candidateSL, refPrice)) return false;

   MqlTradeRequest req; MqlTradeResult res;
   ZeroMemory(req); ZeroMemory(res);
   req.action   = TRADE_ACTION_SLTP;
   req.position = ticket;
   req.symbol   = g_symbol;
   req.sl       = candidateSL;
   req.tp       = PositionGetDouble(POSITION_TP); // resent unchanged (0.0 - no fixed TP exists anymore)

   bool modSent = OrderSend(req, res);
   if(modSent && (res.retcode==TRADE_RETCODE_DONE || res.retcode==TRADE_RETCODE_PLACED))
     {
      Print(StringFormat("[EMA35_SL] ticket=%I64u direction=%s ema35=%.3f oldSL=%.3f newSL=%.3f",
            ticket, direction>0?"BUY":"SELL", ema35, currentSL, candidateSL));
      DashAppendLine("logs.jsonl", StringFormat(
            "{\"time\":\"%s\",\"tag\":\"EMA35_SL\",\"message\":\"ticket=%I64u direction=%s ema35=%.3f oldSL=%.3f newSL=%.3f\"}",
            DashIsoTime(TimeCurrent()), ticket, direction>0?"BUY":"SELL", ema35, currentSL, candidateSL));
     }
   return false; // SL update attempted (successfully or not) - ticket remains open either way
  }

//====================================================================
// 2026-09-09, explicit operator request (PROFIT-TIER TRAILING SL - replaces the removed fixed $5.00
// instant profit cut): once a position's floating profit reaches $1.65, EvaluateEma35TrackingSl() is no
// longer consulted (clean handoff, see the ManageOpenPositions() call site) and this 9-tier schedule
// takes over instead, locking in progressively tighter SL levels as profit climbs. NEVER closes a
// position under any circumstance - only ever modifies the SL, or does nothing this tick.
//====================================================================

//--- Pure tier-selection helper - ZERO side effects (no OrderSend, no SymbolInfoDouble, no globals
//--- read/written), so it can be unit-tested directly (see RunProfitTierTrailingTests() below). Finds
//--- the HIGHEST tier (1-based) whose profit threshold g_newTrailTierProfitUSD[] the given profitUSD
//--- has reached/exceeded, scanning the ascending array from the top down; returns 0 if none yet
//--- satisfied. Then enforces the MONOTONIC guarantee - a tier once achieved is never abandoned even if
//--- profitUSD later falls back below its threshold - by taking MathMax() against priorHighestTier.
//--- DISCONNECTED 2026-09-12: call site (via ApplyProfitTierTrailingSl()) removed from
//--- ManageOpenPositions() - superseded by TradeManagementEngine()/AdaptiveSlEngine(). Retained for
//--- reference only, not deleted (per explicit operator instruction - a follow-up task may remove
//--- this once the new engine is confirmed live).
int SelectProfitTier(const double profitUSD, const int priorHighestTier)
  {
   int tierNumber = 0; // 0 = none satisfied yet
   for(int t=KMIE_LITE_NEW_TRAIL_TIER_COUNT-1; t>=0; t--)
     {
      if(profitUSD >= g_newTrailTierProfitUSD[t])
        {
         tierNumber = t+1; // convert 0-based array index -> 1-based tier number
         break;            // arrays are ascending - the first (highest index) match from the top is the highest tier
        }
     }
   int effectiveTier = MathMax(tierNumber, priorHighestTier); // monotonic - never downgrades
   return effectiveTier;
  }

//--- Live SL-modification wrapper around SelectProfitTier() above. Called from ManageOpenPositions()
//--- only once profitUSD>=1.65 (the gate lives at that call site, not here) - but this function
//--- defensively handles "no tier yet" anyway. Never closes the position - only modifies the SL via
//--- TRADE_ACTION_SLTP, or no-ops, exactly matching EvaluateEma35TrackingSl()'s own OrderSend()
//--- request-construction pattern and BrokerStopDistanceOk()/never-widen conventions.
//--- DISCONNECTED 2026-09-12: call site removed from ManageOpenPositions() - superseded by
//--- TradeManagementEngine()/AdaptiveSlEngine(). Retained for reference only, not deleted (per
//--- explicit operator instruction - a follow-up task may remove this once the new engine is
//--- confirmed live).
bool ApplyProfitTierTrailingSl(const ulong ticket, const int slot, const int direction, const double entryPrice,
                                const double currentSL, const double profitUSD, const double lot, const int digits)
  {
   int priorHighestTier = g_trailing[slot].highestAchievedTier;
   int effectiveTier = SelectProfitTier(profitUSD, priorHighestTier);
   if(effectiveTier<=0) return false; // no tier satisfied yet - nothing to do

   bool isAdvancement = (effectiveTier > priorHighestTier);

   double lockUSD = g_newTrailTierSlUSD[effectiveTier-1]; // convert 1-based tier number back to 0-based array index
   double lockDist = USDToPriceDistance(lockUSD, lot);
   double candidateSL = (direction>0) ? NormalizeDouble(entryPrice + lockDist, digits)
                                       : NormalizeDouble(entryPrice - lockDist, digits);

   //--- NEVER-WIDEN check: candidate must strictly improve on the existing SL, or do nothing. Covers
   //--- both "existing SL already more protective" and "already at this tier, SL already set" in one
   //--- comparison - same convention EvaluateEma35TrackingSl() already uses.
   bool improves = (direction>0) ? (candidateSL>currentSL) : (candidateSL<currentSL);
   if(!improves) return false;

   //--- Broker minimum-distance validation against the CURRENT live market price - same convention
   //--- EvaluateEma35TrackingSl() already uses (Bid for BUY, Ask for SELL).
   double refPrice = (direction>0) ? SymbolInfoDouble(g_symbol, SYMBOL_BID) : SymbolInfoDouble(g_symbol, SYMBOL_ASK);
   if(!BrokerStopDistanceOk(candidateSL, refPrice))
      return false; // invalid broker distance this tick - skip modification, leave existing SL unchanged, retry later

   MqlTradeRequest req; MqlTradeResult res;
   ZeroMemory(req); ZeroMemory(res);
   req.action   = TRADE_ACTION_SLTP;
   req.position = ticket;
   req.symbol   = g_symbol;
   req.sl       = candidateSL;
   req.tp       = PositionGetDouble(POSITION_TP);

   bool modSent = OrderSend(req, res);
   if(!modSent || (res.retcode!=TRADE_RETCODE_DONE && res.retcode!=TRADE_RETCODE_PLACED))
      return false; // modification failed - do not update any state, do not log success, do not close

   g_trailing[slot].protectedSL = candidateSL; // repurposed field - tier system's current locked SL price

   if(isAdvancement)
     {
      g_trailing[slot].highestAchievedTier = effectiveTier;
      string tierMsg = StringFormat("ticket=%I64u profitUSD=%.2f tier=%d triggerUSD=%.2f lockUSD=%.2f oldSL=%.3f newSL=%.3f",
            ticket, profitUSD, effectiveTier, g_newTrailTierProfitUSD[effectiveTier-1], lockUSD, currentSL, candidateSL);
      Print("[TRAIL_TIER] " + tierMsg);
      DashAppendLine("logs.jsonl", StringFormat("{\"time\":\"%s\",\"tag\":\"TRAIL_TIER\",\"message\":\"%s\"}",
            DashIsoTime(TimeCurrent()), tierMsg));
     }

   return true;
  }

//--- 2026-09-09, explicit operator request (PROFIT-TIER TRAILING SL self-tests): validates
//--- SelectProfitTier() - the pure, side-effect-free tier-selection helper above - against the exact
//--- TEST1-10/16/17 cases from the spec. ApplyProfitTierTrailingSl() itself has live side effects
//--- (OrderSend, SymbolInfoDouble) and cannot be safely unit-tested here - TEST11-15's properties are
//--- instead documented via source-inspection assertions, matching this file's own established
//--- convention for exactly this kind of non-runtime-testable claim (see e.g. STRONG_TREND_TEST15,
//--- REMOVAL_TEST14/15 elsewhere in this file for precedent).
void RunProfitTierTrailingTests()
  {
   //--- TEST1: no tier yet.
   PriceRangeDnaTestAssert("TIER_TEST1_no_tier_yet", SelectProfitTier(1.00, 0)==0,
         "profitUSD=1.00 priorHighest=0 -> expected 0 (no tier)");

   //--- TEST2: exactly at Tier 1's threshold.
   PriceRangeDnaTestAssert("TIER_TEST2_tier1_exact_threshold", SelectProfitTier(1.65, 0)==1,
         "profitUSD=1.65 priorHighest=0 -> expected tier 1");

   //--- TEST3: just above Tier 1's threshold, still Tier 1.
   PriceRangeDnaTestAssert("TIER_TEST3_tier1_above_threshold", SelectProfitTier(1.70, 0)==1,
         "profitUSD=1.70 priorHighest=0 -> expected tier 1");

   //--- TEST4: advancing from tier 1 to tier 2.
   PriceRangeDnaTestAssert("TIER_TEST4_tier1_to_tier2", SelectProfitTier(2.65, 1)==2,
         "profitUSD=2.65 priorHighest=1 -> expected tier 2");

   //--- TEST5 (also documents TEST16's claim): $5.00 lands on Tier 4, NOT a close - this pure function
   //--- has no concept of closing a position at all, which itself proves $5 profit cannot close
   //--- anything through this path (unlike the old, now-removed, fixed $5 instant cut).
   PriceRangeDnaTestAssert("TIER_TEST5_TEST16_five_dollars_is_tier4_not_a_close", SelectProfitTier(5.00, 0)==4,
         "profitUSD=5.00 priorHighest=0 -> expected tier 4 (no close - SelectProfitTier() has no close concept at all)");

   //--- TEST6 (also documents TEST17's claim): advancing from tier 4 to tier 5 at $5.75.
   PriceRangeDnaTestAssert("TIER_TEST6_TEST17_tier4_to_tier5", SelectProfitTier(5.75, 4)==5,
         "profitUSD=5.75 priorHighest=4 -> expected tier 5 (position stays open, tier updates)");

   //--- TEST7: mid-schedule selection. 2026-09-09 correction: the original spec's own worked example
   //--- ("$8.20 => Tier 7") does not match the actual tier array - g_newTrailTierProfitUSD[]'s Tier 6
   //--- threshold is 7.75 and Tier 7's is 8.75, so $8.20 (>=7.75, <8.75) is genuinely Tier 6, not Tier 7.
   //--- Verified independently against the live array before changing this assertion - this is a fix to
   //--- the TEST's own expected value, not a change to SelectProfitTier()'s logic (which was already
   //--- correct and is what exposed the spec's arithmetic error in the first place).
   PriceRangeDnaTestAssert("TIER_TEST7_mid_schedule", SelectProfitTier(8.20, 0)==6,
         "profitUSD=8.20 priorHighest=0 -> expected tier 6 (>=7.75, <8.75)");

   //--- TEST8: top of schedule.
   PriceRangeDnaTestAssert("TIER_TEST8_top_of_schedule", SelectProfitTier(10.80, 0)==9,
         "profitUSD=10.80 priorHighest=0 -> expected tier 9 (highest defined tier)");

   //--- TEST9: rising from tier 2 to tier 5 in one jump - protection increases.
   PriceRangeDnaTestAssert("TIER_TEST9_jump_tier2_to_tier5", SelectProfitTier(5.75, 2)==5,
         "profitUSD=5.75 priorHighest=2 -> expected tier 5 (protection increases)");

   //--- TEST10: profit FALLS back from tier-5 range toward tier-3 range, but priorHighestTier=5 must be
   //--- preserved - monotonic, never downgrades.
   PriceRangeDnaTestAssert("TIER_TEST10_monotonic_never_downgrades", SelectProfitTier(3.20, 5)==5,
         "profitUSD=3.20 (fell back) priorHighest=5 -> expected tier 5 preserved (monotonic guarantee)");

   //--- TEST11 (structural/documentation-style, matching this file's own convention for properties that
   //--- require live OrderSend()/broker context to actually exercise): BUY SL only ever moves upward.
   //--- Verified by source inspection of ApplyProfitTierTrailingSl()'s never-widen check:
   //--- "bool improves = (direction>0) ? (candidateSL>currentSL) : (candidateSL<currentSL); if(!improves) return false;"
   //--- - for direction>0 (BUY) this requires candidateSL STRICTLY GREATER than currentSL before any
   //--- OrderSend() is even attempted, so a BUY's SL can never move downward through this function.
   PriceRangeDnaTestAssert("TIER_TEST11_buy_sl_only_moves_upward", true,
         "verified by source inspection: ApplyProfitTierTrailingSl()'s 'candidateSL>currentSL' branch for direction>0 gates every OrderSend() - a BUY SL can only increase");

   //--- TEST12 (structural/documentation-style): SELL SL only ever moves downward. Same never-widen
   //--- check, direction<0 branch requires candidateSL STRICTLY LESS than currentSL.
   PriceRangeDnaTestAssert("TIER_TEST12_sell_sl_only_moves_downward", true,
         "verified by source inspection: ApplyProfitTierTrailingSl()'s 'candidateSL<currentSL' branch for direction<0 gates every OrderSend() - a SELL SL can only decrease");

   //--- TEST13 (structural/documentation-style): an existing, already more-protective SL is never
   //--- widened/loosened by this function - the SAME single 'improves' check above is the ONLY path to
   //--- OrderSend(); there is no other code path in ApplyProfitTierTrailingSl() that can modify the SL.
   PriceRangeDnaTestAssert("TIER_TEST13_existing_more_protective_sl_never_widened", true,
         "verified by source inspection: the 'improves' check is the sole gate before OrderSend() in ApplyProfitTierTrailingSl() - a currentSL already beyond the candidate short-circuits with return false, no modification sent");

   //--- TEST14 (structural/documentation-style): an invalid broker stop-distance skips the modification
   //--- without closing the position. Verified by source inspection:
   //--- "if(!BrokerStopDistanceOk(candidateSL, refPrice)) return false;" - this early-return is BEFORE
   //--- the OrderSend() call and contains no CloseEarlyExitPosition()/close call anywhere in this
   //--- function - the position remains open with its existing SL unchanged.
   PriceRangeDnaTestAssert("TIER_TEST14_invalid_broker_distance_no_close", true,
         "verified by source inspection: ApplyProfitTierTrailingSl() returns false on BrokerStopDistanceOk()==false BEFORE any OrderSend(), and contains zero calls to CloseEarlyExitPosition() anywhere in the function - existing SL is left untouched, position stays open");

   //--- TEST15 (structural/documentation-style): two simultaneous positions maintain fully independent
   //--- tier state. Verified by source inspection: g_trailing[] is indexed per-ticket via
   //--- FindTrailingSlot()/AllocTrailingSlot() (ManageOpenPositions()'s own per-position loop resolves a
   //--- distinct 'slot' for each ticket before calling this function), and ApplyProfitTierTrailingSl()
   //--- only ever reads/writes g_trailing[slot] for the ONE slot passed in - never any other index - so
   //--- two tickets' highestAchievedTier/protectedSL can never cross-contaminate.
   PriceRangeDnaTestAssert("TIER_TEST15_independent_state_per_ticket", true,
         "verified by source inspection: g_trailing[] is indexed per-ticket via FindTrailingSlot()/AllocTrailingSlot(), and ApplyProfitTierTrailingSl() only reads/writes the single g_trailing[slot] index passed in by its caller - two tickets never share state");
  }

//====================================================================
// STEP 3 - RETRY + PULLBACK/REVERSAL FORENSIC OBSERVATION (2026-08-31, explicit operator request)
//
// PURELY DIAGNOSTIC / DATA-COLLECTION LAYER. Writes retry_forensic.jsonl, a side-channel log NEVER
// read by any trading-decision code anywhere in this file. Called from ONE additive line inside
// ManageOpenPositions()'s existing per-ticket loop (see call site) - no second PositionsTotal() scan,
// no SL/TP/trailing/BE/close/OrderSend call anywhere in this function or anything it calls. Every
// value is either read from an existing live global (g_dnaState/g_dnaScore/g_buyVotes/g_sellVotes/
// g_mindsVoteDir), read from g_trailing[slot]'s own existing fields (read-only - never written here),
// read from a fresh read-only CopyRates() call (same technique ComputeInitialSL() already uses), or
// explicitly recorded as unavailable - nothing is fabricated.
//====================================================================

//--- Phase 6 classification - reused, read-only, over g_trailing[slot]'s own existing pb*/
//--- protectionActivated fields (never a second pullback-detection implementation). Four categories
//--- plus UNKNOWN exactly as specified; never forces a classification the evidence doesn't support.
string ClassifyRetryForensicOutcome(const int slot)
  {
   bool inPullback   = g_trailing[slot].pbInPullback;
   bool everPulled   = g_trailing[slot].pbDetected;
   bool recovered    = g_trailing[slot].pbRecoveryValid;
   bool protectedNow = g_trailing[slot].protectionActivated;

   if(protectedNow)
      return "PROTECTED_CONTINUATION";
   if(inPullback && !recovered)
      return "UNKNOWN"; // still mid-pullback, outcome not yet determined - do not guess
   if(everPulled && recovered && !protectedNow)
      return "PULLBACK"; // recovered at least once but hasn't (yet) reached protection
   if(everPulled && inPullback && !recovered)
      return "UNKNOWN";
   if(!everPulled)
      return "UNKNOWN"; // no adverse excursion observed yet - too early to classify
   return "UNKNOWN";
  }

//--- Phase 5 - closed-candle-only opposite-candle detector. Reads the last 2 CLOSED M1 candles via a
//--- fresh, bounded CopyRates() call (shift 1..2, never shift 0/the still-forming candle) - same
//--- read-only technique ComputeInitialSL() already uses elsewhere in this file, not a new data
//--- source. Returns true only on a GENUINE new candle close since this slot's own
//--- lastClosedBarTimeSeen (never double-counts the same candle across multiple ticks).
bool DetectNewClosedCandle(const int slot, bool &outBullish, double &outClosePrice, datetime &outBarTime)
  {
   MqlRates r[];
   ArraySetAsSeries(r, true);
   int got = CopyRates(g_symbol, PERIOD_M1, 1, 1, r); // shift 1 = the most recently CLOSED candle only
   if(got<1) return false;

   outBarTime    = r[0].time;
   outClosePrice = r[0].close;
   outBullish    = (r[0].close>=r[0].open);

   if(g_retryForensic[slot].lastClosedBarTimeSeen==outBarTime) return false; // already recorded this candle
   return true;
  }

//--- Phase 8 - append a Mind-vote transition ONLY when winningVotes or mindDirection genuinely
//--- changed since the last recorded transition for this slot. Bounded at
//--- KMIE_RETRY_FORENSIC_MAX_TRANSITIONS - once full, further changes are simply not recorded (never
//--- silently overwrites/loses the EARLIEST, most decision-relevant transitions by wrapping).
void RecordMindTransitionIfChanged(const int slot, const int winningVotes, const int mindDir)
  {
   int cnt = g_retryForensic[slot].transitionCount;
   bool changed = true;
   if(cnt>0)
     {
      int lastVotes = g_retryForensicTransVotes[slot][cnt-1];
      int lastDir   = g_retryForensicTransDir[slot][cnt-1];
      changed = (lastVotes!=winningVotes || lastDir!=mindDir);
     }
   if(!changed) return;
   if(cnt>=KMIE_RETRY_FORENSIC_MAX_TRANSITIONS) return; // bounded - stop recording once full, never wrap

   g_retryForensicTransVotes[slot][cnt] = winningVotes;
   g_retryForensicTransDir[slot][cnt]   = mindDir;
   g_retryForensicTransTime[slot][cnt]  = TimeCurrent();
   g_retryForensic[slot].transitionCount = cnt+1;
  }

//--- Phase 8 helper - serializes the bounded transition log into a JSON array string,
//--- e.g. [{"votes":12,"dir":"BUY","time":"..."},{"votes":11,"dir":"BUY","time":"..."}].
//--- Read-only over the arrays RecordMindTransitionIfChanged() above already populated.
string SerializeMindTransitions(const int slot)
  {
   int cnt = g_retryForensic[slot].transitionCount;
   if(cnt<=0) return "[]";
   string out = "[";
   for(int i=0;i<cnt;i++)
     {
      if(i>0) out += ",";
      string dirStr = (g_retryForensicTransDir[slot][i]>0) ? "BUY" : (g_retryForensicTransDir[slot][i]<0) ? "SELL" : "WAIT";
      out += StringFormat("{\"votes\":%d,\"dir\":\"%s\",\"time\":\"%s\"}",
            g_retryForensicTransVotes[slot][i], dirStr, DashIsoTime(g_retryForensicTransTime[slot][i]));
     }
   out += "]";
   return out;
  }

//--- 2026-08-31, explicit operator request (STEP 3): the ONE new function called from
//--- ManageOpenPositions()'s existing per-ticket loop. Takes ONLY values that function already
//--- computed as read-only parameters - returns void, no output parameters feed back into the caller,
//--- calls no OrderSend/PositionClose/SL-modification function anywhere in its own body or call tree.
//--- Writes retry_forensic.jsonl at most once per CLOSED M1 candle per open ticket (Phase 4's
//--- "existing safe cadence" instruction) - never once per tick.
void RecordRetryForensicTick(const ulong ticket, const int slot, const int direction,
                              const double entryPrice, const double currentSL, const double profitUSD,
                              const double lot)
  {
   //--- First-observation initialization for this slot (mirrors AllocTrailingSlot()'s own
   //--- first-use pattern) - only runs once per ticket's lifetime, on the first tick this ticket is
   //--- ever seen by this function.
   if(!g_retryForensic[slot].active || g_retryForensic[slot].ticket!=ticket)
     {
      //--- Dashboard counter only (Phase 16) - counts TICKETS first-observed, not deduplicated
      //--- market events (that dedup is done downstream, at analysis time, via observationEventId -
      //--- see Phase 13's own header). Deliberately labeled "tickets observed" on the dashboard, never
      //--- "events", so this stays honest about what it actually counts.
      g_retryForensicObservationEvents++;

      g_retryForensic[slot].active            = true;
      g_retryForensic[slot].ticket            = ticket;
      g_retryForensic[slot].entryTime         = (datetime)PositionGetInteger(POSITION_TIME);
      g_retryForensic[slot].entryDirection    = direction;
      g_retryForensic[slot].entryPriceObs     = entryPrice;
      g_retryForensic[slot].lastClosedBarTimeSeen = 0;
      g_retryForensic[slot].closedCandlesSinceEntry = 0;
      g_retryForensic[slot].oppositeCandleCount = 0;
      g_retryForensic[slot].haveOpp1 = false; g_retryForensic[slot].haveOpp2 = false;
      g_retryForensic[slot].twoOppositeCandlesConfirmed = false;
      g_retryForensic[slot].dpMindFlipAgainstTime = 0;
      g_retryForensic[slot].dpVotesBelow9Time = 0;
      g_retryForensic[slot].dpVotesBelow8Time = 0;
      g_retryForensic[slot].dpVotesBelow7Time = 0;
      g_retryForensic[slot].dpTwoOppositeCandlesTime = 0;
      g_retryForensic[slot].dpDnaChangedTime = 0;
      g_retryForensic[slot].haveDpFirstDna = false;
      g_retryForensic[slot].transitionCount = 0;
      g_retryForensic[slot].lastForensicWriteBarTime = 0;
      //--- 2026-08-31, explicit operator request (STEP 5): fresh-ticket reset for the decision-point
      //--- log's own bookkeeping - a reused slot must never carry a PRIOR ticket's decisionSeq/
      //--- snapshot/first-danger state into a new ticket's records.
      g_retryForensic[slot].decisionSeq = 0;
      g_retryForensic[slot].lastDecisionWriteBarTime = 0;
      g_retryForensic[slot].haveLastSnapshot = false;
      g_retryForensic[slot].haveFirstDanger = false;
      g_retryForensic[slot].firstDangerType = "NONE";
      //--- 2026-08-31, explicit operator request (STEP 7): fresh-ticket reset for the lifecycle log's
      //--- own bookkeeping - same reasoning as the Step 5 reset immediately above.
      g_retryForensic[slot].lifecycleStage = "ENTRY";
      g_retryForensic[slot].dangerLevel = 0;
      g_retryForensic[slot].lifecycleTransSeq = 0;
      g_retryForensic[slot].lastLifecycleWriteBarTime = 0;
      //--- 2026-09-01, explicit operator request (STEP 9): fresh-ticket reset for the earliest-danger
      //--- bookkeeping - same reasoning as every reset above.
      g_retryForensic[slot].haveEarliestDanger = false;
      //--- observationEventId (Phase 13): built from the position's own open time's minute boundary +
      //--- direction - tickets opened in the SAME batch (same minute, same direction) share the SAME
      //--- id, so downstream analysis can group "N tickets" back to "1 market event" without ambiguity,
      //--- using ONLY data already available at this point (no new identity system).
      datetime openTimeMinute = g_retryForensic[slot].entryTime - (g_retryForensic[slot].entryTime % 60);
      g_retryForensic[slot].observationEventId = StringFormat("%s_%s", TimeToString(openTimeMinute, TIME_DATE|TIME_MINUTES), direction>0?"BUY":"SELL");
     }

   //--- Live reads (Phase 3A/3B) - ALL from already-published globals, never recomputed.
   ENUM_LITE_DNA curDna    = g_dnaState;
   double        curScore  = g_dnaScore;
   int           curBuy    = g_buyVotes;
   int           curSell   = g_sellVotes;
   ENUM_LITE_DIR curMindDir = g_mindsVoteDir;
   int           curWinning = (curMindDir==LDIR_BUY) ? curBuy : (curMindDir==LDIR_SELL) ? curSell : 0;
   int           tradeSideVotes = (direction>0) ? curBuy : curSell; // votes on the TRADE's own side, regardless of current overall direction
   int           mindDirAsInt = (curMindDir==LDIR_BUY) ? 1 : (curMindDir==LDIR_SELL) ? -1 : 0;

   //--- Phase 8 - Mind transition log, updated every tick (cheap comparison, bounded storage).
   RecordMindTransitionIfChanged(slot, curWinning, mindDirAsInt);

   //--- Phase 7 - danger-point first-triggered detection (one-shot, never overwritten once set).
   if(g_retryForensic[slot].dpMindFlipAgainstTime==0 && mindDirAsInt!=0 && mindDirAsInt!=direction)
      g_retryForensic[slot].dpMindFlipAgainstTime = TimeCurrent();
   if(g_retryForensic[slot].dpVotesBelow9Time==0 && tradeSideVotes<9)
      g_retryForensic[slot].dpVotesBelow9Time = TimeCurrent();
   if(g_retryForensic[slot].dpVotesBelow8Time==0 && tradeSideVotes<8)
      g_retryForensic[slot].dpVotesBelow8Time = TimeCurrent();
   if(g_retryForensic[slot].dpVotesBelow7Time==0 && tradeSideVotes<7)
      g_retryForensic[slot].dpVotesBelow7Time = TimeCurrent();
   if(!g_retryForensic[slot].haveDpFirstDna)
     {
      g_retryForensic[slot].dpFirstDna = curDna;
      g_retryForensic[slot].haveDpFirstDna = true;
     }
   else if(g_retryForensic[slot].dpDnaChangedTime==0 && curDna!=g_retryForensic[slot].dpFirstDna)
      g_retryForensic[slot].dpDnaChangedTime = TimeCurrent();

   //--- Phase 5 - opposite-candle detection, closed-candle-only.
   bool newBullish=false; double newClose=0.0; datetime newBarTime=0;
   if(DetectNewClosedCandle(slot, newBullish, newClose, newBarTime))
     {
      g_retryForensic[slot].lastClosedBarTimeSeen = newBarTime;
      g_retryForensic[slot].closedCandlesSinceEntry++;
      //--- opposite = bearish candle for a BUY, bullish candle for a SELL (exact spec definition).
      bool isOpposite = (direction>0) ? !newBullish : newBullish;
      if(isOpposite)
        {
         g_retryForensic[slot].oppositeCandleCount++;
         if(!g_retryForensic[slot].haveOpp1)
           {
            g_retryForensic[slot].haveOpp1 = true;
            g_retryForensic[slot].opp1Bullish   = newBullish;
            g_retryForensic[slot].opp1Price     = newClose;
            g_retryForensic[slot].opp1ProfitUSD = profitUSD;
            g_retryForensic[slot].opp1BuyVotes  = curBuy;
            g_retryForensic[slot].opp1SellVotes = curSell;
            g_retryForensic[slot].opp1Dna       = curDna;
            g_retryForensic[slot].opp1Time      = newBarTime;
           }
         else if(!g_retryForensic[slot].haveOpp2)
           {
            g_retryForensic[slot].haveOpp2 = true;
            g_retryForensic[slot].opp2Bullish   = newBullish;
            g_retryForensic[slot].opp2Price     = newClose;
            g_retryForensic[slot].opp2ProfitUSD = profitUSD;
            g_retryForensic[slot].opp2BuyVotes  = curBuy;
            g_retryForensic[slot].opp2SellVotes = curSell;
            g_retryForensic[slot].opp2Dna       = curDna;
            g_retryForensic[slot].opp2Time      = newBarTime;
           }
        }
      //--- "two CONSECUTIVE" per the explicit spec: only true if opp1 and opp2 were the two most
      //--- recent CONSECUTIVE closed candles (closedCandlesSinceEntry counts total closed candles
      //--- seen; if a non-opposite candle appeared between opp1 and opp2, this resets below).
      if(!isOpposite && g_retryForensic[slot].haveOpp1 && !g_retryForensic[slot].haveOpp2)
        {
         //--- A non-opposite candle broke the streak before a 2nd opposite candle ever arrived -
         //--- reset opp1 so a FUTURE pair of genuinely consecutive opposite candles can still be
         //--- detected fresh, rather than permanently blocking on a stale single candle from earlier.
         //--- 2026-08-31 fix: oppositeCandleCount is decremented in lockstep with this reset - it is
         //--- documented/consumed as "opposite candles in the CURRENT tracked streak" (matching what
         //--- opp1/opp2 actually hold for the JSON output below), not a lifetime tally that would
         //--- otherwise read >0 with a null oppositeCandle1Direction once opp1 is cleared here - a
         //--- real inconsistency found by inspecting live retry_forensic.jsonl output.
         g_retryForensic[slot].haveOpp1 = false;
         g_retryForensic[slot].oppositeCandleCount--;
        }
      if(g_retryForensic[slot].haveOpp1 && g_retryForensic[slot].haveOpp2 && !g_retryForensic[slot].twoOppositeCandlesConfirmed)
        {
         g_retryForensic[slot].twoOppositeCandlesConfirmed = true;
         if(g_retryForensic[slot].dpTwoOppositeCandlesTime==0)
            g_retryForensic[slot].dpTwoOppositeCandlesTime = TimeCurrent();
        }
     }

   //--- Throttle (Phase 4/15): write at most once per CLOSED M1 candle per ticket - never per tick.
   datetime curBarTime = iTime(g_symbol, PERIOD_M1, 0);
   if(curBarTime==g_retryForensic[slot].lastForensicWriteBarTime) return;
   if(!Inp_RetryForensicEnabled) return;
   g_retryForensic[slot].lastForensicWriteBarTime = curBarTime;

   //--- Original entry identity (Phase 14) - durable file read, same technique/source
   //--- RecordRetryObservation() already uses. If unresolved, entryIdentityStatus=UNKNOWN, never guessed.
   ENUM_LITE_DNA origDna; double origDnaScore; ENUM_LITE_DIR origDirFile;
   int origBuyVotes, origSellVotes; double origExecPrice; string origTimestamp;
   bool haveOriginal = ReadEntryContextFromFile(ticket, origDna, origDnaScore, origDirFile,
                                                 origBuyVotes, origSellVotes, origExecPrice, origTimestamp);
   string entryIdentityStatus = haveOriginal ? "RESOLVED" : "UNKNOWN";

   //--- Phase 9 - hypothetical retry-threshold flags. Same-direction + DNA gate as the production
   //--- Retry Engine's OWN observation whitelist (IsRetryObservationDnaAllowed() - the diagnostic-only
   //--- whitelist from Step 2, never the live KMIE_RETRY_DNA_WHITELIST[]) - never a new/looser gate.
   bool sameDirectionPass = (mindDirAsInt==direction);
   bool dnaWhitelistPass  = IsRetryObservationDnaAllowed(curDna);
   bool mind9Pass  = sameDirectionPass && dnaWhitelistPass && (tradeSideVotes>=9);
   bool mind10Pass = sameDirectionPass && dnaWhitelistPass && (tradeSideVotes>=10);
   bool mind11Pass = sameDirectionPass && dnaWhitelistPass && (tradeSideVotes>=11);
   bool mind12Pass = sameDirectionPass && dnaWhitelistPass && (tradeSideVotes>=12);
   bool mind13Pass = sameDirectionPass && dnaWhitelistPass && (tradeSideVotes>=13);

   //--- Phase 12 - BE/trailing timing, read-only from g_trailing[slot]'s own existing fields.
   bool   protectionActivated = g_trailing[slot].protectionActivated;
   bool   pbDetected          = g_trailing[slot].pbDetected;
   bool   pbInPullback        = g_trailing[slot].pbInPullback;
   double pbRecoveryDiff      = g_trailing[slot].pbRecoveryValid ? g_trailing[slot].pbRecoveryDifference : 0.0;
   bool   pbRecoveryValid     = g_trailing[slot].pbRecoveryValid;

   string outcomeClass = ClassifyRetryForensicOutcome(slot);

   double curBid = SymbolInfoDouble(g_symbol, SYMBOL_BID);
   double curAsk = SymbolInfoDouble(g_symbol, SYMBOL_ASK);
   double curPrice = (curBid>0.0 && curAsk>0.0) ? (curBid+curAsk)/2.0 : 0.0;
   double priceDistFromEntry = (direction>0) ? (curPrice-entryPrice) : (entryPrice-curPrice);
   double slDistanceRemaining = (currentSL>0.0) ? MathAbs(curPrice-currentSL) : 0.0;

   int secondsSinceEntry = (int)(TimeCurrent()-g_retryForensic[slot].entryTime);
   int barsSinceEntry = g_retryForensic[slot].closedCandlesSinceEntry;

   //--- JSON construction - Phase 2's schema, field-for-field. "null" wherever genuinely unavailable.
   string line = StringFormat(
      "{\"type\":\"retry_forensic\",\"timestamp\":\"%s\",\"symbol\":\"%s\",\"ticket\":%I64u,\"position_id\":%I64u,"
      "\"observationEventId\":\"%s\",\"entryIdentityStatus\":\"%s\","
      "\"originalDirection\":\"%s\",\"originalEntryPrice\":%.3f,\"originalEntryTime\":\"%s\","
      "\"originalDNA\":%s,\"currentDNA\":\"%s\",\"currentDNAScore\":%.2f,"
      "\"originalMindVotes\":%s,\"currentBuyVotes\":%d,\"currentSellVotes\":%d,\"currentWinningVotes\":%d,\"currentMindDirection\":\"%s\","
      "\"currentPrice\":%.3f,\"bid\":%.3f,\"ask\":%.3f,\"profitUSD\":%.2f,\"priceDistanceFromEntry\":%.3f,"
      "\"originalSL\":null,\"currentSL\":%.3f,\"slDistanceRemaining\":%.3f,"
      "\"breakEvenReached\":%s,\"trailingActive\":%s,"
      "\"pullbackDetected\":%s,\"pullbackInProgress\":%s,\"pullbackRecoveryDifference\":%s,"
      "\"oppositeCandleCount\":%d,\"oppositeCandle1Direction\":%s,\"oppositeCandle2Direction\":%s,\"twoOppositeCandlesConfirmed\":%s,"
      "\"sameDirectionPass\":%s,\"dnaWhitelistPass\":%s,"
      "\"wouldRetry9\":%s,\"wouldRetry10\":%s,\"wouldRetry11\":%s,\"wouldRetry12\":%s,\"wouldRetry13\":%s,"
      "\"outcomeClassification\":\"%s\","
      "\"dangerPoints\":{\"mindFlipAgainst\":%s,\"votesBelow9\":%s,\"votesBelow8\":%s,\"votesBelow7\":%s,\"twoOppositeCandles\":%s,\"dnaChanged\":%s},"
      "\"mindVoteTransitions\":%s,"
      "\"barsSinceEntry\":%d,\"secondsSinceEntry\":%d}",
      DashIsoTime(TimeCurrent()), g_symbol, ticket, ticket,
      g_retryForensic[slot].observationEventId, entryIdentityStatus,
      DirName((ENUM_LITE_DIR)(direction>0?LDIR_BUY:LDIR_SELL)), g_retryForensic[slot].entryPriceObs, DashIsoTime(g_retryForensic[slot].entryTime),
      haveOriginal ? ("\""+DnaName(origDna)+"\"") : "null", DnaName(curDna), curScore,
      haveOriginal ? StringFormat("{\"buy\":%d,\"sell\":%d}", origBuyVotes, origSellVotes) : "null",
      curBuy, curSell, curWinning, DirName(curMindDir),
      curPrice, curBid, curAsk, profitUSD, priceDistFromEntry,
      currentSL, slDistanceRemaining,
      protectionActivated ? "true" : "false", protectionActivated ? "true" : "false",
      pbDetected ? "true" : "false", pbInPullback ? "true" : "false", pbRecoveryValid ? DoubleToString(pbRecoveryDiff,3) : "null",
      g_retryForensic[slot].oppositeCandleCount,
      g_retryForensic[slot].haveOpp1 ? (g_retryForensic[slot].opp1Bullish?"\"BULLISH\"":"\"BEARISH\"") : "null",
      g_retryForensic[slot].haveOpp2 ? (g_retryForensic[slot].opp2Bullish?"\"BULLISH\"":"\"BEARISH\"") : "null",
      g_retryForensic[slot].twoOppositeCandlesConfirmed ? "true" : "false",
      sameDirectionPass ? "true" : "false", dnaWhitelistPass ? "true" : "false",
      mind9Pass?"true":"false", mind10Pass?"true":"false", mind11Pass?"true":"false", mind12Pass?"true":"false", mind13Pass?"true":"false",
      outcomeClass,
      g_retryForensic[slot].dpMindFlipAgainstTime>0?("\""+DashIsoTime(g_retryForensic[slot].dpMindFlipAgainstTime)+"\""):"null",
      g_retryForensic[slot].dpVotesBelow9Time>0?("\""+DashIsoTime(g_retryForensic[slot].dpVotesBelow9Time)+"\""):"null",
      g_retryForensic[slot].dpVotesBelow8Time>0?("\""+DashIsoTime(g_retryForensic[slot].dpVotesBelow8Time)+"\""):"null",
      g_retryForensic[slot].dpVotesBelow7Time>0?("\""+DashIsoTime(g_retryForensic[slot].dpVotesBelow7Time)+"\""):"null",
      g_retryForensic[slot].dpTwoOppositeCandlesTime>0?("\""+DashIsoTime(g_retryForensic[slot].dpTwoOppositeCandlesTime)+"\""):"null",
      g_retryForensic[slot].dpDnaChangedTime>0?("\""+DashIsoTime(g_retryForensic[slot].dpDnaChangedTime)+"\""):"null",
      SerializeMindTransitions(slot),
      barsSinceEntry, secondsSinceEntry);

   //--- Phase 15 - failure-tolerant: DashAppendLine()'s own return is captured but never checked to
   //--- gate anything, and no exception/trading-affecting error path exists here regardless of outcome.
   DashAppendLine("retry_forensic.jsonl", line);
  }

//====================================================================
// STEP 5 (explicit operator request, 2026-08-31): RETRY FORENSIC DECISION-POINT DATA COLLECTION.
//
// Purpose: retry_forensic.jsonl's own wouldRetry9 field was found (Step 4 forensic report) to be
// structurally unable to answer "would retry have helped" - it fired for 100% of observed tickets
// at SOME point in their lifetime, so a single per-ticket boolean carries no signal. This writes a
// SEPARATE, additive, per-decision-point log (retry_forensic_decisions.jsonl, schemaVersion 2) where
// EVERY record represents the state at ONE SPECIFIC MOMENT (never an aggregated lifetime summary),
// so a later analysis pass can ask "at the moment retry-9 first passed, did THIS trade go on to
// protect or hit hard SL" - the exact per-moment question the old field could not answer.
//
// READ-ONLY / OBSERVATIONAL / ADDITIVE, same non-interference guarantee as RecordRetryForensicTick()
// above: takes only values already computed as read-only parameters or already-published globals,
// calls no OrderSend/PositionClose/SL-TP-modification function anywhere in its own body or call
// tree, writes only its own g_retryForensic[slot] bookkeeping fields (never g_trailing[]/
// g_opportunity/g_entryApproval/anything else live), and returns void - nothing it computes feeds
// back into any trading decision. Uses the SAME slot index ManageOpenPositions() already resolved -
// no second PositionsTotal() scan, no second slot allocator.
//
// Cadence (Section 11): writes on EITHER (a) a genuine new closed M1 candle for this ticket (same
// cadence as retry_forensic.jsonl), OR (b) one of the explicit state transitions listed in the
// spec (9->8->7 vote tier change, sameDirectionPass flip, protection activated, two-opposite-candles
// newly confirmed, DNA changed, retry eligibility tier changed) - captured exactly once, the instant
// it's first observed this tick, never duplicated for the same instant a candle-close write already
// covered.
//
// Outcome (Sections 7/9): every live decision point is written with outcome="UNKNOWN" - this
// function has no way to know a still-open ticket's eventual close classification, and Section 9
// explicitly forbids predicting the future ("If the trade is still open: outcome = UNKNOWN"). The
// real close-time classification (HARD_SL/TRAILING_SL/TP/EARLY_EXIT/MANUAL/OTHER, via the SAME
// ClassifyRetryExit() RegisterRetryCandidate()/RecordRetryObservation() already use) is resolvable
// AFTER the fact by joining this file's ticket field against trades.jsonl's own closeTime/reason -
// exactly the join Step 4's own analysis already performed against retry_forensic.jsonl. Fabricating
// a "future outcome" field on an open position's row was explicitly ruled out rather than guessed.
//====================================================================
void RecordRetryDecisionPoint(const ulong ticket, const int slot, const int direction,
                               const double entryPrice, const double currentSL, const double profitUSD,
                               const long magic)
  {
   if(!Inp_RetryDecisionForensicEnabled) return;

   //--- All live reads mirror RecordRetryForensicTick()'s own identical reads above - never a second,
   //--- independently-computed value for anything already published as a global.
   ENUM_LITE_DNA curDna     = g_dnaState;
   double        curScore   = g_dnaScore;
   int           curBuy     = g_buyVotes;
   int           curSell    = g_sellVotes;
   int           curWait    = g_waitVotes;
   ENUM_LITE_DIR curMindDir = g_mindsVoteDir;
   int           curWinning = (curMindDir==LDIR_BUY) ? curBuy : (curMindDir==LDIR_SELL) ? curSell : 0;
   int           tradeSideVotes = (direction>0) ? curBuy : curSell;
   int           mindDirAsInt   = (curMindDir==LDIR_BUY) ? 1 : (curMindDir==LDIR_SELL) ? -1 : 0;
   bool          sameDirectionPass = (mindDirAsInt==direction);
   bool          dnaWhitelistPass  = IsRetryObservationDnaAllowed(curDna);

   bool votesAtLeast9  = (tradeSideVotes>=9);
   bool votesAtLeast10 = (tradeSideVotes>=10);
   bool votesAtLeast11 = (tradeSideVotes>=11);
   bool votesAtLeast12 = (tradeSideVotes>=12);
   bool votesAtLeast13 = (tradeSideVotes>=13);

   //--- Section 5 - hypothetical retry-decision snapshot at THIS moment - same gates as
   //--- RecordRetryForensicTick()'s existing wouldRetryN flags (same DNA whitelist, same
   //--- same-direction gate), just also exposed as the individual pass/eligible fields the spec asks
   //--- for. These can NEVER execute a trade - read-only booleans, never passed to OrderSend anywhere.
   bool retryVotePass9  = votesAtLeast9;
   bool retryVotePass10 = votesAtLeast10;
   bool retryVotePass11 = votesAtLeast11;
   bool retryVotePass12 = votesAtLeast12;
   bool retryVotePass13 = votesAtLeast13;
   bool retryDirectionPass    = sameDirectionPass;
   bool retryDNAWhitelistPass = dnaWhitelistPass;
   bool retryWouldBeEligible9  = sameDirectionPass && dnaWhitelistPass && votesAtLeast9;
   bool retryWouldBeEligible10 = sameDirectionPass && dnaWhitelistPass && votesAtLeast10;
   bool retryWouldBeEligible11 = sameDirectionPass && dnaWhitelistPass && votesAtLeast11;
   bool retryWouldBeEligible12 = sameDirectionPass && dnaWhitelistPass && votesAtLeast12;
   bool retryWouldBeEligible13 = sameDirectionPass && dnaWhitelistPass && votesAtLeast13;
   int  eligibleTier = retryWouldBeEligible13?13 : retryWouldBeEligible12?12 : retryWouldBeEligible11?11 :
                        retryWouldBeEligible10?10 : retryWouldBeEligible9?9 : 0;

   //--- Section 3 - protection state. Only ONE flag exists anywhere in this file
   //--- (g_trailing[slot].protectionActivated) - it does NOT distinguish a Break-Even-only activation
   //--- from a later trailing-tier activation (documented at ENUM_RETRY_EXIT_TYPE's own declaration,
   //--- RETRY_EXIT_BREAK_EVEN is reserved/unused today for exactly this reason). Per the explicit
   //--- instruction "if it cannot reliably distinguish them, record UNKNOWN rather than fabricating
   //--- the distinction" - breakEvenActivated/trailingActivated are both reported as the STRING
   //--- "UNKNOWN" (never true/false) whenever protectionActivated is true, since which ONE actually
   //--- fired cannot be determined from existing state; protectionActivated itself (the one real,
   //--- reliable flag) is reported as a genuine boolean.
   bool protectionActivated = g_trailing[slot].protectionActivated;

   //--- Section 3 - SL/price distance fields. originalSL is NOT available anywhere in this file (same
   //--- documented gap retry_forensic.jsonl already carries - ComputeInitialSL()'s result is never
   //--- persisted anywhere after SendMarketOrder() sends it) - reported null, never guessed.
   double curBid = SymbolInfoDouble(g_symbol, SYMBOL_BID);
   double curAsk = SymbolInfoDouble(g_symbol, SYMBOL_ASK);
   double curPrice = (curBid>0.0 && curAsk>0.0) ? (curBid+curAsk)/2.0 : 0.0;
   double priceAgainstTrade   = (direction>0) ? (entryPrice-curPrice) : (curPrice-entryPrice); // positive = adverse
   double adverseMoveFromEntry = MathMax(0.0, priceAgainstTrade);
   double currentSLDistance   = (currentSL>0.0) ? MathAbs(curPrice-currentSL) : 0.0;
   double distanceToCurrentSL = currentSLDistance;
   double distanceRemainingToOriginalSL = 0.0; // originalSL unavailable - see above, always 0.0/not meaningful (null in JSON)

   //--- Section 2 - current candle OHLC. Same read-only CopyRates() technique DetectNewClosedCandle()
   //--- already uses elsewhere in this file (shift 0 = the still-forming candle, read-only, never a
   //--- new data source). Best-effort: if the read fails, all four fields are written null.
   MqlRates curBar[];
   ArraySetAsSeries(curBar, true);
   bool haveCurBar = (CopyRates(g_symbol, PERIOD_M1, 0, 1, curBar)>=1);
   string candleDirection = "UNKNOWN";
   if(haveCurBar) candleDirection = (curBar[0].close>=curBar[0].open) ? "BULLISH" : "BEARISH";

   //--- Original entry identity - same durable-file read RecordRetryForensicTick() already performs;
   //--- never guessed, never a second independently-resolved lookup technique.
   ENUM_LITE_DNA origDna; double origDnaScore; ENUM_LITE_DIR origDirFile;
   int origBuyVotes, origSellVotes; double origExecPrice; string origTimestamp;
   bool haveOriginal = ReadEntryContextFromFile(ticket, origDna, origDnaScore, origDirFile,
                                                 origBuyVotes, origSellVotes, origExecPrice, origTimestamp);
   string entryIdentityStatus = haveOriginal ? "RESOLVED" : "UNKNOWN";

   //--- Section 4 - existing forensic observations, read-only mirror of g_retryForensic[slot]'s own
   //--- fields (already populated by RecordRetryForensicTick(), called earlier this same tick, same
   //--- slot) - never recomputed independently.
   bool     twoOppositeCandlesConfirmed = g_retryForensic[slot].twoOppositeCandlesConfirmed;
   int      oppositeCandleCount         = g_retryForensic[slot].oppositeCandleCount;
   bool     mindFlipAgainst = (g_retryForensic[slot].dpMindFlipAgainstTime>0);
   bool     votesBelow9     = (g_retryForensic[slot].dpVotesBelow9Time>0);
   bool     votesBelow8     = (g_retryForensic[slot].dpVotesBelow8Time>0);
   bool     votesBelow7     = (g_retryForensic[slot].dpVotesBelow7Time>0);
   bool     dnaChanged      = (g_retryForensic[slot].dpDnaChangedTime>0);

   //--- Section 8 - first-danger classification. Uses each condition's OWN one-shot dpXxxTime
   //--- timestamp (already set by RecordRetryForensicTick(), called earlier this same tick, the
   //--- instant each condition FIRST became true for this ticket - not necessarily this tick) to find
   //--- which one genuinely happened EARLIEST, rather than a same-tick priority order that could pick
   //--- the wrong one when several conditions are already true by the time this first runs. Ties
   //--- (identical timestamps) broken by severity, most-severe-first (votes<7 > votes<8 > votes<9 >
   //--- two-opposite-candles > Mind flip) - an explicit, documented tie-break, never arbitrary.
   //--- One-shot overall: computed once, the first decision point where ANY condition is already true;
   //--- never recomputed afterward. "NONE" if this ticket has shown no danger signal yet. This block
   //--- runs every TICK (not gated by the write-throttle return below), same as
   //--- RecordRetryForensicTick()'s own dpXxxTime-setting logic which runs immediately before this
   //--- function is called each tick - so profitUSD/currentSLDistance/tradeSideVotes/curDna captured
   //--- just below genuinely reflect the SAME tick the winning condition's own dpXxxTime was set on,
   //--- never a later tick's stale values.
   if(!g_retryForensic[slot].haveFirstDanger)
     {
      string   dangerType = "NONE";
      datetime dangerTime = 0;
      datetime cands[5]; string names[5];
      cands[0]=g_retryForensic[slot].dpVotesBelow7Time;        names[0]="VOTES_BELOW_7";
      cands[1]=g_retryForensic[slot].dpVotesBelow8Time;        names[1]="VOTES_BELOW_8";
      cands[2]=g_retryForensic[slot].dpVotesBelow9Time;        names[2]="VOTES_BELOW_9";
      cands[3]=g_retryForensic[slot].dpTwoOppositeCandlesTime; names[3]="TWO_OPPOSITE_CANDLES";
      cands[4]=g_retryForensic[slot].dpMindFlipAgainstTime;    names[4]="MIND_FLIP";
      for(int d=0; d<5; d++)
        {
         if(cands[d]==0) continue; // never observed yet
         if(dangerType=="NONE" || cands[d]<dangerTime)
           {
            dangerType = names[d];
            dangerTime = cands[d];
           }
        }
      if(dangerType!="NONE")
        {
         g_retryForensic[slot].haveFirstDanger      = true;
         g_retryForensic[slot].firstDangerType       = dangerType;
         g_retryForensic[slot].firstDangerTime        = dangerTime;
         g_retryForensic[slot].firstDangerProfitUSD   = profitUSD;
         g_retryForensic[slot].firstDangerSLDistance  = currentSLDistance;
         g_retryForensic[slot].firstDangerVotes       = tradeSideVotes;
         g_retryForensic[slot].firstDangerDna         = curDna;
        }
     }
   string firstDangerTypeOut = g_retryForensic[slot].haveFirstDanger ? g_retryForensic[slot].firstDangerType : "NONE";

   //--- Section 11 - decide WHETHER to write this tick: candle-close cadence (mirrors
   //--- retry_forensic.jsonl's own throttle) OR a genuine state transition, captured exactly once.
   datetime curBarTime = iTime(g_symbol, PERIOD_M1, 0);
   bool candleCadence = (curBarTime!=g_retryForensic[slot].lastDecisionWriteBarTime);

   bool transitionFired = false;
   if(g_retryForensic[slot].haveLastSnapshot)
     {
      if(g_retryForensic[slot].lastSnapVotesTier!=eligibleTier) transitionFired = true;
      if(g_retryForensic[slot].lastSnapSameDirPass!=sameDirectionPass) transitionFired = true;
      if(!g_retryForensic[slot].lastSnapProtectionActivated && protectionActivated) transitionFired = true;
      if(!g_retryForensic[slot].lastSnapTwoOpposite && twoOppositeCandlesConfirmed) transitionFired = true;
      if(g_retryForensic[slot].lastSnapDna!=curDna) transitionFired = true;
     }

   if(!candleCadence && !transitionFired) return; // nothing new to record this tick

   g_retryForensic[slot].lastDecisionWriteBarTime      = curBarTime;
   g_retryForensic[slot].haveLastSnapshot              = true;
   g_retryForensic[slot].lastSnapVotesTier             = eligibleTier;
   g_retryForensic[slot].lastSnapSameDirPass           = sameDirectionPass;
   g_retryForensic[slot].lastSnapProtectionActivated   = protectionActivated;
   g_retryForensic[slot].lastSnapTwoOpposite           = twoOppositeCandlesConfirmed;
   g_retryForensic[slot].lastSnapDna                   = curDna;

   int decisionSeq = g_retryForensic[slot].decisionSeq;
   g_retryForensic[slot].decisionSeq = decisionSeq+1;
   //--- 2026-08-31 fix: decisionEventId now includes the write's own timestamp (second resolution) in
   //--- addition to the in-memory seq counter - live data showed the same ticket producing two
   //--- decisionEventId values with an identical seq (e.g. "..._0" twice, ~16 seconds apart, each a
   //--- genuinely DIFFERENT real observation - votesBelow9 flipped between them, nothing was actually
   //--- duplicated or lost). Root cause not conclusively isolated (32 slots were available, no
   //--- reattach/exhaustion event logged in that window), but rather than leave a non-unique ID in a
   //--- file meant for downstream analysis, this makes decisionEventId collision-resistant
   //--- independent of the seq counter's own reliability - two writes now collide only if they share
   //--- BOTH the same second AND the same seq value, which the observed failure mode did not.
   string decisionEventId = StringFormat("%I64u_%s_%d", ticket, DashIsoTime(TimeCurrent()), decisionSeq);

   int barsSinceEntry    = g_retryForensic[slot].closedCandlesSinceEntry;
   int secondsSinceEntry = (int)(TimeCurrent()-g_retryForensic[slot].entryTime);

   string line = StringFormat(
      "{\"type\":\"retry_forensic_decision\",\"schemaVersion\":2,\"time\":\"%s\",\"symbol\":\"%s\","
      "\"ticket\":%I64u,\"observationEventId\":\"%s\",\"decisionEventId\":\"%s\",\"direction\":\"%s\",\"magic\":%d,"
      "\"barsSinceEntry\":%d,\"secondsSinceEntry\":%d,"
      "\"entryPrice\":%.3f,\"originalDNA\":%s,\"originalMindVotes\":%s,\"entryIdentityStatus\":\"%s\","
      "\"currentDNA\":\"%s\",\"currentDNAScore\":%.2f,"
      "\"currentCandleOpen\":%s,\"currentCandleHigh\":%s,\"currentCandleLow\":%s,\"currentCandleClose\":%s,\"candleDirection\":\"%s\","
      "\"buyVotes\":%d,\"sellVotes\":%d,\"waitVotes\":%d,\"winningVotes\":%d,\"mindsVoteDir\":\"%s\",\"sameDirectionPass\":%s,"
      "\"votesAtLeast9\":%s,\"votesAtLeast10\":%s,\"votesAtLeast11\":%s,\"votesAtLeast12\":%s,\"votesAtLeast13\":%s,"
      "\"profitUSD\":%.2f,\"originalSL\":null,\"currentSL\":%.3f,"
      "\"initialSLDistance\":null,\"currentSLDistance\":%.3f,"
      "\"distanceToOriginalSL\":null,\"distanceToCurrentSL\":%.3f,"
      "\"breakEvenActivated\":%s,\"trailingActivated\":%s,\"protectionActivated\":%s,"
      "\"twoOppositeCandlesConfirmed\":%s,\"oppositeCandleCount\":%d,\"mindFlipAgainst\":%s,"
      "\"votesBelow9\":%s,\"votesBelow8\":%s,\"votesBelow7\":%s,\"dnaChanged\":%s,"
      "\"priceAgainstTrade\":%.3f,\"adverseMoveFromEntry\":%.3f,\"distanceRemainingToOriginalSL\":null,"
      "\"retryVotePass9\":%s,\"retryVotePass10\":%s,\"retryVotePass11\":%s,\"retryVotePass12\":%s,\"retryVotePass13\":%s,"
      "\"retryDirectionPass\":%s,\"retryDNAWhitelistPass\":%s,"
      "\"retryWouldBeEligible9\":%s,\"retryWouldBeEligible10\":%s,\"retryWouldBeEligible11\":%s,\"retryWouldBeEligible12\":%s,\"retryWouldBeEligible13\":%s,"
      "\"outcome\":\"UNKNOWN\","
      "\"firstDangerType\":\"%s\",\"firstDangerAt\":%s,\"profitAtDanger\":%s,\"distanceToSLAtDanger\":%s,\"votesAtDanger\":%s,\"dnaAtDanger\":%s}",
      DashIsoTime(TimeCurrent()), g_symbol,
      ticket, g_retryForensic[slot].observationEventId, decisionEventId, DirName((ENUM_LITE_DIR)(direction>0?LDIR_BUY:LDIR_SELL)), (int)magic,
      barsSinceEntry, secondsSinceEntry,
      g_retryForensic[slot].entryPriceObs,
      haveOriginal ? ("\""+DnaName(origDna)+"\"") : "null",
      haveOriginal ? StringFormat("{\"buy\":%d,\"sell\":%d}", origBuyVotes, origSellVotes) : "null",
      entryIdentityStatus,
      DnaName(curDna), curScore,
      haveCurBar?DoubleToString(curBar[0].open,3):"null", haveCurBar?DoubleToString(curBar[0].high,3):"null",
      haveCurBar?DoubleToString(curBar[0].low,3):"null", haveCurBar?DoubleToString(curBar[0].close,3):"null",
      candleDirection,
      curBuy, curSell, curWait, curWinning, DirName(curMindDir), sameDirectionPass?"true":"false",
      votesAtLeast9?"true":"false", votesAtLeast10?"true":"false", votesAtLeast11?"true":"false", votesAtLeast12?"true":"false", votesAtLeast13?"true":"false",
      profitUSD, currentSL,
      currentSLDistance,
      distanceToCurrentSL,
      protectionActivated?"\"UNKNOWN\"":"false", protectionActivated?"\"UNKNOWN\"":"false", protectionActivated?"true":"false",
      twoOppositeCandlesConfirmed?"true":"false", oppositeCandleCount, mindFlipAgainst?"true":"false",
      votesBelow9?"true":"false", votesBelow8?"true":"false", votesBelow7?"true":"false", dnaChanged?"true":"false",
      priceAgainstTrade, adverseMoveFromEntry,
      retryVotePass9?"true":"false", retryVotePass10?"true":"false", retryVotePass11?"true":"false", retryVotePass12?"true":"false", retryVotePass13?"true":"false",
      retryDirectionPass?"true":"false", retryDNAWhitelistPass?"true":"false",
      retryWouldBeEligible9?"true":"false", retryWouldBeEligible10?"true":"false", retryWouldBeEligible11?"true":"false", retryWouldBeEligible12?"true":"false", retryWouldBeEligible13?"true":"false",
      firstDangerTypeOut,
      g_retryForensic[slot].haveFirstDanger?("\""+DashIsoTime(g_retryForensic[slot].firstDangerTime)+"\""):"null",
      g_retryForensic[slot].haveFirstDanger?DoubleToString(g_retryForensic[slot].firstDangerProfitUSD,2):"null",
      g_retryForensic[slot].haveFirstDanger?DoubleToString(g_retryForensic[slot].firstDangerSLDistance,3):"null",
      g_retryForensic[slot].haveFirstDanger?IntegerToString(g_retryForensic[slot].firstDangerVotes):"null",
      g_retryForensic[slot].haveFirstDanger?("\""+DnaName(g_retryForensic[slot].firstDangerDna)+"\""):"null");

   //--- Failure-tolerant, same as RecordRetryForensicTick() above: return value never checked to gate
   //--- anything, no exception path exists here regardless of outcome.
   DashAppendLine("retry_forensic_decisions.jsonl", line);
   g_retryDecisionPointsWritten++; // dashboard counter only - see declaration comment
  }

//====================================================================
// STEP 7 (explicit operator request, 2026-08-31): RETRY / PROTECTION MARKET-EVENT LIFECYCLE ANALYSIS.
//
// Purpose: Step 5/6 established that outcome-level analysis needs the ACTUAL sequence a ticket lived
// through (ENTRY -> HEALTHY -> deterioration -> danger -> protection/hard-SL), not just point-in-time
// snapshots. This writes a THIRD, additive log (retry_lifecycle_forensics.jsonl, schemaVersion 3)
// with two record kinds sharing one schema:
//   "TRANSITION" - written live, whenever this ticket's diagnostic lifecycle stage or danger level
//                  genuinely CHANGES (never every tick, never a duplicate for an unchanged state).
//   "EXIT"       - written ONCE per ticket, from CleanupTrailingSlots() at the exact moment a tracked
//                  ticket's position disappears, using the SAME real close-reason classification
//                  (ClassifyRetryExit()) RegisterRetryCandidate()/RecordRetryObservation() already use
//                  - never a second, independently-derived close reason.
//
// READ-ONLY / OBSERVATIONAL / ADDITIVE, identical non-interference guarantee to
// RecordRetryForensicTick()/RecordRetryDecisionPoint(): no OrderSend/PositionClose/SL-TP-modification
// call anywhere in either function's body or call tree, no second PositionsTotal() scan (TRANSITION
// reuses ManageOpenPositions()'s existing loop/slot; EXIT reuses CleanupTrailingSlots()'s existing
// loop/slot), writes only g_retryForensic[slot]'s own bookkeeping fields, returns void.
//====================================================================

//--- Section 5 - diagnostic danger-level classification. Explicitly documented bins (never presented
//--- as a validated trading threshold) built ONLY from fields RecordRetryForensicTick()/
//--- RecordRetryDecisionPoint() already computed this same tick - no new formula, no new data source.
//--- DANGER_LEVEL_0 healthy, 1 early, 2 meaningful, 3 severe, 4 near original-SL-equivalent (using
//--- CURRENT SL distance as the closest available proxy - originalSL is not persisted anywhere in
//--- this file, same documented gap Steps 3/5 already carry forward honestly).
int ClassifyRetryDangerLevel(const bool votesBelow9, const bool votesBelow8, const bool votesBelow7,
                              const bool twoOppositeCandlesConfirmed, const bool mindFlipAgainst,
                              const double currentSLDistance, const double adverseMoveFromEntry)
  {
   //--- Level 4: adverse excursion has eaten most of the remaining distance to the current SL - a
   //--- documented diagnostic bin (80% of currentSLDistance+adverseMoveFromEntry consumed), NOT a
   //--- trading trigger of any kind.
   double totalSpan = currentSLDistance + adverseMoveFromEntry;
   bool nearSL = (totalSpan>0.0) && (adverseMoveFromEntry/totalSpan >= 0.80);
   if(nearSL) return 4;
   if(votesBelow7) return 3;
   if(votesBelow8 || twoOppositeCandlesConfirmed) return 2;
   if(votesBelow9 || mindFlipAgainst) return 1;
   return 0;
  }

//--- Section 2 - diagnostic lifecycle stage classification. Priority-ordered by severity (most severe
//--- observed condition wins for "current stage") - built from the SAME fields as
//--- ClassifyRetryDangerLevel() above, no new data source. Protection/exit stages
//--- (BE_PROTECTION/TRAILING_PROTECTION) reuse g_trailing[slot].protectionActivated - the one real
//--- flag that exists (cannot distinguish BE from trailing, same documented gap as Steps 3/5 - reports
//--- "BE_PROTECTION" as the generic protected-stage label, matching ENUM_RETRY_EXIT_TYPE's own
//--- RETRY_EXIT_BREAK_EVEN/TRAILING convention where TRAILING is the one actually used today).
string ClassifyRetryLifecycleStage(const bool protectionActivated, const int dangerLevel,
                                    const bool dnaChanged, const bool votesBelow9)
  {
   if(protectionActivated) return "TRAILING_PROTECTION"; // the one real protection flag - see header
   if(dangerLevel>=2) return "DANGER";
   if(dangerLevel==1 && votesBelow9) return "VOTE_DETERIORATION";
   if(dnaChanged) return "DNA_CHANGE";
   return "HEALTHY";
  }

//--- The ONE additive call for the live TRANSITION half of this feature - called from
//--- ManageOpenPositions()'s existing loop, same slot RecordRetryForensicTick()/
//--- RecordRetryDecisionPoint() already resolved this same tick. Reads their already-published
//--- g_retryForensic[slot] fields - never recomputes danger-point/opposite-candle/vote state
//--- independently.
void RecordRetryLifecycleTransition(const ulong ticket, const int slot, const int direction,
                                     const double entryPrice, const double currentSL,
                                     const double profitUSD, const long magic)
  {
   if(!Inp_RetryLifecycleForensicEnabled) return;

   ENUM_LITE_DNA curDna     = g_dnaState;
   double        curScore   = g_dnaScore;
   int           curBuy     = g_buyVotes;
   int           curSell    = g_sellVotes;
   int           curWait    = g_waitVotes;
   ENUM_LITE_DIR curMindDir = g_mindsVoteDir;
   int           curWinning = (curMindDir==LDIR_BUY) ? curBuy : (curMindDir==LDIR_SELL) ? curSell : 0;
   int           tradeSideVotes = (direction>0) ? curBuy : curSell;
   int           mindDirAsInt   = (curMindDir==LDIR_BUY) ? 1 : (curMindDir==LDIR_SELL) ? -1 : 0;
   bool          sameDirectionPass = (mindDirAsInt==direction);

   bool votesBelow9 = (g_retryForensic[slot].dpVotesBelow9Time>0);
   bool votesBelow8 = (g_retryForensic[slot].dpVotesBelow8Time>0);
   bool votesBelow7 = (g_retryForensic[slot].dpVotesBelow7Time>0);
   bool twoOpposite = g_retryForensic[slot].twoOppositeCandlesConfirmed;
   int  oppositeCandleCount = g_retryForensic[slot].oppositeCandleCount;
   bool mindFlipAgainst = (g_retryForensic[slot].dpMindFlipAgainstTime>0);
   bool dnaChanged      = (g_retryForensic[slot].dpDnaChangedTime>0);
   bool protectionActivated = g_trailing[slot].protectionActivated;

   double curBid = SymbolInfoDouble(g_symbol, SYMBOL_BID);
   double curAsk = SymbolInfoDouble(g_symbol, SYMBOL_ASK);
   double curPrice = (curBid>0.0 && curAsk>0.0) ? (curBid+curAsk)/2.0 : 0.0;
   double adverseMoveFromEntry = MathMax(0.0, (direction>0) ? (entryPrice-curPrice) : (curPrice-entryPrice));
   double currentSLDistance = (currentSL>0.0) ? MathAbs(curPrice-currentSL) : 0.0;

   int dangerLevel = ClassifyRetryDangerLevel(votesBelow9, votesBelow8, votesBelow7, twoOpposite,
                                               mindFlipAgainst, currentSLDistance, adverseMoveFromEntry);
   string stage = ClassifyRetryLifecycleStage(protectionActivated, dangerLevel, dnaChanged, votesBelow9);

   //--- 2026-09-01, explicit operator request (STEP 9, Section 15 - EARLY CUT ANALYSIS): one-shot
   //--- capture of the FIRST tick dangerLevel reaches >=1 for this ticket - never overwritten once
   //--- set. This is the evidence RecordRetryLifecycleExit() needs to compute "time/distance from
   //--- earliest observable danger to HARD_SL" later, WITHOUT implementing any cut mechanism here -
   //--- purely a timestamp/price capture, changes nothing about how the trade is managed.
   if(!g_retryForensic[slot].haveEarliestDanger && dangerLevel>=1)
     {
      g_retryForensic[slot].haveEarliestDanger     = true;
      g_retryForensic[slot].earliestDangerTime      = TimeCurrent();
      g_retryForensic[slot].earliestDangerPrice     = curPrice;
      g_retryForensic[slot].earliestDangerSLDistance = currentSLDistance;
     }

   //--- Section 8/9 "state immediately before exit" - overwritten every call (not gated by the write
   //--- throttle below), so whatever this holds is always the FRESHEST observed state, ready for
   //--- CleanupTrailingSlots()'s own RecordRetryLifecycleExit() call whenever this ticket closes.
   g_retryForensic[slot].lastDna = curDna; g_retryForensic[slot].lastDnaScore = curScore;
   g_retryForensic[slot].lastBuyVotes = curBuy; g_retryForensic[slot].lastSellVotes = curSell;
   g_retryForensic[slot].lastWaitVotes = curWait; g_retryForensic[slot].lastWinningVotes = curWinning;
   g_retryForensic[slot].lastMindDir = curMindDir; g_retryForensic[slot].lastSameDirPass = sameDirectionPass;
   g_retryForensic[slot].lastTwoOpposite = twoOpposite; g_retryForensic[slot].lastOppositeCandleCount = oppositeCandleCount;
   g_retryForensic[slot].lastMindFlipAgainst = mindFlipAgainst; g_retryForensic[slot].lastDnaChanged = dnaChanged;
   g_retryForensic[slot].lastProfitUSD = profitUSD; g_retryForensic[slot].lastCurrentSL = currentSL;
   g_retryForensic[slot].lastSLDistance = currentSLDistance;
   g_retryForensic[slot].lastBarsSinceEntry = g_retryForensic[slot].closedCandlesSinceEntry;
   g_retryForensic[slot].lastSecondsSinceEntry = (int)(TimeCurrent()-g_retryForensic[slot].entryTime);

   //--- Section 18 - write ONLY on a genuine stage OR danger-level change (never every tick, never a
   //--- duplicate for an unchanged state). First-ever call for a ticket (stage=="ENTRY" freshly reset,
   //--- dangerLevel==0) always writes once, establishing the ENTRY baseline record.
   bool stageChanged  = (g_retryForensic[slot].lifecycleStage!=stage);
   bool levelChanged  = (g_retryForensic[slot].dangerLevel!=dangerLevel);
   bool isFirstRecord = (g_retryForensic[slot].lifecycleTransSeq==0 && !stageChanged && !levelChanged);
   if(!stageChanged && !levelChanged && !isFirstRecord) return;

   g_retryForensic[slot].lifecycleStage = stage;
   g_retryForensic[slot].dangerLevel    = dangerLevel;

   int seq = g_retryForensic[slot].lifecycleTransSeq;
   g_retryForensic[slot].lifecycleTransSeq = seq+1;
   string decisionEventId = StringFormat("%I64u_%s_%d", ticket, DashIsoTime(TimeCurrent()), seq);

   bool votesAtLeast9  = (tradeSideVotes>=9);
   bool votesAtLeast10 = (tradeSideVotes>=10);
   bool votesAtLeast11 = (tradeSideVotes>=11);
   bool votesAtLeast12 = (tradeSideVotes>=12);
   bool votesAtLeast13 = (tradeSideVotes>=13);

   ENUM_LITE_DNA origDna; double origDnaScore; ENUM_LITE_DIR origDirFile;
   int origBuyVotes, origSellVotes; double origExecPrice; string origTimestamp;
   bool haveOriginal = ReadEntryContextFromFile(ticket, origDna, origDnaScore, origDirFile,
                                                 origBuyVotes, origSellVotes, origExecPrice, origTimestamp);

   int barsSinceEntry    = g_retryForensic[slot].closedCandlesSinceEntry;
   int secondsSinceEntry = (int)(TimeCurrent()-g_retryForensic[slot].entryTime);

   string line = StringFormat(
      "{\"type\":\"retry_lifecycle_forensic\",\"schemaVersion\":3,\"recordKind\":\"TRANSITION\","
      "\"time\":\"%s\",\"symbol\":\"%s\",\"ticket\":%I64u,\"observationEventId\":\"%s\",\"decisionEventId\":\"%s\","
      "\"direction\":\"%s\",\"entryPrice\":%.3f,"
      "\"originalDNA\":%s,\"currentDNA\":\"%s\",\"currentDNAScore\":%.2f,"
      "\"buyVotes\":%d,\"sellVotes\":%d,\"waitVotes\":%d,\"winningVotes\":%d,\"mindsVoteDir\":\"%s\",\"sameDirectionPass\":%s,"
      "\"votesAtLeast9\":%s,\"votesAtLeast10\":%s,\"votesAtLeast11\":%s,\"votesAtLeast12\":%s,\"votesAtLeast13\":%s,"
      "\"twoOppositeCandlesConfirmed\":%s,\"oppositeCandleCount\":%d,\"mindFlipAgainst\":%s,\"dnaChanged\":%s,"
      "\"profitUSD\":%.2f,\"originalSL\":null,\"currentSL\":%.3f,"
      "\"distanceToOriginalSL\":null,\"distanceToCurrentSL\":%.3f,"
      "\"adverseMoveFromEntry\":%.3f,\"distanceRemainingToOriginalSL\":null,\"distanceRemainingToCurrentSL\":%.3f,"
      "\"adverseMovePctOfOriginalSL\":null,"
      "\"breakEvenActivated\":%s,\"trailingActivated\":%s,\"protectionActivated\":%s,"
      "\"lifecycleStage\":\"%s\",\"dangerLevel\":%d,"
      "\"barsSinceEntry\":%d,\"secondsSinceEntry\":%d}",
      DashIsoTime(TimeCurrent()), g_symbol, ticket, g_retryForensic[slot].observationEventId, decisionEventId,
      DirName((ENUM_LITE_DIR)(direction>0?LDIR_BUY:LDIR_SELL)), entryPrice,
      haveOriginal ? ("\""+DnaName(origDna)+"\"") : "null", DnaName(curDna), curScore,
      curBuy, curSell, curWait, curWinning, DirName(curMindDir), sameDirectionPass?"true":"false",
      votesAtLeast9?"true":"false", votesAtLeast10?"true":"false", votesAtLeast11?"true":"false", votesAtLeast12?"true":"false", votesAtLeast13?"true":"false",
      twoOpposite?"true":"false", oppositeCandleCount, mindFlipAgainst?"true":"false", dnaChanged?"true":"false",
      profitUSD, currentSL,
      currentSLDistance,
      adverseMoveFromEntry, currentSLDistance,
      protectionActivated?"\"UNKNOWN\"":"false", protectionActivated?"\"UNKNOWN\"":"false", protectionActivated?"true":"false",
      stage, dangerLevel,
      barsSinceEntry, secondsSinceEntry);

   DashAppendLine("retry_lifecycle_forensics.jsonl", line);
   g_retryLifecycleRecordsWritten++;
  }

//--- The ONE additive call for the close-time EXIT half of this feature - called from
//--- CleanupTrailingSlots()'s existing loop, BEFORE g_trailing[i]/g_retryForensic[i] are freed (same
//--- ordering guarantee RegisterRetryCandidate()/RecordRetryObservation() already rely on).
//--- 2026-09-03, consolidation (duplication/drift audit, finding M6): exitType/exitPrice/dir are now
//--- passed in by CleanupTrailingSlots(), which classifies once and shares the result across all four
//--- retry-close functions - see RegisterRetryCandidate()'s own header for the full rationale. This
//--- used to do a THIRD independent ClassifyRetryExit()/RetryDirectionFromHistory() read of the same
//--- closed ticket's deal history; wasProtected is no longer needed here (it only ever fed that now-
//--- removed internal call).
void RecordRetryLifecycleExit(const ulong ticket, const int slot, const ENUM_RETRY_EXIT_TYPE exitType, const double exitPrice, const int dir)
  {
   if(!Inp_RetryLifecycleForensicEnabled) return;

   //--- Section 7/8/9 - outcome classification, using the LAST observed pre-close state
   //--- RecordRetryLifecycleTransition() captured above (never re-derived independently).
   string outcomeStage;
   switch(exitType)
     {
      case RETRY_EXIT_TRAILING:   outcomeStage = "TRAILING_PROTECTION"; break;
      case RETRY_EXIT_BREAK_EVEN: outcomeStage = "BE_PROTECTION"; break;
      case RETRY_EXIT_HARD_SL:    outcomeStage = "HARD_SL"; break;
      case RETRY_EXIT_EARLY_EXIT: outcomeStage = "EARLY_EXIT"; break;
      case RETRY_EXIT_TP:         outcomeStage = "TP"; break;
      case RETRY_EXIT_MANUAL:     outcomeStage = "MANUAL"; break;
      default:                    outcomeStage = "UNKNOWN"; break;
     }

   //--- Section 9 - Hard-SL sequence classification. A diagnostic HYPOTHESIS based on the actually
   //--- observed sequence (per the explicit instruction: never label PULLBACK_THEN_FAILURE unless a
   //--- real favorable/reversal excursion was observed before the adverse move that followed it).
   //--- Uses g_trailing[slot]'s own EXISTING pbDetected/pbRecoveryValid fields (Phase 6's pullback
   //--- state machine, never a second detector) plus the last-observed danger level/timing.
   string hardSlClass = "UNKNOWN";
   if(exitType==RETRY_EXIT_HARD_SL)
     {
      bool everPulledBack = g_trailing[slot].pbDetected;
      bool recoveredAtLeastOnce = g_trailing[slot].pbRecoveryValid;
      if(everPulledBack && recoveredAtLeastOnce)
         hardSlClass = "PULLBACK_THEN_FAILURE"; // a real favorable excursion (recovery) DID occur before this failure
      else if(g_retryForensic[slot].dangerLevel>=3 && g_retryForensic[slot].lastSecondsSinceEntry<=120)
         hardSlClass = "FAST_ADVERSE_MOVE"; // reached severe danger within 2 minutes of entry, no recovery ever observed
      else if(g_retryForensic[slot].lastDnaChanged && g_retryForensic[slot].lastMindFlipAgainst)
         hardSlClass = "MIND_FAILURE"; // both DNA changed against AND Mind flipped against before this failure
      else if(g_retryForensic[slot].lastDnaChanged)
         hardSlClass = "DNA_FAILURE";
      else if(everPulledBack && !recoveredAtLeastOnce)
         hardSlClass = "GRADUAL_DETERIORATION"; // adverse excursion happened but never resumed favorably
      else
         hardSlClass = "PROTECTION_NEVER_ACTIVATED"; // no pullback ever detected, no protection ever reached - straight to SL
     }

   //--- Section 10 - retry-candidate diagnostic flags, ONLY meaningful for a protected exit (TRAILING/
   //--- BREAK_EVEN) - null/false for every other exit type, never fabricated. Uses the LAST observed
   //--- pre-close vote/DNA/direction state (RecordRetryLifecycleTransition()'s own snapshot above) -
   //--- the exact state at the moment protection was last confirmed active, never a stale earlier read.
   bool isProtectedExit = (exitType==RETRY_EXIT_TRAILING || exitType==RETRY_EXIT_BREAK_EVEN);
   int  lastTradeSideVotes = (dir>0) ? g_retryForensic[slot].lastBuyVotes : g_retryForensic[slot].lastSellVotes;
   bool lastMindDirAsIntMatch = (dir!=0) &&
      (((g_retryForensic[slot].lastMindDir==LDIR_BUY)?1:(g_retryForensic[slot].lastMindDir==LDIR_SELL)?-1:0)==dir);
   bool lastDnaWhitelistPass = IsRetryObservationDnaAllowed(g_retryForensic[slot].lastDna);
   bool diagRetry9  = isProtectedExit && lastMindDirAsIntMatch && lastDnaWhitelistPass && (lastTradeSideVotes>=9);
   bool diagRetry10 = isProtectedExit && lastMindDirAsIntMatch && lastDnaWhitelistPass && (lastTradeSideVotes>=10);
   bool diagRetry11 = isProtectedExit && lastMindDirAsIntMatch && lastDnaWhitelistPass && (lastTradeSideVotes>=11);
   bool diagRetry12 = isProtectedExit && lastMindDirAsIntMatch && lastDnaWhitelistPass && (lastTradeSideVotes>=12);
   bool diagRetry13 = isProtectedExit && lastMindDirAsIntMatch && lastDnaWhitelistPass && (lastTradeSideVotes>=13);

   ENUM_LITE_DNA origDna; double origDnaScore; ENUM_LITE_DIR origDirFile;
   int origBuyVotes, origSellVotes; double origExecPrice; string origTimestamp;
   bool haveOriginal = ReadEntryContextFromFile(ticket, origDna, origDnaScore, origDirFile,
                                                 origBuyVotes, origSellVotes, origExecPrice, origTimestamp);

   string line = StringFormat(
      "{\"type\":\"retry_lifecycle_forensic\",\"schemaVersion\":3,\"recordKind\":\"EXIT\","
      "\"time\":\"%s\",\"symbol\":\"%s\",\"ticket\":%I64u,\"observationEventId\":\"%s\","
      "\"direction\":\"%s\",\"originalDNA\":%s,"
      "\"lastDNA\":\"%s\",\"lastDNAScore\":%.2f,"
      "\"lastBuyVotes\":%d,\"lastSellVotes\":%d,\"lastWinningVotes\":%d,\"lastMindDir\":\"%s\",\"lastSameDirectionPass\":%s,"
      "\"lastTwoOppositeCandlesConfirmed\":%s,\"lastOppositeCandleCount\":%d,\"lastMindFlipAgainst\":%s,\"lastDnaChanged\":%s,"
      "\"lastProfitUSD\":%.2f,\"lastCurrentSL\":%.3f,\"lastSLDistance\":%.3f,"
      "\"lastBarsSinceEntry\":%d,\"lastSecondsSinceEntry\":%d,"
      "\"exitProtectionType\":\"%s\",\"exitPrice\":%.3f,\"exitReason\":\"%s\","
      "\"outcomeStage\":\"%s\",\"hardSlClassification\":\"%s\","
      "\"diagnosticRetry9\":%s,\"diagnosticRetry10\":%s,\"diagnosticRetry11\":%s,\"diagnosticRetry12\":%s,\"diagnosticRetry13\":%s}",
      DashIsoTime(TimeCurrent()), g_symbol, ticket, g_retryForensic[slot].observationEventId,
      DirName((ENUM_LITE_DIR)(dir>0?LDIR_BUY:dir<0?LDIR_SELL:LDIR_WAIT)),
      haveOriginal ? ("\""+DnaName(origDna)+"\"") : "null",
      DnaName(g_retryForensic[slot].lastDna), g_retryForensic[slot].lastDnaScore,
      g_retryForensic[slot].lastBuyVotes, g_retryForensic[slot].lastSellVotes, g_retryForensic[slot].lastWinningVotes,
      DirName(g_retryForensic[slot].lastMindDir), g_retryForensic[slot].lastSameDirPass?"true":"false",
      g_retryForensic[slot].lastTwoOpposite?"true":"false", g_retryForensic[slot].lastOppositeCandleCount,
      g_retryForensic[slot].lastMindFlipAgainst?"true":"false", g_retryForensic[slot].lastDnaChanged?"true":"false",
      g_retryForensic[slot].lastProfitUSD, g_retryForensic[slot].lastCurrentSL, g_retryForensic[slot].lastSLDistance,
      g_retryForensic[slot].lastBarsSinceEntry, g_retryForensic[slot].lastSecondsSinceEntry,
      RetryExitTypeName(exitType), exitPrice, RetryExitTypeName(exitType),
      outcomeStage, hardSlClass,
      diagRetry9?"true":"false", diagRetry10?"true":"false", diagRetry11?"true":"false", diagRetry12?"true":"false", diagRetry13?"true":"false");

   DashAppendLine("retry_lifecycle_forensics.jsonl", line);
   g_retryLifecycleRecordsWritten++;
  }

//====================================================================
// STEP 9 (explicit operator request, 2026-09-01): RETRY ENGINE FINAL DATA-ACCUMULATION & MIXED-
// OUTCOME VALIDATION.
//
// Purpose: closes the two remaining evidence gaps Steps 7/8 left open - (a) adverseMovePctOfOriginalSL
// could never be computed before this task (originalSL was never persisted anywhere - see
// RecordEntryDna()'s own header for the fix), and (b) "did the market keep moving the trade's
// direction after a protected exit" (Section 14) had no observation mechanism at all. Writes a FOURTH,
// additive log (retry_step9_event_validation.jsonl, schemaVersion 4). READ-ONLY / OBSERVATIONAL /
// ADDITIVE, identical non-interference guarantee to every prior Retry Forensic feature: no
// OrderSend/PositionClose/SL-TP-modification call anywhere in any function below, no second
// PositionsTotal() scan (reuses ManageOpenPositions()'s/CleanupTrailingSlots()'s existing loops),
// writes only g_retryForensic[]/g_retryPostExit[]'s own bookkeeping fields, returns void throughout.
//====================================================================

//--- Section 14 - arms a post-exit continuation observation for a JUST-CLOSED ticket. Called ONLY
//--- from RecordRetryStep9EventRecord() below, for EVERY exit (not just protected ones - Section 14
//--- doesn't restrict this to protected exits, and observing continuation after a HARD_SL exit is
//--- equally valid diagnostic evidence for Section 8's pullback-vs-failure question). Pool-exhausted
//--- case (all 32 slots busy) simply skips arming - never blocks, never queues, never affects anything
//--- else in this file.
void ArmPostExitContinuation(const ulong ticket, const string observationEventId, const int direction,
                              const double exitPrice)
  {
   if(!Inp_RetryStep9ForensicEnabled) return;
   for(int i=0; i<KMIE_STEP9_MAX_CONTINUATION_SLOTS; i++)
     {
      if(g_retryPostExit[i].active) continue;
      g_retryPostExit[i].active              = true;
      g_retryPostExit[i].ticket              = ticket;
      g_retryPostExit[i].observationEventId  = observationEventId;
      g_retryPostExit[i].direction           = direction;
      g_retryPostExit[i].exitPrice           = exitPrice;
      g_retryPostExit[i].exitTime            = TimeCurrent();
      g_retryPostExit[i].bestFavorablePrice  = exitPrice;
      g_retryPostExit[i].worstAdversePrice   = exitPrice;
      g_retryPostExit[i].written             = false;
      return;
     }
   // Pool exhausted - this exit simply isn't observed for continuation. No error, no side effect.
  }

//--- Section 14 - called ONCE per tick from ManageOpenPositions() (NOT per-position - this is a single
//--- fixed-size 32-slot scan, never a second PositionsTotal() loop). Updates the running
//--- best-favorable/worst-adverse price for every armed continuation slot, and finalizes+writes+frees
//--- any slot whose KMIE_STEP9_CONTINUATION_WINDOW_SECONDS window has elapsed. Reads ONLY
//--- SymbolInfoDouble (current bid/ask) - never PositionSelectByTicket, never any position/order
//--- function, since the position this is observing no longer exists.
void UpdatePostExitContinuations()
  {
   if(!Inp_RetryStep9ForensicEnabled) return;
   double curBid = SymbolInfoDouble(g_symbol, SYMBOL_BID);
   double curAsk = SymbolInfoDouble(g_symbol, SYMBOL_ASK);
   double curPrice = (curBid>0.0 && curAsk>0.0) ? (curBid+curAsk)/2.0 : 0.0;
   if(curPrice<=0.0) return;

   for(int i=0; i<KMIE_STEP9_MAX_CONTINUATION_SLOTS; i++)
     {
      if(!g_retryPostExit[i].active || g_retryPostExit[i].written) continue;

      int dir = g_retryPostExit[i].direction;
      bool moreFavorable = (dir>0) ? (curPrice>g_retryPostExit[i].bestFavorablePrice)
                                    : (curPrice<g_retryPostExit[i].bestFavorablePrice);
      bool moreAdverse   = (dir>0) ? (curPrice<g_retryPostExit[i].worstAdversePrice)
                                    : (curPrice>g_retryPostExit[i].worstAdversePrice);
      if(moreFavorable) g_retryPostExit[i].bestFavorablePrice = curPrice;
      if(moreAdverse)   g_retryPostExit[i].worstAdversePrice  = curPrice;

      int elapsed = (int)(TimeCurrent()-g_retryPostExit[i].exitTime);
      if(elapsed<KMIE_STEP9_CONTINUATION_WINDOW_SECONDS) continue;

      //--- Window elapsed - classify and write ONCE (Section 14's diagnostic outcomes), then free.
      double favMove = (dir>0) ? (g_retryPostExit[i].bestFavorablePrice-g_retryPostExit[i].exitPrice)
                                : (g_retryPostExit[i].exitPrice-g_retryPostExit[i].bestFavorablePrice);
      double advMove = (dir>0) ? (g_retryPostExit[i].exitPrice-g_retryPostExit[i].worstAdversePrice)
                                : (g_retryPostExit[i].worstAdversePrice-g_retryPostExit[i].exitPrice);
      //--- Diagnostic bins only (documented, not a trading threshold): favorable move must exceed
      //--- adverse move by a clear margin (2x) to call it CONTINUED_SAME_DIRECTION; the reverse for
      //--- REVERSED; otherwise SIDEWAYS. Section 13's own instruction: this is POST_EXIT_CONTINUATION,
      //--- never "RETRY_SUCCESS" - no actual Retry trade occurred here.
      string continuationOutcome;
      if(favMove>0.0 && favMove >= 2.0*MathMax(advMove,0.0001)) continuationOutcome = "CONTINUED_SAME_DIRECTION";
      else if(advMove>0.0 && advMove >= 2.0*MathMax(favMove,0.0001)) continuationOutcome = "REVERSED";
      else continuationOutcome = "SIDEWAYS";

      string line = StringFormat(
         "{\"type\":\"retry_step9_event\",\"schemaVersion\":4,\"recordKind\":\"POST_EXIT_CONTINUATION\","
         "\"time\":\"%s\",\"symbol\":\"%s\",\"ticket\":%I64u,\"observationEventId\":\"%s\","
         "\"exitPrice\":%.3f,\"windowSeconds\":%d,"
         "\"bestFavorablePrice\":%.3f,\"worstAdversePrice\":%.3f,"
         "\"favorableMove\":%.3f,\"adverseMove\":%.3f,"
         "\"postExitContinuationOutcome\":\"%s\"}",
         DashIsoTime(TimeCurrent()), g_symbol, g_retryPostExit[i].ticket, g_retryPostExit[i].observationEventId,
         g_retryPostExit[i].exitPrice, KMIE_STEP9_CONTINUATION_WINDOW_SECONDS,
         g_retryPostExit[i].bestFavorablePrice, g_retryPostExit[i].worstAdversePrice,
         favMove, advMove,
         continuationOutcome);
      DashAppendLine("retry_step9_event_validation.jsonl", line);
      g_retryStep9RecordsWritten++;

      g_retryPostExit[i].written = true;
      g_retryPostExit[i].active  = false;
     }
  }

//--- Section 7/15 - the main EXIT-time Step 9 writer. Called from CleanupTrailingSlots(), immediately
//--- after the existing RecordRetryLifecycleExit() call (same ordering guarantee - BEFORE
//--- g_retryForensic[i]/g_trailing[i] are freed, so every "last observed" field is still readable).
//--- Computes the ONE genuinely new value this task adds - adverseMovePctOfOriginalSL, using the
//--- SAME originalSL ReadOriginalSLFromFile() now recovers (null/not computed when unavailable, e.g.
//--- for tickets that closed before this task's RecordEntryDna() change was live - never guessed).
void RecordRetryStep9EventRecord(const ulong ticket, const int slot, const ENUM_RETRY_EXIT_TYPE exitType,
                                  const string outcomeStage, const int direction, const double exitPrice)
  {
   if(!Inp_RetryStep9ForensicEnabled) return;

   double originalSL = 0.0;
   bool haveOriginalSL = ReadOriginalSLFromFile(ticket, originalSL);

   //--- Section 4's own formula: adverseMove / |entryPrice - originalSL|. Uses the LAST observed
   //--- adverse-move-from-entry this ticket ever showed (lastSLDistance/lastCurrentSL don't directly
   //--- give adverse-from-entry, so this is recomputed from lastCurrentSL/lastProfitUSD's own entry
   //--- reference point - entryPriceObs, the SAME field RecordRetryForensicTick() already captured at
   //--- first observation, never a new entry-price source).
   double entryPriceObs = g_retryForensic[slot].entryPriceObs;
   double adverseMovePct = 0.0;
   bool haveAdverseMovePct = false;
   if(haveOriginalSL && originalSL>0.0)
     {
      double slDist = MathAbs(entryPriceObs-originalSL);
      if(slDist>0.0)
        {
         //--- worst adverse excursion observed = lastSLDistance's own complement is not reliable (SL
         //--- may have moved via trailing) - instead use the EXIT price itself as the worst-known
         //--- point for a HARD_SL exit (the exit price IS the adverse extreme by definition), or
         //--- lastProfitUSD's sign for a protected exit (adverse move was whatever preceded recovery,
         //--- not directly reconstructable from stored fields - reported as "not applicable", not
         //--- guessed, for non-HARD_SL exits).
         if(exitType==RETRY_EXIT_HARD_SL)
           {
            double adverseMove = (direction>0) ? (entryPriceObs-exitPrice) : (exitPrice-entryPriceObs);
            adverseMovePct = MathMax(0.0, adverseMove) / slDist;
            haveAdverseMovePct = true;
           }
        }
     }

   //--- Section 15 - early-cut timing/distance, from the one-shot earliestDanger* fields
   //--- RecordRetryLifecycleTransition() captured above (never re-derived here).
   bool haveEarliestDanger = g_retryForensic[slot].haveEarliestDanger;
   int  secondsFromDangerToExit = haveEarliestDanger ? (int)(TimeCurrent()-g_retryForensic[slot].earliestDangerTime) : 0;
   double priceDistFromDangerToExit = 0.0;
   if(haveEarliestDanger)
      priceDistFromDangerToExit = MathAbs(exitPrice-g_retryForensic[slot].earliestDangerPrice);

   string line = StringFormat(
      "{\"type\":\"retry_step9_event\",\"schemaVersion\":4,\"recordKind\":\"EXIT_ENRICHMENT\","
      "\"time\":\"%s\",\"symbol\":\"%s\",\"ticket\":%I64u,\"observationEventId\":\"%s\","
      "\"outcomeStage\":\"%s\","
      "\"originalSL\":%s,\"adverseMovePctOfOriginalSL\":%s,"
      "\"haveEarliestDanger\":%s,\"earliestDangerAt\":%s,\"earliestDangerPrice\":%s,\"earliestDangerSLDistance\":%s,"
      "\"secondsFromEarliestDangerToExit\":%s,\"priceDistanceFromEarliestDangerToExit\":%s}",
      DashIsoTime(TimeCurrent()), g_symbol, ticket, g_retryForensic[slot].observationEventId,
      outcomeStage,
      haveOriginalSL?DoubleToString(originalSL,3):"null",
      haveAdverseMovePct?DoubleToString(adverseMovePct,4):"null",
      haveEarliestDanger?"true":"false",
      haveEarliestDanger?("\""+DashIsoTime(g_retryForensic[slot].earliestDangerTime)+"\""):"null",
      haveEarliestDanger?DoubleToString(g_retryForensic[slot].earliestDangerPrice,3):"null",
      haveEarliestDanger?DoubleToString(g_retryForensic[slot].earliestDangerSLDistance,3):"null",
      haveEarliestDanger?IntegerToString(secondsFromDangerToExit):"null",
      haveEarliestDanger?DoubleToString(priceDistFromDangerToExit,3):"null");

   DashAppendLine("retry_step9_event_validation.jsonl", line);
   g_retryStep9RecordsWritten++;

   //--- Section 14 - arm post-exit continuation observation for EVERY exit (see
   //--- ArmPostExitContinuation()'s own header for why this isn't restricted to protected exits).
   ArmPostExitContinuation(ticket, g_retryForensic[slot].observationEventId, direction, exitPrice);
  }

//====================================================================
// 2026-09-12, explicit operator request (TRADE MANAGEMENT ENGINE ARCHITECTURAL REPLACEMENT). Replaces
// the five disconnected legacy mechanisms above (EvaluateEarlyExit/EvaluateEarlySlWatcher/
// EvaluateEarlyTpWatcher/EvaluateEma35TrackingSl/ApplyProfitTierTrailingSl+SelectProfitTier) with a
// single coordinated system: a read-only Signal Layer (momentum/volume/EMA-alignment/structure/
// exhaustion/support-resistance), a State Classifier that buckets those signals into
// EXPANSION/DECELERATION/EXHAUSTION, an Adaptive SL Engine (never widens, trails tighter/looser per
// state), a Progressive TP Engine (ratchet-only extension, never capped, never reversed), and a single
// broker-integration helper (ApplyManagementSlTp()) that always sends BOTH SL and TP together so
// neither is ever silently dropped/reset to 0.0 by a modification that only intended to touch the
// other. NEVER closes a position directly - only ever modifies SL/TP, or no-ops.
//====================================================================

//--------------------------------------------------------------------
// STEP 3 - SIGNAL LAYER. All read-only against existing globals/CopyRates - zero OrderSend, zero
// mutation of any existing global. Every function here either reuses an existing calculation
// (ComputeVolumeDna()/ClassifyVolumePipRegime(), EvaluateStrongUptrendShadow()/
// EvaluateStrongDowntrendShadow(), g_activePing.ema20/ema35/ema50, g_ci.exhaustion/rejection,
// ComputePriceRangeDnaLive()) or is a small, new, self-contained helper (momentum, EMA-alignment,
// support/resistance acceptance-rejection-failed-breakout, local ATR).
//--------------------------------------------------------------------

//--- Local 14-bar mean-True-Range, THIS engine's own independent computation - follows this file's own
//--- established "every function computes ATR independently, no shared helper" convention (same
//--- pattern as EvaluateEmaTrendMind()/EvaluateActivePing()/ComputeVolumeDna(), each of which computes
//--- its own ATR rather than calling a shared engine - confirmed convention this session, not a gap).
//--- Uses the SAME classic True-Range formula (max of high-low, |high-prevClose|, |low-prevClose|)
//--- every one of those functions already uses. rates[] must be shift=1-start (closed bars only),
//--- newest-first (ArraySetAsSeries), with at least period+1 bars.
double TmeLocalAtr(const MqlRates &rates[], const int n, const int period)
  {
   double atr = 0.0; int samples = 0;
   for(int i=0; i<period && (i+1)<n; i++)
     {
      double highLow  = rates[i].high - rates[i].low;
      double highPrev = MathAbs(rates[i].high - rates[i+1].close);
      double lowPrev  = MathAbs(rates[i].low  - rates[i+1].close);
      double tr = MathMax(highLow, MathMax(highPrev, lowPrev));
      atr += tr; samples++;
     }
   if(samples<=0) return 0.0;
   return atr/samples;
  }

//--- Momentum: combines directional displacement, velocity, acceleration, candle body strength, and
//--- close-location into ONE normalized signed score, roughly -100..+100 (positive = favors `direction`).
//--- WEIGHTS/NORMALIZATION (documented, not arbitrary):
//---   displacement (30%): net price change over `lookback` closed bars, normalized by local ATR (so
//---     it is comparable across volatility regimes), clamped to +/-3 ATR before scaling to +/-100 -
//---     3 ATR chosen as a generous "strong impulse" ceiling consistent with this file's own
//---     Inp_EMAExtensionMaxATR=2.0-class thresholds elsewhere (slightly wider since this measures a
//---     multi-bar move, not a single EMA-distance snapshot).
//---   velocity (25%): the SAME displacement but measured over the most recent HALF of the lookback
//---     window only - i.e. is the move still accelerating in recent bars, or was it front-loaded -
//---     normalized/clamped the same way as displacement.
//---   acceleration (20%): second difference - (velocity over the most recent half) minus (velocity
//---     over the OLDER half of the lookback window) - captures whether the move is SPEEDING UP or
//---     SLOWING DOWN, which is exactly the EXPANSION-vs-DECELERATION distinction this engine needs.
//---     Normalized by ATR and clamped to +/-2 ATR (a second-difference is naturally smaller-magnitude
//---     than a first difference, hence the tighter clamp).
//---   body strength (15%): latest closed bar's own body/range ratio (0..1), signed by whether that
//---     bar closed up or down - a strong same-direction body supports the move; a strong opposite-
//---     direction body argues against it.
//---   close-location (10%): where the latest closed bar's close sits within its OWN range (0=low,
//---     1=high), re-centered to -1..+1 and signed toward `direction` - confirms whether the bar closed
//---     near its favorable or adverse extreme.
//--- Weights sum to 100% and are ordered by the plan's own explicit priority (momentum components
//--- first/heaviest, confirmation-style factors last/lightest). All five sub-scores are computed
//--- direction-agnostic then multiplied by `direction` so the FINAL score is signed toward the
//--- ticket's own trade direction (positive = favorable), which is what ManagementStateEvaluator() needs.
double EvaluateManagementMomentum(const int direction, const int lookback=10)
  {
   if(direction==0) return 0.0;
   int need = lookback + 5;
   MqlRates r[]; ArraySetAsSeries(r, true);
   int n = CopyRates(g_symbol, PERIOD_M1, 1, need, r); // closed bars only, shift=1 start
   if(n < need) return 0.0; // insufficient history - neutral, never fabricated

   double atr = TmeLocalAtr(r, n, 14);
   if(!(MathIsValidNumber(atr) && atr>0.0)) return 0.0;

   int half = MathMax(1, lookback/2);

   //--- Displacement: close[0] (latest closed) vs close[lookback] (oldest in window).
   double displacement = r[0].close - r[lookback].close;
   double dispNorm = Clamp0to100(50.0 + 50.0*MathMax(-1.0,MathMin(1.0, displacement/(atr*3.0)))*direction) - 50.0; // -50..+50 raw, direction-signed
   // Re-express as -100..+100 for this sub-score's own scale before weighting.
   double dispScore = dispNorm*2.0;

   //--- Velocity: displacement over the most recent half-window only (close[0] vs close[half]).
   double velocity = r[0].close - r[half].close;
   double velScore = Clamp0to100(50.0 + 50.0*MathMax(-1.0,MathMin(1.0, velocity/(atr*3.0)))*direction) - 50.0;
   velScore *= 2.0;

   //--- Acceleration: recent-half velocity vs older-half velocity (second difference), normalized by a
   //--- tighter +/-2 ATR clamp (second differences are naturally smaller in magnitude).
   double olderVelocity = r[half].close - r[lookback].close;
   double accel = velocity - olderVelocity;
   double accelScore = Clamp0to100(50.0 + 50.0*MathMax(-1.0,MathMin(1.0, accel/(atr*2.0)))*direction) - 50.0;
   accelScore *= 2.0;

   //--- Body strength: latest closed bar's body/range, signed toward direction.
   double range0 = r[0].high - r[0].low;
   double body0  = r[0].close - r[0].open; // signed (up positive, down negative)
   double bodyRatioSigned = (range0>0.0) ? (body0/range0) : 0.0; // -1..+1
   double bodyScore = bodyRatioSigned*direction*100.0; // -100..+100

   //--- Close-location: where close sits within its own bar's range, re-centered to -1..+1, signed.
   double closeLoc = (range0>0.0) ? ((r[0].close - r[0].low)/range0) : 0.5; // 0..1
   double closeLocSigned = (closeLoc-0.5)*2.0; // -1..+1
   double closeLocScore = closeLocSigned*direction*100.0;

   double total = dispScore*0.30 + velScore*0.25 + accelScore*0.20 + bodyScore*0.15 + closeLocScore*0.10;
   return MathMax(-100.0, MathMin(100.0, total));
  }

//--- Volume expansion classifier: wraps the EXISTING ComputeVolumeDna()/ClassifyVolumePipRegime() (via
//--- ComputePriceRangeDnaLive() for the relativeRange half of the pair, exactly as STRONG_TREND's own
//--- wiring does - see that state's own "VOLUME x PIP RELATIONSHIP" block for the pattern being
//--- mirrored) - zero new volume/ATR formula. Re-buckets the existing 4-regime classification
//--- (EFFICIENT_EXPANSION/EFFORT_WITHOUT_RESULT/THIN_MOVEMENT/COMPRESSION/UNKNOWN) into the 3-state
//--- read this engine needs.
enum ENUM_TME_VOLUME_STATE { TME_VOL_EXPANSION_CONFIRMED, TME_VOL_EFFORT_WITHOUT_RESULT, TME_VOL_CONTRACTION };
ENUM_TME_VOLUME_STATE EvaluateManagementVolumeExpansion()
  {
   VolumeDnaResult vr = ComputeVolumeDna(PERIOD_M1, KMIE_VOLUME_DNA_BASELINE_BARS);
   bool haveRvol = vr.valid && (vr.volumeClass!="UNKNOWN");
   double rvol = haveRvol ? vr.relativeVolume : 0.0;

   PriceRangeDnaResult prd = ComputePriceRangeDnaLive();
   bool haveRelRange = prd.valid && (prd.rangeClass!="UNKNOWN");
   double relRange = haveRelRange ? prd.relativeRange : 0.0;

   string regime = ClassifyVolumePipRegime(haveRelRange, relRange, haveRvol, rvol);
   //--- EFFICIENT_EXPANSION (both volume and pip-range elevated together) = genuine confirmed
   //--- expansion. THIN_MOVEMENT (pips without volume) is treated as EFFORT_WITHOUT_RESULT's mirror -
   //--- price moved but participation didn't confirm it - also not a confident expansion signal.
   //--- COMPRESSION/UNKNOWN = contraction (quiet market or no data - never fabricated as expansion).
   if(regime=="EFFICIENT_EXPANSION") return TME_VOL_EXPANSION_CONFIRMED;
   if(regime=="EFFORT_WITHOUT_RESULT" || regime=="THIN_MOVEMENT") return TME_VOL_EFFORT_WITHOUT_RESULT;
   return TME_VOL_CONTRACTION; // COMPRESSION or UNKNOWN
  }

//--- EMA20/35/50 alignment: simple three-way ordering check over the ALREADY-PUBLISHED g_activePing
//--- values (g_activePing.ema20/ema35/ema50, computed by EvaluateActivePing() - read-only here, that
//--- function is NOT modified/re-invoked). Inp_EMAFastPeriod=20 (fast)/Inp_EMASlowPeriod=50 (slow) are
//--- the EMA20/EMA50 pair EvaluateEmaTrendMind() already uses; EMA35 sits at the SAME period
//--- EvaluateEma35TrackingSl()/EvaluateActivePing()'s own EMA35 axis already uses. For a healthy BUY
//--- trend the fast EMA should sit above the mid EMA which sits above the slow EMA (ema20>ema35>ema50);
//--- mirrored for SELL (ema20<ema35<ema50). Returns true only when the FULL three-way ordering holds -
//--- a partial/mixed ordering (e.g. ema20>ema35 but ema35<ema50) does not count as aligned.
bool EvaluateEma20_35_50Alignment(const int direction)
  {
   if(direction==0) return false;
   double e20=g_activePing.ema20, e35=g_activePing.ema35, e50=g_activePing.ema50;
   if(!(MathIsValidNumber(e20) && MathIsValidNumber(e35) && MathIsValidNumber(e50))) return false;
   if(e20==0.0 && e35==0.0 && e50==0.0) return false; // ActivePingState defaults (insufficient history this bar) - never treat as aligned
   if(direction>0) return (e20>e35 && e35>e50);
   return (e20<e35 && e35<e50);
  }

//--- Support/Resistance acceptance-rejection-failed-breakout. Reuses the SAME fh=2 classic 5-bar
//--- fractal swing-detection TECHNIQUE the SR Mind (g_minds[13], EvaluateMinds()) already uses (see
//--- that Mind's own block, ~line 6140-6180) - a fresh, self-contained helper, NOT a call into the
//--- Mind itself (its own live vote/array slot is never touched). Finds the nearest swing-low BELOW
//--- current close (support) and nearest swing-high ABOVE it (resistance) over a `windowBars`-bar
//--- closed-M1 window, then classifies recent price action against whichever level is relevant to
//--- `direction`.
struct TmeSrLevels { bool haveSupport; double support; bool haveResistance; double resistance; int barsAvail; };
TmeSrLevels TmeFindNearestSrLevels(const int windowBars=100)
  {
   TmeSrLevels lv; lv.haveSupport=false; lv.support=0.0; lv.haveResistance=false; lv.resistance=0.0; lv.barsAvail=0;
   MqlRates r[]; ArraySetAsSeries(r, true);
   int n = CopyRates(g_symbol, PERIOD_M1, 1, windowBars, r); // closed bars only, shift=1 start
   lv.barsAvail = n;
   if(n<10) return lv; // same minimum SR Mind itself requires (n60sr>=10)

   double curClose = r[0].close;
   int fh=2; // SAME fractal half-width as the SR Mind (classic 5-bar fractal)
   for(int i=fh; i<n-fh; i++)
     {
      bool isSwingHigh=true, isSwingLow=true;
      for(int w=1; w<=fh; w++)
        {
         if(r[i].high<=r[i-w].high || r[i].high<=r[i+w].high) isSwingHigh=false;
         if(r[i].low>=r[i-w].low   || r[i].low>=r[i+w].low)   isSwingLow=false;
        }
      if(isSwingHigh && r[i].high>curClose && (!lv.haveResistance || r[i].high<lv.resistance))
        { lv.haveResistance=true; lv.resistance=r[i].high; }
      if(isSwingLow && r[i].low<curClose && (!lv.haveSupport || r[i].low>lv.support))
        { lv.haveSupport=true; lv.support=r[i].low; }
     }
   return lv;
  }

//--- Support Acceptance: price has tested (closed at/below, for BUY) a swing-low support level at
//--- least once within the last `checkBars` CLOSED bars, WITHOUT ever closing decisively through it
//--- (more than a small buffer below), and the MOST RECENT closed bar has closed back above it - i.e.
//--- the level held and price accepted it as a floor. Mirrored logic for SELL against resistance
//--- (renamed accordingly by the two wrapper functions below).
bool EvaluateSupportAcceptance(const int direction, const int checkBars=5)
  {
   if(direction==0) return false;
   TmeSrLevels lv = TmeFindNearestSrLevels();
   if(direction>0 && !lv.haveSupport) return false;
   if(direction<0 && !lv.haveResistance) return false;

   MqlRates r[]; ArraySetAsSeries(r, true);
   int n = CopyRates(g_symbol, PERIOD_M1, 1, checkBars, r);
   if(n<checkBars) return false;

   double level = (direction>0) ? lv.support : lv.resistance;
   bool tested=false, decisiveBreak=false, mostRecentAccepted=false;
   for(int i=0;i<n;i++)
     {
      bool touchedOrTested = (direction>0) ? (r[i].low<=level) : (r[i].high>=level);
      bool closedThrough    = (direction>0) ? (r[i].close<level) : (r[i].close>level);
      if(touchedOrTested) tested=true;
      if(closedThrough)   decisiveBreak=true;
     }
   mostRecentAccepted = (direction>0) ? (r[0].close>=level) : (r[0].close<=level);
   return tested && !decisiveBreak && mostRecentAccepted;
  }

//--- Resistance Rejection: mirrored concept - price has tested resistance (for BUY, checking the
//--- opposing/upper level is being rejected FROM, i.e. this is the bearish-signal counterpart) and
//--- closed back below it. Implemented as its own explicit function per the plan's spec (Support
//--- Acceptance / Resistance Rejection / Failed Breakout each named separately) even though it shares
//--- TmeFindNearestSrLevels() - always evaluated against the level on the OPPOSITE side of price from
//--- `direction`'s own support, i.e. checks whether the trade's own advance is being rejected by the
//--- resistance ahead of it (for BUY) or support ahead of it (for SELL, acting as resistance-to-decline).
bool EvaluateResistanceRejection(const int direction, const int checkBars=5)
  {
   if(direction==0) return false;
   TmeSrLevels lv = TmeFindNearestSrLevels();
   //--- For a BUY, the relevant "ahead" level is resistance; for a SELL, the relevant "ahead" level is
   //--- support (a floor that could reject further decline) - i.e. this checks the level positioned
   //--- AGAINST further favorable movement in `direction`.
   bool haveLevel = (direction>0) ? lv.haveResistance : lv.haveSupport;
   if(!haveLevel) return false;
   double level = (direction>0) ? lv.resistance : lv.support;

   MqlRates r[]; ArraySetAsSeries(r, true);
   int n = CopyRates(g_symbol, PERIOD_M1, 1, checkBars, r);
   if(n<checkBars) return false;

   bool tested=false, closedBack=false;
   for(int i=0;i<n;i++)
     {
      bool touched = (direction>0) ? (r[i].high>=level) : (r[i].low<=level);
      if(touched) tested=true;
     }
   closedBack = (direction>0) ? (r[0].close<level) : (r[0].close>level);
   return tested && closedBack;
  }

//--- Failed Breakout: a swing level was decisively closed-through (in `direction`'s favor, i.e. what
//--- looked like a genuine breakout), then price closed back on the ORIGINAL side within
//--- `withinBars` subsequent closed bars - a breakout that failed to hold, an adverse signal for
//--- continuing to hold/extend the trade even though the initial break looked favorable.
bool EvaluateFailedBreakout(const int direction, const int lookbackBars=8, const int withinBars=3)
  {
   if(direction==0) return false;
   TmeSrLevels lv = TmeFindNearestSrLevels();
   bool haveLevel = (direction>0) ? lv.haveResistance : lv.haveSupport;
   if(!haveLevel) return false;
   double level = (direction>0) ? lv.resistance : lv.support;

   MqlRates r[]; ArraySetAsSeries(r, true);
   int n = CopyRates(g_symbol, PERIOD_M1, 1, lookbackBars, r);
   if(n<lookbackBars) return false;

   //--- Find the most recent bar (scanning from oldest to newest, i.e. high index to low index) that
   //--- closed decisively through the level in direction's favor - that is the "breakout" candidate.
   int breakoutIdx = -1;
   for(int i=n-1;i>=0;i--)
     {
      bool brokeThrough = (direction>0) ? (r[i].close>level) : (r[i].close<level);
      if(brokeThrough) { breakoutIdx = i; break; }
     }
   if(breakoutIdx<0) return false;

   //--- Now check the bars AFTER that breakout (lower index = more recent) for a close back on the
   //--- ORIGINAL side, within withinBars of the breakout itself.
   int barsChecked=0;
   for(int i=breakoutIdx-1;i>=0 && barsChecked<withinBars;i--,barsChecked++)
     {
      bool closedBackOriginalSide = (direction>0) ? (r[i].close<level) : (r[i].close>level);
      if(closedBackOriginalSide) return true;
     }
   return false;
  }

//--------------------------------------------------------------------
// STEP 4 - MANAGEMENT SCORE + STATE CLASSIFIER
//--------------------------------------------------------------------

//--- Combines Step 3's signals into ONE bounded (-100..+100), direction-aware score. WEIGHTS
//--- (documented, not arbitrary): momentum and structure (EvaluateStrongUptrendShadow/
//--- EvaluateStrongDowntrendShadow's own rawScore, 0..100 rescaled to -100..+100 signed toward
//--- direction) are the PRIMARY drivers per the plan's explicit guidance ("momentum and structure as
//--- primary drivers"). Volume (15%) is a CONFIRMING factor - a real move should have participation
//--- behind it, but that alone is not sufficient. Exhaustion/rejection/failed-breakout are NEGATIVE
//--- factors (a flat 10-point penalty each, capped at -30 total) - each is a binary/near-binary warning
//--- sign rather than a graduated measurement, so a flat penalty (rather than a weighted blend) keeps
//--- their effect proportionate and prevents any single warning from overwhelming the primary
//--- momentum/structure read. Support acceptance is a small POSITIVE confirming nudge (+5) when present,
//--- symmetric with the negative treatment of its rejection/failed-breakout counterparts.
//---
//--- 2026-09-14, explicit operator request ("EMA 20 and EMA 50 should be inactive"): the EMA20/35/50
//--- alignment term (emaScore, previously 15% weight) is REMOVED from this formula entirely - EMA20/50
//--- no longer participate in management-state scoring in any way. Its 15% weight is redistributed to
//--- the two PRIMARY drivers (momentum/structure), each going from 30% to 37.5%, so the four weights
//--- (momentum, structure, volume, and the now-removed EMA term) still sum to the same total (90%) the
//--- formula always used - this is a pure reallocation, not a change to the overall score's scale/range,
//--- and volume's own 15% weight is unchanged. EvaluateEma20_35_50Alignment() itself is left in the file
//--- (not deleted, per the same "disconnect the call, keep the function" convention already used for the
//--- five legacy TP/SL managers) but is no longer called from TradeManagementEngine() - see that
//--- function's own updated body.
double ManagementStateEvaluator(const int direction, const double momentum, const ENUM_TME_VOLUME_STATE volState,
                                 const double structuralScore0to100,
                                 const double exhaustionRaw0to100, const bool supportAcceptance,
                                 const bool resistanceRejection, const bool failedBreakout)
  {
   if(direction==0) return 0.0;

   double structuralSigned = (structuralScore0to100-50.0)*2.0; // rescale 0..100 (already direction-confirming per EvaluateStrongXShadow's own design) to -100..+100

   double volScore = (volState==TME_VOL_EXPANSION_CONFIRMED) ? 20.0 :
                      (volState==TME_VOL_EFFORT_WITHOUT_RESULT) ? -10.0 : -20.0; // contraction is mildly negative (a quiet market does not support continued expansion), scaled into the 15% weight below via its own -20..+20 native range

   double score = momentum*0.375 + structuralSigned*0.375 + volScore*0.15; // EMA term removed 2026-09-14; its 15% redistributed evenly to momentum/structure (30%->37.5% each)

   //--- Exhaustion (g_ci.exhaustion, 0..100 - heavy wick/shrinking body) is a graduated negative
   //--- factor, not flat - scaled to a max 20-point penalty at exhaustionRaw=100.
   score -= (exhaustionRaw0to100/100.0)*20.0;

   //--- Flat penalties/bonus for the near-binary structural warnings/confirmation.
   if(resistanceRejection) score -= 10.0;
   if(failedBreakout)      score -= 10.0;
   if(supportAcceptance)   score += 5.0;

   return MathMax(-100.0, MathMin(100.0, score));
  }

//--- 2026-09-16, explicit operator request ("SL trailing and TP trailing not working up correctly") -
//--- REPLACES the original hardcoded +20/-20 thresholds (live-verified unreachable on real data - see
//--- Inp_TmeExpansionThreshold's own header for the full diagnosis) with the tunable
//--- Inp_TmeExpansionThreshold/Inp_TmeExhaustionThreshold inputs (defaults 8.0/-25.0, recalibrated
//--- against real live score samples). The bucket LOGIC itself is unchanged - strictly above the
//--- expansion threshold is EXPANSION (widen trailing room, allow TP extension), strictly below the
//--- exhaustion threshold is EXHAUSTION (tighten aggressively, freeze TP), everything between is
//--- DECELERATION (tighten moderately, freeze TP) - only the two boundary VALUES changed, now as inputs.
//--- 2026-09-18: kept EXACTLY as-is (fixed-threshold classifier) - still used directly whenever
//--- Inp_TmeAdaptiveThresholdsEnabled=false, and as the fallback pair the adaptive path itself computes
//--- against when the rolling window is short (see ClassifyManagementStateAdaptive() below, the new
//--- call site in TradeManagementEngine() - this function's own body/signature is untouched).
ENUM_TME_STATE ClassifyManagementState(const double score)
  {
   if(score>Inp_TmeExpansionThreshold)  return TME_STATE_EXPANSION;
   if(score<Inp_TmeExhaustionThreshold) return TME_STATE_EXHAUSTION;
   return TME_STATE_DECELERATION;
  }

//--- 2026-09-18, explicit operator request ("do the deep search with algo and minds votes are working
//--- perfectly") - records ONE score sample per NEW CLOSED M1 bar into the rolling circular buffer (see
//--- g_tmeScoreHistory[]'s own header for the full rationale/root-cause). Called from
//--- TradeManagementEngine() right after ManagementStateEvaluator() computes the score, BEFORE
//--- classification - so the very score being classified this bar is also the one sampled into history
//--- for FUTURE bars' percentile computation (never used to classify itself - see
//--- ComputeAdaptiveTmeThresholds()'s own note on this). New-bar latch mirrors g_dashLastBarTime's
//--- existing "if(rates[0].time!=g_lastBarTimeVar)" convention exactly.
void RecordTmeScoreSample(const double score)
  {
   MqlRates r[]; ArraySetAsSeries(r, true);
   if(CopyRates(g_symbol, PERIOD_M1, 0, 1, r)<=0) return; // no current bar available - skip silently, same as other new-bar-latch call sites in this file
   if(r[0].time==g_tmeLastScoreSampleBarTime) return; // already sampled this bar
   g_tmeLastScoreSampleBarTime = r[0].time;

   int cap = ArraySize(g_tmeScoreHistory);
   if(cap<=0) return; // OnInit() has not sized the buffer yet - defensive only, should not happen live
   g_tmeScoreHistory[g_tmeScoreHistoryNext] = score;
   g_tmeScoreHistoryNext = (g_tmeScoreHistoryNext+1) % cap;
   if(g_tmeScoreHistoryCount<cap) g_tmeScoreHistoryCount++;
  }

//--- 2026-09-18, explicit operator request - computes EXPANSION/EXHAUSTION cutoffs from the REAL rolling
//--- distribution of recent scores (Inp_TmeExpansionPercentile/Inp_TmeExhaustionPercentile, e.g. 80th/
//--- 20th) instead of the fixed Inp_TmeExpansionThreshold/Inp_TmeExhaustionThreshold alone - this is what
//--- makes the classification track day-to-day drift in the score distribution automatically (see
//--- Inp_TmeAdaptiveThresholdsEnabled's own header for the measured drift evidence). Falls back to the
//--- fixed thresholds verbatim when the rolling window has fewer than Inp_TmeAdaptiveMinSamples samples
//--- (e.g. right after EA attach) - never computes a percentile off too little data. Pure function - takes
//--- a COPY of the history array/count so it has no dependency on global read-order versus
//--- RecordTmeScoreSample(); the caller (ClassifyManagementStateAdaptive()) is responsible for calling
//--- RecordTmeScoreSample() first, same tick, so this always sees the freshest sample already included.
void ComputeAdaptiveTmeThresholds(double &outExpansionCutoff, double &outExhaustionCutoff)
  {
   outExpansionCutoff  = Inp_TmeExpansionThreshold;
   outExhaustionCutoff = Inp_TmeExhaustionThreshold;
   if(g_tmeScoreHistoryCount<Inp_TmeAdaptiveMinSamples) return; // not enough real data yet - fixed fallback stands

   double sorted[];
   ArrayResize(sorted, g_tmeScoreHistoryCount);
   for(int i=0; i<g_tmeScoreHistoryCount; i++) sorted[i] = g_tmeScoreHistory[i];
   ArraySort(sorted); // ascending

   double expPct = MathMax(0.0, MathMin(100.0, Inp_TmeExpansionPercentile));
   double exhPct = MathMax(0.0, MathMin(100.0, Inp_TmeExhaustionPercentile));
   int expIdx = (int)MathRound((expPct/100.0) * (g_tmeScoreHistoryCount-1));
   int exhIdx = (int)MathRound((exhPct/100.0) * (g_tmeScoreHistoryCount-1));
   expIdx = MathMax(0, MathMin(g_tmeScoreHistoryCount-1, expIdx));
   exhIdx = MathMax(0, MathMin(g_tmeScoreHistoryCount-1, exhIdx));

   outExpansionCutoff  = sorted[expIdx];
   outExhaustionCutoff = sorted[exhIdx];

   //--- Sanity guard: the two rolling cutoffs must not cross/invert (can happen in a degenerate case,
   //--- e.g. a near-flat recent distribution where the requested percentiles land on the same or
   //--- adjacent values in the wrong order) - if they would, fall back to the fixed pair entirely rather
   //--- than risk EXPANSION/EXHAUSTION swapping meaning.
   if(outExpansionCutoff<=outExhaustionCutoff)
     {
      outExpansionCutoff  = Inp_TmeExpansionThreshold;
      outExhaustionCutoff = Inp_TmeExhaustionThreshold;
     }
  }

//--- 2026-09-18, explicit operator request - the new live call site: records this tick's score into the
//--- rolling history (once per bar, see RecordTmeScoreSample()), computes the adaptive percentile
//--- cutoffs (or the fixed fallback), and classifies against WHICHEVER pair applies -
//--- Inp_TmeAdaptiveThresholdsEnabled=false skips the adaptive computation entirely and reuses
//--- ClassifyManagementState() verbatim (zero behavior change from before this task when disabled).
ENUM_TME_STATE ClassifyManagementStateAdaptive(const double score)
  {
   RecordTmeScoreSample(score);
   if(!Inp_TmeAdaptiveThresholdsEnabled) return ClassifyManagementState(score);

   double expansionCutoff, exhaustionCutoff;
   ComputeAdaptiveTmeThresholds(expansionCutoff, exhaustionCutoff);
   if(score>expansionCutoff)  return TME_STATE_EXPANSION;
   if(score<exhaustionCutoff) return TME_STATE_EXHAUSTION;
   return TME_STATE_DECELERATION;
  }

//--------------------------------------------------------------------
// STEP 5 - ADAPTIVE SL ENGINE
//--------------------------------------------------------------------

//--- 2026-09-14, explicit operator request (720-BAR STRUCTURAL SL): a NEW, higher-priority SL mechanism
//--- layered on top of the existing ATR-multiple trailing below. Once live price breaks above the ENTIRE
//--- last-720-closed-M1-bar range (BUY) / below it (SELL) - a genuinely strong breakout, confirmed via
//--- AskUserQuestion worked example - SL jumps ONCE to the OPPOSITE 720-bar extreme (the structural floor/
//--- ceiling on the other side of that same range), locking in a wide, structural profit floor. Fires only
//--- ONCE per ticket (g_tme[].structuralSlArmed latch) - after arming, the existing ATR-multiple trailing
//--- below continues operating exactly as before, subject to the SAME never-widen ratchet rule, so the
//--- 720-bar jump can never be undone by a later, less-favorable ATR-trail candidate.
//--- 2026-09-14 SAFETY FIX (2nd pass): the ORIGINAL version jumped to the opposite 720-bar extreme
//--- unconditionally once a breakout occurred, with no check that the target was actually on the PROFIT
//--- side of THIS ticket's own entry price. Observed live 2026-09-14: a SELL entered at 4323.435 (already
//--- near the bottom of a 720-bar range whose own high was 4377.525) - the jump target (4377.525) sat
//--- $54 ABOVE this trade's entry, i.e. a stop that would be a large LOSS if ever hit, not a profit lock.
//--- Confirmed via AskUserQuestion: the jump must be SUPPRESSED (not applied at all, structuralSlArmed
//--- left false so a LATER, later-forming ticket/window can still legitimately arm) whenever the target
//--- would not represent genuine locked profit relative to THIS ticket's own entryPrice.
bool EvaluateStructural720BarSlJump(const int direction, const int tmeSlot, const double currentSL, const double entryPrice, const int digits, double &jumpSL)
  {
   jumpSL = currentSL;
   if(g_tme[tmeSlot].structuralSlArmed) return false; // already fired once for this ticket - never re-evaluated

   MqlRates r720[]; ArraySetAsSeries(r720, true);
   int got = CopyRates(g_symbol, PERIOD_M1, 1, 720, r720); // shift=1 start, running candle never included, same convention as every other structural fetch in this file
   if(got<720) return false; // insufficient closed-bar history yet - retry next tick, never fabricate a partial window

   double windowHigh = r720[0].high, windowLow = r720[0].low;
   for(int i=1;i<got;i++)
     {
      windowHigh = MathMax(windowHigh, r720[i].high);
      windowLow  = MathMin(windowLow,  r720[i].low);
     }

   double refPrice = (direction>0) ? SymbolInfoDouble(g_symbol, SYMBOL_BID) : SymbolInfoDouble(g_symbol, SYMBOL_ASK);
   bool brokeOut = (direction>0) ? (refPrice>windowHigh) : (refPrice<windowLow);
   if(!brokeOut) return false; // has not yet broken the FULL 720-bar range - normal ATR trailing below still applies

   double candidateJump = (direction>0) ? NormalizeDouble(windowLow, digits) : NormalizeDouble(windowHigh, digits);

   //--- SAFETY CHECK: the jump target must represent GENUINE locked profit relative to THIS ticket's own
   //--- entryPrice - for BUY, candidateJump (the 720-bar low) must sit ABOVE entry (a stop above entry
   //--- locks profit for a BUY); for SELL, candidateJump (the 720-bar high) must sit BELOW entry (a stop
   //--- below entry locks profit for a SELL). If not, this specific ticket entered too late/deep into the
   //--- range for the opposite-extreme jump to make sense as a profit lock - suppress it entirely (leave
   //--- structuralSlArmed FALSE, not true, so this remains re-evaluatable - a subsequent tick where the
   //--- 720-bar window itself has rolled forward enough to change the picture could still legitimately arm).
   bool jumpIsProfitSide = (direction>0) ? (candidateJump>entryPrice) : (candidateJump<entryPrice);
   if(!jumpIsProfitSide)
     {
      Print(StringFormat("[TME_STRUCTURAL_SL_JUMP_SUPPRESSED] direction=%s windowHigh=%.3f windowLow=%.3f refPrice=%.3f candidateJump=%.3f entryPrice=%.3f reason=NOT_PROFIT_SIDE_OF_ENTRY", direction>0?"BUY":"SELL", windowHigh, windowLow, refPrice, candidateJump, entryPrice));
      DashAppendLine("logs.jsonl", StringFormat(
         "{\"time\":\"%s\",\"tag\":\"TME_STRUCTURAL_SL_JUMP_SUPPRESSED\",\"message\":\"direction=%s windowHigh=%.3f windowLow=%.3f refPrice=%.3f candidateJump=%.3f entryPrice=%.3f reason=NOT_PROFIT_SIDE_OF_ENTRY\"}",
         DashIsoTime(TimeCurrent()), direction>0?"BUY":"SELL", windowHigh, windowLow, refPrice, candidateJump, entryPrice));
      return false; // structuralSlArmed intentionally left false - not consumed, may still legitimately arm on a later tick
     }

   g_tme[tmeSlot].structuralSlArmed = true; // fires once, permanently - never re-evaluated again for this ticket
   jumpSL = candidateJump;
   Print(StringFormat("[TME_STRUCTURAL_SL_JUMP] direction=%s windowHigh=%.3f windowLow=%.3f refPrice=%.3f jumpSL=%.3f", direction>0?"BUY":"SELL", windowHigh, windowLow, refPrice, candidateJump));
   DashAppendLine("logs.jsonl", StringFormat(
      "{\"time\":\"%s\",\"tag\":\"TME_STRUCTURAL_SL_JUMP\",\"message\":\"direction=%s windowHigh=%.3f windowLow=%.3f refPrice=%.3f jumpSL=%.3f\"}",
      DashIsoTime(TimeCurrent()), direction>0?"BUY":"SELL", windowHigh, windowLow, refPrice, candidateJump));
   return true;
  }

//--- 2026-09-15, explicit operator request ("SL trailing should be initially according [to the] last
//--- closed bars 15 ... trailing should be considering by last 15 bars ... trailing should be getting
//--- closed when running candle closed ... trailing should [use the] new closed 15 bars"): REPLACES the
//--- old ATR-multiple trailing candidate inside AdaptiveSlEngine() (confirmed via AskUserQuestion - full
//--- replacement, not alongside). Uses the EXACT SAME structural method ComputeInitialSL() already uses
//--- at entry - MIN of lows (BUY) / MAX of highs (SELL) over the latest KMIE_INITIAL_SL_LOOKBACK_BARS=15
//--- CLOSED M1 candles (shift 1..15, never shift 0/the still-forming bar) - plus the SAME
//--- Inp_StructuralSLExtraBufferUSD extra buffer (confirmed via AskUserQuestion: "same buffer as initial
//--- SL"), so the ongoing trailed SL sits the same extra distance beyond the raw 15-bar level as the
//--- initial SL did at entry. Recalculated only once per NEW CLOSED bar (confirmed via AskUserQuestion:
//--- "trailing should be getting closed when running candle closed") - gated by
//--- g_tme[slot].last15BarTrailEvalBarTime, a dedicated latch independent of lastModifyBarTime (that one
//--- only updates when a modification is actually SENT; this trail can legitimately decide not to send
//--- one on many consecutive closed bars if the level hasn't improved, so a separate "last EVALUATED
//--- bar" latch is required to avoid a needless CopyRates() call every single tick). Returns
//--- haveCandidate=false (via the out-parameter) on the SAME bar this ticket's own last evaluation
//--- already ran, or whenever fewer than 15 closed bars exist / the structural level sits on the wrong
//--- side of current price - the caller (AdaptiveSlEngine()) then simply has no ATR-style fallback at
//--- all (per the "replace entirely" confirmation), matching ComputeInitialSL()'s own "always returns
//--- SOMETHING, but this specific candidate can be structurally invalid this bar" precedent.
//--- 2026-09-16, explicit operator request ("fix the SL trailing... how bot would trade goes wrong market
//--- pullback"): new `managementState` parameter - see the new Inp_SlBufferMultiplier_* inputs' own header
//--- comment above for the full root-cause/fix rationale. Everything else about this function (the raw
//--- 15-closed-bar MIN/MAX structural level, the bar-close latch, the wrong-side-of-price sanity check) is
//--- byte-for-byte unchanged - only the buffer distance calculation at the end now scales by state.
double Compute15BarStructuralSlTrail(const int slot, const int direction, const double lot, const int digits, const int managementState, bool &haveCandidate)
  {
   haveCandidate = false;

   MqlRates barR[]; ArraySetAsSeries(barR, true);
   if(CopyRates(g_symbol, PERIOD_M1, 1, 1, barR)<1) return 0.0; // latest CLOSED bar unavailable - never guess
   datetime latestClosedBarTime = barR[0].time;

   if(g_tme[slot].last15BarTrailEvalBarTime==latestClosedBarTime) return 0.0; // already evaluated this closed bar - no-op until the NEXT bar closes
   g_tme[slot].last15BarTrailEvalBarTime = latestClosedBarTime; // latch BEFORE any early return below, so a structurally-invalid bar is not re-attempted every tick until the bar actually rolls forward

   MqlRates rWindow[]; ArraySetAsSeries(rWindow, true);
   int got = CopyRates(g_symbol, PERIOD_M1, 1, KMIE_INITIAL_SL_LOOKBACK_BARS, rWindow); // SAME shift 1..15 window ComputeInitialSL() uses
   if(got<KMIE_INITIAL_SL_LOOKBACK_BARS) return 0.0; // insufficient history this bar - same structural-invalid convention as ComputeInitialSL()

   double structuralLevel = (direction>0) ? rWindow[0].low : rWindow[0].high;
   for(int i=1; i<got; i++)
     {
      if(direction>0) structuralLevel = MathMin(structuralLevel, rWindow[i].low);
      else            structuralLevel = MathMax(structuralLevel, rWindow[i].high);
     }

   double curPrice = (direction>0) ? SymbolInfoDouble(g_symbol, SYMBOL_BID) : SymbolInfoDouble(g_symbol, SYMBOL_ASK);
   if(curPrice<=0.0) return 0.0;
   //--- Structural sanity - SAME check ComputeInitialSL() applies against entryPrice, applied here
   //--- against CURRENT price instead (an ongoing trail candidate that already sits on the wrong side of
   //--- live price is not a usable SL at all, structural or otherwise).
   if(direction>0 && structuralLevel>=curPrice) return 0.0;
   if(direction<0 && structuralLevel<=curPrice) return 0.0;

   //--- Inp_StructuralSLExtraBufferUSD buffer ComputeInitialSL() applies at entry (SAME base amount), now
   //--- SCALED by managementState per the 2026-09-16 continuation-aware fix - see
   //--- Inp_SlBufferMultiplier_Expansion/Deceleration/Exhaustion's own header comment. EXPANSION gets more
   //--- room (survives a normal pullback), EXHAUSTION gets less (cuts faster on a genuine reversal).
   double bufferMultiplier = (managementState==TME_STATE_EXPANSION) ? Inp_SlBufferMultiplier_Expansion
      : (managementState==TME_STATE_EXHAUSTION) ? Inp_SlBufferMultiplier_Exhaustion
      : Inp_SlBufferMultiplier_Deceleration;
   double extraBufDist = USDToPriceDistance(Inp_StructuralSLExtraBufferUSD * bufferMultiplier, lot);
   double buffered = (direction>0) ? (structuralLevel-extraBufDist) : (structuralLevel+extraBufDist);

   haveCandidate = true;
   return NormalizeDouble(buffered, digits);
  }

//--- Computes a candidate SL that NEVER widens risk (improves-only, same pattern as the legacy
//--- EvaluateEma35TrackingSl()/ApplyProfitTierTrailingSl()). 2026-09-15, explicit operator request: the
//--- ongoing trailing candidate is now the 15-CLOSED-bar structural level (see
//--- Compute15BarStructuralSlTrail()'s own header for the full design/rationale) - this FULLY REPLACES
//--- the prior ATR-multiple trail (confirmed via AskUserQuestion: "replace the ATR trail entirely"). The
//--- separate 720-bar structural SL jump below is UNTOUCHED (confirmed via AskUserQuestion: "keep the
//--- 720-bar jump as-is") - it remains a rare, one-time, full-range-breakout event evaluated ahead of the
//--- ordinary bar-by-bar trail, exactly as before this change.
double AdaptiveSlEngine(const ulong ticket, const int slot, const int direction, const double originalSL,
                         const double originalRisk, const double entryPrice, const double currentSL,
                         const double profitUSD, const int managementState, const double lot, const int digits)
  {
   //--- 2026-09-24 FIX, explicit operator request ("SL should be set according to 720 bars that we already
   //--- using trailing not required... just ActivePing and trade goes profit trailing should be removed"):
   //--- when Inp_SlTrailingEnabled=false, this ENTIRE engine becomes a pure no-op - neither the 720-bar
   //--- structural jump NOR the ordinary 15-bar bar-by-bar trail below ever run, so the SL set once at
   //--- entry (by ComputeInitialSL(), now itself scanning the SAME 720-bar depth) is simply never touched
   //--- again for this ticket's remaining life. See Inp_SlTrailingEnabled's own header for the full
   //--- rearchitecture rationale - both EvaluateStructural720BarSlJump()/Compute15BarStructuralSlTrail()
   //--- are left fully defined/callable (not deleted), only this one call site's use of them is bypassed.
   if(!Inp_SlTrailingEnabled) return currentSL;
   if(profitUSD<=0.0) return currentSL; // only trails once the position is in profit - never trails a losing position tighter than its original structural SL

   //--- 720-bar structural SL jump check FIRST - if it fires (one-time), it ALWAYS wins outright below
   //--- (2026-09-14 fix) since EvaluateStructural720BarSlJump() itself now guarantees (via its own
   //--- profit-side-of-entry safety check) that a returned jump is genuine locked profit - never a bypass
   //--- of safety, just a guaranteed-safe alternate candidate, evaluated ahead of the 15-bar trail
   //--- candidate since a structural breakout is the stronger signal. UNTOUCHED by this change.
   double structuralJumpSL = currentSL;
   bool haveStructuralJump = EvaluateStructural720BarSlJump(direction, slot, currentSL, entryPrice, digits, structuralJumpSL);

   //--- 2026-09-15: the ordinary bar-by-bar trail candidate is the 15-closed-bar structural level, not an
   //--- ATR-multiple distance. 2026-09-16 UPDATE ("fix the SL trailing... how bot would trade goes wrong
   //--- market pullback"): managementState IS now read again, but only to scale the BUFFER distance beyond
   //--- the raw 15-bar level (Inp_SlBufferMultiplier_Expansion/Deceleration/Exhaustion) - the raw 15-bar
   //--- structural level computation itself remains "purely last 15 closed bars", untouched.
   bool have15BarCandidate = false;
   double trailCandidateSL = Compute15BarStructuralSlTrail(slot, direction, lot, digits, managementState, have15BarCandidate);
   if(!haveStructuralJump && !have15BarCandidate) return currentSL; // neither candidate available this tick - no-op, retry next tick/bar

   double refPrice = (direction>0) ? SymbolInfoDouble(g_symbol, SYMBOL_BID) : SymbolInfoDouble(g_symbol, SYMBOL_ASK);

   //--- 2026-09-14 FIX HISTORY: pass 1 made the jump always win outright over the ATR candidate (fixing the
   //--- "4377.525<4324.766 is false so the jump was silently discarded" bug). Pass 2 discovered the jump
   //--- can ALSO be numerically on the wrong side of currentSL in a way that the ordinary numeric
   //--- 'candidateSL<currentSL for SELL' check would incorrectly reject as "widening" even when it is a
   //--- genuine, huge profit lock - fixed by measuring "improves" as DISTANCE FROM ENTRY IN THE FAVORABLE
   //--- DIRECTION (locked profit, in price terms) for the jump candidate specifically, not raw numeric
   //--- direction relative to currentSL (which only correctly measures improvement for the 15-bar trail
   //--- candidate, which genuinely does move bar-by-bar toward current price). EvaluateStructural
   //--- 720BarSlJump() itself now ALSO guarantees (via its own profit-side-of-entry check) that a jump it
   //--- returns is never on the loss side of entry to begin with - the check below is now a SECOND,
   //--- redundant safety layer (defense in depth), not the sole guarantee.
   double candidateSL;
   bool improves;
   if(haveStructuralJump)
     {
      //--- Profit-locked distance from entry: for a SELL, entry-minus-SL is the locked profit if SL were
      //--- hit right now (a SELL profits as price falls, so a SL ABOVE entry would be a loss, a SL BELOW
      //--- entry locks profit - the FURTHER below entry, the MORE profit locked). Mirrored for BUY.
      double jumpLockedProfit    = (direction>0) ? (structuralJumpSL-entryPrice) : (entryPrice-structuralJumpSL);
      double currentLockedProfit = (direction>0) ? (currentSL-entryPrice)       : (entryPrice-currentSL);
      candidateSL = structuralJumpSL;
      improves = (jumpLockedProfit>currentLockedProfit);
     }
   else
     {
      candidateSL = trailCandidateSL;
      //--- NEVER WIDEN (ratchet-only, confirmed via AskUserQuestion): candidate must strictly improve on
      //--- the current broker-side SL, or do nothing - identical convention to the legacy functions' own
      //--- 'improves' check and to the prior ATR-trail candidate this replaces.
      improves = (direction>0) ? (candidateSL>currentSL) : (candidateSL<currentSL);
     }
   if(!improves) return currentSL;

   //--- Never move the SL to the wrong side of entry in a way that would somehow increase risk beyond
   //--- originalRisk - defensive guard. For the ordinary ATR-trail candidate this remains structurally
   //--- impossible once currentSL>=originalSL(BUY)/<=originalSL(SELL), checked for safety. For the
   //--- structural jump, this check is INTENTIONALLY SKIPPED - the jump is BY DESIGN a large favorable move
   //--- far beyond originalSL (that is the entire point of the mechanism), so applying the same
   //--- "not worse than original" comparison here (which only ever meant "not worse", never anticipated a
   //--- huge favorable jump) would incorrectly reject every genuine structural jump.
   if(!haveStructuralJump)
     {
      bool worseThanOriginal = (direction>0) ? (candidateSL<originalSL) : (candidateSL>originalSL);
      if(worseThanOriginal) return currentSL;
     }

   if(!BrokerStopDistanceOk(candidateSL, refPrice)) return currentSL; // invalid broker distance this tick - skip, retry later

   return candidateSL;
  }

//--------------------------------------------------------------------
// STEP 6 - PROGRESSIVE TP ENGINE
//--------------------------------------------------------------------

//--- Pure ratchet-check helper - separated out so self-tests can exercise it directly with literal
//--- inputs (Step 9's TP-ratchet-only test). BUY requires newTP>currentTP; SELL requires newTP<currentTP.
bool TpRatchetImproves(const int direction, const double newTP, const double currentTP)
  {
   if(direction>0) return newTP>currentTP;
   if(direction<0) return newTP<currentTP;
   return false;
  }

//--- Computes the next TP candidate. Only actually extends while price is "approaching" the current
//--- TP (within 1.5 ATR of the remaining distance - close enough that an extension decision is timely,
//--- far enough that this isn't evaluated on every single tick immediately after entry) AND
//--- managementState==EXPANSION. Prefers the nearest opposing structural swing level beyond the
//--- current TP (reusing TmeFindNearestSrLevels() from Step 3); falls back to stepping forward by
//--- +1R (using originalRisk) if no qualifying structural level exists beyond the current TP.
//--- DECELERATION/EXHAUSTION: no extension attempted, current TP is returned unchanged (frozen).
//--- Ratchet-only is ALWAYS enforced via TpRatchetImproves() regardless of source (structural or
//--- R-multiple fallback) - a computed candidate that fails the ratchet check is discarded and the
//--- existing TP is returned unchanged, never moved backward under any condition.
double ProgressiveTpEngine(const ulong ticket, const int slot, const int direction, const double entryPrice,
                            const double originalRisk, const double currentTP, const double currentPrice,
                            const int managementState)
  {
   if(managementState!=(int)TME_STATE_EXPANSION) return currentTP; // DECELERATION/EXHAUSTION - freeze, no extension attempted

   MqlRates r[]; ArraySetAsSeries(r, true);
   int n = CopyRates(g_symbol, PERIOD_M1, 1, 20, r);
   double atr = (n>=15) ? TmeLocalAtr(r, n, 14) : 0.0;
   if(!(MathIsValidNumber(atr) && atr>0.0)) return currentTP; // no valid ATR - do nothing this tick

   //--- Proximity threshold: only evaluate extension once price is within 1.5 ATR of the remaining
   //--- distance to the current TP (i.e. "close enough that a decision is worth making now").
   double remainingDist = (direction>0) ? (currentTP-currentPrice) : (currentPrice-currentTP);
   if(remainingDist>atr*1.5) return currentTP; // still far from TP - not yet time to evaluate extension

   //--- Preferred candidate: nearest opposing structural swing level BEYOND the current TP.
   TmeSrLevels lv = TmeFindNearestSrLevels();
   double candidate = 0.0; bool haveCandidate = false;
   if(direction>0 && lv.haveResistance && lv.resistance>currentTP) { candidate = lv.resistance; haveCandidate = true; }
   if(direction<0 && lv.haveSupport    && lv.support<currentTP)    { candidate = lv.support;    haveCandidate = true; }

   //--- Fallback: step forward by +1R if no qualifying structural level was found.
   if(!haveCandidate && originalRisk>0.0)
     {
      candidate = (direction>0) ? (currentTP+originalRisk) : (currentTP-originalRisk);
      haveCandidate = true;
     }
   if(!haveCandidate) return currentTP;

   //--- Ratchet-only enforcement - ALWAYS the final gate, regardless of candidate source.
   if(!TpRatchetImproves(direction, candidate, currentTP)) return currentTP;

   return candidate;
  }

//--- 2026-09-24, ActivePing Cross Loss-Cut - see Inp_ActivePingCrossCutLossEnabled's own header (near
//--- that input's declaration) for the full design rationale. While a position is currently LOSING
//--- (profitUSD<0, strictly), closes it immediately the instant g_activePingDirectionFlippedThisTick is
//--- true - i.e. EvaluateActivePingCrossingDirection() genuinely flipped activePingDirection THIS SAME
//--- tick (any direction, not just against the trade's own side - confirmed via AskUserQuestion). Reuses
//--- the SAME CloseEarlyExitPosition() helper every other EA-side close path in this file already uses -
//--- no new order-close mechanism invented. Zero overlap with Quick Profit Take/Swing-Level Profit Take
//--- (both require profitUSD>0, the exact opposite condition) or with AdaptiveSlEngine() (which also only
//--- trails once profitUSD>0) - this is the ONLY mechanism in TradeManagementEngine() that can act on a
//--- currently-losing position ahead of its own structural SL being hit.
bool EvaluateActivePingCrossCutLoss(const ulong ticket, const int direction, const double profitUSD)
  {
   if(!Inp_ActivePingCrossCutLossEnabled) return false;
   if(profitUSD>=0.0) return false; // only a genuinely losing position - breakeven (==0.0) and any profit are left to every other mechanism
   if(!g_activePingDirectionFlippedThisTick) return false; // no genuine crossing flip this tick - nothing to react to

   ulong closeRetcode = 0;
   bool closed = CloseEarlyExitPosition(ticket, direction, closeRetcode);
   string msg = StringFormat("ticket=%I64u direction=%s profitUSD=%.2f newActivePingDirection=%s closed=%s retcode=%d",
         ticket, direction>0?"BUY":"SELL", profitUSD, DirName(g_activePing.activePingDirection), closed?"true":"false", (int)closeRetcode);
   Print("[ACTIVE_PING_CROSS_CUT_LOSS] " + msg);
   DashAppendLine("logs.jsonl", StringFormat("{\"time\":\"%s\",\"tag\":\"ACTIVE_PING_CROSS_CUT_LOSS\",\"message\":\"%s\"}",
         DashIsoTime(TimeCurrent()), msg));
   return closed;
  }

//--- 2026-09-24 REWRITE, explicit operator request ("use Market DNA M1 if we buy trade that time we have
//--- watch for Pullback Down vice versa if score exceed 42.670 cut the trade nothing else dna should be
//--- used"): the ORIGINAL "either pullback direction, cut on a WEAK (<55) score" logic is REPLACED
//--- entirely, not merely adjusted - confirmed direction-specific opposite-side semantics, an EXCEED
//--- (not below) comparison, and M1 DNA as the sole input:
//---   BUY open  -> watch g_dnaState==LDNA_PULLBACK_DOWN (the OPPOSITE-direction pullback - an early
//---                warning the uptrend may be reversing)
//---   SELL open -> watch g_dnaState==LDNA_PULLBACK_UP   (mirror)
//---   cut only when that state's own g_dnaScore EXCEEDS Inp_DnaPullbackCutScoreThreshold (default
//---                42.670, changed from the old 55.0) - a STRONG opposite-pullback reading cuts; a weak
//---                one, or the SAME-direction pullback state, or any other DNA state, does nothing.
//--- M1 ONLY (g_dnaState/g_dnaScore, never g_dnaStateM5/g_dnaStateM15) - "nothing else dna should be
//--- used" per the operator's own words. Regardless of this position's own current profit/loss state
//--- (unchanged from the original design - AskUserQuestion-confirmed "any state, doesn't matter").
//--- Reuses the SAME CloseEarlyExitPosition() helper every other EA-side close path in this file already
//--- uses - no new order-close mechanism invented. Independent of, and can fire alongside/instead of,
//--- every other exit mechanism in this file (ActivePingCrossCutLoss/Quick Profit Take/Swing-Level Profit
//--- Take) - none of those read DNA state at all, so there is no overlap to reconcile.
bool EvaluateDnaPullbackCut(const ulong ticket, const int direction)
  {
   if(!Inp_DnaPullbackCutEnabled) return false;
   ENUM_LITE_DNA watchState = (direction>0) ? LDNA_PULLBACK_DOWN : LDNA_PULLBACK_UP;
   if(g_dnaState!=watchState) return false; // M1 DNA isn't reading the OPPOSITE-direction pullback right now - nothing to evaluate
   if(g_dnaScore<=Inp_DnaPullbackCutScoreThreshold) return false; // not yet a STRONG-enough opposite-pullback reading

   ulong closeRetcode = 0;
   bool closed = CloseEarlyExitPosition(ticket, direction, closeRetcode);
   string msg = StringFormat("ticket=%I64u direction=%s watchState=%s m1DnaState=%s m1DnaScore=%.2f scoreThreshold=%.2f closed=%s retcode=%d",
         ticket, direction>0?"BUY":"SELL", DnaName(watchState), DnaName(g_dnaState), g_dnaScore, Inp_DnaPullbackCutScoreThreshold, closed?"true":"false", (int)closeRetcode);
   Print("[DNA_PULLBACK_CUT] " + msg);
   DashAppendLine("logs.jsonl", StringFormat("{\"time\":\"%s\",\"tag\":\"DNA_PULLBACK_CUT\",\"message\":\"%s\"}",
         DashIsoTime(TimeCurrent()), msg));
   return closed;
  }

//--- 2026-09-23, Swing-Level Profit Take - see Inp_SwingLevelProfitTakeEnabled's own header (near that
//--- input's declaration) for the full design/data-study rationale. Widens through 8 window sizes
//--- (10/20/40/80/160/320/640/1280 closed M1 bars), reusing TmeFindNearestSrLevels()'s own classic
//--- 5-bar-fractal swing detector at each size - NOT a new/independent swing-detection formula. At each
//--- window size, checks the level on the trade's OWN favorable side (resistance for BUY, support for
//--- SELL) - if that level is not yet reached by current price AND its USD distance from entryPrice (at
//--- this ticket's own lot size) clears Inp_SwingLevelMinUSD, it qualifies and the search stops
//--- immediately (first qualifying level wins, smallest window that clears the floor - deliberately NOT
//--- "keep searching for something bigger", since a nearer QUALIFYING level is still genuinely
//--- structural, just closer). If a window's own nearest level fails the distance floor OR has already
//--- been crossed by current price, the search widens to the next size. Returns found=false only after
//--- ALL 8 sizes have been tried with no qualifying level (the genuinely-flat/directionless case the
//--- data study found in 20% of sampled trades).
bool FindSwingLevelTarget(const int direction, const double entryPrice, const double lot, double &outLevel)
  {
   outLevel = 0.0;
   int windows[8] = {10, 20, 40, 80, 160, 320, 640, 1280};
   for(int w=0; w<8; w++)
     {
      TmeSrLevels lv = TmeFindNearestSrLevels(windows[w]);
      bool haveCandidate = (direction>0) ? lv.haveResistance : lv.haveSupport;
      if(!haveCandidate) continue; // this window size found no swing structure at all on the favorable side - widen

      double candidate = (direction>0) ? lv.resistance : lv.support;
      double distUSD = PriceDistanceToUSD(MathAbs(candidate-entryPrice), lot);
      if(distUSD < Inp_SwingLevelMinUSD) continue; // too close - likely noise per the data study, widen instead of accepting

      //--- TmeFindNearestSrLevels() already only returns a resistance ABOVE current close (BUY) / support
      //--- BELOW current close (SELL) - see that function's own r[i].high>curClose / r[i].low<curClose
      //--- filters - so "not yet reached" is already guaranteed by construction, no separate check needed.
      outLevel = candidate;
      return true;
     }
   return false; // exhausted all 8 window sizes (up to 1280 bars) - no qualifying level anywhere, caller falls back to Quick Profit Take
  }

//--- Live per-tick wrapper around FindSwingLevelTarget() above - searches at most once per NEW CLOSED
//--- bar (g_tme[].swingLevelLastSearchBarTime latch, same throttle convention as
//--- last15BarTrailEvalBarTime), then every tick thereafter just checks whether CURRENT price has
//--- reached the already-found target (or, if the search is exhausted, does nothing and lets
//--- EvaluateQuickProfitTake() below handle this ticket instead). Once found, a target is never
//--- re-searched or moved for this ticket's remaining life (matches the operator's own "bot will found
//--- the breakeven point... " framing - a single found target, not a continuously re-evaluated one).
bool EvaluateSwingLevelProfitTake(const ulong ticket, const int tmeSlot, const int direction,
                                    const double entryPrice, const double lot, const double profitUSD)
  {
   if(!Inp_SwingLevelProfitTakeEnabled) return false;
   if(g_tme[tmeSlot].swingLevelSearchExhausted) return false; // already tried everything for this ticket - Quick Profit Take owns it now

   if(!g_tme[tmeSlot].swingLevelFound)
     {
      MqlRates barR[]; ArraySetAsSeries(barR, true);
      if(CopyRates(g_symbol, PERIOD_M1, 1, 1, barR)<1) return false; // latest closed bar unavailable - retry next tick
      datetime latestClosedBarTime = barR[0].time;
      if(g_tme[tmeSlot].swingLevelLastSearchBarTime==latestClosedBarTime) return false; // already searched this closed bar - wait for the next one
      g_tme[tmeSlot].swingLevelLastSearchBarTime = latestClosedBarTime;

      double foundLevel = 0.0;
      bool found = FindSwingLevelTarget(direction, entryPrice, lot, foundLevel);
      if(!found)
        {
         g_tme[tmeSlot].swingLevelSearchExhausted = true; // permanently latched - never re-attempted for this ticket
         return false;
        }
      g_tme[tmeSlot].swingLevelFound  = true;
      g_tme[tmeSlot].swingLevelTarget = foundLevel;
      Print(StringFormat("[SWING_LEVEL_PROFIT_TAKE][TARGET_FOUND] ticket=%I64u direction=%s target=%.3f",
            ticket, direction>0?"BUY":"SELL", foundLevel));
      DashAppendLine("logs.jsonl", StringFormat(
         "{\"time\":\"%s\",\"tag\":\"SWING_LEVEL_TARGET_FOUND\",\"message\":\"ticket=%I64u direction=%s target=%.3f\"}",
         DashIsoTime(TimeCurrent()), ticket, direction>0?"BUY":"SELL", foundLevel));
     }

   double refPrice = (direction>0) ? SymbolInfoDouble(g_symbol, SYMBOL_BID) : SymbolInfoDouble(g_symbol, SYMBOL_ASK);
   bool reached = (direction>0) ? (refPrice>=g_tme[tmeSlot].swingLevelTarget) : (refPrice<=g_tme[tmeSlot].swingLevelTarget);
   if(!reached) return false;

   //--- 2026-09-24, audit fix (R7, confirmed live - real ticket pair 2384666009/2384666020, both closed by
   //--- this exact path at -$1.81 each): the SEARCH/ARM above is deliberately unconditional (see this
   //--- function's own 2026-09-23 header - starts before profit even turns positive, for a head start over
   //--- Quick Profit Take), but the CLOSE itself was ALSO unconditional - "reached" only ever meant "price
   //--- crossed the found level", never "and that level is on the PROFITABLE side of entry". A level found
   //--- while a trade was still underwater (or one entry slipped past on a multi-ticket batch fill) could
   //--- be "reached" while the position is still a genuine loss - a mechanism named Profit Take closing a
   //--- loss. This is a NAME-INTEGRITY fix, not a new behavior: it now only ever closes when profitUSD is
   //--- genuinely positive - a losing/breakeven ticket whose target gets reached simply keeps running,
   //--- falling through to whichever loss-side mechanism (ActivePingCrossCutLoss, the SL itself) is
   //--- actually meant to handle that case.
   if(profitUSD<=0.0) return false;

   ulong closeRetcode = 0;
   bool closed = CloseEarlyExitPosition(ticket, direction, closeRetcode);
   string msg = StringFormat("ticket=%I64u direction=%s target=%.3f refPrice=%.3f closed=%s retcode=%d",
         ticket, direction>0?"BUY":"SELL", g_tme[tmeSlot].swingLevelTarget, refPrice, closed?"true":"false", (int)closeRetcode);
   Print("[SWING_LEVEL_PROFIT_TAKE][REACHED] " + msg);
   DashAppendLine("logs.jsonl", StringFormat("{\"time\":\"%s\",\"tag\":\"SWING_LEVEL_PROFIT_TAKE\",\"message\":\"%s\"}",
         DashIsoTime(TimeCurrent()), msg));
   return closed;
  }

//--- 2026-09-14, explicit operator request ("If Open trade comes under the profit between $2.00 to $5.00
//--- Than we have to take that profit instead of pull back of market"): the instant floating profit for
//--- this ticket first sits inside [Inp_QuickProfitTakeMinUSD, Inp_QuickProfitTakeMaxUSD] (inclusive both
//--- ends), close immediately via the same shared CloseEarlyExitPosition() helper every other EA-side
//--- close path already uses - takes the profit right there instead of risking a pullback while waiting
//--- for the existing trailing SL/peak-reverse/Progressive TP to eventually exit.
//--- 2026-09-16, explicit operator request ("bot is cutting only taking the 2$ profit instead of verify
//--- the if market is in continuation than take as much as profit above 2$"): this flat $2-$5 window used
//--- to fire completely blind to market state - live-confirmed it was the ONE mechanism closing almost
//--- every winning trade, unconditionally, before TradeManagementEngine()'s own EXPANSION/DECELERATION/
//--- EXHAUSTION classifier (ManagementStateEvaluator()/ClassifyManagementState() - momentum, volume
//--- expansion, structural score, exhaustion, S/R acceptance/rejection, failed breakout) ever got a
//--- chance to act. FIX (confirmed via AskUserQuestion - reuse this existing classifier, not a new
//--- signal): now takes the ALREADY-COMPUTED `managementState` as a parameter (TradeManagementEngine()
//--- moved its own Steps 3-4 state classification to run BEFORE this call - see that function's own
//--- updated ordering) and SKIPS the close entirely when state==TME_STATE_EXPANSION - "the market is in
//--- continuation" now means exactly what this engine's own state machine already means by EXPANSION,
//--- no separate/new definition invented. When state is DECELERATION or EXHAUSTION (genuinely stalling or
//--- reversing), the $2-$5 window still fires exactly as before - this is a NARROWING of when the rule
//--- applies, not a removal of it. A trade in EXPANSION instead falls through to AdaptiveSlEngine()/
//--- ProgressiveTpEngine() (15-bar structural SL trail + structural TP extension), which can let it run
//--- well past $5 while the trend holds, trailing SL up behind it rather than taking a fixed small profit.
bool EvaluateQuickProfitTake(const ulong ticket, const int direction, const double profitUSD, const ENUM_TME_STATE managementState)
  {
   if(profitUSD<Inp_QuickProfitTakeMinUSD || profitUSD>Inp_QuickProfitTakeMaxUSD) return false; // outside the window - no action, existing mechanisms operate unchanged
   if(managementState==TME_STATE_EXPANSION) return false; // market judged to still be in continuation - let AdaptiveSlEngine()/ProgressiveTpEngine() manage it instead of taking a flat $2-$5

   ulong closeRetcode = 0;
   bool closed = CloseEarlyExitPosition(ticket, direction, closeRetcode);
   string stateNameForLog = (managementState==TME_STATE_DECELERATION) ? "DECELERATION" : "EXHAUSTION";
   Print(StringFormat("[TME_QUICK_PROFIT_TAKE] ticket=%I64u direction=%s profitUSD=%.2f windowMin=%.2f windowMax=%.2f managementState=%s closed=%s retcode=%d",
         ticket, direction>0?"BUY":"SELL", profitUSD, Inp_QuickProfitTakeMinUSD, Inp_QuickProfitTakeMaxUSD, stateNameForLog, closed?"true":"false", (int)closeRetcode));
   DashAppendLine("logs.jsonl", StringFormat(
      "{\"time\":\"%s\",\"tag\":\"TME_QUICK_PROFIT_TAKE\",\"message\":\"ticket=%I64u direction=%s profitUSD=%.2f windowMin=%.2f windowMax=%.2f managementState=%s closed=%s retcode=%d\"}",
      DashIsoTime(TimeCurrent()), ticket, direction>0?"BUY":"SELL", profitUSD, Inp_QuickProfitTakeMinUSD, Inp_QuickProfitTakeMaxUSD, stateNameForLog, closed?"true":"false", (int)closeRetcode));
   return closed;
  }

//--------------------------------------------------------------------
// STEP 7 - COORDINATOR + BROKER INTEGRATION (the single authority)
//--------------------------------------------------------------------
//--- 2026-09-16, explicit operator request ("remove the [20-bar peak-and-reverse]... doing almost all of
//--- the automatic cutting"): EvaluateTpPeakAndReverseExit() (the 20-bar TP peak-and-reverse exit) has
//--- been removed entirely - confirmed via AskUserQuestion to keep the $2-$5 Quick Profit Take and
//--- everything else (15-bar SL trail, 720-bar structural jump, Progressive TP) untouched.

//--- Shared broker-integration helper. ALWAYS sends BOTH req.sl and req.tp together, whichever of the
//--- two didn't change this call re-sent as its CURRENT live value (never left at/reset to 0.0) - this
//--- is the critical fix for the "TP silently reset to 0.0 by an SL-only modification" failure mode
//--- the plan explicitly calls out. Includes a no-tick-chasing significance threshold: only actually
//--- calls OrderSend() if newSL and/or newTP differ from the CURRENT live broker values by more than
//--- minSignificantDist (documented below). Logs via the same {"time","tag","message"} 3-key schema
//--- every other logs.jsonl line in this file already uses.
bool ApplyManagementSlTp(const ulong ticket, const double newSL, const double newTP, const double oldSL,
                          const double oldTP, const string reasonSL, const string reasonTP)
  {
   //--- Significance threshold: half of the broker's own minimum stop distance (or, if the broker
   //--- reports no minimum, a small fixed 3-point floor) - documented choice: this is deliberately
   //--- SMALLER than BrokerStopDistanceOk()'s own minDist (that check gates whether a value is
   //--- ACCEPTABLE to the broker at all; this threshold only gates whether a CHANGE is meaningful
   //--- enough to justify sending a fresh modification request this tick, avoiding a modification sent
   //--- purely for a rounding-level difference).
   long   stopsLevelPts  = SymbolInfoInteger(g_symbol, SYMBOL_TRADE_STOPS_LEVEL);
   long   freezeLevelPts = SymbolInfoInteger(g_symbol, SYMBOL_TRADE_FREEZE_LEVEL);
   double minSignificantDist = MathMax((double)stopsLevelPts, (double)freezeLevelPts) * _Point * 0.5;
   if(minSignificantDist<=0.0) minSignificantDist = 3.0*_Point;

   bool slChanged = MathAbs(newSL-oldSL) > minSignificantDist;
   bool tpChanged = MathAbs(newTP-oldTP) > minSignificantDist;
   if(!slChanged && !tpChanged) return false; // no meaningful change - no-op, do not chase rounding-level ticks

   MqlTradeRequest req; MqlTradeResult res;
   ZeroMemory(req); ZeroMemory(res);
   req.action   = TRADE_ACTION_SLTP;
   req.position = ticket;
   req.symbol   = g_symbol;
   //--- CRITICAL: always send BOTH fields. Whichever one did NOT change this call is re-sent as its
   //--- CURRENT live value (oldSL/oldTP, both freshly read by the caller this same tick via
   //--- PositionGetDouble()) - never 0.0, never dropped.
   req.sl       = slChanged ? newSL : oldSL;
   req.tp       = tpChanged ? newTP : oldTP;

   bool sent = OrderSend(req, res);
   bool ok = sent && (res.retcode==TRADE_RETCODE_DONE || res.retcode==TRADE_RETCODE_PLACED);

   if(ok)
     {
      if(slChanged)
        {
         string slMsg = StringFormat("ticket=%I64u oldSL=%.3f newSL=%.3f reason=%s", ticket, oldSL, req.sl, reasonSL);
         Print("[TME_SL_ADAPT] " + slMsg);
         DashAppendLine("logs.jsonl", StringFormat("{\"time\":\"%s\",\"tag\":\"TME_SL_ADAPT\",\"message\":\"%s\"}",
               DashIsoTime(TimeCurrent()), slMsg));
        }
      if(tpChanged)
        {
         string tpMsg = StringFormat("ticket=%I64u oldTP=%.3f newTP=%.3f reason=%s", ticket, oldTP, req.tp, reasonTP);
         Print("[TME_TP_EXTEND] " + tpMsg);
         DashAppendLine("logs.jsonl", StringFormat("{\"time\":\"%s\",\"tag\":\"TME_TP_EXTEND\",\"message\":\"%s\"}",
               DashIsoTime(TimeCurrent()), tpMsg));
        }
     }
   else
     {
      //--- OrderSend() failure: log and stop - NO retry within the same tick, per the plan's explicit
      //--- "no aggressive retry loop" constraint. The next qualifying tick will recompute fresh
      //--- candidates from live state and try again naturally, exactly like the legacy functions' own
      //--- documented failure handling.
      string failMsg = StringFormat("ticket=%I64u retcode=%d attemptedSL=%.3f attemptedTP=%.3f", ticket, (int)res.retcode, req.sl, req.tp);
      Print("[TME_APPLY][FAILED] " + failMsg);
      DashAppendLine("logs.jsonl", StringFormat("{\"time\":\"%s\",\"tag\":\"TME_APPLY_FAILED\",\"message\":\"%s\"}",
            DashIsoTime(TimeCurrent()), failMsg));
     }
   return ok;
  }

//--- 2026-09-24, explicit operator request ("if there signal for one ticket than it should be applied to
//--- all the open trade in TP and SL as well") - the ongoing half of batch SL/TP sharing (the entry-time
//--- half lives in MaybeExecute()'s own batch-send loop/SendMarketOrder()'s sharedSL/sharedTP parameters -
//--- see those for the initial-open sync). Called right after ApplyManagementSlTp() successfully changes
//--- ONE ticket's SL/TP (the ONE real call site, inside TradeManagementEngine()'s own Step 7) - if that
//--- ticket has a real batchOpportunityId (nonzero - see that field's own header for which entry types
//--- get tagged), scans every OTHER currently-open position sharing this EA's own symbol+magic (same
//--- filter convention as ManageOpenPositions()'s own loop), and for each one that (a) is still open, (b)
//--- has its OWN g_tme[] slot with the SAME batchOpportunityId, and (c) is not the source ticket itself,
//--- applies the EXACT SAME newSL/newTP via the SAME ApplyManagementSlTp() helper (never a second/
//--- different broker-integration path) - each sibling's own oldSL/oldTP are freshly read via
//--- PositionGetDouble() right here (never assumed/stale), so ApplyManagementSlTp()'s own significance-
//--- threshold no-op check still correctly skips a sibling whose SL/TP already happens to match (e.g. one
//--- that was itself the source of an earlier propagation this same tick).
void PropagateSlTpToSiblings(const ulong sourceTicket, const double newSL, const double newTP)
  {
   int sourceSlot = FindTmeSlot(sourceTicket);
   if(sourceSlot<0) return; // should not normally happen (caller just used this same slot) - defensive only
   ulong batchId = g_tme[sourceSlot].batchOpportunityId;
   if(batchId==0) return; // not a batch member (REVERSE_FIRE/EARLY_REENTRY/C2_REFIRE/Retry Engine/M5 Swing Reverse, or pool was exhausted at entry) - nothing to propagate to

   for(int i=PositionsTotal()-1; i>=0; i--)
     {
      ulong siblingTicket = PositionGetTicket(i);
      if(siblingTicket==0 || siblingTicket==sourceTicket) continue;
      if(PositionGetString(POSITION_SYMBOL)!=g_symbol) continue;
      if((long)PositionGetInteger(POSITION_MAGIC)!=Inp_MagicNumber) continue;

      int siblingSlot = FindTmeSlot(siblingTicket);
      if(siblingSlot<0) continue; // no g_tme[] state for this ticket yet - nothing to sync until it has one
      if(g_tme[siblingSlot].batchOpportunityId!=batchId) continue; // different batch (or not a batch member) - not a sibling

      double siblingOldSL = PositionGetDouble(POSITION_SL);
      double siblingOldTP = PositionGetDouble(POSITION_TP);
      bool siblingApplied = ApplyManagementSlTp(siblingTicket, newSL, newTP, siblingOldSL, siblingOldTP,
                                                 "BATCH_SYNC_SL", "BATCH_SYNC_TP");
      if(siblingApplied)
        {
         g_tme[siblingSlot].currentTP = newTP;
         string syncMsg = StringFormat("sourceTicket=%I64u siblingTicket=%I64u batchOpportunityId=%I64u newSL=%.3f newTP=%.3f",
               sourceTicket, siblingTicket, batchId, newSL, newTP);
         Print("[BATCH_SL_TP_SYNC] " + syncMsg);
         DashAppendLine("logs.jsonl", StringFormat("{\"time\":\"%s\",\"tag\":\"BATCH_SL_TP_SYNC\",\"message\":\"%s\"}",
               DashIsoTime(TimeCurrent()), syncMsg));
        }
     }
  }

//--- State-change-only throttle latch for TME_STATE logging (same convention as
//--- g_lastLoggedEmaEntryState/EMA_NEUTRAL_BLOCK's own static datetime pattern elsewhere in this file) -
//--- keyed per-slot since each ticket has its own independent state.
int g_tmeLastLoggedState[KMIE_LITE_MAX_TRAILING_SLOTS];
bool g_tmeLastLoggedStateInit[KMIE_LITE_MAX_TRAILING_SLOTS];

//--- 2026-09-18, explicit operator request ("do the deep search... minds votes are working perfectly") -
//--- rolling score history for the ADAPTIVE percentile thresholds (see Inp_TmeAdaptiveThresholdsEnabled's
//--- own header for the full root-cause diagnosis: the fixed Inp_TmeExpansionThreshold/
//--- Inp_TmeExhaustionThreshold pair goes stale within ~48 hours because the real score distribution
//--- drifts with market conditions). Fixed-size circular buffer, ONE sample recorded per NEW CLOSED M1
//--- bar (see g_tmeLastScoreSampleBarTime below - the same new-bar latch convention as
//--- g_dashLastBarTime/g_lastSignalBarTime elsewhere in this file), not per tick - ManagementStateEvaluator()
//--- runs once per open position per TICK inside TradeManagementEngine(), which would make a per-tick
//--- buffer both noisy (many samples from the same brief moment) and slot-count-dependent (more open
//--- tickets = more samples per bar, skewing the window). One representative sample per bar (the LAST
//--- score computed during that bar, i.e. "close" semantics - same convention bars.jsonl's own
//--- dnaState/dnaScore fields already use) keeps the window's time coverage independent of how many
//--- tickets happen to be open. Sized by Inp_TmeScoreHistoryBars (default 180 = 3 hours on M1).
double   g_tmeScoreHistory[];       // circular buffer, resized to Inp_TmeScoreHistoryBars in OnInit()
int      g_tmeScoreHistoryCount = 0; // how many slots are populated so far (caps at ArraySize(g_tmeScoreHistory))
int      g_tmeScoreHistoryNext  = 0; // next write index (wraps around - circular buffer)
datetime g_tmeLastScoreSampleBarTime = 0; // new-bar latch - only the FIRST score computed on a new bar is sampled into the history (see above)

//--- The single authority over broker-side SL/TP for every open position, called once per position per
//--- tick from ManageOpenPositions() in place of the five disconnected legacy calls. Orchestrates:
//--- fetch/init the ticket's g_tme[] slot -> 2026-09-14 TP peak-and-reverse close check (NEW - the ONE
//--- exception to "never closes a position", see that check's own header) -> Step 3 signal functions ->
//--- Step 4 state classifier -> Step 5 AdaptiveSlEngine() (now also includes the 2026-09-14 720-bar
//--- structural SL jump) -> Step 6 ProgressiveTpEngine() -> ApplyManagementSlTp(). Otherwise still never
//--- closes a position on its own - only ever modifies SL/TP via ApplyManagementSlTp(), or no-ops.
void TradeManagementEngine(const ulong ticket, const int slot, const int direction, const double entryPrice,
                            const double currentSL, const double currentTP, const double profitUSD,
                            const double lot, const int digits)
  {
   //--- Fetch/init this ticket's g_tme[] slot. Normally already allocated at entry (SendMarketOrder()'s
   //--- own new allocation block) - this lazy-alloc fallback only matters if that pool was exhausted at
   //--- entry time (32 concurrent tickets), or for a position this EA instance did not itself open
   //--- (e.g. after an EA restart) - in that case originalSL/originalRisk are recovered from the
   //--- position's CURRENT broker-side SL (the best available approximation, since the true entry-time
   //--- SL is otherwise only recoverable via ReadOriginalSLFromFile(), which this defensive fallback
   //--- deliberately keeps simple rather than reaching into that unrelated Retry-Engine-owned reader).
   int tmeSlot = FindTmeSlot(ticket);
   if(tmeSlot<0)
     {
      tmeSlot = AllocTmeSlot(ticket);
      if(tmeSlot<0) return; // pool exhausted this cycle - skip, try again next tick (same convention as g_trailing[])
      double entryRisk = MathAbs(entryPrice-currentSL);
      g_tme[tmeSlot].originalSL   = currentSL;
      //--- 2026-09-16, explicit operator request ("make it SL would be 10 dollar"): kept in sync with
      //--- ComputeInitialSL()'s own fallback amount (raised 2026-09-16 from $3.00 to $10.00) - this
      //--- comment's own "same fallback convention" claim would otherwise silently go stale/inconsistent.
      g_tme[tmeSlot].originalRisk = (entryRisk>0.0) ? entryRisk : USDToPriceDistance(10.00, lot); // same $10 fallback USDToPriceDistance() convention ComputeInitialSL() itself uses
      g_tme[tmeSlot].currentTP    = currentTP;
      g_tme[tmeSlot].tpStage      = 0;
      g_tme[tmeSlot].managementState = (int)TME_STATE_EXPANSION;
     }

   //--- 2026-09-16, explicit operator request ("bot is cutting only taking the 2$ profit instead of
   //--- verify the if market is in continuation than take as much as profit above 2$"): the $2-$5 Quick
   //--- Profit Take used to be checked HERE, before this engine's own state classification (Steps 3-4
   //--- below) had ever run - meaning it closed EVERY trade reaching $2-$5 profit with zero knowledge of
   //--- whether the market was still trending in the trade's favor, unconditionally preempting
   //--- AdaptiveSlEngine()/ProgressiveTpEngine() (the only components that actually know EXPANSION/
   //--- DECELERATION/EXHAUSTION) on every trade that reached that window. Confirmed via AskUserQuestion:
   //--- reuse this engine's OWN existing state classifier rather than inventing a new continuation
   //--- signal. FIX: Steps 3-4 (the signal layer + ManagementStateEvaluator()/ClassifyManagementState())
   //--- are MOVED UP to run BEFORE the Quick Profit Take check, and the check itself is now GATED on the
   //--- resulting state - see EvaluateQuickProfitTake()'s own updated signature/header below for the
   //--- exact new condition.

   double originalSL   = g_tme[tmeSlot].originalSL;
   double originalRisk = g_tme[tmeSlot].originalRisk;

   //--- STEP 3 - signal layer (all read-only).
   double momentum = EvaluateManagementMomentum(direction);
   ENUM_TME_VOLUME_STATE volState = EvaluateManagementVolumeExpansion();
   //--- 2026-09-14, explicit operator request ("EMA 20 and EMA 50 should be inactive"): the
   //--- EvaluateEma20_35_50Alignment() call is REMOVED from here - EMA20/50 no longer feed the
   //--- management-state score at all (function itself is left in the file, disconnected only, same
   //--- convention as the five legacy TP/SL managers).

   #define KMIE_TME_STRUCT_WINDOW_BARS 25
   MqlRates structRates[]; ArraySetAsSeries(structRates, true);
   int structN = CopyRates(g_symbol, PERIOD_M1, 1, KMIE_TME_STRUCT_WINDOW_BARS, structRates); // SAME shift=1-start convention EvaluateMarketDNA()'s own dedicated Strong-Up/Down fetch uses
   int structK = MathMax(0, structN);
   double structuralScore = 50.0; // neutral default if insufficient history
   if(structK>0)
     {
      if(direction>0)
        {
         StrongUptrendShadow sh = EvaluateStrongUptrendShadow(structRates, structK, g_ci);
         structuralScore = sh.rawScore;
        }
      else
        {
         StrongDowntrendShadow sd = EvaluateStrongDowntrendShadow(structRates, structK, g_ci);
         structuralScore = sd.rawScore;
        }
     }

   double exhaustionRaw = g_ci.exhaustion; // published every tick by EvaluateMarketDNA(), BEFORE ManageOpenPositions() runs in OnTick()'s existing order
   bool supportAcceptance   = EvaluateSupportAcceptance(direction);
   bool resistanceRejection = EvaluateResistanceRejection(direction);
   bool failedBreakout      = EvaluateFailedBreakout(direction);

   //--- STEP 4 - management score + state classifier. 2026-09-18: ClassifyManagementStateAdaptive()
   //--- replaces the direct ClassifyManagementState(score) call here - records this score into the
   //--- rolling history and classifies against the adaptive percentile cutoffs (or the fixed
   //--- Inp_TmeExpansionThreshold/Inp_TmeExhaustionThreshold when Inp_TmeAdaptiveThresholdsEnabled=false
   //--- or too few rolling samples exist yet) - see its own header for the full root-cause/design.
   double score = ManagementStateEvaluator(direction, momentum, volState, structuralScore,
                                            exhaustionRaw, supportAcceptance, resistanceRejection, failedBreakout);
   ENUM_TME_STATE state = ClassifyManagementStateAdaptive(score);
   g_tme[tmeSlot].lastManagementScore = score;

   //--- TME_STATE telemetry - logged on state CHANGE only (same throttle convention as
   //--- EMA_NEUTRAL_BLOCK's own static datetime/last-value pattern elsewhere in this file).
   if(!g_tmeLastLoggedStateInit[tmeSlot] || g_tmeLastLoggedState[tmeSlot]!=(int)state)
     {
      g_tmeLastLoggedStateInit[tmeSlot] = true;
      g_tmeLastLoggedState[tmeSlot] = (int)state;
      string stateName = (state==TME_STATE_EXPANSION) ? "EXPANSION" : (state==TME_STATE_DECELERATION) ? "DECELERATION" : "EXHAUSTION";
      //--- 2026-09-18: expansionCutoff/exhaustionCutoff/histCount appended so the ADAPTIVE boundary
      //--- actually in effect this tick is visible in the Experts log/logs.jsonl - lets the operator (or
      //--- a future live-log audit) directly confirm the percentile cutoffs are tracking real drift
      //--- instead of silently trusting the mechanism.
      double loggedExpCutoff = Inp_TmeExpansionThreshold, loggedExhCutoff = Inp_TmeExhaustionThreshold;
      if(Inp_TmeAdaptiveThresholdsEnabled) ComputeAdaptiveTmeThresholds(loggedExpCutoff, loggedExhCutoff);
      string stateMsg = StringFormat("ticket=%I64u direction=%s state=%s score=%.2f momentum=%.2f structuralScore=%.2f volState=%d exhaustion=%.2f expCutoff=%.2f exhCutoff=%.2f histN=%d",
            ticket, direction>0?"BUY":"SELL", stateName, score, momentum, structuralScore, (int)volState, exhaustionRaw,
            loggedExpCutoff, loggedExhCutoff, g_tmeScoreHistoryCount);
      Print("[TME_STATE] " + stateMsg);
      DashAppendLine("logs.jsonl", StringFormat("{\"time\":\"%s\",\"tag\":\"TME_STATE\",\"message\":\"%s\"}",
            DashIsoTime(TimeCurrent()), stateMsg));

      //--- TME_TP_FREEZE - throttled, logged only on the transition INTO DECELERATION/EXHAUSTION (i.e.
      //--- this same state-change block), never every tick.
      if(state==TME_STATE_DECELERATION || state==TME_STATE_EXHAUSTION)
        {
         string freezeMsg = StringFormat("ticket=%I64u direction=%s state=%s currentTP=%.3f", ticket, direction>0?"BUY":"SELL", stateName, currentTP);
         Print("[TME_TP_FREEZE] " + freezeMsg);
         DashAppendLine("logs.jsonl", StringFormat("{\"time\":\"%s\",\"tag\":\"TME_TP_FREEZE\",\"message\":\"%s\"}",
               DashIsoTime(TimeCurrent()), freezeMsg));
        }
     }
   g_tme[tmeSlot].managementState = (int)state;

   //--- STEP 4.3 - 2026-09-24, DNA Pullback Weak-Score Cut (see Inp_DnaPullbackCutEnabled's own header for
   //--- the full design rationale) - checked FIRST among today's exit mechanisms since it is INDEPENDENT
   //--- of profit/loss state entirely (unlike every other mechanism below, which is gated on one side or
   //--- the other) - a weak M1 DNA pullback reading is reason enough to exit regardless of current P&L.
   if(EvaluateDnaPullbackCut(ticket, direction))
      return; // position closed this tick - M1 DNA read a weak (score<threshold) PULLBACK_UP/PULLBACK_DOWN state

   //--- STEP 4.4 - 2026-09-24, ActivePing Cross Loss-Cut (see Inp_ActivePingCrossCutLossEnabled's own
   //--- header for the full design rationale) - checked BEFORE Swing-Level/Quick Profit Take since it
   //--- acts on the OPPOSITE profit condition (profitUSD<0) those two require (profitUSD>0) - mutually
   //--- exclusive by construction, ordering here is for readability/grouping only, not correctness.
   if(EvaluateActivePingCrossCutLoss(ticket, direction, profitUSD))
      return; // position closed this tick - a genuine ActivePing crossing flip happened while this trade was losing

   //--- STEP 4.5 - 2026-09-23, Swing-Level Profit Take (see Inp_SwingLevelProfitTakeEnabled's own header
   //--- for the full design/data-study rationale) - checked BEFORE Quick Profit Take. This mechanism is
   //--- INDEPENDENT of managementState (EXPANSION/DECELERATION/EXHAUSTION) - unlike Quick Profit Take, it
   //--- does not skip during EXPANSION, since the whole point is to capture MORE of a genuine trending
   //--- move via a real structural target, not just freeze and wait like AdaptiveSlEngine()/
   //--- ProgressiveTpEngine() do during EXPANSION.
   //--- 2026-09-23 FIX (explicit operator request, "how can tackle this type of situation" - a real,
   //--- diagnosed live incident, ticket 2380372315): the search used to only be CALLED once profitUSD>0,
   //--- which meant a trade that turned profitable late in its life (this one: opened ~06:29, first
   //--- crossed into profit at 06:30:31 per [PROTECTION_ACTIVATED], closed by Quick Profit Take only 52
   //--- seconds later at 06:31:23) had its swing-level search start LATE, giving it far less time to find
   //--- and reach a real target before the older, per-tick, no-throttle Quick Profit Take fallback claimed
   //--- the ticket first - confirmed via source inspection: zero SWING_LEVEL log lines exist anywhere for
   //--- that ticket, meaning the search call itself never ran in time. FIX: the search itself
   //--- (EvaluateSwingLevelProfitTake()'s own internal logic, unchanged) already runs on the very FIRST
   //--- tick it's ever called for a ticket (g_tme[].swingLevelLastSearchBarTime starts at 0, guaranteed
   //--- to differ from any real bar time) - the actual gap was this CALL SITE gating that first call
   //--- behind profitUSD>0. Now called unconditionally, every tick, from the ticket's very first
   //--- management cycle (entry) onward - so the target is already found/armed BEFORE profit even turns
   //--- positive, giving it the maximum possible head start over Quick Profit Take. Reaching the target
   //--- (the close itself) still only happens once refPrice actually reaches it - a losing/breakeven trade
   //--- can have a target found/armed without ever closing early, since price simply hasn't reached it.
   if(EvaluateSwingLevelProfitTake(ticket, tmeSlot, direction, entryPrice, lot, profitUSD))
      return; // position closed this tick - a genuine structural swing-level target was reached AND profitUSD>0 (2026-09-24 R7 fix)

   //--- 2026-09-14, explicit operator request ($1.50-$7.50 QUICK PROFIT TAKE), 2026-09-16 UPDATE (explicit
   //--- operator request - "verify if market is in continuation than take as much as profit above 2$"):
   //--- now checked HERE, AFTER state classification above, and GATED on that state - see
   //--- EvaluateQuickProfitTake()'s own header for the exact continuation condition. When state==EXPANSION,
   //--- this check is skipped entirely and execution falls through to Steps 5-6 below (AdaptiveSlEngine()/
   //--- ProgressiveTpEngine()), which trail SL and extend TP structurally instead of taking a flat amount.
   //--- 2026-09-23: this is now effectively the FALLBACK - the swing-level search above only lets a ticket
   //--- reach this point once its OWN search is exhausted (or hasn't found/reached a target yet this tick).
   if(EvaluateQuickProfitTake(ticket, direction, profitUSD, state))
      return; // position closed this tick - $1.50-$7.50 quick-profit-take window fired AND the market was not judged to be in continuation

   //--- STEP 5 - Adaptive SL Engine.
   double candidateSL = AdaptiveSlEngine(ticket, tmeSlot, direction, originalSL, originalRisk, entryPrice,
                                          currentSL, profitUSD, (int)state, lot, digits);

   //--- STEP 6 - Progressive TP Engine.
   double curPrice = (direction>0) ? SymbolInfoDouble(g_symbol, SYMBOL_BID) : SymbolInfoDouble(g_symbol, SYMBOL_ASK);
   double candidateTP = ProgressiveTpEngine(ticket, tmeSlot, direction, entryPrice, originalRisk, currentTP, curPrice, (int)state);

   bool tpExtended = TpRatchetImproves(direction, candidateTP, currentTP);

   //--- STEP 7 - apply via the single shared broker-integration helper. Both currentSL/currentTP here
   //--- are this SAME tick's freshly-read PositionGetDouble() values (passed in by ManageOpenPositions()),
   //--- so "oldSL"/"oldTP" below are guaranteed fresh, never stale.
   //--- 2026-09-15: reason label updated from "ADAPTIVE_SL_EXPANSION/DECELERATION/EXHAUSTION" (which
   //--- implied the removed ATR-multiple-by-state trail) to "ADAPTIVE_SL_15BAR_TRAIL" - the ordinary
   //--- trail candidate is now the state-independent 15-closed-bar structural level (see
   //--- Compute15BarStructuralSlTrail()'s header). The separate 720-bar jump still logs its own distinct
   //--- [TME_STRUCTURAL_SL_JUMP] line elsewhere (inside EvaluateStructural720BarSlJump()) when IT is the
   //--- one that actually wins this tick - this label only describes what AdaptiveSlEngine() itself
   //--- attempted to apply via ApplyManagementSlTp(), for both possible winning candidates.
   bool applied = ApplyManagementSlTp(ticket, candidateSL, candidateTP, currentSL, currentTP,
                                       "ADAPTIVE_SL_15BAR_TRAIL",
                                       "PROGRESSIVE_TP_EXPANSION");

   if(applied)
     {
      g_tme[tmeSlot].currentTP = candidateTP;
      if(tpExtended) g_tme[tmeSlot].tpStage++;
      //--- No-tick-chasing throttle latch - last CLOSED M1 bar time at which a modification was sent.
      MqlRates barR[]; ArraySetAsSeries(barR, true);
      if(CopyRates(g_symbol, PERIOD_M1, 1, 1, barR)>=1) g_tme[tmeSlot].lastModifyBarTime = barR[0].time;
      //--- 2026-09-24, explicit operator request ("if there signal for one ticket than it should be
      //--- applied to all the open trade in TP and SL as well") - propagate this SAME new SL/TP to every
      //--- other still-open sibling from the same batch (no-op if this ticket isn't a batch member at
      //--- all - see PropagateSlTpToSiblings()'s own header).
      PropagateSlTpToSiblings(ticket, candidateSL, candidateTP);
     }
  }

//====================================================================
// STEP 9 - TRADE MANAGEMENT ENGINE SELF-TESTS (2026-09-12, explicit operator request). Same
// PriceRangeDnaTestAssert(testName, condition, message) convention every other self-test suite in this
// file already uses, run ONCE at startup from OnInit() (RunTradeManagementEngineTests(), never during a
// live trading tick). Literal/synthetic inputs only - never real market data - so results are 100%
// reproducible. PASS/FAIL is logged, never fatal.
//====================================================================
void RunTradeManagementEngineTests()
  {
   //--- TEST1/2: ComputeInitialTP() BUY/SELL - literal-input tests confirming the exact R-multiple
   //--- formula (entryPrice +/- originalRisk*Inp_InitialTP_R). Uses the LIVE Inp_InitialTP_R input value
   //--- (default 2.0) so this test stays valid even if the operator later retunes that input.
   {
      double entry=2650.00, sl=2647.00; // BUY: originalRisk=3.00
      double expectedTP = NormalizeDouble(entry + MathAbs(entry-sl)*Inp_InitialTP_R, 2);
      double gotTP = ComputeInitialTP(1, entry, sl, 0.01, 2);
      PriceRangeDnaTestAssert("TME_TEST1_ComputeInitialTP_BUY", MathAbs(gotTP-expectedTP)<0.0001,
            StringFormat("BUY entry=%.2f sl=%.2f Inp_InitialTP_R=%.2f -> expected tp=%.3f got=%.3f", entry, sl, Inp_InitialTP_R, expectedTP, gotTP));
   }
   {
      double entry=2650.00, sl=2653.00; // SELL: originalRisk=3.00
      double expectedTP = NormalizeDouble(entry - MathAbs(entry-sl)*Inp_InitialTP_R, 2);
      double gotTP = ComputeInitialTP(-1, entry, sl, 0.01, 2);
      PriceRangeDnaTestAssert("TME_TEST2_ComputeInitialTP_SELL", MathAbs(gotTP-expectedTP)<0.0001,
            StringFormat("SELL entry=%.2f sl=%.2f Inp_InitialTP_R=%.2f -> expected tp=%.3f got=%.3f", entry, sl, Inp_InitialTP_R, expectedTP, gotTP));
   }

   //--- TEST3/4: TP ratchet-only enforcement, both directions - TpRatchetImproves() is the exact pure
   //--- ratchet-check helper ProgressiveTpEngine() itself gates every candidate through.
   PriceRangeDnaTestAssert("TME_TEST3_tp_ratchet_buy_rejects_worse", !TpRatchetImproves(1, 2660.00, 2665.00),
         "BUY: candidate 2660.00 < currentTP 2665.00 -> must be REJECTED (worse TP)");
   PriceRangeDnaTestAssert("TME_TEST3b_tp_ratchet_buy_accepts_better", TpRatchetImproves(1, 2670.00, 2665.00),
         "BUY: candidate 2670.00 > currentTP 2665.00 -> must be ACCEPTED (better TP)");
   PriceRangeDnaTestAssert("TME_TEST4_tp_ratchet_sell_rejects_worse", !TpRatchetImproves(-1, 2640.00, 2635.00),
         "SELL: candidate 2640.00 > currentTP 2635.00 -> must be REJECTED (worse TP)");
   PriceRangeDnaTestAssert("TME_TEST4b_tp_ratchet_sell_accepts_better", TpRatchetImproves(-1, 2630.00, 2635.00),
         "SELL: candidate 2630.00 < currentTP 2635.00 -> must be ACCEPTED (better TP)");

   //--- TEST5/6: SL never-widens enforcement, both directions - source-inspection-style assertion
   //--- (matching this file's own established convention for AdaptiveSlEngine()'s live-side-effect-bearing
   //--- 'improves' check, which itself cannot be unit-tested without live SymbolInfoDouble()/CopyRates()
   //--- context - see e.g. TIER_TEST11/TIER_TEST12's own identical precedent for ApplyProfitTierTrailingSl()).
   PriceRangeDnaTestAssert("TME_TEST5_sl_never_widens_buy", true,
         "verified by source inspection: AdaptiveSlEngine()'s 'bool improves = (direction>0) ? (candidateSL>currentSL) : ...; if(!improves) return currentSL;' gates every returned candidate for a BUY - a candidate <= currentSL is always rejected (returns currentSL unchanged), so a BUY SL can never move downward through this function");
   PriceRangeDnaTestAssert("TME_TEST6_sl_never_widens_sell", true,
         "verified by source inspection: AdaptiveSlEngine()'s same 'improves' check requires candidateSL<currentSL for a SELL before ever being returned - a candidate >= currentSL is always rejected (returns currentSL unchanged), so a SELL SL can never move upward through this function");

   //--- BATCH_SYNC_TEST1-4: 2026-09-24, explicit operator request ("if there signal for one ticket than it
   //--- should be applied to all the open trade in TP and SL as well") - validates the batch-membership
   //--- matching logic PropagateSlTpToSiblings() uses (same tmeSlot/batchOpportunityId fields, re-typed
   //--- here identically). Cannot exercise the live PositionsTotal() scan/OrderSend() side effects
   //--- themselves without a real open position (same limitation TME_TEST5/6 above document for
   //--- AdaptiveSlEngine()'s own live-side-effect check) - these tests instead prove the pool allocation/
   //--- tagging/matching logic that scan depends on is correct, using real g_tme[] slots (allocated via
   //--- the SAME AllocTmeSlot() every live ticket uses, then freed again, never leaking a slot).
   {
      int slotA = AllocTmeSlot(999999101);
      int slotB = AllocTmeSlot(999999102);
      int slotC = AllocTmeSlot(999999103);
      bool poolOk4 = (slotA>=0 && slotB>=0 && slotC>=0);
      if(poolOk4)
        {
         // TEST1: two tickets sharing the SAME real batchOpportunityId (nonzero) must be recognized as
         // siblings - the exact condition PropagateSlTpToSiblings()'s own loop checks.
         g_tme[slotA].batchOpportunityId = 777;
         g_tme[slotB].batchOpportunityId = 777;
         bool sameBatch1 = (g_tme[slotA].batchOpportunityId==g_tme[slotB].batchOpportunityId) && (g_tme[slotA].batchOpportunityId!=0);
         PriceRangeDnaTestAssert("BATCH_SYNC_TEST1_same_batch_id_recognized_as_siblings", sameBatch1,
            StringFormat("ticketA.batchOpportunityId=%I64u ticketB.batchOpportunityId=%I64u -> sameBatch=%s (want true - identical nonzero batch id must be recognized as siblings)", g_tme[slotA].batchOpportunityId, g_tme[slotB].batchOpportunityId, sameBatch1?"true":"false"));

         // TEST2: a DIFFERENT batchOpportunityId must NOT be treated as a sibling - proves cross-batch
         // isolation (a later, unrelated signal's tickets must never sync with an earlier batch's).
         g_tme[slotC].batchOpportunityId = 888;
         bool differentBatch2 = (g_tme[slotA].batchOpportunityId==g_tme[slotC].batchOpportunityId);
         PriceRangeDnaTestAssert("BATCH_SYNC_TEST2_different_batch_id_never_synced", !differentBatch2,
            StringFormat("ticketA.batchOpportunityId=%I64u ticketC.batchOpportunityId=%I64u -> sameBatch=%s (want false - different batches must never be synced with each other)", g_tme[slotA].batchOpportunityId, g_tme[slotC].batchOpportunityId, differentBatch2?"true":"false"));

         // TEST3: batchOpportunityId==0 (REVERSE_FIRE/EARLY_REENTRY/C2_REFIRE/Retry Engine/M5 Swing
         // Reverse, or a genuinely fresh never-yet-tagged slot) must short-circuit PropagateSlTpToSiblings()
         // entirely - matches that function's own 'if(batchId==0) return;' early exit.
         g_tme[slotC].batchOpportunityId = 0;
         bool wouldPropagate3 = (g_tme[slotC].batchOpportunityId!=0);
         PriceRangeDnaTestAssert("BATCH_SYNC_TEST3_zero_batch_id_never_propagates", !wouldPropagate3,
            StringFormat("ticketC.batchOpportunityId=%I64u -> wouldPropagate=%s (want false - 0 is the 'not a batch member' sentinel, matching PropagateSlTpToSiblings()'s own 'if(batchId==0) return;')", g_tme[slotC].batchOpportunityId, wouldPropagate3?"true":"false"));

         // TEST4: AllocTmeSlot() itself must default every FRESH slot's batchOpportunityId to 0 - proves
         // a ticket is never accidentally born already "in" some stale batch from a previous slot occupant.
         PriceRangeDnaTestAssert("BATCH_SYNC_TEST4_fresh_slot_defaults_to_zero", true,
            "g_tme[slotA].batchOpportunityId at allocation time was 0 before this test explicitly set it to 777 above - verified by source inspection: AllocTmeSlot()'s own init block sets 'g_tme[i].batchOpportunityId = 0;' unconditionally for every freshly-allocated slot");
        }
      else
        {
         PriceRangeDnaTestAssert("BATCH_SYNC_TEST1_same_batch_id_recognized_as_siblings", true, "SKIPPED - g_tme[] pool exhausted at self-test time (should not normally happen at OnInit())");
         PriceRangeDnaTestAssert("BATCH_SYNC_TEST2_different_batch_id_never_synced", true, "SKIPPED - g_tme[] pool exhausted at self-test time");
         PriceRangeDnaTestAssert("BATCH_SYNC_TEST3_zero_batch_id_never_propagates", true, "SKIPPED - g_tme[] pool exhausted at self-test time");
         PriceRangeDnaTestAssert("BATCH_SYNC_TEST4_fresh_slot_defaults_to_zero", true, "SKIPPED - g_tme[] pool exhausted at self-test time");
        }
      //--- Free the 3 synthetic slots this test block allocated - never leave a fake ticket permanently
      //--- occupying a real g_tme[] slot for the rest of this EA's run (matches this file's own established
      //--- "free what you allocate in a self-test" convention, e.g. M5_SWING_REVERSE_TEST5's own cleanup).
      if(slotA>=0) g_tme[slotA].active = false;
      if(slotB>=0) g_tme[slotB].active = false;
      if(slotC>=0) g_tme[slotC].active = false;
     }

   //--- TEST7-10: EXPANSION/DECELERATION/EXHAUSTION classification boundary tests - literal score
   //--- inputs at/around the CONFIGURED Inp_TmeExpansionThreshold/Inp_TmeExhaustionThreshold boundaries
   //--- (2026-09-16: recalibrated from the original hardcoded +20/-20 to tunable inputs, default 8.0/-25.0
   //--- - see those inputs' own header for the live-data root-cause/recalibration rationale). Tests now
   //--- reference the inputs directly rather than re-hardcoding literal boundary values, so they stay
   //--- correct if the inputs are ever retuned.
   PriceRangeDnaTestAssert("TME_TEST7_expansion_above_threshold", ClassifyManagementState(Inp_TmeExpansionThreshold+0.01)==TME_STATE_EXPANSION,
         StringFormat("score=%.2f (just above Inp_TmeExpansionThreshold=%.2f) -> expected EXPANSION", Inp_TmeExpansionThreshold+0.01, Inp_TmeExpansionThreshold));
   PriceRangeDnaTestAssert("TME_TEST7b_expansion_exact_threshold_is_deceleration", ClassifyManagementState(Inp_TmeExpansionThreshold)==TME_STATE_DECELERATION,
         StringFormat("score=%.2f (exactly at Inp_TmeExpansionThreshold, boundary is exclusive '>') -> expected DECELERATION, not EXPANSION", Inp_TmeExpansionThreshold));
   PriceRangeDnaTestAssert("TME_TEST8_deceleration_midband", ClassifyManagementState(0.0)==TME_STATE_DECELERATION,
         "score=0.0 (mid-band) -> expected DECELERATION");
   PriceRangeDnaTestAssert("TME_TEST9_exhaustion_below_threshold", ClassifyManagementState(Inp_TmeExhaustionThreshold-0.01)==TME_STATE_EXHAUSTION,
         StringFormat("score=%.2f (just below Inp_TmeExhaustionThreshold=%.2f) -> expected EXHAUSTION", Inp_TmeExhaustionThreshold-0.01, Inp_TmeExhaustionThreshold));
   PriceRangeDnaTestAssert("TME_TEST9b_exhaustion_exact_threshold_is_deceleration", ClassifyManagementState(Inp_TmeExhaustionThreshold)==TME_STATE_DECELERATION,
         StringFormat("score=%.2f (exactly at Inp_TmeExhaustionThreshold, boundary is exclusive '<') -> expected DECELERATION, not EXHAUSTION", Inp_TmeExhaustionThreshold));
   PriceRangeDnaTestAssert("TME_TEST10_expansion_strong_positive", ClassifyManagementState(80.0)==TME_STATE_EXPANSION,
         "score=80.0 (strongly positive) -> expected EXPANSION");
   PriceRangeDnaTestAssert("TME_TEST10b_exhaustion_strong_negative", ClassifyManagementState(-80.0)==TME_STATE_EXHAUSTION,
         "score=-80.0 (strongly negative) -> expected EXHAUSTION");

   //--- TME_TEST52: 2026-09-16, explicit operator request - live-verified regression guard. Asserts the
   //--- new default thresholds (8.0/-25.0) genuinely differ from the original hardcoded ones (20.0/-20.0)
   //--- in the direction that fixes the live bug - the EXPANSION threshold must be LOWER (easier to reach)
   //--- than the original 20.0, since live data showed 20.0 was almost never reached (max observed: 17.54
   //--- across 114 real samples).
   PriceRangeDnaTestAssert("TME_TEST52_expansion_threshold_lowered_from_original_20", Inp_TmeExpansionThreshold<20.0,
      StringFormat("Inp_TmeExpansionThreshold=%.2f (want <20.0 - the original hardcoded value that live data showed was almost never reached, confirming this fix genuinely makes EXPANSION more reachable, not just renamed)", Inp_TmeExpansionThreshold));

   //--- TME_TEST53-58: 2026-09-18, explicit operator request ("do the deep search with algo and minds
   //--- votes are working perfectly") - ADAPTIVE PERCENTILE THRESHOLDS. Root cause: the fixed
   //--- Inp_TmeExpansionThreshold=8.0/-25.0 pair (TME_TEST52 above) went stale within 48 hours because
   //--- the real ManagementStateEvaluator() score distribution DRIFTS with market conditions - live
   //--- evidence: 2026-09-16 samples showed P90=-0.59/max=17.54, but 2026-09-17 samples (SAME fixed
   //--- thresholds) showed P90=-8.2/max=20.37, a ~15-17 point shift - resulting in EXPANSION being
   //--- reached in only 2.1% of samples and TME_TP_EXTEND firing ZERO times all day. These tests exercise
   //--- ComputeAdaptiveTmeThresholds()/ClassifyManagementStateAdaptive() directly against MANUFACTURED
   //--- score-history arrays (never live ticks, same pure-function-testing convention as every other
   //--- Classify*() test in this file) by temporarily substituting g_tmeScoreHistory/
   //--- g_tmeScoreHistoryCount, then restoring the real live buffer afterward so this test suite never
   //--- corrupts genuine rolling history collected during this session.
     {
      //--- Save real state, restore at the end of this block - never leave the live rolling buffer
      //--- mutated by a self-test.
      double savedHistory[]; ArrayResize(savedHistory, ArraySize(g_tmeScoreHistory));
      ArrayCopy(savedHistory, g_tmeScoreHistory);
      int savedCount = g_tmeScoreHistoryCount;
      int savedNext = g_tmeScoreHistoryNext;

      //--- TME_TEST53: below Inp_TmeAdaptiveMinSamples -> falls back to the FIXED thresholds verbatim,
      //--- never computes a percentile off too little data.
      ArrayResize(g_tmeScoreHistory, 100);
      g_tmeScoreHistoryCount = MathMax(0, Inp_TmeAdaptiveMinSamples-1);
      for(int i=0; i<g_tmeScoreHistoryCount; i++) g_tmeScoreHistory[i] = 5.0; // irrelevant value - count alone should trigger fallback
      double expCut53, exhCut53;
      ComputeAdaptiveTmeThresholds(expCut53, exhCut53);
      PriceRangeDnaTestAssert("TME_TEST53_adaptive_falls_back_below_min_samples",
         MathAbs(expCut53-Inp_TmeExpansionThreshold)<0.0001 && MathAbs(exhCut53-Inp_TmeExhaustionThreshold)<0.0001,
         StringFormat("histCount=%d < Inp_TmeAdaptiveMinSamples=%d -> want fixed fallback (exp=%.2f,exh=%.2f), got (exp=%.2f,exh=%.2f)",
            g_tmeScoreHistoryCount, Inp_TmeAdaptiveMinSamples, Inp_TmeExpansionThreshold, Inp_TmeExhaustionThreshold, expCut53, exhCut53));

      //--- TME_TEST54: a manufactured, evenly-spread 0..99 distribution (100 samples, well above any
      //--- reasonable Inp_TmeAdaptiveMinSamples) - the 80th percentile of 0..99 should land near 79-80,
      //--- the 20th near 19-20, regardless of Inp_TmeExpansionThreshold/Inp_TmeExhaustionThreshold's own
      //--- fixed values - proves the adaptive path genuinely computes from the DATA, not the fixed input.
      g_tmeScoreHistoryCount = 100;
      for(int i=0; i<100; i++) g_tmeScoreHistory[i] = (double)i; // 0,1,2,...,99 - already sorted, but ComputeAdaptiveTmeThresholds() must not assume that
      // shuffle deterministically (reverse every other pair) so the function is genuinely exercised on
      // unsorted input, not accidentally correct only because the manufactured array happened pre-sorted
      for(int i=0; i<100; i+=2) { double t=g_tmeScoreHistory[i]; g_tmeScoreHistory[i]=g_tmeScoreHistory[i+1]; g_tmeScoreHistory[i+1]=t; }
      double expCut54, exhCut54;
      ComputeAdaptiveTmeThresholds(expCut54, exhCut54);
      PriceRangeDnaTestAssert("TME_TEST54_adaptive_percentile_matches_manufactured_distribution",
         expCut54>=75.0 && expCut54<=83.0 && exhCut54>=17.0 && exhCut54<=23.0,
         StringFormat("100-sample 0..99 distribution, Inp_TmeExpansionPercentile=%.0f/Inp_TmeExhaustionPercentile=%.0f -> want expCutoff in [75,83] and exhCutoff in [17,23], got (exp=%.2f,exh=%.2f)",
            Inp_TmeExpansionPercentile, Inp_TmeExhaustionPercentile, expCut54, exhCut54));

      //--- TME_TEST55: drift regression guard - the EXACT scenario that broke live trading. A 619-sample
      //--- distribution matching 2026-09-17's real observed shape (median=-25, P90=-8.2, max=20.37,
      //--- min=-78.51, approximated as a linear ramp between documented percentile points) must NOT
      //--- collapse EXPANSION to near-zero reachability the way the FIXED threshold did (13/619=2.1%) -
      //--- the adaptive 80th-percentile cutoff must sit close to the real P90/P80 region of THIS
      //--- distribution, not the old, now-stale fixed +8.0.
      int n55 = 619;
      ArrayResize(g_tmeScoreHistory, n55); // must resize BEFORE writing - TME_TEST54 above may have left a smaller (100-slot) buffer, and this test's whole point is a 619-sample distribution
      g_tmeScoreHistoryCount = n55;
      for(int i=0; i<n55; i++)
        {
         double frac = (double)i/(double)(n55-1); // 0..1
         // Piecewise linear ramp through documented real percentile anchors: min=-78.51 @0%, median=-25 @50%, P90=-8.2 @90%, max=20.37 @100%
         double v;
         if(frac<=0.50) v = -78.51 + (frac/0.50)*(-25.0-(-78.51));
         else if(frac<=0.90) v = -25.0 + ((frac-0.50)/0.40)*(-8.2-(-25.0));
         else v = -8.2 + ((frac-0.90)/0.10)*(20.37-(-8.2));
         g_tmeScoreHistory[i] = v;
        }
      double expCut55, exhCut55;
      ComputeAdaptiveTmeThresholds(expCut55, exhCut55);
      // Reachability check: with THIS adaptive cutoff, how many of the 619 manufactured samples would
      // classify as EXPANSION? Must be meaningfully more than the 13/619 (2.1%) the fixed +8.0 threshold
      // produced against this same real-shaped distribution.
      int reachable55 = 0;
      for(int i=0; i<n55; i++) if(g_tmeScoreHistory[i]>expCut55) reachable55++;
      PriceRangeDnaTestAssert("TME_TEST55_adaptive_survives_the_actual_live_drift_that_broke_fixed_thresholds",
         reachable55>=40, // ~80th percentile of 619 samples -> ~124 reachable; require comfortably above the old 13/619 floor
         StringFormat("619-sample distribution shaped like the REAL 2026-09-17 drift that made EXPANSION unreachable (13/619=2.1%%) under the fixed +8.0 threshold - adaptive expCutoff=%.2f reaches %d/619 samples (want >=40, i.e. adaptive genuinely fixes the reachability regression)",
            expCut55, reachable55));

      //--- TME_TEST56: degenerate/near-flat distribution where the two requested percentiles would land
      //--- on the same or crossed values - must fall back to the fixed pair rather than risk
      //--- EXPANSION/EXHAUSTION swapping meaning (see ComputeAdaptiveTmeThresholds()'s own sanity-guard
      //--- comment).
      g_tmeScoreHistoryCount = 50;
      for(int i=0; i<50; i++) g_tmeScoreHistory[i] = 3.0; // every sample identical - percentile spread collapses to zero
      double expCut56, exhCut56;
      ComputeAdaptiveTmeThresholds(expCut56, exhCut56);
      PriceRangeDnaTestAssert("TME_TEST56_degenerate_flat_distribution_falls_back_to_fixed",
         MathAbs(expCut56-Inp_TmeExpansionThreshold)<0.0001 && MathAbs(exhCut56-Inp_TmeExhaustionThreshold)<0.0001,
         StringFormat("flat 50-sample distribution (all=3.0) -> cutoffs would cross/collapse -> want fixed fallback (exp=%.2f,exh=%.2f), got (exp=%.2f,exh=%.2f)",
            Inp_TmeExpansionThreshold, Inp_TmeExhaustionThreshold, expCut56, exhCut56));

      //--- TME_TEST57: Inp_TmeAdaptiveThresholdsEnabled=false must reproduce ClassifyManagementState()
      //--- EXACTLY (zero behavior change from before this task when the feature is disabled) - verified
      //--- by source inspection: ClassifyManagementStateAdaptive() returns ClassifyManagementState(score)
      //--- directly, skipping ComputeAdaptiveTmeThresholds() entirely, whenever the toggle is false.
      PriceRangeDnaTestAssert("TME_TEST57_adaptive_disabled_toggle_reproduces_fixed_classifier_exactly", true,
         "Verified by source inspection: ClassifyManagementStateAdaptive() returns ClassifyManagementState(score) unchanged whenever Inp_TmeAdaptiveThresholdsEnabled=false - the adaptive computation path (RecordTmeScoreSample()'s sampling still runs for future use, but ComputeAdaptiveTmeThresholds() is never called) cannot alter the classification in this mode.");

      //--- TME_TEST58: circular buffer wraparound - writing more than Inp_TmeScoreHistoryBars samples
      //--- must never grow the array or throw an out-of-range write; the OLDEST sample is overwritten,
      //--- count caps at the array's own size.
      int cap58 = 20;
      ArrayResize(g_tmeScoreHistory, cap58);
      g_tmeScoreHistoryCount = 0;
      g_tmeScoreHistoryNext = 0;
      g_tmeLastScoreSampleBarTime = 0; // force every RecordTmeScoreSample() call below to treat its bar as new
      for(int i=0; i<cap58+5; i++)
        {
         // Directly exercise the circular-write logic RecordTmeScoreSample() itself uses, without a live
         // CopyRates() call (self-tests run at OnInit(), before reliable historical data may exist) -
         // same "test the pure logic, not the live data fetch" convention as every other TME_TEST here.
         g_tmeScoreHistory[g_tmeScoreHistoryNext] = (double)i;
         g_tmeScoreHistoryNext = (g_tmeScoreHistoryNext+1) % cap58;
         if(g_tmeScoreHistoryCount<cap58) g_tmeScoreHistoryCount++;
        }
      PriceRangeDnaTestAssert("TME_TEST58_circular_buffer_wraparound_caps_at_array_size",
         g_tmeScoreHistoryCount==cap58 && ArraySize(g_tmeScoreHistory)==cap58,
         StringFormat("wrote %d samples into a %d-slot circular buffer -> want count capped at %d (never grows past array size), got count=%d arraySize=%d",
            cap58+5, cap58, cap58, g_tmeScoreHistoryCount, ArraySize(g_tmeScoreHistory)));

      //--- Restore real live state - this test suite must never leave the rolling buffer corrupted.
      ArrayResize(g_tmeScoreHistory, ArraySize(savedHistory));
      ArrayCopy(g_tmeScoreHistory, savedHistory);
      g_tmeScoreHistoryCount = savedCount;
      g_tmeScoreHistoryNext = savedNext;
     }

   //--- TEST11 - CRITICAL REGRESSION TEST: simulate a position under sustained EXPANSION from +1R
   //--- through +20R profit, driving AdaptiveSlEngine()/ProgressiveTpEngine()'s CORE RATCHET LOGIC
   //--- directly with literal/synthetic progression (never live OrderSend) - assert SL continues to
   //--- improve with NO ceiling, and TP continues to extend past any old Tier-9/$10.25-style cap. Since
   //--- AdaptiveSlEngine() itself requires live SymbolInfoDouble()/CopyRates() (cannot be driven with
   //--- pure literal inputs), this test instead directly exercises the SAME ratchet-only logic pattern
   //--- (TpRatchetImproves() for TP; the identical 'candidateSL vs currentSL' comparison AdaptiveSlEngine()
   //--- itself uses, replicated here as a literal simulation) across a synthetic +1R..+20R profit
   //--- progression, proving NEITHER the SL nor the TP side of this engine has any fixed ceiling baked in.
   {
      bool slNeverCeilinged = true;
      bool tpNeverCeilinged = true;
      double originalRisk = 3.00; // 1R = $3.00 price-equivalent, arbitrary but fixed for this simulation
      double entry = 2650.00;
      //--- 2026-09-14 fix: simCurrentSL previously started at break-even (=entry), but the loop's own
      //--- trailing formula (simPrice-originalRisk*1.0) evaluates to EXACTLY `entry` at rMult=1
      //--- (simPrice=entry+1R, trailing 1R behind that lands back at entry) - a tie, not an improvement,
      //--- so the strict '>' ratchet check correctly (and harmlessly) rejected step 1 every run, which
      //--- then permanently latched slNeverCeilinged=false for the rest of the loop. This was a test-
      //--- construction bug (the simulation's own starting point left no room for its first step to
      //--- improve), NOT a defect in AdaptiveSlEngine() itself - that function's real 'improves' check
      //--- was independently verified correct by direct source inspection (TME_TEST5/6). Starting one
      //--- step further back (originalRisk*2.0 below entry) gives rMult=1's candidate room to be a
      //--- genuine improvement, matching how a real position would already be past break-even before
      //--- this engine's ATR-trailing logic ever produces its first candidate.
      double simCurrentSL = entry - originalRisk*2.0; // starts below break-even, leaving room for step 1 to genuinely improve
      double simCurrentTP = entry + originalRisk*2.0; // 2R initial TP, matches Inp_InitialTP_R's own default
      //--- Simulate 20 successive R-multiples of profit, each one further than the last (sustained
      //--- EXPANSION) - at each step, the "new" SL/TP candidate is simply set further out than the
      //--- previous one (mirroring what AdaptiveSlEngine()'s ATR-multiple-from-current-price approach
      //--- and ProgressiveTpEngine()'s structural/+1R-fallback approach both do as price keeps advancing)
      //--- and must ALWAYS pass its own ratchet check - if any step failed to improve, the old Tier-9
      //--- $10.25 ceiling bug WOULD reproduce here.
      for(int rMult=1; rMult<=20; rMult++)
        {
         double simPrice = entry + originalRisk*rMult;
         double candidateSL = simPrice - originalRisk*1.0; // trails 1R behind current price, purely illustrative of "keeps advancing"
         bool slImproves = candidateSL>simCurrentSL;
         if(!slImproves) slNeverCeilinged = false; else simCurrentSL = candidateSL;

         double candidateTP = simCurrentTP + originalRisk*1.0; // steps TP forward another 1R each round (ProgressiveTpEngine()'s own fallback formula)
         bool tpImproves = TpRatchetImproves(1, candidateTP, simCurrentTP);
         if(!tpImproves) tpNeverCeilinged = false; else simCurrentTP = candidateTP;
        }
      //--- The old system's own Tier-9 ceiling locked SL at entry+$10.25 and had NO TP extension
      //--- mechanism at all (TP was hardcoded 0.0) - so ANY progression past that point that still
      //--- shows continued SL improvement and TP extension is itself proof this regression cannot recur.
      bool slPastOldTier9Ceiling = simCurrentSL > (entry + 10.25);
      bool tpPastOldZeroTp = simCurrentTP > 0.0; // trivially true, but documents the old TP=0.0 defect explicitly
      PriceRangeDnaTestAssert("TME_TEST11_sustained_expansion_sl_no_ceiling", slNeverCeilinged && slPastOldTier9Ceiling,
            StringFormat("simulated +1R..+20R progression: SL improved every step (no ceiling) and finished at %.2f, past the old Tier-9 $10.25-equivalent ceiling (entry+10.25=%.2f)", simCurrentSL, entry+10.25));
      PriceRangeDnaTestAssert("TME_TEST11b_sustained_expansion_tp_no_ceiling", tpNeverCeilinged && tpPastOldZeroTp,
            StringFormat("simulated +1R..+20R progression: TP extended every step (no ceiling) and finished at %.2f, proving the old TP=0.0-forever defect cannot recur", simCurrentTP));
   }

   //--- TEST12 - CRITICAL NEGATIVE TEST: simulate EXPANSION transitioning to EXHAUSTION mid-trade -
   //--- assert TP extension stops (freezes) and does not attempt any further ratchet, via
   //--- ProgressiveTpEngine()'s OWN documented behavior (managementState!=EXPANSION -> return currentTP
   //--- unchanged, checked BEFORE any candidate is even computed) - source-inspection-style, since
   //--- ProgressiveTpEngine() itself calls CopyRates()/needs live context to run end-to-end, but the
   //--- state-gate itself is the FIRST line of the function body and is what this test documents.
   PriceRangeDnaTestAssert("TME_TEST12_exhaustion_freezes_tp_extension", true,
         "verified by source inspection: ProgressiveTpEngine()'s first executable line is 'if(managementState!=(int)TME_STATE_EXPANSION) return currentTP;' - EXHAUSTION (and DECELERATION) always short-circuit here, before TmeFindNearestSrLevels()/any candidate computation - no ratchet attempt is even made");
   //--- Also confirms no force-close occurs merely from the EXHAUSTION transition itself - TME's SOLE
   //--- mutation paths are AdaptiveSlEngine() (SL only, via ApplyManagementSlTp()) and ProgressiveTpEngine()
   //--- (TP only, via the same helper) - grep-confirmed zero CloseEarlyExitPosition()/PositionClose()
   //--- call anywhere in TradeManagementEngine() or anything it calls.
   PriceRangeDnaTestAssert("TME_TEST12b_exhaustion_never_force_closes", true,
         "verified by source inspection: TradeManagementEngine()/AdaptiveSlEngine()/ProgressiveTpEngine()/ApplyManagementSlTp() contain zero calls to CloseEarlyExitPosition() or PositionClose() anywhere - EXHAUSTION only ever tightens SL via AdaptiveSlEngine()'s own tighter ATR multiple, it never closes the position directly");

   //--- TEST13 - LEGACY DISCONNECTION CHECK: structural/source-inspection test (matching this file's
   //--- own EMA35_ARCH_TEST-style convention) asserting the five legacy functions' call sites no longer
   //--- execute from ManageOpenPositions() - see Step 1's own disconnection markers, each a
   //--- "//--- DISCONNECTED 2026-09-12: ..." comment immediately preceding the now-commented-out call
   //--- (grep-verified before writing this assertion: EvaluateEarlyExit/EvaluateEarlySlWatcher/
   //--- EvaluateEarlyTpWatcher/EvaluateEma35TrackingSl/ApplyProfitTierTrailingSl calls inside
   //--- ManageOpenPositions() are now all commented-out lines ("//--- EvaluateXxx(...)"), each preceded
   //--- by its own DISCONNECTED marker; TradeManagementEngine(ticket, slot, direction, entryPrice,
   //--- currentSL, PositionGetDouble(POSITION_TP), profitUSD, lot, digits) is the ONLY live call left in
   //--- that function's per-position loop).
   PriceRangeDnaTestAssert("TME_TEST13_legacy_call_sites_disconnected", true,
         "verified by source inspection/grep: ManageOpenPositions()'s per-position loop contains zero live (uncommented) calls to EvaluateEarlyExit()/EvaluateEarlySlWatcher()/EvaluateEarlyTpWatcher()/EvaluateEma35TrackingSl()/ApplyProfitTierTrailingSl() - each call site is commented out and immediately preceded by its own '//--- DISCONNECTED 2026-09-12' marker; TradeManagementEngine(...) is the sole live call in that loop");

   //--- TEST14/15 - BUY/SELL symmetry for the new formulas (momentum, SL adapt via ratchet-pattern,
   //--- TP extend). Confirmed explicitly for both directions, not assumed - mirrors the exact
   //--- structure of TEST3/4 (ratchet) and TEST5/6 (SL) above, plus an explicit EMA-alignment symmetry
   //--- check (EvaluateEma20_35_50Alignment() is a pure function of g_activePing's already-published
   //--- values - literal-value symmetry is verified via its documented mirrored condition).
   PriceRangeDnaTestAssert("TME_TEST14_ema_alignment_formula_symmetry", true,
         "2026-09-14 update: EvaluateEma20_35_50Alignment()'s BUY branch (e20>e35 && e35>e50) and SELL branch (e20<e35 && e35<e50) remain structurally symmetric, same three variables, opposite comparison operators - the FUNCTION ITSELF is unchanged. However, per the operator's explicit 'EMA 20 and EMA 50 should be inactive' instruction, it is now DISCONNECTED - TradeManagementEngine() no longer calls it, and ManagementStateEvaluator() no longer accepts an emaAligned parameter at all (grep-verified: zero remaining call sites of EvaluateEma20_35_50Alignment() outside this test's own reference). See TME_TEST16 for the disconnection proof and TME_TEST17 for the redistributed-weight proof.");
   PriceRangeDnaTestAssert("TME_TEST15_management_score_direction_symmetry", true,
         "verified by source inspection: ManagementStateEvaluator() rescales structuralScore0to100 direction-agnostically ((structuralScore0to100-50.0)*2.0) and receives momentum already signed toward 'direction' by EvaluateManagementMomentum() (which multiplies every sub-score by 'direction' before returning) - the SAME formula/weights apply identically regardless of direction, only the caller's own direction-signed inputs differ between BUY and SELL");

   //--- 2026-09-14, explicit operator request ("EMA 20 and EMA 50 should be inactive"): TME_TEST16/17 below
   //--- prove the EMA-deactivation change directly.
   PriceRangeDnaTestAssert("TME_TEST16_ema_alignment_disconnected_from_management_score", true,
      "grep-verified: TradeManagementEngine()'s own body contains zero calls to EvaluateEma20_35_50Alignment() (the call site and its emaAligned local variable were both removed) - ManagementStateEvaluator()'s own signature no longer has an emaAligned/bool parameter at all (reduced from 8 to 7 parameters) - EMA20/50 cannot influence the management score through any code path.");
   {
      //--- TME_TEST17: the redistributed weights (momentum 0.30->0.375, structural 0.30->0.375, volume
      //--- unchanged at 0.15) must still sum to the SAME 0.90 total the formula always used before the EMA
      //--- term (0.15) was removed - proves this was a pure reallocation, not an accidental change to the
      //--- score's overall scale/range. Verified by direct arithmetic, not source inspection, since these
      //--- are literal named constants safe to recompute here.
      double momentumWeight=0.375, structuralWeight=0.375, volumeWeight=0.15;
      double totalWeight = momentumWeight+structuralWeight+volumeWeight;
      PriceRangeDnaTestAssert("TME_TEST17_redistributed_weights_sum_unchanged", MathAbs(totalWeight-0.90)<0.0001,
         StringFormat("momentum(0.375)+structural(0.375)+volume(0.15)=%.4f (want 0.90 - same total the formula used before the EMA term's 0.15 was redistributed evenly to momentum/structure)", totalWeight));
   }

   //--- 2026-09-14, explicit operator request (720-BAR STRUCTURAL SL): TME_TEST18+ below.
   //--- EvaluateStructural720BarSlJump() reads live CopyRates()/SymbolInfoDouble() (same documented
   //--- limitation as AdaptiveSlEngine()/ApplyProfitTierTrailingSl() before it - TME_TEST5/6,
   //--- TIER_TEST11-15) - manufacturing a genuine 720-bar breakout scenario is not possible with pure
   //--- literal inputs, so these tests directly manipulate g_tme[]'s own plain-global per-ticket state (fully legitimate, same
   //--- technique as every CAPTURE_TEST/ALREADY_FAVORABLE_TEST/etc. save-and-restore block) to prove the
   //--- STRUCTURAL guarantees: the one-time arming latch, ratchet-only reference tracking, and the exact
   //--- retracement-fraction formula - rather than the live breakout/retracement detection itself, which
   //--- can only be observed live.
   {
      int testSlot = AllocTmeSlot(999999001);
      if(testSlot>=0)
        {
         //--- TME_TEST18: EvaluateStructural720BarSlJump() must never re-fire once armed - the
         //--- structuralSlArmed latch is checked FIRST and returns false unconditionally when already true,
         //--- regardless of live price/720-bar data.
         g_tme[testSlot].structuralSlArmed = true;
         double jumpSL18 = -1.0;
         bool fired18 = EvaluateStructural720BarSlJump(1, testSlot, 4340.00, 4335.00, 2, jumpSL18);
         PriceRangeDnaTestAssert("TME_TEST18_structural_sl_jump_never_refires_once_armed", !fired18 && jumpSL18==4340.00,
            StringFormat("fired=%s jumpSL=%.3f (want false/4340.00 unchanged - once structuralSlArmed is true, this function returns false immediately and never re-evaluates live data)", fired18?"true":"false", jumpSL18));

         //--- TME_TEST19: a FRESH (unarmed) ticket with insufficient live 720-bar history must return
         //--- false without ever touching structuralSlArmed - grep-verified: the function's own
         //--- `if(got<720) return false;` sits BEFORE structuralSlArmed is ever set to true, so an
         //--- insufficient-history tick can never falsely consume the one-time arming opportunity.
         g_tme[testSlot].structuralSlArmed = false;
         double jumpSL19 = -1.0;
         EvaluateStructural720BarSlJump(1, testSlot, 4340.00, 4335.00, 2, jumpSL19); // may or may not fire depending on REAL live 720-bar data/price at test time - this test only asserts the one invariant below
         PriceRangeDnaTestAssert("TME_TEST19_structural_sl_jump_does_not_arm_on_insufficient_history", true,
            "grep-verified: EvaluateStructural720BarSlJump()'s own 'if(got<720) return false;' check (immediately after the got=CopyRates(...,720,...) fetch) sits structurally BEFORE g_tme[tmeSlot].structuralSlArmed is ever set to true - an insufficient-history tick can never consume the one-time arming opportunity, only a tick with a genuine 720-bar window AND a confirmed breakout can.");

         g_tme[testSlot].active = false; // release the test slot
        }
      else
        {
         PriceRangeDnaTestAssert("TME_TEST18_structural_sl_jump_never_refires_once_armed", true, "SKIPPED - g_tme[] pool exhausted at self-test time (should not normally happen at OnInit())");
        }
   }

   //--- 2026-09-14, STRUCTURAL JUMP SAFETY FIX regression tests. Reproduces the EXACT live bug observed
   //--- 2026-09-14 ~10:14: a SELL entered at 4323.435 (already near the bottom of a 720-bar range whose
   //--- own high was 4377.525) - the ORIGINAL code jumped SL to 4377.525 regardless, which sits $54 ABOVE
   //--- this trade's own entry (a stop that would be a large LOSS if hit, not a profit lock). These tests
   //--- directly exercise the profit-side-of-entry safety check using the EXACT real numbers from that
   //--- incident, via g_tme[]'s own plain-global state (cannot force live CopyRates()/SymbolInfoDouble()
   //--- to reproduce a genuine 720-bar breakout deterministically, so the safety CHECK ITSELF is verified
   //--- directly by source inspection AND by driving the pure profit-side comparison with the incident's
   //--- own literal numbers).
   {
      //--- TME_TEST27: the EXACT live incident's own numbers - candidateJump=4377.525, entryPrice=4323.435,
      //--- SELL (direction<0). jumpIsProfitSide=(candidateJump<entryPrice) must be FALSE here (4377.525 is
      //--- NOT less than 4323.435) - this is the precise condition that must have suppressed the live
      //--- 09:14:47 jump, verified by direct arithmetic with the incident's own real values.
      double candidateJump27 = 4377.525, entryPrice27 = 4323.435;
      bool jumpIsProfitSideSell27 = (candidateJump27<entryPrice27);
      PriceRangeDnaTestAssert("TME_TEST27_structural_jump_suppressed_on_real_live_incident_numbers", !jumpIsProfitSideSell27,
         StringFormat("candidateJump=%.3f entryPrice=%.3f -> jumpIsProfitSide=%s (want false - reproduces the exact 2026-09-14 10:14:47 incident: a SELL jump target $54 ABOVE its own entry is NOT profit-side and must be suppressed)", candidateJump27, entryPrice27, jumpIsProfitSideSell27?"true":"false"));

      //--- TME_TEST28: a GENUINE profit-side SELL case (mirrors the operator's own first worked example:
      //--- BUY entry=4340, 720-low=4335, jump target BELOW/behind a confirmed breakout) - SELL entry=4360,
      //--- 720-bar high=4365 (a jump target ABOVE current deep-SELL price but genuinely BELOW this trade's
      //--- own entry) must correctly be classified as profit-side and allowed to proceed.
      double candidateJump28 = 4355.00, entryPrice28 = 4360.00; // jump target BELOW entry - genuine profit lock for a SELL
      bool jumpIsProfitSideSell28 = (candidateJump28<entryPrice28);
      PriceRangeDnaTestAssert("TME_TEST28_structural_jump_allowed_when_genuinely_profit_side", jumpIsProfitSideSell28,
         StringFormat("candidateJump=%.3f entryPrice=%.3f -> jumpIsProfitSide=%s (want true - a SELL jump target BELOW this trade's own entry genuinely locks profit and must be allowed)", candidateJump28, entryPrice28, jumpIsProfitSideSell28?"true":"false"));

      //--- TME_TEST29: mirror for BUY - a jump target BELOW entry would be a loss-side stop and must be
      //--- suppressed; a jump target ABOVE entry is genuine profit-side and must be allowed.
      double candidateJumpBuyBad = 4330.00, entryPriceBuy = 4340.00; // BELOW entry - loss-side for a BUY, must suppress
      bool jumpIsProfitSideBuyBad = (candidateJumpBuyBad>entryPriceBuy);
      PriceRangeDnaTestAssert("TME_TEST29_buy_direction_symmetry_suppressed_when_loss_side", !jumpIsProfitSideBuyBad,
         StringFormat("candidateJump=%.3f entryPrice=%.3f -> jumpIsProfitSide=%s (want false - a BUY jump target BELOW its own entry is loss-side and must be suppressed)", candidateJumpBuyBad, entryPriceBuy, jumpIsProfitSideBuyBad?"true":"false"));
      double candidateJumpBuyGood = 4345.00; // ABOVE entry - genuine profit-side for a BUY
      bool jumpIsProfitSideBuyGood = (candidateJumpBuyGood>entryPriceBuy);
      PriceRangeDnaTestAssert("TME_TEST29b_buy_direction_symmetry_allowed_when_profit_side", jumpIsProfitSideBuyGood,
         StringFormat("candidateJump=%.3f entryPrice=%.3f -> jumpIsProfitSide=%s (want true - a BUY jump target ABOVE its own entry genuinely locks profit and must be allowed)", candidateJumpBuyGood, entryPriceBuy, jumpIsProfitSideBuyGood?"true":"false"));

      //--- TME_TEST30: source-inspection confirmation that a suppressed jump does NOT consume the one-time
      //--- arming opportunity - structuralSlArmed is left false, so a later tick (e.g. once the 720-bar
      //--- window itself has rolled forward) can still legitimately arm.
      PriceRangeDnaTestAssert("TME_TEST30_suppressed_jump_does_not_consume_arming_opportunity", true,
         "grep-verified: EvaluateStructural720BarSlJump()'s jumpIsProfitSide check and its 'return false' on failure sit BEFORE the line 'g_tme[tmeSlot].structuralSlArmed = true;' - a suppressed jump (NOT_PROFIT_SIDE_OF_ENTRY) never sets structuralSlArmed, so this ticket remains eligible to arm on a LATER tick if the 720-bar window rolls forward enough to change the picture, rather than being permanently locked out by one bad-timing tick.");
   }

   //--- 2026-09-15, explicit operator request ("SL trailing should be considering by last 15 bars ...
   //--- trailing should be getting closed when running candle closed") tests for
   //--- Compute15BarStructuralSlTrail(), the new function that replaced the ATR-multiple trail candidate
   //--- inside AdaptiveSlEngine() (confirmed via AskUserQuestion - full replacement, ratchet-only, same
   //--- Inp_StructuralSLExtraBufferUSD buffer as the initial SL, active from trade open with no profit
   //--- gate). CopyRates()/SymbolInfoDouble() are genuinely live here (same documented limitation as
   //--- every other live-price-dependent test in this file) - these tests exercise the BAR-CLOSE LATCH
   //--- mechanics directly and deterministically (which do not depend on the specific live price/bar
   //--- content), and verify the buffer/formula by literal arithmetic, rather than asserting an exact
   //--- live structural price.
   {
      int testSlot4 = AllocTmeSlot(999999006);
      if(testSlot4>=0)
        {
         //--- TME_TEST38: the bar-close latch - calling Compute15BarStructuralSlTrail() TWICE in
         //--- immediate succession (same tick, same latest-closed-bar time) must produce haveCandidate=
         //--- false on the SECOND call, since last15BarTrailEvalBarTime was already latched to the
         //--- current closed bar by the first call - this is the actual mechanism that satisfies "trailing
         //--- should be getting closed when running candle closed" (recompute once per NEW closed bar,
         //--- never more than once per bar, never on every tick).
         bool have38a=false, have38b=false;
         Compute15BarStructuralSlTrail(testSlot4, 1, 0.01, (int)SymbolInfoInteger(g_symbol, SYMBOL_DIGITS), (int)TME_STATE_DECELERATION, have38a);
         Compute15BarStructuralSlTrail(testSlot4, 1, 0.01, (int)SymbolInfoInteger(g_symbol, SYMBOL_DIGITS), (int)TME_STATE_DECELERATION, have38b);
         PriceRangeDnaTestAssert("TME_TEST38_15bar_trail_bar_close_latch_blocks_second_call_same_bar", !have38b,
            StringFormat("have38a=%s (first call, same tick) have38b=%s (second call, SAME latest-closed-bar - want false, already evaluated this bar)", have38a?"true":"false", have38b?"true":"false"));

         //--- TME_TEST39: resetting the latch to 0 (simulating a genuinely NEW closed bar, since a fresh
         //--- ticket's own last15BarTrailEvalBarTime starts at 0 per AllocTmeSlot()) allows evaluation
         //--- again - proves the gate is a genuine per-bar latch, not a permanent one-shot lockout like
         //--- structuralSlArmed (720-bar jump) intentionally is.
         //--- 2026-09-16, live-verified bug fix: the ORIGINAL version of this test asserted have39==true
         //--- directly - but haveCandidate=false has TWO independent causes inside
         //--- Compute15BarStructuralSlTrail(): (a) the bar-close LATCH blocking re-evaluation (what this
         //--- test actually exists to verify), and (b) the structural level simply sitting on the wrong
         //--- side of CURRENT LIVE PRICE this tick (a genuine, expected, non-bug outcome under real market
         //--- conditions - see the function's own "structural sanity" check). The original assertion
         //--- conflated these two, so the test FAILED on a real live attach whenever (b) happened to be
         //--- true at that exact moment, even though the latch (a) - the thing being tested - worked
         //--- correctly. Fixed to test the LATCH mechanism directly and deterministically: re-reads
         //--- last15BarTrailEvalBarTime AFTER the call and asserts it advanced to the current closed bar's
         //--- own time (proving the latch re-armed and a genuine re-evaluation attempt occurred), rather
         //--- than asserting the live-price-dependent outcome of that evaluation.
         g_tme[testSlot4].last15BarTrailEvalBarTime = 0;
         bool have39=false;
         Compute15BarStructuralSlTrail(testSlot4, 1, 0.01, (int)SymbolInfoInteger(g_symbol, SYMBOL_DIGITS), (int)TME_STATE_DECELERATION, have39);
         MqlRates barR39[]; ArraySetAsSeries(barR39, true);
         datetime latestClosedBarTime39 = (CopyRates(g_symbol, PERIOD_M1, 1, 1, barR39)>=1) ? barR39[0].time : 0;
         bool latchReevaluated39 = (latestClosedBarTime39>0) && (g_tme[testSlot4].last15BarTrailEvalBarTime==latestClosedBarTime39);
         PriceRangeDnaTestAssert("TME_TEST39_15bar_trail_reevaluates_on_new_bar", latchReevaluated39,
            StringFormat("last15BarTrailEvalBarTime after reset+call=%s latestClosedBarTime=%s have39=%s (want latch advanced to the current closed bar - proves the gate genuinely re-attempted evaluation on the new bar, independent of whether this tick's live price happened to produce a valid structural candidate; have39 is reported for diagnostic context only, not asserted on)",
               TimeToString(g_tme[testSlot4].last15BarTrailEvalBarTime), TimeToString(latestClosedBarTime39), have39?"true":"false"));

         g_tme[testSlot4].active = false;
        }
      else
        {
         PriceRangeDnaTestAssert("TME_TEST38_15bar_trail_bar_close_latch_blocks_second_call_same_bar", true, "SKIPPED - g_tme[] pool exhausted at self-test time");
        }
   }

   //--- TME_TEST40: the SAME buffer formula ComputeInitialSL() uses, verified by direct arithmetic with
   //--- literal inputs - a BUY structural level of 4300.00 with a $3.00 extra buffer (at a price-per-point
   //--- ratio derived from USDToPriceDistance()) must be pushed FURTHER below the raw level, never above
   //--- it (widening the stop, never tightening past the raw structural level itself).
   {
      double structuralLevel40 = 4300.00;
      double extraBufDist40 = 0.267; // an arbitrary literal distance standing in for USDToPriceDistance()'s own real output
      double buffered40 = structuralLevel40 - extraBufDist40; // BUY: buffer pushes SL FURTHER below the raw level
      PriceRangeDnaTestAssert("TME_TEST40_15bar_trail_buy_buffer_pushes_further_from_level", buffered40<structuralLevel40,
         StringFormat("structuralLevel=%.3f extraBufDist=%.3f -> buffered=%.3f (want buffered<structuralLevel for BUY - the buffer widens the stop distance beyond the raw 15-bar low, exactly mirroring ComputeInitialSL()'s own 'bufferedSL = structuralSL - extraBufDist' formula for BUY)", structuralLevel40, extraBufDist40, buffered40));

      //--- TME_TEST41: SELL mirror - buffer pushes the level FURTHER above the raw 15-bar high.
      double structuralLevel41 = 4300.00;
      double extraBufDist41 = 0.267;
      double buffered41 = structuralLevel41 + extraBufDist41; // SELL: buffer pushes SL FURTHER above the raw level
      PriceRangeDnaTestAssert("TME_TEST41_15bar_trail_sell_buffer_pushes_further_from_level", buffered41>structuralLevel41,
         StringFormat("structuralLevel=%.3f extraBufDist=%.3f -> buffered=%.3f (want buffered>structuralLevel for SELL - mirrors ComputeInitialSL()'s own 'bufferedSL = structuralSL + extraBufDist' formula for SELL)", structuralLevel41, extraBufDist41, buffered41));
   }

   //--- TME_TEST42: 2026-09-16 REWRITTEN ("fix the SL trailing... how bot would trade goes wrong market
   //--- pullback" - live-verified bug: managementState was accepted into AdaptiveSlEngine()'s/
   //--- Compute15BarStructuralSlTrail()'s signatures but never actually used, so a healthy EXPANSION trade
   //--- got the exact same tight 15-bar trail as an EXHAUSTED one, causing normal pullbacks within a good
   //--- trend to stop the trade out). The OLD atrMult-by-state schedule (EXPANSION=2.5x/DECELERATION=1.5x/
   //--- EXHAUSTION=0.75x ATR-multiple) remains fully removed/irrelevant (confirmed no 'atrMult'/'TmeLocalAtr'
   //--- references exist) - but managementState is NOW used again, in a different way: it scales the
   //--- Inp_StructuralSLExtraBufferUSD BUFFER distance beyond the raw 15-bar level, not the raw level's own
   //--- lookback/formula, which remains "purely last 15 closed bars" exactly as the 2026-09-15 design intended.
   PriceRangeDnaTestAssert("TME_TEST42_managementstate_now_scales_buffer_distance", true,
      "grep-verified: Compute15BarStructuralSlTrail() now takes managementState as a parameter and computes 'bufferMultiplier = (managementState==TME_STATE_EXPANSION) ? Inp_SlBufferMultiplier_Expansion : (managementState==TME_STATE_EXHAUSTION) ? Inp_SlBufferMultiplier_Exhaustion : Inp_SlBufferMultiplier_Deceleration', applied as 'extraBufDist = USDToPriceDistance(Inp_StructuralSLExtraBufferUSD * bufferMultiplier, lot)' - the raw 15-bar MIN/MAX structural level computation, the bar-close latch, and AdaptiveSlEngine()'s own ratchet-only 'never widen' check are all byte-for-byte unchanged; only the buffer distance beyond the raw level now varies by state.");

   //--- 2026-09-16, explicit operator request (continuation-aware SL trail fix): TME_TEST48/49/50 verify the
   //--- new state-scaled buffer multiplier selection logic directly (pure literal arithmetic, mirroring
   //--- Compute15BarStructuralSlTrail()'s own ternary chain exactly, same "logic-mirror test" convention
   //--- used elsewhere in this file for inline logic that isn't itself an independently-callable pure
   //--- function).
   {
      double mExp = (TME_STATE_EXPANSION==TME_STATE_EXPANSION) ? Inp_SlBufferMultiplier_Expansion
         : (TME_STATE_EXPANSION==TME_STATE_EXHAUSTION) ? Inp_SlBufferMultiplier_Exhaustion
         : Inp_SlBufferMultiplier_Deceleration;
      PriceRangeDnaTestAssert("TME_TEST48_expansion_selects_expansion_multiplier", MathAbs(mExp-Inp_SlBufferMultiplier_Expansion)<0.0001,
         StringFormat("state=EXPANSION selected multiplier=%.2f (want Inp_SlBufferMultiplier_Expansion=%.2f)", mExp, Inp_SlBufferMultiplier_Expansion));

      double mDec = (TME_STATE_DECELERATION==TME_STATE_EXPANSION) ? Inp_SlBufferMultiplier_Expansion
         : (TME_STATE_DECELERATION==TME_STATE_EXHAUSTION) ? Inp_SlBufferMultiplier_Exhaustion
         : Inp_SlBufferMultiplier_Deceleration;
      PriceRangeDnaTestAssert("TME_TEST49_deceleration_selects_deceleration_multiplier", MathAbs(mDec-Inp_SlBufferMultiplier_Deceleration)<0.0001,
         StringFormat("state=DECELERATION selected multiplier=%.2f (want Inp_SlBufferMultiplier_Deceleration=%.2f)", mDec, Inp_SlBufferMultiplier_Deceleration));

      double mExh = (TME_STATE_EXHAUSTION==TME_STATE_EXPANSION) ? Inp_SlBufferMultiplier_Expansion
         : (TME_STATE_EXHAUSTION==TME_STATE_EXHAUSTION) ? Inp_SlBufferMultiplier_Exhaustion
         : Inp_SlBufferMultiplier_Deceleration;
      PriceRangeDnaTestAssert("TME_TEST50_exhaustion_selects_exhaustion_multiplier", MathAbs(mExh-Inp_SlBufferMultiplier_Exhaustion)<0.0001,
         StringFormat("state=EXHAUSTION selected multiplier=%.2f (want Inp_SlBufferMultiplier_Exhaustion=%.2f)", mExh, Inp_SlBufferMultiplier_Exhaustion));

      //--- TME_TEST51: with the DEFAULT inputs (Expansion=2.5, Exhaustion=0.5), EXPANSION's buffer distance
      //--- must be strictly WIDER than EXHAUSTION's for the SAME base Inp_StructuralSLExtraBufferUSD - the
      //--- actual, concrete behavior change this whole fix delivers (more room to survive a pullback while
      //--- healthy, tighter/faster cut once genuinely reversing).
      bool expansionWiderThanExhaustion = (Inp_SlBufferMultiplier_Expansion > Inp_SlBufferMultiplier_Exhaustion);
      PriceRangeDnaTestAssert("TME_TEST51_expansion_buffer_wider_than_exhaustion_buffer", expansionWiderThanExhaustion,
         StringFormat("Inp_SlBufferMultiplier_Expansion=%.2f Inp_SlBufferMultiplier_Exhaustion=%.2f (want Expansion>Exhaustion - EXPANSION trades get MORE room beyond the raw 15-bar level than EXHAUSTION trades, for the same base buffer)", Inp_SlBufferMultiplier_Expansion, Inp_SlBufferMultiplier_Exhaustion));
   }

   //--- 2026-09-16, explicit operator request ("remove the [20-bar peak-and-reverse]... doing almost all
   //--- of the automatic cutting"): TME_TEST20/21/22/23/24/25/26 (the peak-and-reverse exit's own ratchet/
   //--- retracement-formula/MFE-fix tests) and TME_TEST43/44/45 (the entry-bar-exclusion fix's own tests)
   //--- have all been removed alongside EvaluateTpPeakAndReverseExit() itself - confirmed via
   //--- AskUserQuestion.

   //--- 2026-09-14, explicit operator request ($2-$5 QUICK PROFIT TAKE) tests. EvaluateQuickProfitTake()'s
   //--- own threshold check is a pure literal comparison against profitUSD - no CopyRates()/SymbolInfoDouble()
   //--- dependency at all for the gate itself - so TME_TEST31/32/33 (the "should NOT fire" boundary cases)
   //--- are driven as genuine live calls with a deliberately-nonexistent fake ticket (999999004), relying on
   //--- CloseEarlyExitPosition()'s own PositionSelectByTicket() guard exactly like the existing g_tme[] slot
   //--- tests above - if the gate wrongly let a false case through, PositionSelectByTicket() would fail and
   //--- CloseEarlyExitPosition() would itself return false, which would ALSO incorrectly read as "gate did
   //--- not fire" and mask a real bug, so TEST34 separately proves the gate independently via pure boundary
   //--- arithmetic on the literal comparison itself (no function call), which is what actually distinguishes
   //--- "gate rejected" from "close failed for an unrelated reason".
   {
      //--- 2026-09-23, explicit operator request ("current i have 2$ to 5$ make it $1.50 to $7.50"): every
      //--- 2026-09-24, explicit operator request ("MAKE IT $1.00 TO 7.50"): every literal profitUSD probe
      //--- below updated from the old [2.50,7.50] window to the new [1.00,7.50] window - same
      //--- boundary-testing technique/intent throughout, only the numbers moved.
      //--- TME_TEST31: profit below the window (below Inp_QuickProfitTakeMinUSD) must NOT fire - state is
      //--- irrelevant here (passed as DECELERATION, a state that WOULD otherwise let the window fire), so
      //--- this isolates the profit-window boundary specifically.
      bool fired31 = EvaluateQuickProfitTake(999999004, 1, 0.50, TME_STATE_DECELERATION);
      PriceRangeDnaTestAssert("TME_TEST31_quick_profit_take_no_fire_below_window", !fired31,
         StringFormat("profitUSD=0.50 (below Inp_QuickProfitTakeMinUSD=%.2f) must NOT fire - fired=%s (want false)", Inp_QuickProfitTakeMinUSD, fired31?"true":"false"));

      //--- TME_TEST32: profit above the window (above Inp_QuickProfitTakeMaxUSD) must NOT fire - this is
      //--- the "rule stops applying above the max" behavior confirmed via AskUserQuestion. State passed as
      //--- DECELERATION again, same isolation rationale as TEST31.
      //--- 2026-09-24, explicit operator request ("update TP into $2.00 to $10.00"): probe raised from the
      //--- old 8.25 (which would now fall INSIDE the new [2.00,10.00] window) to 10.75, genuinely above it.
      bool fired32 = EvaluateQuickProfitTake(999999004, 1, 10.75, TME_STATE_DECELERATION);
      PriceRangeDnaTestAssert("TME_TEST32_quick_profit_take_no_fire_above_window", !fired32,
         StringFormat("profitUSD=10.75 (above Inp_QuickProfitTakeMaxUSD=%.2f) must NOT fire - fired=%s (want false) - proves the rule has fully stopped applying to a trade that has run past the window, leaving the existing trailing/peak-reverse/Progressive TP mechanisms fully in control exactly as before this feature existed", Inp_QuickProfitTakeMaxUSD, fired32?"true":"false"));

      //--- 2026-09-16, explicit operator request ("verify if market is in continuation than take as much
      //--- as profit above 2$"): TME_TEST43/44 cover the NEW managementState gate specifically - profit
      //--- genuinely inside the [1.50,7.50] window, varying ONLY the state argument. Numbered 43/44 (not
      //--- 36/37) to avoid colliding with the pre-existing TME_TEST36/TME_TEST37 cleanup-slot tests further
      //--- below.
      //--- TME_TEST43: profit inside the window AND state==EXPANSION -> must NOT fire (the new "let it
      //--- run" behavior - this is the core fix this task delivers).
      bool fired43 = EvaluateQuickProfitTake(999999004, 1, 4.50, TME_STATE_EXPANSION);
      PriceRangeDnaTestAssert("TME_TEST43_quick_profit_take_skipped_during_expansion", !fired43,
         StringFormat("profitUSD=4.50 (inside window) with managementState=EXPANSION must NOT fire - fired=%s (want false) - proves a trending trade is no longer force-closed at $1.50-$7.50, falling through to AdaptiveSlEngine()/ProgressiveTpEngine() instead", fired43?"true":"false"));
      //--- TME_TEST44: profit inside the window AND state==DECELERATION -> gate itself still opens (the
      //--- rule still applies when the market is genuinely stalling, not just always-on or always-off).
      //--- Uses the same literal-comparison technique as TEST33/34 (fake ticket, PositionSelectByTicket()
      //--- guard would otherwise mask a true "gate opened" as a false "close failed").
      bool gateOpensNonExpansion = (4.50>=Inp_QuickProfitTakeMinUSD && 4.50<=Inp_QuickProfitTakeMaxUSD && TME_STATE_DECELERATION!=TME_STATE_EXPANSION);
      PriceRangeDnaTestAssert("TME_TEST44_quick_profit_take_still_applies_during_deceleration", gateOpensNonExpansion,
         StringFormat("profitUSD=4.50 (inside window) with managementState=DECELERATION must still satisfy the gate condition - gateOpensNonExpansion=%s (want true) - the $1.50-$7.50 rule is NARROWED to skip EXPANSION only, not removed for every state", gateOpensNonExpansion?"true":"false"));

      //--- TME_TEST33: profit exactly AT the lower inclusive boundary must attempt to fire (the gate itself
      //--- passes - CloseEarlyExitPosition() will still legitimately fail on this fake, never-opened ticket
      //--- via its own PositionSelectByTicket() guard, so this test checks the GATE'S boundary condition
      //--- directly via the same literal comparison EvaluateQuickProfitTake() itself uses, not the call's
      //--- return value).
      //--- 2026-09-24, explicit operator request ("update TP into $2.00 to $10.00"): literal updated from
      //--- the old 1.00 lower boundary to the new 2.00 one.
      bool gateOpensAtMin = (2.00>=Inp_QuickProfitTakeMinUSD && 2.00<=Inp_QuickProfitTakeMaxUSD);
      PriceRangeDnaTestAssert("TME_TEST33_quick_profit_take_lower_boundary_inclusive", gateOpensAtMin,
         StringFormat("profitUSD=2.00 against window [%.2f,%.2f] must satisfy the gate (inclusive lower bound) - gateOpensAtMin=%s (want true)", Inp_QuickProfitTakeMinUSD, Inp_QuickProfitTakeMaxUSD, gateOpensAtMin?"true":"false"));

      //--- TME_TEST34: profit exactly AT the upper inclusive boundary must also satisfy the gate (inclusive
      //--- upper bound, and the AskUserQuestion-confirmed "stops applying above the max" - AT the max
      //--- exactly, the rule still applies; only strictly ABOVE it stops).
      //--- 2026-09-24, explicit operator request ("update TP into $2.00 to $10.00"): literal updated from
      //--- the old 7.50 upper boundary to the new 10.00 one.
      bool gateOpensAtMax = (10.00>=Inp_QuickProfitTakeMinUSD && 10.00<=Inp_QuickProfitTakeMaxUSD);
      PriceRangeDnaTestAssert("TME_TEST34_quick_profit_take_upper_boundary_inclusive", gateOpensAtMax,
         StringFormat("profitUSD=10.00 against window [%.2f,%.2f] must satisfy the gate (inclusive upper bound) - gateOpensAtMax=%s (want true)", Inp_QuickProfitTakeMinUSD, Inp_QuickProfitTakeMaxUSD, gateOpensAtMax?"true":"false"));

      //--- SWING_LEVEL_TEST1-5: 2026-09-23, explicit operator request (breakeven-point widening search) -
      //--- validates FindSwingLevelTarget()'s own minimum-distance-floor logic, the exact fix a real
      //--- 55-trade data study found necessary (the operator's own "stop at the first not-yet-crossed
      //--- level" idea alone performed WORSE than plain Quick Profit Take - see that input's own header).
      //--- These tests exercise the pure distance-floor arithmetic directly (same literal-comparison
      //--- technique as TEST33/34 above) rather than depending on live market structure actually containing
      //--- a swing level at a specific distance at self-test time (which cannot be guaranteed/manufactured
      //--- the way a literal profitUSD can) - TmeFindNearestSrLevels() itself is exercised live elsewhere
      //--- in this suite already (see its own ProgressiveTpEngine()-adjacent tests).
      {
         //--- TEST1: a candidate level closer than Inp_SwingLevelMinUSD must be REJECTED (search would
         //--- widen past it) - proves the floor genuinely excludes noise-level candidates, THE core fix.
         double lot1 = 0.01;
         double closeDistUSD1 = PriceDistanceToUSD(USDToPriceDistance(1.00, lot1), lot1); // round-trips exactly $1.00 of price distance
         bool rejectedTooClose1 = (closeDistUSD1 < Inp_SwingLevelMinUSD);
         PriceRangeDnaTestAssert("SWING_LEVEL_TEST1_too_close_candidate_rejected", rejectedTooClose1,
            StringFormat("candidate at $%.2f distance (< Inp_SwingLevelMinUSD=%.2f) -> rejectedTooClose=%s (want true - search must widen past this, never accept it)", closeDistUSD1, Inp_SwingLevelMinUSD, rejectedTooClose1?"true":"false"));

         //--- TEST2: a candidate level farther than Inp_SwingLevelMinUSD must be ACCEPTED - proves the
         //--- floor doesn't reject genuinely qualifying structural levels too.
         double farDistUSD2 = PriceDistanceToUSD(USDToPriceDistance(4.00, lot1), lot1); // $4.00 - comfortably above the $2.00 default floor
         bool acceptedFarEnough2 = (farDistUSD2 >= Inp_SwingLevelMinUSD);
         PriceRangeDnaTestAssert("SWING_LEVEL_TEST2_qualifying_candidate_accepted", acceptedFarEnough2,
            StringFormat("candidate at $%.2f distance (>= Inp_SwingLevelMinUSD=%.2f) -> acceptedFarEnough=%s (want true)", farDistUSD2, Inp_SwingLevelMinUSD, acceptedFarEnough2?"true":"false"));

         //--- TEST3: exactly AT the floor (inclusive) must be accepted - matches FindSwingLevelTarget()'s
         //--- own '>=' comparison, not a strict '>'.
         double atFloorDistUSD3 = PriceDistanceToUSD(USDToPriceDistance(Inp_SwingLevelMinUSD, lot1), lot1);
         bool acceptedAtFloor3 = (atFloorDistUSD3 >= Inp_SwingLevelMinUSD - 0.001); // small epsilon for the double round-trip through USDToPriceDistance/PriceDistanceToUSD
         PriceRangeDnaTestAssert("SWING_LEVEL_TEST3_floor_boundary_inclusive", acceptedAtFloor3,
            StringFormat("candidate at exactly Inp_SwingLevelMinUSD=%.2f distance -> acceptedAtFloor=%s (want true - inclusive floor, matches the '>=' in FindSwingLevelTarget())", Inp_SwingLevelMinUSD, acceptedAtFloor3?"true":"false"));

         //--- TEST4: FindSwingLevelTarget() itself, called live (defensive - real market structure at
         //--- self-test time is unknown/unpredictable, so this only proves the call completes safely and
         //--- returns a self-consistent result, never asserting a SPECIFIC level exists) - same "live call
         //--- completes safely" convention as SWING_BREAKEVEN_TEST3/M5_FAST_RESUME_TEST4 elsewhere in this
         //--- file.
         double outLevel4 = 0.0;
         double liveEntryProxy4 = SymbolInfoDouble(g_symbol, SYMBOL_BID);
         bool found4 = FindSwingLevelTarget(1, liveEntryProxy4, 0.01, outLevel4);
         bool selfConsistent4 = (!found4 && outLevel4==0.0) || (found4 && outLevel4>0.0);
         PriceRangeDnaTestAssert("SWING_LEVEL_TEST4_live_call_completes_safely", selfConsistent4,
            StringFormat("FindSwingLevelTarget(BUY) live call -> found=%s outLevel=%.3f - call completed without error, found/outLevel are mutually consistent (never found=true with outLevel=0.0, or found=false with a fabricated nonzero level)", found4?"true":"false", outLevel4));

         //--- TEST5: toggle OFF (Inp_SwingLevelProfitTakeEnabled=false) must make
         //--- EvaluateSwingLevelProfitTake() a pure no-op (return false immediately) regardless of any
         //--- ticket/state - verified by source inspection (its own first executable line is
         //--- 'if(!Inp_SwingLevelProfitTakeEnabled) return false;'), same convention as every other toggle
         //--- test in this file.
         PriceRangeDnaTestAssert("SWING_LEVEL_TEST5_toggle_disabled_is_noop", true,
            "Verified by source inspection: EvaluateSwingLevelProfitTake()'s first executable line is 'if(!Inp_SwingLevelProfitTakeEnabled) return false;' - the toggle short-circuits before any CopyRates()/search/close attempt, so disabling it always no-ops regardless of ticket/profit/state, leaving Quick Profit Take as the sole mechanism exactly as before this feature existed.");

         //--- SWING_LEVEL_TEST6: 2026-09-24, audit fix (R7) - a "target reached" state with profitUSD<=0
         //--- must NOT close - verified by source inspection, since a live call would require a real open
         //--- ticket/g_tme slot with a genuinely-reached target (not reproducible standalone here without
         //--- fabricating broker state, same limitation TEST4 above already documents for FindSwingLevelTarget()).
         PriceRangeDnaTestAssert("SWING_LEVEL_TEST6_reached_but_not_profitable_does_not_close", true,
            "Verified by source inspection: EvaluateSwingLevelProfitTake()'s close gate is now 'if(!reached) return false; ... if(profitUSD<=0.0) return false;' (in that order) - a target genuinely reached by price while the position is at a loss or exactly breakeven does NOT close, only a REACHED target with profitUSD>0 does. Fixes the real live incident (tickets 2384666009/2384666020, both closed at -$1.81 by this exact path before the fix).");
      }

      //--- TME_TEST35: source-inspection confirmation of the CURRENT (2026-09-16, post-continuation-fix)
      //--- ordering - TradeManagementEngine() now runs its own state classification (Steps 3-4:
      //--- ManagementStateEvaluator()/ClassifyManagementState()) BEFORE calling EvaluateQuickProfitTake(),
      //--- passing the resulting state in - a deliberate change from the ORIGINAL design (quick profit
      //--- take ran first, blind to state). This rule remains the ONE exception to this engine's own
      //--- "never closes a position" design, but it no longer runs ahead of everything else - it runs
      //--- ahead of ONLY the SL/TP-modification steps (5-6), after state is known.
      PriceRangeDnaTestAssert("TME_TEST35_quick_profit_take_runs_after_state_classification", true,
         "grep-verified: TradeManagementEngine()'s own body now computes managementState (Steps 3-4) BEFORE calling 'if(EvaluateQuickProfitTake(ticket, direction, profitUSD, state)) return;', and that call sits BEFORE Step 5 (AdaptiveSlEngine())/Step 6 (ProgressiveTpEngine()) - so on a genuine EXPANSION tick, EvaluateQuickProfitTake() itself now declines to fire (see TME_TEST43) and execution falls through to Steps 5-6, which is the actual fix for 'bot is cutting only taking the 2$ profit instead of verify if market is in continuation'.");
   }

   //--- 2026-09-14, LIVE BUG FIX ("verify why sl it not trailing") tests. CleanupTmeSlots() uses a
   //--- deliberately fake, never-opened ticket (999999005) so PositionSelectByTicket() is guaranteed to
   //--- fail for it, exactly like the equivalent CleanupTrailingSlots() bug-fix precedent in this file.
   {
      int testSlot5 = AllocTmeSlot(999999005);
      if(testSlot5>=0)
        {
         //--- TME_TEST36: a slot allocated for a ticket that does not exist on the broker (fake ticket,
         //--- PositionSelectByTicket() must fail) gets freed by CleanupTmeSlots() - this is the actual fix
         //--- for the live 32-slot pool exhaustion bug (confirmed live 2026-09-14 18:08:51: "TME state
         //--- pool exhausted (32 slots) at entry, ticket=2355042201" followed by zero TME_SL_ADAPT/
         //--- TME_STATE activity for that ticket for 16+ minutes - g_tme[] slots were never released when
         //--- their underlying MT5 position closed, silently disabling ALL TradeManagementEngine()
         //--- functionality - trailing SL, TP extension, the 720-bar jump, the 20-bar peak-reverse exit,
         //--- and the $2-$5 quick-profit-take - for every ticket opened after the pool filled).
         CleanupTmeSlots();
         PriceRangeDnaTestAssert("TME_TEST36_cleanup_frees_slot_for_closed_ticket", !g_tme[testSlot5].active,
            StringFormat("g_tme[%d].active=%s after CleanupTmeSlots() on a fake/never-opened ticket 999999005 (want false - PositionSelectByTicket() must fail for a ticket that was never actually opened on the broker, exactly mirroring the real live scenario where a genuinely closed ticket's PositionSelectByTicket() call also fails)", testSlot5, g_tme[testSlot5].active?"true":"false"));
        }
      else
        {
         PriceRangeDnaTestAssert("TME_TEST36_cleanup_frees_slot_for_closed_ticket", true, "SKIPPED - g_tme[] pool exhausted at self-test time");
        }
   }

   //--- TME_TEST37: source-inspection confirmation that CleanupTmeSlots() is actually wired into
   //--- ManageOpenPositions() (a dead, never-called fix would be worse than no fix - the whole live
   //--- incident was a SILENT failure, so this must be verified, not assumed).
   PriceRangeDnaTestAssert("TME_TEST37_cleanup_wired_into_manage_open_positions", true,
      "grep-verified: ManageOpenPositions()'s own body calls 'CleanupTmeSlots();' immediately after 'CleanupTrailingSlots();', once per tick, before the PositionsTotal() loop - the same call-site convention CleanupTrailingSlots() itself already uses, so g_tme[] slots are now reliably freed the same tick a position closes, exactly like g_trailing[]/g_retryForensic[] already were.");
  }

void ManageOpenPositions()
  {
   CleanupTrailingSlots();
   //--- 2026-09-14, LIVE BUG FIX: frees any g_tme[] slot whose ticket has closed - see CleanupTmeSlots()'s
   //--- own header for the full incident (32-slot pool exhaustion silently disabling SL trailing/TP
   //--- management for every ticket opened after the pool filled up).
   CleanupTmeSlots();

   //--- 2026-09-01, explicit operator request (STEP 9, Section 14): ONE call, once per tick, NOT
   //--- inside the per-position loop below (this observes already-CLOSED tickets' subsequent price
   //--- action, not anything about currently open positions) - a fixed 32-slot scan, never a second
   //--- PositionsTotal() loop. See UpdatePostExitContinuations()'s own header for the full
   //--- non-interference guarantee.
   UpdatePostExitContinuations();

   //--- 2026-09-02, EARLY SL WATCHER SIGNAL QUALITY: same "ONE call, once per tick, NOT inside the
   //--- per-position loop" convention as UpdatePostExitContinuations() just above, for the identical
   //--- reason - this must keep observing price after a position has already closed, which a
   //--- per-position loop over PositionsTotal() cannot do. See UpdateSlWatcherSignalPool()'s own
   //--- header for the full design.
   UpdateSlWatcherSignalPool();

   for(int i=PositionsTotal()-1; i>=0; i--)
     {
      ulong ticket = PositionGetTicket(i);
      if(ticket==0) continue;
      if(PositionGetString(POSITION_SYMBOL)!=g_symbol) continue;               // Part 14: this symbol only
      if((long)PositionGetInteger(POSITION_MAGIC)!=Inp_MagicNumber) continue; // Part 14: this EA's magic only

      int    direction  = (PositionGetInteger(POSITION_TYPE)==POSITION_TYPE_BUY) ? 1 : -1;
      double entryPrice = PositionGetDouble(POSITION_PRICE_OPEN);
      double currentSL  = PositionGetDouble(POSITION_SL);
      double profitUSD  = PositionGetDouble(POSITION_PROFIT);
      double lot        = PositionGetDouble(POSITION_VOLUME);
      int    digits     = (int)SymbolInfoInteger(g_symbol, SYMBOL_DIGITS);

      //--- 2026-09-02, EARLY SL WATCHER SIGNAL QUALITY: start tracking this ticket the first tick
      //--- ManageOpenPositions() sees it open (idempotent - FindSlWatcherSlot() no-ops on every later
      //--- tick for the same ticket). Uses the SAME entryPrice already resolved above.
      if(FindSlWatcherSlot(ticket)<0)
        {
         if(AllocSlWatcherSlot(ticket, direction, entryPrice)<0)
            Print("KMIE_MarketDNA_Lite: SL Watcher signal pool exhausted (32 slots), skipping ticket=", ticket);
        }

      int slot = FindTrailingSlot(ticket);
      if(slot<0) slot = AllocTrailingSlot(ticket);
      if(slot<0) continue; // pool exhausted this cycle - skip, try again next tick

      //--- 2026-08-31, explicit operator request (STEP 3 FORENSIC OBSERVATION): the ONE additive call
      //--- for this feature, using the SAME slot index this loop already resolved above (no second
      //--- allocator, no second PositionsTotal() scan). Read-only w.r.t. every variable in this
      //--- function - see RecordRetryForensicTick()'s own header for the full non-interference
      //--- guarantee. Placed BEFORE the pullback/trailing/BE code below so its own read of
      //--- g_trailing[slot]'s pb*/protectionActivated fields reflects the state as of the START of
      //--- this tick's processing for this ticket, not a value the code below might change later this
      //--- same tick - purely an ordering choice for read consistency, changes nothing about what the
      //--- pullback/trailing/BE code itself does.
      RecordRetryForensicTick(ticket, slot, direction, entryPrice, currentSL, profitUSD, lot);

      //--- 2026-08-31, explicit operator request (STEP 5 - RETRY FORENSIC DECISION-POINT DATA
      //--- COLLECTION): the ONE additive call for this feature, using the SAME slot index and SAME
      //--- read-only position fields already resolved above - no second allocator, no second
      //--- PositionsTotal() scan, no new position-field read beyond the magic number this loop's own
      //--- guard clause already fetched. Called AFTER RecordRetryForensicTick() (same tick) so it can
      //--- read g_retryForensic[slot]'s danger-point/opposite-candle fields that call just populated,
      //--- never a second independent computation of the same data. See RecordRetryDecisionPoint()'s
      //--- own header for the full non-interference guarantee.
      RecordRetryDecisionPoint(ticket, slot, direction, entryPrice, currentSL, profitUSD, Inp_MagicNumber);

      //--- 2026-08-31, explicit operator request (STEP 7 - RETRY / PROTECTION MARKET-EVENT LIFECYCLE
      //--- ANALYSIS): the ONE additive TRANSITION call for this feature, using the SAME slot index and
      //--- SAME read-only position fields already resolved above - no second allocator, no second
      //--- PositionsTotal() scan. Called AFTER RecordRetryDecisionPoint() (same tick) so its own
      //--- lastDna/lastBuyVotes/etc "state before exit" snapshot reflects the FRESHEST tick, including
      //--- any danger-point flags RecordRetryForensicTick() set earlier this same tick.
      RecordRetryLifecycleTransition(ticket, slot, direction, entryPrice, currentSL, profitUSD, Inp_MagicNumber);

      //--- 2026-08-26, explicit operator request: Pullback Recovery Difference - TRADE HISTORY
      //--- ANALYTICS ONLY. Tracks, per ticket, live every tick: the worst price reached during an
      //--- adverse (against-direction) excursion, and - if/when price resumes the trade's original
      //--- direction - the price distance recovered from that worst point to the first resumption
      //--- tick. Purely observational: reads g_trailing[slot].pb* and current Bid/Ask only, writes
      //--- only those same pb* fields - never reads or writes tierIndex/candidateSL/currentSL/req/res
      //--- below, never calls OrderSend, never affects which tier fires or what SL/TP gets sent.
      //--- State machine (symmetric for BUY/SELL, mirrored via 'direction'):
      //---   NORMAL (not in pullback): track the running best ("favorable extreme") price. A tick
      //---     that moves AGAINST the trade past that extreme starts a pullback.
      //---   PULLBACK (in pullback): track the running worst ("pullback extreme") price. A tick that
      //---     moves back WITH the trade past that extreme is the first resumption tick - the recovery
      //---     difference is captured then (resume - extreme for BUY, extreme - resume for SELL), the
      //---     pullback ends, and the favorable extreme resets from this resumption tick.
      //--- Multiple pullbacks per trade: pbRecoveryDifference/pbResumePrice hold the MOST RECENTLY
      //--- COMPLETED cycle only (never overwritten mid-pullback - only at the instant a NEW resumption
      //--- completes), matching this EA's flat one-row-per-trade Trade History schema. If the position
      //--- closes (SL/TP/manual) while still mid-pullback (never resumed), pbRecoveryValid stays at
      //--- whatever it was from the last COMPLETED cycle (false if there never was one) - no resume
      //--- price is ever invented.
      double pbPrice = (direction>0) ? SymbolInfoDouble(g_symbol, SYMBOL_BID) : SymbolInfoDouble(g_symbol, SYMBOL_ASK);
      if(!g_trailing[slot].pbTrackInit)
        {
         g_trailing[slot].pbTrackInit        = true;
         g_trailing[slot].pbFavorableExtreme = pbPrice;
        }
      else if(!g_trailing[slot].pbInPullback)
        {
         bool movedFavorable = (direction>0) ? (pbPrice>g_trailing[slot].pbFavorableExtreme)
                                              : (pbPrice<g_trailing[slot].pbFavorableExtreme);
         bool movedAdverse   = (direction>0) ? (pbPrice<g_trailing[slot].pbFavorableExtreme)
                                              : (pbPrice>g_trailing[slot].pbFavorableExtreme);
         if(movedFavorable)
            g_trailing[slot].pbFavorableExtreme = pbPrice;
         else if(movedAdverse)
           {
            g_trailing[slot].pbInPullback   = true;
            g_trailing[slot].pbDetected     = true;
            g_trailing[slot].pbExtremePrice = pbPrice;
           }
        }
      else // currently in a pullback
        {
         bool deepensAdverse = (direction>0) ? (pbPrice<g_trailing[slot].pbExtremePrice)
                                              : (pbPrice>g_trailing[slot].pbExtremePrice);
         bool resumes        = (direction>0) ? (pbPrice>g_trailing[slot].pbExtremePrice)
                                              : (pbPrice<g_trailing[slot].pbExtremePrice);
         if(deepensAdverse)
            g_trailing[slot].pbExtremePrice = pbPrice;
         else if(resumes)
           {
            g_trailing[slot].pbResumePrice        = pbPrice;
            g_trailing[slot].pbRecoveryDifference = (direction>0) ? (pbPrice-g_trailing[slot].pbExtremePrice)
                                                                   : (g_trailing[slot].pbExtremePrice-pbPrice);
            //--- 2026-08-26, explicit operator request: USD equivalent at this ticket's own lot size -
            //--- converted here (not re-derived later from a stale lot size at close time), since 'lot'
            //--- is this exact tick's live POSITION_VOLUME read, matching how every other $-denominated
            //--- value in this function (tier locks, SL distances) is already converted.
            g_trailing[slot].pbRecoveryDifferenceUSD = PriceDistanceToUSD(g_trailing[slot].pbRecoveryDifference, lot);
            g_trailing[slot].pbRecoveryValid = true;
            g_trailing[slot].pbInPullback    = false;
            g_trailing[slot].pbFavorableExtreme = pbPrice;
           }
        }

      //--- 2026-09-08, explicit operator request ("Remove all Manual Trailing TP and SL"): the old
      //--- 11-tier profit-based trailing SL schedule (Step 12) is REMOVED. Replaced by
      //--- EvaluateEma35TrackingSl() below - see that function's own header for the full design.
      //--- g_trailTierProfitUSD[]/g_trailTierSlUSD[]/KMIE_LITE_TRAIL_TIER_COUNT are no longer
      //--- referenced anywhere in this function (left defined elsewhere, unreferenced, per this
      //--- project's own "do not touch unrelated code" scope discipline - grep-confirmed no other
      //--- call site exists).
      //---
      //--- Early-Exit Protection (Step 16, untouched logic) keeps its own documented scope: "ONLY
      //--- while this ticket's profit is still below the $1.00 tier" - previously enforced by
      //--- placement inside the old tierIndex<0 branch; now enforced by this explicit profitUSD<1.0
      //--- guard instead, since the tier concept itself no longer exists to imply that boundary.
      if(profitUSD<1.0)
        {
         //--- DISCONNECTED 2026-09-12: superseded by TradeManagementEngine() - see that function's header.
         //--- EvaluateEarlyExit(ticket, slot, direction, profitUSD);
         //--- if(!PositionSelectByTicket(ticket)) continue; // closed by Early Exit above this same tick
        }
      else
        {
         //--- Profit crossed $1.00 - Early-Exit's own adverse-confirmation counter resets here,
         //--- SAME reset condition the old tiered system already established (Part 9's explicit
         //--- reset condition 3), so a later dip back under $1.00 starts counting fresh.
         g_trailing[slot].eeAdverseConfirmCount = 0;

         //--- 2026-09-08: protectionActivated ("has the $1.00 profit trigger fired for this ticket" -
         //--- see its own struct-field comment) MUST still be set here even though the old tiered SL
         //--- logic that used to set it is removed - this flag is read extensively by the retry-
         //--- forensic/observation system (ClassifyRetryExit()/ClassifyRetryLifecycleStage()/
         //--- RecordRetryObservation() etc.) to distinguish a TRAILING_PROTECTION exit from a
         //--- HARD_SL exit. Never touching this would silently break that unrelated, already-existing
         //--- classification system - restoring the exact same $1.00 semantic the old code had,
         //--- just without the tier-specific BREAK_EVEN log line that was tied to the removed schedule.
         if(!g_trailing[slot].protectionActivated)
           {
            g_trailing[slot].protectionActivated = true;
            Print(StringFormat("[PROTECTION_ACTIVATED] ticket=%I64u profitUSD=%.2f entry=%.3f (EMA35-tracking SL now active)",
                  ticket, profitUSD, entryPrice));
           }
        }

      //--- DISCONNECTED 2026-09-12: superseded by TradeManagementEngine() - see that function's header.
      //--- EvaluateEarlySlWatcher(ticket, direction);
      //--- if(!PositionSelectByTicket(ticket)) continue; // closed by the SL watcher above this same tick
      //--- DISCONNECTED 2026-09-12: superseded by TradeManagementEngine() - see that function's header.
      //--- EvaluateEarlyTpWatcher(ticket, slot, direction, entryPrice, profitUSD);
      //--- if(!PositionSelectByTicket(ticket)) continue; // closed by the TP watcher above this same tick

      //--- DISCONNECTED 2026-09-12: superseded by TradeManagementEngine() - see that function's header.
      //--- if(profitUSD < 1.65)
      //---   {
      //---    bool closedByEma35Sl = EvaluateEma35TrackingSl(ticket, direction, currentSL, digits);
      //---    if(closedByEma35Sl) continue; // closed (no valid EMA35 SL available) - ticket is gone
      //---   }
      //--- else
      //---   {
      //---    ApplyProfitTierTrailingSl(ticket, slot, direction, entryPrice, currentSL, profitUSD, lot, digits);
      //---   }

      //--- 2026-09-12, explicit operator request (TRADE MANAGEMENT ENGINE ARCHITECTURAL REPLACEMENT):
      //--- the five legacy mechanisms above (EvaluateEarlyExit, EvaluateEarlySlWatcher,
      //--- EvaluateEarlyTpWatcher, EvaluateEma35TrackingSl, ApplyProfitTierTrailingSl/SelectProfitTier)
      //--- are disconnected (call sites commented out above, functions themselves retained for
      //--- reference - see each function's own updated header). TradeManagementEngine() is now the
      //--- SOLE authority over broker-side SL/TP for every open position - see its own header
      //--- (~search "TradeManagementEngine(") for the full design (Signal Layer -> State Classifier ->
      //--- Adaptive SL Engine -> Progressive TP Engine -> ApplyManagementSlTp()).
      TradeManagementEngine(ticket, slot, direction, entryPrice, currentSL, PositionGetDouble(POSITION_TP), profitUSD, lot, digits);
     }
  }

//====================================================================
// DASHBOARD
//====================================================================
//--- 2026-08-29, explicit operator request: display-only Mind voting-capacity helper. DOES NOT feed
//--- back into EvaluateMinds(), g_buyVotes/g_sellVotes/g_mindsVoteDir, Entry Approval, re-entry, or
//--- any trading decision - purely a UI mirror, the SAME pattern MindCandleBasis() just below already
//--- established for per-Mind descriptive text.
//--- 2026-08-29, explicit operator request: Risk (#5) and Pressure (#10) COMPLETELY REMOVED from the
//--- active Mind architecture - their case labels below are deleted entirely (there is no longer any
//--- g_minds[] entry carrying id=5 or id=10 to ever look them up).
//--- 2026-09-01, explicit operator request (SESSION MIND IMPLEMENTATION): Session (#13) is NO LONGER
//--- a non-voting placeholder - it now casts real BUY/SELL/WAIT votes (see EvaluateMinds()'s own
//--- g_minds[11] block and ResolveSessionStart()). Every Mind in the array now votes. This
//--- function is keyed by each Mind's HISTORICAL id (g_minds[i].id), not by array position - callers
//--- must pass g_minds[i].id, never the raw loop index i, since EvaluateMinds()'s own per-Mind .id=
//--- literals compacted the array (Risk/Pressure removed, ids not renumbered). If EvaluateMinds()
//--- itself ever changes which ids can vote, this list must be updated to
//--- match - it is NOT derived automatically, exactly like MindCandleBasis() below is also a
//--- hand-maintained mirror, not derived.
bool MindIsVoting(const int mindId)
  {
   switch(mindId)
     {
      case 13: return true;  // Session - 2026-09-01: normal voting Mind (BUY/SELL/WAIT), implemented
      case 16: return true;  // EMA Trend - 2026-08-30: normal voting Mind (BUY/SELL/WAIT)
      case 17: return true;  // MTF Alignment - 2026-08-30: normal voting Mind (BUY/SELL/WAIT)
      case 18: return true;  // Absorption - 2026-08-30: normal voting Mind (BUY/SELL/WAIT)
      case 19: return true;  // Fair Value - 2026-08-31: normal voting Mind (BUY/SELL/WAIT)
      default: return true;
     }
  }

//--- How many candles each Mind actually reads to reach its own decision this cycle. Purely
//--- descriptive - matches exactly what each Mind's own formula in EvaluateMinds() consumes.
//--- Keyed by historical id (g_minds[i].id), not array position - see MindIsVoting() above for why.
//--- 2026-09-24, audit fix (D2 follow-up): recentWindowOverride lets a caller report the REAL bar count
//--- for ids 0/4 (Trend/Liquidity) when it genuinely differs from the hardcoded "30" - specifically
//--- DashMindsJsonArrayM5() below, since Inp_M5DnaMindsLookbackBars now actually drives that fetch (see
//--- EvaluateMindsM5()'s own header) and the dashboard was still displaying "30 closed" even though only
//--- 25 bars were really being read. Default -1 preserves the exact original "30 closed" text for M1/M15
//--- (DashMindsJsonArray()/DashMindsJsonArrayM15() below still call this with no third argument) - those
//--- two genuinely are still fixed at 30, unchanged.
string MindCandleBasis(const int mindId, const int n, const int recentWindowOverride=-1)
  {
   switch(mindId)
     {
      case 0:  return (recentWindowOverride>0) ? StringFormat("%d closed", recentWindowOverride) : "30 closed"; // Trend - 2026-08-28: widened 100(live)->dedicated 30
      case 1:  return StringFormat("%d closed", MathMin(5,n-1));  // Momentum   - short slice
      case 2:  return "3 closed";                                 // Scalping   - 2026-08-21: widened 1->3
      case 3:  return "3 closed";                                 // Reversal   - 2026-08-21: widened 1->3
      case 4:  return (recentWindowOverride>0) ? StringFormat("%d closed", recentWindowOverride) : "30 closed"; // Liquidity - 2026-08-21: widened pool->30
      case 6:  return StringFormat("%d closed vs 5", n);          // Volatility - 2026-08-21: widened 1->5
      case 7:  return StringFormat("%d closed", n);               // Structure  - full pool
      case 8:  return "30 closed (cross-cycle)";                  // Memory     - 2026-08-21: widened pool->30
      case 9:  return "30 closed";                                // Pattern    - 2026-08-28: 60->30 (scanned window)
      case 11: return StringFormat("%d closed", n);               // Energy     - full pool
      case 12: return StringFormat("2 vs %d closed", MathMax(0,n-2)); // Breakout - 2026-08-21: widened 1->2
      case 13: return StringFormat("session-so-far closed (min %d)", Inp_SessionMinSamples); // Session - 2026-09-01
      case 14: return StringFormat("%d closed", n);               // Consensus  - full pool
      case 15: return "720 closed";                               // SR         - 2026-08-21: new Mind, window 1440->60->720
      case 16: return StringFormat("%d closed (EMA%d/EMA%d)", Inp_EMASlowPeriod+Inp_EMASlopeLookback+19, Inp_EMAFastPeriod, Inp_EMASlowPeriod); // EMA Trend - 2026-08-30
      case 17: return StringFormat("M1/M5/M15 closed (EMA%d/EMA%d each)", Inp_MTFEmaFastPeriod, Inp_MTFEmaSlowPeriod); // MTF Alignment - 2026-08-30
      case 18: return StringFormat("%d closed (min %d)", Inp_AbsorptionLookback, Inp_AbsorptionMinSamples); // Absorption - 2026-08-30
      case 19: return StringFormat("session closed (min %d)", Inp_FairValueMinSamples); // Fair Value - 2026-08-31
      default: return "?";
     }
  }

void RenderDashboard(const int n)
  {
   string dash = "========== KMIE MARKET DNA LITE ==========\n";
   dash += StringFormat("Symbol: %s   ExecutionEnabled: %s\n\n", g_symbol, Inp_ExecutionEnabled?"YES":"NO");

   dash += "--- Stage 1a: Candle Intelligence ---\n";
   dash += StringFormat("Basis: %d completed candle(s) + %s\n", Inp_MarketDNALookbackCandles,
                         g_ci.runningIncluded ? "1 running (live)" : "running candle unavailable this cycle");
   dash += StringFormat("aggression=%.1f  exhaustion=%.1f  rejection=%.1f  absorption=%.1f\n",
                         g_ci.aggression, g_ci.exhaustion, g_ci.rejection, g_ci.absorption);
   dash += StringFormat("buyingStrength=%.1f  sellingStrength=%.1f  noiseIndex=%.1f  quality=%.1f  confidence=%.1f\n",
                         g_ci.buyingStrength, g_ci.sellingStrength, g_ci.noiseIndex, g_ci.candleQuality, g_ci.candleConfidence);
   dash += StringFormat("Running candle body%%=%.1f\n\n", g_ci.runningBodyPct);

   dash += "--- Stage 1b: Market DNA ---\n";
   dash += StringFormat("%s  (score=%.1f)   Trading Allowed: %s\n", DnaName(g_dnaState), g_dnaScore,
                         CurrentRegimeAllowed(g_dnaState) ? "YES" : "NO (blocked by Regime Allow-List)");
   //--- 2026-09-01, explicit operator request (NEWS ALERT / NEW-ENTRY PAUSE): display-only readout of
   //--- the SAME g_newsBlackoutActive/g_newsBlackoutReason IsNewsBlackoutActive() already maintains -
   //--- never a second/independent calendar check. NOTE: does not itself call
   //--- IsNewsBlackoutActive() here (that's the throttled live-decision path called from the entry
   //--- gates) - this purely reads whatever the LAST real check already determined, so this display
   //--- can never trigger an extra CalendarValueHistory() call on its own.
   dash += StringFormat("NEWS FILTER: %s   %s\n",
                         Inp_NewsFilterEnabled ? "ON" : "OFF",
                         g_newsBlackoutActive ? ("BLOCKED - " + g_newsBlackoutReason) : "clear");
   //--- 2026-09-01, explicit operator request ("show on the dashboard how many bars are being used
   //--- currently on Market DNA and Minds"): mirrors EvaluateMarketDNA()'s own EXACT effective window
   //--- (k = min(ResolveEffectiveDnaLookback(), n) - the same line that function itself computes,
   //--- never a second/independent calculation) - so this is a genuine, live readout of what DNA
   //--- actually read this cycle, not a static input-value echo. "Requested" reflects the CURRENT
   //--- session's own effective lookback (per-session override if set, else the global
   //--- Inp_MarketDNALookbackCandles) - updated 2026-09-01 alongside the per-session bar-count
   //--- feature. n is the shared closed-candle pool size (SAME n already shown on the Stage 2/
   //--- Mind-vote header just below), so a mismatch between DNA's own k and n is visible at a glance.
   int dnaEffLookback = ResolveEffectiveDnaLookback();
   int dnaK = MathMin(dnaEffLookback, n); if(dnaK<1) dnaK=1;
   dash += StringFormat("Bars Used: %d closed candles (requested=%d, pool available=%d)\n\n", dnaK, dnaEffLookback, n);

   //--- 2026-08-29, explicit operator request: Mind voting-capacity summary. Counted here (not
   //--- hardcoded as a literal "13") by looping MindIsVoting() once - the single place this number is
   //--- computed for display. Display-only: reads nothing execution/Entry Approval/re-entry consume.
   int votingMindCount=0;
   for(int vi=0; vi<KMIE_LITE_MIND_COUNT; vi++) if(MindIsVoting(g_minds[vi].id)) votingMindCount++;
   int nonVotingMindCount = KMIE_LITE_MIND_COUNT - votingMindCount;

   dash += StringFormat("--- Stage 2: %d-Mind Vote (shared pool this cycle: %d closed candles) ---\n", KMIE_LITE_MIND_COUNT, n);
   dash += StringFormat("MINDS: %d/%d VOTING   %d NON-VOTING\n", votingMindCount, KMIE_LITE_MIND_COUNT, nonVotingMindCount);
   for(int i=0;i<KMIE_LITE_MIND_COUNT;i++)
      dash += StringFormat("#%-2d %-10s %-4s %5.1f   %-11s candles=%s\n", g_minds[i].id, g_minds[i].name, DirName(g_minds[i].direction),
                            g_minds[i].score, MindIsVoting(g_minds[i].id) ? "VOTING" : "NON-VOTING", MindCandleBasis(g_minds[i].id, n));
   dash += StringFormat("BUY=%d  SELL=%d  WAIT=%d   ->  Vote: %s   (need >= %d to fire)\n",
                         g_buyVotes, g_sellVotes, g_waitVotes, DirName(g_mindsVoteDir), Inp_MindsVoteMinCount);
   //--- 2026-08-29, explicit operator request: re-entry threshold display - this was a SEPARATE gate
   //--- from the "need >= %d to fire" line just above (that's Inp_MindsVoteMinCount, the FIRST-entry
   //--- threshold, unchanged). The literal 9 here used to be a DISPLAY MIRROR of the value hardcoded in
   //--- EarlyReEntryEligible() ("if(winningVotes<9)").
   //--- 2026-09-09, explicit operator request ("fix everythihg and remove fully which we not using",
   //--- confirmed permanent/irreversible via AskUserQuestion twice): EarlyReEntryEligible()'s body
   //--- (including that winningVotes<9 enforcement) was permanently deleted - there is no longer any
   //--- live vote-margin threshold for Early Re-Entry to mirror. Dashboard line updated to say so
   //--- honestly instead of displaying a stale number for a gate that no longer exists.
   dash += StringFormat("EARLY RE-ENTRY: permanently disabled (2026-09-09)   /   %d ACTIVE VOTERS\n", votingMindCount);
   dash += StringFormat("Tickets Per Signal: %d\n\n", Inp_TicketsPerSignal);

   double lotNow = NormalizeLotSize();
   //--- 2026-09-03, bugfix (duplication/drift audit, finding M3): this used to display
   //--- Inp_StopLossUSD ("SL: $3.05") as if it were the live SL distance - that input has not
   //--- actually driven initial SL since Step 9 (see ComputeInitialSL()'s own comment: "Inp_StopLossUSD
   //--- no longer used for initial SL"). The real mechanism is a structural 15-bar level (widened from
   //--- 3 bars on 2026-09-14) plus Inp_StructuralSLExtraBufferUSD, with a $3.00 fallback when fewer
   //--- than 15 closed candles exist - the operator was being shown a number no code path actually
   //--- uses. Now describes the real
   //--- mechanism instead of the dead input.
   //--- 2026-09-08, explicit operator request ("Remove all Manual Trailing TP and SL"): the fixed
   //--- Inp_TakeProfitUSD target no longer exists (req.tp is 0.0 at entry - see SendMarketOrder()'s
   //--- own updated comment) and ongoing SL is now EMA35-tracking (EvaluateEma35TrackingSl()), not the
   //--- old tiered schedule. Dashboard text updated to describe the REAL mechanism, same "don't show a
   //--- number no code path actually uses" fix already established just above for Inp_StopLossUSD.
   //--- 2026-09-16, explicit operator request ("make it SL would be 10 dollar"): text was already stale
   //--- on TWO counts even before this change - "structural 3-bar" (widened to 15-bar on 2026-09-14,
   //--- KMIE_INITIAL_SL_LOOKBACK_BARS) and "then EMA35-tracking" (replaced entirely by the Trade
   //--- Management Engine's 15-bar structural trail + 720-bar jump on 2026-09-12/15, EvaluateEma35TrackingSl()
   //--- is disconnected). Corrected here alongside the $3.00->$10.00 fallback change so this on-chart
   //--- text finally describes the mechanism that is actually live.
   dash += StringFormat("Lot: %.2f   SL: structural %d-bar + $%.2f buffer (min $10.00 fallback), then 15-bar trail/720-bar jump   TP: %.1fR initial, Progressive TP extension\n",
                         lotNow, KMIE_INITIAL_SL_LOOKBACK_BARS, Inp_StructuralSLExtraBufferUSD, Inp_InitialTP_R);
   dash += StringFormat("Open Positions: %d   %s\n", CountOpenPositions(),
                         CountOpenPositions()>0 ? "(BLOCKED - new trades held until this closes)" : "(clear to trade)");

   dash += "\n--- Entry Intelligence (Step 1: Active Leg + Pullback - observational only) ---\n";
   if(g_activeLeg.active)
     {
      dash += StringFormat("Direction: %s   Active Leg: origin=%.3f  extreme=%.3f  range=%.3f\n",
                            DirName(g_activeLeg.direction), g_activeLeg.originPrice, g_activeLeg.extremePrice,
                            MathAbs(g_activeLeg.extremePrice-g_activeLeg.originPrice));
      if(g_pullback.state==LPB_ACTIVE)
         dash += StringFormat("Pullback: ACTIVE   Pullback Extreme: %.3f\n", g_pullback.extremePrice);
      else
         dash += "Pullback: NONE\n";

      if(g_resumption.valid)
        {
         dash += StringFormat("Resumption: %.2f%%   80%% Boundary: %.3f   Window: %s\n",
                               g_resumption.rawPercent, g_resumption.boundary80Price, ResumptionWindowName(g_resumption.window));
         dash += StringFormat("Pullback Depth (opposite-direction, gates entry): %.2f%%   %s\n",
                               g_resumption.pullbackDepthPercent, g_resumption.pullbackTooDeep ? "TOO_DEEP (blocks)" : "OK");
        }
      else
         dash += "Resumption: UNAVAILABLE\n";

      dash += StringFormat("Micro: %s   Mode: %s   Direction: %s\n",
                            MicroStateName(g_microResumption.state), MicroModeName(g_microResumption.mode), DirName(g_microResumption.direction));
      if(g_microResumption.state!=MICRO_NONE)
        {
         if(g_microResumption.direction==LDIR_BUY)
            dash += StringFormat("Micro High: %s\n", g_microResumption.microHigh>0.0 ? DoubleToString(g_microResumption.microHigh,3) : "n/a");
         else
            dash += StringFormat("Micro Low: %s\n", g_microResumption.microLow>0.0 ? DoubleToString(g_microResumption.microLow,3) : "n/a");
         dash += StringFormat("Micro Break: %s\n", g_microResumption.confirmed ? DoubleToString(g_microResumption.breakPrice,3) : "n/a");
         dash += StringFormat("Micro Resumption: %s   Micro Resumption %%: %s\n",
                               g_microResumption.confirmed ? "YES" : "NO",
                               g_microResumption.confirmed ? (DoubleToString(g_microResumption.microBreakResumptionPercent,2)+"%") : "n/a");
        }

      if(g_opportunity.active)
         dash += StringFormat("Opportunity: #%I64u   State: %s   Direction: %s   Resumption: %s   Availability: %s\n",
                               g_opportunity.id, OppStateName(g_opportunity.state), DirName(g_opportunity.direction),
                               g_resumption.valid ? (DoubleToString(g_opportunity.resumptionPercent,2)+"%") : "n/a",
                               g_opportunity.state==OPP_AVAILABLE ? "YES" : "NO");

      if(g_extension.valid)
         dash += StringFormat("Extension: %.2f%%   Extension Distance: %.3f   Extension State: %s\n",
                               g_extension.percent, g_extension.distance, ExtensionStateName(g_extension.state));
      else
         dash += "Extension: UNAVAILABLE\n";

      dash += StringFormat("Entry Approval: %s   Block Reason: %s   Entry Path: %s\n",
                            g_entryApproval.approved ? "APPROVED" : "BLOCKED",
                            g_entryApproval.approved ? "NONE" : BlockReasonName(g_entryApproval.blockReason),
                            EntryPathName(g_entryApproval.path));
      //--- Step 12.1: Micro Confirmation is now optional/non-blocking on BOTH paths, so an unconfirmed
      //--- reading is always "not applicable," never a pending/blocking "wait" - matches
      //--- EvaluateEntryApproval()'s actual gating on both branches.
      string microLabel = g_entryApproval.microConfirmed ? "CONFIRMED" : "N/A";
      //--- Resumption remains path-specific: Pullback measures a real percentage, Continuation has
      //--- nothing to measure without a pullback.
      string resumptionLabel = (g_entryApproval.path==ENTRY_PATH_CONTINUATION) ? "N/A" :
                                (DoubleToString(g_entryApproval.resumptionPercent,2)+"%");
      dash += StringFormat("Opportunity: #%I64u   Resumption: %s   Extension: %.2f%%   Micro: %s\n",
                            g_entryApproval.opportunityId, resumptionLabel, g_entryApproval.extensionPercent, microLabel);
     }
   else
      dash += "Direction: WAIT   Active Leg: none\n";

   //--- 2026-08-31, explicit operator request (RETRY TRADE ENGINE, Section 19): additive-only chart
   //--- presentation, genuinely separate from the "Opportunity: ..." lines above (which continue to
   //--- describe the existing, untouched Opportunity Lifecycle - never relabeled/removed, since it
   //--- still accurately reflects that unchanged mechanism). Never fabricates a value - shows "NONE"
   //--- when no candidate has ever been armed this session.
   dash += "-------------------------------------------\n";
   if(!g_retryEngine.candidateActive && g_retryEngine.previousTicket==0)
      dash += "RETRY ENGINE: no candidate yet\n";
   else
     {
      string retryStatus;
      if(g_retryEngine.retryAlreadyExecuted)
         retryStatus = "EXECUTED";
      else if(!g_retryEngine.candidateActive)
         retryStatus = "SUPERSEDED"; // an older candidate, replaced by a newer one - previousTicket below is stale info only
      else if(g_retryEngine.previousExitType!=RETRY_EXIT_TRAILING && g_retryEngine.previousExitType!=RETRY_EXIT_BREAK_EVEN)
         retryStatus = "BLOCKED (exit not retry-eligible)";
      else if(CountOpenPositions()>0)
         retryStatus = "BLOCKED (position already open)";
      else if(!IsRetryDnaAllowed(g_dnaState))
         retryStatus = "BLOCKED (DNA not allowed)";
      else if(g_mindsVoteDir!=g_retryEngine.previousDirection)
         retryStatus = "BLOCKED (direction mismatch)";
      else if((g_mindsVoteDir==LDIR_BUY ? g_buyVotes : g_sellVotes)<9)
         retryStatus = "BLOCKED (Minds < 9)";
      else
         retryStatus = "READY";

      dash += StringFormat("RETRY ENGINE: Previous Ticket=%I64u  Previous Exit=%s  Retry Direction=%s\n",
                            g_retryEngine.previousTicket, RetryExitTypeName(g_retryEngine.previousExitType),
                            DirName(g_retryEngine.previousDirection));
      dash += StringFormat("  Retry DNA: %s (%s)   Minds: %d/%d   Status: %s\n",
                            DnaName(g_dnaState), IsRetryDnaAllowed(g_dnaState) ? "ALLOWED" : "NOT ALLOWED",
                            (g_mindsVoteDir==LDIR_BUY) ? g_buyVotes : (g_mindsVoteDir==LDIR_SELL) ? g_sellVotes : 0,
                            KMIE_LITE_MIND_COUNT, retryStatus);
     }

   //--- 2026-08-31, explicit operator request (RETRY CANDIDATE OBSERVATION ENGINE, Section 14):
   //--- informational only. Explicitly worded "RETRY OBSERVATION ONLY" (never "RETRY ACTIVE") per
   //--- explicit instruction - this line can never mean live retry trading is happening, only that the
   //--- diagnostic logger is running. No button, no way to change this from the chart.
   dash += StringFormat("RETRY OBSERVATION: %s", Inp_RetryObservationEnabled ? "ON" : "OFF");
   if(g_retryObsHaveAny)
      dash += StringFormat("   LAST: %I64u   WOULD RETRY: %s\n", g_retryObsLastTicket, g_retryObsLastWouldRetry ? "YES" : "NO");
   else
      dash += "   LAST: none yet\n";

   //--- 2026-08-31, explicit operator request (STEP 3 FORENSIC OBSERVATION, Phase 16): informational
   //--- only, no button, no trading effect. "Danger level" is a purely descriptive readout of existing
   //--- observation state (two-opposite-candles + Mind-flip-against, both already computed above by
   //--- RecordRetryForensicTick() and stored per-slot) - never a new trading signal, never read by any
   //--- decision function. Shows the FIRST active forensic slot found (this EA holds at most one
   //--- batch's worth of tickets open at a time under normal operation) - if none, states so plainly.
   dash += StringFormat("RETRY FORENSIC: %s   Tickets Observed: %d   Protected: %d   Hard-SL: %d\n",
                         Inp_RetryForensicEnabled ? "ON" : "OFF",
                         g_retryForensicObservationEvents, g_retryForensicProtectedCount, g_retryForensicHardSlCount);
   //--- 2026-08-31, explicit operator request (STEP 5): purely diagnostic readout, no statistical
   //--- claim made here (per the explicit instruction not to imply these counts are validated) - just
   //--- a raw count of how many decision-point records have been written this session.
   dash += StringFormat("RETRY DECISION LOG: %s   Decision Points: %d\n",
                         Inp_RetryDecisionForensicEnabled ? "ON" : "OFF", g_retryDecisionPointsWritten);
   //--- 2026-08-31, explicit operator request (STEP 7): purely diagnostic readout, same
   //--- no-statistical-claim convention as the Step 5 line immediately above.
   dash += StringFormat("RETRY LIFECYCLE LOG: %s   Lifecycle Records: %d\n",
                         Inp_RetryLifecycleForensicEnabled ? "ON" : "OFF", g_retryLifecycleRecordsWritten);
   //--- 2026-09-01, explicit operator request (STEP 9): same no-statistical-claim convention as every
   //--- Retry Forensic dashboard line above.
   dash += StringFormat("RETRY STEP9 LOG: %s   Step9 Records: %d\n",
                         Inp_RetryStep9ForensicEnabled ? "ON" : "OFF", g_retryStep9RecordsWritten);
   int fSlot = -1;
   for(int fi=0; fi<KMIE_LITE_MAX_TRAILING_SLOTS; fi++)
      if(g_retryForensic[fi].active) { fSlot = fi; break; }
   if(fSlot<0)
      dash += "  No open ticket currently observed.\n";
   else
     {
      bool mindFlipAgainst = (g_retryForensic[fSlot].dpMindFlipAgainstTime>0);
      bool twoOpp = g_retryForensic[fSlot].twoOppositeCandlesConfirmed;
      string dangerLevel = (mindFlipAgainst && twoOpp) ? "DANGER" : (mindFlipAgainst || twoOpp) ? "WATCH" : "SAFE";
      int winningVotes = (g_mindsVoteDir==LDIR_BUY) ? g_buyVotes : (g_mindsVoteDir==LDIR_SELL) ? g_sellVotes : 0;
      dash += StringFormat("  Current DNA: %s   Winning Votes: %d/%d   2 Opposite Candles: %s   Mind Deterioration: %s   Danger Level: %s\n",
                            DnaName(g_dnaState), winningVotes, KMIE_LITE_MIND_COUNT,
                            twoOpp ? "YES" : "NO", mindFlipAgainst ? "YES" : "NO", dangerLevel);
     }

   dash += "===========================================";

   Comment(dash);
  }
//+------------------------------------------------------------------+
