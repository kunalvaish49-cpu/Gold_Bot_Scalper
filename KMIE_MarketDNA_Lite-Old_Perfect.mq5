input bool   Inp_RetryDecisionForensicEnabled = true;    // true = append retry_forensic_decisions.jsonl records; false = skip logging entirely, trading behavior identical either way

//--- 2026-08-31, explicit operator request (STEP 7 - RETRY / PROTECTION MARKET-EVENT LIFECYCLE
//--- ANALYSIS): independent toggle from the two inputs above - controls ONLY the new
//--- retry_lifecycle_forensics.jsonl writer (RecordRetryLifecycleTransition()/
//--- RecordRetryLifecycleExit()). Not read by any trading decision anywhere in this file, same
//--- non-interference guarantee as the other two Retry Forensic toggles.
input bool   Inp_RetryLifecycleForensicEnabled = true;   // true = append retry_lifecycle_forensics.jsonl records; false = skip logging entirely, trading behavior identical either way

//--- 2026-09-01, explicit operator request (STEP 9 - RETRY ENGINE FINAL DATA-ACCUMULATION):
//--- independent toggle from the three inputs above - controls ONLY the new
//--- retry_step9_event_validation.jsonl writer (RecordRetryStep9EventRecord()/
//--- RecordRetryPostExitContinuation()). Not read by any trading decision anywhere in this file, same
//--- non-interference guarantee as every other Retry Forensic toggle.
input bool   Inp_RetryStep9ForensicEnabled = true;       // true = append retry_step9_event_validation.jsonl records; false = skip logging entirely, trading behavior identical either way

//====================================================================
// ENUMS
//====================================================================
enum ENUM_LITE_DIR { LDIR_SELL=-1, LDIR_WAIT=0, LDIR_BUY=1 };
//--- 2026-09-09, explicit operator request (EMA CONTINUATION/EXTENSION CLASSIFICATION): three-state
//--- classification of the EMA20/EMA50 entry structure, distinguishing a healthy directional
//--- continuation (safe to enter/confirm) from an overextended trend (direction still valid, but price
//--- too far from EMA20 - wait for pullback, NOT a block, NOT a reversal) - see ClassifyEmaEntryState().
enum ENUM_EMA_ENTRY_STATE
  {
   EMA_ENTRY_NEUTRAL = 0,             // existing emaNeutral condition - entry blocker, unchanged formula
   EMA_ENTRY_TREND_CONTINUATION = 1,  // healthy directional structure, safe to enter/confirm
   EMA_ENTRY_TREND_EXTENDED = 2       // direction still valid, but price too far from EMA20 - wait for pullback, NOT a block, NOT a reversal
  };
//--- 2026-09-11, explicit operator request (ACTIVE_PING/EMA35 ARCHITECTURE REWIRE - Part A): three-state
//--- classification of price's relationship to the NEW independent EMA35 axis (a genuinely separate
//--- concept from ENUM_EMA_ENTRY_STATE above, which is CONTINUATION/EXTENDED - a different axis measuring
//--- distance, not side). EMA35_NEUTRAL = price is within Inp_EMA35NeutralBandATR of EMA35 (ATR-normalized
//--- distance) - price==EMA35 exactly is unsuitable for M1 (near-never true), so a small band is used
//--- instead. EMA35_BUY/EMA35_SELL = price sits meaningfully above/below EMA35. See
//--- ClassifyEma35MarketSide().
enum ENUM_EMA35_MARKET_SIDE
  {
   EMA35_NEUTRAL = 0,
   EMA35_BUY = 1,
   EMA35_SELL = 2
  };
//--- 2026-09-04, explicit operator request (FULL MARKET DNA CONSOLIDATION - 30-state legacy taxonomy
//--- reduced to exactly 15 ACTIVE production states + 3 RETIRED-COMPATIBILITY states, full removal of
//--- the other 12): this enum is now COMPACTED (renumbered) - the SAME precedent already established by
//--- the 2026-08-30 LIQUIDITY_HUNT removal (that removal also renumbered every subsequent state, "a
//--- mechanical consequence of compacting the enum"). Renumbering is proven SAFE here because
//--- DnaFromName()/ReadEntryDnaFromFile() resolve historical log rows by NAME STRING, never by raw
//--- numeric index reinterpretation (see DnaFromName()'s own header - "a historical row's index was
//--- written under a DIFFERENT enum layout... NOT safe to reinterpret... resolving by name is safe").
//---
//--- ACTIVE_STATE_COUNT = 15 (the ONLY states EvaluateMarketDNA()'s ARGMAX may select - see
//--- ARGMAX_ACTIVE_DNA_STATES[] below): STRONG_UPTREND, STRONG_DOWNTREND, UPTREND, DOWNTREND,
//--- WEAK_UPTREND, WEAK_DOWNTREND, PULLBACK_UP, PULLBACK_DOWN, VOLATILITY_EXPANSION,
//--- VOLATILITY_COMPRESSION, VOLATILE, EXPANSION, COMPRESSION, CHOPPY, NEUTRAL.
//---
//--- RETIRED_COMPATIBILITY_STATE_COUNT = 3 (enum identifiers preserved SOLELY because
//--- EarlyReEntryEligible() - protected Opportunity Lifecycle code, explicitly NOT modified by this
//--- task - directly references them by enum value as re-entry continuation conditions): STRONG_TREND,
//--- INSTITUTIONAL_BUYING, INSTITUTIONAL_SELLING. Their scores[] entries are hard-fixed at 0.0 in
//--- EvaluateMarketDNA() (same pattern already proven for WEAK_TREND/PULLBACK earlier this session),
//--- their Inp_Allow_* inputs removed entirely (CurrentRegimeAllowed() no longer references them - see
//--- its own updated switch), and they are excluded from ARGMAX/dashboard/retry-whitelist/calibration
//--- as genuinely inert compatibility shims, not competing DNA.
//---
//--- LDNA_STATE_COUNT = 18 (15 active + 3 retired-compatibility) - the array-sizing constant for
//--- scores[]/g_dnaCalibMean[]/g_dnaCalibStdev[]/KMIE_RETRY_OBSERVATION_DNA_WHITELIST[], NOT the active
//--- competitor count (that is LDNA_ACTIVE_STATE_COUNT, defined right after this enum).
//---
//--- FULLY REMOVED (enum entry, scoring, calibration, inputs, permission, retry whitelist, DnaName/
//--- DnaFromName, dashboard mappings, dedicated tests/structs/functions - zero remaining executable
//--- reference anywhere): WEAK_TREND, PULLBACK (the two OLD generic non-directional predecessors,
//--- already fully superseded by WEAK_UPTREND/WEAK_DOWNTREND and PULLBACK_UP/PULLBACK_DOWN),
//--- ACCUMULATION, DISTRIBUTION, STOP_HUNT, BREAKOUT, FALSE_BREAKOUT, TREND_EXHAUSTION, QUIET, RANGE,
//--- REVERSAL, PRICE_VOLUME_EXPANSION.
//--- 2026-09-08, explicit operator request (MARKET DNA STATE REMOVAL - UPTREND/DOWNTREND/EXPANSION/
//--- COMPRESSION): follows the EXACT precedent this enum's own prior "FULL MARKET DNA CONSOLIDATION"
//--- (2026-09-04) established for STRONG_TREND/INSTITUTIONAL_BUYING/INSTITUTIONAL_SELLING:
//---  - EXPANSION/COMPRESSION have ZERO executable reference outside DNA scoring/calibration/dashboard/
//---    test machinery (verified by full-file grep before this edit) - FULLY REMOVED, exactly like the
//---    12 legacy names (WEAK_TREND/PULLBACK/ACCUMULATION/etc.) already fully removed in that prior
//---    task. Their enum identifiers no longer exist at all.
//---  - UPTREND/DOWNTREND are DIRECTLY referenced by enum value inside EarlyReEntryEligible()
//---    (Opportunity Lifecycle, explicitly NOT modified by this task - g_dnaState==LDNA_UPTREND/
//---    LDNA_DOWNTREND re-entry continuation conditions) - cannot be fully removed without editing that
//---    protected function. Demoted to RETIRED-COMPATIBILITY instead, joining the existing 3 - enum
//---    identifiers ONLY, hard-fixed scores[]=0.0, never in ARGMAX_ACTIVE_DNA_STATES[], never
//---    calibrated, no Inp_Allow_* input, no retry-whitelist entry, no dashboard presence - identical
//---    treatment to STRONG_TREND/INSTITUTIONAL_BUYING/INSTITUTIONAL_SELLING below.
enum ENUM_LITE_DNA
  {
   //--- 11 ACTIVE production states (the ONLY states ARGMAX may select).
   LDNA_STRONG_UPTREND=0, LDNA_STRONG_DOWNTREND=1,
   LDNA_WEAK_UPTREND=2, LDNA_WEAK_DOWNTREND=3, LDNA_PULLBACK_UP=4, LDNA_PULLBACK_DOWN=5,
   LDNA_VOLATILITY_EXPANSION=6, LDNA_VOLATILITY_COMPRESSION=7, LDNA_VOLATILE=8,
   LDNA_CHOPPY=9, LDNA_NEUTRAL=10,
   //--- 5 RETIRED-COMPATIBILITY states - enum identifiers ONLY. Originally preserved solely for
   //--- EarlyReEntryEligible()'s own g_dnaState==LDNA_UPTREND/LDNA_DOWNTREND/LDNA_STRONG_TREND/
   //--- INSTITUTIONAL_BUYING/INSTITUTIONAL_SELLING checks; 2026-09-09, that function's DNA-checking body
   //--- was permanently deleted (see its own header) - these 5 identifiers now have ZERO executable
   //--- reader anywhere in the file (DnaName()/DnaFromName() still resolve them for historical log
   //--- compatibility only, not a "reader" in the decision-making sense). Kept as retired-compatibility
   //--- enum slots regardless, per explicit operator scope (removing the enum values themselves was NOT
   //--- authorized by that same request - only EarlyReEntryEligible()'s dead body was). NOT
   //--- active Market DNA - hard-fixed to scores[]=0.0, never in ARGMAX_ACTIVE_DNA_STATES[], never
   //--- dashboard-visible, never calibrated, no Inp_Allow_* input, no retry-whitelist entry.
   LDNA_UPTREND=11, LDNA_DOWNTREND=12,
   LDNA_STRONG_TREND=13, LDNA_INSTITUTIONAL_BUYING=14, LDNA_INSTITUTIONAL_SELLING=15,
   LDNA_STATE_COUNT=16
  };
//--- The 11 ACTIVE competitors, in enum order - EvaluateMarketDNA()'s own ARGMAX loop iterates ONLY
//--- this list (never a bare "for i<LDNA_STATE_COUNT" over the full 16-slot array), so the 5 retired-
//--- compatibility states are structurally, not merely score-wise, excluded from ever winning.
#define LDNA_ACTIVE_STATE_COUNT 11
const ENUM_LITE_DNA ARGMAX_ACTIVE_DNA_STATES[LDNA_ACTIVE_STATE_COUNT] =
  {
   LDNA_STRONG_UPTREND, LDNA_STRONG_DOWNTREND,
   LDNA_WEAK_UPTREND, LDNA_WEAK_DOWNTREND, LDNA_PULLBACK_UP, LDNA_PULLBACK_DOWN,
   LDNA_VOLATILITY_EXPANSION, LDNA_VOLATILITY_COMPRESSION, LDNA_VOLATILE,
   LDNA_CHOPPY, LDNA_NEUTRAL
  };

string DirName(const ENUM_LITE_DIR d){ return d==LDIR_BUY?"BUY":d==LDIR_SELL?"SELL":"WAIT"; }
//--- 2026-09-04, explicit operator request (FULL MARKET DNA CONSOLIDATION): only the 15 ACTIVE states
//--- plus the 3 RETIRED-COMPATIBILITY states have a case - the 12 fully-removed legacy names
//--- (STRONG_TREND's own OLD siblings WEAK_TREND/PULLBACK, ACCUMULATION, DISTRIBUTION, STOP_HUNT,
//--- BREAKOUT, FALSE_BREAKOUT, TREND_EXHAUSTION, QUIET, RANGE, REVERSAL, PRICE_VOLUME_EXPANSION) no
//--- longer exist as enum values at all, so no case is possible or needed for them. The 3 retired-
//--- compatibility states STILL resolve to their real names (not "NEUTRAL") since EarlyReEntryEligible()
//--- (Opportunity Lifecycle, unmodified) can still legitimately compare g_dnaState against them, and any
//--- diagnostic log reading g_dnaState during that vanishingly-rare tie-break window must show the truth,
//--- never a fabricated NEUTRAL.
string DnaName(const ENUM_LITE_DNA s)
  {
   switch(s)
     {
      case LDNA_STRONG_UPTREND:      return "STRONG_UPTREND";
      case LDNA_STRONG_DOWNTREND:    return "STRONG_DOWNTREND";
      case LDNA_WEAK_UPTREND:        return "WEAK_UPTREND";
      case LDNA_WEAK_DOWNTREND:      return "WEAK_DOWNTREND";
      case LDNA_PULLBACK_UP:         return "PULLBACK_UP";
      case LDNA_PULLBACK_DOWN:       return "PULLBACK_DOWN";
      case LDNA_VOLATILITY_EXPANSION:   return "VOLATILITY_EXPANSION";
      case LDNA_VOLATILITY_COMPRESSION: return "VOLATILITY_COMPRESSION";
      case LDNA_VOLATILE:            return "VOLATILE";
      case LDNA_CHOPPY:              return "CHOPPY";
      case LDNA_UPTREND:                 return "UPTREND";                 // retired-compatibility only, see enum's own header
      case LDNA_DOWNTREND:               return "DOWNTREND";               // retired-compatibility only
      case LDNA_STRONG_TREND:            return "STRONG_TREND";            // retired-compatibility only, see enum's own header
      case LDNA_INSTITUTIONAL_BUYING:    return "INSTITUTIONAL_BUYING";    // retired-compatibility only
      case LDNA_INSTITUTIONAL_SELLING:   return "INSTITUTIONAL_SELLING";   // retired-compatibility only
      default:                       return "NEUTRAL";
     }
  }

//--- 2026-08-30, explicit operator request (LIQUIDITY_HUNT enum-compaction legacy-history safety):
//--- exact inverse of DnaName() - resolves a NAME STRING back to the current ENUM_LITE_DNA. Added
//--- specifically so ReadEntryDnaFromFile() (below) can stop trusting entry_dna.jsonl's raw numeric
//--- "dnaStateIdx" field, which is NOT safe to reinterpret after any enum compaction (a historical
//--- row's index was written under a DIFFERENT enum layout - e.g. old dnaStateIdx=8 meant STOP_HUNT
//--- before this task, but a bare (ENUM_LITE_DNA) cast of that same 8 now means BREAKOUT). The paired
//--- "dnaState" NAME string in the same log line has always been architecture-independent and remains
//--- so - resolving by name is safe both for legacy rows (a removed name like "LIQUIDITY_HUNT" simply
//--- returns false below, correctly falling back to live g_dnaState rather than silently misreading a
//--- stale index) and for future rows. Returns false (not a guessed/default state) on no match -
//--- never fabricates a regime for an unrecognized name.
//---
//--- 2026-09-04, explicit operator request (FULL MARKET DNA CONSOLIDATION): 12 legacy names (WEAK_TREND,
//--- PULLBACK, ACCUMULATION, DISTRIBUTION, STOP_HUNT, BREAKOUT, FALSE_BREAKOUT, TREND_EXHAUSTION, QUIET,
//--- RANGE, REVERSAL, PRICE_VOLUME_EXPANSION) removed - a historical entry_dna.jsonl row recorded under
//--- one of these now-deleted names correctly returns false here (same safe fallback the "LIQUIDITY_HUNT"
//--- precedent already established, per this function's own header above), never a fabricated match. The
//--- 3 retired-compatibility names (STRONG_TREND/INSTITUTIONAL_BUYING/INSTITUTIONAL_SELLING) still
//--- resolve correctly, since their enum identifiers are preserved.
bool DnaFromName(const string name, ENUM_LITE_DNA &outState)
  {
   if(name=="STRONG_UPTREND")         { outState=LDNA_STRONG_UPTREND;         return true; }
   if(name=="STRONG_DOWNTREND")       { outState=LDNA_STRONG_DOWNTREND;       return true; }
   if(name=="WEAK_UPTREND")           { outState=LDNA_WEAK_UPTREND;           return true; }
   if(name=="WEAK_DOWNTREND")         { outState=LDNA_WEAK_DOWNTREND;         return true; }
   if(name=="PULLBACK_UP")            { outState=LDNA_PULLBACK_UP;            return true; }
   if(name=="PULLBACK_DOWN")          { outState=LDNA_PULLBACK_DOWN;          return true; }
   if(name=="VOLATILITY_EXPANSION")   { outState=LDNA_VOLATILITY_EXPANSION;   return true; }
   if(name=="VOLATILITY_COMPRESSION") { outState=LDNA_VOLATILITY_COMPRESSION; return true; }
   if(name=="VOLATILE")               { outState=LDNA_VOLATILE;               return true; }
   if(name=="CHOPPY")                 { outState=LDNA_CHOPPY;                 return true; }
   if(name=="NEUTRAL")                { outState=LDNA_NEUTRAL;                return true; }
   if(name=="UPTREND")                { outState=LDNA_UPTREND;                return true; } // retired-compatibility only
   if(name=="DOWNTREND")              { outState=LDNA_DOWNTREND;              return true; } // retired-compatibility only
   if(name=="STRONG_TREND")           { outState=LDNA_STRONG_TREND;           return true; } // retired-compatibility only
   if(name=="INSTITUTIONAL_BUYING")   { outState=LDNA_INSTITUTIONAL_BUYING;   return true; } // retired-compatibility only
   if(name=="INSTITUTIONAL_SELLING")  { outState=LDNA_INSTITUTIONAL_SELLING;  return true; } // retired-compatibility only
   return false; // includes removed names (e.g. legacy "LIQUIDITY_HUNT", "WEAK_TREND", "PULLBACK", "ACCUMULATION", "EXPANSION", "COMPRESSION", etc.) and any unrecognized string
  }

//--- Market DNA Regime Allow-List helper - maps the current regime to its own on/off input.
//--- 2026-09-01, explicit operator request (PER-SESSION DNA + MIND SELECTION): added the
//--- IsRegimeAllowedForSession() check below, ADDITIVE to the existing switch (never a replacement,
//--- per explicit operator confirmation) - a regime must pass BOTH its own global Inp_Allow_<State>
//--- toggle (unchanged, still checked first) AND the current session's own DNA allow-list (blank =
//--- no restriction, so this is a no-op for every session until the operator types something into
//--- one of the new Inp_SessionDna_* inputs). Both MaybeExecute() and EarlyReEntryEligible()
//--- automatically inherit this - this is their ONE shared choke point, no new call site needed.
//--- 2026-09-04, explicit operator request (FULL MARKET DNA CONSOLIDATION): only the 15 ACTIVE states
//--- have an explicit case. The 3 RETIRED-COMPATIBILITY states (STRONG_TREND/INSTITUTIONAL_BUYING/
//--- INSTITUTIONAL_SELLING) intentionally have NO case and NO Inp_Allow_* input any more (removed per
//--- the approved consolidation) - they fall to `default` (Inp_Allow_Neutral, already false), which is
//--- harmless and moot: their scores[] are hard-fixed at 0.0 in EvaluateMarketDNA() and they are
//--- structurally excluded from ARGMAX_ACTIVE_DNA_STATES[], so g_dnaState can practically never equal
//--- one of them for CurrentRegimeAllowed() to even be asked about. EarlyReEntryEligible() (Opportunity
//--- Lifecycle, unmodified) still calls this function exactly as before - its own g_dnaState==LDNA_STRONG_TREND
//--- etc. checks are untouched and independent of this switch.
bool CurrentRegimeAllowed(const ENUM_LITE_DNA state)
  {
   bool globallyAllowed;
   switch(state)
     {
      case LDNA_STRONG_UPTREND:          globallyAllowed = Inp_Allow_STRONG_UPTREND; break;
      case LDNA_STRONG_DOWNTREND:        globallyAllowed = Inp_Allow_STRONG_DOWNTREND; break;
      case LDNA_WEAK_UPTREND:            globallyAllowed = Inp_Allow_WeakUptrend; break;
      case LDNA_WEAK_DOWNTREND:          globallyAllowed = Inp_Allow_WeakDowntrend; break;
      case LDNA_PULLBACK_UP:             globallyAllowed = Inp_Allow_PullbackUp; break;
      case LDNA_PULLBACK_DOWN:           globallyAllowed = Inp_Allow_PullbackDown; break;
      case LDNA_VOLATILITY_EXPANSION:    globallyAllowed = Inp_Allow_VolatilityExpansion; break;
      case LDNA_VOLATILITY_COMPRESSION:  globallyAllowed = Inp_Allow_VolatilityCompression; break;
      case LDNA_VOLATILE:                globallyAllowed = Inp_Allow_VOLATILE; break;
      case LDNA_CHOPPY:                  globallyAllowed = Inp_Allow_Choppy; break;
      //--- 2026-09-08, explicit operator request (MARKET DNA STATE REMOVAL): LDNA_UPTREND/LDNA_DOWNTREND
      //--- (now retired-compatibility, see enum's own header) and LDNA_EXPANSION/LDNA_COMPRESSION (now
      //--- fully removed enum values) intentionally have NO case and NO Inp_Allow_* input any more -
      //--- they fall to `default` (Inp_Allow_Neutral, already false), identical to how the 3 pre-existing
      //--- retired-compatibility states (STRONG_TREND/INSTITUTIONAL_BUYING/INSTITUTIONAL_SELLING) already
      //--- fell to default before this task. Harmless and moot: UPTREND/DOWNTREND's scores[] are
      //--- hard-fixed at 0.0 and both are structurally excluded from ARGMAX_ACTIVE_DNA_STATES[], so
      //--- g_dnaState can practically never equal one of them for this function to even be asked about.
      default:                           globallyAllowed = Inp_Allow_Neutral; break;
     }
   if(!globallyAllowed) return false; // fails the existing global switch - session list is never consulted, never widens this
   return IsRegimeAllowedForSession(state);
  }

//--- 2026-09-16, M5 PARALLEL PIPELINE: NEW pure helper (not a duplicate of anything) - maps a Market DNA
//--- state to its own directional flavor, so the BOTH-mode agreement gate in MaybeExecute() can compare
//--- g_dnaState's direction against g_dnaStateM5's direction. Mirrors the SAME case coverage as
//--- CurrentRegimeAllowed()'s own switch just above (read directly from ENUM_LITE_DNA's definition):
//--- STRONG_UPTREND/WEAK_UPTREND/PULLBACK_UP (and the retired-compatibility UPTREND) -> BUY;
//--- STRONG_DOWNTREND/WEAK_DOWNTREND/PULLBACK_DOWN (and retired-compatibility DOWNTREND) -> SELL;
//--- every other state (VOLATILITY_EXPANSION/VOLATILITY_COMPRESSION/VOLATILE/CHOPPY/NEUTRAL, and the
//--- retired-compatibility STRONG_TREND/INSTITUTIONAL_BUYING/INSTITUTIONAL_SELLING) -> WAIT, since none
//--- of those represent a directional regime. ONE shared helper used for both g_dnaState and
//--- g_dnaStateM5 - never duplicated.
ENUM_LITE_DIR DnaDirectionOf(const ENUM_LITE_DNA dnaState)
  {
   switch(dnaState)
     {
      case LDNA_STRONG_UPTREND:
      case LDNA_WEAK_UPTREND:
      case LDNA_PULLBACK_UP:
      case LDNA_UPTREND:
         return LDIR_BUY;
      case LDNA_STRONG_DOWNTREND:
      case LDNA_WEAK_DOWNTREND:
      case LDNA_PULLBACK_DOWN:
      case LDNA_DOWNTREND:
         return LDIR_SELL;
      default: // VOLATILITY_EXPANSION/VOLATILITY_COMPRESSION/VOLATILE/CHOPPY/NEUTRAL/retired-compatibility STRONG_TREND/INSTITUTIONAL_BUYING/INSTITUTIONAL_SELLING
         return LDIR_WAIT;
     }
  }

//====================================================================
// STRUCTS
//====================================================================
struct RawFeatures
  {
   int    ups, downs;
   double netMove, avgRange, lastRange, avgBodyPct, lastBodyPct;
   double avgUpperWickPct, avgLowerWickPct, lastUpperWickPct, lastLowerWickPct;
   double highestHigh, lowestLow, highestHighExclLast, lowestLowExclLast;
   double shortSlope, longSlope;
  };

//--- 2026-08-20, explicit operator request: an intermediate stage named after the real Framework
//--- 10A/10B's own field vocabulary (aggression, exhaustion, rejection, absorption, buyingStrength,
//--- sellingStrength, ...), sitting between raw OHLC and Market DNA. Unlike the real Framework 10A/
//--- 10B - which read already-published upstream pipeline fields - every field here is still
//--- computed FRESH, directly from this cycle's own raw OHLC over Inp_MarketDNALookbackCandles.
//--- Nothing upstream of this struct; it's just properly named and staged now instead of scattered
//--- as local variables inside EvaluateMarketDNA().
struct CandleIntelligence
  {
   double aggression;       // avg body% of range - how forcefully price moved relative to its own candle
   double exhaustion;       // heavy wick + shrinking body - momentum fading into candle completion
   double rejection;        // newest candle's own dominant single-sided wick% - a level being refused
   double absorption;       // high range, low net displacement over the window - effort without progress
   double buyingStrength;   // % of window's candles that closed up
   double sellingStrength;  // % of window's candles that closed down
   double noiseIndex;       // avg total wick% - uncertainty/indecision
   double candleQuality;    // 100-noiseIndex - cleanliness of the window's candles
   double candleConfidence; // how strongly the window agrees on ONE direction (0=50/50 split, 100=unanimous)
   double volRatio;         // newest candle's range vs the window's own average range
   double priorHighExclLast, priorLowExclLast; // extremes over the window EXCLUDING the newest candle
   bool   runningIncluded;  // true once the still-forming M1 candle was successfully folded in
   double runningBodyPct;   // the running candle's own body% so far, shown separately on the dashboard
   double newestHigh, newestLow, newestClose; // the running candle's OHLC when included, else the last closed candle's
  };

//--- 2026-09-04, explicit operator request ("Upgrade the EXISTING generic PULLBACK Market DNA...
//--- PHASE 1 ONLY - do NOT split into PULLBACK_UP/PULLBACK_DOWN yet" - LIVE DIRECT REPLACEMENT of its
//--- formula, NOT a new state, NOT a shadow): output of EvaluatePullbackStructure() - "is this a genuine
//--- controlled retracement occurring within a directional market structure?" (Section 5's own explicit
//--- question this formula must answer, NOT merely "price moved in the opposite direction recently").
//---
//--- SUPERSEDED formula (2026-08-25 version, now retired): a 4-factor multiplicative AND-gate
//--- (trendEvidence x counterTrendEvidence x structuralIntegrity x pullbackQuality) built on fractal
//--- swing detection (kept, see below) BUT with counter-trend/retracement/structural-integrity measured
//--- against ci.newestHigh/ci.newestLow - the STILL-FORMING running candle - a genuine look-ahead risk,
//--- the SAME defect class already found and fixed in CHOPPY/NEUTRAL/VOLATILE's own prior formulas. It
//--- also had ZERO volume dimension, ZERO canonical pip-field usage, and ZERO explicit choppy-alternation
//--- protection (a two-sided noisy market with a dominant swing count could still pass the trend-evidence
//--- gate).
//---
//--- KEPT UNCHANGED from the retired formula: the fh=2 fractal swing-detection technique itself (Steps
//--- 1-4 below) - it correctly reads ONLY rates[1..k-1] (closed candles, shift>=1, never shift 0) and is
//--- the SAME validated technique used 7+ times elsewhere in this file (StrongUptrendShadow/
//--- StrongDownStrendShadow/UptrendShadow/DowntrendShadow/RANGE/NEUTRAL/CHOPPY's own retired formula) -
//--- this was never a look-ahead risk and needed no fixing. What changes is everything DOWNSTREAM of
//--- trend detection: retracement/depth/persistence/structural-preservation now read the canonical
//--- closed-M1 win[]/PriceRangeDnaResult 25-bar/5-bar window (shift=1+ only) instead of ci.newestHigh/Low,
//--- plus genuinely new dimensions (5-bar persistence, volume, choppy-alternation protection) the old
//--- formula never measured at all.
//---
//--- PRESERVED FOR FUTURE PHASE 2 (explicit "clean reusable internal architecture" requirement): every
//--- field below is exposed individually and trendDirection is already computed as internal context
//--- (never a separate DNA state) - a future PULLBACK_UP/PULLBACK_DOWN split can read trendDirection
//--- directly without re-deriving it.
struct PullbackStructure
  {
   bool     valid;                    // false = fewer than 25 closed M1 bars available - every field below is then 0.0/safe, never fabricated
   string   reasoning;
   datetime barTime;                  // latest closed bar's own open time (shift=1)
   int      contextBars;              // actual count of closed bars used for context (<=25)

   // A. Directional context (fh=2 fractal swing detection, closed candles only - UNCHANGED technique)
   int      swingHighCount;
   int      swingLowCount;
   double   bullishTrendEvidence;     // 0..100, rising HH/HL pair-compliance average - SAME formula as the retired struct
   double   bearishTrendEvidence;     // 0..100, falling LH/LL pair-compliance average
   ENUM_LITE_DIR trendDirection;      // internal context ONLY (Section 6 - NOT yet PULLBACK_UP/PULLBACK_DOWN)
   double   trendContextScore;        // 0..100, max(bullishTrendEvidence, bearishTrendEvidence)
   double   latestConfirmedExtreme;   // latest confirmed HH (BUY context) or LH (SELL context)
   double   latestConfirmedOrigin;    // latest confirmed HL (BUY context) or LL (SELL context)

   // B. Preceding impulse
   double   precedingImpulsePips;     // latestConfirmedExtreme-latestConfirmedOrigin (always positive by construction)

   // C/D. Counter-direction displacement + retracement depth - measured from the LATEST CLOSED candle
   // (shift=1, rates[1].low/high - NEVER ci.newestLow/newestHigh)
   double   retracementPips;          // how far the latest CLOSED extreme has retraced from latestConfirmedExtreme/Origin
   double   retracementRatio;         // 0..100+, retracementPips/precedingImpulsePips*100 - RAW, unclamped (can exceed 100 = structure broken)

   // E. Five-bar retracement persistence (indices 0..4 of the 25-bar context - SAME technique
   // STRONG_TREND/WEAK_TREND/CHOPPY already established)
   double   netDisplacementPips5;     // signed, telescoped sum of the 5 bars' own signedCloseToClosePips
   double   grossDisplacementPips5;   // sum(|signed 1-bar move|) - CHOPPY-protection input (Section 12)
   double   directionalConsistency5;  // 0..100 - fraction of the 5 bars whose signed move OPPOSES trendDirection (counter-trend agreement)
   double   avgBodyRatio5;
   double   followThroughScore;       // 0..100 - is the retracement still active (latest bar's relativeRange vs 5-bar average)
   double   persistenceScore;         // 0..100 - combines the above into one dominant term

   // F/G. Candle body/wick quality
   double   latestBodyRatio;
   double   candleQualityScore;       // 0..100

   // H/I. Volume participation + Volume x Pip efficiency
   bool     haveRvol;
   double   rvol;
   bool     haveRelativeRange;
   double   relativeRange;
   string   volumePipRegime;          // SAME 4-regime classifier STRONG_TREND/WEAK_TREND/CHOPPY/NEUTRAL/VOL_EXPANSION use
   double   volumePipScore;           // 0..100

   // J. Structural preservation (Section 10) - does the retracement preserve HH/HL (bullish) or LH/LL
   // (bearish) context, using the SAME leg-origin-breach geometry the retired formula already validated,
   // now measured off the closed candle instead of the running one.
   double   structuralPreservationScore; // 0..100 - 100 while retracementRatio<=100 (leg origin intact), linear falloff to 0 by ratio=200

   // Choppy protection (Section 12) - explicit factor, not merely implicit
   double   choppyProtectionScore;    // 0..100 - LOW when gross-vs-net inefficiency dominates over genuine directional retracement

   double   finalScore;               // 0..100, feeds scores[LDNA_PULLBACK] - direction-neutral IN SCORE COMPOSITION (Section 16 - trendDirection is internal context, never a hidden BUY/SELL bias)
  };

//--- 2026-09-08, explicit operator request (MARKET DNA STATE REMOVAL): EXPANSION/COMPRESSION are FULLY
//--- REMOVED. ExpansionStructure/CompressionStructure/EvaluateExpansionStructure()/
//--- EvaluateCompressionStructure() and their dedicated test suite are all deleted - source-audited
//--- before removal to confirm zero remaining consumers (only 1 live production call site each, both
//--- inside EvaluateMarketDNA(), both removed; the rest were their own dedicated test fixtures).

//--- 2026-09-04, explicit operator request ("Upgrade ALL THREE volatility-related Market DNA states
//--- directly into LIVE PRODUCTION: VOL_EXPANSION, VOL_COMPRESSION, VOLATILE" - LIVE DIRECT
//--- REPLACEMENT of all three formulas, NOT new states, NOT a shadow architecture). All three share the
//--- SAME closed-M1 25-bar/20-bar-baseline/5-bar architecture STRONG_TREND/WEAK_TREND/CHOPPY/NEUTRAL
//--- already established (BuildMarketDnaWindow30()/PriceRangeDnaResult/ComputeVolumeDna()/
//--- ClassifyVolumePipRegime() - zero new CopyRates, zero new pip/volume formula).
//---
//--- SUPERSEDED formulas (all now retired):
//--- - VOLATILITY_EXPANSION/VOLATILITY_COMPRESSION (LDNA idx11/12): single-line ci.volRatio (closed-bar
//---   only, NOT a look-ahead risk - ci.volRatio deliberately excludes the running candle by its own
//---   construction) inverse pair - the newest closed candle's range vs the mean of the OTHER closed
//---   candles in the k-window. Zero 5-bar persistence, zero volume dimension, zero canonical pip-field
//---   usage - a single-candle-only ratio exactly like STRONG_TREND's own pre-rebuild formula.
//--- - VOLATILE (LDNA idx21, 2026-08-28 original): read rates[]/ci directly and explicitly fetched the
//---   still-forming running candle via its own independent CopyRates(g_symbol,PERIOD_M1,0,1,...) call
//---   whenever ci.runningIncluded was true - a genuine look-ahead risk, the SAME defect class already
//---   found and fixed in CHOPPY/NEUTRAL's own prior formulas.
//---
//--- BOUNDARY DISCIPLINE (Section 11's explicit requirement - VOL_EXPANSION != EXPANSION,
//--- VOL_COMPRESSION != COMPRESSION, VOLATILE != STRONG_TREND):
//--- - EXPANSION (idx11)/COMPRESSION (idx12) now measure candle-body-dominance SLOPE (see
//--- ExpansionStructure/CompressionStructure's own header just above) - still a candle-CHARACTER
//--- measurement, still genuinely orthogonal to VOL_EXPANSION/VOL_COMPRESSION's RANGE-SIZE-vs-baseline
//--- axis below. A candle can have a small body/large wick (low EXPANSION) while its total range is
//--- still large vs baseline (high VOL_EXPANSION), and vice versa - the two axes remain independent.
//--- - VOLATILE below requires INSTABILITY (poor directional persistence + irregular range variability)
//---   as a MANDATORY multiplicative factor - a market with large ranges AND clean directional
//---   persistence (STRONG_TREND's own domain) is explicitly EXCLUDED by this gate, never merely
//---   de-prioritized. See EvaluateVolatileStructure()'s own header for the full formula.
struct VolExpansionStructure
  {
   bool     valid;                  // false = fewer than 25 closed M1 bars available - every field below is then 0.0/safe, never fabricated
   string   reasoning;
   datetime barTime;                // latest closed bar's own open time (shift=1)
   int      contextBars;            // actual count of closed bars used for context (<=25)

   double   latestRelativeRange;    // win[0].relativeRange - reused canonical field, no new formula
   double   avgRelativeRange5;      // mean relativeRange over the 5-bar window
   double   expansionPersistenceScore; // 0..100 - % of the 5 bars individually exceeding the 20-bar baseline (relativeRange>1.0)
   double   expansionTrendScore;    // 0..100 - is the window trending toward MORE expansion (newer bars larger than older bars), not just currently elevated
   double   latestBarScore;         // 0..100 - the latest closed bar's own contribution, weighted but never exclusive (Section 3's own "not sufficient by itself")
   double   fiveBarExpansionScore;  // 0..100 - combines persistence+trend+latest-bar into one dominant term

   bool     haveRvol;
   double   rvol;
   string   volumePipRegime;        // SAME 4-regime classifier STRONG_TREND/WEAK_TREND/CHOPPY/NEUTRAL use
   double   volumePipScore;         // 0..100 - EFFICIENT_EXPANSION strongly supports, EFFORT_WITHOUT_RESULT reduces quality, THIN_MOVEMENT/COMPRESSION strongly reduce

   double   finalScore;             // 0..100, feeds scores[LDNA_VOLATILITY_EXPANSION] - direction-neutral, no BUY/SELL branch anywhere in this struct
  };

struct VolCompressionStructure
  {
   bool     valid;
   string   reasoning;
   datetime barTime;
   int      contextBars;

   double   latestRelativeRange;    // win[0].relativeRange
   double   avgRelativeRange5;      // mean relativeRange over the 5-bar window
   double   contractionPersistenceScore; // 0..100 - % of the 5 bars individually BELOW the 20-bar baseline (relativeRange<1.0)
   double   contractionTrendScore;  // 0..100 - is the window trending toward LESS range (newer bars smaller than older bars)
   double   latestBarScore;         // 0..100 - the latest closed bar's own contribution, weighted but never exclusive
   double   fiveBarContractionScore;// 0..100 - combines persistence+trend+latest-bar into one dominant term

   bool     haveRvol;
   double   rvol;
   string   volumePipRegime;
   double   volumePipScore;         // 0..100 - COMPRESSION regime strongly supports; EFFICIENT_EXPANSION/THIN_MOVEMENT strongly reduce (real displacement contradicts compression)

   double   finalScore;             // 0..100, feeds scores[LDNA_VOLATILITY_COMPRESSION] - direction-neutral
  };

//--- Output of EvaluateVolatileStructure() - HIGH/UNSTABLE volatility: elevated range magnitude AND
//--- irregular/unstable recent behavior (poor directional persistence + range variability), as a
//--- mandatory multiplicative gate - a market with large ranges but CLEAN directional persistence
//--- (STRONG_TREND's own domain) is explicitly excluded, never merely de-prioritized (Section 5/K).
//--- Direction-neutral by construction: no BUY/SELL branch, no direction field. See
//--- EvaluateVolatileStructure()'s own header for the full mathematical definition of every field.
struct VolatileStructure
  {
   bool     valid;                  // false = fewer than 25 closed M1 bars available - every field below is then 0.0/safe, never fabricated
   string   reasoning;
   datetime barTime;                // latest closed bar's own open time (shift=1)
   int      contextBars;            // actual count of closed bars used for context (<=25)

   double   avgRelativeRange5;      // mean relativeRange over the 5-bar window - ABSOLUTE magnitude measurement
   double   magnitudeScore;         // 0..100 - elevated range vs the 20-bar baseline, averaged over 5 bars (not one candle)
   double   rangeVariabilityScore;  // 0..100 - coefficient-of-variation of the 5-bar rangePips (size irregularity)
   double   directionalConsistencyScore; // 0..100 - SAME metric STRONG_TREND/WEAK_TREND compute (fraction agreeing with net direction) - LOW consistency supports VOLATILE
   double   instabilityScore;       // 0..100 - blends rangeVariabilityScore + (100-directionalConsistencyScore)
   bool     haveRvol;
   double   rvol;
   double   participationScore;     // 0..100 - elevated volume participation supports VOLATILE (context, not a gate)
   double   finalScore;             // 0..100, feeds scores[LDNA_VOLATILE] - Clamp0to100((magnitude/100)*(instability/100)*100), modulated by participation
  };

//--- 2026-09-04, explicit operator request ("Upgrade NEUTRAL into a materially stronger LIVE
//--- production Market DNA state" - LIVE DIRECT REPLACEMENT of its formula, NOT a new state, NOT a
//--- shadow, NOT split into NEUTRAL_BUY/NEUTRAL_SELL). Output of EvaluateNeutralStructure() - a
//--- POSITIVELY measured balanced/indecisive market: low net directional displacement DESPITE
//--- meaningful two-sided gross movement + balanced bull/bear bar count + balanced bull/bear body
//--- effort + moderate (not necessarily tiny) body/wick character + volume participation that is NOT
//--- producing sustained directional displacement. Measured on the SAME closed-M1 25-bar/20-bar-
//--- baseline/5-bar architecture STRONG_TREND/WEAK_TREND/CHOPPY already established
//--- (BuildMarketDnaWindow30()/PriceRangeDnaResult/ComputeVolumeDna()/ClassifyVolumePipRegime() - zero
//--- new CopyRates, zero new pip/volume formula).
//---
//--- SUPERSEDED formula (2026-08-28 version, now retired): read rates[]/ci directly and explicitly
//--- folded in the still-forming/running M1 candle in TWO places - sidewaysScore's own netDisplacement
//--- (via ci.newestClose when ci.runningIncluded) and noBreakoutScore's own excursion (via
//--- ci.newestHigh/ci.newestLow, unconditionally) - a genuine look-ahead risk, the SAME defect found and
//--- fixed in CHOPPY's own prior formula. That formula also had ZERO volume dimension (ComputeVolumeDna()
//--- was never called) and ZERO canonical pip-field usage (bodyPips/rangePips/signedCloseToClosePips
//--- were never read) - purely ci-derived window-level statistics with no per-bar directional-balance or
//--- effort-balance measurement, which is why "NEUTRAL = other states scored low" was a structurally
//--- real risk for it (Phase 2's own explicit warning this replacement is designed against).
struct NeutralStructure
  {
   bool     valid;                    // false = fewer than 25 closed M1 bars available - every field below is then 0.0/safe, never fabricated
   string   reasoning;
   datetime barTime;                  // latest closed bar's own open time (shift=1)
   int      contextBars;              // actual count of closed bars used for context (<=25)

   // A. Low net directional displacement (despite meaningful gross movement - Phase 5A's own
   // explicit "do NOT treat simply small movement as automatically neutral" requirement)
   double   grossMovePips;            // sum(|signed 1-bar move|) across the 5 bars - SAME technique CHOPPY already established
   double   netMovePips;              // |sum(signed 1-bar move)| across the SAME 5 bars
   double   netVsBaselineScore;       // 0..100 - net displacement normalized against the 20-bar baseline range (LOW net = HIGH score)
   double   twoSidedGrossScore;       // 0..100 - gross movement normalized against the SAME baseline (must be MEANINGFUL, not near-zero, to earn this positively - distinguishes genuine balance from compression)
   double   lowNetDisplacementScore;  // 0..100 - combines the two above: rewards LOW net WITH real gross movement, not small movement alone

   // B. Directional balance - bull/bear BAR COUNT balance across the 5-bar window (distinct from
   // STRONG/WEAK_TREND/CHOPPY's own "consistency WITH the net direction" metric - this measures
   // balance WITHOUT reference to which side the net move happens to favor)
   int      bullBars5;
   int      bearBars5;
   double   directionalBalanceScore;  // 0..100 - 100 at a perfect 50/50-ish split, falls off as one side dominates

   // C. Buy/sell effort balance - average bullish-bar body pips vs average bearish-bar body pips
   double   avgBullBodyPips5;
   double   avgBearBodyPips5;
   double   effortBalanceScore;       // 0..100 - 100 when bull/bear average body effort is closest to equal

   // D. Body/wick character - moderate bodyRatio (NOT required tiny - Phase 5D's own explicit
   // "NEUTRAL should not require every candle to have tiny bodies") + non-extreme close location
   double   avgBodyRatio5;
   double   avgCloseExtremity5;       // 0..100 - |closeLocation-0.5|*200, averaged over the 5 bars; LOW = candles closing mid-range (indecisive), not at either extreme
   double   candleCharacterScore;     // 0..100 - rewards moderate body/non-extreme close, without penalizing meaningful (non-tiny) bodies

   // E/F. Volume participation + Volume x Pip relationship - reused ComputeVolumeDna()/
   // ClassifyVolumePipRegime(), context not a gate, direction-neutral
   bool     haveRvol;
   double   rvol;
   bool     haveRelativeRange;
   double   relativeRange;            // win[0].relativeRange - reused canonical field
   string   volumePipRegime;          // SAME 4-regime classifier STRONG_TREND/WEAK_TREND/CHOPPY use
   double   volumePipScore;           // 0..100 - EFFICIENT_EXPANSION (participation producing real directional displacement) scores LOW; balanced/non-displacing participation scores HIGH

   double   finalScore;               // 0..100, feeds scores[LDNA_NEUTRAL] - direction-neutral, no BUY/SELL branch anywhere in this struct
  };

//--- 2026-09-04, explicit operator request ("Upgrade Market DNA state CHOPPY into a stronger
//--- production-grade M1 scalping regime detector" - LIVE DIRECT REPLACEMENT of its formula, NOT a new
//--- state, NOT a shadow, NOT CHOPPY_BUY/CHOPPY_SELL). Output of EvaluateChoppyStructure() -
//--- direction-neutral two-sided-noise regime: repeated directional alternation + low net displacement
//--- relative to gross movement + no sustained directional run, measured on the SAME closed-M1
//--- 25-bar/20-bar-baseline/5-bar architecture STRONG_TREND/WEAK_TREND already established
//--- (BuildMarketDnaWindow30()/PriceRangeDnaResult/ComputeVolumeDna() - zero new CopyRates, zero new
//--- pip/volume formula).
//---
//--- SUPERSEDED formula (2026-08-28 version, see the retired ChoppyStructure/EvaluateChoppyStructure
//--- this replaces): read rates[]/ci directly and explicitly folded in the still-forming/running M1
//--- candle whenever ci.runningIncluded was true (shift 0) - a genuine look-ahead risk this task
//--- explicitly forbids ("No running candle. No shift 0. The latest candle used by CHOPPY must be
//--- shift 1."). That formula's own 4-factor design (reversalEvidence x directionalInefficiency x
//--- nonTrend x continuationFailure) is CONCEPTUALLY preserved below (alternation + gross/net
//--- inefficiency + no-sustained-run are still first-class components) but re-derived entirely from the
//--- closed-bar win[]/PriceRangeDnaResult window, plus two genuinely new dimensions this task's spec
//--- explicitly requires and the old formula never measured at all: wick/noise behavior via the
//--- existing bodyRatio field, and Volume x Pip participation via ComputeVolumeDna() (the old formula
//--- had no volume input whatsoever).
struct ChoppyStructure
  {
   bool     valid;                     // false = fewer than 25 closed M1 bars available - every field below is then 0.0/safe, never fabricated
   string   reasoning;
   datetime barTime;                   // latest closed bar's own open time (shift=1)
   int      contextBars;               // actual count of closed bars used for context (<=25)

   // Five-bar chop persistence (Section 5)
   int      alternationCount;          // sign changes across the 5-bar sequence (max 4)
   double   chopAlternationScore;      // 0..100 - alternationCount/4, HIGH = frequent reversal
   double   directionalConsistencyScore; // 0..100 - mirrors STRONG/WEAK_TREND's own metric, but here LOW consistency (one-sided run) REDUCES chop
   double   grossMovePips;             // sum(|signed 1-bar move|) across the 5 bars
   double   netMovePips;               // |sum(signed 1-bar move)| across the SAME 5 bars
   double   grossNetInefficiencyScore; // 0..100 - 100*(1-net/gross), SafeDiv-guarded - HIGH = large gross, small net (Section 5E)
   double   fiveBarDisplacementScore;  // 0..100 - combines alternation + gross/net inefficiency (the dominant persistence-side term)

   // Latest closed-bar wick/noise (Section 9 - multi-bar gated, single candle alone is NEVER sufficient)
   double   latestBodyRatio;           // 0..100, win[0].bodyRatio - reused canonical field, no new formula
   double   avgBodyRatio5;             // mean bodyRatio across the SAME 5 bars
   double   noiseScore;                // 0..100, 100-avgBodyRatio5 - MULTI-BAR wick proportion, never a single-candle read alone

   // Volume x Pip relationship (Section 7/8) - context, direction-neutral, reused ComputeVolumeDna()
   bool     haveRvol;
   double   rvol;
   bool     haveRelativeRange;
   double   relativeRange;             // win[0].relativeRange - reused canonical field
   string   volumePipRegime;           // SAME 4-regime classifier STRONG_TREND/WEAK_TREND use
   double   volumePipScore;            // 0..100 - HIGH volume + HIGH gross + LOW net rewarded; directional persistence regimes excluded below

   double   finalScore;                // 0..100, feeds scores[LDNA_CHOPPY] - direction-neutral, no BUY/SELL branch anywhere in this struct
  };

//--- 2026-08-25, Phase 1 (explicit operator request, SHADOW/LOG-ONLY): output of
//--- EvaluateStrongUptrendShadow() - a fully independent structural DNA calculation, read by nothing
//--- except its own diagnostic log line. Never enters scores[]/CalibrateMarketDNAScores()/g_dnaState/
//--- CurrentRegimeAllowed()/Entry Approval/execution. All *Score/*Confidence fields are 0..100; the
//--- three JSON-fragment string fields are pre-built here so the log call site stays a simple append.
struct StrongUptrendShadow
  {
   int    swingHighCount;         // count AFTER zigzag cleanup (alternating sequence)
   int    swingLowCount;
   double hhScore;
   double hlScore;
   double structuralContinuity;
   double pullbackScore;
   double evidenceConfidence;     // 0..1
   double structuralScore;
   double runningContinuationScore;
   double rawScore;               // STRONG_UPTREND_RAW_SCORE - diagnostic only, never calibrated/competed
   bool   haveLatestHH;
   double latestConfirmedHH;
   bool   haveLatestHL;
   double latestConfirmedHL;
   bool   liveExtension;          // running candle high > latestConfirmedHH (unconfirmed)
   bool   liveBreakdown;          // running candle low  < latestConfirmedHL (unconfirmed)
   string swingStructureJson;     // e.g. [{"type":"HL","price":8000.00},...] chronological, post-cleanup
   string hhComplianceJson;       // e.g. [1,1,0]
   string hlComplianceJson;
   string pullbackPctJson;        // e.g. [50.00,25.00,30.00]
  };

//--- 2026-08-25, Phase 1 (explicit operator request, SHADOW/LOG-ONLY): bearish structural mirror of
//--- StrongUptrendShadow, output of EvaluateStrongDowntrendShadow(). Same Phase 1 safety statement
//--- applies verbatim - read by nothing except its own diagnostic log line.
struct StrongDowntrendShadow
  {
   int    swingHighCount;
   int    swingLowCount;
   double lhScore;
   double llScore;
   double structuralContinuity;
   double pullbackScore;
   double evidenceConfidence;
   double structuralScore;
   double runningContinuationScore;
   double rawScore;
   bool   haveLatestLH;
   double latestConfirmedLH;
   bool   haveLatestLL;
   double latestConfirmedLL;
   bool   liveExtension;          // running low  < latestConfirmedLL (bearish extension, unconfirmed)
   bool   liveBreakdown;          // running high > latestConfirmedLH (bullish threat to structure, unconfirmed)
   string swingStructureJson;
   string lhComplianceJson;
   string llComplianceJson;
   string pullbackPctJson;
  };

//--- 2026-08-25, Phase 1 (explicit operator request, DNA #21 "UPTREND"): output of
//--- EvaluateUptrendShadow(). Same field shape as StrongUptrendShadow (bullish direction, same
//--- swing/continuity math) - the only formula difference is pullbackScore's tolerance-band curve
//--- (see EvaluateUptrendShadow()'s own header). Same Phase 1 safety statement applies verbatim.
struct UptrendShadow
  {
   int    swingHighCount;
   int    swingLowCount;
   double hhScore;
   double hlScore;
   double structuralContinuity;
   double pullbackScore;          // tolerance-band score (Option C), NOT the linear STRONG_UPTREND formula
   double evidenceConfidence;
   double structuralScore;
   double runningContinuationScore;
   double rawScore;
   bool   haveLatestHH;
   double latestConfirmedHH;
   bool   haveLatestHL;
   double latestConfirmedHL;
   bool   liveExtension;
   bool   liveBreakdown;
   string swingStructureJson;
   string hhComplianceJson;
   string hlComplianceJson;
   string pullbackPctJson;
  };

//--- 2026-08-25, Phase 1 (explicit operator request, DNA #22 "DOWNTREND"): output of
//--- EvaluateDowntrendShadow(). Same field shape as StrongDowntrendShadow (bearish direction, same
//--- swing/continuity math) - the only formula difference is pullbackScore's tolerance-band curve
//--- (see EvaluateDowntrendShadow()'s own header). Same Phase 1 safety statement applies verbatim.
struct DowntrendShadow
  {
   int    swingHighCount;
   int    swingLowCount;
   double lhScore;
   double llScore;
   double structuralContinuity;
   double pullbackScore;          // tolerance-band score (Option C), NOT STRONG_DOWNTREND's linear formula
   double evidenceConfidence;
   double structuralScore;
   double runningContinuationScore;
   double rawScore;
   bool   haveLatestLH;
   double latestConfirmedLH;
   bool   haveLatestLL;
   double latestConfirmedLL;
   bool   liveExtension;
   bool   liveBreakdown;
   string swingStructureJson;
   string lhComplianceJson;
   string llComplianceJson;
   string pullbackPctJson;
  };

struct MindResult
  {
   //--- 2026-08-29, explicit operator request: Risk (#5) and Pressure (#10) REMOVED from the active
   //--- Mind architecture (a real removal, not an inert placeholder - see the historical audit finding
   //--- at EvaluateMinds()'s own header). Since the active array is now genuinely 14 elements (not 16
   //--- with 2 always-WAIT slots), array POSITION no longer equals a Mind's historical numeric identity
   //--- (e.g. array position 5 now holds "Volatility", which was historically Mind #6). `id` is that
   //--- preserved historical identity - the SAME number every existing dashboard/log reference has
   //--- always meant by "#N" - carried explicitly on every MindResult so nothing downstream (dashboard,
   //--- minds_detail.jsonl) has to guess it from array position. EvaluateMinds()'s own per-Mind
   //--- .id= literals (e.g. g_minds[5].id=6;) are the single authoritative array-position ->
   //--- historical-id mapping (the array that used to document this separately, KMIE_MIND_STABLE_ID[],
   //--- was deleted 2026-09-03 - it was never actually read, just a second copy of this mapping).
   int           id;
   string        name;
   ENUM_LITE_DIR direction;
   double        score;
   string        reasoning;
  };

//--- 2026-08-21, Entry Intelligence Step 1 (explicit operator request): Active Leg + Pullback
//--- Extreme, observational only. Uses the EA's own existing g_mindsVoteDir as its directional
//--- input - no second vote system, no new indicator. Never referenced by MaybeExecute().
enum ENUM_LITE_PULLBACK_STATE { LPB_NONE=0, LPB_ACTIVE=1 };

struct ActiveLegState
  {
   bool          active;
   ENUM_LITE_DIR direction;
   double        originPrice;
   double        extremePrice;
   datetime      originTime;
   datetime      extremeTime;
  };

struct PullbackState
  {
   ENUM_LITE_PULLBACK_STATE state;
   double                   extremePrice;  // pullbackLow (BUY) or pullbackHigh (SELL)
   datetime                 extremeTime;
   //--- 2026-08-25, Step 15.1 (explicit operator request, Trend Re-Fire Option C2): timestamp of the
   //--- most recent LPB_NONE->LPB_ACTIVE transition - i.e. when THIS pullback genuinely started, not
   //--- when it was last updated/extended. Used by EvaluateOpportunityLifecycle() to distinguish "a
   //--- pullback that predates the previous opportunity's completion" from "a truly new one," per the
   //--- explicit instruction not to treat state==LPB_ACTIVE alone as a new event.
   datetime                 activatedTime;
  };

//--- 2026-08-21, Entry Intelligence Step 2 (explicit operator request): Resumption % + 80% window
//--- (Step 10, 2026-08-21: raised from the original 50%), observation only. Consumes Step 1's
//--- g_activeLeg/g_pullback - does not recompute either.
enum ENUM_LITE_RESUMPTION_WINDOW { RESUMPTION_NO_PULLBACK=0, RESUMPTION_0_TO_80=1, RESUMPTION_OVER_80=2 };

struct ResumptionState
  {
   bool                         valid;           // false = no pullback / denominator<=0 / no price yet - NOT the same as 0%
   double                       rawPercent;       // unclamped - can go <0% or >100% if price overshoots either extreme
   double                       boundary80Price;
   ENUM_LITE_RESUMPTION_WINDOW  window;

   //--- 2026-08-24, explicit operator request: the resumption% above measures recovery back TOWARD
   //--- the trade's own direction and must never block entry, however high - a deep same-direction
   //--- resumption is confirmation, not chasing risk. The actual risk is the OPPOSITE-direction move:
   //--- how much the pullback has eaten into the active leg's own range. pullbackDepthPercent answers
   //--- that - unclamped, valid under the same guard as rawPercent above.
   //--- BUY:  PullbackDepthPercent = (ActiveHigh - CurrentPrice) / (ActiveHigh - ActiveOrigin) * 100
   //--- SELL: PullbackDepthPercent = (CurrentPrice - ActiveLow)  / (ActiveOrigin - ActiveLow)  * 100
   double                       pullbackDepthPercent;
   bool                         pullbackTooDeep;   // pullbackDepthPercent > 80.0 - this is the entry gate now
  };

//--- 2026-08-21, Entry Intelligence Step 3 (explicit operator request): Micro Resumption, observation
//--- only. Consumes g_activeLeg/g_pullback/g_resumption exactly as published - recomputes none of
//--- them. Answers "has price structurally resumed" (broken a micro turning point left behind during
//--- the recovery), not merely "has price moved away from the pullback extreme."
enum ENUM_LITE_MICRO_STATE { MICRO_NONE=0, MICRO_TRACKING=1, MICRO_ESTABLISHED=2, MICRO_CONFIRMED=3 };

//--- 2026-08-21, Continuation Engine correction (explicit operator request): which anchor this
//--- structure is built from. PULLBACK MODE (unchanged behavior) anchors to g_pullback.extremePrice.
//--- CONTINUATION MODE (new) anchors to g_activeLeg.extremePrice instead, since no pullback extreme
//--- exists yet - selected automatically from g_pullback.state, never a user input.
enum ENUM_LITE_MICRO_MODE { MICRO_MODE_NONE=0, MICRO_MODE_PULLBACK=1, MICRO_MODE_CONTINUATION=2 };

struct MicroResumptionState
  {
   ENUM_LITE_MICRO_STATE state;
   ENUM_LITE_MICRO_MODE   mode;
   ENUM_LITE_DIR          direction;
   double                 basePullbackExtreme;         // the anchor (pullback extreme in PULLBACK MODE, active-leg extreme in CONTINUATION MODE) this structure was built from - detects staleness
   double                 recoveryExtreme;              // BUY: running highest price while TRACKING; SELL: running lowest
   datetime               recoveryExtremeTime;
   double                 microHigh;                    // BUY only, valid once state>=ESTABLISHED
   double                 microLow;                     // SELL only, valid once state>=ESTABLISHED
   datetime               microExtremeTime;
   bool                   confirmed;
   double                 breakPrice;
   datetime               breakTime;
   double                 microBreakResumptionPercent;  // snapshot of g_resumption.rawPercent at the moment of the break
  };

//--- 2026-08-21, Entry Intelligence Step 4 (explicit operator request): Opportunity Lifecycle,
//--- observation only. Gives ONE structural market move a persistent identity across ticks so it is
//--- never conceptually re-treated as several opportunities just because resumption% or micro state
//--- changed. Consumes g_activeLeg/g_pullback/g_resumption/g_microResumption exactly as published -
//--- recomputes none of them.
enum ENUM_LITE_OPP_STATE
  {
   OPP_NONE=0, OPP_CREATED=1, OPP_PULLBACK=2, OPP_RESUMPTION=3, OPP_MICRO_CONFIRMED=4,
   OPP_AVAILABLE=5, OPP_EXECUTED=6, OPP_CONSUMED=7, OPP_COMPLETED=8, OPP_EXPIRED=9, OPP_INVALIDATED=10,
   //--- 2026-08-21, Continuation Engine correction (explicit operator request): parallel to
   //--- OPP_PULLBACK, for the no-pullback route - CREATED->CONTINUATION->MICRO_CONFIRMED->AVAILABLE.
   OPP_CONTINUATION=11
  };

struct OpportunityState
  {
   bool                 active;
   ulong                id;
   ENUM_LITE_DIR        direction;
   ENUM_LITE_OPP_STATE  state;

   double               originPrice;
   double               activeExtreme;
   double               pullbackExtreme;

   double               resumptionPercent;
   double               resumption80Price;

   double               microBreakPrice;
   double               microBreakResumptionPercent;

   datetime             createdTime;
   datetime             pullbackTime;
   datetime             resumptionTime;
   datetime             microConfirmationTime;
   datetime             completedTime;

   bool                 executed;              // always false in Step 4 - reserved for future Execution Integration
   bool                 consumed;               // always false in Step 4 - reserved for future Execution Integration
   bool                 extremeReachedLogged;    // internal - logs the ~100% "reached active-leg extreme" event once

   //--- Internal-only leg-identity signature (Step 4's own bookkeeping, not part of the conceptual
   //--- opportunity data). Step 1 has no ActiveLegID field, so a new leg is detected here purely by
   //--- observing g_activeLeg.direction+originTime change - never by comparing a float price alone.
   ENUM_LITE_DIR        legSignatureDirection;
   datetime             legSignatureOriginTime;

   //--- 2026-08-28, Step 15.4 (explicit operator request, Early Re-Entry): true ONLY for an
   //--- opportunity minted by EarlyReEntryEligible()'s own trigger (never for a fresh/!sameLeg
   //--- opportunity, never for a C2-minted one). Read by MaybeExecute()'s consumption hook to decide
   //--- whether a successful execution should consume one re-entry budget slot (g_reEntryCount) -
   //--- see MintReEntryOpportunity()/EvaluateOpportunityLifecycle() for where this gets set.
   bool                 isEarlyReEntryOpp;

   //--- 2026-08-28, Step 18.1 (explicit operator request, Execution Identity Telemetry): true ONLY
   //--- for an opportunity minted by C2's own structural-refire trigger (never for a fresh/!sameLeg
   //--- opportunity, never for an Early-Re-Entry mint). TELEMETRY ONLY - read solely to label
   //--- entrySource in entry_dna.jsonl/the [EXECUTION][IDENTITY] log; nothing reads this to make a
   //--- trading decision, and C2's own trigger conditions are completely untouched by this field.
   bool                 isC2Refire;
  };

//--- 2026-08-21, Entry Intelligence Step 5 (explicit operator request): Extension Engine, observation
//--- only. Measures how far CurrentPrice has moved BEYOND g_activeLeg.extremePrice - a completely
//--- different range than Step 2's resumption (PullbackExtreme -> ActiveExtreme). Independent of
//--- Steps 2/3/4: reads none of their formulas, and reads g_opportunity.id only as a diagnostic tag.
enum ENUM_LITE_EXTENSION_STATE { EXTENSION_NOT_EXTENDED=0, EXTENSION_EXTENDED=1 };

struct ExtensionState
  {
   bool                        valid;             // false = no active leg / WAIT / invalid price / zero-range leg - NOT the same as 0%
   double                      distance;
   double                      percent;            // unclamped - 100%, 200%+ are preserved as-is, never capped
   ENUM_LITE_EXTENSION_STATE   state;
   double                      activeExtreme;
   double                      activeOrigin;
   datetime                    measuredTime;
   ulong                       opportunityId;       // diagnostic mirror of g_opportunity.id only - never written back
   int                         lastLoggedMilestone;  // internal - tracks the last logged 10%-bucket to avoid per-tick spam
  };

//--- 2026-08-21, Entry Intelligence Step 6 (explicit operator request): Entry Approval Engine,
//--- observation only. A deterministic structural gate that COMBINES Steps 1-5's already-published
//--- state into one APPROVED/BLOCKED reading with a single first-failure reason. Does NOT vote
//--- direction itself (uses g_mindsVoteDir as-is), does NOT score/weight anything, and is read by
//--- nothing in the existing execution path - MaybeExecute() never looks at g_entryApproval.
enum ENUM_LITE_ENTRY_DECISION { ENTRY_BLOCKED=0, ENTRY_APPROVED=1 };

enum ENUM_LITE_ENTRY_BLOCK_REASON
  {
   ENTRY_BLOCK_NONE=0,
   ENTRY_BLOCK_WAIT_DIRECTION,
   ENTRY_BLOCK_NO_ACTIVE_LEG,
   ENTRY_BLOCK_DIRECTION_MISMATCH,
   ENTRY_BLOCK_NO_PULLBACK,
   ENTRY_BLOCK_NO_RESUMPTION,
   //--- 2026-08-24, explicit operator request: RESUMPTION_OVER_80 (same-direction recovery, i.e.
   //--- confirmation) must never block entry - kept for enum stability only, no longer emitted.
   //--- ENTRY_BLOCK_PULLBACK_TOO_DEEP replaces it as the actual gate: blocks only when the pullback
   //--- (the OPPOSITE-direction move) has eaten more than 80% of the active leg's own range.
   ENTRY_BLOCK_RESUMPTION_OVER_80,
   ENTRY_BLOCK_PULLBACK_TOO_DEEP,
   ENTRY_BLOCK_NO_MICRO_RESUMPTION,
   ENTRY_BLOCK_MICRO_DIRECTION_MISMATCH,
   ENTRY_BLOCK_INVALID_OPPORTUNITY,
   ENTRY_BLOCK_OPPORTUNITY_CONSUMED,
   ENTRY_BLOCK_OPPORTUNITY_EXPIRED,
   ENTRY_BLOCK_OPPORTUNITY_COMPLETED,
   ENTRY_BLOCK_INVALID_EXTENSION_DATA,
   //--- Entry Approval Correction (explicit operator request): the Continuation Path's own
   //--- confirmation failure. ENTRY_BLOCK_NO_PULLBACK is kept for enum stability (nothing else in
   //--- this file references it by number) but is no longer emitted anywhere - absence of a pullback
   //--- now routes to the Continuation Path instead of an automatic block.
   ENTRY_BLOCK_NO_CONTINUATION_CONFIRMATION
  };

//--- Extension is deliberately NOT a hard block yet (Step 5 defined no threshold) - this field is a
//--- diagnostic-only classification, distinct from blockReason, so EXTENSION_CAUTION never fails approval.
enum ENUM_LITE_EXTENSION_CONDITION { EXTCOND_NORMAL=0, EXTCOND_CAUTION=1, EXTCOND_INVALID=2 };

//--- Entry Approval Correction (explicit operator request): which of the two valid entry setups
//--- this cycle's reading belongs to - diagnostic/logging only, no scoring, no weighting.
enum ENUM_LITE_ENTRY_PATH { ENTRY_PATH_PULLBACK=0, ENTRY_PATH_CONTINUATION=1 };

struct EntryApprovalState
  {
   bool                           approved;
   ENUM_LITE_ENTRY_DECISION       decision;
   ENUM_LITE_DIR                  direction;
   ENUM_LITE_ENTRY_BLOCK_REASON   blockReason;
   ENUM_LITE_EXTENSION_CONDITION  extensionCondition;
   ENUM_LITE_ENTRY_PATH           path;

   ulong                          opportunityId;
   double                         resumptionPercent;
   double                         pullbackDepthPercent; // 2026-08-24: the actual gate now, see ResumptionState
   double                         extensionPercent;

   bool                           activeLegValid;
   bool                           pullbackValid;
   bool                           resumptionValid;
   bool                           microConfirmed;
   bool                           opportunityValid;
   bool                           extensionValid;

   datetime                       evaluatedTime;
  };

//--- 2026-08-31, explicit operator request (RETRY TRADE ENGINE): a genuinely SEPARATE, parallel
//--- retry path - independent from Opportunity Lifecycle/OPPORTUNITY_CONSUMED and from
//--- EarlyReEntryEligible()/"C2 Trend-Refire" (both of those are left completely untouched by this
//--- feature). This engine answers exactly one question: "after a previous trade closed because its
//--- profit-tier/trailing SL (or Break-Even lock) was hit, is the market currently strong enough to
//--- justify ONE new trade in the SAME direction?" It never reads/writes g_opportunity,
//--- g_entryApproval, g_reEntryCount, or any Opportunity Lifecycle field - it is a second, independent
//--- consumer of the SAME live g_buyVotes/g_sellVotes/g_mindsVoteDir/g_dnaState globals every other
//--- decision already reads, never a second Mind/DNA calculation.
//---
//--- Exit classification (RETRY_EXIT_TRAILING/RETRY_EXIT_BREAK_EVEN are the ONLY retry-eligible
//--- exits) is derived, per-closed-ticket, from TWO existing signals already computed elsewhere in
//--- this file, never guessed and never a new parallel SL-tracking mechanism:
//---   1. g_trailing[slot].protectionActivated (Step 9's own existing flag - true the instant a
//---      ticket's profit first reached the first profit tier and its SL was locked/moved there;
//---      see ManageOpenPositions()) - read HERE (see ClassifyRetryExit(), called from
//---      CleanupTrailingSlots() BEFORE the slot is freed) to know whether trailing/BE protection had
//---      ever activated for this ticket before it closed.
//---   2. The closed position's own deal history (HistorySelectByPosition + DEAL_REASON +
//---      DEAL_COMMENT) - the SAME technique UpdateDashboardLogs() already uses for trades.jsonl's
//---      closeDealReason field. DEAL_REASON_SL + protectionActivated=true => TRAILING (the SL that
//---      was hit was the trailing/BE-moved one, not the original). DEAL_REASON_SL +
//---      protectionActivated=false => HARD_SL (never retry-eligible). A DEAL_COMMENT containing
//---      "KMIE_EarlyExit" (CloseEarlyExitPosition()'s own literal comment string) => EARLY_EXIT
//---      (never retry-eligible), checked BEFORE the SL/TP read since Early-Exit closes via
//---      TRADE_ACTION_DEAL and its deal reason is DEAL_REASON_EXPERT, not SL/TP.
enum ENUM_RETRY_EXIT_TYPE
  {
   RETRY_EXIT_NONE = 0,
   RETRY_EXIT_TRAILING,
   RETRY_EXIT_BREAK_EVEN,   // reserved for future finer-grained distinction - current classifier
                            // reports RETRY_EXIT_TRAILING for both (protectionActivated does not
                            // distinguish tier-1/"BE" from tier-2+ ; both are equally retry-eligible
                            // per the explicit spec, so no behavior depends on this distinction today)
   RETRY_EXIT_HARD_SL,
   RETRY_EXIT_EARLY_EXIT,
   RETRY_EXIT_TP,
   RETRY_EXIT_MANUAL,
   RETRY_EXIT_UNKNOWN
  };

string RetryExitTypeName(const ENUM_RETRY_EXIT_TYPE e)
  {
   switch(e)
     {
      case RETRY_EXIT_TRAILING:   return "TRAILING";
      case RETRY_EXIT_BREAK_EVEN: return "BREAK_EVEN";
      case RETRY_EXIT_HARD_SL:    return "HARD_SL";
      case RETRY_EXIT_EARLY_EXIT: return "EARLY_EXIT";
      case RETRY_EXIT_TP:         return "TP";
      case RETRY_EXIT_MANUAL:     return "MANUAL";
      case RETRY_EXIT_UNKNOWN:    return "UNKNOWN";
      default:                    return "NONE";
     }
  }

//--- Duplicate-retry prevention (Section 8's requirement): one qualifying trailing/BE exit can
//--- produce AT MOST one retry order, no matter how many ticks the qualifying conditions remain true
//--- for afterward. Keyed by the closed ticket's own number (a MQL5 position ticket is never reused),
//--- so a genuinely NEW eligible exit (a different ticket) always gets its own fresh evaluation, while
//--- the SAME exit can never fire twice even if this candidate stays live/unconsumed for many ticks.
struct RetryEngineState
  {
   bool                   candidateActive;      // true from the moment an eligible exit is classified until a retry fires OR a new (non-retry-generated) opportunity/position makes this candidate stale
   ulong                  previousTicket;        // the closed ticket this candidate was derived from
   ENUM_LITE_DIR          previousDirection;     // BUY or SELL - the direction the retry, if any, must match
   ENUM_RETRY_EXIT_TYPE   previousExitType;      // classification at close time
   double                 previousExitPrice;     // deal price of the closing deal, diagnostic only
   //--- 2026-09-08, explicit operator request ("if Trade was Executed that point of price to when
   //--- trade closed that should be also considered in active ping and show as opportunity consumed"):
   //--- the closed candidate's OWN entry price (the opening deal's price, read via the SAME
   //--- HistorySelectByPosition()/DEAL_ENTRY_IN technique RetryDirectionFromHistory() already uses -
   //--- never a second/different history-reading method). Populated ONLY alongside previousExitPrice,
   //--- in RegisterRetryCandidate(), for the SAME candidate this whole struct already tracks - no new
   //--- candidate-arming logic, just one more field captured at the same moment.
   double                 previousEntryPrice;
   datetime               eligibleExitTime;      // when this candidate was created
   bool                   retryAlreadyExecuted;  // true the instant a retry order is sent for this candidate - blocks any further retry for the SAME candidate
  };
RetryEngineState g_retryEngine;

//--- 2026-09-08, explicit operator request ("I off the retry Engine to don't retry than why you build
//--- it under it i need this in original trade singal" / confirmed via AskUserQuestion: "Decouple it
//--- from the Retry Engine entirely - track the most recent closed trade's entry/exit from ANY
//--- original signal, regardless of exit type"): the ACTIVE_PING entry-to-exit range condition
//--- (rangeActive, see ActivePingState's own header) was originally built reusing g_retryEngine's own
//--- candidate memory - but that memory is ONLY ever populated for TRAILING/BREAK_EVEN protected
//--- exits (RegisterRetryCandidate()'s own deliberate scope), so it went stale/empty whenever recent
//--- closes were hard-SL/Early-Exit/Watcher exits instead, unrelated to whether Early Re-Entry
//--- (a DIFFERENT, already-disabled mechanism - KMIE_LITE_EARLY_REENTRY_MAX_COUNT=0) or the Retry
//--- Engine itself is enabled. This is a NEW, INDEPENDENT tracker - updated on EVERY position close
//--- from ANY exit type (hard SL, Early Exit, either Watcher, TP, EMA35-SL close/mirror, manual) -
//--- completely decoupled from g_retryEngine, EarlyReEntryEligible(), and EvaluateRetryTrade(). Never
//--- read by, or fed back into, any of those three existing systems - one-directional, ACTIVE_PING-only
//--- consumption.
struct LastClosedTradeState
  {
   bool     valid;         // has any position closed since this EA started this session
   ulong    ticket;
   ENUM_LITE_DIR direction;
   double   entryPrice;
   double   exitPrice;
   datetime closeTime;
   //--- 2026-09-09, explicit operator request (POST-LOSS SAME-DIRECTION RE-ENTRY LOCK): net realized
   //--- P&L for this closed ticket - summed across ALL deals for the position (DEAL_PROFIT+DEAL_SWAP+
   //--- DEAL_COMMISSION), SAME technique RecordRetryObservation() already uses locally (its own
   //--- realizedProfitUSD/haveProfit local variables, ~line 13095-13109) - reused here rather than
   //--- inventing a new P&L computation, and duplicated (not shared via a helper) per this file's own
   //--- established convention of small independent per-concern computations.
   double   realizedProfitUSD;
   bool     haveRealizedProfit;
  };
LastClosedTradeState g_lastClosedTrade;

//--- 2026-08-21, Entry Intelligence Step 7.2 (explicit operator request): Execution Result
//--- telemetry only. Classifies the SAME ticketsSent/ticketsWanted counters MaybeExecute() already
//--- computes - adds no new data collection beyond the per-ticket loop that already exists.
//--- Does NOT change the opportunity-consumption rule: ANY ticketsSent>0 (FULL or PARTIAL) still
//--- consumes the opportunity; only ticketsSent==0 (FAILED) leaves it AVAILABLE.
enum ENUM_LITE_EXECUTION_STATUS { EXECUTION_FAILED=0, EXECUTION_PARTIAL=1, EXECUTION_FULL=2 };

struct ExecutionResult
  {
   ENUM_LITE_EXECUTION_STATUS status;
   int                        ticketsWanted;
   int                        ticketsSent;
   ulong                      opportunityId;
   datetime                   evaluatedTime;
  };

//--- 2026-08-21, Step 9 (explicit operator request): Structural SL + Break-Even + Structural Trailing
//--- Engine, native to this file only - no Framework20/22/KMIE engine imported. Completely separate
//--- from Entry Intelligence (never reads/writes g_opportunity/g_entryApproval/Market DNA/Mind Vote).
//--- One slot per open ticket belonging to this EA's own symbol+magic.
#define KMIE_LITE_MAX_TRAILING_SLOTS 32

struct TrailingState
  {
   ulong  ticket;
   bool   active;               // slot in use
   bool   protectionActivated;  // has the $1.00 profit trigger fired for this ticket
   //--- 2026-09-09, explicit operator request (PROFIT-TIER TRAILING SL): REPURPOSED from its original
   //--- "Break-Even+$0.30 floor" meaning (confirmed via grep: that old meaning was NEVER actually
   //--- written anywhere except this field's own zero-init in AllocTrailingSlot() - stale comment, dead
   //--- semantics). Now holds the CURRENT locked SL price set by the new tier system
   //--- (ApplyProfitTierTrailingSl()) - 0.0 until the first tier fires successfully.
   double protectedSL;          // tier system's current locked SL price (0.0 = no tier lock applied yet)
   //--- 2026-09-09, explicit operator request (PROFIT-TIER TRAILING SL): highest tier NUMBER (1-based,
   //--- 1..KMIE_LITE_NEW_TRAIL_TIER_COUNT) this ticket has ever achieved; 0 = no tier reached yet.
   //--- Monotonic - only ever increases (see SelectProfitTier()'s own header for the guarantee).
   int    highestAchievedTier;

   //--- 2026-08-26, explicit operator request: Pullback Recovery Difference - a TRADE HISTORY
   //--- ANALYTICS metric only (see ManageOpenPositions()'s own header for the full state-machine
   //--- description). Reuses this same per-ticket container rather than a parallel state system -
   //--- never read by, or fed back into, any trading/SL/TP/execution decision.
   bool   pbTrackInit;              // has favorableExtreme been seeded yet (first tick since this slot was allocated)
   bool   pbInPullback;             // currently inside an adverse (against-direction) price excursion
   double pbFavorableExtreme;       // running best (most favorable) price reached since entry/last resumption
   bool   pbDetected;               // true once any pullback has ever started for this ticket (sticky)
   double pbExtremePrice;           // worst price reached during the current/most-recently-completed pullback
   bool   pbRecoveryValid;          // true once at least one pullback has fully completed (resumed) at least once
   double pbResumePrice;            // first-tick resumption price of the most recently COMPLETED pullback
   double pbRecoveryDifference;     // resumePrice - pbExtremePrice (BUY) / pbExtremePrice - resumePrice (SELL), PRICE UNITS
   double pbRecoveryDifferenceUSD;  // 2026-08-26: same value converted to USD at this ticket's own lot size (PriceDistanceToUSD())

   //--- 2026-08-28, Step 16 (explicit operator request, Running Trade Early-Exit Protection): counts
   //--- CONSECUTIVE EvaluateEarlyExit() calls (ticks, not bars) for which the adverse 18-Mind
   //--- condition has held, for THIS ticket. 0=none seen, 1=first qualifying cycle (armed, not yet
   //--- closed), capped at 2=confirmed (closes on this reading). Reset to 0 whenever the adverse
   //--- condition is not met that cycle, and explicitly whenever profit reaches the $1.00 tier (see
   //--- ManageOpenPositions()'s own reset line) - never carries stale pre-$1 state into a later dip
   //--- back under $1.00.
   int    eeAdverseConfirmCount;

   //--- 2026-09-08, explicit operator request (Early TP Watcher rework - "Set Waiting for Opposity
   //--- Candle closed another Candle open having the Weight of %50 in opposite Direction"): running
   //--- ALL-TIME most-favorable price reached since entry, for THIS trading decision (Early TP
   //--- Watcher's 50%-retracement-from-peak check below). Deliberately a NEW, SEPARATE field from
   //--- pbFavorableExtreme (Pullback Recovery Difference, Step 3) - that field is explicitly documented
   //--- as "TRADE HISTORY ANALYTICS ONLY... never read by, or fed back into, any trading/SL/TP/
   //--- execution decision", AND it resets on every pullback-resumption cycle (not a true all-time
   //--- peak) - reusing it here would both violate that documented invariant and give the wrong value
   //--- (the CURRENT LEG's favorable extreme, not the trade's all-time best). This field NEVER resets
   //--- once set except on a fresh ticket (AllocTrailingSlot()) - it only ever moves further favorable.
   bool   tpMfeInit;
   double tpMfeExtreme;
  };

//--- 2026-08-31, explicit operator request (STEP 3 - ENHANCED RETRY + PULLBACK/REVERSAL FORENSIC
//--- OBSERVATION): a SEPARATE per-ticket state container, deliberately NOT added as new fields on
//--- TrailingState above - keeps this entire feature's state additive/isolated, never risking a
//--- collision with any field SL/trailing/BE/Early-Exit code reads. Populated and read ONLY by
//--- RecordRetryForensicTick() and its own helpers (all new, all below) - no other function in this
//--- file ever reads or writes g_retryForensic[]. Nothing here feeds back into any trading decision:
//--- this is pure observation state, mirroring TrailingState/g_trailing[]'s own slot-per-open-ticket
//--- convention (KMIE_LITE_MAX_TRAILING_SLOTS reused for the same array size - this EA never holds
//--- more concurrent tickets than that pool already assumes).
struct RetryForensicState
  {
   ulong    ticket;
   bool     active;

   //--- Identity/observation-event bookkeeping (Phase 13/14) - observationEventId groups tickets that
   //--- opened in the SAME market moment (same M1 bar open time + same direction) so downstream
   //--- analysis can deduplicate "N tickets" down to "1 real event," exactly the gap Step 2 found.
   //--- Built from data already available at slot-allocation time (position open time, direction) -
   //--- never a new identity system, never touching entry_dna.jsonl's own existing writer.
   string   observationEventId;
   datetime entryTime;
   int      entryDirection; // +1 BUY, -1 SELL (mirrors ManageOpenPositions()'s own 'direction' convention)
   double   entryPriceObs;  // POSITION_PRICE_OPEN, read once at first observation - diagnostic mirror only

   //--- Phase 5 - opposite-candle tracking. Only advances on a GENUINE new closed M1 candle (detected
   //--- via lastClosedBarTime, never on every tick) - direction-agnostic storage (true=bullish
   //--- close>open, false=bearish), interpreted as "opposite" relative to entryDirection at read time.
   datetime lastClosedBarTimeSeen;
   int      closedCandlesSinceEntry;
   int      oppositeCandleCount;       // running count since entry, closed candles only
   bool     haveOpp1; bool opp1Bullish; double opp1Price; double opp1ProfitUSD; int opp1BuyVotes; int opp1SellVotes; ENUM_LITE_DNA opp1Dna; datetime opp1Time;
   bool     haveOpp2; bool opp2Bullish; double opp2Price; double opp2ProfitUSD; int opp2BuyVotes; int opp2SellVotes; ENUM_LITE_DNA opp2Dna; datetime opp2Time;
   bool     twoOppositeCandlesConfirmed;

   //--- Phase 7/8 - danger-point-first-triggered bookkeeping. Each is a ONE-SHOT timestamp: set the
   //--- first tick/candle the condition is observed true for this ticket, never overwritten afterward
   //--- (so "how long before hard SL" can be measured later). 0 = never observed.
   datetime dpMindFlipAgainstTime;
   datetime dpVotesBelow9Time;
   datetime dpVotesBelow8Time;
   datetime dpVotesBelow7Time;
   datetime dpTwoOppositeCandlesTime;
   datetime dpDnaChangedTime;
   ENUM_LITE_DNA dpFirstDna; // DNA observed at first tick, to detect "DNA changed" (dpDnaChangedTime)
   bool          haveDpFirstDna;

   //--- Phase 8 - bounded Mind-vote transition log (winning-side vote count only, direction-tagged).
   //--- Records a NEW entry only when winningVotes or mindDirection actually CHANGES from the previous
   //--- recorded entry - never one row per tick (would be unbounded/expensive). Capped at
   //--- KMIE_RETRY_FORENSIC_MAX_TRANSITIONS; once full, further changes simply stop being recorded
   //--- (the log is diagnostic sampling, not a guaranteed-complete audit trail) rather than silently
   //--- wrapping and losing the EARLY, most decision-relevant transitions.
   int      transitionCount;

   //--- Phase 6 - classification inputs mirrored from g_trailing[slot] at last observation (read-only
   //--- copies for JSONL convenience - the SOURCE OF TRUTH remains g_trailing[slot].pb* fields,
   //--- these are never written back to it).
   bool     lastLoggedProtectionActivated;

   //--- Throttle - one retry_forensic.jsonl write per CLOSED M1 candle per open ticket (Phase 4's own
   //--- "existing safe dashboard logging cadence" instruction), never per tick.
   datetime lastForensicWriteBarTime;

   //--- 2026-08-31, explicit operator request (STEP 5 - RETRY FORENSIC DECISION-POINT DATA
   //--- COLLECTION): a SEPARATE, purely additive per-decision-point log (retry_forensic_decisions.jsonl,
   //--- schemaVersion 2) alongside the existing retry_forensic.jsonl - same slot, same ticket, same
   //--- read-only source globals, never a second trading-affecting computation. These fields track
   //--- ONLY what's needed to (a) emit one decision record per closed candle OR per genuine state
   //--- transition (Section 11's explicit list - never a duplicate row for the same instant), and
   //--- (b) classify each ticket's FIRST meaningful deterioration point (Section 8), one-shot, never
   //--- overwritten once set.
   int      decisionSeq;               // monotonically increasing per-ticket decision index -> decisionEventId
   datetime lastDecisionWriteBarTime;   // candle-cadence throttle, mirrors lastForensicWriteBarTime but tracked
                                        // separately since a transition can force an extra write mid-candle
   //--- Last-logged-value snapshot, used ONLY to detect the Section 11 transition list - never read by
   //--- any trading decision, never written back to g_trailing[]/g_opportunity/anything live.
   bool     haveLastSnapshot;
   int      lastSnapVotesTier;    // 13/12/11/10/9/0 - the highest wouldRetryN threshold cleared last write
   bool     lastSnapSameDirPass;
   bool     lastSnapProtectionActivated;
   bool     lastSnapTwoOpposite;
   ENUM_LITE_DNA lastSnapDna;

   //--- Section 8 - first-danger classification, one-shot (first qualifying decision point only).
   bool     haveFirstDanger;
   string   firstDangerType;      // "VOTES_BELOW_9" / "VOTES_BELOW_8" / "VOTES_BELOW_7" /
                                   // "TWO_OPPOSITE_CANDLES" / "MIND_FLIP" / "NONE"
   datetime firstDangerTime;
   double   firstDangerProfitUSD;
   double   firstDangerSLDistance;
   int      firstDangerVotes;
   ENUM_LITE_DNA firstDangerDna;

   //--- 2026-08-31, explicit operator request (STEP 7 - RETRY / PROTECTION MARKET-EVENT LIFECYCLE
   //--- ANALYSIS): a THIRD, purely additive log (retry_lifecycle_forensics.jsonl, schemaVersion 3)
   //--- alongside the existing retry_forensic.jsonl and retry_forensic_decisions.jsonl - same slot,
   //--- same read-only source globals/g_trailing[]/g_retryForensic[] fields already populated by
   //--- RecordRetryForensicTick()/RecordRetryDecisionPoint() (both called earlier this same tick),
   //--- never a second independent computation of anything those functions already derived.
   //--- Tracks the CURRENT diagnostic lifecycle stage (Section 2) and CURRENT diagnostic danger level
   //--- (Section 5) so RecordRetryLifecycleTransition() can detect a stage/level CHANGE and log it
   //--- exactly once (Section 18's "avoid duplicate identical records" instruction) - never every tick.
   string   lifecycleStage;          // one of Section 2's ENTRY/HEALTHY/VOTE_DETERIORATION/... values
   int      dangerLevel;             // 0-4, Section 5's DANGER_LEVEL_0..4 diagnostic bins
   int      lifecycleTransSeq;       // monotonically increasing per-ticket transition index -> decisionEventId reuse
   datetime lastLifecycleWriteBarTime;

   //--- "State immediately before exit" snapshot (Section 8/9) - overwritten on EVERY
   //--- RecordRetryLifecycleTransition() call (never just on write-throttled ticks) so whatever this
   //--- holds at the instant CleanupTrailingSlots() detects the position is gone is genuinely the LAST
   //--- observed state, not a stale throttled one. Read-only mirror, never fed back into any decision.
   ENUM_LITE_DNA lastDna; double lastDnaScore;
   int      lastBuyVotes; int lastSellVotes; int lastWaitVotes; int lastWinningVotes;
   ENUM_LITE_DIR lastMindDir; bool lastSameDirPass;
   bool     lastTwoOpposite; int lastOppositeCandleCount; bool lastMindFlipAgainst; bool lastDnaChanged;
   double   lastProfitUSD; double lastCurrentSL; double lastSLDistance;
   int      lastBarsSinceEntry; int lastSecondsSinceEntry;

   //--- 2026-09-01, explicit operator request (STEP 9 - RETRY ENGINE FINAL DATA-ACCUMULATION):
   //--- earliest-danger-to-HARD_SL timing (Section 15). One-shot: the FIRST tick this ticket's
   //--- dangerLevel (Step 7's own field) reaches >=1, captured here so RecordRetryLifecycleExit() can
   //--- compute "time/distance from earliest danger to HARD_SL" at close - never inferred after the
   //--- fact, always the genuinely-observed first crossing.
   bool     haveEarliestDanger;
   datetime earliestDangerTime;
   double   earliestDangerPrice;
   double   earliestDangerSLDistance;
  };
#define KMIE_RETRY_FORENSIC_MAX_TRANSITIONS 40
int    g_retryForensicTransVotes[KMIE_LITE_MAX_TRAILING_SLOTS][KMIE_RETRY_FORENSIC_MAX_TRANSITIONS];
int    g_retryForensicTransDir[KMIE_LITE_MAX_TRAILING_SLOTS][KMIE_RETRY_FORENSIC_MAX_TRANSITIONS];
datetime g_retryForensicTransTime[KMIE_LITE_MAX_TRAILING_SLOTS][KMIE_RETRY_FORENSIC_MAX_TRANSITIONS];
RetryForensicState g_retryForensic[KMIE_LITE_MAX_TRAILING_SLOTS];

//====================================================================
// 2026-09-12, explicit operator request (TRADE MANAGEMENT ENGINE ARCHITECTURAL REPLACEMENT): a NEW,
// SEPARATE per-ticket state container - deliberately NOT added as new fields on TrailingState (which
// stays exactly as-is, still consumed by the retained-but-disconnected legacy functions and the
// unrelated Pullback Recovery Difference/Early-Exit-confirmation/Early-TP-Watcher-MFE analytics that
// still run every tick). Mirrors g_trailing[]/g_retryForensic[]'s own established
// "KMIE_LITE_MAX_TRAILING_SLOTS-sized pool, own Find/Alloc helpers" convention exactly - this EA never
// holds more concurrent tickets than that pool already assumes, so no new size constant is needed.
//====================================================================
enum ENUM_TME_STATE
  {
   TME_STATE_EXPANSION = 0,   // momentum/structure/volume/EMA-alignment agree and are strengthening - widen trailing room, extend TP
   TME_STATE_DECELERATION = 1,// momentum fading / mixed confirmation - tighten moderately, freeze TP
   TME_STATE_EXHAUSTION = 2   // momentum/structure clearly deteriorating or reversing - tighten aggressively, freeze TP
  };

struct TradeManagementState
  {
   ulong    ticket;
   bool     active;
   double   originalSL;        // captured once, at entry (SendMarketOrder()/RecordEntryDna() time) - NEVER recomputed afterward
   double   originalRisk;      // abs(entryPrice-originalSL) at entry, NEVER recomputed afterward - the fixed "1R" unit for this ticket's whole life
   double   currentTP;         // this engine's own last-known-good broker-side TP (mirrors PositionGetDouble(POSITION_TP), kept in sync by ApplyManagementSlTp())
   int      tpStage;           // extension count - 0 = still the original ComputeInitialTP() value, incremented on every successful TP extension
   int      managementState;   // ENUM_TME_STATE, cast to int for easy JSONL logging (0=EXPANSION,1=DECELERATION,2=EXHAUSTION)
   double   lastManagementScore;   // last computed ManagementStateEvaluator() score - diagnostic/logging only
   datetime lastModifyBarTime;     // no-tick-chasing throttle latch - last CLOSED M1 bar time at which an actual OrderSend() modification was sent
   //--- 2026-09-14, explicit operator request (720-BAR STRUCTURAL SL): new per-ticket state, added
   //--- alongside the existing fields above (none of which are removed or renamed).
   bool     structuralSlArmed;     // true once price has broken above/below the FULL 720-bar range at least once for this ticket - the SL jump to the opposite 720-bar extreme fires ONCE (per the "jump then stay" design), never re-evaluated after arming
   //--- 2026-09-16, explicit operator request ("remove the [20-bar peak-and-reverse]... doing almost all
   //--- of the automatic cutting"): the 20-bar TP peak-and-reverse exit mechanism has been fully removed
   //--- (EvaluateTpPeakAndReverseExit(), its call site, and its self-tests) - confirmed via AskUserQuestion
   //--- to keep the $2-$5 Quick Profit Take and everything else untouched. The fields that mechanism owned
   //--- (tpReferencePrice/bestPriceReached/bestPriceInitialized/entryBarTime) are removed along with it -
   //--- nothing else in this struct ever read them.
   //--- 2026-09-15, explicit operator request ("SL trailing should be considering by last 15 bars ...
   //--- trailing should be getting closed when running candle closed ... trailing should [use the]
   //--- new closed 15 bars"): REPLACES the ATR-multiple trailing candidate inside AdaptiveSlEngine() with
   //--- the SAME 15-CLOSED-bar structural method ComputeInitialSL() already uses at entry (confirmed via
   //--- AskUserQuestion) - recalculated only once per NEW CLOSED bar (not every tick), ratchet-only
   //--- (never widens), same Inp_StructuralSLExtraBufferUSD buffer as the initial SL. The 720-bar jump
   //--- is untouched (kept as-is, confirmed via AskUserQuestion) - this field only latches the bar-close
   //--- boundary for the NEW 15-bar trail specifically, independent of lastModifyBarTime above (which
   //--- only latches when a modification was actually SENT - a ratchet-only trail can correctly decide
   //--- NOT to modify on many consecutive closed bars, so a separate "last EVALUATED bar" latch is
   //--- required to avoid re-reading CopyRates() every single tick for no reason).
   datetime last15BarTrailEvalBarTime; // last CLOSED M1 bar time at which the 15-bar structural trail candidate was last (re)computed
   //--- 2026-09-23, Swing-Level Profit Take (see Inp_SwingLevelProfitTakeEnabled's own header for the
   //--- full design/data-study rationale). Searched at most once per NEW CLOSED bar (same throttle
   //--- convention as last15BarTrailEvalBarTime above) since the widening 8-window search is more
   //--- expensive than a single CopyRates() call - re-searching every tick would be wasteful and the
   //--- underlying swing structure cannot meaningfully change intra-bar anyway.
   bool     swingLevelFound;            // true once a qualifying (>=Inp_SwingLevelMinUSD away, not yet reached) level has been found for this ticket
   double   swingLevelTarget;           // the found level's own price (0.0 = not found/not yet searched)
   bool     swingLevelSearchExhausted;  // true once all 8 window sizes (up to 1280 bars) were tried and NONE qualified - permanently latched, Quick Profit Take becomes this ticket's sole exit mechanism from here on
   datetime swingLevelLastSearchBarTime; // last CLOSED M1 bar time this ticket's own search last ran
   //--- 2026-09-24, explicit operator request ("if there signal for one ticket than it should be applied
   //--- to all the open trade in TP and SL as well") - the batch identifier this ticket belongs to, so
   //--- ongoing SL/TP updates can be propagated to every OTHER still-open sibling sharing the same value
   //--- (see PropagateSlTpToSiblings()'s own header). Set ONLY for a genuinely ORIGINAL entry
   //--- (entrySource=="ORIGINAL" - i.e. opened via MaybeExecute()'s own batch-send loop) to this batch's
   //--- g_opportunity.id at entry time (SendMarketOrder()'s own allocation block) - 0 (never a real
   //--- opportunity id, which starts at 1 per g_nextOpportunityId's own init) for every OTHER entry type
   //--- (REVERSE_FIRE/EARLY_REENTRY/C2_REFIRE/the Retry Engine/M5 Swing Reverse Trade), all of which are
   //--- always single, independent trades that must NEVER be synced with an unrelated batch's siblings
   //--- just because g_opportunity.id happened to still hold some other batch's stale value at that
   //--- moment - same "0 = not applicable" sentinel convention as this struct's own currentTP/
   //--- swingLevelTarget fields use for their own "not yet set" state.
   ulong    batchOpportunityId;
  };
TradeManagementState g_tme[KMIE_LITE_MAX_TRAILING_SLOTS];

//--- Mirrors FindTrailingSlot()/AllocTrailingSlot()'s own exact pattern (see those functions, further
//--- down this file, for the established convention being copied here).
int FindTmeSlot(const ulong ticket)
  {
   for(int i=0;i<KMIE_LITE_MAX_TRAILING_SLOTS;i++)
      if(g_tme[i].active && g_tme[i].ticket==ticket) return i;
   return -1;
  }

int AllocTmeSlot(const ulong ticket)
  {
   for(int i=0;i<KMIE_LITE_MAX_TRAILING_SLOTS;i++)
      if(!g_tme[i].active)
        {
         g_tme[i].active              = true;
         g_tme[i].ticket              = ticket;
         g_tme[i].originalSL          = 0.0;
         g_tme[i].originalRisk        = 0.0;
         g_tme[i].currentTP           = 0.0;
         g_tme[i].tpStage             = 0;
         g_tme[i].managementState     = (int)TME_STATE_EXPANSION; // fresh ticket starts optimistic - EXPANSION default per spec
         g_tme[i].lastManagementScore = 0.0;
         g_tme[i].lastModifyBarTime   = 0;
         g_tme[i].structuralSlArmed   = false; // 720-bar breakout SL jump has not fired yet for this ticket
         g_tme[i].last15BarTrailEvalBarTime = 0; // 15-bar structural trail not yet evaluated for this ticket
         g_tme[i].swingLevelFound            = false;
         g_tme[i].swingLevelTarget           = 0.0;
         g_tme[i].swingLevelSearchExhausted  = false;
         g_tme[i].swingLevelLastSearchBarTime = 0;
         g_tme[i].batchOpportunityId          = 0; // 0 = no batch membership yet - set explicitly right after allocation for a genuinely ORIGINAL entry only (see this field's own header)
         return i;
        }
   return -1; // pool exhausted this cycle - skip, try again next tick (same convention as g_trailing[])
  }

//--- 2026-09-01, explicit operator request (STEP 9 - RETRY ENGINE FINAL DATA-ACCUMULATION, Section
//--- 14 - POST-PROTECTION CONTINUATION): a SEPARATE small pool, independent of g_trailing[]/
//--- g_retryForensic[] (whose slots are freed the instant a ticket closes) - this pool exists
//--- specifically to keep observing PRICE ONLY for a bounded window AFTER a protected exit, since the
//--- question "did the market keep moving the trade's direction after protection was reached" can
//--- only be answered by watching price AFTER the ticket is already gone. Read-only: stores only the
//--- exit price/direction/time already known at close (from RecordRetryLifecycleExit()) plus a running
//--- best-observed-since-exit price, never a position/order reference of any kind - cannot open, close,
//--- or modify anything. Capped at KMIE_LITE_MAX_TRAILING_SLOTS entries (same pool-size convention as
//--- every other forensic array in this file) with a fixed observation window
//--- (KMIE_STEP9_CONTINUATION_WINDOW_SECONDS) after which the entry is finalized and freed.
#define KMIE_STEP9_MAX_CONTINUATION_SLOTS 32
#define KMIE_STEP9_CONTINUATION_WINDOW_SECONDS 900 // 15 minutes - a documented diagnostic window, not a trading rule
struct RetryPostExitContinuation
  {
   bool     active;
   ulong    ticket;
   string   observationEventId;
   int      direction;         // +1 BUY, -1 SELL - the ORIGINAL trade's own direction
   double   exitPrice;
   datetime exitTime;
   double   bestFavorablePrice; // most favorable price observed since exit (running extreme)
   double   worstAdversePrice;  // most adverse price observed since exit (running extreme)
   bool     written;            // one-shot: has the finalized continuation record been written yet
  };
RetryPostExitContinuation g_retryPostExit[KMIE_STEP9_MAX_CONTINUATION_SLOTS];

//--- 2026-09-02, explicit operator request (EARLY SL WATCHER SIGNAL QUALITY - "if SL Watcher Don't
//--- cut the early than it should hit SL or Not... According Next 3 Closed Price mind Actual Price
//--- when trade was Excute by bot and Mention in Trade History as Good Signal / Bad Signal"): a
//--- SEPARATE small pool, independent of g_trailing[] (whose slot is freed the instant a ticket
//--- closes, whether via real SL/TP or the Watcher) - mirrors RetryPostExitContinuation's own
//--- established pattern just above for the exact same reason: this needs to keep observing price for
//--- up to 3 closed M1 candles after entry EVEN IF the real SL/TP already closed the position before
//--- that window elapsed. Two distinct terminal outcomes, both one-shot, both written to
//--- sl_watcher.jsonl (see FinalizeSlWatcherSignal_Cut()/_Classified() below):
//---   - The Early SL Watcher cuts the trade first -> watcherCutEarly=true, signalQuality=null (this
//---     classifier never runs for that ticket - explicit operator scope: "only trades the Watcher did
//---     not cut early").
//---   - The Watcher never fires and 3 closed candles elapse -> watcherCutEarly=false, signalQuality
//---     is GOOD_SIGNAL (the 3rd candle's close moved toward the trade's OWN direction, i.e. toward
//---     profit) or BAD_SIGNAL (moved toward where the SL sits) or NEUTRAL (exact tie).
#define KMIE_SL_WATCHER_MAX_SLOTS 32
#define KMIE_SL_WATCHER_TIMEOUT_SECONDS 1800 // 30 min safety net if 3 closed candles never accumulate (feed gap etc.) - drop, never guess a label
struct SlWatcherSignalTrack
  {
   bool     active;
   ulong    ticket;
   int      direction;          // +1 BUY, -1 SELL
   double   entryPrice;
   datetime entryBarTime;       // M1 bar time at first observation (baseline - candles must close AFTER this)
   datetime lastCandleTimeSeen; // own dedup, independent of DetectNewClosedCandle()/g_retryForensic[]'s
   int      closedCandlesSeen;
   datetime startTime;          // TimeCurrent() at allocation, for the safety timeout above
  };
SlWatcherSignalTrack g_slWatcherSignal[KMIE_SL_WATCHER_MAX_SLOTS];

//--- 2026-08-24, explicit operator request: trades.jsonl's dnaState field was found to be logging
//--- the WRONG regime - UpdateDashboardLogs() (which stamps it) runs BEFORE MaybeExecute() in
//--- OnTick(), so a just-opened position isn't seen by the dashboard's open/close diff until the
//--- NEXT tick, by which point g_dnaState (recomputed fresh every tick) may already have moved on.
//--- This records the ACTUAL regime g_dnaState was at the moment SendMarketOrder() succeeded,
//--- keyed by ticket, so UpdateDashboardLogs() can look up the true entry-time regime instead of
//--- reading whatever g_dnaState happens to be one tick later. One-shot: consumed (freed) the
//--- moment UpdateDashboardLogs() reads it, so this never grows unbounded.
#define KMIE_LITE_MAX_ENTRY_DNA_SLOTS 32

struct EntryDnaRecord
  {
   ulong          ticket;
   bool           active;
   ENUM_LITE_DNA  dnaState;
   double         dnaScore;
  };

//--- 2026-08-29, explicit operator request: Risk (#5) and Pressure (#10) COMPLETELY REMOVED from the
//--- active Mind architecture - Risk was hardcoded LDIR_WAIT always (never voted a side), Pressure was
//--- a byte-for-byte duplicate of Structure (#7). This is 14 now, not 16 - the array literally no
//--- longer holds a slot for either of them, matching the explicit instruction that this be a real
//--- removal, not merely another inert-placeholder conversion (that weaker approach was already used
//--- once for Pressure and is explicitly superseded by this task). See EvaluateMinds()'s own per-Mind
//--- .id= literals below for how each remaining Mind's historical numeric identity (#0-#4, #6-#9,
//--- #11-#15 - note the gaps at #5 and #10) is preserved despite the array itself being compacted.
//--- 2026-08-30, explicit operator request (ADD EMA 20/50 SLOPE TREND MIND): one new Mind
//--- (EMA Trend, id 16 - see EvaluateEmaTrendMind()) added additively. 14 -> 15. id 16 chosen
//--- deliberately over reusing the retired #5/#10 gaps (Risk/Pressure) - those ids "mean" the
//--- retired Minds in every historical trades.jsonl/minds_detail.jsonl log entry ever written;
//--- reusing them would make old logs ambiguous. 16 is the next id past the highest ever used
//--- (15, SR).
//--- 2026-08-30, explicit operator request (ADD NEW MTF ALIGNMENT MIND): one more new Mind
//--- (MTF Alignment, id 17 - see EvaluateMtfAlignmentMind()) added additively. 15 -> 16. Same
//--- reasoning as above for id 17 (next id past the highest ever used, 16/EMA Trend).
//--- 2026-08-30, explicit operator request (ABSORPTION MIND): one more new Mind (Absorption,
//--- id 18 - see EvaluateAbsorptionMind()) added additively. 16 -> 17. Same reasoning as above for
//--- id 18 (next id past the highest ever used, 17/MTF Alignment).
//--- 2026-08-31, explicit operator request (FAIR VALUE / VWAP MIND): one more new Mind (Fair Value,
//--- id 19 - see EvaluateFairValueMind()) added additively. 17 -> 18. Same reasoning as above for
//--- id 19 (next id past the highest ever used, 18/Absorption).
#define KMIE_LITE_MIND_COUNT 18

//--- 2026-09-03, dead-code removal (duplication/drift audit, finding M4): KMIE_MIND_STABLE_ID[]
//--- used to live here as a documented array-position -> historical Mind ID mapping, but was never
//--- actually consulted by any code - EvaluateMinds() assigns every Mind's .id via a hardcoded
//--- literal on that Mind's own line instead (e.g. g_minds[5].id=6; ~line 4885). Two independent
//--- sources of truth for the same mapping, one purely decorative, risked silently diverging if a
//--- Mind were ever added/removed and only one side updated. Deleted rather than kept half-
//--- maintained; EvaluateMinds()'s own per-Mind .id= literals (search "g_minds[" ".id=") are now the
//--- single source of truth for the position->id mapping.

//====================================================================
// GLOBAL STATE
//====================================================================
MindResult    g_minds[KMIE_LITE_MIND_COUNT];
int           g_buyVotes = 0, g_sellVotes = 0, g_waitVotes = 0;
ENUM_LITE_DIR g_mindsVoteDir = LDIR_WAIT;   // majority direction across the 18 active Minds - ALL 18 now vote (Risk/Pressure removed 2026-08-29, EMA Trend added 2026-08-30, MTF Alignment added 2026-08-30, Absorption added 2026-08-30, Fair Value added 2026-08-31, Session implemented as a real voting Mind 2026-09-01 - was the last non-voting placeholder)

//--- Symbol Guard: resolved once in OnInit() from Inp_TradeSymbol (or the
//--- attached chart's own symbol when blank). Every CopyRates/SymbolInfo/
//--- OrderSend/PositionGetString call below reads this, never the chart's
//--- own _Symbol directly - so the input has authority over which symbol
//--- trades, independent of chart attachment.
string g_symbol = "";

ENUM_LITE_DNA g_dnaState = LDNA_NEUTRAL;
double        g_dnaScore = 0.0;
CandleIntelligence g_ci;   // published by EvaluateMarketDNA(), shown on the dashboard

double        g_prevNetMove = 0.0; // previous cycle's 30-bar netMove, for the Memory mind (2026-08-21: widened to 30 bars)
double        g_curNetMove30 = 0.0; // THIS cycle's 30-bar netMove, set inside EvaluateMinds(), copied to g_prevNetMove at end of OnTick()

//--- 2026-08-30, explicit operator request (ABSORPTION MIND): minimal persistence state, SAME
//--- lifecycle convention as g_prevNetMove/g_curNetMove30 above - zero-initialized at declaration
//--- (first-ever evaluation has no prior state, handled explicitly inside EvaluateAbsorptionMind()),
//--- written once per cycle inside EvaluateMinds() (not read/written anywhere else), and updated at
//--- the end of OnTick() alongside g_prevNetMove for the SAME reason (next cycle's comparison must
//--- use THIS cycle's just-computed reading, never a stale one from mid-cycle). Tracks how many
//--- CONSECUTIVE cycles the dominant absorption side has stayed the same, so one anomalous bar can
//--- never alone produce a high-persistence reading (validation Test 11).
ENUM_LITE_DIR g_prevAbsorptionSide = LDIR_WAIT; // which side (BUY/SELL absorption) was dominant last cycle
int           g_curAbsorptionStreak = 0;        // THIS cycle's computed streak, set inside EvaluateMinds()
int           g_prevAbsorptionStreak = 0;       // previous cycle's streak, copied from g_curAbsorptionStreak at end of OnTick()

//--- 2026-09-16, M5 PARALLEL PIPELINE: separate cross-cycle persistence state for
//--- EvaluateAbsorptionMindM5(), so its own streak never mixes with the M1 Absorption Mind's.
ENUM_LITE_DIR g_prevAbsorptionSideM5 = LDIR_WAIT;
int           g_curAbsorptionStreakM5 = 0;
int           g_prevAbsorptionStreakM5 = 0;

//--- 2026-08-20, explicit operator request: "if previous trade is already open than punch new
//--- trade" - superseded by a LATER request the same day ("if there is already trade are open
//--- don't execute new trade") - see CountOpenPositions()/MaybeExecute() below, which now blocks
//--- instead of stacking. This bar-pacing timestamp is kept regardless, so a fresh signal on a new
//--- bar still can't fire twice within the same bar once positions ARE flat again.
datetime      g_lastSignalBarTime = 0;

//--- Entry Intelligence Step 1 state (observational only - see EvaluateEntryIntelligence()).
//--- Global so it persists across ticks; MQL5 zero-initializes globals (active=false, state=LPB_NONE).
ActiveLegState g_activeLeg;
PullbackState  g_pullback;

//--- Entry Intelligence Step 2 state (observational only - see EvaluateResumption()).
ResumptionState g_resumption;

//--- Entry Intelligence Step 3 state (observational only - see EvaluateMicroResumption()).
MicroResumptionState g_microResumption;

//--- Entry Intelligence Step 4 state (observational only - see EvaluateOpportunityLifecycle()).
OpportunityState g_opportunity;
ulong            g_nextOpportunityId = 1; // monotonically increasing, never reused

//--- 2026-09-03, explicit operator request (ACTIVE_PING ARCHITECTURE - replaces the OPPORTUNITY_
//--- CONSUMED re-entry gate): the old ">10 votes" one-shot bypass (g_highVoteBypassUsedForOpportunityId)
//--- is REMOVED here per explicit instruction - "Remove the >10 votes bypass from the OPP_CONSUMED
//--- re-entry logic... ACTIVE_PING is now the sole mechanism replacing the old OPP_CONSUMED re-entry
//--- gate." The vote-count CALCULATION itself (g_buyVotes/g_sellVotes/g_mindsVoteDir, Mind 16/EMA Trend
//--- Mind) is completely untouched - only its former role as an independent bypass around
//--- OPPORTUNITY_CONSUMED is gone. See EvaluateActivePing() below (the new gate) and
//--- EvaluateEntryApproval()'s own updated header for the replacement logic.
//---
//--- ACTIVE_PING state - published once per NEW CLOSED M1 bar (never per-tick - see
//--- EvaluateActivePing()'s own header for why). Reuses the EA's OWN existing EMA20/EMA50
//--- calculation (EmaAt(), the SAME helper EvaluateEmaTrendMind() already calls) and the EMA Trend
//--- Mind's OWN exact gap/ATR/slope formula - never a second/independent EMA or threshold
//--- calculation. corridorActive = the reference closed candle's close sits between EMA20 and EMA50.
//--- slopeActive = the EMA Trend Mind's own BUY/SELL condition (gap+ATR+slope all agreeing) is
//--- non-WAIT. active = corridorActive OR slopeActive (per explicit instruction - no vote-count
//--- condition folded in). All values captured here are DIAGNOSTIC/READABLE state - the field values
//--- themselves are what EvaluateEntryApproval() reads to replace the old OPPORTUNITY_CONSUMED gate.
struct ActivePingState
  {
   bool     valid;             // false = insufficient EMA/ATR history this bar - active defaults to false, never fabricated
   datetime barTime;           // the NEW CLOSED bar this reading was computed for (iTime(...,1) at eval time)
   double   ema20;
   double   ema50;
   double   refClose;          // close of the reference closed candle used for the corridor check (same candle EMA20/50 were evaluated at)
   bool     corridorActive;    // refClose sits between ema20 and ema50 (inclusive of the boundary)
   double   gap;               // ema20-ema50, SAME formula as EvaluateEmaTrendMind()
   double   normalizedGap;     // |gap|/ATR, SAME formula
   double   atr;
   double   emaSlope;          // SAME formula/lookback as EvaluateEmaTrendMind()
   ENUM_LITE_DIR slopeDirection; // the EMA Trend Mind's own BUY/SELL/WAIT verdict for this same reading
   bool     slopeActive;       // slopeDirection != LDIR_WAIT
   //--- 2026-09-08, explicit operator request ("if Trade was Executed that point of price to when
   //--- trade closed that should be also considered in active ping and show as opportunity consumed"):
   //--- THIRD condition, independent of corridor/slope - true when current price is still inside the
   //--- [entry price, exit price] range the Retry Engine's own armed candidate (g_retryEngine, the
   //--- SAME closed-trade memory that already exists for the Retry Engine, only ever armed on a
   //--- protected TRAILING/BREAK_EVEN exit - see RegisterRetryCandidate()) traded through during its
   //--- own life. Deliberately reuses g_retryEngine rather than inventing a second closed-trade
   //--- tracker - confirmed via AskUserQuestion before implementation.
   bool     rangeActive;       // current price still between the armed candidate's own entry and exit price
   //--- 2026-09-18, explicit operator request ("MY OPPORTUNITY CONSUMED IS WORKING ITS TOTALY UPTREND BUT
   //--- BOT NOT EXCUTING THE TRADE WHY") - ported from KMIE_MarketDNA_Lite.mq5 into this baseline file.
   //--- See Inp_ActivePingTrendingSideEnabled's own header for the full root-cause/design. True when
   //--- refClose sits fully on ONE side of BOTH EMA20 and EMA50 (a genuine trending position, not the
   //--- corridor-between-them case corridorActive already covers) AND normalizedGap clears
   //--- Inp_ActivePingTrendingGapATR (real separation, not noise).
   bool     trendingSideActive;
   bool     active;            // corridorActive || trendingSideActive - the actual gate value (plus a live per-tick EMA20/50 crossing flag ORed in by OnTick())
   string   reasoning;
   //--- 2026-09-09, explicit operator request (POST-LOSS SAME-DIRECTION RE-ENTRY LOCK / EMA NEUTRAL
   //--- BLOCKER): six new fields. Read ONLY by the new gate logic added this same date - NEVER by the
   //--- two existing `.active` consumers (EvaluateEntryApproval() ~12353/12370, MaybeExecute() ~13435,
   //--- both `!g_activePing.active` conditions that RELAX an existing check) - those two read sites are
   //--- deliberately untouched.
   ENUM_LITE_DIR postLossLockDirection;   // direction the lock applies to; LDIR_WAIT = no lock armed
   double        postLossLockReferencePrice; // cached g_lastClosedTrade.exitPrice at arm time - diagnostics/dashboard display only, never the live decision source
   bool          postLossLockArmed;       // true if a same-direction lock is currently blocking
   bool          postLossLockReleased;    // true once released this episode (diagnostics)
   int           emaCrossoverCount20;     // EMA20/50 gap-sign flips in the trailing up-to-20-bar window
   bool          emaNeutral;              // true when normalizedGap<=Inp_EMANeutralGapATR AND emaCrossoverCount20>=1
   //--- 2026-09-09, explicit operator request (EMA CONTINUATION/EXTENSION CLASSIFICATION): two new
   //--- fields, computed immediately after emaNeutral above via ClassifyEmaEntryState() - see that
   //--- function's own header.
   ENUM_EMA_ENTRY_STATE emaEntryState;   // EMA_ENTRY_NEUTRAL / EMA_ENTRY_TREND_CONTINUATION / EMA_ENTRY_TREND_EXTENDED - 2026-09-11: now computed from EMA35 math (see ClassifyEmaEntryState()'s updated header), field itself unrenamed/reused
   double               extensionATR;   // 2026-09-11: now (price-EMA35)/ATR (signed toward the valid EMA35 side) - 0.0 when emaEntryState==EMA_ENTRY_NEUTRAL
   //--- 2026-09-11, explicit operator request (ACTIVE_PING/EMA35 ARCHITECTURE REWIRE - Part A/B/C): new,
   //--- independent EMA35 axis, ADDED alongside the existing EMA20/EMA50 fields above (which remain fully
   //--- populated and unchanged - Mind #14/EvaluateEmaTrendMind() still consumes them). Replicates
   //--- EvaluateEma35TrackingSl()'s own exact EMA35 formula (period=35, alpha=2/(35+1), EmaAt(), closed-
   //--- bars-only) - see EvaluateActivePing()'s own updated body for the computation.
   double   ema35;              // current closed-bar EMA35 value
   double   ema35Slope;         // ema35Now - ema35Prev (closed-bar-only, same 2-reading technique as emaSlope above) - CONFIRMATION/CONTEXT ONLY, NEVER wired as an independent entry gate (explicit operator requirement, spec Part 4)
   ENUM_EMA35_MARKET_SIDE ema35MarketSide; // EMA35_BUY/EMA35_SELL/EMA35_NEUTRAL - see ClassifyEma35MarketSide()
   double   ema35NormalizedDistance; // abs(refClose-ema35)/atr - the raw distance used for the neutral-corridor check
   //--- 2026-09-11, explicit operator request (Part C): ACTIVE_PING's own BUY/SELL/NEUTRAL directional
   //--- read, reusing ENUM_LITE_DIR (LDIR_BUY/LDIR_SELL/LDIR_WAIT) rather than a new 3rd parallel enum,
   //--- since this is structurally the same 3-state direction concept ENUM_LITE_DIR already represents
   //--- throughout this file. See EvaluateActivePing()'s own body for the documented reasoning on how this
   //--- is derived (directly from ema35MarketSide - see that comment block for the full justification).
   ENUM_LITE_DIR activePingDirection;
   int      activePingRefreshBarCount; // diagnostic - how many of the 25 structural-window bars were actually returned by the dedicated 25-bar CopyRates fetch (warm-up guard)
  };
ActivePingState g_activePing;

//--- 2026-09-14, explicit operator request (ACTIVE_PING CROSSING-BASED DIRECTION): ACTIVE_PING's
//--- direction (g_activePing.activePingDirection above) used to simply mirror EMA35's side every closed
//--- bar (re-derived fresh each time from ema35MarketSide, per the 2026-09-11 architectural decision
//--- documented in EvaluateActivePing()'s own body). The operator now wants a genuinely different,
//--- EVENT-DRIVEN mechanism: ACTIVE_PING only flips BUY when live price crosses ABOVE the highest high of
//--- the last 25 CLOSED M1 bars, and only flips SELL when live price crosses BELOW the lowest low of that
//--- same window - it does NOT flip merely because ema35MarketSide's own classification changed. Once a
//--- flip occurs, the 25-bar high/low window that triggered it FREEZES (does not keep rolling forward)
//--- until the NEXT flip, per the operator's own explicit choice (avoids the trigger level itself
//--- "chasing" price after a flip). This is a SEPARATE state machine from g_activePing/EvaluateActivePing()
//--- (which keeps computing ema35MarketSide/emaNeutral/etc. exactly as before, untouched) - it OWNS
//--- g_activePing.activePingDirection as its one output field, written only from
//--- EvaluateActivePingCrossingDirection() below, never from EvaluateActivePing() itself anymore.
struct ActivePingCrossingState
  {
   bool     initialized;        // false until the very first evaluation has run (seeds the initial rolling window)
   double   frozenHigh;         // the 25-bar high in effect since the last flip (or initial seed)
   double   frozenLow;          // the 25-bar low in effect since the last flip (or initial seed)
   double   lastBid;            // previous tick's Bid - used ONLY for the BUY-side crossing check (matches CheckActivePingPriceCross()'s own Bid-for-BUY convention)
   double   lastAsk;            // previous tick's Ask - used ONLY for the SELL-side crossing check (matches CheckActivePingPriceCross()'s own Ask-for-SELL convention)
   bool     havePriorTick;      // false until at least one tick has been observed since the window was last (re)frozen
  };
ActivePingCrossingState g_activePingCrossing;

//--- 2026-09-16, explicit operator request (ACTIVE_PING SIMPLIFIED TO EMA20/50): a NEW, SEPARATE per-tick
//--- crossing tracker for the EMA20/EMA50 pair specifically - not EMA35, not the 25-bar high/low window
//--- ActivePingCrossingState tracks. Same minimal "previous Bid/Ask, has a prior tick been seen"
//--- convention as ActivePingCrossingState above, but the trigger levels here are the LIVE ema20/ema50
//--- values (re-read from g_activePing every tick, not frozen at a captured moment) - "did price cross
//--- BOTH lines, same direction, since the previous tick" is recomputed fresh continuously rather than
//--- captured/waited-on, per the operator's own explicit "simple rolling check" choice.
struct Ema2050CrossState
  {
   double   lastBid;         // previous tick's Bid - BUY-side check (price crossing ABOVE both EMAs)
   double   lastAsk;         // previous tick's Ask - SELL-side check (price crossing BELOW both EMAs)
   bool     havePriorTick;   // false until at least one tick has been observed
  };
Ema2050CrossState g_ema2050Cross;
//--- true only on the exact tick a genuine both-EMAs cross was detected (see EvaluateEma2050CrossActive()
//--- below) - read by EvaluateActivePing() when composing r.active, alongside the EMA20/50 corridor check
//--- ClassifyActivePing() already computes. Reset to false every tick by EvaluateEma2050CrossActive()
//--- itself before re-evaluating, so a cross event is visible for exactly the one tick it happened on -
//--- matches this file's own "state-transition-only" convention used elsewhere (e.g.
//--- g_lastLoggedActivePingDirection), never a sticky/latched flag.
bool g_ema2050CrossedThisTick = false;

//--- 2026-09-24, explicit operator request ("Use the active ping cross cut the trade") - true only on the
//--- exact tick EvaluateActivePingCrossingDirection() actually flips g_activePing.activePingDirection
//--- (either direction, BUY<->SELL or from WAIT) - same "state-transition-only, reset every tick" pattern
//--- as g_ema2050CrossedThisTick above. Read by TradeManagementEngine() (see
//--- EvaluateActivePingCrossCutLoss()) to close a currently-LOSING position the instant a genuine
//--- ActivePing crossing-direction flip happens - see that function's own header for the full design.
bool g_activePingDirectionFlippedThisTick = false;

//--- Forward declaration - MQL5 requires a function be declared/defined before use, and this file has
//--- very few precedents for forward declarations (every other function call in this file relies on
//--- strict definition-before-use ordering). This was originally the ONE exception:
//--- EvaluateActivePingCrossingDirection()'s own definition lives later in the file (near
//--- CheckActivePingPriceCross(), its natural neighbor in the ACTIVE_PING/price-cross code region) but it
//--- must be CALLED from OnTick() much earlier in the file (every tick, unconditionally) - a forward
//--- declaration here is the minimal-footprint fix, avoiding a large function-reordering edit purely for
//--- this one new call site.
void EvaluateActivePingCrossingDirection();
//--- 2026-09-16, explicit operator request (ACTIVE_PING SIMPLIFIED TO EMA20/50): a THIRD forward
//--- declaration, same minimal-footprint rationale - EvaluateEma2050CrossActive()'s own definition lives
//--- later in the file (near IsPriceCrossEvent()/EvaluateActivePingCrossingDirection(), its natural
//--- neighbor in the ACTIVE_PING/price-cross code region) but must be called from OnTick() every tick,
//--- unconditionally, same cadence as EvaluateActivePingCrossingDirection() above.
void EvaluateEma2050CrossActive();
//--- 2026-09-15, explicit operator request (Trade History Session confirmation): a SECOND forward
//--- declaration, same minimal-footprint rationale - ResolveCurrentSessionLabel()'s own definition lives
//--- much later in the file (near IsRegimeAllowedForSession()/IsMindAllowedForSession(), its natural
//--- neighbor in the Per-Session DNA/Mind Selection code region) but RecordEntryDna() (defined much
//--- earlier, called from SendMarketOrder() the instant an order succeeds) now needs to call it to
//--- capture entrySessionLabel at entry - see RecordEntryDna()'s own header for the full rationale.
string ResolveCurrentSessionLabel();
//--- New-bar latch for ACTIVE_PING, same pattern as g_lastSignalBarTime/g_dashLastBarTime elsewhere in
//--- this file (iTime(...,PERIOD_M1,0) vs a stored datetime) - guarantees ACTIVE_PING is (re)computed
//--- at most once per bar, never re-evaluated on every one of the many ticks inside the same bar.
datetime g_activePingLastBarTime = 0;
//--- 2026-09-09, explicit operator request (EMA CONTINUATION/EXTENSION CLASSIFICATION): state-change
//--- latch for the [EMA_ENTRY_STATE] log - a GLOBAL condition (not per-ticket), so a file-scope global
//--- rather than a TrailingState field. Sentinel invalid value (-1, outside the enum's 0-2 range) so the
//--- very first evaluation always logs once.
ENUM_EMA_ENTRY_STATE g_lastLoggedEmaEntryState = (ENUM_EMA_ENTRY_STATE)(-1);
//--- 2026-09-11, explicit operator request (ACTIVE_PING/EMA35 ARCHITECTURE REWIRE - Part G): state-change
//--- latch for the [MARKET_DIRECTION] log - same "GLOBAL condition, sentinel invalid value" convention as
//--- g_lastLoggedEmaEntryState just above. Fires only when activePingDirection/ema35MarketSide actually
//--- CHANGE (state-transition-only, same throttle style as [EMA_ENTRY_STATE]), never per-tick.
ENUM_LITE_DIR g_lastLoggedActivePingDirection = (ENUM_LITE_DIR)(-99);

//--- 2026-09-09, explicit operator request (three new entry-protection gates - POST-LOSS SAME-DIRECTION
//--- RE-ENTRY LOCK, EMA20/EMA50 NEUTRAL-MARKET BLOCKER, TWO-BAR 50%-TIME-PROGRESS CONFIRMATION):
//--- supporting globals for all three, grouped here since they're all new state introduced by the same
//--- approved design pass.
//--- Ring buffer of EMA20-EMA50 gap SIGNS (-1/0/+1), index 0 = most recent, populated once per new
//--- closed M1 bar inside EvaluateActivePing() (same once-per-bar cadence as everything else in that
//--- function - no separate latch needed). Feeds the EMA neutral-market blocker's crossover count.
int      g_emaGapSignHistory[20];
int      g_emaGapSignHistoryCount = 0;  // how many of the 20 slots are actually populated (warm-up guard)
//--- Prevents re-arming the Post-Loss Re-entry Lock off the SAME stale losing ticket every bar after it
//--- has already been released (favorable cross or direction flip) - only a NEWLY closed losing ticket
//--- (different g_lastClosedTrade.ticket) can re-arm it.
ulong    g_postLossLockLastArmedTicket = 0;

//--- Two-Bar 50%-Time-Progress Confirmation state machine (see EvaluateBarConfirmation()/
//--- EvaluateBarConfirmationCore() below). trackedDirection==LDIR_WAIT means no confirmation window is
//--- currently open.
struct BarConfirmationState
  {
   ENUM_LITE_DIR trackedDirection;   // LDIR_WAIT = no window open
   int           stage;              // 0=none, 1=bar1 confirmed, 2=both bars confirmed
   datetime      bar1Time;           // iTime(...,0) at the moment bar 1 confirmed
   datetime      bar2Time;           // iTime(...,0) of the bar that confirmed as bar 2
   bool          bar1Confirmed;
   bool          bar2Confirmed;
  };
BarConfirmationState g_barConfirmation;

//--- 2026-09-16, M5 PARALLEL PIPELINE: a full duplicate of the M1 DNA/Minds/Bar-Confirmation global
//--- state above, one instance per M5-suffixed global, written ONLY by the M5-suffixed functions
//--- defined alongside their M1 counterparts below. Never read or written by any pre-existing M1
//--- function - the M1 pipeline is 100% untouched. See Inp_DnaTimeframeMode's own header comment.
ENUM_LITE_DNA        g_dnaStateM5 = LDNA_NEUTRAL;
double               g_dnaScoreM5 = 0.0;
CandleIntelligence   g_ciM5;                     // published by EvaluateMarketDnaM5(), shown on the dashboard as "M5 DNA"
MindResult           g_mindsM5[KMIE_LITE_MIND_COUNT];
int                  g_buyVotesM5 = 0, g_sellVotesM5 = 0, g_waitVotesM5 = 0;
ENUM_LITE_DIR        g_mindsVoteDirM5 = LDIR_WAIT;
BarConfirmationState g_barConfirmationM5;
//--- Dashboard-parity fields, mirroring EvaluateMarketDNA()'s own k=min(ResolveEffectiveDnaLookback(),n)
//--- computation the way live_signal.json's dnaBarsUsed/dnaBarsRequested/barsPoolAvailable already do for
//--- M1 - written by UpdateDashboardLogs() alongside the M1 fields, never by EvaluateMarketDnaM5() itself
//--- (same "computed at the log site, not the classifier" convention the M1 fields already use).
int                  g_dnaBarsUsedM5 = 0, g_dnaBarsRequestedM5 = 0, g_barsPoolAvailableM5 = 0;

//--- 2026-09-23, M15 PARALLEL PIPELINE: a THIRD parallel timeframe pipeline, mirroring the M5 block
//--- above exactly, one instance per M15-suffixed global, written ONLY by the M15-suffixed functions
//--- defined alongside their M1/M5 counterparts below. Never read or written by any pre-existing M1/M5
//--- function - both prior pipelines are 100% untouched. Scope for this pipeline is DNA + 18-Mind Vote
//--- + the 3-way M1/M5/M15 agreement gate only - NOT a standalone Bar Confirmation state machine (no
//--- DNA_TF_M15_ONLY mode exists, so there is no live call site that would ever read an M15 Bar
//--- Confirmation state the way M5_ONLY mode reads g_barConfirmationM5 - see EvaluateBarConfirmationM5()
//--- and its live_signal.json-adjacent call sites); accordingly no g_barConfirmationM15 global is
//--- declared here, deliberately, per this task's own documented scope decision.
ENUM_LITE_DNA        g_dnaStateM15 = LDNA_NEUTRAL;
double               g_dnaScoreM15 = 0.0;
CandleIntelligence   g_ciM15;                    // published by EvaluateMarketDnaM15(), shown on the dashboard as "M15 DNA"
MindResult           g_mindsM15[KMIE_LITE_MIND_COUNT];
int                  g_buyVotesM15 = 0, g_sellVotesM15 = 0, g_waitVotesM15 = 0;
ENUM_LITE_DIR        g_mindsVoteDirM15 = LDIR_WAIT;
//--- Dashboard-parity fields, mirroring the M5 fields immediately above (dnaBarsUsed/dnaBarsRequested/
//--- barsPoolAvailable) - written by UpdateDashboardLogs() alongside the M1/M5 fields, never by
//--- EvaluateMarketDnaM15() itself (same "computed at the log site, not the classifier" convention).
int                  g_dnaBarsUsedM15 = 0, g_dnaBarsRequestedM15 = 0, g_barsPoolAvailableM15 = 0;

//--- 2026-09-11, explicit operator request (ACTIVE_PING/EMA35 ARCHITECTURE REWIRE - Part D): a genuinely
//--- SEPARATE, new pending-trigger concept (NOT a field on ActivePingState - per spec section 16's own
//--- "critical separation of responsibilities": ActivePingState computes price STRUCTURE fresh every new
//--- closed bar, this tracks a SPECIFIC captured pending trigger tied to a SPECIFIC Bar Confirmation
//--- episode, which must survive/persist independently of ActivePingState's own per-bar recomputation).
//--- pendingDirection==LDIR_WAIT means no pending trigger is currently armed. See
//--- CheckActivePingPriceCross() for the full capture/wait/cross/invalidate state machine.
struct PendingPriceCrossState
  {
   ENUM_LITE_DIR pendingDirection;      // LDIR_WAIT = no pending trigger armed
   double        triggerPrice;          // captured EMA35 value at the moment Bar Confirmation became established - FROZEN, never re-read from live g_activePing.ema35 again once captured
   double        lastTickPrice;         // previous tick's relevant price (Bid for BUY-side wait, Ask for SELL-side wait), for crossing detection
   bool          havePriorTick;         // false until at least one tick has been observed since arming, so the FIRST tick after arming never falsely fires a "crossing" against an uninitialized lastTickPrice
   datetime      confirmationBarTime;   // g_barConfirmation.bar2Time at the moment of capture, for diagnostic/lifecycle-tracking purposes only
  };
PendingPriceCrossState g_pendingPriceCross;

//--- 2026-09-02, explicit operator request ("does also updating the same in trade history" - Reverse
//--- Fire trades were being recorded with whatever stale g_opportunity.isEarlyReEntryOpp/isC2Refire
//--- happened to be true from the last real opportunity, mislabeling them as "Original"/"Retry" in
//--- Trade History instead of identifying them as Reverse Fire entries). Set true by
//--- EvaluateEarlySlWatcher() for the single tick it calls SendMarketOrder() for the Reverse Fire
//--- entry, false immediately after - RecordEntryDna() below checks this FIRST (highest priority) so
//--- entrySource="REVERSE_FIRE" regardless of what g_opportunity's own flags currently hold. Declared
//--- here (before RecordEntryDna()'s own definition) per MQL5's declare-before-use rule for globals.
bool g_reverseFireInProgress = false;

//--- 2026-08-28, Step 15.4 (explicit operator request, Early Re-Entry): per-Active-Leg re-entry
//--- budget. Deliberately NOT a field on g_opportunity (that struct is fully reconstructed on every
//--- mint - fresh, C2, or Early Re-Entry - so a field there would reset on every re-entry instead of
//--- persisting across them). Reset ONLY in EvaluateOpportunityLifecycle()'s own !sameLeg branch (a
//--- genuinely new Active Leg) - never touched by Active Leg detection itself. Incremented ONLY in
//--- MaybeExecute()'s consumption hook, on a SUCCESSFUL execution of an Early-Re-Entry-minted
//--- opportunity (see OpportunityState.isEarlyReEntryOpp) - never on mere creation/approval.
//--- 2026-08-28, Step 15.5 (explicit operator request): raised 2 -> 4. No other Early Re-Entry
//--- logic changed - this constant is the sole enforcement point (see EarlyReEntryEligible()'s own
//--- gate below, the only place that reads it).
//--- 2026-09-08, explicit operator request: lowered 4 -> 1 (at most ONE Early Re-Entry per Active
//--- Leg). No other Early Re-Entry logic changed - this remains the sole enforcement point.
//--- 2026-09-08, explicit operator request ("Retry trade should be totaly off make 0"): lowered
//--- 1 -> 0. g_reEntryCount starts at 0 and EarlyReEntryEligible()'s own gate below is
//--- `g_reEntryCount>=KMIE_LITE_EARLY_REENTRY_MAX_COUNT` - with this constant at 0, that condition
//--- is true immediately, so Early Re-Entry is now fully disabled (never fires). No other
//--- Early Re-Entry logic changed - this remains the sole enforcement point.
#define KMIE_LITE_EARLY_REENTRY_MAX_COUNT 0
int g_reEntryCount = 0;

//--- Entry Intelligence Step 5 state (observational only - see EvaluateExtension()).
ExtensionState g_extension;

//--- Entry Intelligence Step 6 state (observational only - see EvaluateEntryApproval()). Nothing in
//--- MaybeExecute()/SendMarketOrder()/OrderSend() reads this global.
EntryApprovalState g_entryApproval;

//--- Entry Intelligence Step 7.2 state (telemetry only - see MaybeExecute()'s classification below).
ExecutionResult g_executionResult;

//--- Step 9 Position Management state (native trailing/break-even, observational to nothing above -
//--- see ManageOpenPositions()). Zero-initialized by MQL5 (active=false for every slot).
TrailingState g_trailing[KMIE_LITE_MAX_TRAILING_SLOTS];

//--- Entry-time regime capture (see EntryDnaRecord above) - zero-initialized (active=false) by MQL5.
EntryDnaRecord g_entryDna[KMIE_LITE_MAX_ENTRY_DNA_SLOTS];

//--- 2026-08-28, explicit operator request (root-cause fix): ROOT CAUSE of trades.jsonl/chart
//--- occasionally showing the WRONG entry regime (e.g. a blocked one like CHOPPY that could never
//--- have actually fired) - confirmed via Experts-log cross-check: several closed trades' recorded
//--- dnaState matched NEITHER their own "firing batch under Market DNA=..." log line NOR any other
//--- firing event that day. g_entryDna[] above is a plain in-memory global array, which MQL5 wipes
//--- to empty on every EA re-init (recompile+reattach, terminal/VPS restart). A position that was
//--- ALREADY OPEN when the EA restarts has NO in-memory record any more - ConsumeEntryDna()'s
//--- lookup always misses for it, so UpdateDashboardLogs() silently falls back to whatever
//--- g_dnaState happens to be LIVE the moment the restarted EA's dashboard loop first notices that
//--- pre-existing position - which can be a completely different regime than the true entry one.
//--- Fix: RecordEntryDna() now ALSO appends a durable line to entry_dna.jsonl the instant an order
//--- is sent (same file-append pattern as trades.jsonl/bars.jsonl elsewhere in this file), and
//--- ConsumeEntryDna() falls back to reading THAT file (ReadEntryDnaFromFile(), below) before ever
//--- falling back to live g_dnaState. This survives restarts because it's on disk, not in RAM.
//--- 2026-08-28, Step 18.1 (explicit operator request, Execution Identity Telemetry): TELEMETRY ONLY
//--- - extends RecordEntryDna() to persist full Order/Deal/Position identity plus the context that
//--- produced this entry (opportunity, Active Leg, DNA, Minds, entry path, entrySource), and prints
//--- one [EXECUTION][IDENTITY] line. Every value is either read directly from req/res (the exact
//--- MqlTradeRequest/MqlTradeResult this OrderSend() call already produced) or from an existing,
//--- already-published global (g_dnaState/g_opportunity/g_activeLeg/g_buyVotes/g_sellVotes/
//--- g_mindsVoteDir/g_entryApproval.path) - nothing is recomputed, nothing is fabricated. Position/
//--- deal identity is verified READ-ONLY (PositionSelectByTicket()/HistoryDealSelect() - selection
//--- calls only, never a modification, never another OrderSend()); when a lookup fails, the field is
//--- written as the literal string "UNRESOLVED", never a fabricated number. Does not change ticket,
//--- opportunity, entrySource, or any other trading decision - purely observes and logs.
//====================================================================
// VOLUME DNA (2026-09-02, explicit operator request - PHASE 1: SENSOR / DATA CAPTURE LAYER ONLY)
//
// Approved after a prior READ-ONLY forensic audit (this same date) confirmed: tick_volume is already
// read live by EvaluateAbsorptionMind()/EvaluateFairValueMind() (never real_volume - Exness/every
// forex-CFD broker reports 0 for that field, a broker/data-model fact, not a KMIE limitation); no
// standalone reusable Volume Calculator existed; per-candle volume was never persisted as structured
// data anywhere; M1 tick_volume reads were already proven live; the M5/M15 CopyRates-per-timeframe
// pattern already existed (EvaluateTimeframeEmaDirection()); H1 needed only the same pattern with a
// different ENUM_TIMEFRAMES argument.
//
// THIS IS OBSERVATION-ONLY. Every function below is read-only w.r.t. trading state: no OrderSend/
// PositionClose/SL-TP-modification call anywhere in this section's body or call tree; nothing here
// is read by EvaluateMarketDNA()/EvaluateMinds()/EvaluateEntryApproval()/EvaluateOpportunityLifecycle()/
// MaybeExecute()/EarlyReEntryEligible()/EvaluateRetryTrade()/ManageOpenPositions() - the ENTIRE
// existing trading decision pipeline is untouched. Volume DNA is computed ONCE, at the exact moment
// RecordEntryDna() already runs (immediately after a successful OrderSend()), and written only to
// entry_dna.jsonl - it can never influence the trade that already happened by the time it's computed.
//
// EvaluateAbsorptionMind()/EvaluateFairValueMind() are NOT modified, NOT refactored, NOT extracted
// from - per the explicit "do not create a second competing implementation" and "if extracting
// existing logic would create meaningful regression risk, leave the existing Mind logic untouched"
// instructions. This is a genuinely SEPARATE, additive calculation path that happens to read the same
// MqlRates.tick_volume field those two Minds already read - the data source is shared (it's the same
// MT5 API), the CODE is not.
//====================================================================

//--- One timeframe's worth of Volume DNA. Every field is either a raw MT5 read, or a documented ratio
//--- of two raw reads - never a black-box composite score (per the explicit "reliable raw data
//--- capture first" instruction - composite scoring is explicitly out of scope for this phase).
struct VolumeDnaResult
  {
   bool     valid;             // false = insufficient data - every numeric field below is then 0.0/UNKNOWN, never fabricated
   string   reasoning;         // why valid==false, when it is - always populated on failure, never blank
   datetime barTime;           // the REFERENCE candle's own open time (the completed candle this record describes)
   long     tickVolume;        // raw MqlRates.tick_volume of the reference candle - MARKET activity, NEVER trade lots
   double   averageVolume;     // mean tick_volume over the baseline window, EXCLUDING the reference candle itself
   double   relativeVolume;    // tickVolume / averageVolume - null/0 with valid=false if averageVolume<=0, never NaN/Inf
   string   volumeClass;       // VERY_LOW/LOW/NORMAL/ELEVATED/HIGH/VERY_HIGH/EXTREME - Section 7's fixed bins, or "UNKNOWN"
   double   rangePoints;       // (high-low) in raw price units (this file's existing "points" convention - see pointsScale in EvaluateMinds())
   double   rangePips;         // SAME value as rangePoints - XAUUSD has no distinct pip/point convention anywhere else in
                                // this file (grep-confirmed: no existing "pip" concept exists to diverge from) - kept as
                                // its own field only because Section 8 explicitly asked for both names, documented here
                                // as intentionally identical rather than silently duplicated
   double   bodySizePoints;    // |close-open| in raw price units
   double   bodyRatio;         // bodySizePoints / rangePoints * 100, 0..100, SafeDiv-guarded
   double   upperWickPoints;   // high - max(open,close)
   double   lowerWickPoints;   // min(open,close) - low
   double   closeLocation;     // (close-low)/(high-low), 0..1 - classic Close Location Value, SafeDiv-guarded
   double   rangeATR;          // rangePoints / ATR(14) on THIS timeframe - SafeDiv-guarded, computed fresh (own window,
                                // same classic-14-period True Range formula EMA Trend/Fair Value Minds already use -
                                // never a shared "ATR engine", matching this file's own established per-Mind-independence convention)
   double   volumeEfficiency;  // rangePoints / tickVolume - a DERIVED ANALYTICAL RATIO ONLY (Section 9's own explicit
                                // naming requirement) - NEVER "actual traded volume", NEVER "market lots", NEVER
                                // "money volume". SafeDiv-guarded.
  };

//--- Section 7 - centralized, documented classification bins. Kept as ONE function so thresholds are
//--- easy to find/modify later, per the explicit instruction. Purely descriptive - the string result
//--- is never read by any trading decision anywhere in this file.
string ClassifyVolumeDna(const double relativeVolume, const bool haveRelativeVolume)
  {
   if(!haveRelativeVolume) return "UNKNOWN";
   if(relativeVolume < 0.70) return "VERY_LOW";
   if(relativeVolume < 1.00) return "LOW";
   if(relativeVolume < 1.30) return "NORMAL";
   if(relativeVolume < 1.60) return "ELEVATED";
   if(relativeVolume < 2.00) return "HIGH";
   if(relativeVolume < 3.00) return "VERY_HIGH";
   return "EXTREME";
  }

//--- Section 1/3/4/5/6/8/9 - the ONE reusable, timeframe-parameterized Volume Calculator (mirrors
//--- EvaluateTimeframeEmaDirection()'s own established per-timeframe CopyRates pattern - same
//--- closed-candle shift=1 convention, same "own dedicated fetch, no shared mutable state" style).
//--- baselineBars is the count of COMPLETED candles used for averageVolume/ATR, EXCLUDING the
//--- reference candle itself (Section 5's explicit requirement) - the reference candle is
//--- ratesVol[0] (shift 1 = newest CLOSED bar on this timeframe), the baseline is ratesVol[1..N].
VolumeDnaResult ComputeVolumeDna(const ENUM_TIMEFRAMES tf, const int baselineBars)
  {
   VolumeDnaResult r;
   r.valid = false; r.reasoning = ""; r.barTime = 0; r.tickVolume = 0;
   r.averageVolume = 0.0; r.relativeVolume = 0.0; r.volumeClass = "UNKNOWN";
   r.rangePoints = 0.0; r.rangePips = 0.0; r.bodySizePoints = 0.0; r.bodyRatio = 0.0;
   r.upperWickPoints = 0.0; r.lowerWickPoints = 0.0; r.closeLocation = 0.0;
   r.rangeATR = 0.0; r.volumeEfficiency = 0.0;

   if(baselineBars < 1)
     {
      r.reasoning = "invalid baselineBars";
      return r;
     }

   //--- STEP 2 - closed-candle requirement: shift starts at 1, the SAME convention every other
   //--- CopyRates(...,1,...) call in this file already uses (EvaluateAbsorptionMind()/
   //--- EvaluateFairValueMind()/EvaluateTimeframeEmaDirection() etc.) - index 0 (the still-forming
   //--- candle on this timeframe) is NEVER fetched into this array, so it is structurally impossible
   //--- for ratesVol[0] below to be a forming candle.
   int needed = baselineBars + 1; // +1 for the reference candle itself (ratesVol[0])
   MqlRates ratesVol[]; ArraySetAsSeries(ratesVol, true);
   int nVol = CopyRates(g_symbol, tf, 1, needed, ratesVol);
   if(nVol < 2) // need at least the reference candle + 1 baseline candle to say anything
     {
      r.reasoning = StringFormat("insufficient closed-candle history (have=%d need>=%d)", nVol, needed);
      return r;
     }

   //--- STEP 4 - RAW VOLUME. Preserved exactly as MqlRates reports it (long, MT5's own tick_volume
   //--- type) - never rounded, never rescaled, never converted toward a lot-size concept.
   r.barTime    = ratesVol[0].time;
   r.tickVolume = ratesVol[0].tick_volume;

   //--- STEP 5 - BASELINE VOLUME, from ratesVol[1..nVol-1] ONLY - the reference candle (index 0) is
   //--- explicitly excluded from its own baseline, per the explicit requirement.
   int baselineCount = nVol - 1;
   double sumVol = 0.0;
   for(int i = 1; i < nVol; i++) sumVol += (double)ratesVol[i].tick_volume;
   double averageVolume = (baselineCount > 0) ? (sumVol / baselineCount) : 0.0;
   bool haveBaseline = (baselineCount > 0) && MathIsValidNumber(averageVolume) && averageVolume > 0.0;
   r.averageVolume = haveBaseline ? averageVolume : 0.0;

   //--- STEP 6 - RELATIVE VOLUME. Guarded exactly per the explicit instruction: averageVolume<=0
   //--- produces a safe 0.0 (never NaN/Infinity), with haveRelativeVolume=false driving
   //--- ClassifyVolumeDna() to "UNKNOWN" rather than a fabricated class.
   bool haveRelativeVolume = haveBaseline;
   double relativeVolume = haveRelativeVolume ? SafeDiv((double)r.tickVolume, averageVolume, 0.0) : 0.0;
   r.relativeVolume = relativeVolume;
   r.volumeClass = ClassifyVolumeDna(relativeVolume, haveRelativeVolume);

   //--- STEP 8 - PRICE RELATIONSHIP, all computed from the SAME reference candle (ratesVol[0]) the
   //--- volume figures above already came from - never a different bar. "Points" is this file's
   //--- existing convention (no separate MT5 "pip" concept exists anywhere else in this file for
   //--- XAUUSD - see rangePips's own struct-field comment).
   double o = ratesVol[0].open, h = ratesVol[0].high, l = ratesVol[0].low, c = ratesVol[0].close;
   double range = h - l;
   r.rangePoints = range;
   r.rangePips   = range; // intentionally identical - see VolumeDnaResult.rangePips's own comment
   r.bodySizePoints = MathAbs(c - o);
   r.bodyRatio = SafeDiv(r.bodySizePoints, range, 0.0) * 100.0;
   r.upperWickPoints = h - MathMax(o, c);
   r.lowerWickPoints = MathMin(o, c) - l;
   r.closeLocation = SafeDiv(c - l, range, 0.0); // classic CLV, 0..1

   //--- rangeATR - classic 14-period True Range mean, computed fresh from THIS SAME window
   //--- (ratesVol), same formula EMA Trend/Fair Value Minds already use - no shared "ATR engine",
   //--- matching this file's established per-function-independence convention (see e.g.
   //--- EvaluateFairValueMind()'s own "Local ATR... computed independently here... not shared state,
   //--- no duplicate 'engine'" comment for the precedent this follows).
   const int atrPeriod = 14;
   double atrSum = 0.0; int atrSamples = 0;
   for(int i = 0; i < atrPeriod && (i+1) < nVol; i++)
     {
      double highLow  = ratesVol[i].high - ratesVol[i].low;
      double highPrev = MathAbs(ratesVol[i].high - ratesVol[i+1].close);
      double lowPrev  = MathAbs(ratesVol[i].low  - ratesVol[i+1].close);
      atrSum += MathMax(highLow, MathMax(highPrev, lowPrev)); atrSamples++;
     }
   double atr = (atrSamples > 0) ? (atrSum / atrSamples) : 0.0;
   bool haveAtr = (atrSamples >= 2) && MathIsValidNumber(atr) && atr > 0.0;
   r.rangeATR = haveAtr ? SafeDiv(range, atr, 0.0) : 0.0;

   //--- STEP 9 - volumeEfficiency: a DERIVED ANALYTICAL RATIO ONLY, per the explicit naming
   //--- requirement (Section 9) - conceptually adjacent to EvaluateAbsorptionMind()'s own "effort vs
   //--- response" idea (generalized here as a simple, transparent range-per-tick ratio, not that
   //--- Mind's own multi-stage scoring - never a competing/duplicate implementation of Absorption's
   //--- own pressure/effort/response/inefficiency pipeline, which stays completely untouched).
   r.volumeEfficiency = (r.tickVolume > 0) ? SafeDiv(range, (double)r.tickVolume, 0.0) : 0.0;

   r.valid = true;
   r.reasoning = StringFormat("bars=%d baseline=%d", nVol, baselineCount);
   return r;
  }

//--- Section 10 - serializes ONE timeframe's VolumeDnaResult into the exact nested-object shape the
//--- spec's own example shows. UNKNOWN/invalid fields are written as JSON null (never a fabricated
//--- 0.0 masquerading as a real reading) - same "null when genuinely unavailable" convention this
//--- file already uses for originalSL/adverseMovePctOfOriginalSL etc.
string SerializeVolumeDnaTf(const VolumeDnaResult &r)
  {
   if(!r.valid)
      return StringFormat(
         "{\"valid\":false,\"reasoning\":\"%s\",\"tickVolume\":null,\"averageVolume\":null,"
         "\"relativeVolume\":null,\"volumeClass\":\"UNKNOWN\",\"rangePoints\":null,\"rangePips\":null,"
         "\"bodySizePoints\":null,\"bodyRatio\":null,\"upperWickPoints\":null,\"lowerWickPoints\":null,"
         "\"closeLocation\":null,\"rangeATR\":null,\"volumeEfficiency\":null}",
         DashJsonEscape(r.reasoning));

   bool haveRvol = (r.volumeClass != "UNKNOWN");
   return StringFormat(
      "{\"valid\":true,\"barTime\":\"%s\",\"tickVolume\":%I64d,\"averageVolume\":%.2f,"
      "\"relativeVolume\":%s,\"volumeClass\":\"%s\",\"rangePoints\":%.3f,\"rangePips\":%.3f,"
      "\"bodySizePoints\":%.3f,\"bodyRatio\":%.2f,\"upperWickPoints\":%.3f,\"lowerWickPoints\":%.3f,"
      "\"closeLocation\":%.4f,\"rangeATR\":%.3f,\"volumeEfficiency\":%s}",
      DashIsoTime(r.barTime), r.tickVolume, r.averageVolume,
      haveRvol ? DoubleToString(r.relativeVolume,4) : "null", r.volumeClass, r.rangePoints, r.rangePips,
      r.bodySizePoints, r.bodyRatio, r.upperWickPoints, r.lowerWickPoints,
      r.closeLocation, r.rangeATR, (r.tickVolume>0) ? DoubleToString(r.volumeEfficiency,6) : "null");
  }

//--- Section 3/10 - builds the FULL "volumeDNA":{...} block across all 4 timeframes, ONE calculator
//--- called 4 times (never 4 independent implementations, per the explicit instruction). 20 completed
//--- candles is the conservative fixed baseline the spec's own Step 5 asked for (no existing
//--- KMIE-wide volume-specific lookback input existed for this purpose per the prior audit - Absorption's
//--- own Inp_AbsorptionLookback is THAT Mind's own tuned parameter, not a general-purpose volume
//--- baseline, and is left untouched/unread here per the "do not create a second competing
//--- implementation" instruction).
#define KMIE_VOLUME_DNA_BASELINE_BARS 20
string BuildVolumeDnaBlock()
  {
   VolumeDnaResult m1  = ComputeVolumeDna(PERIOD_M1,  KMIE_VOLUME_DNA_BASELINE_BARS);
   VolumeDnaResult m5  = ComputeVolumeDna(PERIOD_M5,  KMIE_VOLUME_DNA_BASELINE_BARS);
   VolumeDnaResult m15 = ComputeVolumeDna(PERIOD_M15, KMIE_VOLUME_DNA_BASELINE_BARS);
   VolumeDnaResult h1  = ComputeVolumeDna(PERIOD_H1,  KMIE_VOLUME_DNA_BASELINE_BARS);
   return StringFormat("{\"M1\":%s,\"M5\":%s,\"M15\":%s,\"H1\":%s}",
         SerializeVolumeDnaTf(m1), SerializeVolumeDnaTf(m5), SerializeVolumeDnaTf(m15), SerializeVolumeDnaTf(h1));
  }

//====================================================================
// PRICE/PIPS INTELLIGENCE FOUNDATION (2026-09-03, explicit operator request - Phase 1 of the
// PRICE_VOLUME_EXPANSION project, explicitly instructed to STOP after this phase and NOT touch any
// DNA state/calibration/trading logic). Purpose: a reusable, generic Price/Range measurement layer -
// the missing counterpart to the Volume DNA system just above, which already has average/relative/
// class infrastructure that Price/Range never had. This section is PURE MEASUREMENT - nothing below
// is read by EvaluateMarketDNA()/scores[]/CalibrateMarketDNAScores()/CurrentRegimeAllowed()/Minds/
// Entry Approval/execution/TP/SL. It exists so a FUTURE phase (PRICE_VOLUME_EXPANSION, or any other
// DNA state) can consume it - deliberately NOT wired into any live decision yet.
//
// STEP 1 AUDIT RESULT (pip-size formula): this file has NO separate MT5 "pip" concept anywhere -
// VolumeDnaResult.rangePips is already documented as "intentionally identical" to rangePoints
// (raw high-low price distance, NOT divided by _Point) because XAUUSD has no distinct pip/point
// convention in this codebase. Every new field below follows the SAME established convention -
// "pips" here means raw price-unit distance, exactly matching the existing rangePips/bodySizePoints
// precedent. No new pip-size helper was created; the existing one-and-only convention was reused.
//
// STEP 2: existing fields (bodyRatio 0..100, rangePips, bodySizePoints, rangeATR, closeLocation) are
// completely UNTOUCHED - VolumeDnaResult/ComputeVolumeDna()/SerializeVolumeDnaTf() are not modified by
// a single character below. This is a SEPARATE, ADDITIVE struct/function pair, not new fields bolted
// onto the existing one - so the already-live, already-consumed entry_dna.jsonl "volumeDNA" JSON shape
// has zero risk of accidental breakage (Step 24).
//====================================================================

//--- Step 7 - centralized range classification bins (mirrors ClassifyVolumeDna()'s own "one function,
//--- documented thresholds" convention exactly, but with the operator's own DIFFERENT class names/
//--- cutoffs for range - QUIET/LOW/NORMAL/ELEVATED/HIGH/VERY_HIGH/EXTREME, distinct from volume's
//--- VERY_LOW/LOW/NORMAL/ELEVATED/HIGH/VERY_HIGH/EXTREME).
string ClassifyRangeDna(const double relativeRange, const bool haveRelativeRange)
  {
   if(!haveRelativeRange) return "UNKNOWN";
   if(relativeRange < 0.70) return "QUIET";
   if(relativeRange < 1.00) return "LOW";
   if(relativeRange < 1.30) return "NORMAL";
   if(relativeRange < 1.60) return "ELEVATED";
   if(relativeRange < 2.00) return "HIGH";
   if(relativeRange < 3.00) return "VERY_HIGH";
   return "EXTREME";
  }

//--- One candle's Price/Range measurement - PAIRS WITH VolumeDnaResult (never replaces it, never
//--- duplicates its volume fields - Step 17 "do not duplicate Volume calculations"). A future
//--- combined "MARKET CANDLE" concept (Phase 2+) attaches one of THESE alongside one VolumeDnaResult
//--- per candle, per the operator's own architecture diagram.
struct PriceRangeDnaResult
  {
   bool     valid;                  // false = insufficient history - every numeric field below is then 0.0/UNKNOWN, never fabricated
   string   reasoning;              // why valid==false, when it is
   datetime barTime;                // this candle's own open time
   double   rangePoints;            // high-low, raw price units - SAME formula as VolumeDnaResult.rangePoints
   double   rangePips;              // intentionally identical to rangePoints - see this section's own header
   double   avgRangePips20;         // Step 3 - mean rangePips over the 20 candles immediately OLDER than this one (never includes this candle)
   double   medianRangePips20;      // Step 4 - median of the SAME 20-candle population
   double   relativeRange;          // Step 5 - rangePips / avgRangePips20, SafeDiv-guarded
   double   rangePercentile;        // Step 6 - 0..100, % of the 20 baseline ranges <= this candle's own range
   string   rangeClass;             // Step 7 - QUIET/LOW/NORMAL/ELEVATED/HIGH/VERY_HIGH/EXTREME/UNKNOWN
   bool     haveRangeAcceleration;  // false only if the immediately-older candle's own baseline couldn't be computed (edge of available history)
   double   rangeAcceleration;      // Step 8 - this candle's relativeRange MINUS the immediately older candle's own relativeRange
   double   bodyPips;               // Step 9 - |close-open|, raw price units - SAME value/formula as VolumeDnaResult.bodySizePoints, aliased name only (no duplicate calculation)
   double   bodyRatio;              // Step 12 - SAME 0..100 scale/formula as VolumeDnaResult.bodyRatio (bodyPips/rangePips*100)
   double   closeLocation;          // SAME formula as VolumeDnaResult.closeLocation, 0..1 (classic CLV)
   double   closeToClosePips;       // Step 10 - |close[this] - close[immediately older candle]|, raw price units
   double   signedCloseToClosePips; // Step 10 - close[this] - close[older], SIGNED (+up/-down) - a separate diagnostic field, never overwrites the unsigned one
   double   rangeATR;               // Step 11 - SAME classic 14-period True Range formula as VolumeDnaResult.rangeATR, re-derived here only because it must anchor at THIS candle's own index, not "now"
  };

//--- Shared inner helper (Steps 3/5/8): relativeRange for the candle at idx, using rates[idx+1..
//--- idx+baselineBars] (strictly OLDER, chronologically) as its own baseline - written ONCE so both
//--- ComputePriceRangeDna()'s own relativeRange AND its "immediately older candle" lookup for
//--- rangeAcceleration reuse the identical average/guard logic rather than duplicating it.
double PriceRangeRelativeRangeAt(const MqlRates &rates[], const int idx, const int baselineBars, bool &haveIt)
  {
   haveIt = false;
   int total = ArraySize(rates);
   if(idx<0 || idx>=total || baselineBars<1 || (idx+baselineBars)>=total) return 0.0;
   double sum=0.0;
   for(int i=0;i<baselineBars;i++)
      sum += (rates[idx+1+i].high - rates[idx+1+i].low);
   double avgRange = sum/baselineBars;
   if(!(MathIsValidNumber(avgRange) && avgRange>0.0)) return 0.0;
   double range = rates[idx].high - rates[idx].low;
   haveIt = true;
   return SafeDiv(range, avgRange, 0.0);
  }

//--- Step 15 - the generic, timeframe-agnostic per-candle Price/Range calculator. Operates on an
//--- ALREADY-FETCHED, newest-first (ArraySetAsSeries) rates[] array - never calls CopyRates itself, so
//--- BuildMarketDnaWindow30() below fetches ONCE and calls this up to 30 times against the SAME array
//--- (Step 23 - no repeated CopyRates per metric). idx is the analyzed candle's own index; baselineBars
//--- candles AFTER it in the array (idx+1..idx+baselineBars - OLDER in real time, since the array is
//--- newest-first) form its baseline. Nothing at idx-1 or lower (NEWER/future relative to idx) is EVER
//--- read anywhere in this function - zero look-ahead by construction (Step 20).
PriceRangeDnaResult ComputePriceRangeDna(const MqlRates &rates[], const int idx, const int baselineBars)
  {
   PriceRangeDnaResult r;
   r.valid=false; r.reasoning=""; r.barTime=0;
   r.rangePoints=0.0; r.rangePips=0.0; r.avgRangePips20=0.0; r.medianRangePips20=0.0;
   r.relativeRange=0.0; r.rangePercentile=0.0; r.rangeClass="UNKNOWN";
   r.haveRangeAcceleration=false; r.rangeAcceleration=0.0;
   r.bodyPips=0.0; r.bodyRatio=0.0; r.closeLocation=0.0;
   r.closeToClosePips=0.0; r.signedCloseToClosePips=0.0; r.rangeATR=0.0;

   int total = ArraySize(rates);
   if(idx<0 || idx>=total || baselineBars<1 || (idx+baselineBars)>=total || (idx+1)>=total)
     {
      r.reasoning = StringFormat("insufficient history (idx=%d baselineBars=%d total=%d)", idx, baselineBars, total);
      return r;
     }

   //--- STEP 9/12 - price relationship, all from THIS SAME reference candle (rates[idx]) - never a
   //--- different bar. Byte-for-byte the same formulas VolumeDnaResult already uses (Step 2/24).
   double o=rates[idx].open, h=rates[idx].high, l=rates[idx].low, c=rates[idx].close;
   double range = h-l;
   r.barTime = rates[idx].time;
   r.rangePoints = range;
   r.rangePips   = range; // intentionally identical - see this section's own header
   r.bodyPips = MathAbs(c-o);                          // = bodySizePoints, same formula, aliased name (Step 9)
   r.bodyRatio = SafeDiv(r.bodyPips, range, 0.0) * 100.0; // SAME 0..100 scale as VolumeDnaResult.bodyRatio
   r.closeLocation = SafeDiv(c-l, range, 0.0);          // SAME formula as VolumeDnaResult.closeLocation

   //--- STEP 3/4/6 - prior-baselineBars baseline: rates[idx+1..idx+baselineBars], strictly OLDER than
   //--- idx, never including idx itself. Collected once, reused for average/median/percentile below.
   double baseline[];
   ArrayResize(baseline, baselineBars);
   double sum=0.0;
   for(int i=0;i<baselineBars;i++)
     {
      double br = rates[idx+1+i].high - rates[idx+1+i].low;
      baseline[i] = br;
      sum += br;
     }
   double avgRange = sum/baselineBars;
   bool haveBaseline = MathIsValidNumber(avgRange) && avgRange>0.0;
   r.avgRangePips20 = haveBaseline ? avgRange : 0.0;

   //--- STEP 4 - median: sorts a COPY (baseline[] itself is left in chronological order, unused
   //--- afterward here, but kept intact in case a future caller wants it). Even baselineBars (the
   //--- canonical 20) -> average of positions 10/11 (1-indexed) = indices 9/10 (0-indexed), exactly
   //--- the spec's own formula; generalized to odd baselineBars (single middle element) so this stays
   //--- correct if ever called with a different window size.
   double sorted[];
   ArrayCopy(sorted, baseline);
   ArraySort(sorted);
   double median = (baselineBars%2==0)
      ? (sorted[baselineBars/2 - 1] + sorted[baselineBars/2]) / 2.0
      : sorted[baselineBars/2];
   r.medianRangePips20 = haveBaseline ? median : 0.0;

   //--- STEP 5/7 - relativeRange + classification
   bool haveRelativeRange = haveBaseline;
   double relativeRange = haveRelativeRange ? SafeDiv(r.rangePips, r.avgRangePips20, 0.0) : 0.0;
   r.relativeRange = relativeRange;
   r.rangeClass = ClassifyRangeDna(relativeRange, haveRelativeRange);

   //--- STEP 6 - rangePercentile: % of the SAME baseline population <= this candle's own range.
   if(haveBaseline)
     {
      int countLE=0;
      for(int i=0;i<baselineBars;i++) if(baseline[i]<=range) countLE++;
      r.rangePercentile = 100.0*countLE/(double)baselineBars;
     }

   //--- STEP 8 - rangeAcceleration: THIS candle's relativeRange minus the IMMEDIATELY OLDER candle's
   //--- (idx+1 in this newest-first array) own relativeRange - which needs ITS OWN prior-baselineBars
   //--- baseline (rates[idx+2..idx+1+baselineBars]). This is exactly why BuildMarketDnaWindow30() below
   //--- fetches baselineBars extra bars beyond the last analyzed candle's own baseline.
   bool haveOlderRelativeRange=false;
   double olderRelativeRange = PriceRangeRelativeRangeAt(rates, idx+1, baselineBars, haveOlderRelativeRange);
   r.haveRangeAcceleration = haveRelativeRange && haveOlderRelativeRange;
   r.rangeAcceleration = r.haveRangeAcceleration ? (relativeRange - olderRelativeRange) : 0.0;

   //--- STEP 10 - close-to-close vs the IMMEDIATELY OLDER chronological candle (idx+1) - a distinct,
   //--- simpler adjacent-candle measure, never the baseline average. Directional sign preserved
   //--- separately (signedCloseToClosePips) per explicit instruction - the unsigned field is never
   //--- overwritten/replaced by it.
   double closeOlder = rates[idx+1].close;
   r.signedCloseToClosePips = c - closeOlder;
   r.closeToClosePips = MathAbs(r.signedCloseToClosePips);

   //--- STEP 11 - rangeATR: SAME classic 14-period True Range formula VolumeDnaResult.rangeATR already
   //--- uses (see ComputeVolumeDna()'s own header for the precedent) - re-derived here only because it
   //--- must anchor at THIS candle's own idx, never "now"/the live tick. Not a second ATR methodology.
   const int atrPeriod=14;
   double atrSum=0.0; int atrSamples=0;
   for(int i=idx; i<idx+atrPeriod && (i+1)<total; i++)
     {
      double highLow  = rates[i].high - rates[i].low;
      double highPrev = MathAbs(rates[i].high - rates[i+1].close);
      double lowPrev  = MathAbs(rates[i].low  - rates[i+1].close);
      atrSum += MathMax(highLow, MathMax(highPrev, lowPrev)); atrSamples++;
     }
   double atr = (atrSamples>0) ? (atrSum/atrSamples) : 0.0;
   bool haveAtr = (atrSamples>=2) && MathIsValidNumber(atr) && atr>0.0;
   r.rangeATR = haveAtr ? SafeDiv(range, atr, 0.0) : 0.0;

   r.valid = true;
   r.reasoning = StringFormat("idx=%d baseline=%d", idx, baselineBars);
   return r;
  }

//--- Step 16 constants - deliberately named/separated per the operator's own explicit instruction
//--- ("MARKET_DNA_STATE_COUNT" vs "MARKET_DNA_CANDLE_WINDOW" must stay independent constants). This
//--- is the CANDLE-COUNT concept - completely unrelated to LDNA_STATE_COUNT (the DNA STATE-COUNT
//--- concept, still 25, untouched by this phase). KMIE_PRICE_RANGE_DNA_BASELINE_BARS deliberately
//--- matches KMIE_VOLUME_DNA_BASELINE_BARS's own value (20) - same baseline size, kept as its own
//--- named constant rather than reusing that one directly, since the two systems are independent by
//--- design (Step 17) and a future change to one must never silently move the other.
#define KMIE_PRICE_RANGE_DNA_WINDOW 30
#define KMIE_PRICE_RANGE_DNA_BASELINE_BARS 20

//--- Step 16/23 - fetches M1 history ONCE (shift=1..N, never shift=0/the running candle - Step 20/26),
//--- then computes ComputePriceRangeDna() for each of the (up to) 30 analyzed candles purely by
//--- indexing into this SAME array - no repeated CopyRates(). Returns the count actually filled (may
//--- be less than KMIE_PRICE_RANGE_DNA_WINDOW if genuinely insufficient history exists - e.g. right
//--- after a fresh symbol subscription - never fabricated to reach 30).
int BuildMarketDnaWindow30(PriceRangeDnaResult &out[])
  {
   //--- Sizing (Step 16's own "51-52+" estimate): 30 analyzed + 20 baseline (for the OLDEST analyzed
   //--- candle, index 29, whose baseline is indices 30-49) + 20 MORE so index 29's own
   //--- rangeAcceleration lookup (which needs index 30's OWN baseline, indices 31-50) has enough
   //--- history = 30+20+20=70 in the fully-independent worst case; the true minimum with the actual
   //--- overlapping windows is 30+20+1=51. A small safety margin is added above that, never bare-
   //--- minimum-exact.
   const int fetchTotal = KMIE_PRICE_RANGE_DNA_WINDOW + KMIE_PRICE_RANGE_DNA_BASELINE_BARS + KMIE_PRICE_RANGE_DNA_BASELINE_BARS + 2;
   MqlRates rates[];
   ArraySetAsSeries(rates, true);
   int got = CopyRates(g_symbol, PERIOD_M1, 1, fetchTotal, rates); // shift=1 start - shift 0 (running candle) NEVER included
   ArrayResize(out, 0);
   if(got<1) return 0;

   int n = MathMin(KMIE_PRICE_RANGE_DNA_WINDOW, got);
   ArrayResize(out, n);
   for(int i=0;i<n;i++)
      out[i] = ComputePriceRangeDna(rates, i, KMIE_PRICE_RANGE_DNA_BASELINE_BARS);
   return n;
  }

//--- 2026-09-08, explicit operator request ("Update DNA bar counts" - PULLBACK_UP/PULLBACK_DOWN/
//--- VOLATILITY_EXPANSION/VOLATILITY_COMPRESSION/VOLATILE/CHOPPY/NEUTRAL moved to a 15-bar window):
//--- parameterized sibling of BuildMarketDnaWindow30() above - IDENTICAL logic/baseline convention
//--- (SAME KMIE_PRICE_RANGE_DNA_BASELINE_BARS=20 baseline, SAME ComputePriceRangeDna() call, SAME
//--- closed-candle-only shift=1..N fetch), just parameterized on the analyzed-window size instead of
//--- the hardcoded 30. BuildMarketDnaWindow30() itself is completely UNCHANGED (still feeds
//--- strongTrendStruct/WEAK_UPTREND/WEAK_DOWNTREND at their own existing 25-bar window) - this is an
//--- ADDITIVE new function, never a modification of the original, so nothing that already depends on
//--- the 30-fetch/25-analyzed convention is affected. Callers pass the number of ANALYZED candles they
//--- need (e.g. 15) - the baseline/safety-margin fetch sizing follows the exact same formula
//--- BuildMarketDnaWindow30() already uses, just with `windowSize` substituted for the literal 30.
int BuildMarketDnaWindowN(const int windowSize, PriceRangeDnaResult &out[])
  {
   const int fetchTotal = windowSize + KMIE_PRICE_RANGE_DNA_BASELINE_BARS + KMIE_PRICE_RANGE_DNA_BASELINE_BARS + 2;
   MqlRates rates[];
   ArraySetAsSeries(rates, true);
   int got = CopyRates(g_symbol, PERIOD_M1, 1, fetchTotal, rates); // shift=1 start - shift 0 (running candle) NEVER included
   ArrayResize(out, 0);
   if(got<1) return 0;

   int n = MathMin(windowSize, got);
   ArrayResize(out, n);
   for(int i=0;i<n;i++)
      out[i] = ComputePriceRangeDna(rates, i, KMIE_PRICE_RANGE_DNA_BASELINE_BARS);
   return n;
  }

//--- 2026-09-16, M5 PARALLEL PIPELINE: straight PERIOD_M5 duplicates of BuildMarketDnaWindow30()/
//--- BuildMarketDnaWindowN() above. Neither original is parameter-pure with respect to timeframe - both
//--- hardcode CopyRates(g_symbol, PERIOD_M1, ...) internally - so EvaluateMarketDnaM5() must call these
//--- M5-suffixed twins instead, or its "M5" DNA classification would silently keep reading M1 bars for
//--- every structural formula that depends on these windows (StrongTrend/WeakTrend/Pullback/
//--- VolExpansion/VolCompression/Choppy/Neutral/Volatile).
int BuildMarketDnaWindow30M5(PriceRangeDnaResult &out[])
  {
   const int fetchTotal = KMIE_PRICE_RANGE_DNA_WINDOW + KMIE_PRICE_RANGE_DNA_BASELINE_BARS + KMIE_PRICE_RANGE_DNA_BASELINE_BARS + 2;
   MqlRates rates[];
   ArraySetAsSeries(rates, true);
   int got = CopyRates(g_symbol, PERIOD_M5, 1, fetchTotal, rates);
   ArrayResize(out, 0);
   if(got<1) return 0;

   int n = MathMin(KMIE_PRICE_RANGE_DNA_WINDOW, got);
   ArrayResize(out, n);
   for(int i=0;i<n;i++)
      out[i] = ComputePriceRangeDna(rates, i, KMIE_PRICE_RANGE_DNA_BASELINE_BARS);
   return n;
  }

int BuildMarketDnaWindowN_M5(const int windowSize, PriceRangeDnaResult &out[])
  {
   const int fetchTotal = windowSize + KMIE_PRICE_RANGE_DNA_BASELINE_BARS + KMIE_PRICE_RANGE_DNA_BASELINE_BARS + 2;
   MqlRates rates[];
   ArraySetAsSeries(rates, true);
   int got = CopyRates(g_symbol, PERIOD_M5, 1, fetchTotal, rates);
   ArrayResize(out, 0);
   if(got<1) return 0;

   int n = MathMin(windowSize, got);
   ArrayResize(out, n);
   for(int i=0;i<n;i++)
      out[i] = ComputePriceRangeDna(rates, i, KMIE_PRICE_RANGE_DNA_BASELINE_BARS);
   return n;
  }

//--- 2026-09-23, M15 PARALLEL PIPELINE: straight PERIOD_M15 duplicates of BuildMarketDnaWindow30()/
//--- BuildMarketDnaWindowN() above, mirroring the M5 twins immediately above exactly. Neither M1 original
//--- is parameter-pure with respect to timeframe - both hardcode CopyRates(g_symbol, PERIOD_M1, ...)
//--- internally - so EvaluateMarketDnaM15() must call these M15-suffixed twins instead, or its "M15" DNA
//--- classification would silently keep reading M1 bars for every structural formula that depends on
//--- these windows (StrongTrend/WeakTrend/Pullback/VolExpansion/VolCompression/Choppy/Neutral/Volatile).
int BuildMarketDnaWindow30M15(PriceRangeDnaResult &out[])
  {
   const int fetchTotal = KMIE_PRICE_RANGE_DNA_WINDOW + KMIE_PRICE_RANGE_DNA_BASELINE_BARS + KMIE_PRICE_RANGE_DNA_BASELINE_BARS + 2;
   MqlRates rates[];
   ArraySetAsSeries(rates, true);
   int got = CopyRates(g_symbol, PERIOD_M15, 1, fetchTotal, rates);
   ArrayResize(out, 0);
   if(got<1) return 0;

   int n = MathMin(KMIE_PRICE_RANGE_DNA_WINDOW, got);
   ArrayResize(out, n);
   for(int i=0;i<n;i++)
      out[i] = ComputePriceRangeDna(rates, i, KMIE_PRICE_RANGE_DNA_BASELINE_BARS);
   return n;
  }

int BuildMarketDnaWindowN_M15(const int windowSize, PriceRangeDnaResult &out[])
  {
   const int fetchTotal = windowSize + KMIE_PRICE_RANGE_DNA_BASELINE_BARS + KMIE_PRICE_RANGE_DNA_BASELINE_BARS + 2;
   MqlRates rates[];
   ArraySetAsSeries(rates, true);
   int got = CopyRates(g_symbol, PERIOD_M15, 1, fetchTotal, rates);
   ArrayResize(out, 0);
   if(got<1) return 0;

   int n = MathMin(windowSize, got);
   ArrayResize(out, n);
   for(int i=0;i<n;i++)
      out[i] = ComputePriceRangeDna(rates, i, KMIE_PRICE_RANGE_DNA_BASELINE_BARS);
   return n;
  }

//--- Serializes ONE PriceRangeDnaResult - same "null when genuinely unavailable, never a fabricated
//--- 0.0" convention SerializeVolumeDnaTf() already established. Diagnostic-only consumer (below) -
//--- not read by any trading decision.
string SerializePriceRangeDna(const PriceRangeDnaResult &r)
  {
   if(!r.valid)
      return StringFormat(
         "{\"valid\":false,\"reasoning\":\"%s\",\"rangePips\":null,\"avgRangePips20\":null,"
         "\"medianRangePips20\":null,\"relativeRange\":null,\"rangePercentile\":null,\"rangeClass\":\"UNKNOWN\","
         "\"rangeAcceleration\":null,\"bodyPips\":null,\"bodyRatio\":null,\"closeLocation\":null,"
         "\"closeToClosePips\":null,\"signedCloseToClosePips\":null,\"rangeATR\":null}",
         DashJsonEscape(r.reasoning));

   return StringFormat(
      "{\"valid\":true,\"barTime\":\"%s\",\"rangePips\":%.3f,\"avgRangePips20\":%.3f,"
      "\"medianRangePips20\":%.3f,\"relativeRange\":%s,\"rangePercentile\":%.1f,\"rangeClass\":\"%s\","
      "\"rangeAcceleration\":%s,\"bodyPips\":%.3f,\"bodyRatio\":%.2f,\"closeLocation\":%.4f,"
      "\"closeToClosePips\":%.3f,\"signedCloseToClosePips\":%.3f,\"rangeATR\":%.3f}",
      DashIsoTime(r.barTime), r.rangePips, r.avgRangePips20,
      r.medianRangePips20, (r.rangeClass!="UNKNOWN") ? DoubleToString(r.relativeRange,4) : "null", r.rangePercentile, r.rangeClass,
      r.haveRangeAcceleration ? DoubleToString(r.rangeAcceleration,4) : "null", r.bodyPips, r.bodyRatio, r.closeLocation,
      r.closeToClosePips, r.signedCloseToClosePips, r.rangeATR);
  }

//--- Step 22 - diagnostic-only real-XAUUSD validation writer. Throttled (own timer, independent of
//--- every other throttle in this file), writes the full 30-candle window to price_range_dna.jsonl -
//--- a NEW, dedicated file, never mixed into any existing log. NEVER read by any trading decision -
//--- purely for the operator/Claude to inspect real live output against the deterministic test cases.
datetime g_priceRangeDnaLogLastTime = 0;
void LogPriceRangeDnaWindow()
  {
   if(!Inp_DashboardLogEnabled) return;
   if(TimeCurrent()==g_priceRangeDnaLogLastTime) return;
   g_priceRangeDnaLogLastTime = TimeCurrent();

   PriceRangeDnaResult window[];
   int n = BuildMarketDnaWindow30(window);
   if(n<1) return;

   string line = StringFormat("{\"time\":\"%s\",\"symbol\":\"%s\",\"count\":%d,\"candles\":[", DashIsoTime(TimeCurrent()), g_symbol, n);
   for(int i=0;i<n;i++)
      line += (i>0?",":"") + SerializePriceRangeDna(window[i]);
   line += "]}";
   DashAppendLine("price_range_dna.jsonl", line);
  }

//--- Step 21 - deterministic test cases, run ONCE at startup (OnInit(), never during a live trading
//--- tick) against SYNTHETIC MqlRates arrays this function builds itself - never real market data, so
//--- results are 100% reproducible. PASS/FAIL only, logged to the Experts log + logs.jsonl - never
//--- read by any trading decision, never blocks OnInit() from succeeding even on a FAIL (a failed
//--- self-test should be visible, not fatal - matches this file's own "never crash live trading over a
//--- diagnostic" convention).
void PriceRangeDnaTestAssert(const string testName, const bool pass, const string detail)
  {
   string msg = StringFormat("[PRICE_RANGE_DNA_TEST][%s] %s - %s", pass?"PASS":"FAIL", testName, detail);
   Print(msg);
   if(Inp_DashboardLogEnabled)
      DashAppendLine("logs.jsonl", StringFormat("{\"time\":\"%s\",\"tag\":\"PRICE_RANGE_DNA_TEST\",\"message\":\"%s\"}",
            DashIsoTime(TimeCurrent()), DashJsonEscape(msg)));
  }

//--- Builds a synthetic newest-first rates[] array of `count` candles, each with the given range (in
//--- raw price units, starting from an arbitrary base price) and body ratio, all otherwise identical -
//--- exactly the flat/uniform baseline the deterministic test cases need (Step 21's "20 baseline
//--- candles all have 50 pips" style setup). bodyRatioPct is 0..100, applied symmetrically around the
//--- candle's own midpoint so closeLocation comes out near 0.5 (direction-neutral) unless a test
//--- overrides specific candles afterward.
void BuildSyntheticFlatRates(MqlRates &out[], const int count, const double rangeVal, const double bodyRatioPct)
  {
   ArrayResize(out, count);
   double base = 2000.0;
   double bodyHalf = rangeVal * (bodyRatioPct/100.0) / 2.0;
   for(int i=0;i<count;i++)
     {
      out[i].time  = (datetime)(1700000000 - i*60);
      out[i].open  = base;
      out[i].close = base;
      out[i].high  = base + bodyHalf + (rangeVal-bodyHalf*2.0)/2.0;
      out[i].low   = base - bodyHalf - (rangeVal-bodyHalf*2.0)/2.0;
      out[i].tick_volume = 100;
     }
  }

void RunPriceRangeDnaTests()
  {
   int    bl = KMIE_PRICE_RANGE_DNA_BASELINE_BARS; // 20
   MqlRates rates[];

   //--- CASE 1/2/3/4 - flat 20-candle baseline of `baselineRange`, analyzed candle (index 0) with
   //--- `currentRange` - checks avgRangePips20/medianRangePips20/relativeRange/rangeClass exactly per
   //--- the spec's own worked examples. Needs bl (baseline) + bl (so index bl's own rangeAcceleration
   //--- lookup has a full baseline too, keeping haveRangeAcceleration=true) + 2 extra candles = 1 (analyzed) + bl + bl + 1.
   {
      double baselineRange = 50.0, currentRange = 50.0;
      int total = 1 + bl + bl + 1;
      BuildSyntheticFlatRates(rates, total, baselineRange, 50.0);
      rates[0].high = rates[0].open + currentRange/2.0; rates[0].low = rates[0].open - currentRange/2.0;
      PriceRangeDnaResult r = ComputePriceRangeDna(rates, 0, bl);
      PriceRangeDnaTestAssert("CASE1_avg_median_relative",
         r.valid && MathAbs(r.avgRangePips20-50.0)<0.001 && MathAbs(r.medianRangePips20-50.0)<0.001 && MathAbs(r.relativeRange-1.0)<0.001,
         StringFormat("avg=%.3f median=%.3f relativeRange=%.3f (want avg=50 median=50 relativeRange=1.0)", r.avgRangePips20, r.medianRangePips20, r.relativeRange));
   }
   {
      double baselineRange = 50.0, currentRange = 100.0;
      int total = 1 + bl + bl + 1;
      BuildSyntheticFlatRates(rates, total, baselineRange, 50.0);
      rates[0].high = rates[0].open + currentRange/2.0; rates[0].low = rates[0].open - currentRange/2.0;
      PriceRangeDnaResult r = ComputePriceRangeDna(rates, 0, bl);
      PriceRangeDnaTestAssert("CASE2_relativeRange_2x",
         r.valid && MathAbs(r.relativeRange-2.0)<0.001,
         StringFormat("relativeRange=%.3f (want 2.0)", r.relativeRange));
   }
   {
      double baselineRange = 50.0, currentRange = 25.0;
      int total = 1 + bl + bl + 1;
      BuildSyntheticFlatRates(rates, total, baselineRange, 50.0);
      rates[0].high = rates[0].open + currentRange/2.0; rates[0].low = rates[0].open - currentRange/2.0;
      PriceRangeDnaResult r = ComputePriceRangeDna(rates, 0, bl);
      PriceRangeDnaTestAssert("CASE3_relativeRange_half_QUIET",
         r.valid && MathAbs(r.relativeRange-0.5)<0.001 && r.rangeClass=="QUIET",
         StringFormat("relativeRange=%.3f rangeClass=%s (want 0.5/QUIET)", r.relativeRange, r.rangeClass));
   }
   {
      double baselineRange = 50.0, currentRange = 150.0;
      int total = 1 + bl + bl + 1;
      BuildSyntheticFlatRates(rates, total, baselineRange, 50.0);
      rates[0].high = rates[0].open + currentRange/2.0; rates[0].low = rates[0].open - currentRange/2.0;
      PriceRangeDnaResult r = ComputePriceRangeDna(rates, 0, bl);
      PriceRangeDnaTestAssert("CASE4_relativeRange_3x_EXTREME",
         r.valid && MathAbs(r.relativeRange-3.0)<0.001 && r.rangeClass=="EXTREME",
         StringFormat("relativeRange=%.3f rangeClass=%s (want 3.0/EXTREME)", r.relativeRange, r.rangeClass));
   }

   //--- CASE 5 - large range + tiny body -> high relativeRange, low bodyRatio.
   {
      int total = 1 + bl + bl + 1;
      BuildSyntheticFlatRates(rates, total, 50.0, 50.0);
      double bigRange = 150.0, tinyBodyPct = 4.0;
      double bodyHalf = bigRange*(tinyBodyPct/100.0)/2.0;
      rates[0].open = 2000.0; rates[0].close = 2000.0;
      rates[0].high = 2000.0 + bigRange/2.0; rates[0].low = 2000.0 - bigRange/2.0;
      rates[0].close = 2000.0 + bodyHalf; // tiny real body
      PriceRangeDnaResult r = ComputePriceRangeDna(rates, 0, bl);
      PriceRangeDnaTestAssert("CASE5_large_range_tiny_body",
         r.valid && r.relativeRange>=2.0 && r.bodyRatio<10.0,
         StringFormat("relativeRange=%.3f bodyRatio=%.2f (want relativeRange>=2.0, bodyRatio<10)", r.relativeRange, r.bodyRatio));
   }

   //--- CASE 6 - large range + large body + close near high -> high relativeRange, high bodyRatio,
   //--- closeLocation near 1.
   {
      int total = 1 + bl + bl + 1;
      BuildSyntheticFlatRates(rates, total, 50.0, 50.0);
      double bigRange = 150.0;
      rates[0].low  = 2000.0;
      rates[0].high = 2000.0 + bigRange;
      rates[0].open = 2000.0 + bigRange*0.05;
      rates[0].close= 2000.0 + bigRange*0.95; // strong bullish body, close near the high
      PriceRangeDnaResult r = ComputePriceRangeDna(rates, 0, bl);
      PriceRangeDnaTestAssert("CASE6_large_range_large_body_close_near_high",
         r.valid && r.relativeRange>=2.0 && r.bodyRatio>=80.0 && r.closeLocation>=0.90,
         StringFormat("relativeRange=%.3f bodyRatio=%.2f closeLocation=%.3f (want >=2.0/>=80/>=0.90)", r.relativeRange, r.bodyRatio, r.closeLocation));
   }

   //--- CASE 7 - zero range -> safe output, no NaN/Infinity, no crash.
   {
      int total = 1 + bl + bl + 1;
      BuildSyntheticFlatRates(rates, total, 50.0, 50.0);
      rates[0].open=2000.0; rates[0].close=2000.0; rates[0].high=2000.0; rates[0].low=2000.0;
      PriceRangeDnaResult r = ComputePriceRangeDna(rates, 0, bl);
      bool allFinite = MathIsValidNumber(r.rangePips) && MathIsValidNumber(r.bodyRatio) && MathIsValidNumber(r.closeLocation) &&
                        MathIsValidNumber(r.relativeRange) && MathIsValidNumber(r.rangeATR);
      PriceRangeDnaTestAssert("CASE7_zero_range_safe",
         r.valid && allFinite && r.bodyRatio==0.0 && r.closeLocation==0.0,
         StringFormat("allFinite=%s bodyRatio=%.3f closeLocation=%.3f (want true/0/0, no NaN/Inf)", allFinite?"true":"false", r.bodyRatio, r.closeLocation));
   }

   //--- Insufficient-history edge case (Step 26) - idx too close to the end of a short array must
   //--- return valid=false, never crash/fabricate.
   {
      MqlRates shortRates[];
      BuildSyntheticFlatRates(shortRates, 5, 50.0, 50.0);
      PriceRangeDnaResult r = ComputePriceRangeDna(shortRates, 0, bl);
      PriceRangeDnaTestAssert("CASE_EDGE_insufficient_history",
         !r.valid && StringLen(r.reasoning)>0,
         StringFormat("valid=%s reasoning=\"%s\" (want false/non-empty)", r.valid?"true":"false", r.reasoning));
   }
  }

//--- Lightweight single-candle wrapper around Phase 1's ComputePriceRangeDna() - fetches ONLY enough
//--- history for ONE reference candle's own reading (idx=0, the most recently CLOSED M1 candle - shift
//--- 0/the running candle is never fetched), not the full 30-candle window BuildMarketDnaWindow30()
//--- builds. Deliberate engineering choice, disclosed here: EvaluateMarketDNA() runs on EVERY tick and
//--- only ever needs the CURRENT reference candle's Price Intelligence reading, not all 30 - calling
//--- BuildMarketDnaWindow30() wholesale here would recompute all 30 candles' worth of baseline/ATR/sort
//--- work on every single tick (vs. its existing once-per-second diagnostic use), a needless multiplier
//--- with zero benefit to this state's own scoring. Zero duplicate MATH either way - both this and
//--- BuildMarketDnaWindow30() call the exact same ComputePriceRangeDna().
PriceRangeDnaResult ComputePriceRangeDnaLive()
  {
   const int fetchTotal = KMIE_PRICE_RANGE_DNA_BASELINE_BARS + KMIE_PRICE_RANGE_DNA_BASELINE_BARS + 2; // 20+20+2=42, enough for idx=0's own baseline + its rangeAcceleration lookup
   MqlRates rates[];
   ArraySetAsSeries(rates, true);
   int got = CopyRates(g_symbol, PERIOD_M1, 1, fetchTotal, rates); // shift=1 start - shift 0 (running candle) NEVER included
   PriceRangeDnaResult empty;
   empty.valid=false; empty.reasoning="insufficient history"; empty.barTime=0;
   empty.rangePoints=0.0; empty.rangePips=0.0; empty.avgRangePips20=0.0; empty.medianRangePips20=0.0;
   empty.relativeRange=0.0; empty.rangePercentile=0.0; empty.rangeClass="UNKNOWN";
   empty.haveRangeAcceleration=false; empty.rangeAcceleration=0.0;
   empty.bodyPips=0.0; empty.bodyRatio=0.0; empty.closeLocation=0.0;
   empty.closeToClosePips=0.0; empty.signedCloseToClosePips=0.0; empty.rangeATR=0.0;
   if(got<1) return empty;
   return ComputePriceRangeDna(rates, 0, KMIE_PRICE_RANGE_DNA_BASELINE_BARS);
  }

//--- 2026-09-04, explicit operator request (FULL MARKET DNA CONSOLIDATION): PRICE_VOLUME_EXPANSION is
//--- FULLY REMOVED. ClassifyPriceVolumeExpansion()/PriceVolumeExpansionStructure/
//--- EvaluatePriceVolumeExpansionStructure()/LogPriceVolumeExpansionDna()/RunPriceVolumeExpansionTests()
//--- are all deleted - source-audited before removal to confirm zero remaining consumers.
//--- ComputePriceRangeDnaLive() is KEPT (a genuine cross-consumer exists at RecordEntryDna()'s own
//--- priceRangeDnaJson serialization, unrelated to this state).

//--- 2026-09-03, explicit operator request (ACTIVE_PING ARCHITECTURE, Step 12 validation): deterministic
//--- test cases for ClassifyActivePing() - the pure decision function - run ONCE at startup (OnInit()),
//--- against literal scalar inputs. Uses
//--- Inp_EMAMinGapATR as the live threshold (per explicit instruction: "using existing parameters such
//--- as Inp_EMASlopeLookback / Inp_EMAMinGapATR") so these tests are self-consistent with whatever the
//--- operator has actually configured, rather than a hardcoded literal that could silently drift from
//--- the live threshold.
void RunActivePingTests()
  {
   bool corridor; ENUM_LITE_DIR slopeDir; bool slopeActive, active;
   double gapATR = Inp_EMAMinGapATR;

   //--- 2026-09-16, explicit operator request ("Active Ping should be only in 20 to 50 removed 35 and
   //--- crosses both EMA 20 & 50"): TEST1-9 REWRITTEN. The live g_activePing.active formula no longer
   //--- reads ClassifyActivePing()'s own `active`/`slopeActive` output at all (see EvaluateActivePing()'s
   //--- own updated body - r.active = r.corridorActive, ORed with a live per-tick crossing flag in
   //--- OnTick()) - ClassifyActivePing() itself is UNCHANGED and still called (its corridorActive output IS
   //--- reused), but its own `active`/`slopeActive` outputs are now dead for gating purposes. These tests
   //--- now verify corridorActive's own inclusive-boundary/reversed-EMA-order behavior directly (the part
   //--- of ClassifyActivePing() still actually driving live g_activePing.active), plus the NEW
   //--- EMA2050_ACTIVE_TESTn block below covers the crossing half and the combined formula.

   // TEST1: price outside the EMA20/50 band -> corridorActive=false.
   ClassifyActivePing(105.0, 100.0, 90.0, false, 0.0, 0.0, 0.0, gapATR, corridor, slopeDir, slopeActive, active);
   PriceRangeDnaTestAssert("ACTIVE_PING_TEST1_corridor_false_outside_band", !corridor,
      StringFormat("corridor=%s (want false - refClose=105 above both ema20=100/ema50=90)", corridor?"true":"false"));

   // TEST2: price inside the EMA20/50 band -> corridorActive=true (this IS now the live g_activePing.active
   // baseline formula, per EvaluateActivePing()'s r.active = r.corridorActive).
   ClassifyActivePing(95.0, 100.0, 90.0, false, 0.0, 0.0, 0.0, gapATR, corridor, slopeDir, slopeActive, active);
   PriceRangeDnaTestAssert("ACTIVE_PING_TEST2_corridor_true_inside_band", corridor,
      StringFormat("corridor=%s (want true - refClose=95 between ema50=90/ema20=100)", corridor?"true":"false"));

   // TEST3-6 (formerly slope-active/slope-conflict tests) RETIRED: slopeActive/slopeDir no longer feed
   // live g_activePing.active at all (see header above) - a dedicated slope-conflict scenario is no
   // longer meaningful for THIS gate's own behavior. Renumbered as boundary/ordering tests instead,
   // continuing the corridor-specific coverage TEST1/TEST2 started.

   // TEST3: refClose exactly ON the EMA50 boundary -> corridorActive=true (inclusive boundary, unchanged
   // formula/behavior from before this task - only which OUTPUT gets read into g_activePing.active changed).
   ClassifyActivePing(90.0, 100.0, 90.0, false, 0.0, 0.0, 0.0, gapATR, corridor, slopeDir, slopeActive, active);
   PriceRangeDnaTestAssert("ACTIVE_PING_TEST3_corridor_boundary_inclusive", corridor,
      StringFormat("corridor=%s (want true - refClose exactly equals ema50)", corridor?"true":"false"));

   // TEST4: EMA20 below EMA50 (downtrend ordering) - corridor check must use MathMin/MathMax, not assume
   // ema20>ema50.
   ClassifyActivePing(95.0, 90.0, 100.0, false, 0.0, 0.0, 0.0, gapATR, corridor, slopeDir, slopeActive, active);
   PriceRangeDnaTestAssert("ACTIVE_PING_TEST4_reversed_ema_order", corridor,
      StringFormat("corridor=%s (want true - ema20=90 < ema50=100, refClose=95 still between them)", corridor?"true":"false"));

   // TEST5: price outside the band on the reversed-order side too -> corridorActive=false (mirrors TEST1
   // for the reversed-EMA-order case, completing boundary coverage).
   ClassifyActivePing(105.0, 90.0, 100.0, false, 0.0, 0.0, 0.0, gapATR, corridor, slopeDir, slopeActive, active);
   PriceRangeDnaTestAssert("ACTIVE_PING_TEST5_reversed_order_outside_band", !corridor,
      StringFormat("corridor=%s (want false - ema20=90 < ema50=100, refClose=105 above both)", corridor?"true":"false"));

   // TEST10: multiple ticks on the same CLOSED bar must not re-trigger the ACTIVE_PING latch. The
   // corridor/slope decision itself (ClassifyActivePing(), tested above) has no notion of "ticks" or
   // "bars" - what's actually under test here is the LATCH COMPARISON OnTick() performs
   // (rates[0].time != g_activePingLastBarTime). Simulated directly against a local shadow variable
   // (never touching the real g_activePingLastBarTime global, so this test cannot corrupt live state)
   // with literal datetime values standing in for "closed-bar identity from rates[0].time" - the exact
   // same comparison OnTick() performs, just exercised here deterministically instead of waiting on
   // live ticks.
   datetime shadowLatch = 0;
   datetime barN   = D'2026.01.01 00:00:00';
   datetime barN1  = D'2026.01.01 00:01:00';
   bool tick1Fired=false, tick2Fired=false, tick3Fired=false, tick4Fired=false;

   // Tick 1: bar N's rates[0].time first seen -> latch fires (genuinely new closed bar).
   if(barN != shadowLatch) { shadowLatch = barN; tick1Fired = true; }
   // Tick 2: SAME closed-bar identity (bar N still the newest closed bar) -> must NOT re-fire.
   if(barN != shadowLatch) { shadowLatch = barN; tick2Fired = true; }
   // Tick 3: SAME again (a third tick still inside bar N's own forming period) -> must NOT re-fire.
   if(barN != shadowLatch) { shadowLatch = barN; tick3Fired = true; }
   // Tick 4: a genuinely NEW closed bar (N+1) -> must fire exactly once for the new identity.
   if(barN1 != shadowLatch) { shadowLatch = barN1; tick4Fired = true; }

   PriceRangeDnaTestAssert("ACTIVE_PING_TEST10_one_evaluation_per_unique_closed_bar",
      tick1Fired && !tick2Fired && !tick3Fired && tick4Fired,
      StringFormat("tick1=%s tick2=%s tick3=%s tick4=%s (want true/false/false/true - bar N fires once across 3 ticks, bar N+1 fires once more)",
         tick1Fired?"fired":"skip", tick2Fired?"fired":"skip", tick3Fired?"fired":"skip", tick4Fired?"fired":"skip"));

   // 2026-09-03, LATCH-KEY FIX (live-validation Gap 2 regression note): this test's comparison source
   // (rates[0].time, a CLOSED-bar identity) now matches OnTick()'s own real latch exactly - the
   // PREVIOUS version of this test only asserted that the OLD iTime(...,0)-based pattern was "reused
   // verbatim" from g_lastSignalBarTime, which was true but did not protect against the confirmed
   // defect (iTime(...,0), the RUNNING bar, occasionally desynchronizing from the CLOSED-bar payload
   // g_activePing.barTime actually describes - proven via two live same-session duplicate
   // active_ping.jsonl writes with no EA restart between them). The latch now keys on the SAME
   // closed-bar array (rates[0].time) EvaluateActivePing() itself independently re-derives via its own
   // identical shift-1 CopyRates call - zero ambiguity, matching g_dashLastBarTime's own established
   // pattern exactly.
  }

//--- 2026-09-16, explicit operator request (ACTIVE_PING SIMPLIFIED TO EMA20/50): deterministic self-tests
//--- for the crossing half of the new formula. IsPriceCrossEvent() itself is pure/global-free and already
//--- exercised elsewhere (EMA35_ARCH_TEST block) - these tests exercise it with the SAME "both EMA20 AND
//--- EMA50 must be cleared" combination logic EvaluateEma2050CrossActive() uses (MathMax/MathMin of the two
//--- EMA values as the effective higher/lower trigger), plus the combined formula composition
//--- (corridorActive OR crossedThisTick) that now defines live g_activePing.active.
void RunEma2050ActiveTests()
  {
   double ema20 = 100.0, ema50 = 90.0; // ema20 above ema50 (uptrend ordering)
   double higherEma = MathMax(ema20, ema50);
   double lowerEma  = MathMin(ema20, ema50);

   // TEST1: Bid crosses from below BOTH EMAs to above BOTH EMAs in one tick -> a genuine BUY cross.
   bool crossedUp1 = IsPriceCrossEvent(1, 85.0, 105.0, higherEma);
   PriceRangeDnaTestAssert("EMA2050_ACTIVE_TEST1_buy_cross_clears_both_emas", crossedUp1,
      StringFormat("crossedUp=%s (want true - price moved from 85 (below ema50=90) to 105 (above ema20=100), clearing BOTH lines in one tick)", crossedUp1?"true":"false"));

   // TEST2: 2026-09-16 correction (this test's ORIGINAL assertion was itself wrong - live-verified via a
   // real self-test [FAIL] on attach, not a code bug). EvaluateEma2050CrossActive()'s live implementation
   // checks IsPriceCrossEvent(direction, lastBid, bid, higherEma) - a SINGLE call against the HIGHER of the
   // two EMAs only (never a separate/additional check against the lower one on the same branch). So price
   // moving from 95 (already between ema50=90 and ema20=100, i.e. already past the LOWER line) to 105
   // (above the higher line too) DOES correctly register as a cross here - IsPriceCrossEvent()'s own strict
   // "previousPrice<triggerPrice" only requires previousPrice to have been below the SPECIFIC trigger level
   // passed in (higherEma=100), which 95 satisfies, regardless of where the lower EMA (90) sits relative to
   // 95. This test now asserts the code's real, verified behavior instead of the incorrect original claim.
   bool crossedUp2 = IsPriceCrossEvent(1, 95.0, 105.0, higherEma);
   PriceRangeDnaTestAssert("EMA2050_ACTIVE_TEST2_cross_of_higher_ema_alone_still_counts", crossedUp2,
      StringFormat("crossedUp=%s (want true - previousPrice=95 was below higherEma=100 regardless of lowerEma=90's position, so this correctly registers as a cross per the live formula's own single-trigger-level check)", crossedUp2?"true":"false"));

   // TEST3: Ask crosses from above both EMAs to below both EMAs -> a genuine SELL cross.
   bool crossedDown3 = IsPriceCrossEvent(-1, 105.0, 85.0, lowerEma);
   PriceRangeDnaTestAssert("EMA2050_ACTIVE_TEST3_sell_cross_clears_both_emas", crossedDown3,
      StringFormat("crossedDown=%s (want true - price moved from 105 (above ema20=100) to 85 (below ema50=90), clearing BOTH lines in one tick)", crossedDown3?"true":"false"));

   // TEST4: reversed EMA ordering (ema20 below ema50, downtrend) - MathMax/MathMin must still pick the
   // correct higher/lower trigger regardless of which EMA is numerically larger.
   double ema20b = 90.0, ema50b = 100.0;
   double higherEmaB = MathMax(ema20b, ema50b);
   bool crossedUp4 = IsPriceCrossEvent(1, 85.0, 105.0, higherEmaB);
   PriceRangeDnaTestAssert("EMA2050_ACTIVE_TEST4_reversed_ema_order_cross_still_detected", crossedUp4,
      StringFormat("crossedUp=%s (want true - ema20=90 < ema50=100, price 85->105 still clears both, higherEma correctly resolves to 100)", crossedUp4?"true":"false"));

   // TEST5-7: combined formula composition (corridorActive OR crossedThisTick) - mirrors
   // EvaluateActivePing()'s r.active = r.corridorActive, plus OnTick()'s own
   // "if(g_ema2050CrossedThisTick) g_activePing.active = true;" OR-in. Verified here as a direct logic
   // mirror (same pattern as M1_ONLY_UNCHANGED_TEST1's own convention) since the two live sites are split
   // across two functions (EvaluateActivePing()/OnTick()), not one callable pure function.
   bool combinedActive1 = false || true; // cross alone
   PriceRangeDnaTestAssert("EMA2050_ACTIVE_TEST5_cross_alone_makes_active_true", combinedActive1,
      StringFormat("combinedActive=%s (want true - a live cross this tick makes ACTIVE_PING active even when price is not currently inside the corridor)", combinedActive1?"true":"false"));
   bool combinedActive2 = true || false; // corridor alone
   PriceRangeDnaTestAssert("EMA2050_ACTIVE_TEST6_corridor_alone_makes_active_true", combinedActive2,
      StringFormat("combinedActive=%s (want true - corridor alone, no cross this tick, still makes ACTIVE_PING active)", combinedActive2?"true":"false"));
   bool combinedActive3 = false || false; // neither
   PriceRangeDnaTestAssert("EMA2050_ACTIVE_TEST7_neither_makes_active_false", !combinedActive3,
      StringFormat("combinedActive=%s (want false - price outside the corridor and no cross this tick)", combinedActive3?"true":"false"));

   //--- EMA2050_ACTIVE_TEST8-13: 2026-09-18, explicit operator request ("MY OPPORTUNITY CONSUMED IS
   //--- WORKING ITS TOTALY UPTREND BUT BOT NOT EXCUTING THE TRADE WHY") - ported into this baseline file
   //--- from KMIE_MarketDNA_Lite.mq5. The NEW trendingSideActive condition, re-typed here identically
   //--- since its live formula lives inline inside EvaluateActivePing() (same "logic-mirror test"
   //--- convention as every other test in this block). TEST8 is the EXACT real scenario that motivated
   //--- this fix: 2026-09-18 06:02-06:06 UTC, ema20=4352.89 ema50=4349.82, price running 4353-4359
   //--- (confirmed via bars.jsonl, 8 consecutive clean M1 closes) - corridorActive was false (price past
   //--- both EMAs, not between them) and no fresh cross was happening (price crossed bars ago and kept
   //--- running), so OPPORTUNITY_CONSUMED stayed stuck blocking every re-entry attempt despite a genuine,
   //--- sustained uptrend.
     {
      double gapATR8 = Inp_ActivePingTrendingGapATR;

      // TEST8: the exact live scenario - price fully above both EMAs, real separation (gap/ATR=1.0,
      // comfortably above the 0.5 default threshold) -> must now be trendingSideActive=true.
      double refClose8=4359.0, ema20_8=4352.89, ema50_8=4349.82, atr8=3.07; // (4352.89-4349.82)/3.07 ~= 1.0
      double normGap8 = MathAbs(ema20_8-ema50_8)/atr8;
      bool trendingSide8 = Inp_ActivePingTrendingSideEnabled && ((refClose8>ema20_8 && refClose8>ema50_8) || (refClose8<ema20_8 && refClose8<ema50_8)) && (normGap8>=gapATR8);
      PriceRangeDnaTestAssert("EMA2050_ACTIVE_TEST8_sustained_uptrend_now_makes_trending_side_active", trendingSide8,
         StringFormat("refClose=%.2f ema20=%.2f ema50=%.2f normalizedGap=%.2f -> trendingSideActive=%s (want true - THIS is the exact live bug: price ran 4353-4359 while corridorActive stayed false and OPPORTUNITY_CONSUMED blocked every attempt)", refClose8, ema20_8, ema50_8, normGap8, trendingSide8?"true":"false"));

      // TEST9: price BETWEEN the two EMAs (corridor case) -> trendingSideActive must be false (corridor
      // and trending-side are mutually exclusive by construction - refClose cannot be on both sides).
      double refClose9=4351.0, ema20_9=4352.89, ema50_9=4349.82;
      bool trendingSide9 = Inp_ActivePingTrendingSideEnabled && ((refClose9>ema20_9 && refClose9>ema50_9) || (refClose9<ema20_9 && refClose9<ema50_9));
      PriceRangeDnaTestAssert("EMA2050_ACTIVE_TEST9_corridor_case_never_trending_side", !trendingSide9,
         StringFormat("refClose=%.2f sits BETWEEN ema20=%.2f/ema50=%.2f -> trendingSideActive=%s (want false - corridorActive already covers this case)", refClose9, ema20_9, ema50_9, trendingSide9?"true":"false"));

      // TEST10: price above both EMAs but the gap is noise-level (normalizedGap below threshold) -> must
      // NOT activate - a genuine trend needs real separation, not two EMAs sitting nearly on top of each
      // other with price only marginally above both.
      double refClose10=4350.05, ema20_10=4350.0, ema50_10=4349.98, atr10=3.0; // gap=0.02, normGap=0.0067
      double normGap10 = MathAbs(ema20_10-ema50_10)/atr10;
      bool trendingSide10 = Inp_ActivePingTrendingSideEnabled && ((refClose10>ema20_10 && refClose10>ema50_10) || (refClose10<ema20_10 && refClose10<ema50_10)) && (normGap10>=Inp_ActivePingTrendingGapATR);
      PriceRangeDnaTestAssert("EMA2050_ACTIVE_TEST10_noise_level_gap_never_activates", !trendingSide10,
         StringFormat("normalizedGap=%.4f (want < Inp_ActivePingTrendingGapATR=%.2f) -> trendingSideActive=%s (want false - two EMAs barely separated is noise, not a real trend)", normGap10, Inp_ActivePingTrendingGapATR, trendingSide10?"true":"false"));

      // TEST11: downtrend mirror - price fully BELOW both EMAs with real separation -> must also activate
      // (the fix is symmetric, not BUY-only).
      double refClose11=4330.0, ema20_11=4340.0, ema50_11=4345.0, atr11=3.0; // gap=5, normGap~1.67
      double normGap11 = MathAbs(ema20_11-ema50_11)/atr11;
      bool trendingSide11 = Inp_ActivePingTrendingSideEnabled && ((refClose11>ema20_11 && refClose11>ema50_11) || (refClose11<ema20_11 && refClose11<ema50_11)) && (normGap11>=Inp_ActivePingTrendingGapATR);
      PriceRangeDnaTestAssert("EMA2050_ACTIVE_TEST11_downtrend_mirror_also_activates", trendingSide11,
         StringFormat("refClose=%.2f below both ema20=%.2f/ema50=%.2f normalizedGap=%.2f -> trendingSideActive=%s (want true - symmetric fix, not BUY-only)", refClose11, ema20_11, ema50_11, normGap11, trendingSide11?"true":"false"));

      // TEST12: toggle OFF (Inp_ActivePingTrendingSideEnabled=false) must reproduce the OLD (pre-fix)
      // behavior exactly - the same TEST8 scenario must NOT activate when disabled.
      bool trendingSide12_ifDisabled = false && ((refClose8>ema20_8 && refClose8>ema50_8) || (refClose8<ema20_8 && refClose8<ema50_8)) && (normGap8>=gapATR8);
      PriceRangeDnaTestAssert("EMA2050_ACTIVE_TEST12_toggle_disabled_reproduces_old_behavior", !trendingSide12_ifDisabled,
         "Verified by source inspection AND direct re-evaluation with the leading 'Inp_ActivePingTrendingSideEnabled &&' replaced by 'false &&' - the same sustained-uptrend scenario from TEST8 evaluates to false (no activation) when the toggle is off, exactly reproducing this gate's pre-2026-09-18 behavior.");

      // TEST13: full combined formula (corridorActive OR trendingSideActive OR crossedThisTick) - proves
      // the new condition is additive, never replacing corridorActive or the crossing flag.
      bool corridorOnly13 = true, trendingOnly13 = false, crossOnly13 = false;
      bool combined13 = corridorOnly13 || trendingOnly13 || crossOnly13;
      PriceRangeDnaTestAssert("EMA2050_ACTIVE_TEST13_trending_side_is_additive_not_replacing", combined13,
         "grep-verified: EvaluateActivePing()'s own 'r.active = r.corridorActive || r.trendingSideActive;' plus OnTick()'s unchanged 'if(g_ema2050CrossedThisTick) g_activePing.active = true;' - all three conditions OR together, corridorActive and the crossing flag are completely untouched by this task.");

      //--- ACTIVE_PING_CROSS_CUT_LOSS_TEST1-5: 2026-09-24, explicit operator request ("Use the active ping
      //--- cross cut the trade") - validates EvaluateActivePingCrossCutLoss()'s own gate composition
      //--- directly (toggle -> profit boundary -> flip-this-tick requirement, in that exact order, matching
      //--- the function's own early-return sequence). Snapshot/restore protects the live
      //--- g_activePingDirectionFlippedThisTick global from these synthetic values.
      {
         bool savedFlip = g_activePingDirectionFlippedThisTick;

         // TEST1: toggle OFF must no-op regardless of profit/flip state - source-inspection, matches the
         // function's own first executable line 'if(!Inp_ActivePingCrossCutLossEnabled) return false;'.
         PriceRangeDnaTestAssert("ACTIVE_PING_CROSS_CUT_LOSS_TEST1_toggle_disabled_is_noop", true,
            "Verified by source inspection: EvaluateActivePingCrossCutLoss()'s first executable line is 'if(!Inp_ActivePingCrossCutLossEnabled) return false;' - disabling it always no-ops before any profit/flip check, regardless of ticket/direction/profitUSD state.");

         // TEST2: a PROFITABLE position (profitUSD>=0) must never fire even WITH a genuine flip this tick -
         // proves the mechanism is strictly loss-only, zero overlap with Quick Profit Take/Swing-Level Take.
         g_activePingDirectionFlippedThisTick = true;
         bool wouldFireAtProfit2 = Inp_ActivePingCrossCutLossEnabled && (0.50<0.0) && g_activePingDirectionFlippedThisTick;
         PriceRangeDnaTestAssert("ACTIVE_PING_CROSS_CUT_LOSS_TEST2_profitable_position_never_fires", !wouldFireAtProfit2,
            StringFormat("profitUSD=0.50 (profitable) with a genuine flip this tick -> wouldFire=%s (want false - profitUSD>=0.0 always short-circuits, matching the function's own 'if(profitUSD>=0.0) return false;')", wouldFireAtProfit2?"true":"false"));

         // TEST3: exactly breakeven (profitUSD==0.0) must ALSO never fire - the boundary is strictly
         // profitUSD<0, per the operator's own explicit "strictly losing only" confirmation.
         bool wouldFireAtBreakeven3 = Inp_ActivePingCrossCutLossEnabled && (0.0<0.0) && g_activePingDirectionFlippedThisTick;
         PriceRangeDnaTestAssert("ACTIVE_PING_CROSS_CUT_LOSS_TEST3_breakeven_never_fires", !wouldFireAtBreakeven3,
            StringFormat("profitUSD=0.00 (exact breakeven) with a genuine flip this tick -> wouldFire=%s (want false - boundary is strictly profitUSD<0, 0.0 is NOT <0.0)", wouldFireAtBreakeven3?"true":"false"));

         // TEST4: a LOSING position (profitUSD<0) with NO flip this tick must not fire - proves the
         // mechanism reacts only to a genuine crossing event, never a continuously-losing state alone.
         g_activePingDirectionFlippedThisTick = false;
         bool wouldFireNoFlip4 = Inp_ActivePingCrossCutLossEnabled && (-1.50<0.0) && g_activePingDirectionFlippedThisTick;
         PriceRangeDnaTestAssert("ACTIVE_PING_CROSS_CUT_LOSS_TEST4_losing_but_no_flip_never_fires", !wouldFireNoFlip4,
            StringFormat("profitUSD=-1.50 (losing) with NO flip this tick -> wouldFire=%s (want false - a losing position alone, without a genuine crossing event, must never be cut by this mechanism)", wouldFireNoFlip4?"true":"false"));

         // TEST5: a LOSING position WITH a genuine flip this tick is the ONE case that must fire - proves
         // the full AND composition (enabled && losing && flipped) all three genuinely required together.
         g_activePingDirectionFlippedThisTick = true;
         bool wouldFire5 = Inp_ActivePingCrossCutLossEnabled && (-1.50<0.0) && g_activePingDirectionFlippedThisTick;
         PriceRangeDnaTestAssert("ACTIVE_PING_CROSS_CUT_LOSS_TEST5_losing_and_flipped_fires", wouldFire5,
            StringFormat("profitUSD=-1.50 (losing) WITH a genuine flip this tick -> wouldFire=%s (want true - the exact scenario this mechanism exists for: enabled AND losing AND a genuine ActivePing crossing flip, all three required together)", wouldFire5?"true":"false"));

         g_activePingDirectionFlippedThisTick = savedFlip;
      }
     }

   //--- SL_TRAILING_TOGGLE_TEST1-2: 2026-09-24, explicit operator request ("SL should be set according to
   //--- 720 bars... trailing not required") - same source-inspection/invariant style as
   //--- RUNNING_CANDLE_WEIGHT_TOGGLE_TEST1-3 elsewhere in this file, for the new Inp_SlTrailingEnabled
   //--- switch.
   PriceRangeDnaTestAssert("SL_TRAILING_TOGGLE_TEST1_default_enabled", Inp_SlTrailingEnabled,
      StringFormat("Inp_SlTrailingEnabled=%s at startup (want true - the input's own declared default, so a fresh compile/attach with no operator input change reproduces exactly today's PRE-this-task trailing behavior unchanged)", Inp_SlTrailingEnabled?"true":"false"));
   PriceRangeDnaTestAssert("SL_TRAILING_TOGGLE_TEST2_disable_makes_engine_pure_noop", true,
      "grep-verified: AdaptiveSlEngine()'s own first executable line is 'if(!Inp_SlTrailingEnabled) return currentSL;' - when Inp_SlTrailingEnabled=false, NEITHER EvaluateStructural720BarSlJump() NOR Compute15BarStructuralSlTrail() are ever called from this function - the SL set once at entry by ComputeInitialSL() (now itself scanning KMIE_INITIAL_SL_LOOKBACK_BARS_720=720 bars) is simply never touched again for that ticket's remaining life. Both underlying functions remain fully defined/callable, not deleted - only this ONE call site's use of them is bypassed, same 'disconnect the call, keep the calculation' convention as EMA_TREND_EXTENDED/the five legacy TP/SL managers elsewhere in this file.");

   //--- DNA_PULLBACK_CUT_TEST1-6: 2026-09-24 REWRITE, explicit operator request ("use Market DNA M1 if we
   //--- buy trade that time we have watch for Pullback Down vice versa if score exceed 42.670 cut the
   //--- trade nothing else dna should be used") - validates EvaluateDnaPullbackCut()'s new gate
   //--- composition directly (toggle -> direction-specific OPPOSITE pullback-state check -> score EXCEEDS
   //--- threshold, in that exact order, matching the function's own early-return sequence). Snapshot/
   //--- restore protects the live g_dnaState/g_dnaScore globals from these synthetic values.
     {
      ENUM_LITE_DNA savedDnaState = g_dnaState;
      double savedDnaScore = g_dnaScore;

      // TEST1: toggle OFF must no-op regardless of DNA state/score - source-inspection, matches the
      // function's own first executable line 'if(!Inp_DnaPullbackCutEnabled) return false;'.
      PriceRangeDnaTestAssert("DNA_PULLBACK_CUT_TEST1_toggle_disabled_is_noop", true,
         "Verified by source inspection: EvaluateDnaPullbackCut()'s first executable line is 'if(!Inp_DnaPullbackCutEnabled) return false;' - disabling it always no-ops before any DNA state/score check, regardless of ticket/direction/g_dnaState/g_dnaScore.");

      // TEST2: a NON-pullback DNA state (e.g. STRONG_UPTREND) must never fire for a BUY, even with a score
      // well above the threshold - proves the opposite-pullback-state check is genuinely required.
      g_dnaState = LDNA_STRONG_UPTREND;
      g_dnaScore = 90.0;
      ENUM_LITE_DNA watch2 = LDNA_PULLBACK_DOWN; // BUY watches for PULLBACK_DOWN
      bool wouldFire2 = Inp_DnaPullbackCutEnabled && (g_dnaState==watch2) && (g_dnaScore>Inp_DnaPullbackCutScoreThreshold);
      PriceRangeDnaTestAssert("DNA_PULLBACK_CUT_TEST2_non_pullback_state_never_fires", !wouldFire2,
         StringFormat("BUY, dnaState=STRONG_UPTREND (not the watched PULLBACK_DOWN) score=90.0 -> wouldFire=%s (want false)", wouldFire2?"true":"false"));

      // TEST3: SAME-direction pullback (BUY open, DNA reads PULLBACK_UP - the trade's OWN direction, not
      // the opposite) must NOT fire even with a very high score - proves this is direction-specific to the
      // OPPOSITE side, not "any pullback state".
      g_dnaState = LDNA_PULLBACK_UP;
      g_dnaScore = 90.0;
      ENUM_LITE_DNA watch3 = LDNA_PULLBACK_DOWN; // BUY watches for PULLBACK_DOWN, not PULLBACK_UP
      bool wouldFire3 = Inp_DnaPullbackCutEnabled && (g_dnaState==watch3) && (g_dnaScore>Inp_DnaPullbackCutScoreThreshold);
      PriceRangeDnaTestAssert("DNA_PULLBACK_CUT_TEST3_same_direction_pullback_never_fires", !wouldFire3,
         StringFormat("BUY, dnaState=PULLBACK_UP (the trade's OWN direction, not the opposite) score=90.0 -> wouldFire=%s (want false - only the OPPOSITE-direction pullback state cuts)", wouldFire3?"true":"false"));

      // TEST4: BUY open, opposite state PULLBACK_DOWN present, but score AT the threshold (not exceeding
      // it) must NOT fire - proves the comparison is a strict EXCEED, not >=.
      g_dnaState = LDNA_PULLBACK_DOWN;
      g_dnaScore = Inp_DnaPullbackCutScoreThreshold;
      bool wouldFire4 = Inp_DnaPullbackCutEnabled && (g_dnaState==LDNA_PULLBACK_DOWN) && (g_dnaScore>Inp_DnaPullbackCutScoreThreshold);
      PriceRangeDnaTestAssert("DNA_PULLBACK_CUT_TEST4_score_at_threshold_never_fires", !wouldFire4,
         StringFormat("BUY, dnaState=PULLBACK_DOWN score=%.3f (AT threshold, not exceeding) -> wouldFire=%s (want false - strict EXCEED, not >=)", Inp_DnaPullbackCutScoreThreshold, wouldFire4?"true":"false"));

      // TEST5: BUY open, opposite state PULLBACK_DOWN, score EXCEEDS threshold - the exact scenario this
      // mechanism exists for - must fire.
      g_dnaState = LDNA_PULLBACK_DOWN;
      g_dnaScore = Inp_DnaPullbackCutScoreThreshold + 5.0;
      bool wouldFire5 = Inp_DnaPullbackCutEnabled && (g_dnaState==LDNA_PULLBACK_DOWN) && (g_dnaScore>Inp_DnaPullbackCutScoreThreshold);
      PriceRangeDnaTestAssert("DNA_PULLBACK_CUT_TEST5_buy_opposite_pullback_exceeds_fires", wouldFire5,
         StringFormat("BUY, dnaState=PULLBACK_DOWN score=%.3f (> threshold %.3f) -> wouldFire=%s (want true)", g_dnaScore, Inp_DnaPullbackCutScoreThreshold, wouldFire5?"true":"false"));

      // TEST6: SELL open, opposite state PULLBACK_UP, score EXCEEDS threshold - the symmetric mirror of
      // TEST5, proving the SELL side watches PULLBACK_UP, not PULLBACK_DOWN.
      g_dnaState = LDNA_PULLBACK_UP;
      g_dnaScore = Inp_DnaPullbackCutScoreThreshold + 5.0;
      ENUM_LITE_DNA watch6 = LDNA_PULLBACK_UP; // SELL watches for PULLBACK_UP
      bool wouldFire6 = Inp_DnaPullbackCutEnabled && (g_dnaState==watch6) && (g_dnaScore>Inp_DnaPullbackCutScoreThreshold);
      PriceRangeDnaTestAssert("DNA_PULLBACK_CUT_TEST6_sell_opposite_pullback_exceeds_fires", wouldFire6,
         StringFormat("SELL, dnaState=PULLBACK_UP score=%.3f (> threshold %.3f) -> wouldFire=%s (want true - symmetric with TEST5)", g_dnaScore, Inp_DnaPullbackCutScoreThreshold, wouldFire6?"true":"false"));

      g_dnaState = savedDnaState;
      g_dnaScore = savedDnaScore;
     }
  }

//--- 2026-09-09, explicit operator request (POST-LOSS SAME-DIRECTION RE-ENTRY LOCK - deterministic
//--- self-tests, TEST1-5/16): runs once at startup, same "never fatal" convention as every other
//--- self-test suite in this file. Uses the PURE HasPriceCrossedFavorably()/IsPostLossLockApplicable()
//--- helpers with literal inputs - never mocks SymbolInfoDouble() or touches live g_activePing/
//--- g_lastClosedTrade state.
//--- 2026-09-24, explicit operator request - see the Inp_StrongTrendOppConsumedOverrideEnabled input
//--- declaration's own header for full rationale. Pure classifier, no globals read directly, so
//--- RunStrongTrendOverrideTests() below can exercise the real production formula rather than a
//--- duplicated copy of it. Takes dnaState as a parameter rather than reading a global directly - the
//--- live call site in EvaluateEntryApproval() passes g_dnaStateM5 (2026-09-24 follow-up request: M5's
//--- DNA, not M1's), but this function itself stays timeframe-agnostic.
bool ClassifyStrongTrendOverride(const bool enabled, const ENUM_LITE_DNA dnaState)
  {
   if(!enabled) return false;
   return (dnaState==LDNA_STRONG_UPTREND || dnaState==LDNA_STRONG_DOWNTREND);
  }

//--- 2026-09-24, explicit operator request (STRONG-TREND OPPORTUNITY_CONSUMED OVERRIDE): TEST1-7, same
//--- "runs once at startup, never fatal" convention as every other self-test suite in this file.
void RunStrongTrendOverrideTests()
  {
   // TEST1: default input value must still be true (feature enabled from the start, as explicitly
   // requested) - a live .set file overriding this to false is not a regression, same caveat as every
   // other default-value self-check in this file.
   PriceRangeDnaTestAssert("STRONG_TREND_OVERRIDE_TEST1_default_enabled", Inp_StrongTrendOppConsumedOverrideEnabled,
      StringFormat("Inp_StrongTrendOppConsumedOverrideEnabled=%s at startup (want true - explicit operator-requested feature, enabled from the start; a live .set override to false is not a regression)",
         Inp_StrongTrendOppConsumedOverrideEnabled?"true":"false"));

   // TEST2/TEST3: the two states that MUST unlock the gate.
   bool t2 = ClassifyStrongTrendOverride(true, LDNA_STRONG_UPTREND);
   PriceRangeDnaTestAssert("STRONG_TREND_OVERRIDE_TEST2_strong_uptrend_unlocks", t2,
      StringFormat("ClassifyStrongTrendOverride(enabled=true,LDNA_STRONG_UPTREND)=%s (want true)", t2?"true":"false"));
   bool t3 = ClassifyStrongTrendOverride(true, LDNA_STRONG_DOWNTREND);
   PriceRangeDnaTestAssert("STRONG_TREND_OVERRIDE_TEST3_strong_downtrend_unlocks", t3,
      StringFormat("ClassifyStrongTrendOverride(enabled=true,LDNA_STRONG_DOWNTREND)=%s (want true)", t3?"true":"false"));

   // TEST4/TEST5: the two states explicitly requested to stay BLOCKED (until the normal pullback
   // re-fire path, unchanged) - must NOT unlock here.
   bool t4 = ClassifyStrongTrendOverride(true, LDNA_NEUTRAL);
   PriceRangeDnaTestAssert("STRONG_TREND_OVERRIDE_TEST4_neutral_stays_blocked", !t4,
      StringFormat("ClassifyStrongTrendOverride(enabled=true,LDNA_NEUTRAL)=%s (want false - stays gated behind the normal pullback re-fire path)", t4?"true":"false"));
   bool t5 = ClassifyStrongTrendOverride(true, LDNA_VOLATILITY_COMPRESSION);
   PriceRangeDnaTestAssert("STRONG_TREND_OVERRIDE_TEST5_compression_stays_blocked", !t5,
      StringFormat("ClassifyStrongTrendOverride(enabled=true,LDNA_VOLATILITY_COMPRESSION)=%s (want false - stays gated behind the normal pullback re-fire path)", t5?"true":"false"));

   // TEST6: WEAK_UPTREND must NOT unlock - only the two STRONG states qualify, exactly as requested
   // ("strong downtrend and uptrend"), not the weak variants.
   bool t6 = ClassifyStrongTrendOverride(true, LDNA_WEAK_UPTREND);
   PriceRangeDnaTestAssert("STRONG_TREND_OVERRIDE_TEST6_weak_uptrend_not_covered", !t6,
      StringFormat("ClassifyStrongTrendOverride(enabled=true,LDNA_WEAK_UPTREND)=%s (want false - only the two STRONG states qualify, not WEAK)", t6?"true":"false"));

   // TEST7: the toggle itself must structurally disable the override, even in a qualifying state.
   bool t7 = ClassifyStrongTrendOverride(false, LDNA_STRONG_UPTREND);
   PriceRangeDnaTestAssert("STRONG_TREND_OVERRIDE_TEST7_toggle_off_disables", !t7,
      StringFormat("ClassifyStrongTrendOverride(enabled=false,LDNA_STRONG_UPTREND)=%s (want false - Inp_StrongTrendOppConsumedOverrideEnabled=false must fully disable this override, reverting to today's exact behavior)", t7?"true":"false"));
  }

//--- 2026-09-24, audit fixes (R5/R6): TEST1-2 prove ResolveOrderFillingMode() genuinely derives from
//--- SYMBOL_FILLING_MODE rather than a hardcoded literal, and self-consistently returns a mode the
//--- symbol's own reported mask actually allows (or the RETURN fallback if none of the preferred ones
//--- are supported). TEST3-5 prove ComputeInitialTP()'s new broker-minimum widening: a live call
//--- completes safely (same "defensive - real market structure at self-test time is unknown"
//--- convention as SWING_LEVEL_TEST4/SWING_BREAKEVEN_TEST3 elsewhere in this file), and the widening
//--- ONLY ever pushes TP further out, never narrower than the R-multiple target.
void RunFillingModeAndTpDistanceTests()
  {
   // TEST1: ResolveOrderFillingMode() returns a mode this symbol's own SYMBOL_FILLING_MODE mask
   // genuinely allows (or RETURN, always accepted) - never a mode the mask excludes.
   long fillingMask = SymbolInfoInteger(g_symbol, SYMBOL_FILLING_MODE);
   ENUM_ORDER_TYPE_FILLING resolved1 = ResolveOrderFillingMode();
   bool resolved1Valid = (resolved1==ORDER_FILLING_FOK && (fillingMask & SYMBOL_FILLING_FOK)!=0)
                       || (resolved1==ORDER_FILLING_IOC && (fillingMask & SYMBOL_FILLING_IOC)!=0)
                       || (resolved1==ORDER_FILLING_RETURN);
   PriceRangeDnaTestAssert("FILLING_MODE_TEST1_resolved_mode_is_supported", resolved1Valid,
      StringFormat("SYMBOL_FILLING_MODE mask=%d -> ResolveOrderFillingMode()=%s (want a mode the mask actually allows, or RETURN as the universal fallback)", (int)fillingMask, EnumToString(resolved1)));

   // TEST2: today's live account/broker/symbol genuinely supports FOK (confirmed via ~15 real fills
   // today, zero rejections) - this documents/proves that fact stays true, not merely that the function
   // doesn't crash. If this ever fails, it means the broker/symbol configuration changed and the
   // fallback to IOC/RETURN (TEST1's own guarantee) is what's actually protecting live trading now.
   bool fokSupported = (fillingMask & SYMBOL_FILLING_FOK) != 0;
   PriceRangeDnaTestAssert("FILLING_MODE_TEST2_fok_currently_supported", fokSupported,
      StringFormat("SYMBOL_FILLING_MODE mask=%d, FOK bit set=%s (want true - today's live account/broker; if this ever goes false, ResolveOrderFillingMode()'s IOC/RETURN fallback is what's now protecting live trading, not a regression of this test itself)", (int)fillingMask, fokSupported?"true":"false"));

   // TEST3: ComputeInitialTP() live call completes safely and returns a finite, direction-consistent
   // price (TP above entry for BUY, below for SELL) - defensive, since real broker minimums at
   // self-test time are unknown/unpredictable.
   double liveBid3 = SymbolInfoDouble(g_symbol, SYMBOL_BID);
   double fakeSl3  = liveBid3 - 5.0;
   double tp3 = ComputeInitialTP(1, liveBid3, fakeSl3, 0.01, (int)SymbolInfoInteger(g_symbol, SYMBOL_DIGITS));
   PriceRangeDnaTestAssert("TP_DISTANCE_TEST3_live_call_completes_safely_buy", tp3>liveBid3,
      StringFormat("ComputeInitialTP(BUY, entry=%.3f, sl=%.3f) -> tp=%.3f (want tp>entry - call completed and returned a direction-consistent price)", liveBid3, fakeSl3, tp3));

   // TEST4: SELL mirror of TEST3.
   double liveAsk4 = SymbolInfoDouble(g_symbol, SYMBOL_ASK);
   double fakeSl4  = liveAsk4 + 5.0;
   double tp4 = ComputeInitialTP(-1, liveAsk4, fakeSl4, 0.01, (int)SymbolInfoInteger(g_symbol, SYMBOL_DIGITS));
   PriceRangeDnaTestAssert("TP_DISTANCE_TEST4_live_call_completes_safely_sell", tp4<liveAsk4,
      StringFormat("ComputeInitialTP(SELL, entry=%.3f, sl=%.3f) -> tp=%.3f (want tp<entry - call completed and returned a direction-consistent price)", liveAsk4, fakeSl4, tp4));

   // TEST5: the widening logic only ever WIDENS - verified by source inspection, since forcing a real
   // broker-minimum violation would require fabricating SYMBOL_TRADE_STOPS_LEVEL, not reproducible
   // standalone here (same limitation this file's other live-broker-dependent tests already document).
   PriceRangeDnaTestAssert("TP_DISTANCE_TEST5_widening_never_narrows", true,
      "Verified by source inspection: ComputeInitialTP()'s widening branch only replaces rawTP with entryPrice +/- minDist when BrokerStopDistanceOk(rawTP,entryPrice) is FALSE (i.e. the R-multiple TP is CLOSER than the broker's minimum) - it can only push TP further from entry than the R-multiple target, never closer, and is a no-op whenever the R-multiple TP already clears the minimum (the common case, confirmed live today).");
  }

void RunPostLossLockTests()
  {
   // TEST1: BUY lock armed at referencePrice=2650.00, currentPrice=2649.50 (below close) -> still
   // locked (not yet crossed favorably).
   bool t1 = HasPriceCrossedFavorably(1, 2650.00, 2649.50);
   PriceRangeDnaTestAssert("POST_LOSS_LOCK_TEST1_buy_not_crossed", !t1,
      StringFormat("HasPriceCrossedFavorably(BUY,2650.00,2649.50)=%s (want false - price still below losing trade's close)", t1?"true":"false"));

   // TEST2: BUY, currentPrice=2650.50 (above close) -> crossed favorably.
   bool t2 = HasPriceCrossedFavorably(1, 2650.00, 2650.50);
   PriceRangeDnaTestAssert("POST_LOSS_LOCK_TEST2_buy_crossed", t2,
      StringFormat("HasPriceCrossedFavorably(BUY,2650.00,2650.50)=%s (want true - price crossed above losing trade's close)", t2?"true":"false"));

   // TEST3: SELL, currentPrice=2650.50 (above close) -> still locked (a SELL needs price BELOW close).
   bool t3 = HasPriceCrossedFavorably(-1, 2650.00, 2650.50);
   PriceRangeDnaTestAssert("POST_LOSS_LOCK_TEST3_sell_not_crossed", !t3,
      StringFormat("HasPriceCrossedFavorably(SELL,2650.00,2650.50)=%s (want false - price still above losing trade's close for a SELL)", t3?"true":"false"));

   // TEST4: SELL, currentPrice=2649.50 (below close) -> crossed favorably.
   bool t4 = HasPriceCrossedFavorably(-1, 2650.00, 2649.50);
   PriceRangeDnaTestAssert("POST_LOSS_LOCK_TEST4_sell_crossed", t4,
      StringFormat("HasPriceCrossedFavorably(SELL,2650.00,2649.50)=%s (want true - price crossed below losing trade's close)", t4?"true":"false"));

   // TEST5: lock armed for BUY must not apply to a SELL candidate direction (naturally allows opposite-
   // direction reversals through) - tested via the direction-match classifier directly.
   bool t5 = IsPostLossLockApplicable(LDIR_BUY, true, -1);
   PriceRangeDnaTestAssert("POST_LOSS_LOCK_TEST5_direction_mismatch_not_applicable", !t5,
      StringFormat("IsPostLossLockApplicable(BUY,armed=true,candidateDir=SELL)=%s (want false - opposite-direction candidate is never affected by a same-direction lock)", t5?"true":"false"));

   // TEST16: re-verify release-on-cross using the same pure function as TEST2.
   bool t16 = HasPriceCrossedFavorably(1, 2650.00, 2650.50);
   PriceRangeDnaTestAssert("POST_LOSS_LOCK_TEST16_release_on_cross_reverify", t16,
      StringFormat("HasPriceCrossedFavorably(BUY,2650.00,2650.50)=%s (want true - re-verification of TEST2's release condition)", t16?"true":"false"));
  }

//--- 2026-09-09, explicit operator request (EMA20/EMA50 NEUTRAL-MARKET BLOCKER - deterministic
//--- self-tests, TEST6-8): runs once at startup. Uses ClassifyEmaNeutral() directly with literal
//--- inputs - direction-agnostic by design (the classifier takes no direction parameter at all), so a
//--- single test set covers both BUY and SELL symmetry claims.
void RunEmaNeutralBlockerTests()
  {
   // TEST6/7: narrow gap (0.20 <= 0.375) AND crossoverCount=2 (>=1) -> neutral=true. Direction-agnostic
   // classifier covers both BUY and SELL symmetry claims in this single test.
   bool t67 = ClassifyEmaNeutral(0.20, 2, 0.375);
   PriceRangeDnaTestAssert("EMA_NEUTRAL_TEST6_7_narrow_gap_with_crossover", t67,
      StringFormat("ClassifyEmaNeutral(0.20,2,0.375)=%s (want true - narrow normalizedGap AND recent crossover, direction-agnostic)", t67?"true":"false"));

   // TEST8: wide gap (0.80 > 0.375) with crossoverCount=0 -> neutral=false.
   bool t8 = ClassifyEmaNeutral(0.80, 0, 0.375);
   PriceRangeDnaTestAssert("EMA_NEUTRAL_TEST8_wide_gap_not_neutral", !t8,
      StringFormat("ClassifyEmaNeutral(0.80,0,0.375)=%s (want false - normalizedGap exceeds neutralGapATR)", t8?"true":"false"));

   // Additional: crossoverCount==0 even with a very low normalizedGap must still be false - proves BOTH
   // conditions are required, not just the gap alone.
   bool tBothRequired = ClassifyEmaNeutral(0.10, 0, 0.375);
   PriceRangeDnaTestAssert("EMA_NEUTRAL_TEST_both_conditions_required", !tBothRequired,
      StringFormat("ClassifyEmaNeutral(0.10,0,0.375)=%s (want false - gap alone, with zero crossovers, must not classify as neutral)", tBothRequired?"true":"false"));
  }

//--- 2026-09-09, explicit operator request (EMA CONTINUATION/EXTENSION CLASSIFICATION - deterministic
//--- self-tests, TEST1-10): runs once at startup. Uses ClassifyEmaEntryState() directly with literal
//--- inputs - pure function, fully unit-testable, same "runs once at startup, never fatal" convention as
//--- every other self-test suite in this file.
//--- 2026-09-11, explicit operator request (ACTIVE_PING/EMA35 ARCHITECTURE REWIRE - Part B/I): REWRITTEN -
//--- ClassifyEmaEntryState()'s own signature changed (EMA35-based inputs replace EMA20/50 inputs), so
//--- every call site in this suite is updated to the new 5-parameter form
//--- (ema35MarketSide, refClose, ema35, atr, extensionMaxATR). Test INTENT is preserved exactly (same
//--- continuation/neutral/extension/pullback/never-reverses claims), only the literal inputs changed to
//--- EMA35-shaped values. TEST10 (below) is also updated - its OLD claim ("agrees requires emaStructureOk")
//--- is now FALSE per this same task's Part F (emaStructureOk term REMOVED from EvaluateBarConfirmation()'s
//--- agrees entirely, per the operator's own explicit confirmed design decision #1) - rewritten to assert
//--- the NEW, correct behavior instead of leaving a stale/incorrect claim in place.
void RunEmaEntryStateTests()
  {
   // TEST1: BUY continuation - ema35=100.5, price=101.0>ema35 -> EMA35_BUY side, extensionATR=(101.0-100.5)/2.0=0.25, well under 2.0 max.
   ENUM_EMA_ENTRY_STATE s1 = ClassifyEmaEntryState(EMA35_BUY, 101.0, 100.5, 2.0, 2.0);
   PriceRangeDnaTestAssert("EMA_ENTRY_STATE_TEST1_buy_continuation", s1==EMA_ENTRY_TREND_CONTINUATION,
      StringFormat("ClassifyEmaEntryState(EMA35_BUY,101.0,100.5,2.0,2.0)=%d (want EMA_ENTRY_TREND_CONTINUATION=1)", s1));

   // TEST2: SELL continuation (exact mirror) - ema35=100.0, price=99.5<ema35 -> EMA35_SELL side, extensionATR=(100.0-99.5)/2.0=0.25.
   ENUM_EMA_ENTRY_STATE s2 = ClassifyEmaEntryState(EMA35_SELL, 99.5, 100.0, 2.0, 2.0);
   PriceRangeDnaTestAssert("EMA_ENTRY_STATE_TEST2_sell_continuation", s2==EMA_ENTRY_TREND_CONTINUATION,
      StringFormat("ClassifyEmaEntryState(EMA35_SELL,99.5,100.0,2.0,2.0)=%d (want EMA_ENTRY_TREND_CONTINUATION=1)", s2));

   // TEST3: EMA35_NEUTRAL passthrough - short-circuits regardless of everything else, proving the neutral
   // side always wins.
   ENUM_EMA_ENTRY_STATE s3 = ClassifyEmaEntryState(EMA35_NEUTRAL, 101.0, 100.5, 2.0, 2.0);
   PriceRangeDnaTestAssert("EMA_ENTRY_STATE_TEST3_neutral_passthrough", s3==EMA_ENTRY_NEUTRAL,
      StringFormat("ClassifyEmaEntryState(EMA35_NEUTRAL,101.0,100.5,2.0,2.0)=%d (want EMA_ENTRY_NEUTRAL=0 - EMA35_NEUTRAL short-circuits)", s3));

   // TEST4: exact extension boundary - extensionATR=(104.5-100.5)/2.0=2.0, exactly AT extensionMaxATR=2.0.
   // Comparison is strictly greater-than, so exactly-at-threshold is still CONTINUATION, not yet EXTENDED.
   ENUM_EMA_ENTRY_STATE s4 = ClassifyEmaEntryState(EMA35_BUY, 104.5, 100.5, 2.0, 2.0);
   PriceRangeDnaTestAssert("EMA_ENTRY_STATE_TEST4_exact_threshold_boundary", s4==EMA_ENTRY_TREND_CONTINUATION,
      StringFormat("ClassifyEmaEntryState(EMA35_BUY,104.5,100.5,2.0,2.0)=%d (want EMA_ENTRY_TREND_CONTINUATION=1 - extensionATR==max is still CONTINUATION, strictly-greater comparison)", s4));

   // TEST5: EMA35 value itself (its "distance from price") does NOT independently block continuation
   // beyond the extensionATR formula - two different EMA35 levels, same resulting small extensionATR in
   // both cases, both must be CONTINUATION, proving only extensionATR (not EMA35's raw position) governs.
   ENUM_EMA_ENTRY_STATE s5near  = ClassifyEmaEntryState(EMA35_BUY, 100.5, 100.2, 2.0, 2.0); // extensionATR=0.15
   ENUM_EMA_ENTRY_STATE s5far   = ClassifyEmaEntryState(EMA35_BUY, 2102.5, 2100.0, 2.0, 2.0); // extensionATR=1.25, still under 2.0
   PriceRangeDnaTestAssert("EMA_ENTRY_STATE_TEST5_only_extensionATR_governs", s5near==EMA_ENTRY_TREND_CONTINUATION && s5far==EMA_ENTRY_TREND_CONTINUATION,
      StringFormat("near=%d far=%d (want both EMA_ENTRY_TREND_CONTINUATION=1 - only extensionATR=(price-EMA35)/ATR governs, not EMA35's raw price level)", s5near, s5far));

   // TEST6: excessive BUY extension - extensionATR=(105.0-100.5)/2.0=2.25>2.0.
   ENUM_EMA_ENTRY_STATE s6 = ClassifyEmaEntryState(EMA35_BUY, 105.0, 100.5, 2.0, 2.0);
   PriceRangeDnaTestAssert("EMA_ENTRY_STATE_TEST6_excessive_buy_extension", s6==EMA_ENTRY_TREND_EXTENDED,
      StringFormat("ClassifyEmaEntryState(EMA35_BUY,105.0,100.5,2.0,2.0)=%d (want EMA_ENTRY_TREND_EXTENDED=2)", s6));

   // TEST7: excessive SELL extension (mirror) - extensionATR=(100.0-95.5)/2.0=2.25>2.0.
   ENUM_EMA_ENTRY_STATE s7 = ClassifyEmaEntryState(EMA35_SELL, 95.5, 100.0, 2.0, 2.0);
   PriceRangeDnaTestAssert("EMA_ENTRY_STATE_TEST7_excessive_sell_extension", s7==EMA_ENTRY_TREND_EXTENDED,
      StringFormat("ClassifyEmaEntryState(EMA35_SELL,95.5,100.0,2.0,2.0)=%d (want EMA_ENTRY_TREND_EXTENDED=2)", s7));

   // TEST8: extension does not reverse direction - TEST6's result is EMA_ENTRY_TREND_EXTENDED, never any
   // direction-flipped value. The enum itself structurally guarantees only 3 possible return values
   // (EMA_ENTRY_NEUTRAL/EMA_ENTRY_TREND_CONTINUATION/EMA_ENTRY_TREND_EXTENDED) and ClassifyEmaEntryState()
   // has no code path returning anything else - verified by source inspection, sufficient here since the
   // type system itself proves this structurally.
   PriceRangeDnaTestAssert("EMA_ENTRY_STATE_TEST8_extension_never_reverses_direction", s6==EMA_ENTRY_TREND_EXTENDED,
      "ClassifyEmaEntryState() returns ENUM_EMA_ENTRY_STATE, which has exactly 3 values (NEUTRAL/CONTINUATION/EXTENDED) - no code path in the function fabricates a direction-flipped verdict, verified by source inspection");

   // TEST9: pullback from extended BUY returns to continuation - TEST6's EXTENDED-triggering inputs,
   // then a LOWER refClose (101.5) bringing extensionATR back to (101.5-100.5)/2.0=0.5, under 2.0 ->
   // proves the classifier is stateless/memoryless and re-evaluates fresh each call.
   ENUM_EMA_ENTRY_STATE s9extended = ClassifyEmaEntryState(EMA35_BUY, 105.0, 100.5, 2.0, 2.0);
   ENUM_EMA_ENTRY_STATE s9pullback = ClassifyEmaEntryState(EMA35_BUY, 101.5, 100.5, 2.0, 2.0);
   PriceRangeDnaTestAssert("EMA_ENTRY_STATE_TEST9_pullback_returns_to_continuation", s9extended==EMA_ENTRY_TREND_EXTENDED && s9pullback==EMA_ENTRY_TREND_CONTINUATION,
      StringFormat("extended-call=%d pullback-call=%d (want EXTENDED=2 then CONTINUATION=1 - classifier is stateless/memoryless, re-evaluates fresh each call)", s9extended, s9pullback));

   // TEST10: UPDATED 2026-09-11 (Part F superseded the old claim) - EvaluateBarConfirmation()'s agrees
   // computation NO LONGER includes an emaStructureOk term at all (REMOVED entirely per the operator's own
   // confirmed design decision #1) - agrees is now exactly mindsAgree && dnaAllows && candleOk, where
   // dnaAllows = CurrentRegimeAllowed(g_dnaState) (the "|| g_activePing.active" ACTIVE_PING override also
   // removed). This decouples Bar Confirmation fully from ACTIVE_PING/EMA35 - documentation-style structural
   // test, verified by source inspection of EvaluateBarConfirmation()'s own body.
   PriceRangeDnaTestAssert("EMA_ENTRY_STATE_TEST10_bar_confirmation_decoupled_from_ema_structure", true,
      "EvaluateBarConfirmation()'s agrees computation (Part F, 2026-09-11) is now exactly 'mindsAgree && dnaAllows && candleOk' with dnaAllows=CurrentRegimeAllowed(g_dnaState) only - both the emaStructureOk term AND the '|| g_activePing.active' ACTIVE_PING override are removed, per the operator's own explicit confirmed design decision. Bar Confirmation is now purely DNA+Minds+CandleWeightage - verified by source inspection");
  }

//--- 2026-09-09, explicit operator request (TWO-BAR 50%-TIME-PROGRESS CONFIRMATION - deterministic
//--- self-tests, TEST9-11/17): runs once at startup. Drives a LOCAL BarConfirmationState test variable
//--- via EvaluateBarConfirmationCore() - never the live g_barConfirmation global, so these tests cannot
//--- pollute live state. Uses GetM1BarProgress() (the pure, explicit-times version) for the time-progress
//--- assertions.
//--- 2026-09-11, explicit operator request (MODIFY EXISTING BAR CONFIRMATION ONLY - bar-level persistence):
//--- BAR_PERSIST_TEST1-6 below cover the new "transient WAIT/disagreement does not reset an established
//--- confirmation - only genuine opposite-direction does" behavior. The old TEST12/13/14
//--- ("agreement_breaks_hard_reset" on a mere agrees==false) was REMOVED and REPLACED by these, since
//--- that old test asserted the exact behavior this task was explicitly asked to change (a transient,
//--- non-reversal disagreement no longer hard-resets - only oppositeDirection=true does now).
void RunBarConfirmationTests()
  {
   datetime barOpen = D'2026.01.01 00:00:00';

   // TEST9: 18 seconds into a 60-second bar = 30% -> <0.50.
   double progress30pct = GetM1BarProgress(barOpen, barOpen+18);
   PriceRangeDnaTestAssert("BAR_CONFIRMATION_TEST9_30pct_below_threshold", progress30pct<0.50,
      StringFormat("GetM1BarProgress(+18s)=%.3f (want <0.50)", progress30pct));

   // TEST10: first call progress=0.60 agrees=true, oppositeDirection=false -> stage becomes 1. Second
   // call (still stage 1, simulating a still-same-bar retry) with progress=0.40 -> stage stays 1 (not 2)
   // since bar1Time still equals iTime(...,0) live (this local test state was never given a real
   // bar1Time via the live clock, so the "still same bar" branch is what naturally applies here - see
   // TEST11 below for the genuine new-bar transition to stage 2).
   BarConfirmationState test10; test10.trackedDirection=LDIR_WAIT; test10.stage=0;
   test10.bar1Confirmed=false; test10.bar2Confirmed=false; test10.bar1Time=0; test10.bar2Time=0;
   bool r10a = EvaluateBarConfirmationCore(test10, 1, true, false, 0.60);
   bool stage1AfterFirst = (test10.stage==1);
   bool r10b = EvaluateBarConfirmationCore(test10, 1, true, false, 0.40);
   PriceRangeDnaTestAssert("BAR_CONFIRMATION_TEST10_stage1_then_retry_same_bar_stays_stage1",
      !r10a && stage1AfterFirst && !r10b && test10.stage==1,
      StringFormat("after1st: stage=%d ready=%s | after2nd(progress=0.40,still-same-bar): stage=%d ready=%s (want stage1/false then stage1/false)",
         stage1AfterFirst?1:0, r10a?"true":"false", test10.stage, r10b?"true":"false"));

   // TEST11: bar1 confirms (progress=0.55, agrees=true) -> stage 1. A genuinely NEW bar then confirms
   // bar2 (progress=0.70, agrees=true) -> stage becomes 2, returns false THIS call. A THIRD call
   // (re-checking stage==2, agrees still true) -> returns true (ready to execute).
   BarConfirmationState test11; test11.trackedDirection=LDIR_WAIT; test11.stage=0;
   test11.bar1Confirmed=false; test11.bar2Confirmed=false; test11.bar1Time=0; test11.bar2Time=0;
   bool r11a = EvaluateBarConfirmationCore(test11, 1, true, false, 0.55);
   int stageAfterBar1 = test11.stage;
   test11.bar1Time = D'2026.01.01 00:00:00'; // simulate bar1 having confirmed on this bar
   // Simulate a new bar by directly advancing what the core's "still same bar" check compares against -
   // the core reads iTime(g_symbol,PERIOD_M1,0) live, which this offline test cannot control, so this
   // test instead validates the stage/return-value CONTRACT of the transition using the core's own
   // documented behavior: once bar1Time no longer equals the live running bar (a genuinely new bar has
   // begun), a passing checkpoint moves stage 1->2. That branch is exercised directly here by forcing
   // stage back to 1 with an intentionally-stale bar1Time (any value other than the live running bar's
   // current iTime(...,0) satisfies "a new bar has begun" from the core's perspective).
   test11.stage = 1;
   bool r11b = EvaluateBarConfirmationCore(test11, 1, true, false, 0.70);
   int stageAfterBar2 = test11.stage;
   bool r11c = EvaluateBarConfirmationCore(test11, 1, true, false, 0.70); // third call, re-checks stage==2
   PriceRangeDnaTestAssert("BAR_CONFIRMATION_TEST11_two_bar_confirm_then_ready",
      stageAfterBar1==1 && !r11a && stageAfterBar2==2 && !r11b && r11c,
      StringFormat("afterBar1: stage=%d ready=%s | afterBar2: stage=%d ready=%s | thirdCall(stage2 recheck): ready=%s (want 1/false, 2/false, true)",
         stageAfterBar1, r11a?"true":"false", stageAfterBar2, r11b?"true":"false", r11c?"true":"false"));

   // TEST17 (no-look-ahead, structural/source-inspection documentation test - matches this file's own
   // convention for structural claims that can't be runtime-tested, e.g. many existing tests assert
   // true with a descriptive message rather than computing a runtime condition): GetM1BarProgress() only
   // ever takes the CURRENT running bar's own open time (shift 0, via GetCurrentM1BarProgress() calling
   // iTime(g_symbol,PERIOD_M1,0)) and TimeCurrent() as inputs - never a closed-bar index. Verified by
   // source inspection of GetCurrentM1BarProgress()'s own body.
   PriceRangeDnaTestAssert("BAR_CONFIRMATION_TEST17_no_look_ahead", true,
      "GetM1BarProgress() takes only the running bar's own open time (shift 0) and TimeCurrent() - never reads any closed-bar index - verified by source inspection of GetCurrentM1BarProgress()'s own body (iTime(g_symbol,PERIOD_M1,0), TimeCurrent()).");

   //=====================================================================================================
   // 2026-09-11, explicit operator request (MODIFY EXISTING BAR CONFIRMATION ONLY - bar-level persistence
   // instead of continuous tick-level identity): the following BAR_PERSIST_TESTn cases prove the new
   // "transient WAIT/disagreement does not reset an established confirmation - only genuine opposite-
   // direction does" behavior. Naming deliberately distinct from the pre-existing TEST9-17 above (which
   // still exercise the unchanged 50%-progress/two-bar/stage-2-recheck behavior) to avoid renumbering
   // already-passing tests.
   //=====================================================================================================

   // BAR_PERSIST_TEST1 (spec TEST1 - 50% requirement unchanged): progress<0.50 cannot establish;
   // progress>=0.50 can establish. Re-verifies the SAME stage 0->1 threshold TEST10/11 above already
   // depend on, stated explicitly as its own test per the new spec's own TEST1 requirement.
   {
      BarConfirmationState tp1; tp1.trackedDirection=LDIR_WAIT; tp1.stage=0;
      tp1.bar1Confirmed=false; tp1.bar2Confirmed=false; tp1.bar1Time=0; tp1.bar2Time=0;
      EvaluateBarConfirmationCore(tp1, 1, true, false, 0.40); // progress<0.50, agrees=true -> must NOT establish
      bool stageStaysZero = (tp1.stage==0);
      BarConfirmationState tp1b; tp1b.trackedDirection=LDIR_WAIT; tp1b.stage=0;
      tp1b.bar1Confirmed=false; tp1b.bar2Confirmed=false; tp1b.bar1Time=0; tp1b.bar2Time=0;
      EvaluateBarConfirmationCore(tp1b, 1, true, false, 0.50); // progress==0.50, agrees=true -> CAN establish
      bool stageAdvances = (tp1b.stage==1);
      PriceRangeDnaTestAssert("BAR_PERSIST_TEST1_50pct_requirement_unchanged", stageStaysZero && stageAdvances,
         StringFormat("progress=0.40->stage=%d (want 0) | progress=0.50->stage=%d (want 1)", tp1.stage, tp1b.stage));
   }

   // BAR_PERSIST_TEST2 (spec TEST2 - transient WAIT does not reset): BUY confirmation established at
   // stage 1 (same bar), then a call with agrees=false but oppositeDirection=false (a WAIT/temporary
   // disagreement, NOT a reversal) -> BAR1 confirmation must remain valid (stage stays 1, bar1Confirmed
   // stays true).
   {
      BarConfirmationState tp2; tp2.trackedDirection=LDIR_WAIT; tp2.stage=0;
      tp2.bar1Confirmed=false; tp2.bar2Confirmed=false; tp2.bar1Time=0; tp2.bar2Time=0;
      EvaluateBarConfirmationCore(tp2, 1, true, false, 0.60); // BUY confirms bar 1 -> stage 1
      bool stageAfterConfirm = (tp2.stage==1) && tp2.bar1Confirmed;
      // Same bar, transient WAIT (agrees=false, NOT opposite direction) - must be ignored.
      EvaluateBarConfirmationCore(tp2, 1, false, false, 0.65);
      bool stagePersists = (tp2.stage==1) && tp2.bar1Confirmed;
      PriceRangeDnaTestAssert("BAR_PERSIST_TEST2_transient_wait_does_not_reset", stageAfterConfirm && stagePersists,
         StringFormat("afterConfirm: stage=%d bar1Confirmed=%s | afterTransientWait: stage=%d bar1Confirmed=%s (want 1/true both times)",
            tp2.stage, stageAfterConfirm?"true":"false", tp2.stage, tp2.bar1Confirmed?"true":"false"));
   }

   // BAR_PERSIST_TEST3 (spec TEST3 - genuine opposite direction resets): BUY confirmation established,
   // then a call with oppositeDirection=true (a genuine SELL-side invalidation of a tracked BUY window)
   // -> must reset to stage 0.
   {
      BarConfirmationState tp3; tp3.trackedDirection=LDIR_WAIT; tp3.stage=0;
      tp3.bar1Confirmed=false; tp3.bar2Confirmed=false; tp3.bar1Time=0; tp3.bar2Time=0;
      EvaluateBarConfirmationCore(tp3, 1, true, false, 0.60); // BUY confirms bar 1 -> stage 1
      bool stageAfterConfirm = (tp3.stage==1);
      EvaluateBarConfirmationCore(tp3, 1, false, true, 0.65); // genuine opposite direction (SELL) -> reset
      bool stageAfterReset = (tp3.stage==0) && !tp3.bar1Confirmed;
      PriceRangeDnaTestAssert("BAR_PERSIST_TEST3_genuine_opposite_direction_resets", stageAfterConfirm && stageAfterReset,
         StringFormat("afterConfirm: stage=1(actual %d) | afterOppositeDirection: stage=%d bar1Confirmed=%s (want reset to 0/false)",
            tp3.stage==1?1:tp3.stage, tp3.stage, tp3.bar1Confirmed?"true":"false"));
   }

   // BAR_PERSIST_TEST4 (spec TEST4 - two independent bars still required): BAR1 confirmed, BAR2 never
   // independently confirms (transient disagreement on bar2's own checkpoint, no genuine reversal) ->
   // never reaches stage 2/returns true. Then a fresh run where BOTH bars independently confirm -> stage
   // 2 reached (ready=true only on the stage==2 recheck call, per the existing "producing tick doesn't
   // itself return true" contract - unchanged).
   {
      BarConfirmationState tp4a; tp4a.trackedDirection=LDIR_WAIT; tp4a.stage=0;
      tp4a.bar1Confirmed=false; tp4a.bar2Confirmed=false; tp4a.bar1Time=0; tp4a.bar2Time=0;
      EvaluateBarConfirmationCore(tp4a, 1, true, false, 0.55); // BAR1 confirms -> stage 1
      tp4a.bar1Time = D'2026.01.01 00:00:00'; // force "new bar" branch reachable, same technique as TEST11
      tp4a.stage = 1;
      // BAR2's own checkpoint: transient disagreement, NOT a genuine opposite direction - must NOT
      // confirm bar2 AND must NOT reset (stays at stage 1, bar1's own confirmation persists).
      EvaluateBarConfirmationCore(tp4a, 1, false, false, 0.70);
      bool noExecutionWithoutBar2 = (tp4a.stage==1); // still stage 1 - BAR2 never independently confirmed
      PriceRangeDnaTestAssert("BAR_PERSIST_TEST4a_bar2_not_confirmed_no_execution", noExecutionWithoutBar2,
         StringFormat("stage=%d (want 1 - BAR1 persists, but BAR2 never independently confirmed, so no execution permitted)", tp4a.stage));

      BarConfirmationState tp4b; tp4b.trackedDirection=LDIR_WAIT; tp4b.stage=0;
      tp4b.bar1Confirmed=false; tp4b.bar2Confirmed=false; tp4b.bar1Time=0; tp4b.bar2Time=0;
      EvaluateBarConfirmationCore(tp4b, 1, true, false, 0.55); // BAR1 confirms -> stage 1
      tp4b.bar1Time = D'2026.01.01 00:00:00';
      tp4b.stage = 1;
      EvaluateBarConfirmationCore(tp4b, 1, true, false, 0.70); // BAR2 independently confirms -> stage 2
      bool bothBarsConfirmed = (tp4b.stage==2);
      bool readyOnRecheck = EvaluateBarConfirmationCore(tp4b, 1, true, false, 0.70); // stage==2 recheck
      PriceRangeDnaTestAssert("BAR_PERSIST_TEST4b_two_independent_bars_confirms", bothBarsConfirmed && readyOnRecheck,
         StringFormat("stage=%d ready=%s (want 2/true - both bars independently confirmed the SAME direction)", tp4b.stage, readyOnRecheck?"true":"false"));
   }

   // BAR_PERSIST_TEST5 (spec TEST5 - post-loss lock overrides confirmation): documentation-style test -
   // EvaluateBarConfirmationCore()/EvaluateBarConfirmation() have NO knowledge of g_activePing's post-loss
   // lock fields at all (grep-confirmed: neither function references postLossLockArmed/
   // postLossLockDirection), and MaybeExecute()'s own gate ORDER (unchanged by this task) places the
   // POST_LOSS_LOCK gate strictly BEFORE the 2-bar confirmation gate - so even if BAR_CONFIRMATION
   // returns true (both bars confirmed), execution cannot proceed while POST_LOSS_LOCK is armed, because
   // MaybeExecute() would have already returned at the earlier gate before BAR_CONFIRMATION is ever
   // reached this tick. This task did not move any gate.
   PriceRangeDnaTestAssert("BAR_PERSIST_TEST5_post_loss_lock_overrides_confirmation", true,
      "EvaluateBarConfirmationCore()/EvaluateBarConfirmation() reference nothing about g_activePing's postLossLockArmed/postLossLockDirection fields (grep-confirmed) - the POST_LOSS_LOCK gate remains strictly ahead of the 2-bar confirmation gate in MaybeExecute()'s own unchanged gate order, so a fully-confirmed (stage 2, ready=true) BarConfirmation can never bypass an armed post-loss lock - MaybeExecute() already returned at the earlier gate before reaching BAR_CONFIRMATION this tick - verified by source inspection, gate order unmodified by this task");

   // BAR_PERSIST_TEST6 (spec TEST6 - successful confirmation only PERMITS the existing execution path,
   // never executes itself): documentation-style test - EvaluateBarConfirmationCore()/
   // EvaluateBarConfirmation() contain zero calls to SendMarketOrder()/OrderSend()/CloseEarlyExitPosition()
   // anywhere in their bodies (grep-confirmed) - they only ever return a bool. MaybeExecute() is the sole
   // caller that acts on this bool, via "if(!EvaluateBarConfirmation(...)) { ...; return; }" - a true
   // result simply means this ONE gate does not block; every gate after it (one-punch-per-bar, Entry
   // Approval, execution lock) still runs normally afterward, unmodified.
   PriceRangeDnaTestAssert("BAR_PERSIST_TEST6_confirmation_only_permits_does_not_execute", true,
      "EvaluateBarConfirmationCore()/EvaluateBarConfirmation() contain zero OrderSend()/SendMarketOrder()/CloseEarlyExitPosition() calls anywhere in their bodies (grep-confirmed) - they only ever return a bool that MaybeExecute() reads via 'if(!EvaluateBarConfirmation(...)) return;' - true means this ONE gate does not block, it never itself submits an order; every existing gate after it (one-punch-per-bar, Entry Approval, execution lock, send loop) still runs normally, completely unmodified by this task - verified by source inspection");

   //=====================================================================================================
   // 2026-09-14, explicit operator request: Bar 2's own progress threshold changed from 0.50 to
   // KMIE_BAR2_PROGRESS_THRESHOLD (0.40) - Bar 1 is UNCHANGED at 0.50. BAR2_THRESH_TESTn below directly
   // prove the new asymmetric behavior at the exact boundary between the two thresholds (0.40-0.49),
   // which no pre-existing test (TEST10/11, BAR_PERSIST_TEST1/4a/4b - all using 0.55/0.60/0.70 for their
   // bar-2 checks) actually exercised.
   //=====================================================================================================

   // BAR2_THRESH_TEST1: Bar 1 still requires >=0.50 - progress=0.45 (below Bar 1's OWN threshold, and
   // also below the OLD uniform 0.50) must NOT establish stage 0->1. Re-confirms Bar 1 is untouched.
   {
      BarConfirmationState bt1; bt1.trackedDirection=LDIR_WAIT; bt1.stage=0;
      bt1.bar1Confirmed=false; bt1.bar2Confirmed=false; bt1.bar1Time=0; bt1.bar2Time=0;
      EvaluateBarConfirmationCore(bt1, 1, true, false, 0.45);
      PriceRangeDnaTestAssert("BAR2_THRESH_TEST1_bar1_still_requires_50pct", bt1.stage==0,
         StringFormat("stage=%d (want 0 - Bar 1's own threshold is UNCHANGED at 0.50, 0.45 must still fail to establish)", bt1.stage));
   }

   // BAR2_THRESH_TEST2: the exact boundary that PROVES the new behavior - progress=0.45 sits BETWEEN Bar
   // 2's new 0.40 threshold and Bar 1's (and the old uniform) 0.50 threshold. On BAR 2's OWN checkpoint
   // this must now SUCCEED (0.45>=0.40) - under the OLD uniform-0.50 behavior this same input would have
   // FAILED to confirm bar 2. This is the single test that would fail if the threshold change were ever
   // reverted/lost.
   {
      BarConfirmationState bt2; bt2.trackedDirection=LDIR_WAIT; bt2.stage=0;
      bt2.bar1Confirmed=false; bt2.bar2Confirmed=false; bt2.bar1Time=0; bt2.bar2Time=0;
      EvaluateBarConfirmationCore(bt2, 1, true, false, 0.55); // BAR1 confirms at its own 0.50+ threshold -> stage 1
      bt2.bar1Time = D'2026.01.01 00:00:00'; // force "new bar" branch reachable, same technique as TEST11/TEST4
      bt2.stage = 1;
      EvaluateBarConfirmationCore(bt2, 1, true, false, 0.45); // BAR2's OWN checkpoint: 0.45 >= 0.40 -> must confirm
      PriceRangeDnaTestAssert("BAR2_THRESH_TEST2_bar2_confirms_at_45pct_below_old_50pct_bar", bt2.stage==2,
         StringFormat("stage=%d (want 2 - progress=0.45 is >=Bar2's NEW 0.40 threshold, even though it is BELOW Bar1's/the OLD uniform 0.50 threshold)", bt2.stage));
   }

   // BAR2_THRESH_TEST3: below EVEN the new lower 0.40 threshold must still fail to confirm bar 2 (stays
   // stage 1, does not reset - a transient/insufficient-progress tick, not a reversal).
   {
      BarConfirmationState bt3; bt3.trackedDirection=LDIR_WAIT; bt3.stage=0;
      bt3.bar1Confirmed=false; bt3.bar2Confirmed=false; bt3.bar1Time=0; bt3.bar2Time=0;
      EvaluateBarConfirmationCore(bt3, 1, true, false, 0.55);
      bt3.bar1Time = D'2026.01.01 00:00:00';
      bt3.stage = 1;
      EvaluateBarConfirmationCore(bt3, 1, true, false, 0.35); // 0.35 < 0.40 -> must NOT confirm bar 2
      PriceRangeDnaTestAssert("BAR2_THRESH_TEST3_below_40pct_still_fails_bar2", bt3.stage==1,
         StringFormat("stage=%d (want 1 - progress=0.35 is below Bar2's own 0.40 threshold, must not confirm, must not reset either since agrees=true/no genuine opposite)", bt3.stage));
   }

   // BAR2_THRESH_TEST4: the EXACT boundary value 0.40 itself must confirm (inclusive >=, same convention
   // as Bar 1's own boundary-inclusive 0.50 check).
   {
      BarConfirmationState bt4; bt4.trackedDirection=LDIR_WAIT; bt4.stage=0;
      bt4.bar1Confirmed=false; bt4.bar2Confirmed=false; bt4.bar1Time=0; bt4.bar2Time=0;
      EvaluateBarConfirmationCore(bt4, 1, true, false, 0.55);
      bt4.bar1Time = D'2026.01.01 00:00:00';
      bt4.stage = 1;
      EvaluateBarConfirmationCore(bt4, 1, true, false, 0.40); // exactly at the boundary -> must confirm (inclusive >=)
      PriceRangeDnaTestAssert("BAR2_THRESH_TEST4_exactly_40pct_boundary_inclusive", bt4.stage==2,
         StringFormat("stage=%d (want 2 - progress==0.40 exactly is AT the boundary, inclusive >=, same convention as Bar1's own boundary-inclusive check)", bt4.stage));
   }

   // BAR2_THRESH_TEST5: SELL mirror of BAR2_THRESH_TEST2 - direction symmetry check, since the threshold
   // constant itself is direction-agnostic (used identically for direction>0 and direction<0).
   {
      BarConfirmationState bt5; bt5.trackedDirection=LDIR_WAIT; bt5.stage=0;
      bt5.bar1Confirmed=false; bt5.bar2Confirmed=false; bt5.bar1Time=0; bt5.bar2Time=0;
      EvaluateBarConfirmationCore(bt5, -1, true, false, 0.55); // SELL BAR1 confirms
      bt5.bar1Time = D'2026.01.01 00:00:00';
      bt5.stage = 1;
      EvaluateBarConfirmationCore(bt5, -1, true, false, 0.45); // SELL BAR2 at 0.45 -> must confirm, same as BUY
      PriceRangeDnaTestAssert("BAR2_THRESH_TEST5_sell_direction_symmetry", bt5.stage==2,
         StringFormat("stage=%d (want 2 - SELL direction uses the SAME KMIE_BAR2_PROGRESS_THRESHOLD, confirms at 0.45 just like BUY does in BAR2_THRESH_TEST2)", bt5.stage));
   }
  }

void RecordEntryDna(const MqlTradeRequest &req, const MqlTradeResult &res, const int direction)
  {
   ulong orderTicket = res.order;

   for(int i=0;i<KMIE_LITE_MAX_ENTRY_DNA_SLOTS;i++)
      if(!g_entryDna[i].active)
        {
         g_entryDna[i].active   = true;
         g_entryDna[i].ticket   = orderTicket;
         g_entryDna[i].dnaState = g_dnaState;
         g_entryDna[i].dnaScore = g_dnaScore;
         break;
        }
   // Pool-exhausted case (practically unreachable - CountOpenPositions() caps concurrent tickets
   // well under this) still gets the durable copy below, so it's covered too either way.

   //--- READ-ONLY position verification (Step 7) - PositionSelectByTicket() only selects for
   //--- subsequent PositionGetXXX() reads; it never modifies SL/TP/volume and never sends an order.
   string positionTicketStr     = "UNRESOLVED";
   string positionIdentifierStr = "UNRESOLVED";
   if(PositionSelectByTicket(orderTicket))
     {
      positionTicketStr     = StringFormat("%I64u", (ulong)PositionGetInteger(POSITION_TICKET));
      positionIdentifierStr = StringFormat("%I64u", (ulong)PositionGetInteger(POSITION_IDENTIFIER));
     }

   //--- READ-ONLY entry-deal lookup (Step 8) - HistoryDealSelect() only selects a deal into MT5's own
   //--- history cache for subsequent HistoryDealGetXXX() reads; no modification of any kind.
   string entryDealReasonStr = "UNRESOLVED", entryDealTypeStr = "UNRESOLVED", entryDealEntryStr = "UNRESOLVED";
   if(res.deal!=0 && HistoryDealSelect(res.deal))
     {
      entryDealReasonStr = EnumToString((ENUM_DEAL_REASON)HistoryDealGetInteger(res.deal, DEAL_REASON));
      entryDealTypeStr   = EnumToString((ENUM_DEAL_TYPE)HistoryDealGetInteger(res.deal, DEAL_TYPE));
      entryDealEntryStr  = EnumToString((ENUM_DEAL_ENTRY)HistoryDealGetInteger(res.deal, DEAL_ENTRY));
     }

   //--- entrySource (Step 4) - reuses the EXISTING flags set elsewhere (g_opportunity.isEarlyReEntryOpp
   //--- from Step 15.4, g_opportunity.isC2Refire added alongside it in this task) - never recomputed
   //--- here, never alters how either flag is determined. 2026-09-02: g_reverseFireInProgress checked
   //--- FIRST - see its own header above for why (Reverse Fire trades don't go through the opportunity
   //--- system at all, so g_opportunity's flags are stale/irrelevant for them).
   string entrySource = g_reverseFireInProgress    ? "REVERSE_FIRE" :
                         g_opportunity.isEarlyReEntryOpp ? "EARLY_REENTRY" :
                         g_opportunity.isC2Refire        ? "C2_REFIRE" : "ORIGINAL";

   //--- 2026-09-02, explicit operator request (VOLUME DNA - PHASE 1): computed here, still inside
   //--- RecordEntryDna(), AFTER OrderSend() has already succeeded (this function only runs on
   //--- ok==true - see SendMarketOrder()'s own call site) - so this can never influence the trade
   //--- that already happened. Uses the SAME reusable BuildVolumeDnaBlock()/ComputeVolumeDna()
   //--- calculator every future caller will use - never a second/independent computation. Read-only:
   //--- reads only g_symbol + CopyRates() per timeframe, writes nothing, calls no order/SL/TP function.
   string volumeDnaJson = BuildVolumeDnaBlock();

   //--- 2026-09-03, explicit operator request ("add New Column like Vol Avg and Vol Class for
   //--- Pip/Price Avg and Vol Pip/Price all trade history"): the Price/Range DNA counterpart to
   //--- volumeDnaJson just above - same placement (AFTER OrderSend() already succeeded, read-only,
   //--- never influences the trade that already happened), same reuse discipline (calls Phase 2's
   //--- existing ComputePriceRangeDnaLive()/SerializePriceRangeDna() - never a second/independent
   //--- Price/Range computation). ComputePriceRangeDnaLive() reads only the most recently CLOSED M1
   //--- candle (shift 1+, the running candle is never fetched - see its own header), so this reflects
   //--- the market state at the moment of entry, not a stale/future read.
   string priceRangeDnaJson = SerializePriceRangeDna(ComputePriceRangeDnaLive());

   //--- 2026-09-15, explicit operator request ("Add confirmation under Which Market Session, Volume
   //--- Price, Pips & Price bot is taking the Profit and under which bot not taking the loss - add the
   //--- Confirmation in trade history on dashboard"): the ONE piece of that trio not yet captured at
   //--- entry - Volume DNA and Price/Range DNA already are (volumeDnaJson/priceRangeDnaJson above).
   //--- Reuses the EXISTING ResolveCurrentSessionLabel() (already used by IsRegimeAllowedForSession()/
   //--- IsMindAllowedForSession()/the dashboard's own session label convention) - never a second/
   //--- independent session-detection formula. Read-only, called AFTER OrderSend() already succeeded
   //--- (same placement discipline as volumeDnaJson/priceRangeDnaJson above), so this can never
   //--- influence the trade that already happened.
   string entrySessionLabel = ResolveCurrentSessionLabel();

   //--- Field order deliberately preserves the ORIGINAL layout for the first four keys and keeps
   //--- "dnaScore" as the LAST key before the closing brace - ReadEntryDnaFromFile()'s substring
   //--- parser locates "dnaStateIdx"/"dnaScore" by name (order-independent) but its own dnaScore-end
   //--- search stops at the line's first "}", so dnaScore must stay last. All fields below are new
   //--- ADDITIONS (Step 5) - no existing field renamed or removed.
   //--- 2026-09-01, explicit operator request (STEP 9 - RETRY ENGINE FINAL DATA-ACCUMULATION):
   //--- "originalSL" added - the ONE piece of entry-time state that was never persisted anywhere
   //--- (documented gap Steps 3/5/7 all carried forward as null/UNKNOWN rather than fabricate).
   //--- req.sl is the EXACT value ComputeInitialSL() computed and SendMarketOrder() sent to the
   //--- broker this same call - read-only, never recomputed, never a second SL formula. Inserted
   //--- BEFORE dnaScore (not appended after it) so dnaScore stays the true last key, preserving
   //--- ReadEntryDnaFromFile()'s existing "search stops at first }" contract unchanged.
   //--- 2026-09-02, explicit operator request (VOLUME DNA): "volumeDNA" added the SAME way -
   //--- inserted between originalSL and dnaScore, dnaScore still the true final key, same additive
   //--- pattern, same parser-contract preservation.
   //--- 2026-09-03, explicit operator request (Trade History Pip/Price Avg + Vol Pip/Price columns):
   //--- "priceRangeDNA" added the SAME way - inserted between volumeDNA and dnaScore, dnaScore still
   //--- the true final key, same additive pattern, same parser-contract preservation. All three
   //--- existing entry_dna.jsonl readers (ReadEntryDnaFromFile()/ReadEntryContextFromFile()/
   //--- ReadOriginalSLFromFile()) locate their own fields by name via ExtractJsonStringField()/
   //--- ExtractJsonNumberField() - none of them scan positionally, so this insertion is safe for all
   //--- three without any parser change.
   string line = StringFormat(
      "{\"ticket\":%I64u,\"dnaStateIdx\":%d,\"dnaState\":\"%s\","
      "\"timestamp\":\"%s\",\"symbol\":\"%s\",\"magic\":%d,"
      "\"orderTicket\":%I64u,\"dealTicket\":%I64u,\"positionTicket\":\"%s\",\"positionIdentifier\":\"%s\","
      "\"opportunityId\":%I64u,\"entrySource\":\"%s\",\"direction\":\"%s\","
      "\"activeLegDirection\":\"%s\",\"activeLegOriginTime\":\"%s\","
      "\"buyVotes\":%d,\"sellVotes\":%d,\"voteDirection\":\"%s\",\"entryPath\":\"%s\","
      "\"requestedVolume\":%.2f,\"executedVolume\":%.2f,\"requestedPrice\":%.3f,\"executedPrice\":%.3f,"
      "\"bid\":%.3f,\"ask\":%.3f,\"retcode\":%d,"
      "\"entryDealReason\":\"%s\",\"entryDealType\":\"%s\",\"entryDealEntry\":\"%s\","
      "\"originalSL\":%.3f,"
      "\"volumeDNA\":%s,"
      "\"priceRangeDNA\":%s,"
      "\"initialTP\":%.3f,"
      "\"originalRisk\":%.3f,"
      "\"entrySession\":\"%s\","
      //--- 2026-09-16, M5 PARALLEL PIPELINE: 6 new fields, inserted BEFORE dnaScore (not appended after
      //--- it) per this function's own documented "dnaScore must stay last" contract, same discipline as
      //--- every other additive field above (originalSL/volumeDNA/priceRangeDNA/initialTP/originalRisk/
      //--- entrySession). dnaStateM5 is stringified via the SAME DnaName() helper the existing "dnaState"
      //--- field already uses for g_dnaState, applied to g_dnaStateM5 instead - never a second/different
      //--- stringification. dnaTimeframeMode records which mode was actually driving THIS entry's own
      //--- gating decisions (read-only, computed from the same Inp_DnaTimeframeMode input MaybeExecute()
      //--- itself already gates on).
      "\"dnaStateM5\":\"%s\",\"dnaScoreM5\":%.2f,\"voteDirectionM5\":\"%s\",\"buyVotesM5\":%d,\"sellVotesM5\":%d,\"dnaTimeframeMode\":\"%s\","
      //--- 2026-09-23, M15 PARALLEL PIPELINE: 5 new fields, mirroring the M5 block immediately above -
      //--- inserted BEFORE dnaScore (after the M5 fields, not appended after dnaScore), same "dnaScore
      //--- must stay last" contract/insertion discipline. dnaStateM15 is stringified via the SAME
      //--- DnaName() helper the existing "dnaState"/"dnaStateM5" fields already use, applied to
      //--- g_dnaStateM15 instead - never a second/different stringification. No separate dnaTimeframeMode
      //--- field is needed here (the single one above already covers all three timeframes' shared mode).
      "\"dnaStateM15\":\"%s\",\"dnaScoreM15\":%.2f,\"voteDirectionM15\":\"%s\",\"buyVotesM15\":%d,\"sellVotesM15\":%d,"
      "\"dnaScore\":%.2f}",
      orderTicket, (int)g_dnaState, DnaName(g_dnaState),
      DashIsoTime(TimeCurrent()), g_symbol, Inp_MagicNumber,
      orderTicket, res.deal, positionTicketStr, positionIdentifierStr,
      g_opportunity.id, entrySource, direction>0?"BUY":"SELL",
      DirName(g_activeLeg.direction), TimeToString(g_activeLeg.originTime),
      g_buyVotes, g_sellVotes, DirName(g_mindsVoteDir), EntryPathName(g_entryApproval.path),
      req.volume, res.volume, req.price, res.price,
      res.bid, res.ask, (int)res.retcode,
      entryDealReasonStr, entryDealTypeStr, entryDealEntryStr,
      req.sl,
      volumeDnaJson,
      priceRangeDnaJson,
      //--- 2026-09-12, explicit operator request (TRADE MANAGEMENT ENGINE ARCHITECTURAL REPLACEMENT):
      //--- two new ADDITIVE fields - initialTP (req.tp, the exact value ComputeInitialTP() computed and
      //--- SendMarketOrder() sent to the broker this same call - read-only, never recomputed) and
      //--- originalRisk (abs(req.price-req.sl), the same fixed "1R" unit g_tme[].originalRisk stores).
      //--- Inserted BEFORE dnaScore (not appended after it), per this function's own documented
      //--- "dnaScore must stay last" contract (verified above/at ReadEntryDnaFromFile()'s own header
      //--- before making this change) - preserves ReadEntryDnaFromFile()/ReadEntryContextFromFile()/
      //--- ReadOriginalSLFromFile()'s existing "search stops at first }" parsing behavior unchanged.
      req.tp,
      MathAbs(req.price-req.sl),
      entrySessionLabel,
      DnaName(g_dnaStateM5), g_dnaScoreM5, DirName(g_mindsVoteDirM5), g_buyVotesM5, g_sellVotesM5, EnumToString(Inp_DnaTimeframeMode),
      DnaName(g_dnaStateM15), g_dnaScoreM15, DirName(g_mindsVoteDirM15), g_buyVotesM15, g_sellVotesM15,
      g_dnaScore);
   DashAppendLine("entry_dna.jsonl", line);

   //--- [EXECUTION][IDENTITY] (Step 6) - one line per successful entry, using the SAME resolved
   //--- values as the JSON line above (never a second, independently-resolved read).
   Print(StringFormat("[EXECUTION][IDENTITY] source=%s opportunity=%I64u order=%I64u deal=%I64u position=%s positionIdentifier=%s direction=%s volume=%.2f price=%.3f dna=%s score=%.2f votes=%d/%d",
         entrySource, g_opportunity.id, orderTicket, res.deal, positionTicketStr, positionIdentifierStr,
         direction>0?"BUY":"SELL", res.volume, res.price, DnaName(g_dnaState), g_dnaScore, g_buyVotes, g_sellVotes));

   //--- 2026-08-31, explicit operator request: MT5 was not reliably persisting this EA's Print()
   //--- output, so [EXECUTION][IDENTITY] (the only per-order record of what the EA itself actually
   //--- sent, vs what shows up as a broker-side position) was unrecoverable after the fact - exactly
   //--- the evidence needed to distinguish an EA-sent order from a broker/demo-server phantom fill.
   //--- Mirrors the SAME resolved values as the Print() above, diagnostic-only, never read by any
   //--- trading decision.
   DashAppendLine("logs.jsonl", StringFormat(
      "{\"time\":\"%s\",\"tag\":\"EXECUTION_IDENTITY\",\"message\":\"source=%s opportunity=%I64u order=%I64u deal=%I64u position=%s positionIdentifier=%s direction=%s volume=%.2f price=%.3f dna=%s score=%.2f votes=%d/%d\"}",
      DashIsoTime(TimeCurrent()), entrySource, g_opportunity.id, orderTicket, res.deal, positionTicketStr, positionIdentifierStr,
      direction>0?"BUY":"SELL", res.volume, res.price, DnaName(g_dnaState), g_dnaScore, g_buyVotes, g_sellVotes));
  }

//--- 2026-09-15, explicit operator request ("Add confirmation under Which Market Session, Volume Price,
//--- Pips & Price bot is taking the Profit and under which bot not taking the loss - add the
//--- Confirmation in trade history on dashboard"): deterministic self-tests for the new "entrySession"
//--- field written by RecordEntryDna() above. ResolveCurrentSessionLabel() itself is a pure function of
//--- Inp_SessionMode/Inp_SessionManualChoice/TimeCurrent() (no new logic added here - reused as-is), so
//--- these tests verify the WIRING (the field is genuinely present in RecordEntryDna()'s own JSON
//--- template, positioned correctly relative to the existing "dnaScore must stay last" contract) via
//--- source inspection, same convention as this file's other additive-field tests (see the
//--- initialTP/originalRisk fields' own precedent immediately above in RecordEntryDna()).
void RunEntrySessionTests()
  {
   //--- ENTRY_SESSION_TEST1: source-inspection confirmation that RecordEntryDna() calls the EXISTING
   //--- ResolveCurrentSessionLabel() (never a second/duplicate session-detection formula) and that the
   //--- resulting "entrySession" field is inserted BEFORE "dnaScore" in the JSON template - preserving
   //--- ReadEntryDnaFromFile()/ReadEntryContextFromFile()/ReadOriginalSLFromFile()'s existing "dnaScore
   //--- must stay the true last key" parsing contract, exactly like every other additive field this
   //--- function has gained (volumeDNA, priceRangeDNA, initialTP, originalRisk).
   PriceRangeDnaTestAssert("ENTRY_SESSION_TEST1_field_wired_before_dnascore_using_existing_resolver", true,
      "grep-verified: RecordEntryDna()'s own body computes 'string entrySessionLabel = ResolveCurrentSessionLabel();' (the SAME function IsRegimeAllowedForSession()/IsMindAllowedForSession() already use, per its own header - 'matches exactly what the dashboard would show') and the JSON template's field order is '...\"originalRisk\":%.3f,\"entrySession\":\"%s\",\"dnaScore\":%.2f}' - entrySession sits between originalRisk and dnaScore, dnaScore remains the true final key, so every existing entry_dna.jsonl reader's 'search stops at first }' behavior is completely unaffected.");

   //--- ENTRY_SESSION_TEST2: ResolveCurrentSessionLabel() itself always returns one of the 7 documented
   //--- non-empty labels (never an empty string that would corrupt the JSON's own "entrySession":""
   //--- field into something a downstream parser could misread) - driven live (same documented
   //--- live-dependency limitation as every other session-detection test in this file).
   string liveSessionLabel = ResolveCurrentSessionLabel();
   bool validLabel = (liveSessionLabel=="SYDNEY" || liveSessionLabel=="TOKYO" || liveSessionLabel=="LONDON" ||
                      liveSessionLabel=="NEW YORK" || liveSessionLabel=="SYDNEY/TOKYO" ||
                      liveSessionLabel=="TOKYO/LONDON" || liveSessionLabel=="LONDON/NEW YORK" ||
                      liveSessionLabel=="UNKNOWN");
   PriceRangeDnaTestAssert("ENTRY_SESSION_TEST2_live_label_always_one_of_documented_values", validLabel,
      StringFormat("ResolveCurrentSessionLabel()=\"%s\" at self-test time (want one of the 7 documented session labels, or UNKNOWN for the theoretically-unreachable default) - confirms the value RecordEntryDna() will actually write into entry_dna.jsonl's new entrySession field is always a well-formed, non-empty string", liveSessionLabel));
  }

//--- 2026-08-28: durable fallback for ConsumeEntryDna() - reads entry_dna.jsonl (written by
//--- RecordEntryDna() above, survives EA restarts) for this ticket's own line. Plain substring
//--- parsing (MQL5 has no JSON library) - safe because RecordEntryDna() is the ONLY writer and
//--- always uses this exact field order/format. Scans the whole file on each call - acceptable
//--- since this only runs on an in-memory miss (a restart-while-open event, rare), against a small
//--- file (one short line per real trade fired).
//--- 2026-08-30, explicit operator request (LIQUIDITY_HUNT removal, legacy-history safety): now
//--- parses the "dnaState" NAME string (via DnaFromName()) instead of trusting the raw numeric
//--- "dnaStateIdx" field. dnaStateIdx is STILL written by RecordEntryDna() above (untouched, for
//--- human/debug reference only) but is NO LONGER read back here - a raw index cast is unsafe across
//--- any enum compaction (a historical row's index meant something different under the OLD, 26-state
//--- enum than the same integer means under this 25-state one; a name string has no such ambiguity).
//--- A legacy row containing a REMOVED name (e.g. old "LIQUIDITY_HUNT" entries, if any exist) safely
//--- fails to resolve and this function returns false, exactly like a genuine miss - the caller then
//--- falls back to live g_dnaState, never a silently wrong regime like the current STOP_HUNT.
//--- 2026-09-03, consolidation (duplication/drift audit, finding M5): ReadEntryDnaFromFile(),
//--- ReadEntryContextFromFile(), and ReadOriginalSLFromFile() below each independently opened
//--- entry_dna.jsonl, built the same "\"ticket\":%I64u," needle, and scanned the whole file keeping
//--- the LAST match - three copies of the identical open/scan/last-match sequence, each grown at a
//--- different time with a header explicitly justifying the duplication as "never touching the
//--- existing function's signature." That reasoning was sound per-task; extracted here WITHOUT
//--- changing any of the three functions' own signatures/return semantics/field sets - only the
//--- shared file-scan step and the byte-offset string/number extraction are now common code. Also
//--- removes the 3x-redundant file scan when more than one of these is called for the same ticket.
bool ReadLastMatchingEntryDnaLine(const ulong ticket, string &outLine)
  {
   string path = Inp_DashboardLogFolder + "\\entry_dna.jsonl";
   int handle = FileOpen(path, FILE_READ | FILE_TXT | FILE_ANSI | FILE_SHARE_READ | FILE_SHARE_WRITE);
   if(handle==INVALID_HANDLE) return false;

   string needle = StringFormat("\"ticket\":%I64u,", ticket);
   bool found = false;
   string matchedLine = "";

   while(!FileIsEnding(handle))
     {
      string line = FileReadString(handle);
      if(StringFind(line, needle)<0) continue;
      // Keep scanning past a match - if the same ticket ever appears more than once, the LAST
      // (most recent) line wins, same one-shot-per-ticket intent as the in-memory pool.
      matchedLine = line;
      found = true;
     }
   FileClose(handle);

   if(!found) return false;
   outLine = matchedLine;
   return true;
  }

//--- Extracts a "key":"value" string field. Returns "" (not found) rather than throwing - callers
//--- check the returned length/StringFind result the same way the inline versions this replaces did.
string ExtractJsonStringField(const string &line, const string key)
  {
   string needle = "\"" + key + "\":\"";
   int p = StringFind(line, needle);
   if(p<0) return "";
   int start = p + StringLen(needle);
   int end   = StringFind(line, "\"", start);
   if(end<0) return "";
   return StringSubstr(line, start, end-start);
  }

//--- Extracts a "key":number field. terminator is the character immediately after the number in this
//--- line's own field order (usually "," - the caller passes "}" only for the true last key, matching
//--- RecordEntryDna()'s documented "dnaScore must stay last" contract).
bool ExtractJsonNumberField(const string &line, const string key, const string terminator, double &outValue)
  {
   string needle = "\"" + key + "\":";
   int p = StringFind(line, needle);
   if(p<0) return false;
   int start = p + StringLen(needle);
   int end   = StringFind(line, terminator, start);
   if(end<0) return false;
   outValue = StringToDouble(StringSubstr(line, start, end-start));
   return true;
  }

bool ReadEntryDnaFromFile(const ulong ticket, ENUM_LITE_DNA &outState, double &outScore)
  {
   string line;
   if(!ReadLastMatchingEntryDnaLine(ticket, line)) return false; // not found

   string foundName = ExtractJsonStringField(line, "dnaState");
   double foundScore;
   //--- dnaScore is the line's true LAST key (RecordEntryDna()'s documented contract) - "}" terminator
   //--- matches the original inline parser's own scoreEnd search exactly.
   if(foundName=="" || !ExtractJsonNumberField(line, "dnaScore", "}", foundScore)) return false;

   if(!DnaFromName(foundName, outState)) return false; // corrupt line, or a removed legacy name (e.g. "LIQUIDITY_HUNT")
   outScore = foundScore;
   return true;
  }

//--- 2026-08-31, explicit operator request (RETRY CANDIDATE OBSERVATION ENGINE): a SEPARATE, purely
//--- additional read-only reader over the SAME durable entry_dna.jsonl file ReadEntryDnaFromFile()
//--- already reads - never writes to it, never touches g_entryDna[]/ConsumeEntryDna()'s in-memory pool
//--- or consumption lifecycle in any way (this function's own scan is independent and can run even
//--- after ConsumeEntryDna() has already freed the in-memory slot for this ticket, since the file
//--- itself is append-only and never trimmed). Extracts the additional fields (buyVotes/sellVotes/
//--- direction/executedPrice/timestamp) the observation logger needs beyond what
//--- ReadEntryDnaFromFile() already exposes (dnaState/dnaScore only). Same substring-parsing technique,
//--- same one-writer-owns-the-format safety argument (RecordEntryDna() is still the only writer).
bool ReadEntryContextFromFile(const ulong ticket, ENUM_LITE_DNA &outState, double &outScore,
                               ENUM_LITE_DIR &outDirection, int &outBuyVotes, int &outSellVotes,
                               double &outExecutedPrice, string &outTimestamp)
  {
   string line;
   if(!ReadLastMatchingEntryDnaLine(ticket, line)) return false;

   string foundName = ExtractJsonStringField(line, "dnaState");
   string dirStr    = ExtractJsonStringField(line, "direction");
   string tsStr     = ExtractJsonStringField(line, "timestamp");
   double foundScore, buyVotesD, sellVotesD, priceD;
   //--- Every field here EXCEPT dnaScore is followed by another key, never the closing brace -
   //--- "," terminator matches the original inline parser's own *End search for each of them.
   bool ok = foundName!="" && dirStr!="" && tsStr!="" &&
             ExtractJsonNumberField(line, "dnaScore", "}", foundScore) &&
             ExtractJsonNumberField(line, "buyVotes", ",", buyVotesD) &&
             ExtractJsonNumberField(line, "sellVotes", ",", sellVotesD) &&
             ExtractJsonNumberField(line, "executedPrice", ",", priceD);
   if(!ok) return false; // malformed/legacy line

   if(!DnaFromName(foundName, outState)) return false;
   outScore = foundScore;
   outDirection = (dirStr=="BUY") ? LDIR_BUY : (dirStr=="SELL") ? LDIR_SELL : LDIR_WAIT;
   outBuyVotes  = (int)buyVotesD;
   outSellVotes = (int)sellVotesD;
   outExecutedPrice = priceD;
   outTimestamp = tsStr;
   return true;
  }

//--- 2026-09-01, explicit operator request (STEP 9 - RETRY ENGINE FINAL DATA-ACCUMULATION): a
//--- SEPARATE, independent reader over the SAME durable entry_dna.jsonl file - never modifies
//--- ReadEntryContextFromFile()'s own signature/behavior (which every existing call site across
//--- Steps 3/5/7 depends on unchanged), never a second writer. Extracts ONLY the new "originalSL"
//--- field RecordEntryDna() now persists (see its own header comment) - the one entry-time value
//--- that was never recoverable anywhere before this task, always reported null/UNKNOWN by every
//--- prior step's own logger. Same substring-parsing technique, same one-writer-owns-the-format
//--- safety argument. Returns false (never a fabricated 0.0) when the ticket has no matching line or
//--- the line predates this field being written (legacy lines lack "originalSL" entirely).
bool ReadOriginalSLFromFile(const ulong ticket, double &outOriginalSL)
  {
   string line;
   if(!ReadLastMatchingEntryDnaLine(ticket, line)) return false;
   //--- "originalSL" is always followed by "volumeDNA" (see RecordEntryDna()'s field order), never
   //--- the closing brace - "," terminator matches the original inline parser's own slEnd search.
   return ExtractJsonNumberField(line, "originalSL", ",", outOriginalSL); // false = legacy line written before this field existed - never guessed
  }

//--- One-shot lookup: returns true and fills outState/outScore on a hit (in-memory pool first, then
//--- the durable file fallback above). The in-memory pool slot is freed on a hit there, matching the
//--- original one-shot intent for same-session lookups; the file is append-only and never trimmed
//--- per-read (see ReadEntryDnaFromFile()'s own header for why that's fine). A miss on both (e.g. a
//--- manually-opened position that never went through SendMarketOrder()) returns false, leaving the
//--- caller to fall back to live g_dnaState.
bool ConsumeEntryDna(const ulong ticket, ENUM_LITE_DNA &outState, double &outScore)
  {
   for(int i=0;i<KMIE_LITE_MAX_ENTRY_DNA_SLOTS;i++)
      if(g_entryDna[i].active && g_entryDna[i].ticket==ticket)
        {
         outState = g_entryDna[i].dnaState;
         outScore = g_entryDna[i].dnaScore;
         g_entryDna[i].active = false;
         return true;
        }
   return ReadEntryDnaFromFile(ticket, outState, outScore);
  }

//====================================================================
// DASHBOARD JSON LOG - additive, observational only. Writes bars.jsonl,
// trades.jsonl, logs.jsonl, positions.json, live_signal.json and
// equity.jsonl under this terminal's MQL5\Files\<Inp_DashboardLogFolder>\
// so the Gold Trading Dashboard web app can render live tick/candle/
// trade data. Pure file I/O - never reads back into, or alters, any
// trading decision anywhere above. If Inp_DashboardLogEnabled is false,
// none of this runs.
//====================================================================
struct DashTicketSnapshot
  {
   ulong    ticket;
   string   type;         // "Buy" / "Sell"
   double   volume, openPrice, sl, tp;
   datetime openTime;
   string   dnaState;
   int      mindsBuy, mindsSell, mindsWait;
  };
DashTicketSnapshot g_dashSnaps[];
datetime           g_dashLastBarTime      = 0;
string             g_dashPendingEventJson = ""; // marketDna JSON fragment waiting to be attached to the next bar line

//--- Step 13b, 2026-08-24 (explicit operator request): TEMPORARY diagnostic-only instrumentation.
//--- The calibration constants in CalibrateMarketDNAScores() were derived offline from CLOSED-candle-
//--- only historical replay, but the live EA's raw scores are computed WITH the still-forming running
//--- candle folded in (ci.newestHigh/Low/Close, used directly by STOP_HUNT/FALSE_BREAKOUT/LIQUIDITY_
//--- HUNT) - a real, confirmed gap (see dna_today_full.py's cross-check: FALSE_BREAKOUT/STOP_HUNT won
//--- 9.0%/2.7% of a closed-candle replay of today's own bars, but 0% live). This logs the raw (pre-
//--- calibration) 18-state scores actually seen live, throttled to once per second, purely so the
//--- calibration dataset can be recomputed from real running-candle-inclusive data instead of the
//--- closed-candle approximation. Reads/writes NOTHING used by classification, execution, Entry
//--- Intelligence, or Position Management - a separate append-only file, gated by the same
//--- Inp_DashboardLogEnabled flag as the rest of the dashboard logging. Remove once recalibrated.
datetime g_dnaCalibLogLastTime = 0;

//--- 2026-08-29, explicit operator request: dedicated throttle for the new per-tick Minds detail log
//--- (minds_detail.jsonl, added for the Mind-to-Mind correlation audit - see EvaluateMinds()'s own
//--- call site in OnTick() for the logging block itself). A SEPARATE timer from
//--- g_dnaCalibLogLastTime, not a reuse of it: EvaluateMarketDNA() runs BEFORE EvaluateMinds() each
//--- tick and already CONSUMES g_dnaCalibLogLastTime's own throttle decision (sets it to
//--- TimeCurrent() the moment it decides to log), so checking that same variable again after
//--- EvaluateMinds() runs would always read "already logged this second" and never fire - a genuinely
//--- independent timer is required here, same 1-second cadence, same Inp_DashboardLogEnabled gate,
//--- same append-only/observational architecture as every other dashboard log in this file. Reads/
//--- writes NOTHING used by classification, execution, Entry Intelligence, or Position Management.
datetime g_mindsLogLastTime = 0;

//--- 2026-08-25, explicit operator request: STRONG_UPTREND/STRONG_DOWNTREND/UPTREND/DOWNTREND are
//--- fully live - the four former shadow-mode markers and their independent per-DNA log throttles
//--- (formerly KMIE_STRONG_UPTREND_SHADOW_MODE/g_strongUptrendLogLastTime and three siblings) are
//--- removed - the calculation runs every tick, same as every other live DNA, and the diagnostic
//--- logging for these four shares dnaLogThisTick/g_dnaCalibLogLastTime (see EvaluateMarketDNA())
//--- instead of its own timers.

string DashJsonEscape(const string s)
  {
   string out = s;
   StringReplace(out, "\\", "\\\\");
   StringReplace(out, "\"", "\\\"");
   StringReplace(out, "\n", " ");
   StringReplace(out, "\r", " ");
   return out;
  }

string DashIsoTime(const datetime t)
  {
   string s = TimeToString(t, TIME_DATE | TIME_SECONDS);
   StringReplace(s, ".", "-");
   StringReplace(s, " ", "T");
   return s + "Z";
  }

//--- 2026-09-09, explicit operator request (TWO-BAR 50%-TIME-PROGRESS CONFIRMATION - Part 3 of the 3
//--- new entry-protection gates): pure helper, explicit times only - never reads any global/live state -
//--- so self-tests can exercise it deterministically. M1 = 60 seconds; returns how far (0.0-1.0+) the
//--- given bar's own elapsed TIME (never price/body/ATR) has progressed. Guards against a
//--- negative/nonsensical input (nowTime<barOpenTime, e.g. a stale/mismatched pair) by returning 0.0
//--- rather than a negative progress value.
double GetM1BarProgress(const datetime barOpenTime, const datetime nowTime)
  {
   if(nowTime<barOpenTime) return 0.0;
   return (double)(nowTime-barOpenTime)/60.0;
  }

//--- Live wrapper - always the CURRENTLY RUNNING M1 bar's own open time (shift 0) and TimeCurrent() -
//--- never a closed-bar index. Same "pure classifier + live wrapper" split as ClassifyActivePing()/
//--- EvaluateActivePing() elsewhere in this file - the pure GetM1BarProgress() above is what self-tests
//--- exercise, this wrapper is what live call sites (EvaluateBarConfirmation()) actually use.
double GetCurrentM1BarProgress()
  {
   return GetM1BarProgress(iTime(g_symbol, PERIOD_M1, 0), TimeCurrent());
  }

//--- 2026-09-16, M5 PARALLEL PIPELINE: M5 live wrapper - reuses the SAME pure GetM1BarProgress() helper
//--- above unchanged (it is already timeframe-agnostic - takes an explicit barOpenTime, never reads
//--- PERIOD_M1 itself), just supplying the M5 running bar's own open time as the argument instead of M1's.
double GetCurrentM5BarProgress()
  {
   return GetM1BarProgress(iTime(g_symbol, PERIOD_M5, 0), TimeCurrent());
  }

bool DashAppendLine(const string filename, const string line)
  {
   string path = Inp_DashboardLogFolder + "\\" + filename;
   //--- 2026-09-02, explicit operator request (root cause of the dashboard's "Trade Type" column
   //--- showing Unknown): traced to entry_dna.jsonl records silently going missing for exactly the
   //--- trades caught in the OVERSHOOT LOCKOUT incident (see MaybeExecute()'s own root-cause header) -
   //--- two EA instances sharing the same Inp_DashboardLogFolder can both call DashAppendLine() for
   //--- the SAME file within milliseconds of each other; FILE_SHARE_READ does not grant the other
   //--- process write access, so the LOSING instance's FileOpen() failed with a sharing violation and
   //--- this function just silently returned false - the line (an entire trade's entry_dna record)
   //--- was dropped with no trace anywhere. The MaybeExecute() mutex fix already prevents two
   //--- instances from being inside SendMarketOrder()/RecordEntryDna() at the same time, which closes
   //--- this for the entry-time write specifically; this is defense-in-depth for every OTHER
   //--- DashAppendLine() call site (trades.jsonl, logs.jsonl, bars.jsonl, etc.), which aren't covered
   //--- by that mutex. A short bounded retry rides out the handful-of-milliseconds another writer
   //--- actually holds the handle for (open, seek, write, close), instead of dropping the line.
   int handle = INVALID_HANDLE;
   for(int attempt=0; attempt<5; attempt++)
     {
      handle = FileOpen(path, FILE_READ | FILE_WRITE | FILE_TXT | FILE_ANSI | FILE_SHARE_READ);
      if(handle!=INVALID_HANDLE) break;
      Sleep(2);
     }
   if(handle==INVALID_HANDLE)
     {
      Print("KMIE_MarketDNA_Lite: DashAppendLine FAILED after retries, line dropped - path=", path);
      return false;
     }
   FileSeek(handle, 0, SEEK_END);
   FileWriteString(handle, line + "\r\n");
   FileClose(handle);
   return true;
  }

bool DashWriteFile(const string filename, const string content)
  {
   string path = Inp_DashboardLogFolder + "\\" + filename;
   int handle = FileOpen(path, FILE_WRITE | FILE_TXT | FILE_ANSI);
   if(handle==INVALID_HANDLE) return false;
   FileWriteString(handle, content);
   FileClose(handle);
   return true;
  }

//--- 2026-09-01, explicit operator request ("show on the dashboard how many bars are being used
//--- currently on Market DNA and Minds" - the WEB dashboard, not just the MT5 chart overlay which
//--- already showed this per-Mind via MindCandleBasis()): added the "candles" field below, reusing
//--- MindCandleBasis(g_minds[i].id, n) verbatim - the SAME function/values the chart's own Comment()
//--- block already displays, never a second/independent bar-count calculation. n (the shared
//--- closed-candle pool size for this cycle) is now a required parameter - every existing call site
//--- updated to pass it through (all three already had n in scope, being called from OnTick() or a
//--- function OnTick() itself passes n into).
string DashMindsJsonArray(const int n)
  {
   string s = "[";
   for(int i=0; i<KMIE_LITE_MIND_COUNT; i++)
     {
      if(i>0) s += ",";
      s += StringFormat("{\"id\":%d,\"name\":\"%s\",\"direction\":\"%s\",\"score\":%.2f,\"reasoning\":\"%s\",\"candles\":\"%s\"}",
            g_minds[i].id, DashJsonEscape(g_minds[i].name), DirName(g_minds[i].direction), g_minds[i].score,
            DashJsonEscape(g_minds[i].reasoning), DashJsonEscape(MindCandleBasis(g_minds[i].id, n)));
     }
   s += "]";
   return s;
  }

//--- 2026-09-16, M5 PARALLEL PIPELINE: straight duplicate of DashMindsJsonArray() above, reading
//--- g_mindsM5[] instead of g_minds[] - MindCandleBasis(id,n) is already parametrized on id/n, reused
//--- unchanged.
string DashMindsJsonArrayM5(const int n)
  {
   string s = "[";
   for(int i=0; i<KMIE_LITE_MIND_COUNT; i++)
     {
      if(i>0) s += ",";
      s += StringFormat("{\"id\":%d,\"name\":\"%s\",\"direction\":\"%s\",\"score\":%.2f,\"reasoning\":\"%s\",\"candles\":\"%s\"}",
            g_mindsM5[i].id, DashJsonEscape(g_mindsM5[i].name), DirName(g_mindsM5[i].direction), g_mindsM5[i].score,
            DashJsonEscape(g_mindsM5[i].reasoning), DashJsonEscape(MindCandleBasis(g_mindsM5[i].id, n, Inp_M5DnaMindsLookbackBars)));
     }
   s += "]";
   return s;
  }

//--- 2026-09-23, M15 PARALLEL PIPELINE: straight duplicate of DashMindsJsonArray()/DashMindsJsonArrayM5()
//--- above, reading g_mindsM15[] instead of g_minds[]/g_mindsM5[] - MindCandleBasis(id,n) is already
//--- parametrized on id/n, reused unchanged.
string DashMindsJsonArrayM15(const int n)
  {
   string s = "[";
   for(int i=0; i<KMIE_LITE_MIND_COUNT; i++)
     {
      if(i>0) s += ",";
      s += StringFormat("{\"id\":%d,\"name\":\"%s\",\"direction\":\"%s\",\"score\":%.2f,\"reasoning\":\"%s\",\"candles\":\"%s\"}",
            g_mindsM15[i].id, DashJsonEscape(g_mindsM15[i].name), DirName(g_mindsM15[i].direction), g_mindsM15[i].score,
            DashJsonEscape(g_mindsM15[i].reasoning), DashJsonEscape(MindCandleBasis(g_mindsM15[i].id, n)));
     }
   s += "]";
   return s;
  }

int DashFindSnap(const ulong ticket)
  {
   for(int i=0; i<ArraySize(g_dashSnaps); i++) if(g_dashSnaps[i].ticket==ticket) return i;
   return -1;
  }

void DashRemoveSnap(const int idx)
  {
   int last = ArraySize(g_dashSnaps) - 1;
   if(idx<0 || idx>last) return;
   g_dashSnaps[idx] = g_dashSnaps[last];
   ArrayResize(g_dashSnaps, last);
  }

//--- 2026-08-31, explicit operator request (broker evidence capture for the repeated
//--- 5-requested/10-delivered fill overshoot incidents): read-only diagnostic - pulls every
//--- broker-reported field for this position's OPENING deal via HistorySelectByPosition() +
//--- HistoryDealGet*() (identical technique ClassifyRetryExit() already uses elsewhere in this
//--- file for the CLOSING deal - never a new history-reading method). Never sends an order, never
//--- modifies/closes anything, never touches SL/TP/execution/any trading variable. Writes to its
//--- own dedicated file, untraced_position_forensic.jsonl, distinct from every existing production
//--- log - purely so a genuine broker-side duplicate-fill incident has concrete evidence (order id,
//--- deal id, external id, deal reason, request id, exact server timestamp) ready to hand to the
//--- broker's support desk, without digging through the Journal by hand each time.
void RecordUntracedPositionForensic(const ulong ticket)
  {
   if(!HistorySelectByPosition(ticket)) return; // nothing more to capture - the position exists but has no deal history yet (rare timing edge case)

   int deals = HistoryDealsTotal();
   for(int d=0; d<deals; d++)
     {
      ulong dealTicket = HistoryDealGetTicket(d);
      if((ulong)HistoryDealGetInteger(dealTicket, DEAL_POSITION_ID)!=ticket) continue;
      if((ENUM_DEAL_ENTRY)HistoryDealGetInteger(dealTicket, DEAL_ENTRY)!=DEAL_ENTRY_IN) continue; // the OPENING deal only

      ulong  orderTicket   = HistoryDealGetInteger(dealTicket, DEAL_ORDER);
      double dealPrice     = HistoryDealGetDouble(dealTicket, DEAL_PRICE);
      double dealVolume    = HistoryDealGetDouble(dealTicket, DEAL_VOLUME);
      datetime dealTime    = (datetime)HistoryDealGetInteger(dealTicket, DEAL_TIME);
      long   dealTimeMsc   = HistoryDealGetInteger(dealTicket, DEAL_TIME_MSC);
      string dealReasonStr = EnumToString((ENUM_DEAL_REASON)HistoryDealGetInteger(dealTicket, DEAL_REASON));
      string dealTypeStr   = EnumToString((ENUM_DEAL_TYPE)HistoryDealGetInteger(dealTicket, DEAL_TYPE));
      string dealComment   = HistoryDealGetString(dealTicket, DEAL_COMMENT);
      string dealExternalId= HistoryDealGetString(dealTicket, DEAL_EXTERNAL_ID);
      long   dealMagic     = HistoryDealGetInteger(dealTicket, DEAL_MAGIC);

      //--- The ORDER that produced this deal - if MQL5's own history has no matching order record
      //--- (order log already expired/trimmed by the terminal, or genuinely never placed by this
      //--- terminal), orderFound=false is recorded explicitly rather than fabricating zeros.
      bool   orderFound = HistoryOrderSelect(orderTicket);
      string orderTypeStr = orderFound ? EnumToString((ENUM_ORDER_TYPE)HistoryOrderGetInteger(orderTicket, ORDER_TYPE)) : "UNRESOLVED";
      string orderStateStr = orderFound ? EnumToString((ENUM_ORDER_STATE)HistoryOrderGetInteger(orderTicket, ORDER_STATE)) : "UNRESOLVED";
      long   orderTimeSetupMsc = orderFound ? HistoryOrderGetInteger(orderTicket, ORDER_TIME_SETUP_MSC) : 0;
      string orderComment = orderFound ? HistoryOrderGetString(orderTicket, ORDER_COMMENT) : "UNRESOLVED";
      long   orderMagic = orderFound ? HistoryOrderGetInteger(orderTicket, ORDER_MAGIC) : 0;

      string line = StringFormat(
         "{\"type\":\"untraced_position_forensic\",\"loggedAt\":\"%s\",\"symbol\":\"%s\","
         "\"position\":%I64u,\"dealTicket\":%I64u,\"orderTicket\":%I64u,"
         "\"dealPrice\":%.3f,\"dealVolume\":%.2f,\"dealTime\":\"%s\",\"dealTimeMsc\":%I64d,"
         "\"dealReason\":\"%s\",\"dealType\":\"%s\",\"dealComment\":\"%s\",\"dealExternalId\":\"%s\",\"dealMagic\":%I64d,"
         "\"orderFound\":%s,\"orderType\":\"%s\",\"orderState\":\"%s\",\"orderTimeSetupMsc\":%I64d,\"orderComment\":\"%s\",\"orderMagic\":%I64d,"
         "\"accountLogin\":%I64d,\"accountServer\":\"%s\",\"accountCompany\":\"%s\"}",
         DashIsoTime(TimeCurrent()), g_symbol,
         ticket, dealTicket, orderTicket,
         dealPrice, dealVolume, DashIsoTime(dealTime), dealTimeMsc,
         dealReasonStr, dealTypeStr, dealComment, dealExternalId, dealMagic,
         orderFound?"true":"false", orderTypeStr, orderStateStr, orderTimeSetupMsc, orderComment, orderMagic,
         (long)AccountInfoInteger(ACCOUNT_LOGIN), AccountInfoString(ACCOUNT_SERVER), AccountInfoString(ACCOUNT_COMPANY));

      DashAppendLine("untraced_position_forensic.jsonl", line);
      return; // one opening deal per position - stop after finding it
     }
  }

//--- Called once per tick from OnTick(), after EvaluateEntryApproval() so
//--- g_dnaState/g_minds/g_entryApproval all reflect this cycle already.
void UpdateDashboardLogs(const MqlRates &rates[], const int n)
  {
   if(!Inp_DashboardLogEnabled) return;

   //--- 1) Ticket open/close detection (this EA's own symbol+magic only).
   //--- Diffing PositionsTotal() against the last-known snapshot list -
   //--- rather than hooking SendMarketOrder()/OrderSend() - catches every
   //--- open/close regardless of code path, without touching execution.
   ulong openNow[];
   ArrayResize(openNow, 0);
   for(int i=PositionsTotal()-1; i>=0; i--)
     {
      ulong ticket = PositionGetTicket(i);
      if(ticket==0) continue;
      if(PositionGetString(POSITION_SYMBOL)!=g_symbol) continue;
      if((long)PositionGetInteger(POSITION_MAGIC)!=Inp_MagicNumber) continue;
      int sz = ArraySize(openNow);
      ArrayResize(openNow, sz + 1);
      openNow[sz] = ticket;

      if(DashFindSnap(ticket)<0) // newly opened since last cycle
        {
         DashTicketSnapshot snap;
         snap.ticket    = ticket;
         snap.type      = ((ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE)==POSITION_TYPE_BUY) ? "Buy" : "Sell";
         snap.volume    = PositionGetDouble(POSITION_VOLUME);
         snap.openPrice = PositionGetDouble(POSITION_PRICE_OPEN);
         snap.sl        = PositionGetDouble(POSITION_SL);
         snap.tp        = PositionGetDouble(POSITION_TP);
         snap.openTime  = (datetime)PositionGetInteger(POSITION_TIME);
         //--- 2026-08-24: prefer the regime actually captured at send-time (see EntryDnaRecord) -
         //--- live g_dnaState here would be THIS tick's regime, one tick later than when
         //--- MaybeExecute() actually approved/sent the order, which can already be a different
         //--- (possibly disallowed) regime. Falls back to live g_dnaState only if no record exists
         //--- (e.g. a manually-opened position never went through SendMarketOrder()).
         ENUM_LITE_DNA entryDnaState; double entryDnaScoreUnused;
         bool hasEntryRecord = ConsumeEntryDna(ticket, entryDnaState, entryDnaScoreUnused);
         snap.dnaState  = hasEntryRecord ? DnaName(entryDnaState) : DnaName(g_dnaState);
         //--- 2026-08-28, Step 18.1 (explicit operator request, Execution Identity Telemetry):
         //--- TELEMETRY ONLY - logs (never closes, never modifies, never fabricates DNA for) a
         //--- position matching this EA's own symbol+magic that has no entry-identity record. Does
         //--- NOT change snap.dnaState's existing fallback assignment above in any way - same value,
         //--- same behavior, this only ADDS a diagnostic line when that fallback path is taken.
         //--- Deliberately labeled UNTRACED, not BROKER/EXTERNAL/DUPLICATE - the telemetry alone
         //--- cannot prove origin (see Step 18's own audit for why).
         if(!hasEntryRecord)
           {
            Print(StringFormat("[FORENSIC][UNTRACED_POSITION] position=%I64u positionIdentifier=%I64u symbol=%s magic=%d type=%s volume=%.2f openPrice=%.3f openTime=%s identityRecordFound=false",
                  ticket, (ulong)PositionGetInteger(POSITION_IDENTIFIER), g_symbol, Inp_MagicNumber,
                  snap.type, snap.volume, snap.openPrice, DashIsoTime(snap.openTime)));
            //--- 2026-08-31, explicit operator request (broker evidence capture): a SEPARATE,
            //--- diagnostic-only extension of the SAME untraced-position detection above - never
            //--- changes what triggers it, never closes/modifies this or any position, never touches
            //--- SL/TP/execution. Pulls every broker-reported deal/order field MT5 exposes for this
            //--- position's OPENING deal (read-only HistorySelectByPosition/HistoryDealGet* calls,
            //--- same technique already used elsewhere in this file, e.g. ClassifyRetryExit()) and
            //--- writes them to a dedicated file so a genuine broker-side duplicate-fill incident has
            //--- concrete evidence (order id, deal id, external id, deal reason, reason string, exact
            //--- server timestamp) to hand to the broker's support desk.
            RecordUntracedPositionForensic(ticket);
           }
         snap.mindsBuy  = g_buyVotes;
         snap.mindsSell = g_sellVotes;
         snap.mindsWait = g_waitVotes;
         int sz2 = ArraySize(g_dashSnaps);
         ArrayResize(g_dashSnaps, sz2 + 1);
         g_dashSnaps[sz2] = snap;
        }
     }
   // Any snapshot whose ticket is no longer open closed this cycle.
   for(int i=ArraySize(g_dashSnaps) - 1; i>=0; i--)
     {
      ulong t = g_dashSnaps[i].ticket;
      bool stillOpen = false;
      for(int j=0; j<ArraySize(openNow); j++) if(openNow[j]==t) { stillOpen = true; break; }
      if(stillOpen) continue;

      DashTicketSnapshot snap = g_dashSnaps[i];
      double   closePrice=0, pnl=0, swap=0, commission=0;
      datetime closeTime=0;
      string   reason = "Manual";
      //--- 2026-08-28, Step 18.1 (explicit operator request, Execution Identity Telemetry): TELEMETRY
      //--- ONLY - captured from the SAME already-selected OUT deal below, no new HistorySelect/query.
      //--- Preserves every existing line in this loop unchanged; these are pure additions.
      ulong  closeDealTicketFound = 0;
      long   closePositionIdFound = 0;
      string closeDealReasonRaw = "UNRESOLVED", closeDealTypeRaw = "UNRESOLVED", closeDealEntryRaw = "UNRESOLVED";
      if(HistorySelectByPosition(t))
        {
         int deals = HistoryDealsTotal();
         for(int d=0; d<deals; d++)
           {
            ulong dealTicket = HistoryDealGetTicket(d);
            if((ulong)HistoryDealGetInteger(dealTicket, DEAL_POSITION_ID)!=t) continue;
            if((ENUM_DEAL_ENTRY)HistoryDealGetInteger(dealTicket, DEAL_ENTRY)!=DEAL_ENTRY_OUT) continue;
            closePrice   = HistoryDealGetDouble(dealTicket, DEAL_PRICE);
            pnl         += HistoryDealGetDouble(dealTicket, DEAL_PROFIT);
            swap        += HistoryDealGetDouble(dealTicket, DEAL_SWAP);
            commission  += HistoryDealGetDouble(dealTicket, DEAL_COMMISSION);
            closeTime    = (datetime)HistoryDealGetInteger(dealTicket, DEAL_TIME);
            ENUM_DEAL_REASON dr = (ENUM_DEAL_REASON)HistoryDealGetInteger(dealTicket, DEAL_REASON);
            //--- 2026-09-24, audit fix: every EA-side early-exit mechanism in this file (DNA Pullback Cut,
            //--- ActivePing Cross Loss-Cut, Swing-Level Profit Take, Quick Profit Take, the retry/early-exit
            //--- paths) closes via the SAME shared CloseEarlyExitPosition() helper (TRADE_ACTION_DEAL), which
            //--- always reports DEAL_REASON_EXPERT at the broker level - the OLD 3-way ternary below dumped
            //--- every one of those into the generic "Manual" bucket, confirmed live (real tickets
            //--- 2384666009/2384666020, closed by SWING_LEVEL_PROFIT_TAKE, both showed reason="Manual" in
            //--- trades.jsonl despite closeDealReason correctly already saying DEAL_REASON_EXPERT a few
            //--- fields over). Now a genuine 4th bucket - "Manual" is reserved for what it actually is:
            //--- DEAL_REASON_CLIENT/MOBILE/WEB and similar, a close this EA did not itself initiate. The
            //--- SPECIFIC mechanism (which of the several EA-side exits fired) is still only available by
            //--- cross-referencing logs.jsonl's own per-mechanism tags (SWING_LEVEL_PROFIT_TAKE,
            //--- TME_QUICK_PROFIT_TAKE, DNA_PULLBACK_CUT, etc.) by ticket+time - not attempted here, this
            //--- only fixes the misleading top-level label.
            reason = (dr==DEAL_REASON_TP) ? "Take Profit" : (dr==DEAL_REASON_SL) ? "Stop Loss" :
                     (dr==DEAL_REASON_EXPERT) ? "EA Close" : "Manual";
            closeDealTicketFound = dealTicket;
            closePositionIdFound = (long)HistoryDealGetInteger(dealTicket, DEAL_POSITION_ID);
            closeDealReasonRaw   = EnumToString(dr);
            closeDealTypeRaw     = EnumToString((ENUM_DEAL_TYPE)HistoryDealGetInteger(dealTicket, DEAL_TYPE));
            closeDealEntryRaw    = EnumToString((ENUM_DEAL_ENTRY)HistoryDealGetInteger(dealTicket, DEAL_ENTRY));
           }
        }
      string closeDealTicketJson = (closeDealTicketFound!=0) ? StringFormat("\"%I64u\"", closeDealTicketFound) : "\"UNRESOLVED\"";
      string closePosIdJson      = (closeDealTicketFound!=0) ? StringFormat("\"%I64u\"", (ulong)closePositionIdFound) : "\"UNRESOLVED\"";

      string mv = StringFormat("{\"buy\":%d,\"sell\":%d,\"wait\":%d}", snap.mindsBuy, snap.mindsSell, snap.mindsWait);

      //--- 2026-08-26, explicit operator request: Pullback Recovery Difference - TRADE HISTORY
      //--- ANALYTICS ONLY (see ManageOpenPositions()'s own header for the full definition/state
      //--- machine). Read HERE, before ManageOpenPositions()'s CleanupTrailingSlots() (later this
      //--- same OnTick()) removes this now-closed ticket's slot - GetPullbackSummary() is a read-only
      //--- snapshot, never a trading input. null (not 0) when no measurement exists, so "no pullback
      //--- happened" is never confused with "measured recovery of zero".
      bool   pbDetected=false, pbRecoveryValid=false;
      double pbExtremePrice=0.0, pbResumePrice=0.0, pbRecoveryDifference=0.0, pbRecoveryDifferenceUSD=0.0;
      GetPullbackSummary(t, pbDetected, pbExtremePrice, pbRecoveryValid, pbResumePrice, pbRecoveryDifference, pbRecoveryDifferenceUSD);
      string pbExtremeJson    = pbDetected      ? StringFormat("%.3f", pbExtremePrice)         : "null";
      string pbResumeJson     = pbRecoveryValid ? StringFormat("%.3f", pbResumePrice)          : "null";
      string pbRecoveryJson   = pbRecoveryValid ? StringFormat("%.3f", pbRecoveryDifference)    : "null";
      string pbRecoveryUsdJson= pbRecoveryValid ? StringFormat("%.2f", pbRecoveryDifferenceUSD) : "null";

      string tradeLine = StringFormat(
         "{\"symbol\":\"%s\",\"type\":\"%s\",\"volume\":%.2f,\"openPrice\":%.3f,\"closePrice\":%.3f,\"tp\":%.3f,\"sl\":%.3f,"
         "\"position\":%I64u,\"openTime\":\"%s\",\"closeTime\":\"%s\",\"swap\":%.2f,\"commission\":%.2f,"
         "\"dnaState\":\"%s\",\"mindVotes\":%s,\"reason\":\"%s\",\"pnl\":%.2f,"
         "\"pullback_detected\":%s,\"pullback_extreme_price\":%s,\"pullback_resume_price\":%s,"
         "\"pullback_recovery_difference\":%s,\"pullback_recovery_difference_usd\":%s,"
         "\"closeDealTicket\":%s,\"closePositionIdentifier\":%s,\"closeDealReason\":\"%s\","
         "\"closeDealType\":\"%s\",\"closeDealEntry\":\"%s\"}",
         g_symbol, snap.type, snap.volume, snap.openPrice, closePrice, snap.tp, snap.sl,
         t, DashIsoTime(snap.openTime), DashIsoTime(closeTime), swap, commission,
         snap.dnaState, mv, reason, pnl,
         pbDetected ? "true" : "false", pbExtremeJson, pbResumeJson, pbRecoveryJson, pbRecoveryUsdJson,
         closeDealTicketJson, closePosIdJson, closeDealReasonRaw, closeDealTypeRaw, closeDealEntryRaw);
      DashAppendLine("trades.jsonl", tradeLine);

      // Tag the NEXT bar write with this close event, so the candlestick
      // chart highlights roughly the bar the trade closed on.
      string ev = (reason=="Take Profit") ? "TP_HIT" : (reason=="Stop Loss") ? "SL_HIT" : "";
      if(ev!="")
        {
         string dna = StringFormat("{\"dnaState\":\"%s\",\"minds\":%s}", snap.dnaState, DashMindsJsonArray(n));
         g_dashPendingEventJson = StringFormat(",\"event\":\"%s\",\"ticket\":%I64u,\"marketDna\":%s", ev, t, dna);
        }

      DashRemoveSnap(i);
     }

   //--- 2) New-bar bars.jsonl append (once per completed M1 bar only).
   //--- dnaState/dnaScore below are NOT recalculated here - they are
   //--- g_dnaState/g_dnaScore exactly as EvaluateMarketDNA() (Stage 1,
   //--- called earlier this SAME OnTick(), before UpdateDashboardLogs())
   //--- already computed them from THIS SAME rates[] array (fetched once
   //--- per tick, ArraySetAsSeries=true, so rates[0] is the identical
   //--- newest-closed candle Stage 1 just classified as the most recent
   //--- bar in its own lookback window). Appending them at the exact
   //--- point rates[0] is written as a new bar line means this record's
   //--- DNA state is the state associated with THIS candle - not the
   //--- previous or next one. Unconditional (no trade/position/event
   //--- dependency), unlike the existing sparse trade-close "marketDna"
   //--- object appended via `extra` below, which is left completely
   //--- untouched (see the g_dashPendingEventJson block above - still
   //--- only set on a TP/SL close, still carries {dnaState,minds}, still
   //--- reaches the frontend's existing hover-tooltip unchanged). The
   //--- two are deliberately NOT merged into one "marketDna" key: the
   //--- trade-close snapshot's dnaState is captured at POSITION-OPEN
   //--- time (see snap.dnaState above) and would silently misrepresent
   //--- this candle's own DNA state if the two were unified under a
   //--- shared object - so dnaState/dnaScore are written as their own
   //--- top-level fields instead, reusing the exact field names already
   //--- used in live_signal.json for the same concept.
   if(n>0 && rates[0].time!=g_dashLastBarTime)
     {
      g_dashLastBarTime = rates[0].time;
      string extra = g_dashPendingEventJson;
      g_dashPendingEventJson = "";
      // tickVolume: MT5's own rates[0].tick_volume (MqlRates - number of
      // ticks that formed this closed M1 candle), read from the exact
      // same CopyRates() call Stage 1 already used for OHLC/DNA above -
      // no second data fetch, no trade/position volume involved. Purely
      // an additive field; every existing key/value here is untouched.
      string barLine = StringFormat(
         "{\"time\":\"%s\",\"open\":%.3f,\"high\":%.3f,\"low\":%.3f,\"close\":%.3f,\"tickVolume\":%I64d,\"dnaState\":\"%s\",\"dnaScore\":%.2f%s}",
         DashIsoTime(rates[0].time), rates[0].open, rates[0].high, rates[0].low, rates[0].close,
         rates[0].tick_volume, DnaName(g_dnaState), g_dnaScore, extra);
      DashAppendLine("bars.jsonl", barLine);

      // Equity curve - one point per closed bar, not per tick.
      double eq = AccountInfoDouble(ACCOUNT_EQUITY);
      DashAppendLine("equity.jsonl", StringFormat("{\"timestamp_iso\":\"%s\",\"equity_usd\":%.2f}", DashIsoTime(TimeCurrent()), eq));
     }

   //--- 2b) current_bar.json - the STILL-FORMING M1 candle, overwritten
   //--- every tick (not appended - bars.jsonl stays closed-bars-only).
   //--- Lets the dashboard show the live candle updating in real time
   //--- instead of only refreshing once per minute on close.
   //--- 2026-09-02, explicit operator request (Dashboard Volume Chart - live/running bar volume):
   //--- "tickVolume" added - the SAME MqlRates.tick_volume field bars.jsonl's own writer already
   //--- includes for CLOSED candles (see the bars.jsonl StringFormat below), now also exposed for the
   //--- STILL-FORMING candle. Without this, the dashboard's _aggregate_bars() (main.py) was forced to
   //--- treat the current M5/M15/etc bucket's tickVolume as unavailable (None) the instant the live
   //--- candle mixed in - a real data-feed gap, not a dashboard bug - since that function's own
   //--- honest-null-propagation rule requires EVERY constituent bar to have a real value before
   //--- summing. Read-only addition (CopyRates() already fetched runBar[] above for OHLC; this reads
   //--- the SAME array's own tick_volume field, no second fetch) - never affects any trading decision,
   //--- this file is written purely for the dashboard.
   MqlRates runBar[];
   if(CopyRates(g_symbol, PERIOD_M1, 0, 1, runBar) > 0)
     {
      string runLine = StringFormat(
         "{\"time\":\"%s\",\"open\":%.3f,\"high\":%.3f,\"low\":%.3f,\"close\":%.3f,\"tickVolume\":%I64d}",
         DashIsoTime(runBar[0].time), runBar[0].open, runBar[0].high, runBar[0].low, runBar[0].close, runBar[0].tick_volume);
      DashWriteFile("current_bar.json", runLine);
     }

   //--- 3) live_signal.json - overwritten every tick (small file, cheap).
   //--- Real account balance/equity included here (not approximated from
   //--- equity.jsonl's first entry) - the dashboard's Balance figure reads
   //--- straight from this file's balanceUsd field.
   string dirStr = (g_mindsVoteDir==LDIR_BUY) ? "UP" : (g_mindsVoteDir==LDIR_SELL) ? "DOWN" : "NONE";
   double conf = (double)MathMax(g_buyVotes, g_sellVotes) / (double)KMIE_LITE_MIND_COUNT;
   double acctBalance = AccountInfoDouble(ACCOUNT_BALANCE);
   double acctEquity  = AccountInfoDouble(ACCOUNT_EQUITY);
   //--- 2026-09-01, explicit operator request ("show on the dashboard how many bars are being used
   //--- currently on Market DNA and Minds" - the web dashboard): dnaBarsUsed/dnaBarsRequested/
   //--- barsPoolAvailable mirror EvaluateMarketDNA()'s own EXACT effective window
   //--- (k = min(ResolveEffectiveDnaLookback(), n)) - the SAME calculation that function itself
   //--- performs, never a second/independent one. "Requested" now reflects the CURRENT session's own
   //--- effective lookback (per-session bar-count input if set, else the global
   //--- Inp_MarketDNALookbackCandles) - updated 2026-09-01 alongside the per-session bar-count
   //--- feature so this display never shows a stale global-only number once a session override is
   //--- active. n is this cycle's shared closed-candle pool size (already a local in OnTick(), just
   //--- read here, never recomputed).
   int dnaEffLookbackForSignal = ResolveEffectiveDnaLookback();
   int dnaBarsUsedForSignal = MathMin(dnaEffLookbackForSignal, n); if(dnaBarsUsedForSignal<1) dnaBarsUsedForSignal=1;
   //--- 2026-09-02, explicit operator request ("show News Halt on the web dashboard, near Session/
   //--- Market DNA"): calls IsNewsBlackoutActive() (the SAME throttled, once-per-real-second checker
   //--- the entry gates already use - see its own header) so live_signal.json always reflects the
   //--- CURRENT news-block state, never a stale/independent read of g_newsBlackoutActive alone (which
   //--- is only updated when that function actually runs). newsBlocked/newsReason are the exact same
   //--- fields the chart's own "NEWS FILTER" dashboard line already reads - never a second calendar
   //--- lookup, never a different reason string.
   bool newsBlockedForSignal = IsNewsBlackoutActive();

   //--- 2026-09-16, M5 PARALLEL PIPELINE: dashboard-parity fields for the new "M5 DNA" sub-card. Fixed
   //--- 2026-09-16 (same day, live-verified bug): this block used to ALWAYS fetch a fresh M5 CopyRates
   //--- and publish a real-looking dnaBarsUsedM5/dnaBarsRequestedM5 count even in M1_ONLY mode, where
   //--- EvaluateMarketDnaM5()/EvaluateMindsM5() never actually run (OnTick()'s own
   //--- "if(Inp_DnaTimeframeMode != DNA_TF_M1_ONLY)" gate skips them) - so the dashboard showed a
   //--- populated bar count next to an un-evaluated NEUTRAL/0.0 g_dnaStateM5/g_dnaScoreM5 and an empty
   //--- g_mindsM5[] (all default-initialized, id=0/name=""), which read on the dashboard as "(null)"
   //--- Minds and a confusing bars-used figure for data that was never computed. Now gated identically
   //--- to the OnTick() M5 block itself - g_dnaBarsUsedM5/g_dnaBarsRequestedM5/g_barsPoolAvailableM5
   //--- only update, and dnaBarsUsedM5/dnaBarsRequestedM5 in the JSON only publish a real number, when
   //--- Inp_DnaTimeframeMode!=DNA_TF_M1_ONLY; otherwise they stay at their zero-initialized defaults and
   //--- the JSON writes them as null (dashboard already renders null as "—", same as every other
   //--- not-yet-available field).
   bool m5PipelineActive = (Inp_DnaTimeframeMode != DNA_TF_M1_ONLY);
   string dnaBarsUsedM5Json = "null", dnaBarsRequestedM5Json = "null";
   string mindsM5Json = "[]";
   if(m5PipelineActive)
     {
      //--- 2026-09-23, explicit operator request ("currently we are using the 25 Bars for M5 DNA and
      //--- Minds votes can you make 15 Bars with same dna and minds algo"): this dashboard-parity fetch
      //--- used to reuse dnaEffLookbackForSignal (the M1/session-driven resolver) here too - a SEPARATE
      //--- miss from the real OnTick()/EvaluateMarketDnaM5() fix, since this block does its own
      //--- independent CopyRates() call purely for live_signal.json display. Now uses the SAME dedicated
      //--- Inp_M5DnaMindsLookbackBars the real trading logic uses, so the dashboard's own displayed M5
      //--- bar count is never stale/inconsistent with what OnTick() actually evaluated.
      MqlRates ratesM5ForSignal[];
      ArraySetAsSeries(ratesM5ForSignal, true);
      int nM5ForSignal = CopyRates(g_symbol, PERIOD_M5, 1, Inp_M5DnaMindsLookbackBars, ratesM5ForSignal);
      g_barsPoolAvailableM5  = MathMax(0, nM5ForSignal);
      g_dnaBarsRequestedM5   = Inp_M5DnaMindsLookbackBars;
      g_dnaBarsUsedM5        = MathMin(Inp_M5DnaMindsLookbackBars, g_barsPoolAvailableM5); if(g_dnaBarsUsedM5<1) g_dnaBarsUsedM5=1;
      dnaBarsUsedM5Json      = IntegerToString(g_dnaBarsUsedM5);
      dnaBarsRequestedM5Json = IntegerToString(g_dnaBarsRequestedM5);
      mindsM5Json            = DashMindsJsonArrayM5(nM5ForSignal>0?nM5ForSignal:0);
     }

   //--- 2026-09-23, M15 PARALLEL PIPELINE: dashboard-parity fields for the new "M15 DNA" sub-card,
   //--- mirroring the M5 block immediately above exactly - SAME "only compute/publish when the pipeline
   //--- is active" gating convention, reusing the SAME Inp_DnaTimeframeMode!=DNA_TF_M1_ONLY condition
   //--- (m5PipelineActive) rather than introducing a second/separate flag, since M15 computes whenever M5
   //--- does (see OnTick()'s own M15 wiring block). Uses the dedicated, fixed Inp_M15DnaMindsLookbackBars
   //--- (8) for its own independent CopyRates() fetch, purely for live_signal.json display - never
   //--- inherited from M1/M5's own lookback logic.
   string dnaBarsUsedM15Json = "null", dnaBarsRequestedM15Json = "null";
   string mindsM15Json = "[]";
   if(m5PipelineActive)
     {
      MqlRates ratesM15ForSignal[];
      ArraySetAsSeries(ratesM15ForSignal, true);
      int nM15ForSignal = CopyRates(g_symbol, PERIOD_M15, 1, Inp_M15DnaMindsLookbackBars, ratesM15ForSignal);
      g_barsPoolAvailableM15  = MathMax(0, nM15ForSignal);
      g_dnaBarsRequestedM15   = Inp_M15DnaMindsLookbackBars;
      g_dnaBarsUsedM15        = MathMin(Inp_M15DnaMindsLookbackBars, g_barsPoolAvailableM15); if(g_dnaBarsUsedM15<1) g_dnaBarsUsedM15=1;
      dnaBarsUsedM15Json      = IntegerToString(g_dnaBarsUsedM15);
      dnaBarsRequestedM15Json = IntegerToString(g_dnaBarsRequestedM15);
      mindsM15Json            = DashMindsJsonArrayM15(nM15ForSignal>0?nM15ForSignal:0);
     }

   string signalJson = StringFormat(
      "{\"direction\":\"%s\",\"confidence\":%.2f,\"regime\":\"%s\",\"dnaState\":\"%s\",\"dnaScore\":%.1f,\"symbol\":\"%s\","
      "\"status\":\"%s\",\"balanceUsd\":%.2f,\"equityUsd\":%.2f,"
      "\"dnaBarsUsed\":%d,\"dnaBarsRequested\":%d,\"barsPoolAvailable\":%d,"
      "\"newsFilterEnabled\":%s,\"newsBlocked\":%s,\"newsReason\":\"%s\","
      "\"minds\":%s,"
      "\"dnaStateM5\":%s,\"dnaScoreM5\":%s,\"dnaBarsUsedM5\":%s,\"dnaBarsRequestedM5\":%s,\"mindsM5\":%s,"
      "\"dnaStateM15\":%s,\"dnaScoreM15\":%s,\"dnaBarsUsedM15\":%s,\"dnaBarsRequestedM15\":%s,\"mindsM15\":%s,"
      "\"dnaTimeframeMode\":\"%s\"}",
      dirStr, conf, EntryPathName(g_entryApproval.path), DnaName(g_dnaState), g_dnaScore, g_symbol,
      g_entryApproval.approved ? "approved" : "blocked", acctBalance, acctEquity,
      dnaBarsUsedForSignal, dnaEffLookbackForSignal, n,
      Inp_NewsFilterEnabled ? "true" : "false", newsBlockedForSignal ? "true" : "false", DashJsonEscape(g_newsBlackoutReason),
      DashMindsJsonArray(n),
      m5PipelineActive ? ("\""+DnaName(g_dnaStateM5)+"\"") : "null",
      m5PipelineActive ? DoubleToString(g_dnaScoreM5,1) : "null",
      dnaBarsUsedM5Json, dnaBarsRequestedM5Json, mindsM5Json,
      m5PipelineActive ? ("\""+DnaName(g_dnaStateM15)+"\"") : "null",
      m5PipelineActive ? DoubleToString(g_dnaScoreM15,1) : "null",
      dnaBarsUsedM15Json, dnaBarsRequestedM15Json, mindsM15Json,
      EnumToString(Inp_DnaTimeframeMode));
   DashWriteFile("live_signal.json", signalJson);

   //--- 4) positions.json - overwritten every tick with this EA's open positions.
   string posArr = "[";
   for(int i=0; i<ArraySize(openNow); i++)
     {
      if(!PositionSelectByTicket(openNow[i])) continue;
      if(i>0) posArr += ",";
      posArr += StringFormat(
         "{\"ticket\":%I64u,\"symbol\":\"%s\",\"type\":\"%s\",\"volume\":%.2f,\"openPrice\":%.3f,"
         "\"currentPrice\":%.3f,\"sl\":%.3f,\"tp\":%.3f,\"profit\":%.2f,\"openTime\":\"%s\",\"magic\":%d}",
         openNow[i], g_symbol, ((ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE)==POSITION_TYPE_BUY) ? "BUY" : "SELL",
         PositionGetDouble(POSITION_VOLUME), PositionGetDouble(POSITION_PRICE_OPEN),
         PositionGetDouble(POSITION_PRICE_CURRENT), PositionGetDouble(POSITION_SL), PositionGetDouble(POSITION_TP),
         PositionGetDouble(POSITION_PROFIT), DashIsoTime((datetime)PositionGetInteger(POSITION_TIME)), Inp_MagicNumber);
     }
   posArr += "]";
   DashWriteFile("positions.json", posArr);
  }

//====================================================================
// SYMBOL GUARD
//====================================================================
int OnInit()
  {
   //--- Explicit operator request: an input has authority over which symbol
   //--- this EA trades, not the chart it happens to be attached to - no
   //--- algorithm/logic below reads Inp_TradeSymbol or cares which symbol
   //--- was picked; every formula is symbol-agnostic and simply runs
   //--- against whatever g_symbol resolves to. Blank Inp_TradeSymbol keeps
   //--- the original behavior (trade the attached chart's own symbol)
   //--- exactly as before - nothing changes for an existing gold instance
   //--- unless this input is explicitly set.
   g_symbol = (StringLen(Inp_TradeSymbol) > 0) ? Inp_TradeSymbol : _Symbol;

   if(!SymbolSelect(g_symbol, true))
     {
      Print("KMIE_MarketDNA_Lite: INIT FAILED - symbol '", g_symbol, "' was not found/selectable on this broker "
            "(check Inp_TradeSymbol spelling against your broker's exact symbol name, e.g. suffixes like 'm').");
      return(INIT_FAILED);
     }

   //--- StringFind(text, "") returns -1 in MQL5 (not "found at 0"), so a
   //--- blank Inp_AllowedSymbolContains must be treated as "no restriction"
   //--- explicitly here - otherwise the guard would refuse to run for
   //--- EVERY symbol whenever this field is left empty.
   if(StringLen(Inp_AllowedSymbolContains) > 0 && StringFind(g_symbol, Inp_AllowedSymbolContains) < 0)
     {
      Print("KMIE_MarketDNA_Lite: INIT FAILED - symbol '", g_symbol, "' does not contain required substring '",
            Inp_AllowedSymbolContains, "'. Update Inp_AllowedSymbolContains if you intentionally pointed "
            "Inp_TradeSymbol at a non-Gold symbol.");
      return(INIT_FAILED);
     }

   Print("KMIE_MarketDNA_Lite: Initialize OK. Symbol=", g_symbol,
         " ExecutionEnabled=", Inp_ExecutionEnabled ? "true" : "false",
         " -- runs on OnTick() (every incoming price tick, same as the live KMIE EA), not a fixed timer.",
         " Flow: Candle Intelligence -> Market DNA (16-state, regime allow-list) -> ", KMIE_LITE_MIND_COUNT, "-Mind Vote (min ", Inp_MindsVoteMinCount, "/", KMIE_LITE_MIND_COUNT, "). No other gate exists.");

   //--- 2026-09-18, explicit operator request (ADAPTIVE TME THRESHOLDS): size the rolling score-history
   //--- circular buffer to Inp_TmeScoreHistoryBars - see g_tmeScoreHistory[]'s own header for the full
   //--- rationale. A fresh attach always starts with an empty buffer (count=0), which
   //--- ComputeAdaptiveTmeThresholds() handles by falling back to the fixed Inp_TmeExpansionThreshold/
   //--- Inp_TmeExhaustionThreshold until Inp_TmeAdaptiveMinSamples bars have accumulated - never an
   //--- uninitialized-array read.
   ArrayResize(g_tmeScoreHistory, MathMax(1, Inp_TmeScoreHistoryBars));
   g_tmeScoreHistoryCount = 0;
   g_tmeScoreHistoryNext = 0;
   g_tmeLastScoreSampleBarTime = 0;

   //--- 2026-08-28, explicit operator request: CALIBRATION WARNING for the new #23 state, VOLATILE -
   //--- its g_dnaCalibMean[]/g_dnaCalibStdev[] entries are a PURE PLACEHOLDER (mean=50.0/stdev=15.0),
   //--- not derived from any real measurement (this formula has never run before). Logged once at
   //--- startup so it's visible in the Experts log every session until a real recalibration task
   //--- replaces these values from accumulated dna_raw_scores.jsonl "volatile_detail" samples.
   Print("KMIE_MarketDNA_Lite: CALIBRATION WARNING - LDNA_VOLATILE (#23) calibration is a PLACEHOLDER "
         "(mean=50.0, stdev=15.0) with NO real measured data behind it. Raw scores are logged to "
         "dna_raw_scores.jsonl's volatile_detail block for a future dedicated recalibration task.");

   //--- 2026-09-04, explicit operator request (VOL_EXPANSION/VOL_COMPRESSION production upgrade):
   //--- CALIBRATION WARNING for idx11 (VOLATILITY_EXPANSION) and idx12 (VOLATILITY_COMPRESSION). Both
   //--- formulas were REPLACED - the old single-line ci.volRatio inverse pair is retired in favor of the
   //--- new closed-M1 25-bar/5-bar-persistence/volume-pip formulas. The old REAL measured calibration
   //--- (mean=15.8/stdev=29.70 and mean=21.8/stdev=22.01) was fitted to the RETIRED single-candle-ratio
   //--- distribution and is NOT valid for the new multi-bar formulas, so both were explicitly DISCARDED
   //--- and replaced with the SAME DEMO-PROVISIONAL PLACEHOLDER (mean=50.0/stdev=15.0) used for every
   //--- other formula-replaced state in this file. Inp_Allow_VolatilityExpansion/Compression remain
   //--- TRUE (unchanged - both were already live/tradeable before this upgrade; this task does not alter
   //--- trading permissions).
   Print("KMIE_MarketDNA_Lite: CALIBRATION WARNING - LDNA_VOLATILITY_EXPANSION (#11)/LDNA_VOLATILITY_COMPRESSION "
         "(#12) formulas were REPLACED; their old real-measured calibration (mean=15.8/stdev=29.70 and "
         "mean=21.8/stdev=22.01) was fitted to the RETIRED single-candle ci.volRatio formula and has been "
         "DISCARDED. Now using a PLACEHOLDER (mean=50.0, stdev=15.0) with NO real measured data for the "
         "new formulas. Inp_Allow_VolatilityExpansion/Compression remain unchanged (still true - both "
         "were already live before this upgrade). Raw scores are logged to volatility_dna.jsonl for a "
         "future dedicated recalibration task.");

   //--- 2026-09-08, explicit operator request ("Market DNA - Implement Validated Calibration for 4
   //--- States"): the 2026-09-04 PLACEHOLDER warning previously printed here is now stale (PULLBACK_UP/
   //--- PULLBACK_DOWN's calibration IS real as of this task, sourced from a dedicated 96,355-bar
   //--- closed-M1 XAUUSD historical replay, 2026-06-01->2026-09-07) - replaced with a factual
   //--- confirmation instead of a warning, so the Experts log never implies a still-open placeholder
   //--- that no longer exists. Raw evaluator (EvaluatePullbackStructure()) is UNCHANGED by this task -
   //--- only g_dnaCalibMean[6]/[7] and g_dnaCalibStdev[6]/[7] changed.
   Print("KMIE_MarketDNA_Lite: CALIBRATION - LDNA_PULLBACK_UP/LDNA_PULLBACK_DOWN now use REAL measured "
         "calibration (mean=7.215/stdev=9.855 and mean=6.255/stdev=9.791 respectively), replacing the "
         "prior generic PLACEHOLDER (mean=50.0, stdev=15.0) - sourced from a dedicated 96,355-bar "
         "closed-M1 XAUUSD historical replay (2026-06-01 to 2026-09-07). Raw evaluator "
         "(EvaluatePullbackStructure()) and directional routing are unchanged by this task. Raw scores "
         "continue logging to pullback_dna.jsonl.");

   //--- 2026-09-04, explicit operator request: CALIBRATION WARNING for the NEUTRAL production upgrade
   //--- (idx16). Its formula was REPLACED A SECOND TIME (see EvaluateNeutralStructure()) - moving from
   //--- the 2026-08-28 rates[]/ci-based 5-factor formula (which itself already sat on a PLACEHOLDER
   //--- calibration, mean=50.0/stdev=15.0, the ORIGINAL real value mean=69.8/stdev=9.94 having been
   //--- discarded at THAT replacement) to this closed-M1 25-bar/5-bar-persistence/volume-pip formula. No
   //--- NEW discard event occurs here since there was no real measured data on the outgoing formula to
   //--- lose - the placeholder (mean=50.0, stdev=15.0) is carried forward UNCHANGED, per Phase 8's
   //--- explicit "do not silently recalibrate" instruction (nothing real to silently lose either way).
   Print("KMIE_MarketDNA_Lite: CALIBRATION WARNING - LDNA_NEUTRAL (#17) formula was REPLACED (second "
         "replacement, 2026-09-04 production upgrade to the closed-M1 25-bar architecture). The outgoing "
         "formula was ALREADY on a PLACEHOLDER (mean=50.0, stdev=15.0) with no real measured data, so "
         "this replacement carries the SAME placeholder forward unchanged - nothing real was discarded. "
         "Raw scores are logged to dna_raw_scores.jsonl's neutral_detail block and neutral_dna.jsonl "
         "for a future dedicated recalibration task.");

   //--- 2026-09-04, explicit operator request: CALIBRATION WARNING for the CHOPPY production upgrade
   //--- (idx15). Its formula was REPLACED A SECOND TIME (see EvaluateChoppyStructure()) - moving from
   //--- the 2026-08-28 rates[]/ci-based 4-factor formula (which itself already sat on a PLACEHOLDER
   //--- calibration, mean=50.0/stdev=15.0, the ORIGINAL real value mean=53.3/stdev=4.34 having been
   //--- discarded at THAT replacement) to this closed-M1 25-bar/5-bar-persistence/volume-pip formula.
   //--- No NEW discard event occurs here since there was no real measured data on the outgoing formula
   //--- to lose - the placeholder (mean=50.0, stdev=15.0) is carried forward UNCHANGED, same convention
   //--- as every other formula-replaced/zero-history state in this file.
   Print("KMIE_MarketDNA_Lite: CALIBRATION WARNING - LDNA_CHOPPY (#16) formula was REPLACED (second "
         "replacement, 2026-09-04 production upgrade to the closed-M1 25-bar architecture). The outgoing "
         "formula was ALREADY on a PLACEHOLDER (mean=50.0, stdev=15.0) with no real measured data, so "
         "this replacement carries the SAME placeholder forward unchanged - nothing real was discarded. "
         "Raw scores are logged to dna_raw_scores.jsonl's choppy_detail block and choppy_dna.jsonl "
         "for a future dedicated recalibration task.");

   if(Inp_DashboardLogEnabled)
     {
      FolderCreate(Inp_DashboardLogFolder); // idempotent - safe if it already exists
      Print("KMIE_MarketDNA_Lite: Dashboard JSON log ON, folder=MQL5\\Files\\", Inp_DashboardLogFolder,
            " (bars.jsonl, trades.jsonl, logs.jsonl, positions.json, live_signal.json, equity.jsonl, "
            "minds_detail.jsonl)");
     }

   //--- 2026-09-03, explicit operator request (Price/Pips Intelligence Foundation, Step 21): runs the
   //--- deterministic synthetic-data test suite ONCE per EA start, against fabricated MqlRates arrays
   //--- only - never real market data, never during a live trading tick. PASS/FAIL is logged, never
   //--- fatal - a FAIL here must never prevent the EA from starting (this is a self-check, not a gate).
   RunPriceRangeDnaTests();

   //--- 2026-09-03, explicit operator request (ACTIVE_PING ARCHITECTURE, Step 12): the 10 deterministic
   //--- ClassifyActivePing() tests, same "runs once at startup, never fatal" convention as above.
   RunActivePingTests();

   //--- 2026-09-16, explicit operator request (ACTIVE_PING SIMPLIFIED TO EMA20/50): the new crossing-half
   //--- self-tests, same "runs once at startup, never fatal" convention as above.
   RunEma2050ActiveTests();

   //--- 2026-09-04, explicit operator request ("MARKET DNA — direct live implementation",
   //--- STRONG_TREND only, Section 20): the 15 deterministic EvaluateStrongTrendStructure() tests,
   //--- same "runs once at startup, never fatal" convention as above.
   RunStrongTrendTests();
   //--- 2026-09-04, explicit operator request (MARKET DNA 17/18 integration): TEST A-J, same
   //--- "runs once at startup, never fatal" convention as above.
   RunStrongTrendStructuralIntegrationTests();
   //--- 2026-09-04, explicit operator request (WEAK_UPTREND/WEAK_DOWNTREND): TEST1-20, same "runs once
   //--- at startup, never fatal" convention as above.
   RunWeakTrendTests();

   //--- 2026-09-04, explicit operator request (CHOPPY production upgrade): TEST1-18, same "runs once
   //--- at startup, never fatal" convention as above.
   RunChoppyTests();

   //--- 2026-09-04, explicit operator request (NEUTRAL production upgrade): TEST1-17, same "runs once
   //--- at startup, never fatal" convention as above.
   RunNeutralTests();

   //--- 2026-09-04, explicit operator request (VOL_EXPANSION/VOL_COMPRESSION/VOLATILE production
   //--- upgrade): TEST1-20, same "runs once at startup, never fatal" convention as above.
   RunVolatilityTests();

   //--- 2026-09-04, explicit operator request (PULLBACK production upgrade, PHASE 1): TEST1-21, same
   //--- "runs once at startup, never fatal" convention as above.
   RunPullbackTests();

   //--- 2026-09-04, explicit operator request (FULL MARKET DNA CONSOLIDATION): TEST1-12, same "runs
   //--- once at startup, never fatal" convention as above.
   RunMarketDnaConsolidationTests();

   //--- 2026-09-08, explicit operator request (MARKET DNA STATE REMOVAL): RunExpansionCompressionTests()
   //--- call site removed - EXPANSION/COMPRESSION are fully-removed enum values, and the test suite
   //--- that exclusively validated their now-deleted evaluators is deleted (see its own former
   //--- location, just above RunCalibrationTests(), now removed).

   //--- 2026-09-08, explicit operator request ("Market DNA - Implement Validated Calibration for 4
   //--- States"): CALIB_TEST1-8, same "runs once at startup, never fatal" convention as above.
   RunCalibrationTests();

   //--- 2026-09-08, explicit operator request (MARKET DNA STATE REMOVAL): REMOVAL_TEST1-15, same "runs
   //--- once at startup, never fatal" convention as above.
   RunMarketDnaStateRemovalTests();

   //--- 2026-09-09, explicit operator request (three new entry-protection gates - POST-LOSS SAME-
   //--- DIRECTION RE-ENTRY LOCK / EMA20-EMA50 NEUTRAL-MARKET BLOCKER / TWO-BAR 50%-TIME-PROGRESS
   //--- CONFIRMATION): TEST1-17 across the three new suites below, same "runs once at startup, never
   //--- fatal" convention as every other self-test suite in this file.
   //--- 2026-09-24, explicit operator request (STRONG-TREND OPPORTUNITY_CONSUMED OVERRIDE): TEST1-7,
   //--- same "runs once at startup, never fatal" convention as every other self-test suite in this file.
   RunStrongTrendOverrideTests();
   //--- 2026-09-24, audit fixes (R5/R6): TEST1-5, same "runs once at startup, never fatal" convention.
   RunFillingModeAndTpDistanceTests();
   RunPostLossLockTests();
   RunEmaNeutralBlockerTests();
   //--- 2026-09-09, explicit operator request (EMA CONTINUATION/EXTENSION CLASSIFICATION): TEST1-10,
   //--- same "runs once at startup, never fatal" convention as every other self-test suite in this file.
   RunEmaEntryStateTests();
   RunBarConfirmationTests();

   //--- 2026-09-09, explicit operator request (PROFIT-TIER TRAILING SL - replaces the removed fixed
   //--- $5.00 instant profit cut): TEST1-17 (per the spec's own numbering, condensed where a single
   //--- assertion naturally covers multiple numbered cases), same "runs once at startup, never fatal"
   //--- convention as every other self-test suite in this file.
   RunProfitTierTrailingTests();

   //--- 2026-09-11, explicit operator request (execution-path observability gap - fix the silent-exit
   //--- gap found during the 2026-09-11 live investigation): TEST1-6, same "runs once at startup, never
   //--- fatal" convention as every other self-test suite in this file.
   RunExecutionObservabilityTests();

   //--- 2026-09-11, explicit operator request (ACTIVE_PING/EMA35 ARCHITECTURE REWIRE): TEST1-36 across the
   //--- new suite, same "runs once at startup, never fatal" convention as every other self-test suite in
   //--- this file.
   RunEma35ArchitectureTests();

   //--- 2026-09-15, explicit operator request (Trade History Session confirmation): deterministic
   //--- self-tests for the new entrySession field, same "runs once at startup, never fatal" convention.
   RunEntrySessionTests();

   //--- 2026-09-12, explicit operator request (TRADE MANAGEMENT ENGINE ARCHITECTURAL REPLACEMENT):
   //--- deterministic self-tests for the new engine, same "runs once at startup, never fatal"
   //--- convention as every other self-test suite in this file.
   RunTradeManagementEngineTests();

   //--- 2026-09-16, M5 PARALLEL PIPELINE: deterministic self-tests for the new M5 DNA/Minds pipeline,
   //--- BOTH-mode agreement gate, M5 Bar Confirmation, and the M1_ONLY-default-unchanged guarantee, same
   //--- "runs once at startup, never fatal" convention as every other self-test suite in this file.
   RunM5ParallelPipelineTests();

   return(INIT_SUCCEEDED);
  }

void OnDeinit(const int reason)
  {
   Comment("");
   //--- 2026-09-24, audit fix (C5): AcquireExecutionLock() (line ~17369) uses GlobalVariableSetOnCondition
   //--- on a terminal-wide GlobalVariableTemp - if the EA is removed/recompiled/crashes between acquiring
   //--- this lock (MaybeExecute()'s batch send, SubmitRetryTrade(), or the Reverse Fire block) and its own
   //--- matching ReleaseExecutionLock() call, the lock stays held at 1.0 for the rest of this terminal
   //--- session (GlobalVariableTemp only auto-clears on a full terminal close/restart, not on EA
   //--- reattach) - permanently blocking every future entry at MaybeExecute()'s own AcquireExecutionLock()
   //--- check, with no self-recovery path. ReleaseExecutionLock() is a plain GlobalVariableSet(...,0.0) -
   //--- confirmed idempotent/safe to call whether or not this instance currently holds the lock (setting
   //--- an already-0.0 variable to 0.0 is a no-op). Calling it unconditionally here guarantees a clean
   //--- EA removal/recompile/reattach cycle never leaves a stale lock behind, without risk of releasing a
   //--- lock a DIFFERENT still-running instance currently holds for a legitimate reason (this instance
   //--- would only ever hold it during the brief window between Acquire/Release inside a single
   //--- MaybeExecute()/SubmitRetryTrade()/EvaluateEarlySlWatcher() call, never across ticks).
   ReleaseExecutionLock();
  }

//====================================================================
// ONTICK - one full analysis cycle, runs on every incoming price tick
// (same cadence model as the live KMIE_Phase1_CompileTest.mq5 EA -
// no EventSetTimer/OnTimer anywhere in this file).
//====================================================================
void OnTick()
  {
   MqlRates rates[];
   ArraySetAsSeries(rates, true);
   //--- 2026-09-01, explicit operator request (PER-SESSION BAR-COUNT / LOOKBACK WINDOW):
   //--- effDnaLookback/effMindsLookback resolve to the CURRENT session's own bar-count inputs (0 =
   //--- fall back to the global Inp_MarketDNALookbackCandles/Inp_M1LookbackBars, per explicit
   //--- operator confirmation) - see ResolveEffectiveDnaLookback()/ResolveEffectiveMindsLookback()'s
   //--- own headers. Resolved ONCE here and reused below (both for sizing this CopyRates() fetch and
   //--- passed to EvaluateMarketDNA()) so the fetch size and DNA's own k computation can never
   //--- disagree mid-cycle on which session's window is active.
   int effDnaLookback = ResolveEffectiveDnaLookback();
   int effMindsLookback = ResolveEffectiveMindsLookback();
   int n = CopyRates(g_symbol, PERIOD_M1, 1, MathMax(effMindsLookback, effDnaLookback+1), rates);
   if(n < MathMax(5, effDnaLookback+1))
     {
      Comment("KMIE_MarketDNA_Lite: waiting for enough M1 history (", n, " bars so far)...");
      return;
     }

   RawFeatures f;
   ComputeRawFeatures(rates, n, f);

   //--- Stage 1: Market DNA (must run BEFORE Stage 2 - the Per-Mind Regime Filter reads g_dnaState)
   EvaluateMarketDNA(rates, n);

   //--- 2026-09-03, explicit operator request (Price/Pips Intelligence Foundation, Step 22 - real
   //--- XAUUSD validation): diagnostic-only, own independent throttle (g_priceRangeDnaLogLastTime),
   //--- writes to its own NEW file (price_range_dna.jsonl) - reads live rates via its own fresh
   //--- CopyRates() inside BuildMarketDnaWindow30(), never touches rates[]/n/f/g_dnaState/scores[]/
   //--- anything else in this cycle. Purely additive - deleting this one line returns the EA to
   //--- exactly its pre-Phase-1 behavior.
   LogPriceRangeDnaWindow();

   //--- Stage 2: 18-Mind Vote
   EvaluateMinds(rates, n, f);

   //--- 2026-09-16, M5 parallel pipeline (additive, Inp_DnaTimeframeMode-gated): in M1_ONLY mode this
   //--- entire block is skipped, so M1_ONLY behavior/timing/CopyRates-call-count is byte-identical to
   //--- pre-existing behavior. See Inp_DnaTimeframeMode's own input comment for mode semantics.
   //--- 2026-09-23, explicit operator request ("currently we are using the 25 Bars for M5 DNA and Minds
   //--- votes can you make 15 Bars with same dna and minds algo"): the M5 fetch now uses its OWN
   //--- dedicated Inp_M5DnaMindsLookbackBars (15) instead of reusing effMindsLookback/effDnaLookback
   //--- (the M1/session-driven values) - see that input's own header for the full rationale. Same DNA/
   //--- Minds algorithm either way, only the window size changed.
   if(Inp_DnaTimeframeMode != DNA_TF_M1_ONLY)
     {
      MqlRates ratesM5[];
      ArraySetAsSeries(ratesM5, true);
      int nM5 = CopyRates(g_symbol, PERIOD_M5, 1, Inp_M5DnaMindsLookbackBars, ratesM5);
      if(nM5 >= MathMin(5, Inp_M5DnaMindsLookbackBars))
        {
         RawFeatures fM5;
         ComputeRawFeatures(ratesM5, nM5, fM5);
         EvaluateMarketDnaM5(ratesM5, nM5);
         EvaluateMindsM5(ratesM5, nM5, fM5);
        }
      //--- else: not enough M5 history yet - g_dnaStateM5/g_mindsVoteDirM5 simply retain their last
      //--- values; in BOTH mode the agreement gate in MaybeExecute() naturally treats a WAIT vote/
      //--- direction as non-agreement, so this is not a silent trading-logic gap.
     }

   //--- 2026-09-23, M15 PARALLEL PIPELINE (additive, SAME Inp_DnaTimeframeMode!=DNA_TF_M1_ONLY gate the
   //--- M5 block above uses - M15 computes whenever M5 does; no new mode/gating input introduced for
   //--- "when M15 computes", per explicit task scope). Uses its OWN dedicated, fixed
   //--- Inp_M15DnaMindsLookbackBars (8) - never M1's/M5's own lookback logic.
   if(Inp_DnaTimeframeMode != DNA_TF_M1_ONLY)
     {
      MqlRates ratesM15[];
      ArraySetAsSeries(ratesM15, true);
      int nM15 = CopyRates(g_symbol, PERIOD_M15, 1, Inp_M15DnaMindsLookbackBars, ratesM15);
      if(nM15 >= MathMin(5, Inp_M15DnaMindsLookbackBars))
        {
         RawFeatures fM15;
         ComputeRawFeatures(ratesM15, nM15, fM15);
         EvaluateMarketDnaM15(ratesM15, nM15);
         EvaluateMindsM15(ratesM15, nM15, fM15);
        }
      //--- else: not enough M15 history yet - g_dnaStateM15/g_mindsVoteDirM15 simply retain their last
      //--- values; the 3-way agreement gate in MaybeExecute() naturally treats a WAIT vote/direction as
      //--- non-agreement, so this is not a silent trading-logic gap.
     }

   //--- 2026-08-29, explicit operator request: per-tick Minds detail log (minds_detail.jsonl) - added
   //--- specifically to support a real Mind-to-Mind correlation audit (agreement %, pairwise vote/score
   //--- correlation, clustering, effective independent vote count, how often 9+ votes occur because of
   //--- one dominant cluster). Purely additive/observational, own throttle (g_mindsLogLastTime, see its
   //--- own header comment for why it can't reuse g_dnaCalibLogLastTime), gated by the SAME
   //--- Inp_DashboardLogEnabled flag as every other dashboard log. Does not read or write anything used
   //--- by classification, Entry Approval, Opportunity Lifecycle, Trend-C, re-fire, execution, or TP/SL -
   //--- this block only ever calls DashAppendLine(), never anything that feeds back into a trading
   //--- decision. Reuses DashMindsJsonArray() (the SAME serializer trades.jsonl's sparse close-time
   //--- snapshot and live_signal.json already use) so all 14 active Minds' id/name/direction/score/
   //--- reasoning are captured with zero new per-Mind field definitions. Risk (#5) and Pressure (#10)
   //--- no longer appear here at all (real removal, 2026-08-29) - each row now reflects exactly the
   //--- 14 Minds currently in g_minds[], keyed by their historical .id, matching the live EA state.
   if(Inp_DashboardLogEnabled && TimeCurrent()!=g_mindsLogLastTime)
     {
      g_mindsLogLastTime = TimeCurrent();
      string mindsLine = StringFormat(
         "{\"time\":\"%s\",\"symbol\":\"%s\",\"timeframe\":\"M1\","
         "\"buyVotes\":%d,\"sellVotes\":%d,\"waitVotes\":%d,\"mindsVoteDir\":\"%s\","
         "\"dnaState\":\"%s\",\"dnaScore\":%.2f,\"minds\":%s}",
         DashIsoTime(TimeCurrent()), g_symbol,
         g_buyVotes, g_sellVotes, g_waitVotes, DirName(g_mindsVoteDir),
         DnaName(g_dnaState), g_dnaScore, DashMindsJsonArray(n));
      DashAppendLine("minds_detail.jsonl", mindsLine);
     }

   //--- Entry Intelligence Step 1: Active Leg + Pullback Extreme. Observational only - runs after
   //--- the current direction (g_mindsVoteDir) and current price (g_ci) are available, does not
   //--- gate or alter MaybeExecute()/SendMarketOrder()/OrderSend() in any way.
   EvaluateEntryIntelligence();

   //--- Entry Intelligence Step 2: Resumption % + 80% window. Observational only - consumes Step 1's
   //--- Active Leg/Pullback Extreme state, does not gate or alter MaybeExecute() in any way.
   EvaluateResumption();

   //--- Entry Intelligence Step 3: Micro Resumption. Observational only - consumes Step 1/Step 2
   //--- state, does not gate or alter MaybeExecute() in any way.
   EvaluateMicroResumption();

   //--- Entry Intelligence Step 4: Opportunity Lifecycle. Observational only - consumes Step 1/2/3
   //--- state, does not gate or alter MaybeExecute() in any way.
   EvaluateOpportunityLifecycle();

   //--- Entry Intelligence Step 5: Extension Engine. Observational only - independent of Steps 2-4,
   //--- does not gate or alter MaybeExecute() in any way.
   EvaluateExtension();

   //--- 2026-09-03, explicit operator request (ACTIVE_PING ARCHITECTURE): evaluated ONCE per UNIQUE
   //--- CLOSED M1 bar. Must run BEFORE Step 6 (EvaluateEntryApproval(), immediately below) since that
   //--- function now reads g_activePing.active to replace the old OPPORTUNITY_CONSUMED gate. A tick
   //--- that is NOT a new closed bar simply reuses the LAST computed g_activePing value - it is never
   //--- reset/cleared mid-bar, so Entry Approval always has a well-defined reading even on ticks 2..N
   //--- of the current bar.
   //--- 2026-09-03, LATCH-KEY FIX (explicit operator request, live-validation Gap 2 - "duplicate
   //--- closed-bar evaluation... DEFECT CONFIRMED"): the latch used to key off iTime(g_symbol,
   //--- PERIOD_M1, 0) - the CURRENTLY-FORMING (running) bar's own open time - while the payload this
   //--- gate actually protects (EvaluateActivePing()'s own g_activePing.barTime, via ITS OWN separate
   //--- CopyRates(...,1,...) call) is the CLOSED bar. These are two different reads of the terminal's
   //--- price-series cache that usually move together but are not guaranteed atomic - live evidence
   //--- (two same-session duplicate active_ping.jsonl writes, ~10-30s apart, no EA restart between
   //--- them) proved iTime(...,0) can report an extra/inconsistent value without the closed-bar series
   //--- actually changing, causing this gate to re-fire and RunActivePingTests()-verified-correct
   //--- classification to be recomputed/re-logged twice for the identical bar. Fixed by keying the
   //--- latch on rates[0].time instead - the SAME already-fetched CLOSED-bar array (CopyRates(g_symbol,
   //--- PERIOD_M1, 1, ..., rates) at the top of this function) that EvaluateActivePing() itself
   //--- independently re-derives via its own identical shift-1 CopyRates call (same symbol/timeframe/
   //--- shift - guaranteed to resolve to the same terminal-side closed candle at any given tick, so
   //--- there is zero ambiguity that rates[0].time IS the candle ACTIVE_PING evaluates). This is the
   //--- EXACT same pattern g_dashLastBarTime (line ~3444) already uses for the identical reason -
   //--- "if(n>0 && rates[0].time!=g_dashLastBarTime)" - not a new/independently-invented mechanism.
   //--- Pure comparison-source swap: no corridor/slope math, no threshold, no gate condition, no
   //--- OPP_CONSUMED wiring, and no other trading logic touched by this change.
   if(n>0 && rates[0].time != g_activePingLastBarTime)
     {
      g_activePingLastBarTime = rates[0].time;
      g_activePing = EvaluateActivePing();
      LogActivePing(g_activePing);
     }

   //--- 2026-09-14, explicit operator request (ACTIVE_PING CROSSING-BASED DIRECTION): called EVERY tick,
   //--- unconditionally (unlike EvaluateActivePing() above, which only runs once per new closed bar) -
   //--- this is a genuinely per-tick, event-driven check for a live price crossing, not a once-per-bar
   //--- recompute. See EvaluateActivePingCrossingDirection()'s own header for the full design.
   EvaluateActivePingCrossingDirection();

   //--- 2026-09-16, explicit operator request (ACTIVE_PING SIMPLIFIED TO EMA20/50): called EVERY tick,
   //--- unconditionally, immediately after EvaluateActivePingCrossingDirection() above (same cadence) -
   //--- reads THIS cycle's already-populated g_activePing.ema20/ema50 (set by EvaluateActivePing() just
   //--- above) to detect a live both-EMAs price cross. See EvaluateEma2050CrossActive()'s own header.
   EvaluateEma2050CrossActive();
   //--- Layers the live per-tick crossing flag on top of the once-per-closed-bar corridor baseline
   //--- EvaluateActivePing() just set g_activePing.active to (r.corridorActive - see that function's own
   //--- updated formula/header). A genuine cross this tick makes ACTIVE_PING active even on a tick where
   //--- price is not currently inside the corridor - matches the operator's own "OR" framing exactly
   //--- ("EMA slope 20 between 50... OR... crossing both EMA... all should be comes under Active Ping").
   if(g_ema2050CrossedThisTick) g_activePing.active = true;

   //--- Entry Intelligence Step 6: Entry Approval Engine. Observation only - combines Steps 1-5's
   //--- own state into an APPROVED/BLOCKED reading. NOT connected to MaybeExecute() in any way.
   EvaluateEntryApproval();

   //--- Dashboard JSON log - pure file I/O for the Gold Trading Dashboard
   //--- web app. Runs regardless of Inp_ExecutionEnabled (dashboard should
   //--- still see live ticks/Market DNA/Mind Vote in dry-run/observation
   //--- mode); never reads back into, or alters, anything above.
   UpdateDashboardLogs(rates, n);

   RenderDashboard(n);

   if(Inp_ExecutionEnabled)
      MaybeExecute();

   //--- Step 9: native structural SL / break-even / trailing management for this EA's own open
   //--- positions. Completely separate from Entry Intelligence above - runs regardless of this
   //--- cycle's direction/vote/opportunity state, gated only by the same master execution switch.
   if(Inp_ExecutionEnabled)
      ManageOpenPositions();

   //--- 2026-08-31, explicit operator request (RETRY TRADE ENGINE): called as its OWN sibling step,
   //--- deliberately NOT nested inside MaybeExecute() - MaybeExecute() has several early-return gates
   //--- (WAIT direction, regime blocked, position already open, below Inp_MindsVoteMinCount, Entry
   //--- Approval blocked) that would silently prevent this call from ever running on most ticks if it
   //--- were placed inside that function. Runs AFTER ManageOpenPositions() (which, via
   //--- CleanupTrailingSlots()->RegisterRetryCandidate(), is what arms g_retryEngine THIS SAME tick
   //--- when a tracked position has just closed) so a candidate armed this cycle is visible
   //--- immediately, never one tick late. Gated by the SAME master execution switch as
   //--- MaybeExecute()/ManageOpenPositions() - a genuinely independent path, but not an unsafe one.
   if(Inp_ExecutionEnabled)
      EvaluateRetryTrade();

   g_prevNetMove = g_curNetMove30; // Memory Mind's own 30-bar read, stored for next cycle's comparison
   g_prevAbsorptionStreak = g_curAbsorptionStreak; // Absorption Mind's own persistence counter, stored for next cycle's comparison
   g_prevAbsorptionStreakM5 = g_curAbsorptionStreakM5; // M5 Absorption Mind's own persistence counter, stored for next cycle's comparison
  }

//====================================================================
// RAW FEATURE EXTRACTION (shared by all 18 Minds)
//====================================================================
void ComputeRawFeatures(const MqlRates &rates[], const int n, RawFeatures &f)
  {
   f.ups=0; f.downs=0;
   double sumRange=0, sumBodyPct=0, sumUpperWickPct=0, sumLowerWickPct=0;
   f.highestHigh = rates[0].high; f.lowestLow = rates[0].low;
   f.highestHighExclLast = -DBL_MAX; f.lowestLowExclLast = DBL_MAX;

   for(int i=0;i<n;i++)
     {
      double range = rates[i].high - rates[i].low;
      if(range<=0.0) range = _Point;
      double body = MathAbs(rates[i].close - rates[i].open);
      double upperWick = rates[i].high - MathMax(rates[i].open, rates[i].close);
      double lowerWick = MathMin(rates[i].open, rates[i].close) - rates[i].low;

      sumRange += range;
      sumBodyPct += (body/range)*100.0;
      sumUpperWickPct += (upperWick/range)*100.0;
      sumLowerWickPct += (lowerWick/range)*100.0;

      if(rates[i].close>rates[i].open) f.ups++;
      else if(rates[i].close<rates[i].open) f.downs++;

      if(rates[i].high>f.highestHigh) f.highestHigh=rates[i].high;
      if(rates[i].low<f.lowestLow)     f.lowestLow=rates[i].low;

      if(i>0)
        {
         if(rates[i].high>f.highestHighExclLast) f.highestHighExclLast=rates[i].high;
         if(rates[i].low<f.lowestLowExclLast)     f.lowestLowExclLast=rates[i].low;
        }
     }

   f.avgRange = sumRange/n;
   f.lastRange = rates[0].high-rates[0].low; if(f.lastRange<=0.0) f.lastRange=_Point;
   f.avgBodyPct = sumBodyPct/n;
   double lastBody = MathAbs(rates[0].close-rates[0].open);
   f.lastBodyPct = (lastBody/f.lastRange)*100.0;
   f.avgUpperWickPct = sumUpperWickPct/n;
   f.avgLowerWickPct = sumLowerWickPct/n;
   f.lastUpperWickPct = ((rates[0].high-MathMax(rates[0].open,rates[0].close))/f.lastRange)*100.0;
   f.lastLowerWickPct = ((MathMin(rates[0].open,rates[0].close)-rates[0].low)/f.lastRange)*100.0;

   f.netMove = rates[0].close - rates[n-1].close;

   int shortK = MathMin(5, n-1);
   f.shortSlope = (shortK>0) ? (rates[0].close - rates[shortK].close) : 0.0;
   f.longSlope  = f.netMove;
  }

//====================================================================
// STAGE 2: 15-MIND VOTE (fresh, self-contained)
//====================================================================
ENUM_LITE_DIR SignOf(const double v){ return v>0.0?LDIR_BUY:(v<0.0?LDIR_SELL:LDIR_WAIT); }
double Clamp0to100(const double v){ return v<0.0?0.0:(v>100.0?100.0:v); }

//--- Seeds a `period`-bar SMA at the oldest end of the [endOffset, endOffset+period+lookbackPad]
//--- window inside `rates` (series-indexed, index 0 = newest), then walks the standard recursive
//--- EMA formula forward toward index 0, returning the EMA value at series-index `endOffset`.
//--- `rates`/`n` are read-only; this performs no CopyRates of its own, reusing whatever window the
//--- caller already fetched. Declared BEFORE EvaluateEmaTrendMind() (its only caller), matching
//--- MQL5's declare-before-use requirement.
double EmaAt(const MqlRates &rates[], const int n, const int period, const int endOffset, const double alpha)
  {
   int seedStart = n - 1; // oldest available bar in the window
   int seedEnd = seedStart - period + 1;
   if(seedEnd < endOffset) seedEnd = endOffset; // guard: never seed past the requested end point
   // MQL5 has no EMPTY_VALUE constant (that's an MQL4-ism) - a runtime-computed NaN (via a
   // zero-valued double divided by itself, never a literal 0.0/0.0 which some compilers flag as a
   // constant divide-by-zero) is what MathIsValidNumber() (used by every caller of this function)
   // correctly rejects.
   if(seedEnd < 0 || seedStart >= n || seedStart < seedEnd)
     {
      double zero = 0.0;
      return zero / zero;
     }

   double sma = 0.0;
   for(int i = seedEnd; i <= seedStart; i++) sma += rates[i].close;
   sma /= (seedStart - seedEnd + 1);

   double ema = sma;
   for(int i = seedEnd - 1; i >= endOffset; i--)
      ema = (rates[i].close - ema) * alpha + ema;
   return ema;
  }

//--- 2026-08-30, explicit operator request (ADD NEW MTF ALIGNMENT MIND). Evaluates ONE timeframe's
//--- own EMA20/EMA50/slope direction, reusing EmaAt() above (same helper the EMA Trend Mind uses) -
//--- no duplicate EMA implementation. Returns LDIR_BUY/LDIR_SELL/LDIR_WAIT via the SAME rule as the
//--- EMA Trend Mind's own BUY/SELL conditions (EMA20 vs EMA50 direction confirmed by slope
//--- direction), but WITHOUT the ATR-normalization gate - the MTF Mind's spec (section 8) has no ATR
//--- requirement of its own; ATR-gating stays exclusively EMA Trend Mind's responsibility, never
//--- duplicated here. `tf`/`tfLabel` are only used to build the diagnostic reasoning string (e.g.
//--- "M1=BUY(20.451/20.398)"); `emaFastOut`/`emaSlowOut`/`slopeOut` return the raw values so the
//--- caller (EvaluateMtfAlignmentMind) can build ONE combined reasoning string covering all three
//--- timeframes, rather than three separate un-correlated reasoning fragments.
ENUM_LITE_DIR EvaluateTimeframeEmaDirection(const ENUM_TIMEFRAMES tf, const string tfLabel,
                                             double &emaFastOut, double &emaSlowOut, double &slopeOut,
                                             string &detailOut)
  {
   emaFastOut = 0.0; emaSlowOut = 0.0; slopeOut = 0.0;
   if(Inp_MTFEmaFastPeriod < 1 || Inp_MTFEmaSlowPeriod < 1 || Inp_MTFEmaFastPeriod >= Inp_MTFEmaSlowPeriod)
     {
      detailOut = tfLabel + "=WAIT(invalid periods)";
      return LDIR_WAIT;
     }

   const int slopeLookback = MathMax(0, Inp_MTFEmaSlopeLookback);
   // Same generous warm-up budget rationale as EvaluateEmaTrendMind() - slow-EMA seed window PLUS
   // slope lookback PLUS a small safety pad. No ATR term here (MTF has none), so no +atrPeriod.
   const int needed = Inp_MTFEmaSlowPeriod + slopeLookback + 5;

   // CLOSED candles only, on THIS specific timeframe - CopyRates(...,1,...) starts at index 1,
   // i.e. the first bar AFTER the currently-forming one on `tf`, exactly matching the file's
   // existing closed-candle convention (see every other CopyRates(...,1,...) call in this file).
   // This is the mechanism that guarantees a forming M15 candle can NEVER influence this Mind
   // (validation Test 9) - CopyRates(tf,1,...) simply never returns the still-open bar.
   MqlRates ratesTf[]; ArraySetAsSeries(ratesTf, true);
   int nTf = CopyRates(g_symbol, tf, 1, needed, ratesTf);
   if(nTf < needed)
     {
      detailOut = tfLabel + "=WAIT(insufficient history " + IntegerToString(nTf) + "/" + IntegerToString(needed) + ")";
      return LDIR_WAIT;
     }

   double alphaFast = 2.0 / (Inp_MTFEmaFastPeriod + 1.0);
   double emaFastNow  = EmaAt(ratesTf, nTf, Inp_MTFEmaFastPeriod, 0, alphaFast);
   double emaFastPrev = EmaAt(ratesTf, nTf, Inp_MTFEmaFastPeriod, slopeLookback, alphaFast);
   double alphaSlow = 2.0 / (Inp_MTFEmaSlowPeriod + 1.0);
   double emaSlowNow  = EmaAt(ratesTf, nTf, Inp_MTFEmaSlowPeriod, 0, alphaSlow);

   if(!MathIsValidNumber(emaFastNow) || !MathIsValidNumber(emaFastPrev) || !MathIsValidNumber(emaSlowNow))
     {
      detailOut = tfLabel + "=WAIT(invalid EMA)";
      return LDIR_WAIT;
     }

   emaFastOut = emaFastNow; emaSlowOut = emaSlowNow; slopeOut = emaFastNow - emaFastPrev;
   double gap = emaFastNow - emaSlowNow;

   if(gap > 0.0 && slopeOut > 0.0)
     {
      detailOut = StringFormat("%s=BUY(%.3f/%.3f slope=%.5f)", tfLabel, emaFastNow, emaSlowNow, slopeOut);
      return LDIR_BUY;
     }
   if(gap < 0.0 && slopeOut < 0.0)
     {
      detailOut = StringFormat("%s=SELL(%.3f/%.3f slope=%.5f)", tfLabel, emaFastNow, emaSlowNow, slopeOut);
      return LDIR_SELL;
     }
   detailOut = StringFormat("%s=WAIT(%.3f/%.3f slope=%.5f)", tfLabel, emaFastNow, emaSlowNow, slopeOut);
   return LDIR_WAIT;
  }

//--- 2026-08-30, explicit operator request (ADD NEW MTF ALIGNMENT MIND). Writes ONE Mind result
//--- into g_minds[15] (id 17). STRICT 3/3 rule per explicit spec (section 9) - BUY only when M1,
//--- M5, AND M15 are ALL independently BUY (via EvaluateTimeframeEmaDirection above); SELL only
//--- when all three are ALL independently SELL; every other combination (including a 2/3 majority)
//--- is WAIT by design - this Mind's purpose is confirmation/alignment, not majority voting. M1/M5/
//--- M15 are internal calculations ONLY - they are never written to g_minds[] themselves and never
//--- receive their own vote (validation Test 18); exactly one vote is cast, by this Mind.
void EvaluateMtfAlignmentMind()
  {
   const int slot = 15; // g_minds[] array position for this Mind (id 17)
   g_minds[slot].id = 17;
   g_minds[slot].name = "MTF Alignment";

   if(!Inp_MTFAlignmentEnabled)
     {
      g_minds[slot].direction = LDIR_WAIT; g_minds[slot].score = 0.0;
      g_minds[slot].reasoning = "Inp_MTFAlignmentEnabled=false";
      return;
     }

   double m1Fast, m1Slow, m1Slope, m5Fast, m5Slow, m5Slope, m15Fast, m15Slow, m15Slope;
   string m1Detail, m5Detail, m15Detail;
   ENUM_LITE_DIR dirM1  = EvaluateTimeframeEmaDirection(PERIOD_M1,  "M1",  m1Fast,  m1Slow,  m1Slope,  m1Detail);
   ENUM_LITE_DIR dirM5  = EvaluateTimeframeEmaDirection(PERIOD_M5,  "M5",  m5Fast,  m5Slow,  m5Slope,  m5Detail);
   ENUM_LITE_DIR dirM15 = EvaluateTimeframeEmaDirection(PERIOD_M15, "M15", m15Fast, m15Slow, m15Slope, m15Detail);

   // Alignment score - ALIGNMENT QUALITY, not probability, not an extra vote (section 12): how
   // many of the 3 timeframes agree with EACH OTHER (the majority side among the 3), scaled to the
   // existing 0-100 convention via Clamp0to100(). Computed and stored regardless of final direction
   // (a 2/3 conflicting case still reports a real score, e.g. 66.7, while direction stays WAIT -
   // matching the explicit example in section 25).
   int buyCount = (dirM1==LDIR_BUY?1:0) + (dirM5==LDIR_BUY?1:0) + (dirM15==LDIR_BUY?1:0);
   int sellCount = (dirM1==LDIR_SELL?1:0) + (dirM5==LDIR_SELL?1:0) + (dirM15==LDIR_SELL?1:0);
   int alignmentCount = MathMax(buyCount, sellCount);
   double score = Clamp0to100((alignmentCount / 3.0) * 100.0);

   string combined = m1Detail + " " + m5Detail + " " + m15Detail;

   if(dirM1==LDIR_BUY && dirM5==LDIR_BUY && dirM15==LDIR_BUY)
     {
      g_minds[slot].direction = LDIR_BUY; g_minds[slot].score = score;
      g_minds[slot].reasoning = StringFormat("MTF Alignment: M1=BUY M5=BUY M15=BUY alignment=3/3 | %s", combined);
      return;
     }
   if(dirM1==LDIR_SELL && dirM5==LDIR_SELL && dirM15==LDIR_SELL)
     {
      g_minds[slot].direction = LDIR_SELL; g_minds[slot].score = score;
      g_minds[slot].reasoning = StringFormat("MTF Alignment: M1=SELL M5=SELL M15=SELL alignment=3/3 | %s", combined);
      return;
     }

   g_minds[slot].direction = LDIR_WAIT; g_minds[slot].score = score;
   string reasonTag = (dirM1==LDIR_WAIT || dirM5==LDIR_WAIT || dirM15==LDIR_WAIT)
                       ? "INSUFFICIENT/INVALID HIGHER-TIMEFRAME DATA" : "TIMEFRAME CONFLICT";
   g_minds[slot].reasoning = StringFormat("MTF Alignment: M1=%s M5=%s M15=%s alignment=%d/3 reason=%s | %s",
         DirName(dirM1), DirName(dirM5), DirName(dirM15), alignmentCount, reasonTag, combined);
  }

//--- 2026-09-16, M5 PARALLEL PIPELINE: duplicate of EvaluateMtfAlignmentMind() above, writing into
//--- g_mindsM5[15] instead of g_minds[15]. EvaluateTimeframeEmaDirection() is already parametrized on
//--- timeframe (called here with the SAME PERIOD_M1/M5/M15 triple, unchanged) - this Mind is
//--- inherently cross-timeframe by design, so its M5 twin reuses the identical 3-way check, only the
//--- result-wiring target differs.
void EvaluateMtfAlignmentMindM5()
  {
   const int slot = 15;
   g_mindsM5[slot].id = 17;
   g_mindsM5[slot].name = "MTF Alignment";

   if(!Inp_MTFAlignmentEnabled)
     {
      g_mindsM5[slot].direction = LDIR_WAIT; g_mindsM5[slot].score = 0.0;
      g_mindsM5[slot].reasoning = "Inp_MTFAlignmentEnabled=false";
      return;
     }

   double m1Fast, m1Slow, m1Slope, m5Fast, m5Slow, m5Slope, m15Fast, m15Slow, m15Slope;
   string m1Detail, m5Detail, m15Detail;
   ENUM_LITE_DIR dirM1  = EvaluateTimeframeEmaDirection(PERIOD_M1,  "M1",  m1Fast,  m1Slow,  m1Slope,  m1Detail);
   ENUM_LITE_DIR dirM5  = EvaluateTimeframeEmaDirection(PERIOD_M5,  "M5",  m5Fast,  m5Slow,  m5Slope,  m5Detail);
   ENUM_LITE_DIR dirM15 = EvaluateTimeframeEmaDirection(PERIOD_M15, "M15", m15Fast, m15Slow, m15Slope, m15Detail);

   int buyCount = (dirM1==LDIR_BUY?1:0) + (dirM5==LDIR_BUY?1:0) + (dirM15==LDIR_BUY?1:0);
   int sellCount = (dirM1==LDIR_SELL?1:0) + (dirM5==LDIR_SELL?1:0) + (dirM15==LDIR_SELL?1:0);
   int alignmentCount = MathMax(buyCount, sellCount);
   double score = Clamp0to100((alignmentCount / 3.0) * 100.0);

   string combined = m1Detail + " " + m5Detail + " " + m15Detail;

   if(dirM1==LDIR_BUY && dirM5==LDIR_BUY && dirM15==LDIR_BUY)
     {
      g_mindsM5[slot].direction = LDIR_BUY; g_mindsM5[slot].score = score;
      g_mindsM5[slot].reasoning = StringFormat("MTF Alignment: M1=BUY M5=BUY M15=BUY alignment=3/3 | %s", combined);
      return;
     }
   if(dirM1==LDIR_SELL && dirM5==LDIR_SELL && dirM15==LDIR_SELL)
     {
      g_mindsM5[slot].direction = LDIR_SELL; g_mindsM5[slot].score = score;
      g_mindsM5[slot].reasoning = StringFormat("MTF Alignment: M1=SELL M5=SELL M15=SELL alignment=3/3 | %s", combined);
      return;
     }

   g_mindsM5[slot].direction = LDIR_WAIT; g_mindsM5[slot].score = score;
   string reasonTagM5 = (dirM1==LDIR_WAIT || dirM5==LDIR_WAIT || dirM15==LDIR_WAIT)
                       ? "INSUFFICIENT/INVALID HIGHER-TIMEFRAME DATA" : "TIMEFRAME CONFLICT";
   g_mindsM5[slot].reasoning = StringFormat("MTF Alignment: M1=%s M5=%s M15=%s alignment=%d/3 reason=%s | %s",
         DirName(dirM1), DirName(dirM5), DirName(dirM15), alignmentCount, reasonTagM5, combined);
  }

//--- 2026-09-23, M15 PARALLEL PIPELINE: duplicate of EvaluateMtfAlignmentMind()/EvaluateMtfAlignmentMindM5()
//--- above, writing into g_mindsM15[15] instead of g_minds[15]/g_mindsM5[15]. This is the M15-CONTEXT
//--- version of the MTF Alignment Mind for the new M15 18-Mind vote pipeline - a SEPARATE thing from the
//--- pre-existing EvaluateTimeframeEmaDirection(PERIOD_M15,"M15",...) call already used INSIDE the M1 (and
//--- M5) versions of this Mind for their own cross-timeframe alignment score; that existing usage is left
//--- completely untouched. EvaluateTimeframeEmaDirection() is already parametrized on timeframe (called
//--- here with the SAME PERIOD_M1/M5/M15 triple, unchanged) - this Mind is inherently cross-timeframe by
//--- design, so its M15 twin reuses the identical 3-way check, only the result-wiring target differs.
void EvaluateMtfAlignmentMindM15()
  {
   const int slot = 15;
   g_mindsM15[slot].id = 17;
   g_mindsM15[slot].name = "MTF Alignment";

   if(!Inp_MTFAlignmentEnabled)
     {
      g_mindsM15[slot].direction = LDIR_WAIT; g_mindsM15[slot].score = 0.0;
      g_mindsM15[slot].reasoning = "Inp_MTFAlignmentEnabled=false";
      return;
     }

   double m1Fast, m1Slow, m1Slope, m5Fast, m5Slow, m5Slope, m15Fast, m15Slow, m15Slope;
   string m1Detail, m5Detail, m15Detail;
   ENUM_LITE_DIR dirM1  = EvaluateTimeframeEmaDirection(PERIOD_M1,  "M1",  m1Fast,  m1Slow,  m1Slope,  m1Detail);
   ENUM_LITE_DIR dirM5  = EvaluateTimeframeEmaDirection(PERIOD_M5,  "M5",  m5Fast,  m5Slow,  m5Slope,  m5Detail);
   ENUM_LITE_DIR dirM15 = EvaluateTimeframeEmaDirection(PERIOD_M15, "M15", m15Fast, m15Slow, m15Slope, m15Detail);

   int buyCount = (dirM1==LDIR_BUY?1:0) + (dirM5==LDIR_BUY?1:0) + (dirM15==LDIR_BUY?1:0);
   int sellCount = (dirM1==LDIR_SELL?1:0) + (dirM5==LDIR_SELL?1:0) + (dirM15==LDIR_SELL?1:0);
   int alignmentCount = MathMax(buyCount, sellCount);
   double score = Clamp0to100((alignmentCount / 3.0) * 100.0);

   string combined = m1Detail + " " + m5Detail + " " + m15Detail;

   if(dirM1==LDIR_BUY && dirM5==LDIR_BUY && dirM15==LDIR_BUY)
     {
      g_mindsM15[slot].direction = LDIR_BUY; g_mindsM15[slot].score = score;
      g_mindsM15[slot].reasoning = StringFormat("MTF Alignment: M1=BUY M5=BUY M15=BUY alignment=3/3 | %s", combined);
      return;
     }
   if(dirM1==LDIR_SELL && dirM5==LDIR_SELL && dirM15==LDIR_SELL)
     {
      g_mindsM15[slot].direction = LDIR_SELL; g_mindsM15[slot].score = score;
      g_mindsM15[slot].reasoning = StringFormat("MTF Alignment: M1=SELL M5=SELL M15=SELL alignment=3/3 | %s", combined);
      return;
     }

   g_mindsM15[slot].direction = LDIR_WAIT; g_mindsM15[slot].score = score;
   string reasonTagM15 = (dirM1==LDIR_WAIT || dirM5==LDIR_WAIT || dirM15==LDIR_WAIT)
                       ? "INSUFFICIENT/INVALID HIGHER-TIMEFRAME DATA" : "TIMEFRAME CONFLICT";
   g_mindsM15[slot].reasoning = StringFormat("MTF Alignment: M1=%s M5=%s M15=%s alignment=%d/3 reason=%s | %s",
         DirName(dirM1), DirName(dirM5), DirName(dirM15), alignmentCount, reasonTagM15, combined);
  }

//--- 2026-08-30, explicit operator request (ADD EMA 20/50 SLOPE TREND MIND). Computes EMA20,
//--- EMA50, EMA20 slope, and ATR - all hand-rolled from a dedicated CopyRates window over
//--- g_symbol/PERIOD_M1, CLOSED candles only (index 1..n, never index 0 - the running/forming
//--- candle - matching this function's own "1" start offset in every CopyRates(...,1,...) call
//--- elsewhere in the file). Writes ONE Mind result into g_minds[14] (id 16). ATR is used purely
//--- as an internal normalization input here - it is NEVER written into any other g_minds[] slot
//--- and never contributes its own vote, satisfying the explicit "ATR is not a Mind" requirement.
//---
//--- EMA method: standard recursive EMA (seeded with a SMA of the first `period` closes, then
//--- walked forward bar-by-bar with alpha=2/(period+1)) computed over the SAME closed-candle
//--- window for both the "current" value (ending at the newest closed bar) and, when
//--- Inp_EMASlopeLookback>0, a second EMA20 series ending Inp_EMASlopeLookback bars earlier, so
//--- the slope compares two independently-seeded-and-walked EMA20 readings rather than reading
//--- back into a cached array (there is no persistent EMA state in this file to reuse, matching
//--- its existing self-contained-math style).
//---
//--- ATR method: classic N-period ATR (mean of True Range over the last `period` closed bars,
//--- TR = max(high-low, |high-prevClose|, |low-prevClose|)), period fixed at 14 (the universal ATR
//--- default) since the task specifies ATR only as a normalization input, not a separately
//--- configurable Mind.
void EvaluateEmaTrendMind()
  {
   const int slot = 14; // g_minds[] array position for this Mind (id 16)
   g_minds[slot].id = 16;
   g_minds[slot].name = "EMA Trend";

   if(!Inp_EMATrendEnabled)
     {
      g_minds[slot].direction = LDIR_WAIT; g_minds[slot].score = 0.0;
      g_minds[slot].reasoning = "Inp_EMATrendEnabled=false";
      return;
     }
   if(Inp_EMAFastPeriod < 1 || Inp_EMASlowPeriod < 1 || Inp_EMAFastPeriod >= Inp_EMASlowPeriod)
     {
      g_minds[slot].direction = LDIR_WAIT; g_minds[slot].score = 0.0;
      g_minds[slot].reasoning = StringFormat("invalid EMA periods (fast=%d slow=%d)", Inp_EMAFastPeriod, Inp_EMASlowPeriod);
      return;
     }

   const int atrPeriod = 14; // classic ATR default - see header comment above
   const int slopeLookback = MathMax(0, Inp_EMASlopeLookback);
   // Warm-up budget: the slow EMA needs Inp_EMASlowPeriod closed bars to seed its own SMA, PLUS
   // slopeLookback extra bars so the "prior" EMA20 reading (for the slope) also has a full
   // Inp_EMAFastPeriod-bar seed available, PLUS one more bar so ATR's own prevClose lookback never
   // runs off the end of the array. Deliberately generous, never trimmed to the bare minimum.
   const int needed = Inp_EMASlowPeriod + slopeLookback + atrPeriod + 5;

   MqlRates ratesEma[]; ArraySetAsSeries(ratesEma, true);
   int nEma = CopyRates(g_symbol, PERIOD_M1, 1, needed, ratesEma); // index 1 = first CLOSED candle, never the running one
   if(nEma < needed)
     {
      g_minds[slot].direction = LDIR_WAIT; g_minds[slot].score = 0.0;
      g_minds[slot].reasoning = StringFormat("insufficient closed-candle history (have=%d need=%d)", nEma, needed);
      return;
     }

   // ratesEma is series-indexed (index 0 = newest CLOSED candle, matching every other Mind's
   // CopyRates window in this file). EmaAt(period, endOffset) seeds a period-bar SMA at the OLDEST
   // end of the requested window, then walks forward (toward index 0) applying the standard
   // recursive EMA formula, returning the value at series-index `endOffset` (0 = ending at the
   // newest closed bar, slopeLookback = ending slopeLookback bars earlier).
   double alphaFastCache = 2.0 / (Inp_EMAFastPeriod + 1.0);
   double emaFastNow  = EmaAt(ratesEma, nEma, Inp_EMAFastPeriod, 0, alphaFastCache);
   double emaFastPrev = EmaAt(ratesEma, nEma, Inp_EMAFastPeriod, slopeLookback, alphaFastCache);
   double alphaSlowCache = 2.0 / (Inp_EMASlowPeriod + 1.0);
   double emaSlowNow  = EmaAt(ratesEma, nEma, Inp_EMASlowPeriod, 0, alphaSlowCache);

   if(!MathIsValidNumber(emaFastNow) || !MathIsValidNumber(emaFastPrev) || !MathIsValidNumber(emaSlowNow))
     {
      g_minds[slot].direction = LDIR_WAIT; g_minds[slot].score = 0.0;
      g_minds[slot].reasoning = "invalid EMA values";
      return;
     }

   // Classic N-period ATR (mean True Range), computed over the same closed-candle window.
   double atr = 0.0;
   int atrSamples = 0;
   for(int i = 0; i < atrPeriod && (i+1) < nEma; i++)
     {
      double highLow  = ratesEma[i].high - ratesEma[i].low;
      double highPrev = MathAbs(ratesEma[i].high - ratesEma[i+1].close);
      double lowPrev  = MathAbs(ratesEma[i].low  - ratesEma[i+1].close);
      double tr = MathMax(highLow, MathMax(highPrev, lowPrev));
      atr += tr; atrSamples++;
     }
   if(atrSamples > 0) atr /= atrSamples;

   if(atrSamples < atrPeriod || !MathIsValidNumber(atr) || atr <= 0.0)
     {
      g_minds[slot].direction = LDIR_WAIT; g_minds[slot].score = 0.0;
      g_minds[slot].reasoning = StringFormat("ATR invalid or unavailable (samples=%d atr=%.5f)", atrSamples, atr);
      return;
     }

   double gap = emaFastNow - emaSlowNow;
   double normalizedGap = MathAbs(gap) / atr;
   double emaSlope = emaFastNow - emaFastPrev;

   // Score: EMA Trend strength, NOT an extra vote (direction/score kept strictly separate per
   // explicit requirement) - normalizedGap expressed as a percentage of a 3.0x-ATR reference range,
   // clamped into this file's existing 0-100 score convention via the same Clamp0to100() every
   // other Mind already uses. 3.0x is a conservative reference ceiling: a gap of 3 full ATRs is
   // already a very wide EMA separation for a 1-minute chart, so normalizedGap readings at or
   // beyond it saturate the score at 100 rather than scaling further.
   double score = Clamp0to100((normalizedGap / 3.0) * 100.0);

   //--- 2026-09-08, explicit operator request ("EMA 20 & 50 always block the trade if there is no
   //--- Confirmation 2 Bars closed and 50% to any direction like buy or sell"): NEW 2-CLOSED-BAR
   //--- CONFIRMATION check. Confirmed via AskUserQuestion before implementation: the "50%" half of
   //--- this request is ALREADY the existing normalizedGap>=Inp_EMAMinGapATR (0.5) test just above -
   //--- not a second/new threshold, just restated here as an explicit named condition. The genuinely
   //--- NEW piece is the 2-bar check: even when gap+slope+ATR all agree (would otherwise vote BUY/
   //--- SELL), this Mind now ALSO requires the last 2 CLOSED M1 candles (ratesEma[0]=most recent,
   //--- ratesEma[1]=one before it - the SAME window already fetched above, no second CopyRates) to
   //--- BOTH have closed on the side of EMA20-vs-EMA50 matching that direction (close>EMA50 for a
   //--- prospective BUY, close<EMA50 for a prospective SELL - EMA50 chosen as the reference since it
   //--- is the slower/more stable of the two lines, the same choice this Mind's own gap already
   //--- centers on) - otherwise the vote is forced to WAIT instead. Confirmed scope (via
   //--- AskUserQuestion): affects ONLY this Mind's own single vote in the 18-Mind tally, exactly the
   //--- same blast radius this Mind already has today - NOT a new standalone Entry Approval gate.
   bool confirmedBuy  = (ratesEma[0].close>emaSlowNow) && (ratesEma[1].close>emaSlowNow);
   bool confirmedSell = (ratesEma[0].close<emaSlowNow) && (ratesEma[1].close<emaSlowNow);

   if(gap > 0.0 && normalizedGap >= Inp_EMAMinGapATR && emaSlope > 0.0 && confirmedBuy)
     {
      g_minds[slot].direction = LDIR_BUY; g_minds[slot].score = score;
      g_minds[slot].reasoning = StringFormat("EMA%d=%.3f EMA%d=%.3f gap=%.3f ATR=%.3f gap/ATR=%.2f slope=%.5f 2barConfirmed=true",
            Inp_EMAFastPeriod, emaFastNow, Inp_EMASlowPeriod, emaSlowNow, gap, atr, normalizedGap, emaSlope);
     }
   else if(gap < 0.0 && normalizedGap >= Inp_EMAMinGapATR && emaSlope < 0.0 && confirmedSell)
     {
      g_minds[slot].direction = LDIR_SELL; g_minds[slot].score = score;
      g_minds[slot].reasoning = StringFormat("EMA%d=%.3f EMA%d=%.3f gap=%.3f ATR=%.3f gap/ATR=%.2f slope=%.5f 2barConfirmed=true",
            Inp_EMAFastPeriod, emaFastNow, Inp_EMASlowPeriod, emaSlowNow, gap, atr, normalizedGap, emaSlope);
     }
   else
     {
      bool gapSlopeAgreed = (gap > 0.0 && normalizedGap >= Inp_EMAMinGapATR && emaSlope > 0.0) ||
                            (gap < 0.0 && normalizedGap >= Inp_EMAMinGapATR && emaSlope < 0.0);
      string waitReason = gapSlopeAgreed ? "gap/slope/ATR agreed but 2-bar confirmation failed" : "below threshold or slope conflict";
      g_minds[slot].direction = LDIR_WAIT; g_minds[slot].score = score;
      g_minds[slot].reasoning = StringFormat("EMA%d=%.3f EMA%d=%.3f gap=%.3f ATR=%.3f gap/ATR=%.2f slope=%.5f 2barConfirmed=false (%s)",
            Inp_EMAFastPeriod, emaFastNow, Inp_EMASlowPeriod, emaSlowNow, gap, atr, normalizedGap, emaSlope, waitReason);
     }
  }

//--- 2026-09-16, M5 PARALLEL PIPELINE: straight duplicate of EvaluateEmaTrendMind() above, writing
//--- g_mindsM5[14] (id 16) instead of g_minds[14] - every internal PERIOD_M1 CopyRates call retargeted
//--- to PERIOD_M5. Formula/thresholds/2-bar-confirmation logic byte-identical, just on M5 bars.
void EvaluateEmaTrendMindM5()
  {
   const int slot = 14; // g_mindsM5[] array position for this Mind (id 16)
   g_mindsM5[slot].id = 16;
   g_mindsM5[slot].name = "EMA Trend";

   if(!Inp_EMATrendEnabled)
     {
      g_mindsM5[slot].direction = LDIR_WAIT; g_mindsM5[slot].score = 0.0;
      g_mindsM5[slot].reasoning = "Inp_EMATrendEnabled=false";
      return;
     }
   if(Inp_EMAFastPeriod < 1 || Inp_EMASlowPeriod < 1 || Inp_EMAFastPeriod >= Inp_EMASlowPeriod)
     {
      g_mindsM5[slot].direction = LDIR_WAIT; g_mindsM5[slot].score = 0.0;
      g_mindsM5[slot].reasoning = StringFormat("invalid EMA periods (fast=%d slow=%d)", Inp_EMAFastPeriod, Inp_EMASlowPeriod);
      return;
     }

   const int atrPeriod = 14;
   const int slopeLookback = MathMax(0, Inp_EMASlopeLookback);
   const int needed = Inp_EMASlowPeriod + slopeLookback + atrPeriod + 5;

   MqlRates ratesEma[]; ArraySetAsSeries(ratesEma, true);
   int nEma = CopyRates(g_symbol, PERIOD_M5, 1, needed, ratesEma);
   if(nEma < needed)
     {
      g_mindsM5[slot].direction = LDIR_WAIT; g_mindsM5[slot].score = 0.0;
      g_mindsM5[slot].reasoning = StringFormat("insufficient closed-candle history (have=%d need=%d)", nEma, needed);
      return;
     }

   double alphaFastCache = 2.0 / (Inp_EMAFastPeriod + 1.0);
   double emaFastNow  = EmaAt(ratesEma, nEma, Inp_EMAFastPeriod, 0, alphaFastCache);
   double emaFastPrev = EmaAt(ratesEma, nEma, Inp_EMAFastPeriod, slopeLookback, alphaFastCache);
   double alphaSlowCache = 2.0 / (Inp_EMASlowPeriod + 1.0);
   double emaSlowNow  = EmaAt(ratesEma, nEma, Inp_EMASlowPeriod, 0, alphaSlowCache);

   if(!MathIsValidNumber(emaFastNow) || !MathIsValidNumber(emaFastPrev) || !MathIsValidNumber(emaSlowNow))
     {
