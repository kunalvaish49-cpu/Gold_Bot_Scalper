input group "Retry Forensic Observation (Step 3 - diagnostic logging only, no trading effect)"
input bool   Inp_RetryForensicEnabled = true;            // true = append retry_forensic.jsonl records; false = skip logging entirely, trading behavior identical either way

//--- 2026-08-31, explicit operator request (STEP 5 - RETRY FORENSIC DECISION-POINT DATA COLLECTION):
//--- independent toggle from Inp_RetryForensicEnabled above - controls ONLY the new
